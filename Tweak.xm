// 1.0.1：控制按钮的动作（注销 / 安全模式 / 用户空间重启 / 重启）用 posix_spawnp
// 直接 exec 设备上的命令行工具，不经过 shell。posix_spawnp 会按 PATH 查找，
// 所以 rootless(/var/jb) 与 roothide(随机 jbroot) 两种前缀都不用在这里特判。
#import <spawn.h>
#import <unistd.h>
// posix_spawnp 的 envp 参数要显式给一份环境变量。Darwin 上取它的正确方式是
// _NSGetEnviron()：直接写 `extern char **environ;` 在 C++ 里会和 <unistd.h>
// 里隐藏的声明冲突，编译不过。
#import <crt_externs.h>
#import <objc/message.h>
#import <objc/runtime.h>

// ---------------------------------------------------------------------------
// jailbreak root resolution
//
// roothide installs packages under a randomised per-install root and exposes
// jbroot() to convert a package-relative path into the real one.  rootless
// (Dopamine / NathanLR / palera1n) keeps a fixed /var/jb prefix instead, so
// the fallback below simply returns the path unchanged.
// jbroot() is a *function* in roothide, never a macro, so `#ifndef jbroot`
// cannot detect it -- it has to be __has_include on <roothide.h>.
// ---------------------------------------------------------------------------
#if __has_include(<roothide.h>)
#import <roothide.h>
#else
static inline NSString *ER_jbrootPath(NSString *path) { return path; }
#define jbroot(p) ER_jbrootPath(p)
#endif

// ---------------------------------------------------------------------------
// Liquid glass (0.4.0)
//
// The liquidass dependency is gone. The render pipeline that used to live in
// the LiquidAss tweak is now vendored into this project:
//
//   GlassKit/LGLiveBackdropView  — the CABackdropView glass renderer +
//                                  CAFilter plumbing (SpringBoard side)
//   GlassKit/LGGlassKit          — MTMaterialView routing + per-host prefs
//   BackboarddGlass/Tweak.mm     — the backboardd-side Metal filter that the
//                                  echoreborn.liquidglass.* filter types resolve to
//
// EchoReborn registers a "ControlCenter" material-host route so every native
// module's MTMaterialView is glassed by the ported pipeline, and the converted
// connectivity tiles get a directly-created LGLiveBackdropView (their native
// materials are hidden by the conversion, so there is nothing for the router
// to latch onto there — same reason the old stub MTMaterialView existed).
// ---------------------------------------------------------------------------
#import "GlassKit/LGGlassKit.h"
#import "GlassKit/LGLiveBackdropView.h"

// ---------------------------------------------------------------------------
// iOS version probing
//
// Theos ships at most the iPhoneOS16.5 SDK, so `@available(iOS 17.0, *)` is
// not usable here.  Compare the numeric system version at runtime instead.
// ---------------------------------------------------------------------------
static double ERSystemVersion(void) {
    static double cached = -1.0;
    if (cached < 0.0) {
        NSString *version = [[UIDevice currentDevice] systemVersion];
        cached = version.length ? [version doubleValue] : 0.0;
    }
    return cached;
}

static BOOL ERSystemVersionAtLeast(double version) {
    return ERSystemVersion() >= version - 0.0001;
}

// EchoReborn drives the classic ControlCenterUIKit collection architecture.
// iOS 18 replaced it outright, so when the cluster is missing we must install
// no hooks at all rather than half-hook a surface that no longer exists.
static BOOL ERControlCenterClusterAvailable(void) {
    return NSClassFromString(@"CCUIModuleCollectionViewController") != nil &&
           NSClassFromString(@"CCUIModularControlCenterOverlayViewController") != nil &&
           NSClassFromString(@"CCUIContentModuleContainerViewController") != nil;
}

