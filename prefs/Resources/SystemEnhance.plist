			<key>footerText</key>
			<string>开启后，相机 App 顶部「实况」图标左侧会出现一个双摄按钮，点击即可同时调用前后摄像头拍摄：前置画面以小窗合入后置画面，只保存一张照片。下面的「小窗位置」决定这个小窗落在四个角中的哪一个 —— 双摄画面、照片与录像三处同源。关闭双摄时不建按钮，相机进程也不会加载双摄组件。</string>
			<key>label</key>
			<string>相机增强</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.strive.echoreborn/ReloadPrefs</string>
