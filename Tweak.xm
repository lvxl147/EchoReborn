// ===========================================================================
// 1.0.9-50 · LiquidAss 两个效果的**逐字移植版**
// （上一版用「材质宿主路由 + 关键词匹配」是错误方向：实测快捷按钮完全没命中，
//   音量 HUD 反而误命中控制中心滑块 parent=_CCUIBaseSliderContentView，已整体移除）
//
// 为什么改回逐字移植：你实测「装 liquidass 原项目时锁屏按钮是透明的」→ 上游的判定
// 方式在 iOS 17 上是有效的。
//   Hooks/QuickActions.x → hook UIVisualEffectView，沿父链找 CSQuickActionsButton，
//                          隐藏原生 backdrop 后插入 LGLiveBackdropView（胶囊圆角）
//   Hooks/VolumeHUD.x    → hook SBElasticSliderMaterialWrapperView，隐藏
//                          _baseMaterialView/_captureOnlyMaterialView/_shadowView，
//                          插入 LGLiveBackdropView + CABackdropLayer 饱和/对比度层
// 三处适配：① 头文件用本项目 GlassKit ② 开关换成 ERGlassSwitchEnabled（缺省关）
//          ③ 日志用 ERLogInfo
// ===========================================================================

// 开关缺省为关（GlassKit 的 lgHostEnabled 在偏好为空时默认 YES，与需求不符）
static BOOL ERGlassSwitchEnabled(NSString *key) {
    if (!key.length) return NO;
    CFPropertyListRef v = CFPreferencesCopyAppValue((__bridge CFStringRef)key,
                                                    CFSTR("com.strive.echoreborn.preferences"));
    BOOL on = NO;
    if (v) {
        if (CFGetTypeID(v) == CFBooleanGetTypeID() || CFGetTypeID(v) == CFNumberGetTypeID()) {
            on = [(__bridge NSNumber *)v boolValue];
        }
        CFRelease(v);
    }
    return on;
}

