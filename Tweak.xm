// ---------------------------------------------------------------------------
// Logging forward declarations
//
// The log helpers are defined much further down, but presentation repairs near
// the top of the file (gallery preview clean-up) already report through them.
// The macros are declared here so those early call sites preprocess correctly;
// the implementations below are ordinary C functions and need no ordering.
// ---------------------------------------------------------------------------
static void ERLogMessage(NSString *level, NSString *format, ...);
#define ERLogInfo(...)    ERLogMessage(@"INFO", __VA_ARGS__)
#define ERLogWarn(...)    ERLogMessage(@"WARN", __VA_ARGS__)
#define ERLogError(...)   ERLogMessage(@"ERROR", __VA_ARGS__)

// 1.0.6-10（第 1 条）：热路径诊断的最小间隔闸门。
//
// 背景（实机量化，1.0.6-9 日志 235006，55 秒会话）：
//   ERPERF 的 slow 计数器从 618 涨到 732 —— 约 2.1 次/秒把 60Hz 的单帧预算打爆；
//   同期 SHORTCUTGRID 618 行 + SHORTCUTVIS 400 行 + SHORTCUTANCHOR 48 行 = 1066 行
//   长字符串（每条含十几个浮点格式化），且是**突发式**落盘：23:49:05.442→.481 这
//   40 毫秒里就有 30 行。也就是说翻页手势的每一帧要额外构造并写出约 16 条长日志，
//   这与 layout=5–16ms 的实测量级吻合 —— 它们是主线程的直接负担，而不仅仅是噪声。
//
// 闸门按「键 + 最小间隔」复用同一个词典，键只用固定标签，条目数有界。
// 诊断价值不丢：每条标签每秒仍会输出一次，足以判断状态是否收敛。
static BOOL ERDiagShouldLog(NSString *key, CFTimeInterval minInterval) {
    if (!key.length || minInterval <= 0.0) return YES;
    static NSMutableDictionary<NSString *, NSNumber *> *stamps;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{ stamps = [NSMutableDictionary dictionary]; });
    CFTimeInterval now = CACurrentMediaTime();
    NSNumber *last = stamps[key];
    if (last && now - last.doubleValue < minInterval) return NO;
    stamps[key] = @(now);
    return YES;
}


