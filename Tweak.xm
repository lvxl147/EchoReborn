static BOOL ERPreferenceBool(NSString *key, BOOL fallback) {
    Boolean valid = false;
    Boolean value = CFPreferencesGetAppBooleanValue((__bridge CFStringRef)key, kERPrefsDomain, &valid);
    return valid ? (BOOL)value : fallback;
}

static NSString *ERPreferenceString(NSString *key, NSString *fallback) {
    CFPropertyListRef value = CFPreferencesCopyAppValue((__bridge CFStringRef)key, kERPrefsDomain);
    if (!value) return fallback;
    NSString *result = [(__bridge_transfer NSString *)value copy];
    return result.length ? result : fallback;
}

static CGFloat ERPreferenceDouble(NSString *key, CGFloat fallback) {
    CFPropertyListRef value = CFPreferencesCopyAppValue((__bridge CFStringRef)key, kERPrefsDomain);
    CGFloat result = fallback;
    if (value) {
        if (CFGetTypeID(value) == CFNumberGetTypeID()) {
            double number = 0.0;
            if (CFNumberGetValue((CFNumberRef)value, kCFNumberDoubleType, &number)) result = (CGFloat)number;
        }
        CFRelease(value);
    }
    return result;
}

// 1.0.5：读偏好的统一入口。
//
// 更名（CCAster → Echo Reborn）把偏好域从 com.futur3sn0w.ccaster.preferences 换成了
// com.strive.echoreborn.preferences，但**用户更名前配好的东西仍然躺在老域里**：
// COSMICDuplicateFamilies（哪些磁贴归插件管）、ShortcutVisibleIdentifiers（「显示控制项」
// 清单）、ShortcutCatalog（设置侧发布的快捷指令目录）。
//
// 只认新域的唯一后果就是「读出来是空的」——插件既不登记那些磁贴、也不渲染，
// 用户在控制中心里就再也看不到快捷指令。这里做一层**读时兜底**：新域没有就回落到老域，
// 不改写老域、不破坏回滚。它与 -ERMigrateRenamedPreferenceState 的写时合并互为保险：
// 即使某次迁移因为任何原因没跑成，本次读取依然是完整的。
static id ERPreferenceValueWithLegacyFallback(NSString *key) {
    CFStringRef cfKey = (__bridge CFStringRef)key;
    CFPropertyListRef value = CFPreferencesCopyAppValue(cfKey, kERPrefsDomain);
    if (value) return (__bridge_transfer id)value;
    value = CFPreferencesCopyAppValue(cfKey, kERLegacyPrefsDomain);
    if (!value) return nil;
    return (__bridge_transfer id)value;
}

static NSArray *ERPreferenceArray(NSString *key) {
    id value = ERPreferenceValueWithLegacyFallback(key);
    if (![value isKindOfClass:[NSArray class]]) return nil;
    return [(NSArray *)value copy];
}

// ---------------------------------------------------------------------------
// Control Center gallery categories
//
// The category list used to be a hard-coded array in the add sheet. It is now
// driven by two preferences written by the Settings pane:
//
//   CategoryOrder       NSArray<NSString *>  the user's chosen ordering
//   DisabledCategories  NSArray<NSString *>  groups to hide entirely
//
// Both are read through CFPreferences on every catalog build, so a change in
// Settings takes effect the next time the sheet opens — no respring.
// ---------------------------------------------------------------------------
// Everything the catalog can legitimately produce, in the stock order. Used as
// the seed when no custom order has been saved, and as the ordering authority
// for any category the saved list forgot to mention.
static NSArray<NSString *> *ERDefaultCategoryOrder(void) {
    // 1.0.6-14：移除「实用功能」。该分类的天气条目已按用户要求并入「实用工具」，
    // 不再需要一个只有一项的自研分组（见 ERCategoryForIdentifier 的说明）。
    // 老用户盘里已存的 CategoryOrder 若仍含这一项，它只会是一个空分类 ——
    // visibleSections 里 `if (!entries.count) continue;` 会把它整组跳过，
    // 不会留下空标题。
    return @[@"辅助功能", @"拍摄", @"时钟", @"连接", @"显示", @"专注", @"家庭",
             @"媒体", @"备忘录", @"语音备忘录", @"钱包", @"实用工具",
             @"快捷指令", @"第三方插件"];
}

static NSArray<NSString *> *ERCategoryOrder(void) {
    NSArray *stored = ERPreferenceArray(@"CategoryOrder");
    NSMutableArray<NSString *> *order = [NSMutableArray array];
    for (id entry in stored) {
        if (![entry isKindOfClass:[NSString class]] || ![entry length]) continue;
        if ([order containsObject:entry]) continue;
        [order addObject:entry];
    }
    // Append anything the saved order does not know about (a category added by
    // a newer build, or an order saved before this version existed) so no group
    // can ever be silently dropped.
    for (NSString *category in ERDefaultCategoryOrder()) {
        if (![order containsObject:category]) [order addObject:category];
    }
    return order;
}

static BOOL ERCategoryIsDisabled(NSString *category) {
    if (!category.length) return NO;
    NSArray *disabled = ERPreferenceArray(@"DisabledCategories");
    return [disabled containsObject:category];
}

// ---------------------------------------------------------------------------
// Diagnostics log
//
// Off by default. When the Settings switch is on, every significant decision,
// failure, exception, and module-state change is written to a rolling plain
// text file that the preference bundle can export, and echoed to os_log so
// `log stream` keeps working. Everything runs on a private serial queue, so
// logging never blocks or re-enters the code that produced the event.
//
// The file lives outside the jailbreak root on purpose: SpringBoard and the
// Preferences process both run as `mobile`, and the same absolute path has to
// be reachable from both — including under roothide, whose jbroot() is
// randomised per install.
// ---------------------------------------------------------------------------
static NSString *const kERLogDirectory = @"/var/mobile/Library/Logs/EchoReborn";
static NSString *const kERLogFileName = @"echoreborn.log";
static NSString *const kERLogExportedPrefix = @"EchoReborn-log-";
static NSString *const kERLogExportedDirectory = @"/var/mobile/Documents";
static NSUInteger const kERLogMaxBufferedLines = 1500;
static NSUInteger const kERLogFlushInterval = 8;
static NSUInteger const kERLogMaxFileBytes = 512u * 1024u;

static dispatch_queue_t gERLogQueue;
static NSMutableArray<NSString *> *gERLogBuffer;
static NSUInteger gERLogFlushCounter = 0;
static BOOL gERLogDirectoryReady = NO;

static NSString *ERLogPath(void) {
    return [kERLogDirectory stringByAppendingPathComponent:kERLogFileName];
}

static void ERLogEnsureDirectory(void) {
    if (gERLogDirectoryReady) return;
    NSFileManager *files = [NSFileManager defaultManager];
    BOOL isDirectory = NO;
    if ([files fileExistsAtPath:kERLogDirectory isDirectory:&isDirectory] && isDirectory) {
        gERLogDirectoryReady = YES;
        return;
    }
    [files createDirectoryAtPath:kERLogDirectory withIntermediateDirectories:YES attributes:nil error:nil];
    gERLogDirectoryReady = YES;
}

// Keep the on-disk log bounded: once it passes the budget, drop the oldest
// half rather than letting it grow without limit on a device that is never
// rebooted.
static void ERLogTruncateIfNeeded(void) {
    NSString *path = ERLogPath();
    NSDictionary *attributes = [[NSFileManager defaultManager] attributesOfItemAtPath:path error:nil];
    if ([attributes fileSize] <= kERLogMaxFileBytes) return;
    NSString *contents = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:nil];
    if (!contents.length) return;
    NSArray<NSString *> *lines = [contents componentsSeparatedByString:@"\n"];
    if (lines.count < 2) return;
    NSUInteger keepFrom = lines.count / 2;
    NSString *kept = [[lines subarrayWithRange:NSMakeRange(keepFrom, lines.count - keepFrom)] componentsJoinedByString:@"\n"];
    [kept writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:nil];
}

// 0.4.3: the primary log is the file of record, but a write to it can fail —
// SpringBoard's sandbox refuses /var/mobile/Library/Logs/EchoReborn, the
// container is remounted read-only mid-session, a roothide jbroot moves the
// path out from under us. When that happens the caller sees nothing at all:
// not a truncated file, not a permission error, just a log that silently ends.
// That exact failure cost a whole release cycle on 2026-09-12, because the
// only way to reach a diagnosis was reading the on-device log and the log had
// stopped being written hours earlier. So a failed primary write now also
// mirrors into NSLog. NSLog is deliberately avoided on the hot path (it is
// synchronous inside SpringBoard's own pipeline and stalled the main thread),
// but this branch only runs when the file is already unusable, which is much
// worse than a slow frame.
static void ERLogFallbackToConsole(NSArray<NSString *> *lines, BOOL primaryFailed) {
    if (!lines.count || !primaryFailed) return;
    static NSUInteger fallbackLines = 0;
    // Bounded: a permanently broken log file must not turn into an unbounded
    // NSLog storm on a process that lays out Control Center continuously.
    if (fallbackLines > 2000) return;
    fallbackLines += lines.count;
    for (NSString *line in lines) {
        // %@ not %s: the lines are already Unicode and this is not a hot path.
        NSLog(@"[EchoReborn] %@", line);
    }
}

static void ERLogAppendLines(NSArray<NSString *> *lines) {
    if (!lines.count) return;
    ERLogEnsureDirectory();
    NSString *path = ERLogPath();
    BOOL failed = NO;
    NSFileHandle *handle = [NSFileHandle fileHandleForWritingAtPath:path];
    if (!handle) {
        [@"" writeToFile:path atomically:NO encoding:NSUTF8StringEncoding error:nil];
        handle = [NSFileHandle fileHandleForWritingAtPath:path];
    }
    if (!handle) {
        failed = YES;
    } else {
        @try {
            [handle seekToEndOfFile];
            NSString *chunk = [[lines componentsJoinedByString:@"\n"] stringByAppendingString:@"\n"];
            [handle writeData:[chunk dataUsingEncoding:NSUTF8StringEncoding]];
        } @catch (__unused NSException *exception) {
            failed = YES;
        } @finally {
            @try { [handle closeFile]; } @catch (__unused NSException *ignored) {}
        }
    }
    ERLogFallbackToConsole(lines, failed);
    if (failed) return;
    ERLogTruncateIfNeeded();
}

static NSString *ERLogTimestamp(void) {
    static NSDateFormatter *formatter;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        formatter = [NSDateFormatter new];
        formatter.dateFormat = @"yyyy-MM-dd HH:mm:ss.SSS";
        formatter.locale = [NSLocale localeWithLocaleIdentifier:@"en_US_POSIX"];
    });
    return [formatter stringFromDate:[NSDate date]];
}

static void ERLogRecord(NSString *level, NSString *message) {
    if (!gERLoggingEnabled || !message.length) return;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        gERLogQueue = dispatch_queue_create("com.strive.echoreborn.log", DISPATCH_QUEUE_SERIAL);
        gERLogBuffer = [NSMutableArray array];
    });
    NSString *capturedLevel = [level copy];
    NSString *capturedMessage = [message copy];
    dispatch_async(gERLogQueue, ^{
        // Formatting happens on the queue: NSDateFormatter is not thread safe
        // and log callers arrive from whichever thread produced the event.
        NSString *line = [NSString stringWithFormat:@"%@ [%@] %@", ERLogTimestamp(), capturedLevel, capturedMessage];
        // Deliberately no NSLog here. The file is the log of record, and
        // NSLog is a synchronous write into SpringBoard's own logging
        // pipeline: at Control Center's per-layout call rate it stalled the
        // main thread badly enough that the overlay never finished presenting.
        [gERLogBuffer addObject:line];
        if (gERLogBuffer.count > kERLogMaxBufferedLines) {
            NSUInteger drop = gERLogBuffer.count - kERLogMaxBufferedLines;
            [gERLogBuffer removeObjectsInRange:NSMakeRange(0, drop)];
        }
        // Errors are flushed immediately: a crash right after is exactly the
        // case where the newest lines matter most.
        gERLogFlushCounter++;
        BOOL urgent = [level isEqualToString:@"ERROR"];
        if (urgent || gERLogFlushCounter >= kERLogFlushInterval) {
            gERLogFlushCounter = 0;
            NSArray<NSString *> *pending = [gERLogBuffer copy];
            [gERLogBuffer removeAllObjects];
            ERLogAppendLines(pending);
        }
    });
}

// Force everything still buffered to disk. Called before the preference
// bundle exports the file so an export is never missing the latest lines.
static void ERLogFlush(void) {
    if (!gERLoggingEnabled || !gERLogQueue) return;
    dispatch_sync(gERLogQueue, ^{
        if (!gERLogBuffer.count) return;
        NSArray<NSString *> *pending = [gERLogBuffer copy];
        [gERLogBuffer removeAllObjects];
        ERLogAppendLines(pending);
    });
}

static void ERLogMessage(NSString *level, NSString *format, ...) {
    if (!gERLoggingEnabled) return;
    va_list args;
    va_start(args, format);
    NSString *message = [[NSString alloc] initWithFormat:format arguments:args];
    va_end(args);
    ERLogRecord(level, message);
}

// ERLogInfo/ERLogWarn/ERLogError are declared at the top of the file; the
// early preview clean-up needs them before this point.

// Key operations: what happened, to which module, and with what outcome.
static void ERLogOperation(NSString *operation, NSString *identifier, BOOL success, NSString *detail) {
    if (!gERLoggingEnabled) return;
    ERLogRecord(success ? @"INFO" : @"WARN",
                 [NSString stringWithFormat:@"op=%@ id=%@ result=%@ %@",
                  operation, identifier ?: @"(none)", success ? @"ok" : @"failed", detail ?: @""]);
}

// Module state snapshots: footprint, placement, and which presentation is
// driving the tile — the values that explain a layout that looks wrong.
//
// Deduplicated per module. Control Center lays its modules out many times per
// presentation (the process log showed ~333 identical snapshots in 22 s), and
// every line is an fopen/append/close on the SpringBoard main thread. Logging
// only transitions keeps the diagnostic value while removing the I/O storm.
static NSMutableDictionary<NSString *, NSString *> *gERLastModuleState;
static void ERLogModuleState(NSString *identifier, CCUILayoutSize natural, CCUILayoutSize effective, NSString *presentation) {
    if (!gERLoggingEnabled) return;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{ gERLastModuleState = [NSMutableDictionary dictionary]; });
    NSString *state = [NSString stringWithFormat:@"natural=%lux%lu effective=%lux%lu presentation=%@",
                       (unsigned long)natural.width, (unsigned long)natural.height,
                       (unsigned long)effective.width, (unsigned long)effective.height,
                       presentation ?: @"native"];
    NSString *key = identifier ?: @"(none)";
    @synchronized (gERLastModuleState) {
        if ([gERLastModuleState[key] isEqualToString:state]) return;
        gERLastModuleState[key] = state;
    }
    ERLogRecord(@"INFO", [NSString stringWithFormat:@"state id=%@ %@", key, state]);
}



static void ERLogPrefs(void) {
    if (!gERLoggingEnabled) return;
    ERLogRecord(@"INFO",
                 [NSString stringWithFormat:@"prefs enabled=%d paging=%d quickAccess=%d volume=%d brightness=%d logging=1",
                  gEnabled, gPagingEnabled, gQuickAccessButtonsEnabled, gVolumeControlEnabled, gBrightnessControlEnabled]);
}

static void ERLoadPrefs(void) {
    // Land anything still buffered before the flag can change, so turning the
    // switch off keeps the lines recorded up to that moment.
    ERLogFlush();
    CFPreferencesAppSynchronize(kERPrefsDomain);
    gEnabled = ERPreferenceBool(@"Enabled", YES);
    gQuickAccessButtonsEnabled = ERPreferenceBool(@"QuickAccessButtonsEnabled", YES);
    gQuickAccessVerticalOffset = ERPreferenceDouble(@"QuickAccessVerticalOffset", 0.0);
    gQuickAccessHorizontalInset = ERPreferenceDouble(@"QuickAccessHorizontalInset", 22.0);
    gQuickAccessButtonSize = ERPreferenceDouble(@"QuickAccessButtonSize", 40.0);
    gPagingEnabled = ERPreferenceBool(@"PagingEnabled", YES);
    gBlankSpaceGestureEnabled = ERPreferenceBool(@"BlankSpaceGestureEnabled", YES);
    gAddButtonEnabled = ERPreferenceBool(@"AddButtonEnabled", YES);
    gPowerButtonEnabled = ERPreferenceBool(@"PowerButtonEnabled", YES);
    gRemovalButtonsEnabled = ERPreferenceBool(@"RemovalButtonsEnabled", YES);
    gModuleBordersEnabled = ERPreferenceBool(@"ModuleBordersEnabled", YES);
    gBorderBreathingEnabled = ERPreferenceBool(@"BorderBreathingEnabled", YES);
    gHapticsEnabled = ERPreferenceBool(@"HapticsEnabled", YES);
    gVolumeControlEnabled = ERPreferenceBool(@"VolumeControlEnabled", YES);
    gBrightnessControlEnabled = ERPreferenceBool(@"BrightnessControlEnabled", YES);
    gERLoggingEnabled = ERPreferenceBool(@"LoggingEnabled", NO);
    gERLandscapeLayoutEnabled = ERPreferenceBool(@"LandscapeLayout.Enabled", NO);
    // 1.0.7-23：横屏账本每次重载都重读一遍 —— 设置页的「恢复横屏布局」删掉
    // COSMICLandscapeOrigins 后，不需要注销就能立刻回到折行布局。
    CFPropertyListRef reloadedLandscape = CFPreferencesCopyAppValue(CFSTR("COSMICLandscapeOrigins"), kERPrefsDomain);
    gERLandscapeOrigins = [(__bridge NSDictionary *)reloadedLandscape mutableCopy] ?: [NSMutableDictionary dictionary];
    if (reloadedLandscape) CFRelease(reloadedLandscape);
    ERLogInfo(@"LANDSCAPE ver=1.0.9-103 ledger=%lu enabled=%d",
              (unsigned long)gERLandscapeOrigins.count, gERLandscapeLayoutEnabled ? 1 : 0);
    ERLogPrefs();

    // -----------------------------------------------------------------
    // 1.0.9-70 · **把 LiquidAss 移植项的初始化改挂到这里**。
    //
    // 为什么不是 %ctor：日志证明 —— `ER-CTOR-START`（写在主 %ctor 第一行）**一次都没输出**，
    // 而日志里的 APPSW-PROBE 比启动日志晚 2.3 秒（说明它是别处的同名日志，不是 %ctor 里的）。
    // 也就是说**主 %ctor 在本项目里并未执行**，hook 自然永远挂不上。
    //
    // ERLoadPrefs() 是已证明会跑的入口（日志第 1/2 行就是它打的），
    // 并且偏好变化/注销后重载也会再来一次 —— 正好适合做一次性初始化。
    // -----------------------------------------------------------------
    // 1.0.9-71 · **去掉一次性门闩**：ERLoadPrefs() 启动时会跑多次，第一次执行时日志往往还没落盘
    // （于是看起来"初始化没跑"）。现在改为**每次都调用**，由 ERInstallDynamicIslandHooks 内部
    // 自己保证幂等（装过就跳过），并且**每次都打日志**，这样清空日志后切一下开关就能看到状态。
    @try {
        ERStartVolumeHUDClassScanner();
        ERStartDynamicIslandScanner();
        ERLogInfo(@"LIQUIDASS-INIT 已调用 di=%d hide=%d global=%d",
                  ERDIEnabled() ? 1 : 0, ERDIHideEnabled() ? 1 : 0,
                  ERGlassSwitchEnabled(@"Global.Enabled") ? 1 : 0);
    } @catch (__unused NSException *e) {
        ERLogInfo(@"LIQUIDASS-INIT 抛异常（已忽略）");
    }
}

static BOOL ERIsOverlayController(UIViewController *controller) {
    NSString *name = NSStringFromClass(controller.class);
    return [name containsString:@"ControlCenterOverlayViewController"] ||
           [name isEqualToString:@"CCUIModularControlCenterOverlayViewController"];
}

static UIViewController *ERFindOverlayController(UIViewController *root) {
    if (!root) return nil;
    NSMutableArray<UIViewController *> *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIViewController *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if (ERIsOverlayController(candidate)) return candidate;
        [queue addObjectsFromArray:candidate.childViewControllers];
        if (candidate.presentedViewController) [queue addObject:candidate.presentedViewController];
    }
    return nil;
}

static BOOL ERIsModuleController(UIViewController *controller) {
    return [controller isKindOfClass:[EROwnedDuplicateModuleViewController class]] ||
           [NSStringFromClass(controller.class) containsString:@"ContentModuleContainerViewController"];
}

static BOOL ERIsOwnedDuplicateModuleController(UIViewController *controller) {
    return [controller isKindOfClass:[EROwnedDuplicateModuleViewController class]];
}

static UIView *ERPresentationWrapperForModuleController(UIViewController *controller) {
    UIView *candidate = controller.view.superview;
    for (NSUInteger depth = 0; candidate && candidate.superview && depth < 6; depth++) {
        if ([NSStringFromClass(candidate.superview.class) containsString:@"ContentModuleContainerView"]) {
            return candidate;
        }
        candidate = candidate.superview;
    }
    return controller.view.superview;
}


static void ERHaptic(void) {
    if (!gHapticsEnabled) return;
    UIImpactFeedbackGenerator *generator = [[UIImpactFeedbackGenerator alloc] initWithStyle:UIImpactFeedbackStyleLight];
    [generator prepare];
    [generator impactOccurred];
}

// 单击震动生成器必须全局强引用保留：impactOccurred 是异步派发的，局部变量会在
// 派发完成前被释放，导致「自检点击后不震动」这类静默失败。
static UIImpactFeedbackGenerator *gTapHapticGenerator = nil;
static NSInteger gTapHapticStyle = -1;

// 把「震动强度」偏好（0=轻微 / 1=中等 / 2=强烈，默认 1，越界夹回 0–2）读成 API 档位。
static UIImpactFeedbackStyle ERHapticStyleForStrength(NSInteger strength) {
    switch (strength) {
        case 0:  return UIImpactFeedbackStyleLight;
        case 2:  return UIImpactFeedbackStyleHeavy;
        default: return UIImpactFeedbackStyleMedium;
    }
}

// 读取「震动强度」偏好，越界值夹回 0–2。
static NSInteger ERHapticCurrentStrength(void) {
    NSInteger strength = 1; // 默认中等
    CFPropertyListRef value = CFPreferencesCopyAppValue(CFSTR("TapHapticStrength"),
        CFSTR("com.strive.echoreborn.preferences"));
    if (value) {
        if (CFGetTypeID(value) == CFNumberGetTypeID())
            CFNumberGetValue((CFNumberRef)value, kCFNumberNSIntegerType, &strength);
        CFRelease(value);
    }
    if (strength < 0) strength = 0;
    if (strength > 2) strength = 2;
    return strength;
}

// 按指定强度触发一次单击震动。受总开关 gHapticsEnabled 与「单击震动反馈」开关双重控制。
static void ERHapticWithStrength(NSInteger strength) {
    if (!gHapticsEnabled) return;
    BOOL tapEnabled = YES;
    CFPropertyListRef value = CFPreferencesCopyAppValue(CFSTR("TapHapticEnabled"),
        CFSTR("com.strive.echoreborn.preferences"));
    if (value) {
        if (CFGetTypeID(value) == CFBooleanGetTypeID())
            tapEnabled = CFBooleanGetValue((CFBooleanRef)value);
        CFRelease(value);
    }
    if (!tapEnabled) return;
    UIImpactFeedbackStyle style = ERHapticStyleForStrength(strength);
    if (gTapHapticStyle != (NSInteger)style || !gTapHapticGenerator) {
        gTapHapticGenerator = [[UIImpactFeedbackGenerator alloc] initWithStyle:style];
        gTapHapticStyle = (NSInteger)style;
    }
    [gTapHapticGenerator prepare];
    [gTapHapticGenerator impactOccurred];
}

static NSString *ERModuleIdentifier(UIViewController *controller) {
    NSArray<NSString *> *keys = @[@"moduleIdentifier", @"_moduleIdentifier"];
    for (NSString *key in keys) {
        @try {
            id value = [controller valueForKey:key];
            if ([value isKindOfClass:[NSString class]] && [value length]) return value;
        } @catch (__unused NSException *exception) {}
    }
    @try {
        id module = [controller valueForKey:@"module"];
        id context = [module valueForKey:@"contentModuleContext"];
        id value = [context valueForKey:@"moduleIdentifier"];
        if ([value isKindOfClass:[NSString class]]) return value;
    } @catch (__unused NSException *exception) {}
    return nil;
}

static UIViewController *ERModuleControllerForView(UIView *view) {
    UIResponder *responder = view;
    while (responder) {
        if ([responder isKindOfClass:[UIViewController class]] && ERIsModuleController((UIViewController *)responder)) {
            return (UIViewController *)responder;
        }
        responder = responder.nextResponder;
    }
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            if (view == module.view || [view isDescendantOfView:module.view]) return module;
        }
    }
    return nil;
}

static NSString *ERIdentifierFromObject(id object) {
    if (!object) return nil;
    if ([object isKindOfClass:[UIViewController class]]) {
        NSString *identifier = ERModuleIdentifier((UIViewController *)object);
        if (identifier.length) return identifier;
    }
    for (NSString *key in @[@"moduleIdentifier", @"_moduleIdentifier"]) {
        @try {
            id value = [object valueForKey:key];
            if ([value isKindOfClass:[NSString class]] && [value length]) return value;
        } @catch (__unused NSException *exception) {}
    }
    @try {
        id context = [object valueForKey:@"contentModuleContext"];
        id value = [context valueForKey:@"moduleIdentifier"];
        if ([value isKindOfClass:[NSString class]] && [value length]) return value;
    } @catch (__unused NSException *exception) {}
    return nil;
}

static BOOL ERDuplicateIdentifierIsNumbered(NSString *identifier) {
    if (![identifier isKindOfClass:[NSString class]]) return NO;
    NSRange range = [identifier rangeOfString:@"#" options:NSBackwardsSearch];
    if (range.location == NSNotFound || range.location == 0 || range.location + 1 >= identifier.length) return NO;
    NSString *suffix = [identifier substringFromIndex:range.location + 1];
    if (!suffix.length) return NO;
    return [suffix rangeOfCharacterFromSet:[[NSCharacterSet decimalDigitCharacterSet] invertedSet]].location == NSNotFound && suffix.integerValue > 1;
}

static NSString *ERDuplicateFamilyIdentifierForIdentifier(NSString *identifier) {
    NSString *registered = gERDuplicateFamilies[identifier];
    if (registered.length) return registered;
    if (ERDuplicateIdentifierIsNumbered(identifier)) {
        NSRange range = [identifier rangeOfString:@"#" options:NSBackwardsSearch];
        return [identifier substringToIndex:range.location];
    }
    return identifier;
}

static BOOL ERModuleIdentifierSupportsOwnedDuplicates(NSString *identifier) {
    NSString *familyIdentifier = ERDuplicateFamilyIdentifierForIdentifier(identifier).lowercaseString;
    if (![familyIdentifier containsString:@"echoreborn.connectivity"]) return NO;
    // Converted modules are single-instance: one tile, no count badge, no second
    // copy, and no lingering entry in 添加控制项 once placed. Membership of the
    // highlight set therefore drives BOTH the visual style and this rule, so
    // there is no second list to keep in sync. The unconverted remainder keeps
    // the duplicate-capable behaviour until they are converted too.
    if (ERConnectivityIdentifierUsesWhiteHighlight(familyIdentifier)) return NO;
    return YES;
}

static BOOL ERIdentifierIsLegacyPhysicalDuplicate(NSString *identifier) {
    if (![identifier isKindOfClass:[NSString class]]) return NO;
    NSString *lower = identifier.lowercaseString;
    return [lower containsString:@".instance."] || [lower containsString:@"moduleinstance"];
}

static void ERSaveDuplicateFamilies(void) {
    CFPreferencesSetAppValue(CFSTR("COSMICDuplicateFamilies"), (__bridge CFPropertyListRef)[gERDuplicateFamilies copy], kERPrefsDomain);
    CFPreferencesAppSynchronize(kERPrefsDomain);
}

static void ERSaveGridPreferences(void) {
    CFPreferencesSetAppValue(CFSTR("ModuleGridOrigins"), (__bridge CFPropertyListRef)[gERCustomOrigins copy], kERPrefsDomain);
    CFPreferencesSetAppValue(CFSTR("ModuleGridSizes"), (__bridge CFPropertyListRef)[gERCustomSizes copy], kERPrefsDomain);
    CFPreferencesAppSynchronize(kERPrefsDomain);
}

static NSString *ERNextDuplicateIdentifierForFamily(NSString *familyIdentifier, NSSet<NSString *> *present) {
    if (!familyIdentifier.length) return nil;
    NSMutableSet<NSString *> *used = [NSMutableSet setWithArray:gERDuplicateFamilies.allKeys ?: @[]];
    for (NSString *identifier in present) if ([identifier isKindOfClass:[NSString class]]) [used addObject:identifier];
    for (NSUInteger index = 2; index < 100; index++) {
        NSString *candidate = [NSString stringWithFormat:@"%@#%lu", familyIdentifier, (unsigned long)index];
        if (![used containsObject:candidate]) return candidate;
    }
    return nil;
}

static NSUInteger ERDuplicateCountForFamily(NSString *familyIdentifier, NSSet<NSString *> *present) {
    if (!familyIdentifier.length) return 0;
    NSUInteger count = [present containsObject:familyIdentifier] ? 1 : 0;
    for (NSString *identifier in gERDuplicateFamilies) {
        if ([gERDuplicateFamilies[identifier] isEqualToString:familyIdentifier]) count++;
    }
    return count;
}

static NSString *ERPrettyNameForIdentifier(NSString *identifier) {
    NSString *last = [identifier componentsSeparatedByString:@"."].lastObject ?: identifier;
    last = [last stringByReplacingOccurrencesOfString:@"Module" withString:@""];
    if (!last.length) return identifier;
    NSMutableString *result = [NSMutableString string];
    for (NSUInteger index = 0; index < last.length; index++) {
        unichar character = [last characterAtIndex:index];
        if (index > 0 && [[NSCharacterSet uppercaseLetterCharacterSet] characterIsMember:character]) [result appendString:@" "];
        [result appendFormat:@"%C", character];
    }
    return result.length ? [result capitalizedString] : identifier;
}

// ---------------------------------------------------------------------------
// Shortcuts (快捷指令) integration
//
// Shortcut records are read by ERShortcutScanner (prefs bundle) from the
// user's Shortcuts store and published to the shared "ShortcutCatalog"
// prefs domain. This process only consumes that domain (ERShortcutRecords).
// ---------------------------------------------------------------------------



static BOOL ERShortcutIdentifierIsShortcut(NSString *identifier) {
    if (![identifier isKindOfClass:[NSString class]]) return NO;
    // 1.0.4：老前缀（更名前加进控制中心的磁贴）同样算快捷指令磁贴，
    // 否则它们在更名后会被当成「未知模块」而整体失联。
    if ([identifier hasPrefix:kERShortcutIdentifierPrefix]) {
        return identifier.length > kERShortcutIdentifierPrefix.length;
    }
    if ([identifier hasPrefix:kERLegacyShortcutIdentifierPrefix]) {
        return identifier.length > kERLegacyShortcutIdentifierPrefix.length;
    }
    return NO;
}

// ---------------------------------------------------------------------------
// 快捷指令 slot modules（对齐真实 0.5.6.24 / 0.5.5.0 起）
//
// 每一块快捷指令磁贴现在都是一个**真实的 Control Center 模块** —— 即 32 个
// com.strive.echoreborn.shortcut.N bundle（见 slot-modules/shortcutN）。于是
// 摆放、尺寸、分页、绘制全部由控制中心自己做，本插件只需要说明「某个槽位跑哪条
// 快捷指令」。这条绑定是数据：ShortcutSlotAssignments { "1" -> uuid }，与目录
// 一起由同一条链路发布。
//
// 为什么换掉 0.5.4.3 及以前的自绘磁贴：自绘意味着插件必须复刻控制中心的布局算术
// —— 页原点、采样矩形所在的坐标空间、页偏移 —— 且要覆盖每一个状态（静止、拖动中、
// 落位到第 n 页、编辑态）。「第二页位置不对」「编辑态不对」「打开瞬间歪一下」这些
// 报告全部出自那段算术。把磁贴交给控制中心，是**删掉**那段算术，而不是再修一次。
// 与七个「连接」模块同一机制。
//
// 槽位标识符刻意沿用 kERShortcutIdentifierPrefix，于是
// ERShortcutIdentifierIsShortcut、ERCategoryForIdentifier、
// ERFallbackSymbolForIdentifier 以及整条渲染路径都不必改；区别在**后缀**——
// 槽位是纯数字（"3"），旧的 uuid 磁贴是 36 个字符带连字符。
// ---------------------------------------------------------------------------
static NSUInteger const kERShortcutSlotCount = 32;
static NSString *const kERShortcutSlotAssignmentsKey = @"ShortcutSlotAssignments";
// 与槽位 bundle 共享：bundle 广播 RunShortcut，并把工作流 uuid 暂存在
// ShortcutRunRequest（Darwin 通知跨观察者不带可靠的 userInfo），本进程读回来。
static NSString *const kERShortcutRunRequestKey = @"ShortcutRunRequest";
static NSString *const kERShortcutRunNotification = @"com.strive.echoreborn/RunShortcut";

// 槽位标识符返回 1..kERShortcutSlotCount；其它一律 0。
static NSInteger ERShortcutSlotIndexFromIdentifier(NSString *identifier) {
    if (![identifier isKindOfClass:[NSString class]]) return 0;
    if (![identifier hasPrefix:kERShortcutIdentifierPrefix]) return 0;
    NSString *suffix = [identifier substringFromIndex:kERShortcutIdentifierPrefix.length];
    if (!suffix.length || suffix.length > 3) return 0;
    for (NSUInteger index = 0; index < suffix.length; index++) {
        unichar character = [suffix characterAtIndex:index];
        if (character < '0' || character > '9') return 0;
    }
    NSInteger slot = suffix.integerValue;
    return (slot >= 1 && slot <= (NSInteger)kERShortcutSlotCount) ? slot : 0;
}

static NSString *ERShortcutSlotIdentifier(NSInteger slot) {
    return [kERShortcutIdentifierPrefix stringByAppendingFormat:@"%ld", (long)slot];
}

// 槽号 -> 快捷指令 uuid。
static NSDictionary<NSString *, NSString *> *ERShortcutSlotAssignments(void) {
    NSMutableDictionary<NSString *, NSString *> *assignments = [NSMutableDictionary dictionary];
    CFPropertyListRef value = CFPreferencesCopyAppValue((__bridge CFStringRef)kERShortcutSlotAssignmentsKey, kERPrefsDomain);
    if (value) {
        if (CFGetTypeID(value) == CFDictionaryGetTypeID()) {
            NSDictionary *raw = (__bridge NSDictionary *)value;
            for (id key in raw) {
                id entry = raw[key];
                if (![key isKindOfClass:[NSString class]] || ![entry isKindOfClass:[NSString class]]) continue;
                if (![(NSString *)entry length]) continue;
                assignments[(NSString *)key] = (NSString *)entry;
            }
        }
        CFRelease(value);
    }
    return assignments;
}

static NSString *ERShortcutUUIDForSlot(NSInteger slot) {
    if (slot <= 0) return nil;
    return ERShortcutSlotAssignments()[[NSString stringWithFormat:@"%ld", (long)slot]];
}

// 落盘槽位 -> 快捷指令的绑定。由「添加控制项」写入，由槽位 bundle 读出来画磁贴。
static void ERShortcutSetSlotAssignment(NSInteger slot, NSString *uuid) {
    if (slot <= 0 || slot > (NSInteger)kERShortcutSlotCount) return;
    if (![uuid isKindOfClass:[NSString class]] || !uuid.length) return;
    NSMutableDictionary<NSString *, NSString *> *assignments = [ERShortcutSlotAssignments() mutableCopy] ?: [NSMutableDictionary dictionary];
    assignments[[NSString stringWithFormat:@"%ld", (long)slot]] = uuid;
    CFPreferencesSetAppValue((__bridge CFStringRef)kERShortcutSlotAssignmentsKey, (__bridge CFPropertyListRef)[assignments copy], kERPrefsDomain);
    CFPreferencesAppSynchronize(kERPrefsDomain);
}

// 为一条快捷指令取一个槽位标识符：已有绑定则复用；否则认领第一个空槽并落盘。
// 「空」= 没有任何绑定，且当前没有被启用进控制中心 —— 于是两行目录项不可能撞同一个槽。
static NSString *ERShortcutSlotIdentifierForAddingUUID(NSString *uuid) {
    if (![uuid isKindOfClass:[NSString class]] || !uuid.length) return nil;
    NSDictionary<NSString *, NSString *> *assignments = ERShortcutSlotAssignments();
    for (NSString *key in assignments) {
        if ([assignments[key] isEqualToString:uuid]) {
            NSInteger slot = key.integerValue;
            if (slot >= 1 && slot <= (NSInteger)kERShortcutSlotCount) return ERShortcutSlotIdentifier(slot);
        }
    }
    NSMutableSet<NSString *> *occupied = [NSMutableSet setWithArray:assignments.allKeys];
    id coordinatorClass = NSClassFromString(@"EchoRebornCoordinator");
    if (coordinatorClass && [coordinatorClass respondsToSelector:@selector(shared)]) {
        id coordinator = ((id (*)(id, SEL))objc_msgSend)(coordinatorClass, @selector(shared));
        if ([coordinator respondsToSelector:@selector(enabledModuleIdentifiers)]) {
            NSArray *enabled = ((id (*)(id, SEL))objc_msgSend)(coordinator, @selector(enabledModuleIdentifiers));
            for (NSString *identifier in enabled) {
                if ([identifier isKindOfClass:[NSString class]] && [identifier hasPrefix:kERShortcutIdentifierPrefix]) {
                    [occupied addObject:[identifier substringFromIndex:kERShortcutIdentifierPrefix.length]];
                }
            }
        }
    }
    for (NSInteger slot = 1; slot <= (NSInteger)kERShortcutSlotCount; slot++) {
        NSString *key = [NSString stringWithFormat:@"%ld", (long)slot];
        if ([occupied containsObject:key]) continue;
        ERShortcutSetSlotAssignment(slot, uuid);
        return ERShortcutSlotIdentifier(slot);
    }
    return nil;
}

// 把「模块已经不在控制中心里」的槽位绑定丢掉，让槽位重新可用。
static void ERShortcutReconcileSlots(void) {
    NSDictionary<NSString *, NSString *> *assignments = ERShortcutSlotAssignments();
    if (!assignments.count) return;
    id coordinatorClass = NSClassFromString(@"EchoRebornCoordinator");
    NSArray *enabled = nil;
    if (coordinatorClass && [coordinatorClass respondsToSelector:@selector(shared)]) {
        id coordinator = ((id (*)(id, SEL))objc_msgSend)(coordinatorClass, @selector(shared));
        if ([coordinator respondsToSelector:@selector(enabledModuleIdentifiers)]) {
            enabled = ((id (*)(id, SEL))objc_msgSend)(coordinator, @selector(enabledModuleIdentifiers));
        }
    }
    NSMutableDictionary<NSString *, NSString *> *next = [assignments mutableCopy];
    BOOL changed = NO;
    for (NSString *key in assignments) {
        NSString *slotIdentifier = ERShortcutSlotIdentifier(key.integerValue);
        if (slotIdentifier && enabled && ![enabled containsObject:slotIdentifier]) {
            [next removeObjectForKey:key];
            changed = YES;
        }
    }
    if (changed) {
        CFPreferencesSetAppValue((__bridge CFStringRef)kERShortcutSlotAssignmentsKey, (__bridge CFPropertyListRef)[next copy], kERPrefsDomain);
        CFPreferencesAppSynchronize(kERPrefsDomain);
    }
}

// 1.0.4：把老前缀归一成新前缀。凡是「按标识符查记录 / 去重 / 落盘」的地方都应该
// 先过这一道，老磁贴才能继续解析到同一条快捷指令记录。
static NSString *ERShortcutNormalizedIdentifier(NSString *identifier) {
    if (![identifier isKindOfClass:[NSString class]]) return identifier;
    if ([identifier hasPrefix:kERLegacyShortcutIdentifierPrefix]) {
        return [kERShortcutIdentifierPrefix stringByAppendingString:
                [identifier substringFromIndex:kERLegacyShortcutIdentifierPrefix.length]];
    }
    return identifier;
}

// Strips the "#N" duplicate suffix so lookups survive family resolution.
// 槽位标识符另外解析成该槽位绑定到的快捷指令。
static NSString *ERShortcutUUIDFromIdentifier(NSString *identifier) {
    if (!ERShortcutIdentifierIsShortcut(identifier)) return nil;
    NSInteger slot = ERShortcutSlotIndexFromIdentifier(identifier);
    if (slot > 0) return ERShortcutUUIDForSlot(slot);
    NSString *normalized = ERShortcutNormalizedIdentifier(identifier);
    NSString *uuid = [normalized substringFromIndex:kERShortcutIdentifierPrefix.length];
    NSRange marker = [uuid rangeOfString:@"#" options:NSBackwardsSearch];
    if (marker.location != NSNotFound) uuid = [uuid substringToIndex:marker.location];
    return uuid.length ? uuid : nil;
}

// ---------------------------------------------------------------------------
// 0.5.4: running a shortcut without bringing the Shortcuts app to the front.
//
// `shortcuts://run-shortcut?name=` is a *foreground* URL: opening it activates
// the Shortcuts app, which is why tapping a tile used to leave the user staring
// at Shortcuts instead of just seeing the shortcut's own banners.
//
// The system route for "run it in the background" is the private runner client
// in VoiceShortcutClient — the same one Control Center's own Shortcuts module,
// Back Tap and the Lock Screen widgets use. Hand it a workflow descriptor plus a
// run request whose presentation mode is the banner mode, then start it over
// XPC. Nothing comes to the foreground.
//
// Every step is private API, so each one is probed at runtime and the whole
// attempt is wrapped in @try/@catch. If anything is missing this returns NO and
// the caller falls back to the URL scheme, which still works — it just opens
// the app.
// EvoCenter16 的运行路径：按工作流标识符交给 WFSpringBoardWorkflowRunnerClient
// 在 SpringBoard 进程内执行，**永不前台化**快捷指令 App —— 这正是 EvoCenter16 的
// 磁贴「点了就直接跑」而不是把人弹进 App 的原因。拿不到就退回
// WFWorkflowRunnerClient 那条路。
static BOOL ERRunShortcutViaSpringBoardRunner(NSString *uuid) {
    if (!uuid.length) return NO;
    Class clientClass = NSClassFromString(@"WFSpringBoardWorkflowRunnerClient");
    if (!clientClass) { ERLogInfo(@"shortcut-run: WFSpringBoardWorkflowRunnerClient absent"); return NO; }
    SEL initSelector = NSSelectorFromString(@"initWithWorkflowIdentifier:");
    if (![clientClass instancesRespondToSelector:initSelector]) { ERLogInfo(@"shortcut-run: SpringBoard runner API missing"); return NO; }
    id client = nil;
    @try {
        client = ((id (*)(id, SEL, id))objc_msgSend)(((id (*)(id, SEL))objc_msgSend)(clientClass, @selector(alloc)), initSelector, uuid);
    } @catch (NSException *exception) {
        ERLogInfo(@"shortcut-run: SpringBoard runner init threw %@", exception.reason);
        client = nil;
    }
    if (!client) return NO;
    // 飞行途中 runner 自己驱动 XPC 会话，被释放会话就断了。留一个小环保活。
    static NSMutableArray *sLiveRunners = nil;
    static dispatch_once_t runnersOnce;
    dispatch_once(&runnersOnce, ^{ sLiveRunners = [NSMutableArray array]; });
    @synchronized (sLiveRunners) {
        [sLiveRunners addObject:client];
        while (sLiveRunners.count > 8) [sLiveRunners removeObjectAtIndex:0];
    }
    BOOL started = NO;
    @try {
        if ([client respondsToSelector:@selector(executeWithInput:)]) {
            ((void (*)(id, SEL, id))objc_msgSend)(client, @selector(executeWithInput:), nil);
            started = YES;
        } else if ([client respondsToSelector:@selector(start)]) {
            ((void (*)(id, SEL))objc_msgSend)(client, @selector(start));
            started = YES;
        }
    } @catch (NSException *exception) {
        ERLogInfo(@"shortcut-run: SpringBoard runner start threw %@", exception.reason);
        started = NO;
    }
    ERLogInfo(@"shortcut-run: WFSpringBoardWorkflowRunnerClient %@ for %@", started ? @"started" : @"failed", uuid);
    return started;
}

static BOOL ERRunShortcutInBackground(NSString *name, NSString *uuid) {
    static BOOL sVoiceShortcutClientAvailable = NO;
    static dispatch_once_t frameworksOnce;
    dispatch_once(&frameworksOnce, ^{
        BOOL voiceShortcutClient = dlopen("/System/Library/PrivateFrameworks/VoiceShortcutClient.framework/VoiceShortcutClient", RTLD_NOW) != NULL;
        BOOL workflowKit = dlopen("/System/Library/PrivateFrameworks/WorkflowKit.framework/WorkflowKit", RTLD_NOW) != NULL;
        sVoiceShortcutClientAvailable = voiceShortcutClient;
        ERLogInfo(@"shortcut-run: VoiceShortcutClient=%d WorkflowKit=%d", voiceShortcutClient, workflowKit);
    });
    // 首选：按工作流标识符走 SpringBoard 运行器。
    if (ERRunShortcutViaSpringBoardRunner(uuid)) return YES;
    if (!sVoiceShortcutClientAvailable) return NO;

    Class clientClass = NSClassFromString(@"WFWorkflowRunnerClient");
    Class requestClass = NSClassFromString(@"WFWorkflowRunRequest");
    SEL requestInit = NSSelectorFromString(@"initWithInput:presentationMode:");
    SEL clientInit = NSSelectorFromString(@"initWithDescriptor:runRequest:");
    if (!clientClass || !requestClass ||
        ![requestClass instancesRespondToSelector:requestInit] ||
        ![clientClass instancesRespondToSelector:clientInit]) {
        ERLogInfo(@"shortcut-run: runner API incomplete client=%d request=%d init=%d",
                   clientClass != nil, requestClass != nil,
                   [clientClass instancesRespondToSelector:clientInit]);
        return NO;
    }

    id descriptor = nil;
    @try {
        Class databaseClass = NSClassFromString(@"WFDatabase");
        if (!databaseClass) databaseClass = NSClassFromString(@"VCVoiceShortcutDatabase");
        id database = nil;
        if ([databaseClass respondsToSelector:@selector(defaultDatabase)]) {
            database = ((id (*)(id, SEL))objc_msgSend)(databaseClass, @selector(defaultDatabase));
        }
        NSArray<NSString *> *lookups = @[@"uniqueVisibleReferenceForWorkflowName:",
                                         @"referenceForWorkflowName:",
                                         @"uniqueVisibleReferenceForWorkflowUUIDString:",
                                         @"referenceForWorkflowUUIDString:"];
        for (NSString *lookupName in lookups) {
            SEL lookup = NSSelectorFromString(lookupName);
            if (![database respondsToSelector:lookup]) continue;
            NSString *argument = [lookupName containsString:@"UUID"] ? uuid : name;
            if (!argument.length) continue;
            descriptor = ((id (*)(id, SEL, id))objc_msgSend)(database, lookup, argument);
            ERLogInfo(@"shortcut-run: %@ %@", lookupName, descriptor ? @"hit" : @"miss");
            if (descriptor) break;
        }
    } @catch (NSException *exception) {
        ERLogInfo(@"shortcut-run: descriptor lookup threw %@", exception.reason);
        descriptor = nil;
    }
    if (!descriptor) {
        ERLogInfo(@"shortcut-run: no descriptor for name=%@ uuid=%@", name, uuid ?: @"(none)");
        return NO;
    }

    id request = nil;
    @try {
        request = ((id (*)(id, SEL, id, unsigned long long))objc_msgSend)(
            ((id (*)(id, SEL))objc_msgSend)(requestClass, @selector(alloc)), requestInit, nil, 0ULL);
        // Banner presentation. An explicit, non-zero output behaviour is
        // mandatory: without it the private run request finishes without error
        // and the shortcut never actually runs.
        if ([request respondsToSelector:@selector(setOutputBehavior:)]) {
            ((void (*)(id, SEL, unsigned long long))objc_msgSend)(request, @selector(setOutputBehavior:), 1ULL);
        }
    } @catch (NSException *exception) {
        ERLogInfo(@"shortcut-run: run request threw %@", exception.reason);
        return NO;
    }
    if (!request) return NO;

    id client = nil;
    @try {
        client = ((id (*)(id, SEL, id, id))objc_msgSend)(
            ((id (*)(id, SEL))objc_msgSend)(clientClass, @selector(alloc)), clientInit, descriptor, request);
    } @catch (NSException *exception) {
        ERLogInfo(@"shortcut-run: runner client threw %@", exception.reason);
        return NO;
    }
    if (!client) return NO;

    // The client drives the XPC conversation itself while the request is in
    // flight. Nothing else owns it, so without a strong reference it deallocates
    // the moment this function returns and the run is torn down before it has
    // started. Keep a short ring of the most recent runners alive.
    static NSMutableArray *sLiveRunners = nil;
    static dispatch_once_t runnersOnce;
    dispatch_once(&runnersOnce, ^{ sLiveRunners = [NSMutableArray array]; });
    @synchronized (sLiveRunners) {
        [sLiveRunners addObject:client];
        while (sLiveRunners.count > 8) [sLiveRunners removeObjectAtIndex:0];
    }

    BOOL started = NO;
    @try {
        if ([client respondsToSelector:@selector(start)]) {
            ((void (*)(id, SEL))objc_msgSend)(client, @selector(start));
            started = YES;
        }
    } @catch (NSException *exception) {
        ERLogInfo(@"shortcut-run: start threw %@", exception.reason);
        started = NO;
    }
    ERLogInfo(@"shortcut-run: %@ for \"%@\"", started ? @"started in background" : @"failed", name);
    return started;
}

// ---------------------------------------------------------------------------
// 1.0.6：磁贴账本 COSMICDuplicateFamilies 的坏账修复
// ---------------------------------------------------------------------------
// 这份字典是「哪些磁贴归插件管」的唯一账本：
//
//     identifier（新前缀） -> familyIdentifier
//
// 快捷指令磁贴的 family 就是它自己，所以值本来应当等于键。但更名前后的若干版本里
// 曾经落盘过「键正确、值是空串」的条目。一条这样的坏账会同时造成三个后果，
// 而它们合起来正是「快捷指令模块不显示，怎么弄都不回来」：
//
//   1) syncOwnedDuplicateModulesForOverlay: 里 `if (!baseIdentifier.length) continue;`
//      直接跳过 —— 磁贴永远不会被创建成子控制器。它不是被藏起来，是**根本没生成**，
//      所以屏幕上什么都没有，而且 SHORTCUTTILE 诊断也不会为它打印任何一行。
//   2) 「添加控制项」用 `gERDuplicateFamilies[identifier]` 判断「是否已添加」。空串是
//      非 nil 对象，判定为真 —— 于是这条快捷指令被判成「已经在控制中心里了」而从
//      候选列表里被隐藏。用户无法把它重新加回来，正是「怎么弄都不回来」。
//   3) 启动日志把账本条目数当成「已登记磁贴数」，于是日志说登记了 10 个，
//      实际上一个都没创建 —— 这条谎报让排查时长期盯着错误的环节。
//
// 修法：在读盘之后、任何使用之前，把坏账就地补成合法值。只补齐、不删除，
// 幂等，可重复执行。快捷指令磁贴补成键自身；其余模块的 family 在值缺失时
// 本来就由 ERDuplicateFamilyIdentifierForIdentifier 回落到标识符本身，语义一致。
static NSUInteger ERRepairDuplicateLedger(void) {
    if (!gERDuplicateFamilies.count) return 0;
    NSUInteger repaired = 0;
    NSUInteger dropped = 0;
    NSArray *keys = [gERDuplicateFamilies.allKeys copy];
    for (id key in keys) {
        if (![key isKindOfClass:[NSString class]]) {
            [gERDuplicateFamilies removeObjectForKey:key];
            dropped++;
            continue;
        }
        NSString *identifier = (NSString *)key;
        NSString *normalized = ERShortcutNormalizedIdentifier(identifier);
        if (![normalized isEqualToString:identifier]) {
            id value = gERDuplicateFamilies[key];
            if ([value isKindOfClass:[NSString class]]) value = ERShortcutNormalizedIdentifier((NSString *)value);
            [gERDuplicateFamilies removeObjectForKey:key];
            if (value && !gERDuplicateFamilies[normalized]) gERDuplicateFamilies[normalized] = value;
            identifier = normalized;
            repaired++;
        }
        id value = gERDuplicateFamilies[identifier];
        // 快捷指令磁贴的 family 恒等于它自己（addShortcutModuleToControlCenter: 就是
        // 这样写的）。所以只要值是空串、NSNull、非字符串，或者干脆指向别的模块，
        // 这条账就一定是坏的 —— 一律补成键自身。带 "#N" 后缀的编号标识符照旧
        // 保留指向无后缀 family 的关系，不在这里改写。
        if (ERShortcutIdentifierIsShortcut(identifier)) {
            BOOL valueIsShortcutIdentifier = [value isKindOfClass:[NSString class]] &&
                ERShortcutIdentifierIsShortcut((NSString *)value);
            if (!valueIsShortcutIdentifier) {
                gERDuplicateFamilies[identifier] = identifier;
                repaired++;
            }
            continue;
        }
        // 其余模块（原生模块的「再来一个」副本）的 family 必须由代码写死，
        // 值一旦缺失或非法就无法还原它属于谁。这类条目**剔除**而不是补成键自身：
        // 补成键自身等于凭空造出一块用户没要过的副本磁贴，而剔除最多只是让用户
        // 需要重新添加一次 —— 一个不可渲染的条目本来就没有在为用户做任何事。
        if (![value isKindOfClass:[NSString class]] || !((NSString *)value).length) {
            [gERDuplicateFamilies removeObjectForKey:identifier];
            dropped++;
        }
    }
    if (repaired || dropped) {
        ERSaveDuplicateFamilies();
        ERLogWarn(@"ledger: repaired %lu and dropped %lu owned-tile entr(ies) with empty/legacy values",
                  (unsigned long)repaired, (unsigned long)dropped);
    }
    return repaired + dropped;
}

// 账本里是否存在**可用**的条目。空值条目必须算「不存在」：它既不会渲染，
// 也不应该把对应的控制项从「添加控制项」里挡掉。
static BOOL ERDuplicateLedgerHasLiveEntry(NSString *identifier) {
    if (!identifier.length) return NO;
    id value = gERDuplicateFamilies[identifier];
    return [value isKindOfClass:[NSString class]] && ((NSString *)value).length > 0;
}

static NSString *ERShortcutSymbolNameForGlyph(unsigned short glyph) {
    static NSString *(*mapper)(unsigned short);
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        void *handle = dlopen("/System/Library/PrivateFrameworks/WorkflowKit.framework/WorkflowKit", RTLD_LAZY);
        if (handle) mapper = (NSString *(*)(unsigned short))dlsym(handle, "WFSystemImageNameForGlyphCharacter");
    });
    if (!mapper) return nil;
    @try { return mapper(glyph); } @catch (__unused NSException *exception) { return nil; }
}

static UIColor *ERShortcutColorFromValue(long long value) {
    if (value <= 0 || value > 0xFFFFFFFFLL) return nil;
    uint32_t rgba = (uint32_t)value;
    CGFloat red = ((rgba >> 24) & 0xFF) / 255.0;
    CGFloat green = ((rgba >> 16) & 0xFF) / 255.0;
    CGFloat blue = ((rgba >> 8) & 0xFF) / 255.0;
    CGFloat alpha = (rgba & 0xFF) / 255.0;
    if (alpha < 0.01) alpha = 1.0;
    return [UIColor colorWithRed:red green:green blue:blue alpha:alpha];
}

// Reads one icon row (ZSHORTCUTICON) by primary key, mapping columns by name.


// ---------------------------------------------------------------------------
// Shortcut store discovery
//
// The old reader only tried the shared Home path and NSHomeDirectory(), which
// on a jailbroken iOS 17 device can both resolve to /var/mobile — and on a
// roothide install SpringBoard's NSHomeDirectory() is not even guaranteed to
// be /var/mobile. Enumerate every plausible container instead: the shared
// group container, the Shortcuts app container, iCloud Drive, and the
// Mobile Documents tree. The per-container probes are directory-scoped (the
// home-relative candidate is dropped when the home path is /var/mobile, so
// nothing is scanned twice) because enumerating a whole data container is
// only affordable when it cannot be the large shared one.
// ---------------------------------------------------------------------------
static NSArray<NSDictionary *> *ERShortcutRecords(void);

// ---------------------------------------------------------------------------
// Shortcut snapshot for the Settings pane
//
// The pane runs in the Preferences process — a different sandbox from
// SpringBoard — so it cannot reuse the discovery stack below (dlopen'd
// libsqlite3, recursive container walks, Core Data version differences).
// SpringBoard therefore publishes what it actually fetched, and how the fetch
// went, to a small plist in the same directory as the diagnostics log, which
// both processes can reach. The pane renders that file verbatim.
//
// An empty `shortcuts` array in this file is the definitive answer to "did the
// tweak get the data?" — no. Two releases of log reading had to infer that
// indirectly, which is precisely why this file exists.
// ---------------------------------------------------------------------------
static NSString *const kERShortcutSnapshotFileName = @"shortcuts.plist";

// The gate between the Settings pane and the gallery. Stored as bare uuids so
// the pane can toggle a row without knowing how the tile identifier is built
// (kERShortcutIdentifierPrefix + uuid).
static NSString *const kERShortcutVisibleKey = @"ShortcutVisibleIdentifiers";

static NSArray<NSString *> *ERShortcutVisibleUUIDs(void) {
    NSMutableArray<NSString *> *uuids = [NSMutableArray array];
    for (id entry in ERPreferenceArray(kERShortcutVisibleKey)) {
        if ([entry isKindOfClass:[NSString class]] && [entry length] && ![uuids containsObject:entry]) {
            [uuids addObject:entry];
        }
    }
    return uuids;
}





// Re-scan on demand, requested by the pane's 重新扫描 button. The cache is
// dropped first so the button always does real work.
static void ERShortcutInvalidateCache(void);
static void ERShortcutRefreshNow(void);
// Path A: enumerate voice (Siri-added) shortcuts through INVoiceShortcutCenter
// from inside SpringBoard, so we never have to read Shortcuts' sandboxed SQLite
// file. Declared here; defined just below -ERShortcutRecords.

// How many sqlite files the last content scan opened. Published in the
// snapshot so the pane can distinguish "no container was reachable" from "the
// containers were walked and none of them held a ZSHORTCUT table".

// The files that scan actually opened, in order. Published alongside the count
// so a failing scan shows which paths were tried rather than only how many.
static NSArray<NSString *> *gERShortcutProbedPaths = nil;

// Path A state: results of the INVoiceShortcutCenter enumeration. When
// `intentsDone` is set and `intentsRecords` is non-empty, -ERShortcutRecords
// returns these directly and the SQLite sandbox fight is skipped entirely.
static NSArray<NSDictionary *> *gERShortcutIntentsRecords = nil;
static BOOL gERShortcutIntentsDone = NO;
static BOOL gERShortcutIntentsTried = NO;

// Consumed by the next -ERShortcutRecords call, which then drops all three of
// its caches so the scan genuinely re-runs.
static BOOL gERShortcutForceRefresh = NO;

// Second stage of the same force. -ERShortcutsDatabasePath keeps its own
// "store discovered" memo, and that one has to be dropped too or a rescan
// would re-report the file it already decided about without looking again.
static BOOL gERShortcutForceRescan = NO;

static void ERShortcutInvalidateCache(void) {
    gERShortcutForceRefresh = YES;
    // A 重新扫描 also re-runs the Intents enumeration so newly added Siri
    // shortcuts show up without a respring.
    gERShortcutIntentsTried = NO;
    gERShortcutIntentsDone = NO;
    gERShortcutIntentsRecords = nil;
}



// Where per-application data containers live.
//
// Data/Application alone is not enough. On current iOS the Shortcuts store is
// shared between the Shortcuts app, Siri and the widgets, so Core Data keeps it
// in the AppGroup container (group.com.apple.WorkflowKit) rather than in the
// app's own data container. 0.4.1-3 found the com.apple.shortcuts containers
// correctly and still reported "Shortcuts.sqlite not found in any known
// location" for exactly this reason — it never looked inside Shared/AppGroup.


// The data container of a bundle identifier, asked of the container manager
// rather than assembled by hand.
//
// 0.4.4 REWRITE — this function crashed SpringBoard in 0.4.3, and the crash
// report says exactly why.
//
// 0.4.3 called dlsym("container_copy_path") and declared it
//     CFStringRef (*)(CFStringRef)
// That symbol is real and exported, so the NULL check passed and the call went
// through — but it is NOT a caller-facing identifier->path function. It is an
// internal helper of the container_object_t family and takes a
// container_object_t as its first argument, not a CFStringRef. Passing a
// CFString where an object was expected made the callee treat the string's
// first bytes as an object pointer:
//
//     __container_copy_path_block_invoke
//       container_object_get_uuid
//         xpc_data_get_bytes_ptr
//           object_getClass            <- dereferences the "object"
//
// and object_getClass("Shortcut") faults at 0x74756374726f6853 — that value IS
// the ASCII bytes "Shortcut". The register dump in both crash reports has
// x[0] = 0x74756374726f6853, and both reports fault on the main thread inside
// container_copy_path. A @try/@catch cannot help: a bad pointer dereference is
// a SIGSEGV, not an Objective-C exception, so the defensive catch in 0.4.3
// never ran.
//
// The lesson is not "wrap it better" — it is "do not guess a private symbol's
// prototype". The supported, object-oriented way to ask for a container path
// is the query API, which is what SpringBoard-adjacent code actually uses and
// what its own symbols say it takes:
//
//     container_query_create()
//     container_query_set_class(query, class)        // 2 = app data, 7 = app group
//     container_query_set_identifiers(query, xpc)    // or _set_group_identifiers
//     container_query_get_single_result(query)       // borrowed container_object_t
//     container_object_get_path(object)              // const char *
//
// Every one of those — plus the two xpc helpers used to build the identifier
// argument — is dlsym'd and NULL-checked, and every one that returns an owned
// object is released with the matching *_free. If any symbol is missing on a
// given iOS build the function returns an empty array and the filesystem walk
// below still runs — degraded, never fatal.


// The Shortcuts data containers, matched on the owning bundle identifier
// because the container UUID changes between installs.
//
// 0.4.2 REWRITE. The 0.4.1-3 widening made this function strictly worse on a
// real device and the 2026-09-12 log proves it: it returned 22 containers of
// which NONE was a Shortcuts container. The cause was the fallback. When the
// metadata plist could not be read (which is the normal case for another app's
// container from SpringBoard) it accepted a container that merely had
// "shortcut" or "workflow" SOMEWHERE in its name, or that held a
// Library/Application Support or Library/Mobile Documents subdirectory with a
// shortcut-named entry in it. Almost every app has the former, and
// Library/Application Support exists in every container, so the fallback was
// effectively "accept almost everything":
//
//   - 17 PluginKitPlugin containers (extensions have no Shortcuts data at all)
//   - the com.apple.shortcuts UI container, which holds only Caches and
//     HTTPStorages
//   - an AppGroup whose only Shortcuts-shaped content is the WFDiskCache the
//     very widening was supposed to stop matching
//
// Those 22 containers then produced 66 hand-assembled candidate paths, which
// is exactly what the WARN line listed. Narrowing the matcher cannot by itself
// fix this, because the container that DOES hold the store is unrecognisable
// from its name and its metadata is unreadable. So the matcher is not the
// mechanism that finds the store any more; it is only a fast path. The real
// mechanism is -ERContainerHoldsShortcutStore below, which identifies the
// container by content: the marker files that a container carrying the
// Shortcuts Core Data store must contain. A miss is therefore a search
// failure, not a matching failure, and a search cannot be tricked by a name.

// `/private/var/x` and `/var/x` name the same file on iOS, and ERDataContainerRoots
// lists the container roots under BOTH spellings. Without collapsing them every
// container is found twice: the 2026-09-12 13:43 log reported 44 containers where
// the device has 22, and the content walk then paid for every directory twice.


// Is this path an existing regular file — i.e. something SQLite could open?
//
// This exists because -fileExistsAtPath: answers YES for a DIRECTORY, and the
// candidate list below deliberately contains directories (the container-relative
// roots the store is looked for in). 0.4.4 matched one of those directories and
// returned it as "the store": the 2026-09-12 13:43 log resolved
//
//     /var/mobile/Containers/Data/Application/C762A96E-.../Documents
//
// which is a directory. `Shortcuts: using store` printed it, copying it failed,
// and SQLite answered "unable to open database file" — while the content walk
// that would have found the real store never ran at all, because that directory
// had already satisfied the cheap fixed-candidate pass. A directory is never a
// store; the store is a file. Every existence test that can lead to "this is the
// database" must therefore demand a regular file.




// Content evidence that a container carries the Shortcuts Core Data store or
// its Core Data version/lock files. None of these is a name test: they are the
// sidecar files Core Data itself creates next to a store, plus the two path
// fragments the store has actually been seen under. A cache-only container
// (the 0.4.2 false positives) cannot satisfy any of them.


// Collects candidate Core Data stores at or below `root`.
//
// 0.4.2 REWRITE. The 0.4.1-3 version accepted every extensionless file so that
// a store Core Data had named `Shortcuts` would not be missed. On a real
// device that rule is what broke the scan. The 2026-09-12 log shows what it
// actually collected: 24 of the 28 probed files were
// Caches/com.apple.shortcuts/fsCachedData/<UUID> — URL cache blobs, which are
// extensionless by construction and massively outnumber any real store. The
// one genuine store would have been somewhere in the same list, but the depth
// limit and the directory choice meant it was never reached at all.
//
// Both halves are fixed. The extensionless rule is gone: a file must carry a
// store-shaped extension to be offered, and Core Data's own extensionless
// naming is covered by the explicit `Shortcuts` candidate the caller adds by
// name instead. And everything under a Caches or HTTPStorages directory is
// skipped outright — a Core Data store that is the source of truth for user
// data cannot live in a directory iOS is allowed to purge at any time, so
// pruning those subtrees removes the entire false-positive class by
// construction rather than by pattern. The pruning lives in
// -ERDirectoryIsWorthWalking below, which rejects the directory before it is
// read; there is deliberately no path-shaped variant, because a rule keyed on
// the path would have to be applied after the read it is meant to prevent.


// Directory names that can never hold the store, skipped before the directory
// read rather than after: the log's 28 candidates were all under one of these,
// and pruning them at the source is what removes the noise from the report.




// Every store-shaped file that could plausibly be Shortcuts', ordered so the
// files whose name mentions Shortcuts are tried first and the cheap
// recognisable hit wins before anything else has to be opened.
//
// 0.4.2 REWRITE — the ordering is reversed, and it is the single most
// important change in this release. The 0.4.1-3 version walked the containers
// first (depth 6, everything, caches included) and appended the explicit
// paths afterwards. On the user's device the container walk produced 28
// candidates that were all cache files, so the cheap explicit candidates were
// never opened: the store would have been found if it had been looked for at
// the one path that was already known, but 28 worthless probes had to fail
// first. Shallow-then-deep is also the correct order on its own merits — the
// explicit list is tens of stat calls whose hit rate is far higher than any
// recursive walk.


// Opens `path` and asks whether it has a ZSHORTCUT table. A WAL store whose
// -shm sidecar cannot be mapped refuses a read-only open, so that case falls
// back to the same copy-then-open the real reader uses.




static NSArray<NSDictionary *> *ERShortcutRecords(void) {
    static NSArray<NSDictionary *> *records;
    static CFAbsoluteTime cachedAt = 0.0;
    static BOOL loadFailed = NO;
    CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
    // Checked before every cache test so the pane's 重新扫描 always wins.
    if (gERShortcutForceRefresh) {
        gERShortcutForceRefresh = NO;
        gERShortcutForceRescan = YES;
        records = nil;
        cachedAt = 0.0;
        loadFailed = NO;
    }
    if (records && now - cachedAt < 15.0) return records;
    // process. See ERShortcutScanner in the prefs subproject.
    // 0.5.1: the catalog is written by the Settings pane, which runs in a
    // different process. CFPreferences answers from a per-process cache, so
    // without an explicit synchronize SpringBoard keeps returning the values it
    // first read and shortcuts added afterwards never show up.
    CFPreferencesAppSynchronize(kERPrefsDomain);
    NSArray *catalog = ERPreferenceArray(@"ShortcutCatalog");
    if ([catalog isKindOfClass:[NSArray class]] && catalog.count) {
        records = [catalog copy];
        cachedAt = now;
        ERLogInfo(@"Shortcuts: served %lu shortcut(s) from Settings-published catalog",
                   (unsigned long)records.count);
        return records;
    }
    if (loadFailed && now - cachedAt < 5.0) return records ?: @[];
    cachedAt = now;
    loadFailed = YES;
    records = @[];
    ERLogInfo(@"Shortcuts: no catalog published by Settings yet (open Settings ▸ EchoReborn ▸ 快捷指令 to populate it)");
    return records;
}

// One full load with every cache ignored, then a republished snapshot. Driven
// by the Darwin notification the Settings pane posts from its 重新扫描 button,
// so the pane can always force a fresh answer to "did the tweak get the data?"
// without respringing SpringBoard.
static void ERShortcutRefreshNow(void) {
    ERShortcutInvalidateCache();
    NSArray<NSDictionary *> *loaded = ERShortcutRecords();
    ERLogInfo(@"Shortcuts: manual rescan from Settings -> %lu shortcut(s) fetched",
               (unsigned long)loaded.count);
}

// Path A: read the user's voice (Siri-added) shortcuts straight from
// INVoiceShortcutCenter, running inside SpringBoard. This never touches the
// Shortcuts app's sandboxed SQLite file, so the sandbox refusal that blocks the
// SQLite path (home domain exists=0) is sidestepped entirely.
//
// The class/method are resolved at runtime rather than via <Intents/Intents.h>
// so the build does not depend on the SDK shipping Intents headers (the same
// reason the xpc types are declared locally). If either is missing — older iOS,
// or the entitlement is withheld — the call logs and falls through to the
// SQLite fallback; it is never fatal.


static NSDictionary *ERShortcutForIdentifier(NSString *identifier) {
    NSString *uuid = ERShortcutUUIDFromIdentifier(identifier);
    if (!uuid) return nil;
    for (NSDictionary *record in ERShortcutRecords()) {
        if ([record[@"uuid"] isKindOfClass:[NSString class]] && [record[@"uuid"] isEqualToString:uuid]) return record;
    }
    return nil;
}

// Renders the shortcut's native look: its own background colour rounded
// square plus its glyph (SF Symbol via WorkflowKit's own mapping, or the
// custom image when the shortcut uses one).
static UIImage *ERShortcutIconImage(NSDictionary *shortcut) {
    if (![shortcut isKindOfClass:[NSDictionary class]]) return nil;
    static NSMutableDictionary<NSString *, UIImage *> *cache;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{ cache = [NSMutableDictionary dictionary]; });
    NSString *cacheKey = [NSString stringWithFormat:@"%@|%lld|%lu",
                          shortcut[@"uuid"] ?: @"", (long long)[shortcut[@"color"] longLongValue],
                          (unsigned long)[shortcut[@"glyph"] unsignedIntegerValue]];
    UIImage *cached = cache[cacheKey];
    if (cached) return cached;
    NSData *imageData = [shortcut[@"imageData"] isKindOfClass:[NSData class]] ? shortcut[@"imageData"] : nil;
    UIImage *customImage = imageData.length ? [UIImage imageWithData:imageData] : nil;
    UIColor *background = ERShortcutColorFromValue([shortcut[@"color"] longLongValue]);
    UIImage *glyphImage = nil;
    BOOL fullBleedImage = NO;
    if (customImage && !background) {
        // A photo-style icon fills the whole tile.
        fullBleedImage = YES;
        glyphImage = customImage;
    } else if (customImage) {
        glyphImage = customImage;
    } else {
        NSString *symbolName = ERShortcutSymbolNameForGlyph((unsigned short)[shortcut[@"glyph"] unsignedShortValue]);
        if (!symbolName.length) symbolName = @"sparkles";
        UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:64.0 weight:UIImageSymbolWeightMedium];
        glyphImage = [UIImage systemImageNamed:symbolName withConfiguration:configuration] ?: [UIImage systemImageNamed:@"sparkles"];
    }
    CGSize size = CGSizeMake(120.0, 120.0);
    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:size];
    __block UIImage *result = nil;
    result = [renderer imageWithActions:^(UIGraphicsImageRendererContext * _Nonnull context) {
        CGRect rect = CGRectMake(0.0, 0.0, size.width, size.height);
        UIBezierPath *backgroundPath = [UIBezierPath bezierPathWithRoundedRect:CGRectInset(rect, 3.0, 3.0) cornerRadius:28.0];
        UIColor *fill = background ?: [UIColor colorWithRed:0.11 green:0.60 blue:0.97 alpha:1.0];
        [fill setFill];
        [backgroundPath fill];
        if (glyphImage) {
            UIImage *drawable = glyphImage;
            if (!fullBleedImage) {
                drawable = [glyphImage imageWithTintColor:UIColor.whiteColor renderingMode:UIImageRenderingModeAlwaysOriginal] ?: glyphImage;
            }
            if (drawable) {
                CGFloat side = fullBleedImage ? size.width - 6.0 : size.width * 0.52;
                CGRect glyphRect = CGRectMake((size.width - side) * 0.5, (size.height - side) * 0.5, side, side);
                [drawable drawInRect:glyphRect];
            }
        }
    }];
    if (result) cache[cacheKey] = result;
    return result;
}

static UIView *ERFindStockButtonForModuleView(UIView *moduleView) {
    if (!moduleView) return nil;
    UIView *container = moduleView.superview;
    while (container) {
        NSString *className = NSStringFromClass(container.class);
        if ([className containsString:@"ContentModuleContainer"] || [className containsString:@"ModuleContainer"]) break;
        container = container.superview;
    }
    if (container) {
        UIView *found = ERFindSubviewWithClassName(container, @"CCUIButtonModuleView");
        if (found) return found;
    }
    for (UIView *candidate = moduleView.superview; candidate; candidate = candidate.superview) {
        UIView *found = ERFindSubviewWithClassName(candidate, @"CCUIButtonModuleView");
        if (found) return found;
    }
    return nil;
}

static NSString *ERFriendlyNameForIdentifier(NSString *identifier) {
    if (ERShortcutIdentifierIsShortcut(identifier)) {
        NSDictionary *shortcut = ERShortcutForIdentifier(identifier);
        if ([shortcut[@"name"] isKindOfClass:[NSString class]]) return shortcut[@"name"];
        return @"快捷指令";
    }
    NSString *lower = identifier.lowercaseString;
    // Needles verified against /System/Library/ControlCenter/Bundles on iOS 16.
    NSDictionary<NSString *, NSString *> *known = @{
        @"echoreborn.connectivity.airplane": @"飞行模式",
        @"echoreborn.connectivity.wifi": @"无线局域网",
        @"echoreborn.connectivity.airdrop": @"隔空投送",
        @"echoreborn.connectivity.cellular": @"蜂窝数据",
        @"echoreborn.connectivity.bluetooth": @"蓝牙",
        @"echoreborn.connectivity.hotspot": @"个人热点",
        @"echoreborn.connectivity.vpn": @"VPN",
        // 1.0.6-2：「实用工具」卡片里的天气磁贴（ERWeatherModule.bundle）。
        // 必须在表里，否则会落到 bundle 的 CFBundleDisplayName，虽然也写着「天气」，
        // 但那条路径只在 bundle 目录扫描命中时才有效，这里显式登记才是权威来源。
        @"echoreborn.weather": @"天气",
        @"orientationlock": @"方向锁定",
        @"focusui": @"专注模式",
        @"nowplaying": @"正在播放",
        @"controlcenter.audio": @"音量",
        @"displaymodule": @"亮度",
        @"connectivitymodule": @"连接",
        @"appearancemodule": @"深色模式",
        @"lowpowermodule": @"低电量模式",
        @"qrcodemodule": @"扫描二维码",
        @"controlcenter.timer": @"计时器",
        @"flashlightmodule": @"手电筒",
        @"control-center.stopwatch": @"秒表",
        @"autobrightness": @"自动亮度",
        @"accessibility.controlcenter.general": @"辅助功能快捷键",
        @"accessibility.controlcenter.guidedaccess": @"引导式访问",
        @"accessibility.controlcenter.sounddetection": @"声音识别",
        @"accessibility.controlcenter.text.size": @"文字大小",
        @"accessibility.controlcenter.hearingdevices": @"听觉",
        @"controlcenter.screencapture": @"屏幕录制",
        @"shazamkit": @"音乐识别",
        @"airplaymirroring": @"屏幕镜像",
        @"spokennotifications": @"朗读通知",
        @"silencecalls": @"静音来电",
        @"nfccontrolcenter": @"NFC 标签读取器",
        @"keyboardbrightness": @"键盘亮度",
        @"systempapercontrolcenter": @"备忘录",
        @"control-center.quicknote": @"快速备忘录",
        @"home.compactcontrolcenter": @"家庭",
        @"home.controlcenter": @"家庭控制",
        @"appletvremote": @"Apple TV 遥控器",
        @"voicememos": @"语音备忘录",
        @"walletmodule": @"钱包",
        @"feedbackassistant": @"反馈助手",
        @"mutemodule": @"静音模式",
    };
    for (NSString *needle in known) {
        if ([lower containsString:needle]) return known[needle];
    }
    return nil;
}

static id ERDynamicSharedInstance(NSString *className) {
    Class cls = NSClassFromString(className);
    return [cls respondsToSelector:@selector(sharedInstance)] ? ((id (*)(id, SEL))objc_msgSend)(cls, @selector(sharedInstance)) : nil;
}

static id ERDynamicValue(id target, NSArray<NSString *> *selectors) {
    for (NSString *selectorName in selectors) {
        SEL selector = NSSelectorFromString(selectorName);
        if ([target respondsToSelector:selector]) return ((id (*)(id, SEL))objc_msgSend)(target, selector);
    }
    return nil;
}

static BOOL ERDynamicBool(id target, NSArray<NSString *> *selectors, BOOL fallback) {
    for (NSString *selectorName in selectors) {
        SEL selector = NSSelectorFromString(selectorName);
        if ([target respondsToSelector:selector]) return ((BOOL (*)(id, SEL))objc_msgSend)(target, selector);
    }
    return fallback;
}

static BOOL ERDynamicSetBool(id target, NSArray<NSString *> *selectors, BOOL value) {
    for (NSString *selectorName in selectors) {
        SEL selector = NSSelectorFromString(selectorName);
        if (![target respondsToSelector:selector]) continue;
        NSMethodSignature *signature = [target methodSignatureForSelector:selector];
        const char *returnType = signature.methodReturnType;
        if (returnType && (returnType[0] == @encode(BOOL)[0] || returnType[0] == @encode(bool)[0])) {
            BOOL accepted = ((BOOL (*)(id, SEL, BOOL))objc_msgSend)(target, selector, value);
            if (accepted) return YES;
            continue;
        }
        ((void (*)(id, SEL, BOOL))objc_msgSend)(target, selector, value);
        return YES;
    }
    return NO;
}

// ---------------------------------------------------------------------------
// Cellular data (蜂窝数据) state
//
// The CoreTelephonyClient route this used to rely on is unusable as written:
// CoreTelephonyClient has no +sharedInstance — it is built with
// -initWithQueue: — so ERDynamicSharedInstance always returned nil and the
// cellular tile was permanently "off" regardless of the real radio state. That
// is precisely the report "移动蜂窝，我明明是打开的但是没有".
//
// Three sources, cheapest first. Any one that produces an answer wins:
//   1. A properly constructed CoreTelephonyClient and its
//      getCellularDataEnabled:error: accessor.
//   2. CTSettingCopyCellularDataEnabled() from the CoreTelephony C API.
//   3. The system proxy dictionary, which reflects a live cellular data
//      interface the same way the VPN check does.
// ---------------------------------------------------------------------------
static id ERCellularClient(void) {
    static id client = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        Class clientClass = NSClassFromString(@"CoreTelephonyClient");
        if (!clientClass) return;
        // There is no documented singleton; build one on a private queue the
        // way the framework itself does.
        id candidate = nil;
        SEL initWithQueue = NSSelectorFromString(@"initWithQueue:");
        if ([clientClass instancesRespondToSelector:initWithQueue]) {
            dispatch_queue_t queue = dispatch_queue_create("com.strive.echoreborn.cellular", DISPATCH_QUEUE_SERIAL);
            @try { candidate = ((id (*)(id, SEL, dispatch_queue_t))objc_msgSend)([clientClass alloc], initWithQueue, queue); } @catch (__unused NSException *exception) { candidate = nil; }
        }
        if (!candidate) {
            SEL initWithQueueAndError = NSSelectorFromString(@"initWithQueue:error:");
            if ([clientClass instancesRespondToSelector:initWithQueueAndError]) {
                dispatch_queue_t queue = dispatch_queue_create("com.strive.echoreborn.cellular", DISPATCH_QUEUE_SERIAL);
                @try { candidate = ((id (*)(id, SEL, dispatch_queue_t, void *))objc_msgSend)([clientClass alloc], initWithQueueAndError, queue, NULL); } @catch (__unused NSException *exception) { candidate = nil; }
            }
        }
        client = candidate;
    });
    return client;
}

static BOOL ERCellularDataEnabled(BOOL *answered) {
    if (answered) *answered = NO;
    // 1. CoreTelephonyClient getCellularDataEnabled:error:
    id client = ERCellularClient();
    SEL accessor = NSSelectorFromString(@"getCellularDataEnabled:");
    if (client && [client respondsToSelector:accessor]) {
        // The error out-parameter is `NSError *__autoreleasing *`. Passing NULL
        // is valid for every CoreTelephonyClient accessor of this shape.
        @try {
            BOOL accepted = ((BOOL (*)(id, SEL, void *))objc_msgSend)(client, accessor, NULL);
            if (answered) *answered = YES;
            return accepted;
        } @catch (__unused NSException *exception) { /* fall through */ }
    }
    // 2. The CoreTelephony C API. CTSettingCopyCellularDataEnabled returns a
    //    CFBoolean-ish object; it survives when the Objective-C client does not.
    void *handle = dlopen("/System/Library/Frameworks/CoreTelephony.framework/CoreTelephony", RTLD_LAZY);
    if (handle) {
        typedef void *(*CTSettingCopyCellularDataEnabledFn)(void);
        CTSettingCopyCellularDataEnabledFn fn =
            (CTSettingCopyCellularDataEnabledFn)dlsym(handle, "CTSettingCopyCellularDataEnabled");
        if (fn) {
            void *result = fn();
            if (result) {
                if (answered) *answered = YES;
                return CFBooleanGetValue((CFBooleanRef)result);
            }
        }
    }
    // 3. A live cellular data interface in the proxy dictionary.
    NSDictionary *settings = (__bridge_transfer NSDictionary *)CFNetworkCopySystemProxySettings();
    NSDictionary *scoped = settings[@"__SCOPED__"];
    if ([scoped isKindOfClass:[NSDictionary class]]) {
        for (NSString *key in scoped.allKeys) {
            NSString *name = key.lowercaseString;
            if ([name hasPrefix:@"pdp"] || [name containsString:@"wwan"] || [name containsString:@"cellular"]) {
                if (answered) *answered = YES;
                return YES;
            }
        }
    }
    return NO;
}

// RadiosPreferences (airplane mode) lives in the private Preferences framework.
//
// SpringBoard does not link it, so NSClassFromString returns nil until the
// framework is dlopen'd. Every read and write goes through this one accessor so
// the dlopen and the cached instance happen exactly once, and so a build that
// genuinely lacks the class degrades to nil instead of throwing.
static id ERRadiosPreferences(void) {
    static id radios = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        dlopen("/System/Library/PrivateFrameworks/Preferences.framework/Preferences", RTLD_LAZY);
        Class cls = NSClassFromString(@"RadiosPreferences");
        if (cls) {
            @try { radios = [cls new]; } @catch (__unused NSException *exception) { radios = nil; }
        }
    });
    return radios;
}

// Personal Hotspot state.
//
// SBTetheringController is the SpringBoard-side manager and it does exist on
// iOS 16/17, but it is not the only place the state lives and it is not always
// loaded early. TetheringManager (the Tethering private framework) and the
// preferences domain both answer too, so all three are consulted in order.
static BOOL ERHotspotEnabled(void) {
    id tethering = ERDynamicSharedInstance(@"SBTetheringController");
    NSArray<NSString *> *keys = @[@"isPersonalHotspotEnabled", @"personalHotspotEnabled", @"tetheringEnabled", @"isTetheringActive"];
    if (tethering) {
        for (NSString *key in keys) {
            SEL selector = NSSelectorFromString(key);
            if ([tethering respondsToSelector:selector]) return ((BOOL (*)(id, SEL))objc_msgSend)(tethering, selector);
        }
    }
    id manager = ERDynamicSharedInstance(@"TetheringManager");
    if (manager) {
        for (NSString *key in keys) {
            SEL selector = NSSelectorFromString(key);
            if ([manager respondsToSelector:selector]) return ((BOOL (*)(id, SEL))objc_msgSend)(manager, selector);
        }
    }
    // The system-wide preference is written whenever the user flips the switch,
    // so it is a dependable last resort even when no manager is reachable.
    CFPropertyListRef value = CFPreferencesCopyAppValue(CFSTR("HostsPersonalHotspotEnabled"),
                                                        CFSTR("com.apple.MobileInternetSharing"));
    if (value) {
        BOOL enabled = CFBooleanGetValue((CFBooleanRef)value);
        CFRelease(value);
        return enabled;
    }
    return NO;
}

static BOOL ERSetHotspotEnabled(BOOL enabled) {
    id tethering = ERDynamicSharedInstance(@"SBTetheringController");
    if (ERDynamicSetBool(tethering, @[@"setPersonalHotspotEnabled:", @"setTetheringEnabled:"], enabled)) return YES;
    id manager = ERDynamicSharedInstance(@"TetheringManager");
    if (ERDynamicSetBool(manager, @[@"setTetheringEnabled:", @"setPersonalHotspotEnabled:"], enabled)) return YES;
    // Writing the preference is what the Settings toggle ultimately does; the
    // daemon picks it up and mirrors it back into the managers.
    CFPreferencesSetAppValue(CFSTR("HostsPersonalHotspotEnabled"),
                            enabled ? kCFBooleanTrue : kCFBooleanFalse,
                            CFSTR("com.apple.MobileInternetSharing"));
    CFPreferencesAppSynchronize(CFSTR("com.apple.MobileInternetSharing"));
    return YES;
}

static BOOL ERSetBluetoothEnabled(BOOL enabled) {
    id manager = ERDynamicSharedInstance(@"BluetoothManager");
    BOOL changed = NO;
    for (NSString *selectorName in @[@"setPowered:", @"setEnabled:"]) {
        SEL selector = NSSelectorFromString(selectorName);
        if (![manager respondsToSelector:selector]) continue;
        BOOL accepted = ((BOOL (*)(id, SEL, BOOL))objc_msgSend)(manager, selector, enabled);
        changed = changed || accepted;
    }
    return changed;
}

static BOOL ERConnectivitySelectedForIdentifier(NSString *identifier);
static BOOL ERConnectivityActiveForIdentifier(NSString *identifier);

// Number of Bluetooth devices currently connected.
//
// BluetoothManager.connectedDevices is the primary source, but it is not always
// populated the moment the tile is laid out (the manager refreshes on its own
// cadence), and on some builds it only lists *paired* devices. Both are handled:
// only entries that report themselves connected are counted, so a paired-but-
// idle device does not inflate the number, which is what "连接几个即显示几"
// requires.
static NSUInteger ERBluetoothConnectedDeviceCount(void) {
    id manager = ERDynamicSharedInstance(@"BluetoothManager");
    NSArray *devices = nil;
    @try { devices = ERDynamicValue(manager, @[@"connectedDevices"]); } @catch (__unused NSException *exception) { devices = nil; }
    if (![devices respondsToSelector:@selector(count)]) return 0;
    NSUInteger connected = 0;
    for (id device in devices) {
        // A device object may or may not expose a connection flag. When the
        // flag exists, honour it. When it does not, the mere presence of the
        // object in `connectedDevices` is the only signal available, so count
        // it — otherwise every device would be dropped and the count would
        // always read 0.
        SEL isConnected = NSSelectorFromString(@"isConnected");
        SEL connectedSelector = NSSelectorFromString(@"connected");
        if ([device respondsToSelector:isConnected]) {
            if (((BOOL (*)(id, SEL))objc_msgSend)(device, isConnected)) connected++;
        } else if ([device respondsToSelector:connectedSelector]) {
            if (((BOOL (*)(id, SEL))objc_msgSend)(device, connectedSelector)) connected++;
        } else {
            connected++;
        }
    }
    return connected;
}

// The caption under 蓝牙: how many devices are connected.
//
// Three states, in order of specificity:
//   * radio off            → 「关闭」
//   * on, nothing paired   → 「打开」
//   * on, N connected      → 「N个设备已连接」
// The count is phrased as a sentence rather than a bare digit, because a lone
// number under the tile gives no hint that it is a device count.
static NSString *ERBluetoothStatusText(void) {
    id manager = ERDynamicSharedInstance(@"BluetoothManager");
    if (!ERDynamicBool(manager, @[@"enabled", @"powered"], NO)) return @"关闭";
    NSUInteger count = ERBluetoothConnectedDeviceCount();
    if (count == 0) return @"打开";
    return [NSString stringWithFormat:@"%lu个设备已连接", (unsigned long)count];
}

static NSString *ERConnectivityStatusForIdentifier(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    if (![lower containsString:@"echoreborn.connectivity"]) return nil;
    if ([lower containsString:@".wifi"]) {
        id manager = ERDynamicSharedInstance(@"SBWiFiManager") ?: ERDynamicSharedInstance(@"WiFiManager");
        id name = ERDynamicValue(manager, @[@"currentNetworkName", @"networkName"]);
        if ([name isKindOfClass:[NSString class]] && [name length]) return name;
        // Radio on but not associated: 「打开」. Radio off: 「关闭」. The two are
        // distinct on-purpose, because "on with no network" and "off" look
        // identical on the tile otherwise.
        BOOL enabled = ERDynamicBool(manager, @[@"wiFiEnabled", @"isWiFiEnabled", @"enabled", @"isEnabled", @"powered"], NO);
        return enabled ? @"打开" : @"关闭";
    }
    if ([lower containsString:@".bluetooth"]) return ERBluetoothStatusText();
    if ([lower containsString:@".airdrop"]) {
        // AirDrop's receiving scope, read from sharingd. The raw values are
        // English ("Everyone" / "Contacts Only" / "Off") because that is how
        // sharingd stores them; the tile shows the Chinese label the rest of
        // Control Center uses.
        NSString *value = (__bridge_transfer NSString *)CFPreferencesCopyAppValue(CFSTR("DiscoverableMode"), CFSTR("com.apple.sharingd"));
        if ([value isEqualToString:@"Everyone"]) return @"所有人";
        if ([value isEqualToString:@"Contacts Only"] || [value isEqualToString:@"Contacts"]) return @"仅限联系人";
        return @"关闭";
    }
    if ([lower containsString:@".airplane"]) {
        BOOL enabled = ERDynamicBool(ERRadiosPreferences(), @[@"airplaneMode", @"isAirplaneMode"], NO);
        return enabled ? @"打开" : @"关闭";
    }
    if ([lower containsString:@".cellular"]) {
        BOOL answered = NO;
        BOOL enabled = ERCellularDataEnabled(&answered);
        // Only claim a network name while data is actually on; otherwise a tile
        // that is switched off would still advertise the carrier.
        if (answered && !enabled) return @"关闭";
        NSString *carrier = nil;
        id client = ERCellularClient();
        for (NSString *selectorName in @[@"carrierName", @"serviceProviderName"]) {
            SEL selector = NSSelectorFromString(selectorName);
            if (![client respondsToSelector:selector]) continue;
            @try {
                NSString *value = ((NSString *(*)(id, SEL))objc_msgSend)(client, selector);
                if ([value isKindOfClass:[NSString class]] && value.length) { carrier = value; break; }
            } @catch (__unused NSException *exception) { /* ignore */ }
        }
        if (carrier.length && (!answered || enabled)) return carrier;
        if (!answered && !ERConnectivitySelectedForIdentifier(identifier)) return @"关闭";
        return @"打开";
    }
    if ([lower containsString:@".hotspot"]) {
        // 个人热点 is the one module with its own closed caption.
        return ERHotspotEnabled() ? @"打开" : @"不可被发现";
    }
    if ([lower containsString:@".vpn"]) return ERConnectivitySelectedForIdentifier(identifier) ? @"已连接" : @"未连接";
    return nil;
}

static BOOL ERConnectivitySelectedForIdentifier(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    if (![lower containsString:@"echoreborn.connectivity"]) return NO;
    NSNumber *optimistic = identifier.length ? gERConnectivityOptimisticStates[identifier] : nil;
    if (optimistic) return optimistic.boolValue;
    if ([lower containsString:@".wifi"]) {
        id manager = ERDynamicSharedInstance(@"SBWiFiManager") ?: ERDynamicSharedInstance(@"WiFiManager");
        id name = ERDynamicValue(manager, @[@"currentNetworkName", @"networkName"]);
        if ([name isKindOfClass:[NSString class]] && [name length]) return YES;
        return ERDynamicBool(manager, @[@"wiFiEnabled", @"isWiFiEnabled", @"enabled", @"isEnabled", @"powered"], NO);
    }
    if ([lower containsString:@".bluetooth"]) {
        id manager = ERDynamicSharedInstance(@"BluetoothManager");
        id devices = nil;
        @try { devices = ERDynamicValue(manager, @[@"connectedDevices"]); } @catch (__unused NSException *exception) {}
        BOOL hasDevice = [devices respondsToSelector:@selector(count)] ? [devices count] > 0 : devices != nil;
        return ERDynamicBool(manager, @[@"enabled", @"powered"], NO) || hasDevice;
    }
    if ([lower containsString:@".airdrop"]) {
        // "On" for AirDrop means it is discoverable to someone — which is every
        // scope except 关闭. The status string is now localized, so match on the
        // closed label rather than the old English "Off".
        return ![ERConnectivityStatusForIdentifier(identifier) isEqualToString:@"关闭"];
    }
    if ([lower containsString:@".airplane"]) {
        // RadiosPreferences lives in the Preferences private framework, which is
        // not loaded in SpringBoard by default. The old code called
        // [NSClassFromString(@"RadiosPreferences") new] with no dlopen in the
        // read path, so the class was usually nil and airplane mode always read
        // as off. ERRadiosPreferences() loads the framework first and hands
        // back one cached instance.
        return ERDynamicBool(ERRadiosPreferences(), @[@"airplaneMode", @"isAirplaneMode"], NO);
    }
    if ([lower containsString:@".cellular"]) {
        BOOL answered = NO;
        BOOL enabled = ERCellularDataEnabled(&answered);
        if (answered) return enabled;
        // Last resort: whatever the tile's own control reports, so a build
        // where all three probes miss still tracks the system rather than
        // being hard-wired to "off".
        return ERDynamicBool(ERDynamicSharedInstance(@"CoreTelephonyClient"), @[@"cellularDataEnabled", @"isCellularDataEnabled"], NO);
    }
    if ([lower containsString:@".hotspot"]) return ERHotspotEnabled();
    if ([lower containsString:@".vpn"]) {
        NSDictionary *settings = (__bridge_transfer NSDictionary *)CFNetworkCopySystemProxySettings();
        NSArray *scoped = settings[@"__SCOPED__"] ? [settings[@"__SCOPED__"] allKeys] : nil;
        for (NSString *key in scoped) {
            NSString *name = key.lowercaseString;
            if ([name containsString:@"tap"] || [name containsString:@"tun"] || [name containsString:@"ipsec"] || [name containsString:@"ppp"]) return YES;
        }
        return NO;
    }
    return NO;
}

static BOOL ERConnectivityActiveForIdentifier(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    if (![lower containsString:@"echoreborn.connectivity"]) return NO;
    if ([lower containsString:@".wifi"]) {
        id manager = ERDynamicSharedInstance(@"SBWiFiManager") ?: ERDynamicSharedInstance(@"WiFiManager");
        id name = ERDynamicValue(manager, @[@"currentNetworkName", @"networkName"]);
        return [name isKindOfClass:[NSString class]] && [name length] > 0;
    }
    if ([lower containsString:@".bluetooth"]) {
        id manager = ERDynamicSharedInstance(@"BluetoothManager");
        id devices = nil;
        @try { devices = ERDynamicValue(manager, @[@"connectedDevices"]); } @catch (__unused NSException *exception) {}
        return [devices respondsToSelector:@selector(count)] ? [devices count] > 0 : devices != nil;
    }
    return ERConnectivitySelectedForIdentifier(identifier);
}

static BOOL ERConnectivityAvailableForIdentifier(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    if (![lower containsString:@"echoreborn.connectivity"]) return YES;
    // Availability means "the radio exists on this device", not "the singleton
    // answered just now". Testing the shared instance made a tile grey out for a
    // run loop whenever the manager was momentarily rebuilding, which reads as
    // a broken module. The class test is stable across iOS 16/17.
    if ([lower containsString:@".wifi"]) return NSClassFromString(@"SBWiFiManager") != nil || NSClassFromString(@"WiFiManager") != nil;
    if ([lower containsString:@".bluetooth"]) return NSClassFromString(@"BluetoothManager") != nil;
    if ([lower containsString:@".airplane"]) return NSClassFromString(@"RadiosPreferences") != nil;
    if ([lower containsString:@".cellular"]) {
        // Availability must not depend on +sharedInstance, which does not exist
        // on CoreTelephonyClient. A device that has the class at all is a
        // cellular device; that is all this predicate has to decide.
        return NSClassFromString(@"CoreTelephonyClient") != nil || NSClassFromString(@"CTServerConnection") != nil;
    }
    if ([lower containsString:@".hotspot"]) {
        // 个人热点共享的是蜂窝数据，它的可用性与蜂窝能力同源。0.5.8 及以前这里只认
        // SBTetheringController / TetheringManager 两个类名，而这两个类在 iOS 16/17
        // 上根本不存在（日志里 hotspot 是七个磁贴中唯一 avail=0 的那个），于是热点被
        // 误判成「不可用」：关闭态背景被压到 0.52 透明度，成了整页唯一一块明显偏暗的
        // 磁贴。这就是「只有个人热点看起来异常」的成因——不是背景色画错，是可用性
        // 判定把材质调暗了。
        if (NSClassFromString(@"SBTetheringController") != nil ||
            NSClassFromString(@"TetheringManager") != nil) return YES;
        return ERConnectivityAvailableForIdentifier(@"echoreborn.connectivity.cellular");
    }
    if ([lower containsString:@".vpn"]) return YES;
    return YES;
}

static BOOL ERConnectivitySetIdentifier(NSString *identifier, BOOL enabled) {
    NSString *lower = identifier.lowercaseString;
    if (![lower containsString:@"echoreborn.connectivity"]) return NO;
    if ([lower containsString:@".wifi"]) {
        id manager = ERDynamicSharedInstance(@"SBWiFiManager") ?: ERDynamicSharedInstance(@"WiFiManager");
        // iOS 16/17 moved the toggle around; try every spelling we have seen
        // before giving up, because a miss here is what makes the tile look
        // inert (see the optimistic-state note in -connectivityTileProxyTapped:).
        return ERDynamicSetBool(manager, @[@"setWiFiEnabled:", @"setEnabled:", @"setPowered:",
                                            @"setWiFiEnabled:forUser:", @"setPower:"], enabled);
    }
    if ([lower containsString:@".bluetooth"]) {
        return ERSetBluetoothEnabled(enabled);
    }
    if ([lower containsString:@".airplane"]) {
        id radios = ERRadiosPreferences();
        if (!radios) return NO;
        if (ERDynamicSetBool(radios, @[@"setAirplaneMode:"], enabled)) return YES;
        // The direct RadiosPreferences route needs a live connection on some
        // builds; the notify-style call is the older but still valid one.
        return ERDynamicSetBool(radios, @[@"setAirplaneModeWithoutMirroring:"], enabled);
    }
    if ([lower containsString:@".cellular"]) {
        // Use the client we actually constructed: +sharedInstance has never
        // existed on CoreTelephonyClient, so the old lookup was always nil and
        // this branch could never work.
        id client = ERCellularClient();
        if (!client) client = ERDynamicSharedInstance(@"CoreTelephonyClient");
        if (ERDynamicSetBool(client, @[@"setCellularDataEnabled:"], enabled)) return YES;
        if (ERDynamicSetBool(client, @[@"setCellularDataEnabled:error:"], enabled)) return YES;
        if (ERDynamicSetBool(client, @[@"setUserDataPreferred:"], enabled)) return YES;
        // The C API mirror of the reader above.
        void *handle = dlopen("/System/Library/Frameworks/CoreTelephony.framework/CoreTelephony", RTLD_LAZY);
        if (handle) {
            typedef void (*CTSettingSetCellularDataEnabledFn)(BOOL);
            CTSettingSetCellularDataEnabledFn fn =
                (CTSettingSetCellularDataEnabledFn)dlsym(handle, "CTSettingSetCellularDataEnabled");
            if (fn) { fn(enabled); return YES; }
        }
        return NO;
    }
    if ([lower containsString:@".hotspot"]) return ERSetHotspotEnabled(enabled);
    if ([lower containsString:@".vpn"]) {
        // EchoReborn's own VPN tile follows the system-on-demand connection. There
        // is no supported public toggle for it, so route the press to the
        // Settings pane rather than pretending the state changed — the tile
        // itself repaints from the optimistic state either way.
        return NO;
    }
    return NO;
}

// 1.0.6-14：EchoReborn 自己实现的模块（七个连接磁贴 + 天气磁贴）。
//
// 「实用工具」是系统模块的兜底分类，而 availableControlCatalog 里有一条把
// 「非 /System 目录的 bundle + 兜底分类 实用工具」重标为「第三方插件」的规则 ——
// 天气 bundle 确实装在 /Library 下，走兜底就会被改名成第三方插件。天气现在按用户
// 要求归到「实用工具」，所以这里必须显式把自研模块排除在那条重标之外。
static BOOL ERIdentifierIsEchoRebornOwned(NSString *identifier) {
    if (!identifier.length) return NO;
    NSString *lower = identifier.lowercaseString;
    return [lower containsString:@"echoreborn.connectivity"] ||
           [lower containsString:@"echoreborn.weather"];
}

static NSString *ERCategoryForIdentifier(NSString *identifier) {
    if (ERShortcutIdentifierIsShortcut(identifier)) return @"快捷指令";
    NSString *lower = identifier.lowercaseString;
    NSArray<NSArray *> *categories = @[
        @[@"辅助功能", @[@"accessibility.controlcenter", @"magnifier", @"spokennotifications", @"assistivetouch", @"voicecontrol"]],
        @[@"拍摄", @[@"cameramodule", @"qrcodemodule", @"screencapture", @"nfccontrolcenter", @"flashlightmodule"]],
        @[@"时钟", @[@"controlcenter.timer", @"control-center.stopwatch", @"alarmmodule"]],
        // 1.0.6-14：「实用功能」分类整体移除。
        //
        // 1.0.6-2 建这个分类是为了让天气**不要**落进「实用工具」兜底（否则会被
        // isTweak 规则重标成「第三方插件」）。但用户实机上看到的是「实用工具」与
        // 「实用功能」两个分组并存，而他要的是天气就在「实用工具」里、不要再多一个
        // 分组。所以这里删掉这条映射，天气自然落到 return 的「实用工具」；
        // 「第三方插件」重标由 ERIdentifierIsEchoRebornOwned 挡住 —— 把分类问题和
        // 重标问题分开解决，两边都不会互相牵连。
        @[@"连接", @[@"connectivitymodule", @"echoreborn.connectivity"]],
        @[@"显示", @[@"displaymodule", @"appearancemodule", @"orientationlock", @"autobrightness", @"truetone", @"nightshift", @"keyboardbrightness"]],
        @[@"专注", @[@"focusui", @"donotdisturb", @"sleep", @"silencecalls"]],
        @[@"家庭", @[@"apple.home"]],
        @[@"媒体", @[@"nowplaying", @"controlcenter.audio", @"mutemodule", @"airplaymirroring", @"shazam"]],
        @[@"备忘录", @[@"systempapercontrolcenter", @"quicknote"]],
        @[@"语音备忘录", @[@"voicememos"]],
        @[@"钱包", @[@"walletmodule"]],
    ];
    for (NSArray *pair in categories) {
        for (NSString *needle in pair[1]) {
            if ([lower containsString:needle]) return pair[0];
        }
    }
    return @"实用工具";
}

static NSString *ERFallbackSymbolForIdentifier(NSString *identifier) {
    if (ERShortcutIdentifierIsShortcut(identifier)) return @"sparkles";
    NSString *lower = identifier.lowercaseString;
    NSDictionary<NSString *, NSString *> *symbols = @{
        @"echoreborn.connectivity.airplane": @"airplane",
        @"echoreborn.connectivity.wifi": @"wifi",
        @"echoreborn.connectivity.airdrop": @"airdrop",
        @"echoreborn.connectivity.cellular": @"antenna.radiowaves.left.and.right",
        @"echoreborn.connectivity.bluetooth": @"bluetooth",
        @"echoreborn.connectivity.hotspot": @"personalhotspot",
        @"echoreborn.connectivity.vpn": @"network",
        // 1.0.6-2：「添加控制项」里天气条目的预览字形。
        @"echoreborn.weather": @"cloud.sun.fill",
        @"cameramodule": @"camera.fill",
        @"alarmmodule": @"alarm.fill",
        @"flashlightmodule": @"flashlight.off.fill",
        @"control-center.stopwatch": @"stopwatch",
        @"controlcenter.timer": @"timer",
        @"hearingdevices": @"ear",
        @"magnifiermodule": @"plus.magnifyingglass",
        @"appearancemodule": @"circle.lefthalf.filled",
        @"qrcodemodule": @"qrcode.viewfinder",
        @"controlcenter.screencapture": @"record.circle",
        @"nfccontrolcenter": @"wave.3.right",
        @"appletvremote": @"appletvremote.gen4.fill",
        @"walletmodule": @"wallet.pass.fill",
        @"voicememos": @"waveform",
        @"systempapercontrolcenter": @"note.text",
        @"control-center.quicknote": @"note.text.badge.plus",
        @"lowpowermodule": @"battery.25",
        @"feedbackassistant": @"exclamationmark.bubble.fill",
        @"keyboardbrightness": @"keyboard",
        @"apple.home": @"house.fill",
        @"silencecalls": @"bell.slash.fill",
        @"calculatormodule": @"calculator",
        @"accessibility.controlcenter.general": @"accessibility",
        @"guidedaccess": @"lock.square",
        @"mutemodule": @"bell.fill",
        @"orientationlock": @"lock.rotation",
    };
    for (NSString *needle in symbols) {
        if ([lower containsString:needle]) return symbols[needle];
    }
    return nil;
}

static UIImage *ERCurrentOutputDeviceGlyph(NSString **stateIdentifier) {
    Class controllerClass = NSClassFromString(@"MRUSystemOutputDeviceRouteController");
    if (!controllerClass) {
        static dispatch_once_t onceToken;
        dispatch_once(&onceToken, ^{
            dlopen("/System/Library/PrivateFrameworks/MediaControls.framework/MediaControls", RTLD_LAZY | RTLD_LOCAL);
        });
        controllerClass = NSClassFromString(@"MRUSystemOutputDeviceRouteController");
    }
    if (!controllerClass || ![controllerClass respondsToSelector:@selector(sharedController)]) return nil;

    id controller = ((id (*)(id, SEL))objc_msgSend)(controllerClass, @selector(sharedController));
    if (![controller respondsToSelector:@selector(systemOutputDeviceAsset)]) return nil;
    id asset = ((id (*)(id, SEL))objc_msgSend)(controller, @selector(systemOutputDeviceAsset));
    if (!asset) return nil;

    Class assetClass = NSClassFromString(@"MRUOutputDeviceAsset");
    id speakerAsset = [assetClass respondsToSelector:@selector(speakerAsset)] ?
        ((id (*)(id, SEL))objc_msgSend)(assetClass, @selector(speakerAsset)) : nil;
    if (speakerAsset && [asset isEqual:speakerAsset]) return nil;

    UIImage *icon = [asset respondsToSelector:@selector(icon)] ?
        ((id (*)(id, SEL))objc_msgSend)(asset, @selector(icon)) : nil;
    if (![icon isKindOfClass:[UIImage class]]) return nil;

    NSString *title = [asset respondsToSelector:@selector(localizedDisplayTitle)] ?
        ((id (*)(id, SEL))objc_msgSend)(asset, @selector(localizedDisplayTitle)) : nil;
    NSInteger type = [asset respondsToSelector:@selector(type)] ?
        ((NSInteger (*)(id, SEL))objc_msgSend)(asset, @selector(type)) : NSNotFound;
    NSInteger kind = [asset respondsToSelector:@selector(kind)] ?
        ((NSInteger (*)(id, SEL))objc_msgSend)(asset, @selector(kind)) : NSNotFound;
    if (stateIdentifier) {
        *stateIdentifier = [NSString stringWithFormat:@"route.%ld.%ld.%@", (long)type, (long)kind, title ?: @""];
    }
    return icon;
}

// The readout sits at the 50% mark of the track and is centred across the
// pill. The fill grows past that mark at half volume, so from there on the
// number is drawn on the bright fill: it flips to black (with a white halo)
// and back to white once the level drops below the mark again.
static CGFloat const kERSliderPercentTrackMark = 0.5;

static void ERUpdateSliderPercentageLabel(UIView *slider, BOOL isBrightness, float value) {
    if (!slider) return;
    BOOL enabled = isBrightness ? gBrightnessControlEnabled : gVolumeControlEnabled;
    __block UILabel *label = (UILabel *)[slider viewWithTag:kERSliderPercentLabelTag];
    if (label && ![label isKindOfClass:[UILabel class]]) {
        [label removeFromSuperview];
        label = nil;
    }
    if (!enabled) {
        // Preference was flipped off — drop any label left over from before.
        if (label) [label removeFromSuperview];
        return;
    }
    float normalized = MIN(1.0f, MAX(0.0f, value));
    NSInteger percent = (NSInteger)lroundf(normalized * 100.0f);
    NSString *text = [NSString stringWithFormat:@"%ld%%", (long)percent];
    // Small hysteresis band so a finger resting exactly on the 50% mark does
    // not strobe the colour on every value update.
    NSNumber *lastFilled = objc_getAssociatedObject(slider, kERSliderPercentFilledKey);
    BOOL filled = lastFilled ? lastFilled.boolValue : NO;
    if (normalized >= kERSliderPercentTrackMark + 0.005f) filled = YES;
    else if (normalized < kERSliderPercentTrackMark - 0.005f) filled = NO;
    objc_setAssociatedObject(slider, kERSliderPercentFilledKey, @(filled), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    UIColor *textColor = filled ? UIColor.blackColor : UIColor.whiteColor;
    UIColor *haloColor = filled ? [UIColor colorWithWhite:1.0 alpha:0.9] : [UIColor colorWithWhite:0.0 alpha:0.55];
    // Every mutation of the label happens with implicit animation and
    // Core Animation actions disabled, and the text is only touched when it
    // actually changed. The slider's own glyph cross-dissolve (which fires
    // when the value crosses the 20% threshold or reaches 0) is therefore
    // untouched: no layout invalidation, no subview reordering churn, and no
    // inherited animations from enclosing transition blocks.
    [UIView performWithoutAnimation:^{
        [CATransaction begin];
        [CATransaction setDisableActions:YES];
        if (!label) {
            label = [[UILabel alloc] initWithFrame:CGRectZero];
            label.tag = kERSliderPercentLabelTag;
            label.textAlignment = NSTextAlignmentCenter;
            label.userInteractionEnabled = NO;
            label.font = [UIFont monospacedDigitSystemFontOfSize:13.0 weight:UIFontWeightSemibold];
            label.textColor = textColor;
            label.layer.shadowColor = haloColor.CGColor;
            label.layer.shadowOpacity = 1.0;
            label.layer.shadowRadius = 2.0;
            label.layer.shadowOffset = CGSizeMake(0.0, 1.0);
            label.adjustsFontForContentSizeCategory = NO;
            [slider addSubview:label];
        }
        if (![label.text isEqualToString:text]) label.text = text;
        if (![label.textColor isEqual:textColor]) {
            label.textColor = textColor;
            label.layer.shadowColor = haloColor.CGColor;
        }
        // Measure from the string itself — no sizeToFit, so setting the text
        // never invalidates an intrinsic-content-size pass mid-drag.
        CGRect measured = [text boundingRectWithSize:CGSizeMake(120.0, 24.0)
                                             options:NSStringDrawingUsesLineFragmentOrigin
                                          attributes:@{NSFontAttributeName: label.font}
                                             context:nil];
        CGFloat labelWidth = ceil(MAX(measured.size.width, 8.0)) + 12.0;
        CGFloat labelHeight = 16.0;
        // Centred across the pill and parked on the 50% mark of the track:
        // the point the fill reaches at half level.
        CGFloat width = CGRectGetWidth(slider.bounds);
        CGFloat height = CGRectGetHeight(slider.bounds);
        CGFloat centerY = height * kERSliderPercentTrackMark;
        centerY = MIN(MAX(labelHeight * 0.5 + 2.0, centerY), height - labelHeight * 0.5 - 2.0);
        label.frame = CGRectMake(round((width - labelWidth) * 0.5), round(centerY - labelHeight * 0.5), labelWidth, labelHeight);
        [slider bringSubviewToFront:label];
        [CATransaction commit];
    }];
}

static void ERUpdateSliderGlyphColor(UIView *slider, float value, BOOL animate) {
    if (!slider) return;
    NSMutableString *identity = [NSMutableString string];
    for (UIView *ancestor = slider; ancestor; ancestor = ancestor.superview) {
        if (ancestor.accessibilityLabel.length) [identity appendFormat:@" %@", ancestor.accessibilityLabel.lowercaseString];
    }
    // The flashlight intensity slider is accessibility-labelled "Brightness";
    // never hand it the display slider's sun glyph or yellow theme.
    if ([identity containsString:@"flashlight"]) return;
    for (UIResponder *responder = slider.nextResponder; responder; responder = responder.nextResponder) {
        if (![responder isKindOfClass:[UIViewController class]]) continue;
        if ([ERIdentifierFromObject(responder).lowercaseString containsString:@"flashlight"]) return;
    }
    BOOL isBrightness = [identity containsString:@"brightness"];
    BOOL isVolume = [identity containsString:@"volume"];
    if (!isBrightness && !isVolume) {
        UIResponder *responder = slider.nextResponder;
        while (responder) {
            if ([responder isKindOfClass:[UIViewController class]]) {
                NSString *identifier = ERIdentifierFromObject(responder).lowercaseString;
                if ([identifier containsString:@"displaymodule"]) isBrightness = YES;
                else if ([identifier containsString:@"controlcenter.audio"] || [identifier containsString:@"volumemodule"]) isVolume = YES;
                if (isBrightness || isVolume) break;
            }
            responder = responder.nextResponder;
        }
    }
    if (!isBrightness && !isVolume) return;

    ERUpdateSliderPercentageLabel(slider, isBrightness, value);

    BOOL colored = value >= 0.20f;
    NSNumber *previousState = objc_getAssociatedObject(slider, kERSliderGlyphColoredKey);
    BOOL stateChanged = previousState && previousState.boolValue != colored;
    UIColor *activeColor = isBrightness ? UIColor.systemYellowColor : [UIColor colorWithRed:0.25 green:0.74 blue:1.0 alpha:1.0];
    UIColor *displayColor = colored ? activeColor : UIColor.whiteColor;
    NSMutableArray<UIView *> *glyphHosts = [NSMutableArray array];
    for (NSString *key in @[@"_activeGlyphView", @"_glyphImageView", @"_glyphPackageView", @"_compensatingGlyphView"]) {
        @try {
            id candidate = [(id)slider valueForKey:key];
            if ([candidate isKindOfClass:[UIView class]] && ![glyphHosts containsObject:candidate]) [glyphHosts addObject:candidate];
        } @catch (__unused NSException *exception) {}
    }
    if (!glyphHosts.count) {
        NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithArray:slider.subviews];
        while (queue.count) {
            UIView *candidate = queue.firstObject;
            [queue removeObjectAtIndex:0];
            NSString *className = NSStringFromClass(candidate.class);
            if (([candidate isKindOfClass:[UIImageView class]] || [className isEqualToString:@"CCUICAPackageView"]) &&
                CGRectGetWidth(candidate.bounds) <= 64.0 && CGRectGetHeight(candidate.bounds) <= 64.0) [glyphHosts addObject:candidate];
            [queue addObjectsFromArray:candidate.subviews];
        }
    }

    for (UIView *host in glyphHosts) {
        if (!objc_getAssociatedObject(host, kERSliderGlyphOriginalTintKey)) {
            objc_setAssociatedObject(host, kERSliderGlyphOriginalTintKey, host.tintColor ?: UIColor.whiteColor, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(host, kERSliderGlyphOriginalAlphaKey, @(host.alpha), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(host, kERSliderGlyphOriginalHiddenKey, @(host.hidden), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        UIImageView *imageView = [host isKindOfClass:[UIImageView class]] ? (UIImageView *)host : nil;
        if (imageView.image && (!previousState || !previousState.boolValue)) {
            objc_setAssociatedObject(host, kERSliderGlyphOriginalImageKey, imageView.image, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        void (^changes)(void) = ^{
            host.tintColor = displayColor;
            // The native iOS 16 glyph is a gray punch-out. Keep it hidden at
            // every value and use the same SF-symbol overlay for both sides
            // of the 20% threshold so the inactive state is genuinely white.
            host.alpha = 0.0;
            host.hidden = YES;
            if (imageView) {
                UIImage *baseImage = objc_getAssociatedObject(host, kERSliderGlyphOriginalImageKey) ?: imageView.image;
                if (baseImage) {
                    UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithHierarchicalColor:displayColor];
                    UIImage *configured = [baseImage imageByApplyingSymbolConfiguration:configuration];
                    imageView.image = configured ?: [baseImage imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];
                    imageView.tintColor = displayColor;
                }
            }
        };
        if (animate && stateChanged) {
            [UIView transitionWithView:host duration:0.11 options:UIViewAnimationOptionTransitionCrossDissolve | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowAnimatedContent animations:changes completion:nil];
        } else {
            changes();
        }
    }

    if (isBrightness) {
        UIView *existingGlyph = [slider viewWithTag:kERSliderColorGlyphTag];
        if (existingGlyph && ![existingGlyph isKindOfClass:[ERBrightnessGlyphView class]]) {
            [existingGlyph removeFromSuperview];
            existingGlyph = nil;
        }
        ERBrightnessGlyphView *brightnessGlyph = (ERBrightnessGlyphView *)existingGlyph;
        if (!brightnessGlyph) {
            brightnessGlyph = [[ERBrightnessGlyphView alloc] initWithFrame:CGRectMake(0.0, 0.0, 44.0, 44.0)];
            brightnessGlyph.tag = kERSliderColorGlyphTag;
            [slider addSubview:brightnessGlyph];
        }
        CGPoint center = ((CGPoint (*)(id, SEL))objc_msgSend)((id)slider, @selector(glyphCenter));
        brightnessGlyph.center = center;
        brightnessGlyph.alpha = 1.0;
        [brightnessGlyph setLevel:value color:displayColor animated:animate];
        [slider bringSubviewToFront:brightnessGlyph];
        objc_setAssociatedObject(slider, kERSliderGlyphSymbolStateKey, @"brightness.rays", OBJC_ASSOCIATION_COPY_NONATOMIC);
        objc_setAssociatedObject(slider, kERSliderGlyphColoredKey, @(colored), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }

    // iOS 16 normally renders these glyphs as punch-outs, so changing the
    // backing host's tint does not necessarily alter the composited pixels.
    // Own one SF-symbol layer and drive its variable value directly. This is
    // what gives the sun rays and speaker waves continuous level feedback,
    // instead of snapping among a handful of unrelated static images.
    UIImageSymbolConfiguration *symbolConfiguration =
        [UIImageSymbolConfiguration configurationWithPointSize:24.0 weight:UIImageSymbolWeightRegular];
    CGFloat variableValue = MIN(1.0, MAX(0.0, value));
    BOOL isMutedVolume = isVolume && value <= 0.001f;
    NSString *symbolState = nil;
    UIImage *nativeGlyph = nil;
    NSString *routeState = nil;
    UIImage *routeGlyph = isVolume ? ERCurrentOutputDeviceGlyph(&routeState) : nil;
    if (routeGlyph) {
        symbolState = routeState ?: @"volume.externalRoute";
        UIImageSymbolConfiguration *routeConfiguration =
            [UIImageSymbolConfiguration configurationWithPointSize:26.0 weight:UIImageSymbolWeightRegular];
        nativeGlyph = [routeGlyph imageByApplyingSymbolConfiguration:routeConfiguration] ?: routeGlyph;
    } else if (isMutedVolume) {
        symbolState = @"volume.muted";
        nativeGlyph = [UIImage systemImageNamed:@"speaker.slash.fill" withConfiguration:symbolConfiguration];
    } else if (isVolume) {
        NSUInteger waveCount = value >= 0.66f ? 3 : (value >= 0.33f ? 2 : 1);
        symbolState = [NSString stringWithFormat:@"volume.wave%lu", (unsigned long)waveCount];
        NSString *symbolName = [NSString stringWithFormat:@"speaker.wave.%lu.fill", (unsigned long)waveCount];
        nativeGlyph = [UIImage systemImageNamed:symbolName withConfiguration:symbolConfiguration];
    } else {
        symbolState = @"brightness.variable";
        if (@available(iOS 16.0, *)) {
            nativeGlyph = [UIImage systemImageNamed:@"sun.max.fill"
                                       variableValue:variableValue
                                    withConfiguration:symbolConfiguration];
        }
    }
    if (!nativeGlyph) {
        NSString *fallbackName = isBrightness ? @"sun.max.fill" :
            (isMutedVolume ? @"speaker.slash.fill" :
             (value >= 0.66f ? @"speaker.wave.3.fill" :
              (value >= 0.33f ? @"speaker.wave.2.fill" : @"speaker.wave.1.fill")));
        nativeGlyph = [UIImage systemImageNamed:fallbackName withConfiguration:symbolConfiguration];
    }
    UIImageView *colorGlyph = (UIImageView *)[slider viewWithTag:kERSliderColorGlyphTag];
    if (nativeGlyph) {
        if (!colorGlyph) {
            colorGlyph = [[UIImageView alloc] initWithFrame:CGRectMake(0.0, 0.0, 44.0, 44.0)];
            colorGlyph.tag = kERSliderColorGlyphTag;
            colorGlyph.userInteractionEnabled = NO;
            colorGlyph.contentMode = UIViewContentModeCenter;
            colorGlyph.alpha = 1.0;
            [slider addSubview:colorGlyph];
        }
        CGPoint center = ((CGPoint (*)(id, SEL))objc_msgSend)((id)slider, @selector(glyphCenter));
        colorGlyph.center = center;
        [slider bringSubviewToFront:colorGlyph];
        UIImageSymbolConfiguration *colorConfiguration = [UIImageSymbolConfiguration configurationWithHierarchicalColor:displayColor];
        UIImage *configured = [nativeGlyph imageByApplyingSymbolConfiguration:colorConfiguration];
        UIImage *nextImage = configured ?: [nativeGlyph imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];
        NSString *previousSymbolState = objc_getAssociatedObject(slider, kERSliderGlyphSymbolStateKey);
        BOOL symbolStateChanged = previousSymbolState.length && ![previousSymbolState isEqualToString:symbolState];

        if (animate && symbolStateChanged && colorGlyph.image) {
            // SymbolEffect.replace is not exposed by iOS 16. Recreate its
            // compact replacement motion with independent outgoing/incoming
            // symbol layers, while shared variable symbols continue tracking
            // the slider without spawning animations on every touch sample.
            for (UIView *view in [slider.subviews copy]) {
                if (view.tag == kERSliderOutgoingGlyphTag) [view removeFromSuperview];
            }
            UIImageView *outgoing = [[UIImageView alloc] initWithFrame:colorGlyph.frame];
            outgoing.tag = kERSliderOutgoingGlyphTag;
            outgoing.userInteractionEnabled = NO;
            outgoing.contentMode = colorGlyph.contentMode;
            outgoing.image = colorGlyph.image;
            outgoing.tintColor = colorGlyph.tintColor;
            outgoing.alpha = colorGlyph.alpha;
            [slider insertSubview:outgoing belowSubview:colorGlyph];

            colorGlyph.image = nextImage;
            colorGlyph.tintColor = displayColor;
            colorGlyph.alpha = 0.0;
            colorGlyph.transform = CGAffineTransformMakeScale(0.72, 0.72);
            [UIView animateWithDuration:0.18 delay:0.0
                                options:UIViewAnimationOptionCurveEaseInOut |
                                        UIViewAnimationOptionBeginFromCurrentState |
                                        UIViewAnimationOptionAllowUserInteraction
                             animations:^{
                outgoing.alpha = 0.0;
                outgoing.transform = CGAffineTransformMakeScale(0.72, 0.72);
                colorGlyph.alpha = 1.0;
                colorGlyph.transform = CGAffineTransformIdentity;
            } completion:^(__unused BOOL finished) {
                [outgoing removeFromSuperview];
            }];
        } else if (animate && stateChanged && colorGlyph.image) {
            [UIView transitionWithView:colorGlyph duration:0.13
                               options:UIViewAnimationOptionTransitionCrossDissolve |
                                       UIViewAnimationOptionBeginFromCurrentState |
                                       UIViewAnimationOptionAllowAnimatedContent |
                                       UIViewAnimationOptionAllowUserInteraction
                            animations:^{
                colorGlyph.image = nextImage;
                colorGlyph.tintColor = displayColor;
                colorGlyph.alpha = 1.0;
            } completion:nil];
        } else {
            colorGlyph.image = nextImage;
            colorGlyph.tintColor = displayColor;
            colorGlyph.alpha = 1.0;
            colorGlyph.transform = CGAffineTransformIdentity;
        }
        objc_setAssociatedObject(slider, kERSliderGlyphSymbolStateKey, symbolState, OBJC_ASSOCIATION_COPY_NONATOMIC);
    } else if (colorGlyph) {
        colorGlyph.alpha = 0.0;
    }
    objc_setAssociatedObject(slider, kERSliderGlyphColoredKey, @(colored), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

static void ERUpdateSliderOverscroll(UIView *slider, UIPanGestureRecognizer *gesture) {
    if (!slider || !gesture || !gEnabled || gEditModeActive) return;
    UIGestureRecognizerState state = gesture.state;
    if (state == UIGestureRecognizerStateBegan) {
        UIView *target = nil;
        for (UIViewController *overlay in gOverlayControllers.allObjects) {
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (slider == module.view || [slider isDescendantOfView:module.view]) {
                    target = module.view;
                    break;
                }
            }
            if (target) break;
        }
        if (!target) target = slider;
        [target.layer removeAllAnimations];
        objc_setAssociatedObject(slider,
                                 kERSliderOverscrollTargetKey,
                                 [NSValue valueWithNonretainedObject:target],
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(slider,
                                 kERSliderOverscrollBaseTransformKey,
                                 [NSValue valueWithCGAffineTransform:target.transform],
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        float value = [slider respondsToSelector:@selector(value)] ?
            ((float (*)(id, SEL))objc_msgSend)((id)slider, @selector(value)) : 0.0f;
        objc_setAssociatedObject(slider, kERSliderOverscrollStartValueKey, @(value), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(slider, kERSliderOverscrollAmountKey, @0.0, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }

    NSValue *baseValue = objc_getAssociatedObject(slider, kERSliderOverscrollBaseTransformKey);
    if (!baseValue) return;
    UIView *target = [objc_getAssociatedObject(slider, kERSliderOverscrollTargetKey) nonretainedObjectValue] ?: slider;
    CGAffineTransform baseTransform = baseValue.CGAffineTransformValue;
    if (state == UIGestureRecognizerStateEnded || state == UIGestureRecognizerStateCancelled || state == UIGestureRecognizerStateFailed) {
        CGFloat tension = [objc_getAssociatedObject(slider, kERSliderOverscrollAmountKey) doubleValue];
        CGFloat velocityY = [gesture velocityInView:slider.window].y;
        CGFloat displacementY = target.transform.ty - baseTransform.ty;
        BOOL flingingOutward = tension > 0.10 && displacementY * velocityY > 0.0;
        CGFloat springVelocity = flingingOutward ? -MIN(2.2, fabs(velocityY) / 520.0) * tension : 0.0;
        NSTimeInterval duration = 0.20 + 0.30 * tension;
        CGFloat damping = 0.88 - 0.32 * tension;
        [UIView animateWithDuration:duration
                              delay:0.0
             usingSpringWithDamping:damping
              initialSpringVelocity:springVelocity
                            options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction
                         animations:^{ target.transform = baseTransform; }
                         completion:^(__unused BOOL finished) {
            objc_setAssociatedObject(slider, kERSliderOverscrollBaseTransformKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(slider, kERSliderOverscrollStartValueKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(slider, kERSliderOverscrollAmountKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(slider, kERSliderOverscrollTargetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }];
        return;
    }
    if (state != UIGestureRecognizerStateBegan && state != UIGestureRecognizerStateChanged) return;

    // Brightness and volume use the tall continuous-slider presentation. Use
    // window-space translation so deforming the slider cannot feed back into
    // the gesture's own coordinate system.
    if (CGRectGetHeight(slider.bounds) <= CGRectGetWidth(slider.bounds) * 1.15) return;
    CGFloat startValue = [objc_getAssociatedObject(slider, kERSliderOverscrollStartValueKey) doubleValue];
    CGFloat translationY = [gesture translationInView:slider.window].y;
    CGFloat rawValue = startValue - translationY / MAX(1.0, CGRectGetHeight(slider.bounds));
    CGFloat overshoot = rawValue > 1.0 ? rawValue - 1.0 : (rawValue < 0.0 ? -rawValue : 0.0);
    // Rational resistance has no abrupt ceiling: every extra point still
    // yields a little motion, but progressively less than the one before it.
    CGFloat pull = overshoot * 6.0;
    CGFloat resisted = pull / (1.0 + pull);
    BOOL pullingTop = rawValue > 1.0;
    CGFloat travelY = (pullingTop ? -1.0 : 1.0) * 9.0 * resisted;
    CGFloat scaleX = 1.0 - 0.045 * resisted;
    CGFloat scaleY = 1.0 + 0.040 * resisted;
    CGAffineTransform transformed = CGAffineTransformTranslate(baseTransform, 0.0, travelY);
    transformed = CGAffineTransformScale(transformed, scaleX, scaleY);
    [UIView performWithoutAnimation:^{ target.transform = transformed; }];
    objc_setAssociatedObject(slider, kERSliderOverscrollAmountKey, @(resisted), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

// ---------------------------------------------------------------------------
// Live slider readout
//
// EchoReborn's percentage readout and glyph tint are driven from -setValue:, but
// that is not the property the finger actually moves during a continuous drag.
// CCUIContinuousSliderView's pan handler maintains its own running level and
// only pushes a new `value` down to CCUIBaseSliderView when the level crosses
// a system milestone (and once more on release). A small drag inside a
// milestone band therefore leaves the readout showing the old number — the
// reported "33% does not move until I drag all the way to 66%".
//
// Reading `value` back out at the gesture sample and re-entering the normal
// update path is the fix. `value` is already current at that point, so the
// readout tracks the finger continuously without EchoReborn having to model the
// slider's level itself. The mirrored `setValue:` hooks on the continuous and
// stepped subclasses stay in place for programmatic changes (Control Center
// restoring a level, the volume HUD, accessibility), where no gesture runs.
// ---------------------------------------------------------------------------
@interface CCUIBaseSliderView : UIView
- (float)value;
@end

// The continuous and stepped subclasses are typed so their hook blocks have a
// complete receiver type; the class itself is private and has no linkable
// symbol, which is why the refresh below is a plain C helper rather than an
// Objective-C method.
@interface CCUIContinuousSliderView : CCUIBaseSliderView
@end

@interface CCUISteppedSliderView : CCUIBaseSliderView
@end

// Re-reads the slider's own `value` and pushes it through the normal
// glyph/label path. A C function rather than a category method: a category on
// a private class emits an _OBJC_CLASS_$_CCUIBaseSliderView reference that the
// linker cannot resolve (the class only exists inside SpringBoard at runtime).
static void ERRefreshSliderReadoutLive(UIView *slider) {
    if (!slider || !gEnabled || gEditModeActive) return;
    if (![slider respondsToSelector:@selector(value)]) return;
    float value = ((float (*)(id, SEL))objc_msgSend)((id)slider, @selector(value));
    if (!isfinite(value)) return;
    // animate:NO — the finger owns the motion; a cross-dissolve per gesture
    // sample would strobe the glyph.
    ERUpdateSliderGlyphColor(slider, value, NO);
}

// ---------------------------------------------------------------------------
// Live slider diagnostics
//
// Enabled only through the Settings logging switch. Records the slider's class
// and the value each candidate update path reports, so a single drag tells us
// exactly which selector actually runs per finger sample on this iOS build.
// The readout was reported as stepping in coarse jumps twice, and guessing at
// the class hierarchy is what produced a fix that did not take; this data
// removes the guesswork.
// ---------------------------------------------------------------------------
static void ERLogSliderProbe(UIView *slider, NSString *path) {
    if (!gERLoggingEnabled || !slider) return;
    NSString *className = NSStringFromClass(slider.class);
    float value = [slider respondsToSelector:@selector(value)] ?
        ((float (*)(id, SEL))objc_msgSend)((id)slider, @selector(value)) : -1.0f;
    NSString *label = slider.accessibilityLabel ?: @"";
    ERLogInfo(@"sliderprobe: %@ class=%@ value=%.3f label=%@ bounds=%.0fx%.0f",
               path, className, value, label,
               CGRectGetWidth(slider.bounds), CGRectGetHeight(slider.bounds));
}

// ---------------------------------------------------------------------------
// Per-frame slider readout
//
// The readout must follow the finger even though the value the system exposes
// only advances on coarse milestones. Rather than depend on which private
// selector happens to carry the per-sample update on a given iOS build, drive
// the readout from a display link for as long as a touch is on the slider: one
// refresh per frame, reading whatever `value` currently reports.
//
// A display link only runs while a touch is down, so the cost is bounded to
// the drag itself, and the label update path is already idempotent (it writes
// text only when the string actually changed) so a frame that reports the same
// value does no work.
// ---------------------------------------------------------------------------
static CADisplayLink *gERSliderReadoutLink = nil;
static __weak UIView *gERSliderReadoutTarget = nil;
// Live value derived from the finger. The slider's own `value` only advances on
// coarse milestones, so polling that getter per frame still shows a stale
// number. This is the last value the readout displayed, advanced by the
// gesture's own translation using the same mapping CC uses for these tall
// vertical sliders (full track height == full range).
static float gERSliderReadoutLiveValue = -1.0f;
static CGFloat gERSliderReadoutLastDeltaY = 0.0;
static BOOL gERSliderReadoutTracking = NO;
// Safety net: a display link must never outlive its drag. If the gesture-end
// hook is missed (the recogniser is cancelled by a system interruption, or the
// overlay is torn down mid-touch), the link stops itself once the finger has
// been away for a moment.
static CFTimeInterval gERSliderReadoutLastAdvance = 0.0;
static CFTimeInterval gERSliderReadoutLogStamp = 0.0;

static void ERSliderReadoutFrame(CADisplayLink *link) {
    UIView *slider = gERSliderReadoutTarget;
    if (!slider || !slider.window) {
        [link invalidate];
        if (gERSliderReadoutLink == link) gERSliderReadoutLink = nil;
        gERSliderReadoutTarget = nil;
        gERSliderReadoutTracking = NO;
        gERSliderReadoutLastDeltaY = 0.0;
        gERSliderReadoutLiveValue = -1.0f;
        return;
    }
    // The gesture handler stamps this every time it advances the level. Once
    // the stamps stop arriving the touch is over, so the poller retires.
    if (gERSliderReadoutLastAdvance > 0.0 &&
        CACurrentMediaTime() - gERSliderReadoutLastAdvance > 0.5) {
        [link invalidate];
        if (gERSliderReadoutLink == link) gERSliderReadoutLink = nil;
        gERSliderReadoutTarget = nil;
        gERSliderReadoutTracking = NO;
        gERSliderReadoutLiveValue = -1.0f;
        return;
    }
    if (![slider respondsToSelector:@selector(value)]) return;
    if (gERSliderReadoutLiveValue < 0.0f) return;
    // Rate-limited probe: one line per ~0.5s of tracking is enough to prove the
    // link is running and show the value actually being painted.
    if (gERLoggingEnabled && gERSliderReadoutLastAdvance > 0.0 &&
        CACurrentMediaTime() - gERSliderReadoutLogStamp > 0.5) {
        gERSliderReadoutLogStamp = CACurrentMediaTime();
        ERLogInfo(@"readout: frame paint %@ live=%.3f system=%.3f tracking=%d",
                   NSStringFromClass(slider.class), gERSliderReadoutLiveValue,
                   ((float (*)(id, SEL))objc_msgSend)((id)slider, @selector(value)),
                   gERSliderReadoutTracking ? 1 : 0);
    }
    ERUpdateSliderGlyphColor(slider, gERSliderReadoutLiveValue, NO);
}

static void ERSliderReadoutBegin(UIView *slider) {
    if (!slider || !gEnabled || gEditModeActive) return;
    // An in-flight drag owns the readout.
    //
    // Brightness and volume are two SEPARATE slider instances that share this
    // one set of globals, and ERSliderReadoutTick fires for both whenever the
    // system pushes a new value (auto-brightness being the common trigger).
    // Letting the second one in mid-drag reassigns the target and clobbers the
    // live value under the first one's finger — the reported "音量/亮度滑块
    // 有时不准确". The device log shows it as a second
    // "readout: started display link ... base=0.000" line immediately followed
    // by a frame paint whose system= belongs to a different slider entirely.
    if (gERSliderReadoutTracking && gERSliderReadoutTarget &&
        gERSliderReadoutTarget != slider) return;
    // Same slider, drag already in flight: this is a re-entry from the second
    // update path (the -setValue: hook firing while the observer gesture is
    // also live). Resetting LastDeltaY here would make the next gesture sample
    // compute its step against a stale origin and jump the reading, so the
    // in-flight state is left completely alone.
    if (gERSliderReadoutTracking && gERSliderReadoutTarget == slider) return;
    gERSliderReadoutTarget = slider;
    gERSliderReadoutTracking = NO;
    gERSliderReadoutLastDeltaY = 0.0;
    gERSliderReadoutLastAdvance = CACurrentMediaTime();
    gERSliderReadoutLiveValue = [slider respondsToSelector:@selector(value)] ?
        ((float (*)(id, SEL))objc_msgSend)((id)slider, @selector(value)) : -1.0f;
    if (gERSliderReadoutLink) return;
    // EchoRebornCoordinator is declared further down the file, so it cannot be
    // messaged by name yet; every other early helper resolves it the same way.
    Class coordinatorClass = NSClassFromString(@"EchoRebornCoordinator");
    id coordinator = coordinatorClass ? ((id (*)(id, SEL))objc_msgSend)(coordinatorClass, @selector(shared)) : nil;
    if (!coordinator) {
        ERLogInfo(@"readout: no coordinator, display link not started for %@", NSStringFromClass(slider.class));
        return;
    }
    gERSliderReadoutLink = [CADisplayLink displayLinkWithTarget:coordinator
                                                        selector:@selector(sliderReadoutLinkFired:)];
    [gERSliderReadoutLink addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
    ERLogInfo(@"readout: started display link for %@ base=%.3f", NSStringFromClass(slider.class), gERSliderReadoutLiveValue);
}

// Called from the gesture handler while the finger is down. Advancing by the
// per-call *delta* of the pan translation is correct whether or not the
// system's own handler resets the translation each sample: when it does, each
// call carries a small fresh delta; when it does not, the running total is
// consumed here so no motion is double counted.
static void ERSliderReadoutTrackGesture(UIView *slider, UIPanGestureRecognizer *gesture) {
    if (!slider || !gesture) return;
    if (![slider respondsToSelector:@selector(value)]) return;
    UIGestureRecognizerState state = gesture.state;
    if (state == UIGestureRecognizerStateBegan) {
        gERSliderReadoutTracking = YES;
        gERSliderReadoutLastDeltaY = [gesture translationInView:slider.window].y;
        // Seed from the system value ONLY when nothing has been tracked yet.
        // -ERSliderReadoutBegin already seeded it, and the display link may
        // have advanced it since (Begin runs first in the gesture callback).
        // Blindly overwriting here threw away that progress and pinned the
        // reading back to the coarse system value, which is the "数值不随拖动
        // 连续叠加" symptom.
        if (gERSliderReadoutLiveValue < 0.0f) {
            gERSliderReadoutLiveValue = ((float (*)(id, SEL))objc_msgSend)((id)slider, @selector(value));
        }
        return;
    }
    if (state != UIGestureRecognizerStateChanged) return;
    if (!gERSliderReadoutTracking) {
        // Entered mid-drag (the Began sample was missed). Anchor the running
        // origin to the CURRENT cumulative translation rather than to 0: the
        // translation is already non-zero by now, so anchoring at 0 would make
        // the first step swallow the whole distance travelled so far and jump
        // the reading by that much in one frame.
        gERSliderReadoutTracking = YES;
        gERSliderReadoutLastDeltaY = [gesture translationInView:slider.window].y;
        gERSliderReadoutLiveValue = ((float (*)(id, SEL))objc_msgSend)((id)slider, @selector(value));
    }
    CGFloat height = CGRectGetHeight(slider.bounds);
    if (height < 1.0) return;
    CGFloat deltaY = [gesture translationInView:slider.window].y;
    CGFloat step = deltaY - gERSliderReadoutLastDeltaY;
    gERSliderReadoutLastDeltaY = deltaY;
    gERSliderReadoutLastAdvance = CACurrentMediaTime();
    if (fabs(step) < 0.01) return;
    if (gERSliderReadoutLiveValue < 0.0f) gERSliderReadoutLiveValue = 0.0f;
    // Dragging up (negative step) raises the level, matching the system's tall
    // vertical sliders.
    float live = gERSliderReadoutLiveValue - (float)(step / MAX(1.0, height));
    float previous = gERSliderReadoutLiveValue;
    gERSliderReadoutLiveValue = MIN(1.0f, MAX(0.0f, live));
    if (gERLoggingEnabled && fabs(gERSliderReadoutLiveValue - previous) > 0.001f) {
        ERLogInfo(@"readout: gesture step=%.1f h=%.0f live=%.3f", step, height, gERSliderReadoutLiveValue);
    }
}

static void ERSliderReadoutEnd(UIView *slider) {
    if (slider && gERSliderReadoutTarget != slider) return;
    [gERSliderReadoutLink invalidate];
    gERSliderReadoutLink = nil;
    gERSliderReadoutTarget = nil;
    gERSliderReadoutTracking = NO;
    gERSliderReadoutLastDeltaY = 0.0;
    gERSliderReadoutLastAdvance = 0.0;
    gERSliderReadoutLiveValue = -1.0f;
}

// ---------------------------------------------------------------------------
// Self-installed tracking gesture
//
// Hook-based tracking was tried four times and never worked on the user's
// build. The log finally explained why: every sample came from
// `setValue:`/`layoutSubviews`, and neither `readout: gesture step` nor
// `tracking=1` ever appeared, i.e. the gesture callback never ran at all.
//
// The reason is the class hierarchy. The brightness slider in Control Center
// is NOT a CCUIContinuousSliderView on this build: it is
// `MRUContinuousSliderView`, which lives in the private MediaControls
// framework and inherits from an MRU* base, not from CCUIBaseSliderView. A
// `%hook CCUIContinuousSliderView -_handleValueChangeGestureRecognizer:` can
// therefore never fire for it, no matter how the body is written.
//
// Rather than guess which private class carries the per-sample updates on a
// given iOS build, EchoReborn installs its own UIPanGestureRecognizer on the
// slider. A recogniser attached by us receives a callback for every touch
// sample the system delivers, whatever the slider's own class does, and it
// coexists with the system's recogniser (both observe, neither consumes).
// ---------------------------------------------------------------------------
static BOOL ERSliderBelongsToAdjustmentModule(UIView *slider) {
    if (!slider) return NO;
    NSMutableString *identity = [NSMutableString string];
    for (UIView *ancestor = slider; ancestor; ancestor = ancestor.superview) {
        NSString *label = ancestor.accessibilityLabel;
        if (label.length) [identity appendFormat:@" %@", label.lowercaseString];
        // Class names on the way up. On iOS 17 the brightness and volume
        // sliders are MRUContinuousSliderView / MRUVolumeSliderView (private
        // MediaControls classes) whose own accessibilityLabel is frequently
        // nil — the label lives on an ancestor, and on some builds no ancestor
        // carries one at all. Requiring a label alone made this function answer
        // NO for exactly the two sliders it exists to find, which meant the
        // observation recogniser was never installed and the readout fell back
        // to the lagging system value. Class names are always available.
        NSString *className = NSStringFromClass(ancestor.class).lowercaseString;
        if (className.length) [identity appendFormat:@" %@", className];
    }
    for (UIResponder *responder = slider.nextResponder; responder; responder = responder.nextResponder) {
        if (![responder isKindOfClass:[UIViewController class]]) continue;
        NSString *identifier = ERIdentifierFromObject(responder).lowercaseString;
        if (identifier.length) [identity appendFormat:@" %@", identifier];
        NSString *className = NSStringFromClass(responder.class).lowercaseString;
        if (className.length) [identity appendFormat:@" %@", className];
    }
    NSString *lower = identity.lowercaseString;
    // The flashlight's intensity slider is accessibility-labelled "Brightness"
    // on some builds; it must not get the display slider's readout.
    if ([lower containsString:@"flashlight"]) return NO;
    if ([lower containsString:@"brightness"] ||
        [lower containsString:@"volume"] ||
        [lower containsString:@"displaymodule"] ||
        [lower containsString:@"controlcenter.audio"]) return YES;
    // Class-family fallback, kept deliberately narrow. On the builds where the
    // labels are missing, MRUContinuousSliderView (brightness) and
    // MRUVolumeSliderView (volume) are the two classes that carry these
    // sliders. The match is on the exact class name, not on a shared prefix,
    // so MediaControls' other MRU* sliders (scrubbers, route pickers) are not
    // swept in by a loose "mruslider" substring.
    NSString *className = NSStringFromClass(slider.class);
    if ([className isEqualToString:@"MRUContinuousSliderView"] ||
        [className isEqualToString:@"MRUVolumeSliderView"]) return YES;
    return NO;
}

// The gesture handler is an ObjC method because that is what a recogniser
// target requires. It lives on EchoRebornCoordinator (the singleton already used
// as the other display-link target) and is declared on that class further down.
static void ERSliderInstallTrackingGesture(UIView *slider) {
    if (!slider) return;
    if (objc_getAssociatedObject(slider, &kERSliderTrackingGestureKey)) return;
    if (!ERSliderBelongsToAdjustmentModule(slider)) return;
    Class coordinatorClass = NSClassFromString(@"EchoRebornCoordinator");
    id coordinator = coordinatorClass ? ((id (*)(id, SEL))objc_msgSend)(coordinatorClass, @selector(shared)) : nil;
    if (!coordinator) return;
    // A dedicated recogniser rather than one that competes with the system's:
    // `cancelsTouchesInView = NO` and a very permissive delegate keep the
    // slider's own drag working exactly as before. This recogniser only
    // observes, so a simultaneous-recognition failure would break nothing —
    // but it is avoided anyway by never claiming the touch.
    UIPanGestureRecognizer *tracking = [[UIPanGestureRecognizer alloc] initWithTarget:coordinator
                                                                             action:@selector(erSliderTrackingGestureFired:)];
    tracking.cancelsTouchesInView = NO;
    tracking.delaysTouchesBegan = NO;
    tracking.delaysTouchesEnded = NO;
    tracking.minimumNumberOfTouches = 1;
    tracking.maximumNumberOfTouches = 1;
    // THE delegate is what makes this an observer instead of a competitor.
    //
    // Two pan recognisers attached to the SAME view do not recognise together
    // unless a delegate says so — that is UIKit's default. Without the line
    // below, ours and the slider's own pan block each other and whichever
    // reaches Began first wins outright:
    //   * ours wins  -> the slider's recogniser is cancelled, the fill stops
    //                   following the finger ("拖动偶发失效");
    //   * theirs wins -> ours is cancelled, -erSliderTrackingGestureFired:
    //                   receives Cancelled, tears the display link down, and
    //                   the readout falls back to the coarse value the system
    //                   pushes through -setValue: ("百分比不实时").
    // Both outcomes are a race, which is why the symptom was intermittent.
    // EchoRebornCoordinator already answers
    // -gestureRecognizer:shouldRecognizeSimultaneouslyWithGestureRecognizer:
    // with YES for exactly this recogniser (matched by
    // ERGestureIsSliderTracking), but that answer was never reachable because
    // the delegate was never assigned. Assigning it lets both run at once.
    tracking.delegate = (id<UIGestureRecognizerDelegate>)coordinator;
    // Never let our observer win a contest against the slider's own gesture:
    // a failure requirement would suppress the system recogniser if ours
    // failed first.
    [slider addGestureRecognizer:tracking];
    // TWO associations, deliberately.
    //
    // The slider side is the "already installed" guard, so a second call on
    // the same slider does not stack a second recogniser.
    //
    // The gesture side is what -ERGestureIsSliderTracking reads. Earlier
    // builds only stored the slider->gesture edge, which meant
    // -ERGestureIsSliderTracking(gesture) could never find anything: it looks
    // the key up on the GESTURE, and the value had been hung off the SLIDER.
    // That single mismatch silently disabled every recognition rule this
    // recogniser depended on:
    //   * -gestureRecognizer:shouldReceiveTouch: fell through to the generic
    //     UIControl rejection at the end of that method (sliders are controls),
    //     so the observer was refused the touch outright and its callback
    //     never ran — the readout stayed on the coarse -setValue: value;
    //   * -gestureRecognizer:shouldRecognizeSimultaneouslyWith...: answered NO,
    //     so the observer and the slider's own pan blocked each other and a
    //     race decided whether the fill followed the finger ("拖动偶发失效").
    // Setting the association on BOTH objects makes the helper answer YES and
    // restores the intended behaviour.
    objc_setAssociatedObject(slider, &kERSliderTrackingGestureKey,
                             tracking, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(tracking, &kERSliderTrackingGestureKey,
                             @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    ERLogInfo(@"readout: installed tracking gesture on %@", NSStringFromClass(slider.class));
}

// YES when the recogniser is EchoReborn's own slider observer. Used by the
// gesture delegate to keep it from ever being blocked.
static BOOL ERGestureIsSliderTracking(UIGestureRecognizer *gesture) {
    if (!gesture) return NO;
    // A single, exact test: the flag is hung off the recogniser itself by
    // -ERSliderInstallTrackingGesture. Nothing else in EchoReborn sets this key.
    //
    // Do NOT fall back to matching on -allTargets. Every gesture EchoReborn
    // installs (the pager pan, the edit-dismiss pan, the module pan) has
    // EchoRebornCoordinator as its target, so a target-based test would report
    // them all as the slider observer — which would make
    // -gestureRecognizer:shouldReceiveTouch: hand them every touch
    // unconditionally and make -shouldRecognizeSimultaneously... allow them to
    // run against anything. That would break paging and edit-mode dragging,
    // i.e. exactly the "do not disturb any other interaction" constraint.
    return objc_getAssociatedObject(gesture, &kERSliderTrackingGestureKey) != nil;
}

// ---------------------------------------------------------------------------
// Slider observation — how brightness/volume readouts actually work.
//
// History, because this took five attempts and two bricked boots:
//
//   * `%hook CCUIContinuousSliderView -_handleValueChangeGestureRecognizer:`
//     never fired: on iOS 17 the brightness slider is MRUContinuousSliderView,
//     a private MediaControls class that is NOT a CCUIContinuousSliderView.
//   * Runtime enumeration + swizzling -layoutSubviews (v0.3.2) recursed and hit
//     the stack guard: method_getImplementation(class_getInstanceMethod(...))
//     captured an already-swizzled ancestor IMP.
//   * The class_addMethod-only rewrite (v0.3.3) recursed TOO, for a different
//     and less obvious reason — see the note below.
//
// ---------------------------------------------------------------------------
// WHY v0.3.3 STILL CRASHED — the lesson that shapes the code below.
//
// The crash log showed 253 repetitions of just two frames:
//
//     EchoReborn.dylib   +0x6AE78
//     liquidass.dylib +0x146948
//
// +0x6AE78 is inside the function that resolved the original implementation by
// repeatedly calling class_getSuperclass(). liquidass.dylib is ANOTHER tweak,
// and it interposes that runtime function. So the sequence was:
//
//     trampoline -> walk hierarchy -> class_getSuperclass (liquidass hook)
//                -> liquidass eventually lays out / re-enters
//                -> trampoline -> walk hierarchy -> ...
//
// Every hop was a FRESH stack frame, so the `depth < 64` counter — local to
// each activation, exactly as a local always is — could never observe the
// recursion. A loop guard can only bound a loop that lives in one frame; it is
// powerless against re-entry from outside.
//
// The wider lesson: on a jailbroken SpringBoard we do not own the runtime.
// Any public runtime function (class_getSuperclass, class_copyMethodList,
// class_getInstanceMethod, ...) may be interposed by any other installed
// tweak, and calling one from inside a swizzled method creates a re-entry path
// we cannot audit. The only reliable fix is to not be on that path at all.
//
// Therefore this version does the following and nothing else:
//
//   1. NO -layoutSubviews swizzling. Not with class_addMethod, not with
//      class_replaceMethod, not ever. Nothing of ours runs during SpringBoard's
//      layout passes, so no re-entry is possible by construction.
//   2. NO call-time class hierarchy walking. The only hierarchy introspection
//      happens inside the installer, on the main queue, outside any layout
//      pass, and it is wrapped so a broken superclass chain cannot spin.
//   3. The readout is driven purely by a UIPanGestureRecognizer we own plus the
//      value setter. Both are ordinary message sends to our own object; neither
//      goes through a runtime function another tweak can interpose.
//
// The tracking gesture is attached when a slider is first SEEN, which happens
// in -ERSliderReadoutTick (called from the value setter and from the module
// layout code EchoReborn already hooks for its own UI work), so losing the
// -layoutSubviews trampoline costs nothing functional.
// ---------------------------------------------------------------------------

// NOTE: there is deliberately no class-name matcher and no runtime installer
// here any more. The two previous builds both had one, and both crashed
// SpringBoard. Identification of a slider happens on the instance in
// -ERSliderBelongsToAdjustmentModule, which reads accessibility labels and
// view-controller identifiers — plain message sends, no runtime APIs for
// another tweak to interpose.

// Called from the value setter and from EchoReborn's own module-layout code when a
// brightness/volume slider is first seen; attaches the tracking gesture and
// keeps the readout link alive while a drag is ongoing even if the touch-down
// hook was missed (e.g. the gesture began before the tweak observed the slider).
static void ERSliderReadoutTick(UIView *slider, float value) {
    if (!gEnabled || gEditModeActive) return;
    // Installing the observer is independent of the display link: it has to be
    // in place before the drag starts, so it runs on every call.
    ERSliderInstallTrackingGesture(slider);
    if (gERSliderReadoutTarget == slider && gERSliderReadoutLink) return;
    // Only auto-start for sliders that belong to the brightness/volume family;
    // a plain tap elsewhere must not spin up a link.
    if (!ERSliderBelongsToAdjustmentModule(slider)) return;
    (void)value;
    ERSliderReadoutBegin(slider);
}

static NSArray<UIViewController *> *ERCollectModuleControllers(UIViewController *root) {
    if (!root) return @[];
    NSMutableArray *result = [NSMutableArray array];
    NSMutableArray *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIViewController *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if (candidate != root && ERIsModuleController(candidate)) [result addObject:candidate];
        [queue addObjectsFromArray:candidate.childViewControllers];
    }
    return result;
}

static UIViewController *ERModuleControllerMatchingObject(UIViewController *overlay, id object) {
    NSString *identifier = ERIdentifierFromObject(object);
    for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
        if (identifier.length && [ERModuleIdentifier(candidate) isEqualToString:identifier]) return candidate;
        @try {
            if ([candidate valueForKey:@"module"] == object) return candidate;
        } @catch (__unused NSException *exception) {}
    }
    return nil;
}

static CGRect ERVisibleModuleFrame(UIViewController *module, UIViewController *overlay) {
    // convertRect already walks the transformed wrapper hierarchy. Applying
    // the edit translation again displaced hit testing and landing by 48pt.
    return [module.view convertRect:module.view.bounds toView:overlay.view];
}

static BOOL ERExpandedChromeRevealActive(void) {
    return CACurrentMediaTime() < gERExpandedChromeRevealUntil;
}

static void ERApplyExpansionPageGeometrySync(UIViewController *overlay) {
    if (!overlay || gERCurrentPage == 0) return;
    if (objc_getAssociatedObject(overlay, kERExpansionPageGeometrySyncKey)) return;
    id coordinator = ((id (*)(id, SEL))objc_msgSend)(NSClassFromString(@"EchoRebornCoordinator"), @selector(shared));
    UIViewController *collection = ((id (*)(id, SEL, id))objc_msgSend)(coordinator, NSSelectorFromString(@"moduleCollectionControllerInOverlay:"), overlay);
    if (!collection.view) return;
    ((void (*)(id, SEL, id))objc_msgSend)(coordinator, NSSelectorFromString(@"capturePresentationStateForView:"), collection.view);
    CGAffineTransform currentTransform = collection.view.transform;
    CATransform3D currentSublayerTransform = collection.view.layer.sublayerTransform;
    objc_setAssociatedObject(collection.view, kERExpansionCollectionLayerPositionKey,
                             [NSValue valueWithCGPoint:collection.view.layer.position], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    CGAffineTransform base = [objc_getAssociatedObject(collection.view, kEROriginalTransformKey) CGAffineTransformValue];
    CATransform3D sublayerBase = [objc_getAssociatedObject(collection.view, kEROriginalSublayerTransformKey) CATransform3DValue];
    CGFloat editOffset = gEditModeActive ? 0.0 : kERRestingModuleOffset;
    CGFloat pageOffset = -(CGFloat)gERCurrentPage * ERVisualPageSpan();
    NSDictionary *record = @{
        @"collection": collection.view,
        @"transform": [NSValue valueWithCGAffineTransform:currentTransform],
        @"sublayerTransform": [NSValue valueWithCATransform3D:currentSublayerTransform],
    };
    objc_setAssociatedObject(overlay, kERExpansionPageGeometrySyncKey, record, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [UIView performWithoutAnimation:^{
        [collection.view.layer removeAnimationForKey:@"EchoRebornPageStackSlide"];
        collection.view.transform = CGAffineTransformTranslate(base, 0.0, editOffset + pageOffset);
        collection.view.layer.sublayerTransform = sublayerBase;
    }];
}

static void ERRestoreExpansionPageGeometrySync(UIViewController *overlay) {
    NSDictionary *record = objc_getAssociatedObject(overlay, kERExpansionPageGeometrySyncKey);
    if (!record) return;
    objc_setAssociatedObject(overlay, kERExpansionPageGeometrySyncKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    UIView *collectionView = record[@"collection"];
    if (![collectionView isKindOfClass:[UIView class]]) return;
    NSValue *transformValue = record[@"transform"];
    NSValue *sublayerValue = record[@"sublayerTransform"];
    [UIView performWithoutAnimation:^{
        [collectionView.layer removeAnimationForKey:@"EchoRebornPageStackSlide"];
        if ([transformValue isKindOfClass:[NSValue class]]) collectionView.transform = transformValue.CGAffineTransformValue;
        if ([sublayerValue isKindOfClass:[NSValue class]]) collectionView.layer.sublayerTransform = sublayerValue.CATransform3DValue;
        NSArray<NSDictionary *> *wrapperRecords = record[@"wrappers"];
        for (NSDictionary *wrapperRecord in wrapperRecords) {
            UIView *wrapper = wrapperRecord[@"wrapper"];
            NSValue *wrapperTransformValue = wrapperRecord[@"transform"];
            if (![wrapper isKindOfClass:[UIView class]] || ![wrapperTransformValue isKindOfClass:[NSValue class]]) continue;
            wrapper.transform = wrapperTransformValue.CGAffineTransformValue;
        }
    }];
}

static void ERReassertExpansionPageGeometry(UIViewController *overlay) {
    if (!overlay || gERCurrentPage == 0) return;
    NSDictionary *record = objc_getAssociatedObject(overlay, kERExpansionPageGeometrySyncKey);
    UIView *collectionView = record[@"collection"];
    if (![collectionView isKindOfClass:[UIView class]]) return;
    CGAffineTransform base = [objc_getAssociatedObject(collectionView, kEROriginalTransformKey) CGAffineTransformValue];
    CATransform3D sublayerBase = [objc_getAssociatedObject(collectionView, kEROriginalSublayerTransformKey) CATransform3DValue];
    NSValue *positionValue = objc_getAssociatedObject(collectionView, kERExpansionCollectionLayerPositionKey);
    CGFloat editOffset = gEditModeActive ? 0.0 : kERRestingModuleOffset;
    CGFloat pageOffset = -(CGFloat)gERCurrentPage * ERVisualPageSpan();
    [collectionView.layer removeAnimationForKey:@"EchoRebornPageStackSlide"];
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    if (positionValue) collectionView.layer.position = positionValue.CGPointValue;
    collectionView.transform = CGAffineTransformTranslate(base, 0.0, editOffset + pageOffset);
    collectionView.layer.sublayerTransform = sublayerBase;
    [CATransaction commit];
}

static void ERHoldExpansionPageGeometryDuringDismissal(UIViewController *overlay) {
    if (!overlay || gERCurrentPage == 0) return;
    id token = [NSObject new];
    objc_setAssociatedObject(overlay, kERExpansionGeometryHoldTokenKey, token, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    for (NSUInteger frame = 0; frame <= 42; frame++) {
        NSTimeInterval delay = (NSTimeInterval)frame / 60.0;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{
            if (objc_getAssociatedObject(overlay, kERExpansionGeometryHoldTokenKey) != token) return;
            if (!gERExpandedModuleClosingActive) return;
            ERReassertExpansionPageGeometry(overlay);
        });
    }
}

static void ERDiscardExpansionSourceSnapshot(void) {
    [gERExpansionSourceSnapshot removeFromSuperview];
    gERExpansionSourceSnapshot = nil;
}

static void ERDiscardExpansionDismissalSnapshot(void) {
    [gERExpansionDismissalSnapshot removeFromSuperview];
    gERExpansionDismissalSnapshot = nil;
    [gERExpansionDismissalForegroundSnapshot removeFromSuperview];
    gERExpansionDismissalForegroundSnapshot = nil;
}

static BOOL ERExpansionIdentifierUsesLiveTransition(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    return [lower containsString:@"connectivity"] ||
        [lower isEqualToString:@"com.apple.control-center.displaymodule"] ||
        [lower hasPrefix:@"com.apple.mediaremote.controlcenter."];
}

static BOOL ERViewTreeContainsLiveExpansionContent(UIView *root) {
    if (!root) return NO;
    NSString *className = NSStringFromClass(root.class);
    if ([className isEqualToString:@"CCUIBaseSliderView"] ||
        [className isEqualToString:@"CCUIContinuousSliderView"] ||
        [className containsString:@"MRUNowPlaying"] ||
        [className containsString:@"MRUControlCenter"]) return YES;
    for (UIView *subview in root.subviews) {
        if (ERViewTreeContainsLiveExpansionContent(subview)) return YES;
    }
    return NO;
}

static BOOL ERUsesSpecializedExpansionTransition(UIViewController *presented) {
    return gERConnectivityExpansionActive ||
        ERExpansionIdentifierUsesLiveTransition(gERExpandedModuleIdentifier) ||
        ERViewTreeContainsLiveExpansionContent(presented.view);
}

static void ERRestoreHiddenExpansionLiveViews(void) {
    [UIView performWithoutAnimation:^{
        [gERExpansionHiddenLiveViews enumerateObjectsUsingBlock:^(UIView *liveView, NSUInteger index, __unused BOOL *stop) {
            if (index < gERExpansionHiddenLiveAlphas.count) {
                liveView.alpha = gERExpansionHiddenLiveAlphas[index].doubleValue;
            }
            if (index < gERExpansionHiddenLiveLayerOpacities.count) {
                liveView.layer.opacity = gERExpansionHiddenLiveLayerOpacities[index].floatValue;
            }
        }];
    }];
    gERExpansionHiddenLiveViews = nil;
    gERExpansionHiddenLiveAlphas = nil;
    gERExpansionHiddenLiveLayerOpacities = nil;
}

static void ERDiscardExpandedDismissalSnapshot(void) {
    [gERExpansionExpandedSnapshot removeFromSuperview];
    gERExpansionExpandedSnapshot = nil;
}

static void ERDiscardExpansionCompactTransitionAssets(void) {
    [gERExpansionCompactMaterialTemplate removeFromSuperview];
    gERExpansionCompactMaterialTemplate = nil;
    gERExpansionCompactForegroundImage = nil;
    gERExpansionCompactImage = nil;
    gERExpansionTransitionWindow = nil;
    gERExpansionCompactDestinationWindowFrame = CGRectZero;
    gERExpansionExpandedContentAnchorWindow = CGPointZero;
}

static void ERResetGenericExpansionDismissal(void) {
    gERExpansionDismissalGeneration++;
    ERRestoreHiddenExpansionLiveViews();
    ERDiscardExpandedDismissalSnapshot();
    ERDiscardExpansionDismissalSnapshot();
    gERExpansionDismissalAnimatorFinished = NO;
    gERExpansionDismissalDidClose = NO;
}

static void ERCompleteGenericExpansionDismissalIfReady(void) {
    if (!gERExpansionDismissalAnimatorFinished || !gERExpansionDismissalDidClose) return;
    for (UIView *liveView in gERExpansionHiddenLiveViews) {
        [liveView.superview layoutIfNeeded];
        [liveView layoutIfNeeded];
    }
    [UIView performWithoutAnimation:^{
        [gERExpansionHiddenLiveViews enumerateObjectsUsingBlock:^(UIView *liveView, NSUInteger index, __unused BOOL *stop) {
            if (index < gERExpansionHiddenLiveAlphas.count) {
                liveView.alpha = gERExpansionHiddenLiveAlphas[index].doubleValue;
            }
            if (index < gERExpansionHiddenLiveLayerOpacities.count) {
                liveView.layer.opacity = gERExpansionHiddenLiveLayerOpacities[index].floatValue;
            }
        }];
        [gERExpansionExpandedSnapshot removeFromSuperview];
        [gERExpansionDismissalSnapshot removeFromSuperview];
        [gERExpansionDismissalForegroundSnapshot removeFromSuperview];
    }];
    gERExpansionHiddenLiveViews = nil;
    gERExpansionHiddenLiveAlphas = nil;
    gERExpansionHiddenLiveLayerOpacities = nil;
    gERExpansionExpandedSnapshot = nil;
    gERExpansionDismissalSnapshot = nil;
    gERExpansionDismissalForegroundSnapshot = nil;
    ERDiscardExpansionCompactTransitionAssets();
    gERExpansionDismissalAnimatorFinished = NO;
    gERExpansionDismissalDidClose = NO;
}

static void ERFreezeExpandedModuleForDismissal(UIViewController *presented) {
    ERDiscardExpandedDismissalSnapshot();
    if (!presented.view || !presented.view.superview || CGRectIsEmpty(presented.view.bounds)) return;
    [presented.view.superview layoutIfNeeded];
    [presented.view layoutIfNeeded];

    UIView *expandedBackground = ERFindSubviewWithClassName(presented.view, @"CCUIContentModuleBackgroundView");
    UIView *contentContainer = ERFindSubviewWithClassName(presented.view, @"CCUIContentModuleContentContainerView");
    UIView *expandedSurface = contentContainer ?: expandedBackground;
    UIView *snapshot = expandedSurface ? ERWindowCropSnapshotView(expandedSurface) : nil;
    CGRect snapshotFrame = expandedSurface
        ? [expandedSurface convertRect:expandedSurface.bounds toView:presented.view.superview]
        : presented.view.frame;
    if (snapshot) {
        snapshot.layer.cornerRadius = expandedSurface.layer.cornerRadius;
        snapshot.layer.cornerCurve = kCACornerCurveContinuous;
        snapshot.layer.masksToBounds = YES;
    }
    if (!snapshot) snapshot = ERCompositedSnapshotView(presented.view);
    if (!snapshot) snapshot = ERWindowCropSnapshotView(presented.view);
    if (!snapshot) return;
    UIWindow *window = expandedSurface.window ?: presented.view.window;
    if (window && expandedSurface) {
        snapshotFrame = [expandedSurface convertRect:expandedSurface.bounds toView:window];
    } else if (window) {
        snapshotFrame = [presented.view convertRect:presented.view.bounds toView:window];
    }
    snapshot.frame = snapshotFrame;
    snapshot.userInteractionEnabled = NO;
    if (window) [window addSubview:snapshot];
    else [presented.view.superview insertSubview:snapshot aboveSubview:presented.view];
    gERExpansionExpandedSnapshot = snapshot;

    if (window && contentContainer) {
        CGRect contentFrame = [contentContainer convertRect:contentContainer.bounds toView:window];
        gERExpansionExpandedContentAnchorWindow = CGPointMake(CGRectGetMidX(contentFrame), CGRectGetMidY(contentFrame));
    } else {
        gERExpansionExpandedContentAnchorWindow = CGPointMake(CGRectGetMidX(snapshotFrame), CGRectGetMidY(snapshotFrame));
    }
    NSMutableArray<UIView *> *liveViews = [NSMutableArray array];
    if (expandedSurface) [liveViews addObject:expandedSurface];
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithArray:presented.view.subviews];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        BOOL alreadyCovered = expandedSurface && [candidate isDescendantOfView:expandedSurface];
        NSString *className = NSStringFromClass(candidate.class);
        NSString *text = nil;
        SEL textSelector = NSSelectorFromString(@"text");
        if ([candidate respondsToSelector:textSelector]) {
            @try {
                id value = ((id (*)(id, SEL))objc_msgSend)(candidate, textSelector);
                if ([value isKindOfClass:[NSString class]]) text = value;
            } @catch (__unused NSException *exception) {}
        }
        BOOL textSurface = text.length || [className containsString:@"Label"] || [className containsString:@"Header"];
        if (textSurface && candidate.window == window) {
            CGRect candidateFrame = [candidate convertRect:candidate.bounds toView:window];
            BOOL intersects = CGRectIntersectsRect(candidateFrame, snapshotFrame) ||
                CGRectIntersectsRect(candidateFrame, gERExpansionCompactDestinationWindowFrame);
            CGFloat candidateArea = CGRectGetWidth(candidateFrame) * CGRectGetHeight(candidateFrame);
            CGFloat platterArea = CGRectGetWidth(snapshotFrame) * CGRectGetHeight(snapshotFrame);
            BOOL select = !alreadyCovered && intersects && candidateArea > 0.0 && candidateArea < platterArea * 0.6;
            if (select && ![liveViews containsObject:candidate]) [liveViews addObject:candidate];
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
    if (!liveViews.count) {
        ERDiscardExpandedDismissalSnapshot();
        return;
    }
    NSMutableArray<NSNumber *> *alphas = [NSMutableArray arrayWithCapacity:liveViews.count];
    NSMutableArray<NSNumber *> *layerOpacities = [NSMutableArray arrayWithCapacity:liveViews.count];
    for (UIView *liveView in liveViews) {
        [alphas addObject:@(liveView.alpha)];
        [layerOpacities addObject:@(liveView.layer.opacity)];
    }
    gERExpansionHiddenLiveViews = liveViews;
    gERExpansionHiddenLiveAlphas = alphas;
    gERExpansionHiddenLiveLayerOpacities = layerOpacities;
    [UIView performWithoutAnimation:^{
        for (UIView *liveView in liveViews) {
            liveView.alpha = 0.0;
            liveView.layer.opacity = 0.0;
        }
    }];
}

static void ERInstallExpansionDismissalSnapshot(id clickAssistant) {
    (void)clickAssistant;
    ERDiscardExpansionDismissalSnapshot();
    UIWindow *window = gERExpansionExpandedSnapshot.window ?: gERExpansionTransitionWindow;
    CGRect startFrame = gERExpansionExpandedSnapshot.frame;
    if (!window || CGRectIsEmpty(startFrame) || CGRectIsEmpty(gERExpansionCompactDestinationWindowFrame)) return;
    UIView *proxy = [[UIView alloc] initWithFrame:startFrame];
    proxy.backgroundColor = UIColor.clearColor;
    proxy.userInteractionEnabled = NO;
    proxy.alpha = 0.0;
    proxy.layer.cornerRadius = gERExpansionExpandedSnapshot.layer.cornerRadius;
    proxy.layer.cornerCurve = kCACornerCurveContinuous;
    proxy.layer.masksToBounds = YES;
    UIView *material = gERExpansionCompactMaterialTemplate;
    if (material) {
        material.frame = proxy.bounds;
        material.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        material.userInteractionEnabled = NO;
        [proxy addSubview:material];
    }
    if (gERExpansionExpandedSnapshot.superview == window) {
        [window insertSubview:proxy belowSubview:gERExpansionExpandedSnapshot];
    } else {
        [window addSubview:proxy];
    }
    UIImage *foregroundImage = gERExpansionCompactForegroundImage ?: gERExpansionCompactImage;
    if (foregroundImage) {
        UIImageView *foreground = [[UIImageView alloc] initWithImage:foregroundImage];
        foreground.bounds = (CGRect){CGPointZero, gERExpansionCompactDestinationWindowFrame.size};
        foreground.center = gERExpansionExpandedContentAnchorWindow;
        foreground.contentMode = UIViewContentModeScaleToFill;
        foreground.userInteractionEnabled = NO;
        foreground.alpha = 0.0;
        if (gERExpansionExpandedSnapshot.superview == window) {
            [window insertSubview:foreground belowSubview:gERExpansionExpandedSnapshot];
        } else {
            [window addSubview:foreground];
        }
        gERExpansionDismissalForegroundSnapshot = foreground;
    }
    gERExpansionDismissalSnapshot = proxy;
}

static UIViewPropertyAnimator *ERExpansionPropertyAnimator(id clickAssistant) {
    SEL selector = NSSelectorFromString(@"presentationAnimator");
    if ([clickAssistant respondsToSelector:selector]) {
        id animator = ((id (*)(id, SEL))objc_msgSend)(clickAssistant, selector);
        if ([animator isKindOfClass:[UIViewPropertyAnimator class]]) return animator;
    }
    Ivar animatorIvar = class_getInstanceVariable([clickAssistant class], "_presentationAnimator");
    id animator = animatorIvar ? object_getIvar(clickAssistant, animatorIvar) : nil;
    return [animator isKindOfClass:[UIViewPropertyAnimator class]] ? animator : nil;
}

// The "+" and power buttons live in the status-bar band above Control Center's
// first module row.  That band's height differs between notch and Dynamic
// Island devices, so a fixed offset drifts out of alignment.  Anchor the button
// centres to the middle of the live status-bar inset instead, and let the
// preference add a manual correction on top.
// 快速访问 host 的宽度。
//
// 必须优先取「窗口」宽度：实测横屏下 controller.view.bounds.width 仍然返回竖屏的
// 430pt（和 UIScreen.mainScreen.bounds 不随转屏变化是同一类陷阱），只有窗口 bounds
// 会跟着转到 932pt。取错宽度，电源键就会被摆到 x = 430−22−20 = 388pt（实测 387.8，
// 完全吻合）而不是屏幕右边缘的 ≈890pt。
static CGFloat ERQuickAccessHostWidth(UIViewController *controller) {
    CGFloat width = 0.0;
    @try {
        UIWindow *window = controller.view.window;
        if (window) width = CGRectGetWidth(window.bounds);
    } @catch (__unused NSException *exception) {}
    if (width < 1.0 && controller.view) width = CGRectGetWidth(controller.view.bounds);
    if (width < 1.0) width = CGRectGetWidth(UIScreen.mainScreen.bounds);
    return width;
}

// 取一份「所有窗口」清单（含不属于任何 UIWindowScene 的系统窗口）。
//
// 0.5.19 需要它兜底找系统状态栏窗口（UIStatusBarWindow）。UIWindowScene.windows 会
// 漏掉没有 scene 的系统窗口，而 -[UIApplication windows] 从 iOS 15 起被标记废弃，
// 本工程开了 -Werror，直接写会编译失败 —— 这里显式关掉该告警，仅用于取清单。
static NSArray<UIWindow *> *ERAllApplicationWindows(void) {
    NSMutableArray<UIWindow *> *result = [NSMutableArray array];
    UIApplication *application = UIApplication.sharedApplication;
    if (!application) return result;
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wdeprecated-declarations"
    NSArray<UIWindow *> *legacy = application.windows;
#pragma clang diagnostic pop
    for (UIWindow *window in legacy) {
        if (window && ![result containsObject:window]) [result addObject:window];
    }
    for (UIScene *scene in application.connectedScenes) {
        if (![scene isKindOfClass:[UIWindowScene class]]) continue;
        for (UIWindow *window in ((UIWindowScene *)scene).windows) {
            if (window && ![result containsObject:window]) [result addObject:window];
        }
    }
    return result;
}

static CGFloat gERQABaselineTopInset = -1.0;   // 1.0.8-61：本次 CC 会话的基准顶部安全区
static CGFloat ERQuickAccessCenterYOffset(UIViewController *controller) {
    CGFloat statusBarHeight = 0.0;
    @try {
        UIWindow *window = controller.view.window;
        if (window) statusBarHeight = MAX(statusBarHeight, window.safeAreaInsets.top);
    } @catch (__unused NSException *exception) {}
    @try {
        statusBarHeight = MAX(statusBarHeight, controller.view.safeAreaInsets.top);
    } @catch (__unused NSException *exception) {}
    // Insets can read zero before the first layout pass; 56pt reproduces the
    // previous hard-coded geometry (top -48 on a 40pt button => centre -28).
    if (statusBarHeight < 1.0) statusBarHeight = 56.0;
    // 1.0.8-61 · **基准锁定**：权限胶囊（相机/定位指示）出现时 iOS 会加大顶部安全区，
    // 按钮就跟着下移。这里只认**本次会话第一次读到的值**（胶囊未出现时的原位），
    // 之后一律用基准 —— 胶囊出现/消失按钮都纹丝不动；滑杆偏移照常叠加。
    // 1.0.9-8 · 竖屏下权限胶囊出现仍会让按钮下移：原来只认「首次读到的 top」，
    // 而竖屏打开控制中心时胶囊往往已经在，首读就含了胶囊的高度。改为认「会话内见过的最小 top」
    // （胶囊只会让安全区变大）—— 胶囊出现/消失，按钮都纹丝不动。
    if (gERQABaselineTopInset < 0.0 || statusBarHeight < gERQABaselineTopInset) {
        gERQABaselineTopInset = statusBarHeight;
    }
    statusBarHeight = gERQABaselineTopInset;
    CGFloat offset = -(statusBarHeight * 0.5) + gQuickAccessVerticalOffset;
    // 0.5.17 横屏修正：横屏 iPhone 的 safeAreaInsets.top 为 0，上面那行会落到
    // 硬编码 56 兜底 → offset = -28。竖屏时 host 顶部本来就低，-28 刚好把按钮放在
    // 状态栏同一行；横屏 host 顶部贴到屏幕顶端，同样的 -28 就把 40pt 按钮顶出屏外
    // （实测只露出 y 0–10pt 的字形，约 15pt 被裁）。
    // 横屏改为「状态栏上移后的下沿 + 间距」定位，并保留用户的
    // QuickAccessVerticalOffset 设置（叠加在最后，两个方向都生效）。
    if (ERLandscapePresentationActive()) offset += kERLandscapeCornerButtonDrop;
    return offset;
}

// 1.0.1：两枚快捷按钮的横向几何，读「增强设置 → 操作按钮」的两个滑杆。
// 都做区间夹取 —— plist 或偏好域被改坏时按钮不会飞出屏幕或缩成看不见的一点。
// 夹取后的值同时被「约束创建」和「约束原地刷新」使用，保证两条路径一致。
static CGFloat ERQuickAccessButtonInset(void) {
    return MIN(120.0, MAX(0.0, gQuickAccessHorizontalInset));
}

static CGFloat ERQuickAccessButtonSide(void) {
    return MIN(72.0, MAX(20.0, gQuickAccessButtonSize));
}

static UIView *ERCreateQuickAccessDismissalProxy(UIViewController *overlay, UIView *quickAccess) {
    if (!overlay.view || !quickAccess || gEditModeActive || !gQuickAccessButtonsEnabled) return nil;
    [[overlay.view viewWithTag:kERQuickAccessDismissalProxyTag] removeFromSuperview];
    UIView *proxy = [[UIView alloc] initWithFrame:overlay.view.bounds];
    proxy.tag = kERQuickAccessDismissalProxyTag;
    proxy.backgroundColor = UIColor.clearColor;
    proxy.userInteractionEnabled = NO;
    proxy.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;

    BOOL originalHidden = quickAccess.hidden;
    CGFloat originalAlpha = quickAccess.alpha;
    CGAffineTransform originalTransform = quickAccess.transform;
    [UIView performWithoutAnimation:^{
        quickAccess.hidden = NO;
        quickAccess.alpha = 1.0;
        quickAccess.transform = CGAffineTransformIdentity;
        [quickAccess.superview layoutIfNeeded];
        [quickAccess layoutIfNeeded];
    }];

    for (UIView *subview in quickAccess.subviews) {
        if (subview.hidden || subview.alpha <= 0.01) continue;
        CGRect frame = [subview.superview convertRect:subview.frame toView:overlay.view];
        if (CGRectIsEmpty(frame) || CGRectGetMaxY(frame) < -80.0 || CGRectGetMinY(frame) > CGRectGetHeight(overlay.view.bounds) + 80.0) continue;
        NSString *symbol = subview.tag == 181001 ? @"plus" : (subview.tag == 181002 ? @"power" : nil);
        UIView *snapshot = nil;
        if (symbol.length) {
            CGRect localBounds = CGRectMake(0.0, 0.0, CGRectGetWidth(frame), CGRectGetHeight(frame));
            snapshot = [[UIView alloc] initWithFrame:localBounds];
            snapshot.backgroundColor = UIColor.clearColor;
            // No material disk here either: the live quick-access buttons are
            // bare glyphs, and the proxy has to match them exactly.
            UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:15.0 weight:UIImageSymbolWeightSemibold];
            UIImage *image = [[UIImage systemImageNamed:symbol withConfiguration:configuration] imageWithTintColor:[UIColor colorWithWhite:1.0 alpha:0.97]
                                                                                                      renderingMode:UIImageRenderingModeAlwaysOriginal];
            UIImageView *glyph = [[UIImageView alloc] initWithImage:image];
            glyph.contentMode = UIViewContentModeCenter;
            glyph.frame = localBounds;
            glyph.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
            [snapshot addSubview:glyph];
        } else {
            snapshot = [subview snapshotViewAfterScreenUpdates:NO];
        }
        if (!snapshot) continue;
        snapshot.frame = frame;
        snapshot.userInteractionEnabled = NO;
        [proxy addSubview:snapshot];
    }

    [UIView performWithoutAnimation:^{
        quickAccess.hidden = originalHidden;
        quickAccess.alpha = originalAlpha;
        quickAccess.transform = originalTransform;
    }];
    if (!proxy.subviews.count) return nil;
    proxy.alpha = 0.0;
    proxy.transform = CGAffineTransformMakeTranslation(0.0, -9.0);
    [overlay.view addSubview:proxy];
    return proxy;
}

static void ERSetQuickAccessMaterialsHidden(UIView *quickAccess, BOOL hidden) {
    for (UIView *button in quickAccess.subviews) {
        UIView *material = [button viewWithTag:kERPowerMaterialTag];
        if (!material) continue;
        material.hidden = hidden;
        material.alpha = hidden ? 0.0 : 1.0;
    }
}

static void ERPrepareOverlayChromeForExpandedDismissal(UIViewController *overlay) {
    if (!overlay.view || !gERControlCenterPresented) return;
    gERExpandedChromeRevealUntil = CACurrentMediaTime() + 0.65;
    id coordinator = ((id (*)(id, SEL))objc_msgSend)(NSClassFromString(@"EchoRebornCoordinator"), @selector(shared));
    ((void (*)(id, SEL, id))objc_msgSend)(coordinator, NSSelectorFromString(@"installQuickAccessHostOnOverlay:"), overlay);
    ((void (*)(id, SEL, id))objc_msgSend)(coordinator, NSSelectorFromString(@"updatePageIndicatorsForOverlay:"), overlay);
    UIView *quickAccess = [overlay.view viewWithTag:181000];
    UIView *pageIndicators = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    UIView *quickAccessProxy = ERCreateQuickAccessDismissalProxy(overlay, quickAccess);
    NSMutableArray<UIView *> *targets = [NSMutableArray array];
    if (quickAccessProxy) {
        [overlay.view bringSubviewToFront:quickAccessProxy];
        [targets addObject:quickAccessProxy];
    }
    if (pageIndicators && gERPageCount > 1) {
        if (pageIndicators.superview) [pageIndicators.superview bringSubviewToFront:pageIndicators];
        pageIndicators.hidden = NO;
        pageIndicators.alpha = 0.0;
        [targets addObject:pageIndicators];
    }
    if (!targets.count) return;
    [UIView animateWithDuration:0.34 delay:0.02
                        options:UIViewAnimationOptionCurveEaseInOut |
                                UIViewAnimationOptionBeginFromCurrentState |
                                UIViewAnimationOptionAllowUserInteraction
                     animations:^{
        quickAccessProxy.alpha = quickAccessProxy ? 1.0 : 0.0;
        quickAccessProxy.transform = CGAffineTransformIdentity;
        pageIndicators.alpha = pageIndicators ? 1.0 : 0.0;
    } completion:^(__unused BOOL finished) {
        if (!quickAccessProxy) return;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.46 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *liveQuickAccess = [overlay.view viewWithTag:181000];
            if (liveQuickAccess && !gEditModeActive && gQuickAccessButtonsEnabled && gERControlCenterPresented) {
                [UIView performWithoutAnimation:^{
                    liveQuickAccess.hidden = NO;
                    liveQuickAccess.alpha = 1.0;
                    liveQuickAccess.transform = CGAffineTransformIdentity;
                    ERSetQuickAccessMaterialsHidden(liveQuickAccess, YES);
                    for (UIView *button in liveQuickAccess.subviews) {
                        for (UIView *child in button.subviews) if (child.tag != kERPowerMaterialTag) child.alpha = 0.0;
                    }
                }];
            }
            [UIView animateWithDuration:0.12 delay:0.0
                                options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction
                             animations:^{
                for (UIView *button in quickAccessProxy.subviews) {
                    for (UIView *child in button.subviews) if (child.tag != kERPowerMaterialTag) child.alpha = 0.0;
                }
                if (liveQuickAccess) {
                    for (UIView *button in liveQuickAccess.subviews) {
                        for (UIView *child in button.subviews) if (child.tag != kERPowerMaterialTag) child.alpha = 1.0;
                    }
                }
            }
                             completion:^(__unused BOOL done) {
                if (liveQuickAccess && !gEditModeActive && gQuickAccessButtonsEnabled && gERControlCenterPresented) {
                    [UIView performWithoutAnimation:^{
                        ERSetQuickAccessMaterialsHidden(liveQuickAccess, NO);
                        liveQuickAccess.alpha = 1.0;
                        liveQuickAccess.transform = CGAffineTransformIdentity;
                    }];
                }
                [quickAccessProxy removeFromSuperview];
            }];
        });
    }];
}

static UIView *ERFindSubviewWithClassName(UIView *root, NSString *className) {
    if (!root) return nil;
    if ([NSStringFromClass(root.class) isEqualToString:className]) return root;
    for (UIView *subview in root.subviews) {
        UIView *match = ERFindSubviewWithClassName(subview, className);
        if (match) return match;
    }
    return nil;
}

static UIView *ERFindAncestorOrSubviewWithClassName(UIView *view, NSString *className) {
    for (UIView *ancestor = view; ancestor; ancestor = ancestor.superview) {
        if ([NSStringFromClass(ancestor.class) isEqualToString:className]) return ancestor;
    }
    return ERFindSubviewWithClassName(view, className);
}

static void ERSetContinuousCornerRadiusIvar(id object, NSString *ivarName, CGFloat value) {
    if (!object || !ivarName.length) return;
    Ivar ivar = class_getInstanceVariable([object class], ivarName.UTF8String);
    if (!ivar) return;
    const char *encoding = ivar_getTypeEncoding(ivar);
    ptrdiff_t offset = ivar_getOffset(ivar);
    uint8_t *bytes = (uint8_t *)(__bridge void *)object;
    if (encoding && encoding[0] == 'd') {
        *((double *)(bytes + offset)) = (double)value;
    } else {
        *((float *)(bytes + offset)) = (float)value;
    }
}

static UIImageView *EREnsureResizePresentationGlyph(UIView *presentation, NSString *symbolName) {
    UIImageView *glyph = (UIImageView *)[presentation viewWithTag:kERResizePresentationGlyphTag];
    if (!glyph) {
        glyph = [[UIImageView alloc] initWithFrame:CGRectZero];
        glyph.tag = kERResizePresentationGlyphTag;
        glyph.userInteractionEnabled = NO;
        glyph.contentMode = UIViewContentModeCenter;
        glyph.tintColor = UIColor.whiteColor;
        [presentation addSubview:glyph];
    }
    // 0.5.10: 七个连通性符号共用一个字号。以前每个符号各配一个 pointSize
    // （27~31），同页并排自然大小不一；非连通性模块（power / sparkles 等）继续沿用
    // 原来的 27.0，不改变既有观感。
    static NSSet<NSString *> *connectivitySymbols = nil;
    if (!connectivitySymbols) {
        connectivitySymbols = [NSSet setWithObjects:@"wifi", @"airdrop", @"airplane",
                               @"antenna.radiowaves.left.and.right", @"personalhotspot",
                               @"network", @"bluetooth", nil];
    }
    CGFloat pointSize = (symbolName.length && [connectivitySymbols containsObject:symbolName])
        ? kERConnectivityGlyphPointSize : 27.0;
    UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:pointSize weight:UIImageSymbolWeightSemibold];
    UIImage *image = [UIImage systemImageNamed:symbolName withConfiguration:configuration];
    glyph.image = [image imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];
    glyph.frame = CGRectMake(0.0, 0.0, kERGridCellSize, kERGridCellSize);
    glyph.hidden = NO;
    glyph.alpha = 1.0;
    return glyph;
}

// v0.3.19: the seven connectivity glyphs arrive at their own intrinsic sizes —
// on device the extracted native glyphs measured 26x40, 39x30, 40x36, 48x30,
// 37x32 and 36x36 — and a UIImageView with contentMode Center paints each at
// exactly that size, which is why the tiles never read at one uniform size.
//
// 0.5.10: 归一规则从「最长边 = 36pt」改成「等比缩放后居中放进一个固定方框」。
// 只把最长边对齐并不能解决观感差异：26x40 会变成 23.4x36（看着细高），48x30 会
// 变成 36x22.5（看着扁宽），两者面积差了近一倍。现在七个图标的外框完全一致
// （boxSide x boxSide），差异只剩图标本身的宽高比——这正是「大小一致」的定义。
static UIImage *ERUniformConnectivityGlyphImage(UIImage *image, CGFloat boxSide) {
    if (!image || image.size.width < 0.5 || image.size.height < 0.5 || boxSide < 1.0) return image;
    // 0.5.11: 已经正好是目标方框就原样返回，不要再造一个新对象。
    //
    // 本函数跑在布局路径上（每个布局周期都会被调用）。返回一个**新的** UIImage
    // 对象并赋给 UIImageView，会让视图认为内容变了、再次请求布局，下一次布局又
    // 走到这里再造一个新对象 —— 布局反馈回环。0.5.10 去掉了这条短路，加上调用点
    // 无条件赋值，主线程被这个回环占满 120 秒，表现就是 watchdog 超时、反复注销。
    if (fabs(image.size.width - boxSide) < 0.5 && fabs(image.size.height - boxSide) < 0.5) return image;
    CGFloat scale = MIN(boxSide / image.size.width, boxSide / image.size.height);
    CGSize target = CGSizeMake(MAX(1.0, round(image.size.width * scale)),
                               MAX(1.0, round(image.size.height * scale)));
    UIGraphicsImageRendererFormat *format = [[UIGraphicsImageRendererFormat alloc] init];
    format.scale = [UIScreen mainScreen].scale;
    format.opaque = NO;
    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(boxSide, boxSide) format:format];
    UIImage *redrawn = [renderer imageWithActions:^(UIGraphicsImageRendererContext *context) {
        CGRect rect = CGRectMake(round((boxSide - target.width) * 0.5),
                                 round((boxSide - target.height) * 0.5),
                                 target.width, target.height);
        [image drawInRect:rect];
    }];
    if (!redrawn) return image;
    return [redrawn imageWithRenderingMode:image.renderingMode];
}

static void ERRestoreTextSizeNativeViews(UIView *root) {
    if (!root) return;
    for (NSString *className in @[@"CCUISteppedSliderView", @"AXCCIconImageView"]) {
        NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
        while (queue.count) {
            UIView *candidate = queue.firstObject;
            [queue removeObjectAtIndex:0];
            if ([NSStringFromClass(candidate.class) isEqualToString:className]) {
                [candidate.layer removeAllAnimations];
                candidate.hidden = NO;
                candidate.alpha = 1.0;
                candidate.layer.opacity = 1.0;
            }
            [queue addObjectsFromArray:candidate.subviews];
        }
    }
}

static BOOL ERModuleLooksExpandedNow(UIViewController *module) {
    if (!module.view || !gERExpandedModuleOpen) return NO;
    NSString *identifier = ERModuleIdentifier(module);
    if (identifier.length && [identifier isEqualToString:gERExpandedModuleIdentifier]) return YES;
    if (!gERExpandedModuleIdentifier.length) {
        @try {
            UIView *container = ERFindAncestorOrSubviewWithClassName(module.view, @"CCUIContentModuleContentContainerView");
            if ([[container valueForKey:@"_expanded"] boolValue]) return YES;
        } @catch (__unused NSException *exception) {}
    }
    return CGRectGetWidth(module.view.bounds) > 190.0 || CGRectGetHeight(module.view.bounds) > 190.0;
}

static void ERHideNativeTextSizeCompactViews(UIView *root) {
    if (!root) return;
    for (NSString *className in @[@"CCUISteppedSliderView", @"AXCCIconImageView"]) {
        NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
        while (queue.count) {
            UIView *candidate = queue.firstObject;
            [queue removeObjectAtIndex:0];
            if ([NSStringFromClass(candidate.class) isEqualToString:className]) {
                [candidate.layer removeAllAnimations];
                candidate.hidden = YES;
                candidate.alpha = 0.0;
                candidate.layer.opacity = 0.0;
            }
            [queue addObjectsFromArray:candidate.subviews];
        }
    }
}

// Every class that can draw part of the native connectivity tile. When the tile
// is owned by us, ALL of them have to go: leaving any one visible puts a second
// glyph on screen next to ours, which is exactly the "中间会多一个图标" report
// on a widened tile.
//
// CCUIRoundButton is the one that matters most and the one that used to be
// missed: ERConnectivityNativeGlyphImage reads the module's glyph *out of* a
// CCUIRoundButton, so if we are taking a glyph from there, that button is
// visibly rendering it too. CCUILabeledRoundButton wraps it for the tiles that
// carry a caption (the 2x2 stock cluster); hiding only the wrapper left the
// inner button's glyph and material visible.
static BOOL ERNativeConnectivityViewShouldHide(UIView *view) {
    if (!view) return NO;
    // Our own chrome and the presentation layer are tagged >= 181000 and must
    // never be hidden by this pass.
    if (view.tag >= 181000) return NO;
    NSString *className = NSStringFromClass(view.class);
    static NSSet<NSString *> *classes = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        classes = [NSSet setWithArray:@[
            @"CCUIRoundButton",
            @"CCUILabeledRoundButton",
            @"CCUILabeledRoundButtonViewController",
            @"CCUIRoundButtonView",
            @"CCUIMenuModuleItemView",
        ]];
    });
    if ([classes containsObject:className]) return YES;
    // Anything whose name starts with CCUIRoundButton (subclasses, version
    // suffixes) is the same control as far as this pass is concerned.
    return [className hasPrefix:@"CCUIRoundButton"] || [className hasPrefix:@"CCUILabeledRoundButton"];
}

static void ERHideNativeConnectivityCompactViews(UIView *root) {
    if (!root) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if (ERNativeConnectivityViewShouldHide(candidate)) {
            [candidate.layer removeAllAnimations];
            candidate.hidden = YES;
            candidate.alpha = 0.0;
            candidate.layer.opacity = 0.0;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

static UIControl *ERFirstConnectivityRoundButton(UIView *root) {
    if (!root) return nil;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if ([candidate isKindOfClass:[UIControl class]] &&
            [NSStringFromClass(candidate.class) isEqualToString:@"CCUIRoundButton"]) {
            return (UIControl *)candidate;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
    return nil;
}

static UIImage *ERConnectivityNativeGlyphImage(UIView *root) {
    UIControl *button = ERFirstConnectivityRoundButton(root);
    if (!button) return nil;
    UIImageView *best = nil;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:(UIView *)button];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if ([candidate isKindOfClass:[UIImageView class]]) {
            UIImageView *imageView = (UIImageView *)candidate;
            if (imageView.image && imageView.alpha > 0.01 && !imageView.hidden) {
                best = imageView;
                break;
            }
            if (!best && imageView.image) best = imageView;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
    return best.image;
}

// The real glyph shipped inside ConnectivityModule.bundle's asset catalog.
// Unlike Bluetooth/WiFi (which have animatable CAPackages — Bluetooth.ca /
// WiFi.ca), AirDrop has no package and is absent from the compact grid, so the
// live-view proxy below never finds it. The named asset is the reliable source.
static UIImage *ERConnectivityBundleGlyphImage(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    NSString *assetName = nil;
    if ([lower containsString:@".airdrop"]) assetName = @"AirDropGlyph";
    if (!assetName) return nil;
    static NSBundle *connectivityBundle = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        connectivityBundle = [NSBundle bundleWithPath:@"/System/Library/ControlCenter/Bundles/ConnectivityModule.bundle"];
    });
    if (!connectivityBundle) return nil;
    return [UIImage imageNamed:assetName inBundle:connectivityBundle compatibleWithTraitCollection:nil];
}

static UIImage *ERConnectivityStockProxyGlyphImage(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    NSInteger tag = 0;
    if ([lower containsString:@".airdrop"]) tag = kERConnectivityCompactAirDropTag;
    if (tag) {
        for (UIViewController *overlay in gOverlayControllers.allObjects) {
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (![ERModuleIdentifier(module) isEqualToString:@"com.apple.control-center.ConnectivityModule"]) continue;
                UIView *proxy = [module.view viewWithTag:tag];
                NSMutableArray<UIView *> *queue = proxy ? [NSMutableArray arrayWithObject:proxy] : nil;
                while (queue.count) {
                    UIView *candidate = queue.firstObject;
                    [queue removeObjectAtIndex:0];
                    if ([candidate isKindOfClass:[UIImageView class]] && ((UIImageView *)candidate).image) return ((UIImageView *)candidate).image;
                    [queue addObjectsFromArray:candidate.subviews];
                }
            }
        }
    }
    // Fall back to the real asset-catalog glyph (fixes AirDrop, which otherwise
    // dropped to the generic fallback symbol).
    return ERConnectivityBundleGlyphImage(identifier);
}

// The view that paints a module tile's background.
//
// Historically this looked for an exactly-named `MTMaterialView`. That misses
// two real cases: a build where the platter is an MTMaterialView *subclass*, and
// a build where it is a plain UIVisualEffectView. Either miss made a converted
// tile believe it had no material and repaint a stand-in colour — which is how
// the OFF background kept drifting away from the rest of the page. Accept any
// Material-named view and any UIVisualEffectView instead; the size test (it must
// cover the tile) is what keeps this from picking up a button's own backing.
static UIView *ERFirstModuleMaterialSurface(UIView *root) {
    if (!root) return nil;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        NSString *name = NSStringFromClass(candidate.class);
        BOOL isMaterial = [name isEqualToString:@"MTMaterialView"] ||
                          [name containsString:@"Material"] ||
                          [candidate isKindOfClass:[UIVisualEffectView class]];
        if (isMaterial) {
            CGFloat widthDelta = fabs(CGRectGetWidth(candidate.bounds) - CGRectGetWidth(root.bounds));
            CGFloat heightDelta = fabs(CGRectGetHeight(candidate.bounds) - CGRectGetHeight(root.bounds));
            if (widthDelta < 4.0 && heightDelta < 4.0) return candidate;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
    return nil;
}

// Last-resort OFF background for a converted tile: a real blur, never a flat
// colour.
//
// Used when the module's own material cannot be used. The point is that an OFF
// tile must show the same *kind* of surface as every other module — a
// translucent material — rather than a painted grey, so a device we cannot
// inspect still gets a plausible tile instead of a hole or a lighter patch.
//
// The style is SystemThinMaterialDark, not the SystemUltraThinMaterialDark the
// other EchoReborn platters use. Ultra-thin was reported as "not dark enough" next
// to the stock Control Center tiles: it is the faintest of the dark materials,
// where a native module platter sits noticeably deeper. Thin is the next step up
// and is the single knob to turn if this still reads light (Material, then
// Chrome, are the further steps).
// Forward declaration: ERConnectivityNativeMaterialSource is defined later
// (~line 13649) but is needed by the glass-target helper below.
static UIView *ERConnectivityNativeMaterialSource(UIView *root);
static void ERDiagAppend(NSString *line);
static void ERDiagEditConnectivityModule(UIViewController *module);

// Nearest CCUIContentModuleContainerView ancestor of a view (or nil). Used to
// host the glass target where liquidass's inModule check is guaranteed true.
// v0.3.20: ERNearestModuleContainer was removed — the glass target now hosts
// on the module's direct wrapper (moduleView.superview), which follows the
// edit-mode -48pt wrapper translation and still satisfies liquidass's inModule
// ancestor check. See EREnsureConnectivityTileMaterial below.

// Builds a *visible* exact MTMaterialView that liquidass can detect and glass.
// ---------------------------------------------------------------------------
// Control Center material-host matcher (ported from LiquidAss Hooks/ControlCenter.x)
//
// The router in GlassKit/LGGlassKit.x hooks MTMaterialView globally and asks
// each registered host whether a given material is glassable. This is EchoReborn's
// Control Center answer — the same rules LiquidAss used: materials inside a
// CCUIContentModuleContainerView (module platters and expanded platters), plus
// the in-module slider fills, with LiquidAss's near-square module heuristic and
// its small-module radius memory.
// ---------------------------------------------------------------------------
static CGFloat sERSmallModuleRadius = 0.0;

static UIView *ERGlassModuleAncestor(UIView *v) {
    for (UIView *a = v.superview; a; a = a.superview)
        if (isExactClass(a, @"CCUIContentModuleContainerView")) return a;
    return nil;
}

static BOOL ERGlassIsModuleCandidate(UIView *module) {
    CGSize s = module.bounds.size;
    CGFloat mn = fmin(s.width, s.height), mx = fmax(s.width, s.height);
    if (mn < 20.0) return NO;
    return mx <= mn * 1.25;
}

static CGFloat ERGlassModuleCornerRadius(UIView *module) {
    CGFloat h = CGRectGetHeight(module.bounds);
    if (h <= 0.0) return 0.0;
    CGFloat r = h * 0.5;
    if (h < 100.0) { sERSmallModuleRadius = r; return r; }
    return sERSmallModuleRadius > 0.0 ? sERSmallModuleRadius : r;
}

static BOOL ERGlassIsSliderView(UIView *view) {
    Class cc = NSClassFromString(@"CCUIContinuousSliderView");
    Class mru = NSClassFromString(@"MRUContinuousSliderView");
    return view && ((cc && [view isKindOfClass:cc]) || (mru && [view isKindOfClass:mru]));
}

static UIView *ERGlassSliderAncestor(UIView *view) {
    for (UIView *v = view; v; v = v.superview)
        if (ERGlassIsSliderView(v)) return v;
    return nil;
}

static BOOL ERGlassIsInsideSlider(UIView *mat) {
    return hasAncestorOfClassName(mat, @"CCUIContinuousSliderView") ||
           hasAncestorOfClassName(mat, @"MRUContinuousSliderView");
}

static BOOL ERGlassHasSBElasticHierarchy(UIView *view) {
    // volume hud reuses cc views so leave its elastic hierarchy alone
    UIView *candidate = view;
    for (NSInteger level = 0; candidate && level < 3; level++, candidate = candidate.superview) {
        NSString *className = NSStringFromClass(candidate.class);
        if ([className hasPrefix:@"SBElastic"]) return YES;
    }
    return NO;
}

static CGFloat ERGlassPillRadius(UIView *v) {
    return fmin(CGRectGetWidth(v.bounds), CGRectGetHeight(v.bounds)) * 0.5;
}

// ---------------------------------------------------------------------------
// 0.5.13 —— 音乐模块（正在播放）的玻璃圆角
//
// 4x2 的模块容器是 304x146，长宽比 2.08，ERGlassIsModuleCandidate() 判为「非近
// 正方形」，于是圆角掉到 ERGlassRadiusForModuleMaterial() 最后一条 pill 分支：
// 短边一半 = 73pt，在 146pt 高的卡片上就是整条边都圆掉，看起来「圆角过大」。
//
// 4x4 的容器是 304x304，走 ERGlassModuleCornerRadius()——它在 h>=100 时返回
// 「小模块圆角记忆」sERSmallModuleRadius。4x2 的 h=146 同样 >=100，因此复用
// 同一套取值即可得到与 4x4 完全相同的数；记忆尚未建立时退化为按正方形边长取
// 值，两个数依旧相等。
//
// 只对音乐模块生效：其它模块（含七个连通性磁贴）的判定路径一行未动。
// ---------------------------------------------------------------------------
static BOOL ERGlassSubtreeHasClassPrefix(UIView *root, NSString *prefix, NSInteger depth) {
    if (!root || depth <= 0) return NO;
    for (UIView *v in root.subviews)
        if ([NSStringFromClass(v.class) hasPrefix:prefix]) return YES;
    if (depth <= 1) return NO;
    for (UIView *v in root.subviews)
        if (ERGlassSubtreeHasClassPrefix(v, prefix, depth - 1)) return YES;
    return NO;
}

static BOOL ERGlassModuleIsNowPlaying(UIView *module) {
    if (!module) return NO;
    // 1) 沿整条 responder 链找，任意一个控制器暴露 nowplaying 即命中。
    //    不能只查第一个控制器就 break：容器控制器往往带自己的标识，
    //    真正带 nowplaying 的控制器在更上层。
    for (UIResponder *responder = module; responder; responder = responder.nextResponder) {
        if (![responder isKindOfClass:[UIViewController class]]) continue;
        NSString *identifier = ERIdentifierFromObject((UIViewController *)responder);
        if ([identifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"]) return YES;
        if ([NSStringFromClass(responder.class) hasPrefix:@"MRUNowPlaying"]) return YES;
    }
    // 2) 兜底：子树里出现 MRUNowPlaying*（MediaControls 的正在播放视图）。
    //    MRUNowPlayingView 的层级比预想的深，深度给到 6 层。
    return ERGlassSubtreeHasClassPrefix(module, @"MRUNowPlaying", 6);
}

static CGFloat ERGlassNowPlayingCornerRadius(UIView *module) {
    CGFloat w = CGRectGetWidth(module.bounds), h = CGRectGetHeight(module.bounds);
    if (w <= 0.0 || h <= 0.0) return 0.0;
    if (sERSmallModuleRadius > 0.0) return sERSmallModuleRadius;
    return fmax(w, h) * 0.5;
}

static BOOL ERGlassIsSliderFillMaterial(UIView *mat) {
    UIView *slider = ERGlassSliderAncestor(mat);
    if (!slider) return NO;
    for (UIView *v = mat.superview; v && v != slider; v = v.superview)
        if (isExactClass(v, @"UIView") && v.layer.masksToBounds) return YES;
    return NO;
}

// 「模块内材质」的圆角规则。
//
// 抽成独立函数是为了让两条路径共用同一套算术：路由（ERGlassRadiusForMaterial →
// 系统模块 / 快捷指令）和 EchoReborn 为七个连通性磁贴手工创建的那块玻璃
// （ERSyncConnectivityTileGlass）。两条路径的圆角只要差一点点，玻璃的圆角边线就
// 会落进按钮内部，看上去就是「一条没铺满的弧线」；共用函数则从构造上保证七个按钮
// 与同尺寸的系统模块取到完全相同的值。

// 1.0.6-13（第 7 条）：4 格级大卡的半径定义在本文件更下方（壳体那一节），而下面的
// 玻璃路由要在它之前调用 —— C 不允许在定义之前使用静态函数，缺了这一行就是
// 「implicit declaration of function」，本项目 -Werror，等于构建失败。
static CGFloat EROversizedMediaCornerRadius(void);

static CGFloat ERGlassRadiusForModuleMaterial(UIView *mat) {
    if (!mat) return -1.0;
    if (ERGlassHasSBElasticHierarchy(mat)) return -1.0;
    BOOL inModule = hasAncestorOfClassName(mat, @"CCUIContentModuleContainerView");

    if (ERGlassIsInsideSlider(mat)) {
        if (!inModule && !LGMaterialHasGlass(mat, kGlassKey)) return -1.0;
        if (ERGlassIsSliderFillMaterial(mat)) return -1.0;
        UIView *slider = ERGlassSliderAncestor(mat);
        if (!slider) return -1.0;
        if (CGRectGetWidth(slider.bounds) < 30.0 ||
            CGRectGetHeight(slider.bounds) < 30.0) return -1.0;
        return ERGlassPillRadius(slider);
    }

    if (!inModule) {
        UIView *parent = mat.superview;
        BOOL expanded = (isExactClass(parent, @"CCUIContentModuleContentContainer") ||
                         isExactClass(parent, @"CCUIContentModuleContentContainerView")) &&
                        LGMaterialHasGlass(mat, kGlassKey);
        return expanded ? mat.layer.cornerRadius : -1.0;
    }

    CGFloat w = CGRectGetWidth(mat.bounds), h = CGRectGetHeight(mat.bounds);
    if (w < 30.0 || h < 30.0) return -1.0;

    UIView *module = ERGlassModuleAncestor(mat);
    // 0.5.13: 音乐模块拉宽成 4x2 后不再是「近正方形」，会掉到下面的 pill 分支拿到
    // 短边一半（73pt）。让它复用 4x4 的取值。
    //
    // 1.0.6-12（第 1 条）：这一支移到「近正方形」判定**之前**，命中条件从
    // 「横向拉宽」放宽成「4 格级大卡（4×2 / 2×4 / 4×4）」。
    //
    // 旧顺序下 4×4 先被 ERGlassIsModuleCandidate 截走，返回 ERGlassModuleCornerRadius
    // 的「小模块记忆」≈37.5，而壳体是 32；只有 4×2 走得到这里拿到壳体值 —— 两个
    // 尺寸的玻璃圆角同样对不上。现在 4 格级大卡一律以壳体圆角为唯一真值源，与
    // -moduleUsesOversizedMediaRadius:view: 的新判定同构，玻璃与壳体从构造上不可能
    // 分叉。其余模块（含 2×2 与 4×1 的音乐）保持原有规则不变。
    if (module) {
        CGSize moduleSize = module.bounds.size;
        CGFloat mn = fmin(moduleSize.width, moduleSize.height);
        CGFloat mx = fmax(moduleSize.width, moduleSize.height);
        // 1.0.6-13（第 7 条）：去掉 `&& ERGlassModuleIsNowPlaying(module)`。
        //
        // 只认「正在播放」时，天气 4×2 走到函数末尾的 pill 兜底
        // （ERGlassPillRadius = 短边一半 ≈ 146/2 = 73pt，实测材质甚至更大），
        // 而它的壳体圆角只有 32 —— 玻璃比壳体圆一倍多，看上去正是「圆角过于圆」。
        // 用户报的是「音乐模块**和天气模块** 4×2 都不对」，两个症状是同一个根因的
        // 两种取值：音乐偏大（36）、天气离谱（≈81）。
        //
        // 4 格级大卡一律以壳体圆角为唯一真值源后，两者都被钉在壳体上，不会再分叉。
        if (mn > 120.0 && mx > 200.0) {
            CGFloat npRadius = module.layer.cornerRadius;
            // 1.0.6-12（第 3 条）：玻璃半径改为**优先取模块自身的圆角**。
            //
            // 模块自身的圆角由 -applyRefinedLookToModule: 写入，且开/关液态玻璃走的是
            // 同一个分支（该模块不是连通性磁贴），所以它是这块模块唯一的「真值源」。
            // 玻璃跟它取同一个数，开启态与关闭态的圆角就**从构造上**不可能分叉。
            //
            // 以前这里取 ERGlassNowPlayingCornerRadius()（sERSmallModuleRadius 记忆，实测
            // 37.5），而模块壳体取 EROversizedMediaCornerRadius()（开启态 22）——两者差
            // 15.5pt，玻璃的圆角边线因此落进卡片内部，看上去就是「圆角不对」。
            // 1.0.6-13：壳体还没写入圆角时的兜底也分开 —— 非音乐模块不应该去借
            // 「正在播放」的小模块记忆（sERSmallModuleRadius ≈ 37.5），那正是 4×2
            // 会被抬大的另一条路。
            if (npRadius < 1.0) {
                npRadius = ERGlassModuleIsNowPlaying(module)
                    ? ERGlassNowPlayingCornerRadius(module)
                    : EROversizedMediaCornerRadius();
            }
            // 只在结论变化时记一行：核对 4×2 是否真的拿到了与 4×4 相同的值。
            static const void *kERBigCardGlassLogKey = &kERBigCardGlassLogKey;
            NSString *npState = [NSString stringWithFormat:@"%.0fx%.0f r=%.1f tile=%.1f small=%.1f pill=%.1f",
                                 moduleSize.width, moduleSize.height, npRadius,
                                 module.layer.cornerRadius, sERSmallModuleRadius, ERGlassPillRadius(mat)];
            if (![objc_getAssociatedObject(module, kERBigCardGlassLogKey) isEqual:npState]) {
                objc_setAssociatedObject(module, kERBigCardGlassLogKey, npState, OBJC_ASSOCIATION_COPY_NONATOMIC);
                ERLogInfo(@"BIGGLASS ver=1.0.9-103 module=%@ mat=%.0fx%.0f pill=%.1f", npState, w, h, ERGlassPillRadius(mat));
            }
            return npRadius;
        }
    }
    if (module && ERGlassIsModuleCandidate(module)) return ERGlassModuleCornerRadius(module);
    if (w > 100.0 && h < 100.0) return h * 0.5;
    if (h > 100.0 && w < 100.0) return w * 0.5;
    return ERGlassPillRadius(mat);
}

// 路由入口。只做两件属于「路由专属」的判断，几何部分全部交给
// ERGlassRadiusForModuleMaterial，避免两条路径算出不同的圆角。
static CGFloat ERGlassRadiusForMaterial(UIView *mat) {
    if (!isExactClass(mat, @"MTMaterialView")) return -1.0;
    // 0.5.8: EchoReborn 自己注入的磁贴兜底材质不参与路由——它的玻璃由
    // ERSyncConnectivityTileGlass 单独负责（0.5.10 起同样调用
    // LGInstallRegisteredGlassInMaterial，但圆角取磁贴自身而不是模块容器）。
    // 若路由再处理一次，同一块材质上会挂两块玻璃。
    if (mat.tag == kERConnectivityTileMaterialTag) return -1.0;
    // 1.0.6-10（第 3 条）：快捷指令磁贴的底板同样不参与路由。
    //
    // 它的玻璃由 ERSyncConnectivityTileGlass 单独负责（tag 决定圆角取「磁贴自身」还是
    // 「材质短边一半」）。若路由也处理一次，同一块材质上会挂两块玻璃、两者共用一个
    // kGlassKey，圆角与 frame 互相覆盖 —— 后跑的那一个说了算，于是「圆角」这个参数
    // 在两条路径之间来回跳。这与 0.5.8 给七个连通性磁贴加排名的理由完全一致，
    // 当时漏掉了快捷指令磁贴这一条，现在补齐。
    if (mat.tag == kERShortcutTileBackgroundTag) return -1.0;
    return ERGlassRadiusForModuleMaterial(mat);
}

// Registered from %ctor once the EchoReborn gates have passed. Enable/disable is
// owned entirely by the GlassKit prefs machinery — the 液态玻璃 page writes
// Global.Enabled (master) and ControlCenter.Enabled (per-host) into the shared
// EchoReborn prefs domain, and GlassKit's Darwin-notification reconcile strips or
// restores glass live. The matcher therefore stays a pure geometry/classifier,
// exactly like LiquidAss's.
static void ERGlassRegisterControlCenterHost(void) {
    LGRegisterMaterialHost(@"ControlCenter", 110,
        ^BOOL(UIView *material) {
            return ERGlassRadiusForMaterial(material) >= 0.0;
        }, UIEdgeInsetsZero,
        ^CGFloat(UIView *material) {
            return ERGlassRadiusForMaterial(material);
        }, nil, nil);
}



// ---------------------------------------------------------------------------
// 关闭态背景 = 系统模块同款材质（0.5.8）
//
// 0.5.7 及以前，转换磁贴的 OFF 背景是一块 EchoReborn 自造的
// UIVisualEffectView(SystemThinMaterialDark) 合成模糊。它不是系统模块（例如
// 「快捷指令」）真正使用的东西——recipe 不同、也不在同一个背景分组里，因此在
// 同一页面上并排看永远差一档。这正是「关闭状态背景不正确，我要的就是与这些模块
// 一致的效果」的成因：不是参数没调对，而是材质根本不同源。
//
// 正确做法是拿到那块材质本身，而不是模仿它：
//   1. 先在磁贴自己的容器（CCUIContentModuleContainerView）里找系统给的
//      platter（MTMaterialView，尺寸与磁贴一致）。这是首选——它就是本磁贴本该
//      显示的那块材质。
//   2. 找不到就在同一页面上借一个真实系统模块的 platter（例如「快捷指令」的
//      方块），克隆它的 recipe 与背景分组。
//   3. 两者都拿不到才退回合成模糊——行为与 0.5.7 完全相同，不会更差。
//
// 克隆体必须是磁贴的「直接子视图」：-ERSetModuleNativeContentHidden: 会隐藏原生
// 内容容器，挂在那个容器下面的材质连祖先一起被关掉，露不出来（详见
// ERConvertedTileBackgroundMaterial 的注释）；直接子视图没有祖先可被抑制。
// ---------------------------------------------------------------------------

// 该视图是否为「覆盖 host 整块」的材质面。容 4pt 误差，避免选中按钮自己的背衬。
static BOOL ERMaterialCoversHost(UIView *view, UIView *host) {
    if (!view || !host) return NO;
    CGSize size = view.bounds.size;
    CGSize target = host.bounds.size;
    if (size.width < 20.0 || size.height < 20.0) return NO;
    if (target.width < 20.0 || target.height < 20.0) return NO;
    return fabs(size.width - target.width) < 4.0 && fabs(size.height - target.height) < 4.0;
}

// 在 root 子树里找一块材质面。跳过 EchoReborn 自己的 chrome（tag >= 181000，含已注入
// 的兜底材质与玻璃层），否则会克隆到自己头上。
//
// 尺寸参照可用时以「与磁贴同尺寸」为首选；参照不可用（首次布局前 bounds 为 0）或
// 没有完全对上的，退而取第一块近方形的 MTMaterialView——模块 platter 一定是近方形的。
static UIView *ERFindPlatterMaterialIn(UIView *root, UIView *sizeRef) {
    if (!root || !sizeRef) return nil;
    CGSize target = sizeRef.bounds.size;
    BOOL measured = (target.width >= 20.0 && target.height >= 20.0);
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    UIView *loose = nil;
    while (queue.count) {
        UIView *node = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if (node.tag >= 181000) continue;
        if ([NSStringFromClass(node.class) isEqualToString:@"MTMaterialView"]) {
            if (measured && ERMaterialCoversHost(node, sizeRef)) return node;
            CGSize size = node.bounds.size;
            if (!loose && size.width >= 20.0 && size.height >= 20.0 &&
                fmax(size.width, size.height) <= fmin(size.width, size.height) * 1.3) loose = node;
        }
        [queue addObjectsFromArray:node.subviews];
    }
    return loose;
}

// 先找本磁贴容器的系统 platter，找不到再借同页面任一真实系统模块的。
static UIView *ERSystemPlatterMaterialForTile(UIView *moduleView) {
    if (!moduleView) return nil;
    UIView *ownContainer = moduleView;
    while (ownContainer && ![NSStringFromClass(ownContainer.class) isEqualToString:@"CCUIContentModuleContainerView"])
        ownContainer = ownContainer.superview;
    UIView *own = ERFindPlatterMaterialIn(ownContainer ?: (moduleView.superview ?: moduleView), moduleView);
    if (own) return own;
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
            UIView *view = candidate.view;
            if (!view || view == moduleView) continue;
            if ([moduleView isDescendantOfView:view] || [view isDescendantOfView:moduleView]) continue;
            NSString *identifier = ERModuleIdentifier(candidate);
            if ([identifier.lowercaseString containsString:@"echoreborn.connectivity"]) continue;
            UIView *container = view;
            while (container && ![NSStringFromClass(container.class) isEqualToString:@"CCUIContentModuleContainerView"])
                container = container.superview;
            UIView *material = ERFindPlatterMaterialIn(container ?: view, view);
            if (material) return material;
        }
    }
    return nil;
}

// 材质分组名。公开面是 backdropGroupName，私有面是 groupName；克隆体必须落在同一
// 分组里，才会和周围磁贴的表现一致。
static NSString *ERMaterialGroupName(UIView *material) {
    if (!material) return nil;
    @try {
        for (NSString *key in @[@"backdropGroupName", @"groupName"]) {
            id value = [material valueForKey:key];
            if ([value isKindOfClass:[NSString class]] && [value length]) return value;
        }
    } @catch (__unused NSException *exception) {}
    @try {
        id value = [material.layer valueForKey:@"groupName"];
        if ([value isKindOfClass:[NSString class]] && [value length]) return value;
    } @catch (__unused NSException *exception) {}
    return nil;
}

// 克隆一块与参考材质同 recipe、同分组的 MTMaterialView。失败返回 nil，由调用方
// 退回合成模糊。先试 NSCopying（最完整），否则走 MaterialKit 工厂。
//
// 参数刻意不叫 `template`：本文件按 Objective-C++ 编译，`template` 是 C++ 关键字，
// 直接用它当参数名会报 "invalid parameter name: 'template' is a keyword"。
static UIView *ERClonePlatterMaterial(UIView *sourceMaterial) {
    if (!sourceMaterial) return nil;
    UIView *material = nil;
    if ([sourceMaterial conformsToProtocol:@protocol(NSCopying)]) {
        @try { material = [sourceMaterial copy]; } @catch (__unused NSException *exception) { material = nil; }
    }
    Class materialClass = NSClassFromString(@"MTMaterialView");
    if (!material && materialClass) {
        long long recipe = 0;
        if ([sourceMaterial respondsToSelector:NSSelectorFromString(@"recipe")]) {
            @try {
                recipe = ((long long (*)(id, SEL))objc_msgSend)(sourceMaterial, NSSelectorFromString(@"recipe"));
            } @catch (__unused NSException *exception) { recipe = 0; }
        }
        NSArray<NSString *> *factories = @[@"materialViewWithRecipe:",
                                          @"materialViewWithRecipe:options:",
                                          @"materialViewWithRecipe:options:initialWeighting:"];
        for (NSString *name in factories) {
            SEL factory = NSSelectorFromString(name);
            if (![materialClass respondsToSelector:factory]) continue;
            @try {
                if ([name isEqualToString:@"materialViewWithRecipe:"]) {
                    material = ((id (*)(id, SEL, long long))objc_msgSend)(materialClass, factory, recipe);
                } else if ([name isEqualToString:@"materialViewWithRecipe:options:"]) {
                    material = ((id (*)(id, SEL, long long, NSUInteger))objc_msgSend)(materialClass, factory, recipe, (NSUInteger)0);
                } else {
                    material = ((id (*)(id, SEL, long long, NSUInteger, CGFloat))objc_msgSend)(materialClass, factory, recipe, (NSUInteger)0, (CGFloat)1.0);
                }
            } @catch (__unused NSException *exception) { material = nil; }
            if (material) break;
        }
    }
    if (!material) return nil;
    NSString *group = ERMaterialGroupName(sourceMaterial);
    if (group.length) {
        for (NSString *name in @[@"setBackdropGroupName:", @"setGroupName:"]) {
            SEL setter = NSSelectorFromString(name);
            if (![material respondsToSelector:setter]) continue;
            @try {
                ((void (*)(id, SEL, id))objc_msgSend)(material, setter, group);
            } @catch (__unused NSException *exception) {}
            break;
        }
    }
    return material;
}

// ---------------------------------------------------------------------------
// 磁贴的液态玻璃层
// ---------------------------------------------------------------------------
//
// 转换过的磁贴把原生内容整体隐藏了，路由看不到可上玻璃的材质面，所以玻璃由
// EchoReborn 显式创建。但「显式」不等于「可以自定参数」——0.5.8 及以前这里有三处
// 与路由不一致，正是用户看到的两类异常的成因：
//
//   1. groupName 传了固定字符串 "echoreborn.cc.module"。
//      LGLiveBackdropView 的规则是：groupName 为空时给每块玻璃生成独立的
//      backdrop 分组名，非空时直接采用。路由（系统模块 / 「快捷指令」）传的是
//      nil，即每块玻璃一个独立分组；而这里让七块玻璃共用同一个分组名，渲染
//      服务器把它们当成一块联合区域处理，于是出现「没铺满」的观感与各种边线残影。
//      → 现在传 nil，与路由一致。
//   2. 圆角取自 host.layer.cornerRadius / moduleView.layer.cornerRadius。
//      路由取的是 ERGlassRadiusForModuleMaterial()（同尺寸系统模块的规则）。
//      两者算出来的圆角只要不同，玻璃的圆角边线就会落在按钮内部，表现为一条
//      弧线。→ 现在两条路径共用同一个函数。
//   3. 没有 masksToBounds / cornerCurve。路由装玻璃时会设
//      masksToBounds = YES 与 kCACornerCurveContinuous，模糊才按圆角裁剪。
//      → 现在补齐。
//
// 另外，玻璃的创建以前被放在「材质首次创建」的分支里：如果磁贴在液态玻璃关闭时
// 就已经建好，之后把开关打开，玻璃永远不会补上（要等重建磁贴）。现在这个函数
// 每次 ERSyncConnectivityTileChrome 都会跑，开关是实时生效的。
//
// 0.5.10 重写：不再自造玻璃，改走系统模块那条路。
//
// 0.5.9 是自己 LGCreateRegisteredGlass 一块玻璃、插到磁贴包装视图的最底层
// （insertSubview:atIndex:0），再把克隆来的系统材质隐藏掉。用户反馈的「开启液态
// 玻璃后七个模块透明、缺少背景」就是这么来的，两处都是「与系统模块不同路径」：
//
//   1. 滤镜挂载没有重试。LGLiveBackdropView 只有在 CAFilter 已注册时才能把
//      backdrop 滤镜挂上去；挂不上时 -applyFilters 直接返回，玻璃就是一块全透明
//      的空层。GlassKit 给系统模块注入玻璃（LGInjectGlassIntoMaterialGroupType）
//      时会在 1.5 / 3 / 5 / 8 / 12 秒各重试一次 applyFilters；EchoReborn 自造的那条
//      路径没有重试，首次挂载失败就永远是空的——而它下面的材质已经被隐藏了。
//   2. 层序不同。系统模块的玻璃插在材质「之上」（insertSubview:aboveSubview:），
//      EchoReborn 的插在包装视图「最底」（atIndex:0），取样区域并不一致。
//
// 现在直接调用 GlassKit 给系统模块用的同一个注入函数，分组名（nil）、滤镜类型、
// 层序、重试策略与系统模块 / 「快捷指令」逐项相同，七个模块必然同源。
//
// EchoReborn 只需补一件事：给注入出来的玻璃打上 tag。
// -ERSetModuleNativeContentHidden: 会隐藏磁贴下所有非 EchoReborn 自有的子视图
// （两级），不带 tag（< 181000）的玻璃会被这次隐藏一起关掉。
// 1.0.6-9（第 2 条）：玻璃自愈用的三个记号。
//   · kERGlassInstalledAtKey —— 这块玻璃第一次被看到的时间，用来算重试间隔；
//   · kERGlassHealTriesKey   —— 已补挂滤镜的次数（有界，最多 5 次）；
//   · kERGlassGiveUpKey      —— 判定「这块玻璃不可能渲染」，此后不再安装，让原生材质独占背景。
static const void *kERGlassInstalledAtKey = &kERGlassInstalledAtKey;
static const void *kERGlassHealTriesKey = &kERGlassHealTriesKey;
static const void *kERGlassGiveUpKey = &kERGlassGiveUpKey;

// 1.0.6-9（第 2 条）：玻璃在场 ≠ 玻璃在渲染。
//
// LGLiveBackdropView 只有在 CAFilter 已注册时才能把 backdrop 滤镜挂上去；挂不上时
// -applyFilters 直接返回，这块玻璃就是**一层全透明的空层**。而系统模块的既定行为是
// 「装上玻璃即隐藏原生材质」（GlassKit 还 hook 了 -[MTMaterialView setHidden:]，只要
// 材质上挂着玻璃就把 hidden 强制改回 YES）。两件事叠在一起的结果就是磁贴彻底透明 ——
// 正是用户报的「七个模块都透明了，明显不一样」。
//
// GlassKit 自己的重试只在注入后的 1.5/3/5/8/12 秒那五次，超过之后无人再管。这里补一条
// **有界**的自愈，不做无期限重试（0.5.11 曾经每次刷新都补 applyFilters，等于把一个渲染
// 服务往返压进每个布局周期，那是主线程被拖住的来源之一）：
//   ① 从玻璃被看到起，第 0.35/0.70/1.05/1.40/1.75 秒各补挂一次，共 5 次；
//   ② 五次用尽、且已经过了 2.5 秒仍不渲染，判定这块玻璃不可能渲染：摘掉它，并给材质
//      打上放弃标记，让原生材质回来。——「有系统同款背景」永远优于「透明」。
static void ERHealConnectivityTileGlass(UIView *material, LGLiveBackdropView *glass, UIView *moduleView) {
    if (!material) return;
    if (!glass) return;
    if (glass.lgFilterAttached) {
        // 已经渲染出来了：清掉两个记号，之后本函数对这块玻璃不再有任何副作用。
        objc_setAssociatedObject(material, kERGlassInstalledAtKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(material, kERGlassHealTriesKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }
    CFTimeInterval now = CACurrentMediaTime();
    NSNumber *installedAt = objc_getAssociatedObject(material, kERGlassInstalledAtKey);
    if (!installedAt) {
        installedAt = @(now);
        objc_setAssociatedObject(material, kERGlassInstalledAtKey, installedAt, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    NSUInteger tried = [objc_getAssociatedObject(material, kERGlassHealTriesKey) unsignedIntegerValue];
    CFTimeInterval since = now - installedAt.doubleValue;
    NSString *identifier = ERModuleIdentifier(ERModuleControllerForView(moduleView)) ?: @"(nil)";
    if (tried < 5) {
        if (since < 0.35 * (double)(tried + 1)) return;
        objc_setAssociatedObject(material, kERGlassHealTriesKey, @(tried + 1), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [glass applyFilters];
        ERLogInfo(@"GLASSHEAL ver=1.0.9-103 id=%@ mode=refilter try=%lu attached=%d",
                  identifier, (unsigned long)(tried + 1), glass.lgFilterAttached ? 1 : 0);
        return;
    }
    if (since <= 2.5) return;
    objc_setAssociatedObject(material, kERGlassGiveUpKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    LGRemoveGlassFromMaterial(material, kGlassKey);
    ERLogInfo(@"GLASSHEAL ver=1.0.9-103 id=%@ mode=remove-glass tries=%lu（玻璃不渲染，交还原生材质）",
              identifier, (unsigned long)tried);
}

static void ERSyncConnectivityTileGlass(UIView *moduleView, UIView *material, BOOL radiusFromTile) {
    if (!moduleView || !material) return;
    // 0.5.9 及以前把玻璃挂在磁贴的包装视图上。现在玻璃归材质所有，包装视图上若还
    // 留着旧玻璃必须先摘掉，否则同一块磁贴会多出一层空玻璃。
    //
    // 0.5.11: 只翻 moduleView 与它的包装视图这两层的**直接子视图**。
    // 0.5.10 是沿整条祖先链做 viewWithTag: —— 那是「每层一次全子树深搜」，复杂度
    // O(子树 × 祖先)，而本函数在每次磁贴刷新时都会跑，足以拖垮主线程。旧玻璃本来
    // 就只可能挂在这两层的直接子视图上。
    id owned = objc_getAssociatedObject(material, kGlassKey);
    UIView *hosts[2] = { moduleView, moduleView.superview };
    for (NSUInteger hostIndex = 0; hostIndex < 2; hostIndex++) {
        UIView *host = hosts[hostIndex];
        if (!host) continue;
        for (UIView *legacy in host.subviews) {
            if (legacy.tag != kERConnectivityTileGlassTag) continue;
            if (![legacy isKindOfClass:[LGLiveBackdropView class]]) continue;
            if (owned && legacy == owned) continue;
            [legacy removeFromSuperview];
        }
    }
    if (!lgHostEnabled(@"ControlCenter")) {
        // 关闭液态玻璃：摘掉玻璃并让克隆来的系统材质重新露出来，与系统模块一致。
        LGRemoveGlassFromMaterial(material, kGlassKey);
        return;
    }
    if ([objc_getAssociatedObject(material, kERGlassGiveUpKey) boolValue]) {
        // 1.0.6-9（第 2 条）：这块材质上的玻璃已被判定为「不渲染」，不再重新安装 ——
        // 否则每次布局都会再装一块空玻璃，把原生材质再隐藏一次，磁贴永远是透明的。
        LGRemoveGlassFromMaterial(material, kGlassKey);
        return;
    }
    // 圆角来源分两种，用 radiusFromTile 区分 —— 这是 1.0.6-7 第 2 / 5 条的修正点。
    //
    //  A. radiusFromTile = NO（七个连通性磁贴）：保持 0.5.9 起的取值「材质短边一半」。
    //     它们的尺寸由系统决定、用户不可能把它拖大，实机核对过玻璃 r=37.5 一直是对的，
    //     所以这一路一行不改，杜绝回归。
    //
    //  B. radiusFromTile = YES（快捷指令磁贴）：**不能**用短边一半。
    //     「短边一半」只在 1x1 附近才与正确值巧合一致（75pt → 37.5，与系统 1x1 模块
    //     逐项相同）；一旦用户把它拖大（2x2 = 163×163），短边一半就是 81.5pt，而 163pt
    //     的方形拿到 81.5pt 圆角就是**一个正圆** —— 这正是用户报的「拖成 4×4 尺寸后
    //     开启液态玻璃，图标已变成正圆」。所以这一路改取**磁贴自身的圆角**：1x1 仍是
    //     37.5（与现在逐点相同，不改变 1x1 的观感），2x2 变成 32，与系统同类大模块一致。
    //
    // 兜底顺序：磁贴自身圆角 → 材质短边一半；两个都拿不到才放弃装玻璃。
    CGFloat radius = 0.0;
    if (radiusFromTile) radius = moduleView.layer.cornerRadius;
    if (radius < 1.0) radius = ERGlassPillRadius(material);
    if (radius < 1.0) radius = moduleView.layer.cornerRadius;
    if (radius < 1.0) return;
    LGLiveBackdropView *glass = LGInstallRegisteredGlassInMaterial(material, kGlassKey,
                                                                   @"ControlCenter",
                                                                   UIEdgeInsetsZero,
                                                                   radius, nil);
    if (!glass) return;
    if (glass.tag != kERConnectivityTileGlassTag) {
        glass.tag = kERConnectivityTileGlassTag;
        ERLogInfo(@"OFFGLASS ver=1.0.9-103 id=%@ mode=install r=%.1f",
                   ERModuleIdentifier(ERModuleControllerForView(moduleView)) ?: @"(nil)", radius);
    }
    glass.userInteractionEnabled = NO;
    glass.alpha = 1.0;
    glass.layer.cornerCurve = kCACornerCurveContinuous;
    glass.layer.masksToBounds = YES;
    if (fabs(glass.layer.cornerRadius - radius) > 0.5) glass.layer.cornerRadius = radius;
    glass.lgShapeCornerRadius = radius;
    // 0.5.11: 这里曾经每次刷新都补一次 applyFilters。磁贴刷新在布局路径上频率很高，
    // 而 applyFilters 要改 layer.filters、重配原生模糊覆盖层，等于把一个渲染服务
    // 往返压进每个布局周期。重试交给 GlassKit 注入时自带的 1.5/3/5/8/12 秒那五次，
    // 不再由刷新路径承担。
    //
    // 1.0.6-9（第 2 条）：但「交给 GlassKit 重试」有一个死角 —— 五次都用尽之后仍没挂上
    // 滤镜的话，没人再管，而原生材质已经因为玻璃在场被隐藏了，磁贴就是一块**透明的洞**。
    // 这里接一条有界自愈（最多 5 次补挂，之后摘掉玻璃让材质回来），代价是每块磁贴最多
    // 5 次 applyFilters，而不是每次刷新一次。详见 ERHealConnectivityTileGlass。
    ERHealConnectivityTileGlass(material, glass, moduleView);
}

// 磁贴的玻璃。系统模块的玻璃挂在材质上（associated object），EchoReborn 早期版本挂在
// 包装视图上（tag）；两条路都认，便于升级后自愈。
static LGLiveBackdropView *ERTileGlassForMaterial(UIView *material) {
    if (!material) return nil;
    id associated = objc_getAssociatedObject(material, kGlassKey);
    if ([associated isKindOfClass:[LGLiveBackdropView class]]) return (LGLiveBackdropView *)associated;
    for (UIView *a = material.superview; a; a = a.superview) {
        UIView *tagged = [a viewWithTag:kERConnectivityTileGlassTag];
        if ([tagged isKindOfClass:[LGLiveBackdropView class]]) return (LGLiveBackdropView *)tagged;
    }
    return nil;
}

// 磁贴的玻璃是否已经挂上。材质层与玻璃层是两层背景，同时可见时因圆角/分组不同会
// 叠出「没铺满」的弧线；系统模块的做法是装上玻璃后把原生材质隐藏，这里照做。
static BOOL ERTileGlassPresent(UIView *material) {
    return ERTileGlassForMaterial(material) != nil;
}


// 1.0.6-5：`tag` 决定这块材质归谁 —— 连通性磁贴用 kERConnectivityTileMaterialTag，
// 快捷指令磁贴用 kERShortcutTileBackgroundTag。两条路径共用同一套实现
// （克隆系统 platter → 装 GlassKit 玻璃 → 拿不到才退回合成模糊），因此它们的背景
// 必然同源，这正是用户要的「参照 7 个独立模块的背景样式」。
static UIView *EREnsureTileMaterial(UIView *moduleView, NSInteger tag) {
    if (!moduleView) return nil;
    UIView *platter = [moduleView viewWithTag:tag];
    if (!platter) {
        // 0.5.8: OFF 背景首选「系统模块同款材质」。0.5.7 用的是 EchoReborn 自造的
        // UIVisualEffectView(SystemThinMaterialDark) 合成模糊，与系统模块（及
        // 「快捷指令」）真实使用的 MTMaterialView 并非同源，并排看必然差一档。
        // 这里先克隆系统 platter；真的拿不到才退回合成模糊，保证不会比 0.5.7
        // 更差——未装 liquidass 时它同样是一块深色毛玻璃。
        UIView *material = nil;
        NSString *source = @"blur";
        // 局部变量同样不能叫 template（Objective-C++ 关键字）。
        UIView *reference = ERSystemPlatterMaterialForTile(moduleView);
        if (reference) {
            material = ERClonePlatterMaterial(reference);
            if (material) source = @"system";
        }
        if (!material) {
            UIVisualEffectView *blur = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThinMaterialDark]];
            blur.contentView.backgroundColor = [UIColor.whiteColor colorWithAlphaComponent:0.055];
            material = blur;
        }
        material.tag = tag;
        material.userInteractionEnabled = NO;
        material.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        material.layer.cornerCurve = kCACornerCurveContinuous;
        material.clipsToBounds = YES;
        material.hidden = NO;
        material.alpha = 1.0;
        material.backgroundColor = UIColor.clearColor;
        [moduleView insertSubview:material atIndex:0];
        platter = material;
        // 留一条可验证的记录：src=system 表示用的是系统同款材质，src=blur 表示退回了
        // 合成模糊。两种来源并存时看这一行就能判断命中的是哪条分支。
        ERLogInfo(@"OFFBGSRC ver=1.0.9-103 id=%@ src=%@",
                   ERModuleIdentifier(ERModuleControllerForView(moduleView)) ?: @"(nil)", source);
    }
    platter.frame = moduleView.bounds;
    platter.layer.cornerRadius = moduleView.layer.cornerRadius;
    // 玻璃层：与路由给系统模块 / 「快捷指令」的处理保持同一套参数（圆角、分组、
    // 裁剪）。这一步每次调用都跑，因此实时开关液态玻璃也会立刻生效，而不是要等到
    // 下一次重建磁贴。详见 ERSyncConnectivityTileGlass 的注释。
    // 1.0.6-7（第 2 / 5 条）：`tag` 决定圆角来源。快捷指令磁贴
    // （kERShortcutTileBackgroundTag）取磁贴自身圆角，七个连通性磁贴
    // （kERConnectivityTileMaterialTag）保持原有取法。详见本函数里半径那一段。
    ERSyncConnectivityTileGlass(moduleView, platter, tag == kERShortcutTileBackgroundTag);
    return platter;
}

static UIView *EREnsureConnectivityTileMaterial(UIView *moduleView) {
    return EREnsureTileMaterial(moduleView, kERConnectivityTileMaterialTag);
}


// 把「创建时没借到系统材质、退回成合成模糊」的兜底就地升级成系统同款材质。
//
// 磁贴第一次创建可能发生在页面里其它模块完成布局之前，那一刻借不到系统 platter，
// 只能退回模糊（OFFBGSRC src=blur）。本函数给这条路径一次自愈机会：只要当前兜底
// 仍是模糊，就再找一次系统材质，找到就原地同位替换——保持 tag / frame / 圆角 /
// 层序不变，让「关闭态背景 = 系统同款材质」这个不变量最终收敛，而不是永久停在模糊上。
static UIView *ERUpgradeTileMaterialIfNeeded(UIView *moduleView, UIView *current, NSInteger tag) {
    if (!moduleView || !current) return current;
    if ([NSStringFromClass(current.class) isEqualToString:@"MTMaterialView"]) return current;
    UIView *reference = ERSystemPlatterMaterialForTile(moduleView);
    if (!reference) return current;
    UIView *material = ERClonePlatterMaterial(reference);
    if (!material) return current;
    material.tag = tag;
    material.userInteractionEnabled = NO;
    material.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    material.layer.cornerCurve = kCACornerCurveContinuous;
    material.clipsToBounds = YES;
    material.hidden = NO;
    material.alpha = 1.0;
    material.backgroundColor = UIColor.clearColor;
    material.frame = current.frame;
    material.layer.cornerRadius = current.layer.cornerRadius;
    NSUInteger index = [moduleView.subviews indexOfObject:current];
    [current removeFromSuperview];
    if (index == NSNotFound || index > moduleView.subviews.count) index = 0;
    [moduleView insertSubview:material atIndex:index];
    ERLogInfo(@"OFFBGUPGRADE ver=1.0.9-103 id=%@",
               ERModuleIdentifier(ERModuleControllerForView(moduleView)) ?: @"(nil)");
    return material;
}

static UIView *ERUpgradeConnectivityTileMaterialIfNeeded(UIView *moduleView, UIView *current) {
    return ERUpgradeTileMaterialIfNeeded(moduleView, current, kERConnectivityTileMaterialTag);
}

// The view that supplies a converted tile's OFF background.
//
// Preferences, in order:
//
//   1. The module's own material — but ONLY when it is a *direct child* of the
//      tile view. This is the whole lesson of v0.3.12: it restored that material
//      and the background still vanished, because the material is normally
//      nested one level down inside the container that the native-content hide
//      pass switches off. Un-hiding a view whose ancestor is `hidden` shows
//      nothing, so the tile came out empty. A material that is a direct child
//      has nothing above it to suppress it, so un-hiding it does work.
//   2. Otherwise EchoReborn's own SystemUltraThinMaterialDark platter, which is a
//      direct child EchoReborn owns and therefore can never be suppressed.
//
// Either way the OFF background is a real material and never a painted colour.
static UIView *ERConvertedTileBackgroundMaterial(UIView *moduleView) {
    if (!moduleView) return nil;
    UIView *native = ERFirstModuleMaterialSurface(moduleView);
    if (native && native.superview == moduleView) return native;
    return EREnsureConnectivityTileMaterial(moduleView);
}

// Modules that use the shared EchoReborn tile style (white when ON, the timer grey
// when OFF) instead of the brand-filled platter.
//
// v0.3.9 wired Wi-Fi and Bluetooth, v0.3.10 added AirDrop and VPN, v0.3.11 adds
// 飞行模式 / 蜂窝数据 / 个人热点 — so all seven are converted and the
// brand-platter branch below is now only a safety net.
//
// Membership drives THREE things at once:
//   1. the platter colour (white ON / grey OFF),
//   2. the glyph + label colours (coloured glyph ON, white OFF),
//   3. the single-instance rule, so a placed tile leaves 添加控制项.
// Keeping them on one list is what makes "convert a module" a one-line change.
static BOOL ERConnectivityIdentifierUsesWhiteHighlight(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    if (![lower containsString:@"echoreborn.connectivity"]) return NO;
    return [lower containsString:@".wifi"] || [lower containsString:@".bluetooth"] ||
           [lower containsString:@".airdrop"] || [lower containsString:@".vpn"] ||
           [lower containsString:@".airplane"] || [lower containsString:@".cellular"] ||
           [lower containsString:@".hotspot"];
}

// The footprint a converted connectivity tile currently occupies, including
// any drag-resize the user has applied. Falls back to the family default so
// the sheet can render an accurate preview before the tile is on screen.
static CCUILayoutSize ERConnectivityLayoutSizeForIdentifier(NSString *identifier) {
    NSArray<NSNumber *> *custom = gERCustomSizes[identifier];
    if (custom.count >= 2) {
        return (CCUILayoutSize){custom[0].unsignedIntegerValue, custom[1].unsignedIntegerValue};
    }
    NSValue *base = gERBaseLayoutSizes[identifier];
    if (base) {
        CCUILayoutSize size = {};
        [base getValue:&size];
        if (size.width && size.height) return size;
    }
    return (CCUILayoutSize){1, 1};
}

// The system blue iOS 18 uses for the converted glyphs. Matches the Control
// Center accent closely enough that every converted module reads as the same
// colour — Bluetooth's CAPackage in particular is forced to exactly this value
// so it cannot drift lighter than the Wi-Fi symbol next to it.
static UIColor *ERConnectivityWhiteHighlightGlyphColor(void) {
    return [UIColor colorWithRed:0.039 green:0.518 blue:1.0 alpha:1.0];
}

// The platter colour for a converted module, by state.
//
// EchoReborn's tile convention, taken from the rest of the tweak (the 计时器 tile
// and every gallery card): an ON tile is a solid white surface, and an OFF tile
// is the shared translucent grey. Both values are reproduced here exactly so a
// converted connectivity tile is indistinguishable from any other EchoReborn tile.
//
//   * ON  = solid white. The module's blur is faded out while ON so the white
//           is not tinted by the material sitting on top of it.
//   * OFF = the same `colorWithWhite:1.0 alpha:0.12` underlay the 计时器 uses,
//           with the native blur left visible on top — that combination is what
//           reads as "grey" on a dark wallpaper.
static UIColor *ERConnectivityHighlightPlatterColor(void) {
    return [UIColor colorWithWhite:1.0 alpha:1.0];
}

static UIColor *ERConnectivityRestingPlatterColor(void) {
    // Matches the container underlay in -previewViewForCatalogEntry and the
    // value the timer chrome pass writes onto the timer's material.
    return [UIColor colorWithWhite:1.0 alpha:0.12];
}

// Text colour to draw on top of the tile background for this module.
//
// OFF is always white, on both styles: the user explicitly chose「保持白色」for
// the grey platter rather than switching to dark text.
static UIColor *ERConnectivityPrimaryTextColor(NSString *identifier, BOOL selected) {
    if (selected && ERConnectivityIdentifierUsesWhiteHighlight(identifier)) {
        return [UIColor colorWithWhite:0.07 alpha:1.0];
    }
    return UIColor.whiteColor;
}

static UIColor *ERConnectivitySecondaryTextColor(NSString *identifier, BOOL selected) {
    if (selected && ERConnectivityIdentifierUsesWhiteHighlight(identifier)) {
        return [UIColor colorWithWhite:0.30 alpha:1.0];
    }
    return [UIColor.whiteColor colorWithAlphaComponent:selected ? 0.82 : 0.62];
}

static UIColor *ERConnectivityAccentColorForIdentifier(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    // Per-module tint, checked BEFORE the highlight test.
    //
    // "Converted" is now a set of seven, but only the PLATTER became common
    // (white when on, grey when off) — the artwork did not. Testing the
    // highlight set first would repaint 飞行模式 and 蜂窝数据 blue.
    //   飞行模式 黄 #FFCC00 · 蜂窝数据 绿 #34C759 · 个人热点 绿 #34C759
    //   and the remaining four system blue #0A84FF.
    if ([lower containsString:@".airplane"]) return [UIColor colorWithRed:1.0 green:0.80 blue:0.0 alpha:1.0];
    if ([lower containsString:@".cellular"]) return [UIColor colorWithRed:0.20 green:0.78 blue:0.35 alpha:1.0];
    if ([lower containsString:@".hotspot"]) return [UIColor colorWithRed:0.20 green:0.78 blue:0.35 alpha:1.0];
    if (ERConnectivityIdentifierUsesWhiteHighlight(identifier)) return ERConnectivityWhiteHighlightGlyphColor();
    return [UIColor colorWithRed:0.0 green:0.48 blue:1.0 alpha:1.0];
}

// A long press on a connectivity tile must do *something* on every one of the
// seven modules. Previously only Wi-Fi / Bluetooth / AirDrop qualified, so a
// press on 飞行模式 / 蜂窝数据 / 个人热点 / VPN fell through to a bare haptic and
// read as "长按没有任何效果".
//
// Two kinds of response:
//   * The three toggles Apple ships an expanded child controller for get that
//     controller (network list, device list, AirDrop sharing modes).
//   * The other four have no such controller, so EchoReborn draws its own compact
//     panel — that still gives the press a visible, useful result instead of
//     nothing, which is what the report was about.
static BOOL ERConnectivityIdentifierHasNativeExpandedMenu(NSString *identifier) {
    return ERConnectivityDetailChildClassForIdentifier(identifier).length > 0;
}

// A long press on ANY of the seven connectivity modules is handled here, so
// this predicate only has to answer "is this one of ours?" — it must never
// narrow further. The first cut of this returned YES only for Wi-Fi /
// Bluetooth / AirDrop, which is why 飞行模式 / 蜂窝数据 / 个人热点 / VPN fell
// through to a bare ERHaptic() and read as "长按没有任何效果".
//
// The old name (…HasExpandedMenu) was also actively misleading: it suggested a
// capability test when the real capability test is the sibling
// ERConnectivityIdentifierHasNativeExpandedMenu above. Renamed so the two can
// no longer be confused at a call site.
static BOOL ERConnectivityIdentifierIsOwned(NSString *identifier) {
    return [identifier.lowercaseString containsString:@"echoreborn.connectivity"];
}

// Forces a CAPackage's painted layers to one flat colour.
//
// The Bluetooth CAPackage is a CAStateLayer tree whose glyph is drawn by a mix
// of fill and stroke layers, some of which carry their own colour and some of
// which inherit `tintColor`. v0.3.9 only recoloured layers that already had a
// non-transparent fill/stroke, so the layers the package left to `tintColor`
// kept rendering near-white and the whole glyph read as "蓝色饱和度不足、偏白"
// next to the Wi-Fi SF Symbol.
//
// This version is authoritative: every layer that can paint is set to `color`,
// whether or not it had a colour of its own, and the alpha is forced to 1 so a
// package-defined 0.4 outline cannot wash the glyph out.
static void ERRecolorBluetoothPackageLayer(CALayer *layer, CGColorRef color) {
    if (!layer || !color) return;
    BOOL painted = NO;
    if ([layer respondsToSelector:@selector(setFillColor:)] && [layer respondsToSelector:@selector(fillColor)]) {
        CGColorRef fill = ((CGColorRef (*)(id, SEL))objc_msgSend)((id)layer, @selector(fillColor));
        // A layer with no fill at all reports NULL, and setting one would turn
        // an intentionally unfilled shape into a solid block — that would fill
        // in the inside of the Bluetooth rune. Only layers the package actually
        // paints are touched.
        if (fill) {
            ((void (*)(id, SEL, CGColorRef))objc_msgSend)((id)layer, @selector(setFillColor:), color);
            painted = YES;
        }
    }
    if ([layer respondsToSelector:@selector(setStrokeColor:)] && [layer respondsToSelector:@selector(strokeColor)]) {
        CGColorRef stroke = ((CGColorRef (*)(id, SEL))objc_msgSend)((id)layer, @selector(strokeColor));
        if (stroke) {
            ((void (*)(id, SEL, CGColorRef))objc_msgSend)((id)layer, @selector(setStrokeColor:), color);
            painted = YES;
        }
    }
    // A CAStateLayer may also paint through a gradient or a plain background.
    if ([layer respondsToSelector:@selector(setBackgroundColor:)] && [layer respondsToSelector:@selector(backgroundColor)]) {
        CGColorRef background = ((CGColorRef (*)(id, SEL))objc_msgSend)((id)layer, @selector(backgroundColor));
        if (background) {
            ((void (*)(id, SEL, CGColorRef))objc_msgSend)((id)layer, @selector(setBackgroundColor:), color);
            painted = YES;
        }
    }
    if (painted) layer.opacity = 1.0f;
    for (CALayer *child in layer.sublayers) ERRecolorBluetoothPackageLayer(child, color);
}

static void ERRecolorBluetoothPackageView(UIView *packageView, UIColor *color) {
    if (!packageView || !color) return;
    ERRecolorBluetoothPackageLayer(packageView.layer, color.CGColor);
    for (UIView *subview in packageView.subviews) ERRecolorBluetoothPackageView(subview, color);
}

// The CAPackage builds its CAStateLayer tree asynchronously after
// setStateName: (and again on every state change), so a single recolour pass
// runs against an empty or half-built tree. This schedules several passes over
// the first second so whichever pass lands after the tree is final wins.
static void ERScheduleBluetoothPackageRecolor(UIView *presentation, UIColor *color, BOOL animated) {
    if (!presentation || !color) return;
    NSArray<NSNumber *> *delays = animated ? @[@0.0, @0.08, @0.20, @0.42, @0.80]
                                           : @[@0.0, @0.06, @0.18, @0.40];
    for (NSNumber *delay in delays) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *packageGlyph = [presentation viewWithTag:kERConnectivityBluetoothPackageGlyphTag];
            if (packageGlyph) ERRecolorBluetoothPackageView(packageGlyph, color);
        });
    }
}

static UIView *EREnsureConnectivityBluetoothPackageGlyph(UIView *presentation, BOOL selected) {
    if (!presentation) return nil;
    UIView *packageView = [presentation viewWithTag:kERConnectivityBluetoothPackageGlyphTag];
    Class packageViewClass = NSClassFromString(@"CCUICAPackageView");
    Class descriptionClass = NSClassFromString(@"CCUICAPackageDescription");
    NSBundle *bundle = [NSBundle bundleWithPath:@"/System/Library/ControlCenter/Bundles/ConnectivityModule.bundle"];
    if (!packageViewClass || !descriptionClass || !bundle) return nil;
    // Size the Bluetooth CAPackage to match the SF Symbol footprint the other
    // six connectivity tiles use, so the seven glyphs read at one uniform size.
    // A 1x1 tile fills the whole cell; any larger footprint uses a single
    // cell-sized square (top-left on 2x2, aligned by ERAlignConnectivityPackageGlyphForLayout).
    UIView *btHost = presentation.superview;
    CGFloat btW = btHost ? CGRectGetWidth(btHost.bounds) : kERGridCellSize;
    CGFloat btH = btHost ? CGRectGetHeight(btHost.bounds) : kERGridCellSize;
    BOOL btSingleCell = (fabs(btW - kERGridCellSize) < (kERGridGap * 0.5) &&
                         fabs(btH - kERGridCellSize) < (kERGridGap * 0.5));
    // 0.5.10: 蓝牙的 CAPackage 以前按整个 cell（67pt）渲染，比其余六个归一到
    // kERConnectivityGlyphBox 的图标大出一截——这是「有的偏大」的主要来源。
    // 现在它也用同一个方框，并把方框摆到 SF Symbol 墨迹所在的位置：
    //   1x1 居中；2x2 与文字同一条 16pt 左边界、垂直居中于 glyph 方格；
    //   2x1 / 更宽的横条 居中于 glyph 方格。
    CGFloat packageSide = kERConnectivityGlyphBox;
    CGFloat packageScale = 1.0;
    CGFloat packageX, packageY;
    if (btSingleCell) {
        packageX = round((btW - packageSide) * 0.5);
        packageY = round((btH - packageSide) * 0.5);
    } else if (btW > kERGridCellSize + 1.0 && btH > kERGridCellSize + 1.0) {
        packageX = kERSquareContentInset;
        packageY = round(4.0 + (kERGridCellSize - packageSide) * 0.5);
    } else {
        packageX = round((kERGridCellSize - packageSide) * 0.5);
        packageY = round((kERGridCellSize - packageSide) * 0.5);
    }
    if (!packageView) {
        packageView = [[packageViewClass alloc] initWithFrame:CGRectMake(packageX, packageY, packageSide, packageSide)];
        packageView.tag = kERConnectivityBluetoothPackageGlyphTag;
        packageView.userInteractionEnabled = NO;
        packageView.contentMode = UIViewContentModeCenter;
        packageView.tintColor = UIColor.whiteColor;
        [presentation addSubview:packageView];
        id packageDescription = nil;
        SEL factory = NSSelectorFromString(@"descriptionForPackageNamed:inBundle:");
        if ([descriptionClass respondsToSelector:factory]) {
            packageDescription = ((id (*)(id, SEL, id, id))objc_msgSend)(descriptionClass, factory, @"Bluetooth", bundle);
        }
        if (!packageDescription) {
            SEL init = NSSelectorFromString(@"initWithPackageName:inBundle:");
            if ([descriptionClass instancesRespondToSelector:init]) {
                packageDescription = ((id (*)(id, SEL, id, id))objc_msgSend)([descriptionClass alloc], init, @"Bluetooth", bundle);
            }
        }
        SEL setPackageDescription = NSSelectorFromString(@"setPackageDescription:");
        if (packageDescription && [packageView respondsToSelector:setPackageDescription]) {
            ((void (*)(id, SEL, id))objc_msgSend)(packageView, setPackageDescription, packageDescription);
        }
        SEL setScale = NSSelectorFromString(@"setScale:");
        if ([packageView respondsToSelector:setScale]) {
            ((void (*)(id, SEL, double))objc_msgSend)(packageView, setScale, packageScale);
        }
    }
    packageView.frame = CGRectMake(packageX, packageY, packageSide, packageSide);
    SEL setScale = NSSelectorFromString(@"setScale:");
    if ([packageView respondsToSelector:setScale]) {
        ((void (*)(id, SEL, double))objc_msgSend)(packageView, setScale, packageScale);
    }
    packageView.hidden = NO;
    packageView.alpha = 1.0;
    SEL stateSelector = NSSelectorFromString(@"setStateName:");
    if ([packageView respondsToSelector:stateSelector]) {
        ((void (*)(id, SEL, id))objc_msgSend)(packageView, stateSelector, selected ? @"poweron" : @"poweroff");
    }
    return packageView;
}

// Bluetooth is the one converted module whose glyph is a CAPackage rather than
// an SF Symbol, so it does not go through the UIImageView alignment above.
//
// On a 2x2 tile its leading edge is pushed out to the shared 16pt inset so the
// Bluetooth artwork lines up with the symbol glyphs and the captions. Every
// other footprint keeps the package centred in its cell exactly as before.
static void ERAlignConnectivityPackageGlyphForLayout(UIView *packageGlyph, CCUILayoutSize gridSize) {
    if (!packageGlyph) return;
    if (!(gridSize.width >= 2 && gridSize.height >= 2)) return;
    CGRect frame = packageGlyph.frame;
    frame.origin.x = kERSquareContentInset;
    packageGlyph.frame = frame;
}

// Puts a converted tile's own system material back on screen.
//
// This is the OFF background of a converted tile, and restoring it is not
// optional: -ERSetModuleNativeContentHidden: walks the module and hides every
// subview that is not EchoReborn's own chrome. It spares UIVisualEffectView, but
// the platter a connectivity module actually uses on iOS 16/17 is an
// MTMaterialView, which is *not* one — so the hide pass takes the tile's
// background with it. That is the real reason an OFF tile once looked like a
// hole ("关闭状态下的背景色缺失"): not a missing colour, a hidden material.
//
// v0.3.10/v0.3.11 papered over it by painting a grey platter instead. That grey
// was never going to match, because every other module on the page is showing
// this material and nothing else. So the material is restored here — matching
// the rest of the page exactly — and the only fallback is EchoReborn's own blur
// platter, never a flat colour.
static void ERRestoreConvertedTileMaterial(UIView *material, BOOL visible, BOOL available) {
    if (!material) return;
    // 液态玻璃在场时，玻璃就是这块磁贴唯一的背景面。系统模块的做法也是如此：
    // 玻璃装上之后原生材质会被隐藏。两层背景同时可见时，它们的圆角与 backdrop
    // 分组并不相同，叠在一起就会出现「没铺满」的弧线——这正是用户报的第二个问题。
    // 所以玻璃在场时强制隐藏材质，让玻璃独占背景；玻璃被摘掉（关闭液态玻璃）后
    // 本函数下一次调用会把材质重新露出来。
    //
    // 0.5.10：玻璃是否真的渲染出东西（-lgFilterAttached）由 ERSyncConnectivity
    // TileGlass 负责重试——GlassKit 自己的重试在 1.5/3/5/8/12 秒，EchoReborn 另外在
    // 每次磁贴刷新时补一次 applyFilters。这里只管「玻璃在场就让玻璃独占背景」，
    // 与系统模块完全一致。
    //
    // 注意 GlassKit 还 hook 了 -[MTMaterialView setHidden:]：只要材质上挂着玻璃，
    // hidden 会被强制改成 YES。这是系统模块的既定行为（装上玻璃即隐藏原生材质），
    // 因此这里不需要、也不可能再单独把材质显示出来。
    material.hidden = !visible || ERTileGlassPresent(material);
    material.alpha = visible ? (available ? 1.0 : 0.52) : 0.0;
    material.layer.opacity = material.alpha;
}

// 连通性磁贴背景不变量。无论布局分支如何结束、也不管液态玻璃处于开/关，
// 都重新断言磁贴持有一块可见的系统材质底。关闭液态玻璃后 GlassKit 的
// reconcile 会移除唯一的玻璃层，本函数把 EchoReborn 自有的兜底毛玻璃重新挂上，
// 并恢复「关闭」态应有的材质可见性，杜绝磁贴变透明。
static void ERSyncConnectivityTileChrome(UIView *moduleView) {
    if (!moduleView) return;
    UIViewController *module = ERModuleControllerForView(moduleView);
    NSString *identifier = module ? ERModuleIdentifier(module) : nil;
    if (![identifier.lowercaseString containsString:@"echoreborn.connectivity"]) return;
    UIView *material = EREnsureConnectivityTileMaterial(moduleView);
    if (!material) return;
    // 创建时没借到系统材质（页面还没布局完）就先退回了模糊；这里再试一次，
    // 让「关闭态背景 = 系统同款材质」这个不变量最终收敛，而不是永久停在模糊上。
    material = ERUpgradeConnectivityTileMaterialIfNeeded(moduleView, material);
    BOOL selected = ERConnectivitySelectedForIdentifier(identifier);
    BOOL available = ERConnectivityAvailableForIdentifier(identifier);
    ERRestoreConvertedTileMaterial(material, !selected, available);
    // 本函数在每次布局/状态刷新时都会被调到。逐次打日志会把导出日志淹掉，因此只在
    // 结论真正变化时记录一次：材质来源(system/blur) + 开/关 + 可用性 + 玻璃。
    // glass=1 时材质应当是被隐藏的（玻璃独占背景）；radius 用来核对七个磁贴是否
    // 取到了与系统模块一致的圆角。
    LGLiveBackdropView *glass = ERTileGlassForMaterial(material);
    // 1.0.6-12（第 2 条）：把「可能超出的那几层」的几何一并打出来。
    //
    // 上一版只打了圆角，无法判断「超出一点」到底来自哪一层。这三组 frame 都是
    // 换算到模块视图坐标系后的值，只要哪一组超出 {0,0,moduleView 宽高}，就是它：
    //   mat  = EchoReborn 注入的材质（承载玻璃的那块）
    //   gs   = 玻璃层（相对材质）
    //   surf = 白色选中底（相对模块视图）
    // 三者与 moduleView.bounds 一起看，一轮日志就能定案，不必再靠猜。
    CGRect matFrame = [moduleView convertRect:material.bounds fromView:material];
    CGRect glassFrame = CGRectZero;
    if (glass) glassFrame = [moduleView convertRect:glass.bounds fromView:glass];
    UIView *selectedSurface = [moduleView viewWithTag:kERConnectivitySelectedSurfaceTag];
    CGRect surfaceFrame = selectedSurface ? selectedSurface.frame : CGRectZero;
    // 1.0.6-12（第 5 条）：再加两个量，一轮日志就能判定白底是否对齐：
    //   cR = CCUIContentModuleContainerView 的实际圆角（liquidass 拥有，外轮廓真值）
    //   sR = 白色选中底当前圆角 —— 稳态下必须恒等于 cR。
    UIView *tileContainer = ERFindAncestorOrSubviewWithClassName(moduleView, @"CCUIContentModuleContainerView");
    // 1.0.7-5：把容器的 frame 也打出来。
    // 白底改为「一律铺满磁贴 bounds」之后，这一项就是**验证用的反例探针**：
    // 只要哪天出现 ctr 明显小于 bnd 的布局，就说明容器确实会缩，届时再看要不要
    // 重新引入裁剪（那时必须用确定性判据，不能用比例）。稳态下 ctr 应等于 bnd。
    CGRect containerFrame = CGRectZero;
    if (tileContainer) containerFrame = [moduleView convertRect:tileContainer.bounds fromView:tileContainer];
    NSString *state = [NSString stringWithFormat:@"%@ sel=%d avail=%d glass=%d fa=%d r=%.1f tileR=%.1f cR=%.1f sR=%.1f bnd={%.0fx%.0f} ctr={%.0f,%.0f,%.0fx%.0f} mat={%.0f,%.0f,%.0fx%.0f} gs={%.0f,%.0f,%.0fx%.0f} surf={%.0f,%.0f,%.0fx%.0f}",
                       [NSStringFromClass(material.class) isEqualToString:@"MTMaterialView"] ? @"system" : @"blur",
                       selected ? 1 : 0, available ? 1 : 0,
                       glass ? 1 : 0,
                       glass ? (glass.lgFilterAttached ? 1 : 0) : -1,
                       glass ? glass.layer.cornerRadius : -1.0,
                       moduleView.layer.cornerRadius,
                       tileContainer ? tileContainer.layer.cornerRadius : -1.0,
                       selectedSurface ? selectedSurface.layer.cornerRadius : -1.0,
                       CGRectGetWidth(moduleView.bounds), CGRectGetHeight(moduleView.bounds),
                       containerFrame.origin.x, containerFrame.origin.y, containerFrame.size.width, containerFrame.size.height,
                       matFrame.origin.x, matFrame.origin.y, matFrame.size.width, matFrame.size.height,
                       glassFrame.origin.x, glassFrame.origin.y, glassFrame.size.width, glassFrame.size.height,
                       surfaceFrame.origin.x, surfaceFrame.origin.y, surfaceFrame.size.width, surfaceFrame.size.height];
    if (![objc_getAssociatedObject(moduleView, kERTileChromeLogStateKey) isEqual:state]) {
        objc_setAssociatedObject(moduleView, kERTileChromeLogStateKey, state, OBJC_ASSOCIATION_COPY_NONATOMIC);
        // 1.0.6-12（第 1 / 4 条）：state 里含 tileR，而 tileR 在 1.0.6-10 上持续跳变
        // （35.5 ↔ 31.5），于是这条「只在结论变化时」的日志实际上每次布局都落一行 ——
        // 一次会话 212 行、单秒峰值 28 行，占全会话日志量的 30%。除第 1 条已把跳变
        // 本身消掉之外，这里再按 1 行/秒封顶。
        if (ERDiagShouldLog(@"OFFBGFIX", 1.0)) {
            ERLogInfo(@"OFFBGFIX ver=1.0.9-103 id=%@ %@", identifier, state);
        }
    }
}

// 1.0.6-12（第 5 条）：白色选中底必须贴着磁贴**真正的外轮廓**，而不是
// moduleView.layer.cornerRadius 这个快照。
//
// 七个连通性磁贴的圆角由 liquidass 拥有 —— 它圆的是 CCUIContentModuleContainerView；
// EchoReborn 在 -applyRefinedLookToModule: 里刻意不改写它（见那里的注释）。于是
// moduleView.layer.cornerRadius 与容器实际圆角是两个不同的数，白底取前者的后果是
// 圆弧与磁贴轮廓错开：白底半径偏小 → 白色从四角溢出；偏大 → 角上露出底下的材质 /
// 玻璃。两者都表现为「开启态还能看见外面多的一点」。
//
// 1.0.6-12 加的 ERReassertConnectivitySelectedSurface 只是把白底重新对齐到**同一个
// 错的值**，所以症状原样保留。现在改成一律以容器几何为准：
//   · frame  = 容器 bounds 换算到 moduleView 坐标系后与 moduleView.bounds 的交集，
//              容器比磁贴小的时候白底也铺不出去；
//   · 圆角  = 容器实际圆角，容器没圆角时才退回 moduleView。
static CGRect ERConnectivitySurfaceFrameForModuleView(UIView *moduleView) {
    if (!moduleView) return CGRectZero;
    // 1.0.7-5（第 2 / 3 条）：白底一律铺满**磁贴自身的 bounds**，不再与容器求交集。
    //
    // 上一版用的是「容器两轴都达到磁贴尺寸 60% 才认它是外轮廓」这种比例判据，
    // 结果正如用户反馈「有时候满了、有时候还是老样子」—— 它依赖容器在那一刻的
    // 瞬时尺寸，是个会飘的启发式。改成确定性：
    //
    // 日志已经证明两件事：
    //   · 非编辑态 surf 与 bnd 完全相同（{0,0,163x75}）—— 说明容器从不比磁贴小，
    //     当年那句「容器比磁贴小的时候白底也铺不出去」在这台设备上从未发生，
    //     求交集在正常态**什么也没裁掉**；
    //   · 编辑态容器只剩 {0,48,163x27}，求交集把白底压成 27pt 横条 —— 唯一的实际
    //     效果就是制造 bug。
    // 所以直接以磁贴 bounds 为准：正常态结果与之前逐像素相同，编辑态不再塌陷。
    // 圆角仍由 ERConnectivitySurfaceRadiusForModuleView 取玻璃实轮廓，不受影响。
    return moduleView.bounds;
}

// 磁贴上那块玻璃（tag = kERConnectivityTileGlassTag）。白色选中底的圆角要以它为准，
// 因为它就是用户眼睛看到的外轮廓。只翻 moduleView 的直接子视图与孙视图 —— 玻璃由
// ERSyncConnectivityTileGlass 挂在 EchoReborn 注入的材质上，而那块材质是 moduleView
// 的直接子视图（见 EREnsureTileMaterial）。
static UIView *ERConnectivityTileGlassIn(UIView *moduleView) {
    if (!moduleView) return nil;
    for (UIView *child in moduleView.subviews) {
        if (child.tag == kERConnectivityTileGlassTag && [child isKindOfClass:[LGLiveBackdropView class]]) return child;
        for (UIView *grandchild in child.subviews) {
            if (grandchild.tag == kERConnectivityTileGlassTag && [grandchild isKindOfClass:[LGLiveBackdropView class]]) return grandchild;
        }
    }
    return nil;
}

static CGFloat ERConnectivitySurfaceRadiusForModuleView(UIView *moduleView) {
    if (!moduleView) return 0.0;
    // 1.0.6-13（第 3 / 5 条）：取值顺序重排，玻璃实测圆角排第一。
    //
    // 为什么非改不可：七个连通性磁贴的圆角自 1.0.6-11 起完全归 liquidass，EchoReborn
    // 对它们只写 cornerCurve / masksToBounds（applyRefinedLookToModule:），
    // applyTransitionRadiusToModule: 也在入口直接 return。结果是
    // moduleView.layer.cornerRadius **实测为 0** —— 白色选中底照着 0 铺出来就是一块
    // 直角色块，四个角压在圆角磁贴之外。这正是「刚注销完进控制中心、七个模块开启项就
    // 显示那样，进编辑界面又自己好了」（编辑态会重新写一次圆角）以及「开启态还能看见
    // 外面多的一点」。
    //
    // 玻璃的圆角由 ERSyncConnectivityTileGlass 决定（七个磁贴取「材质短边一半」），
    // 拿它就一定不会与轮廓错开；后三级兜底保证任何情况下都不会再退回直角。
    UIView *glass = ERConnectivityTileGlassIn(moduleView);
    if (glass && glass.layer.cornerRadius > 1.0) return glass.layer.cornerRadius;
    UIView *container = ERFindAncestorOrSubviewWithClassName(moduleView, @"CCUIContentModuleContainerView");
    if (container && container.layer.cornerRadius > 1.0) return container.layer.cornerRadius;
    if (moduleView.layer.cornerRadius > 1.0) return moduleView.layer.cornerRadius;
    return ERGlassPillRadius(moduleView);
}

// 1.0.6-12（第 2 条）：把白色选中底重新对齐到磁贴的最终几何。
//
// -ERSetConnectivitySelectedSurface 在 ON 态把这块白底铺满磁贴。它的 frame 走
// autoresizingMask，圆角则在那一次调用的**瞬间**从 moduleView.layer.cornerRadius 读一个
// 快照。此后只要磁贴的 bounds 或圆角再变（拖动改尺寸、翻页重排、圆角跳变），白底就
// 留在旧值上：圆角偏小 → 白色直角落到磁贴圆角之外，看上去正是「超出一点」。
//
// 本函数在连通性磁贴布局分支的末端（ERSyncConnectivityTileChrome 之后）再对齐一次，
// 那时磁贴几何已经收敛，白底因此不可能再超出。只写真正变化的值，稳态下是空操作。
static void ERReassertConnectivitySelectedSurface(UIView *moduleView) {
    if (!moduleView) return;
    UIView *surface = [moduleView viewWithTag:kERConnectivitySelectedSurfaceTag];
    if (!surface) return;
    // 1.0.6-12（第 5 条）：frame 与圆角都改取容器几何，见
    // ERConnectivitySurfaceFrameForModuleView 的注释。
    CGRect target = ERConnectivitySurfaceFrameForModuleView(moduleView);
    if (!CGRectEqualToRect(surface.frame, target)) surface.frame = target;
    CGFloat radius = ERConnectivitySurfaceRadiusForModuleView(moduleView);
    if (radius > 1.0 && fabs(surface.layer.cornerRadius - radius) > 0.01) {
        surface.layer.cornerRadius = radius;
    }
}

// Draws the tile background.
//
// Two styles live here, chosen by ERConnectivityIdentifierUsesWhiteHighlight:
//
//   * Converted modules (all seven connectivity tiles) show the SAME two things
//     as the rest of the page:
//       ON  → a solid white platter drawn by EchoReborn, material faded out;
//       OFF → no painted overlay at all, just a translucent MATERIAL, which is
//             what every other module on the page is showing. The material is
//             the module's own when that can actually be shown, otherwise a
//             SystemUltraThinMaterialDark platter EchoReborn owns (see
//             ERConvertedTileBackgroundMaterial).
//     Painting an explicit grey for OFF (v0.3.10 `#C7C7CC`, v0.3.11
//     `colorWithWhite:1.0 alpha:0.12`) could never match: no other module has
//     that overlay, so the converted tiles always read one shade off.
//   * The unconverted remainder keeps the brand-filled platter, and only when
//     selected, so both styles can be judged side by side in one build.
static void ERSetConnectivitySelectedSurface(UIViewController *module, BOOL selected, BOOL available, UIColor *accentColor, BOOL animated) {
    UIView *moduleView = module.view;
    if (!moduleView) return;
    NSString *identifier = ERModuleIdentifier(module);
    BOOL highlights = ERConnectivityIdentifierUsesWhiteHighlight(identifier);
    UIView *surface = [moduleView viewWithTag:kERConnectivitySelectedSurfaceTag];
    if (!surface) {
        surface = [[UIView alloc] initWithFrame:moduleView.bounds];
        surface.tag = kERConnectivitySelectedSurfaceTag;
        surface.userInteractionEnabled = NO;
        surface.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        surface.layer.cornerCurve = kCACornerCurveContinuous;
        [moduleView addSubview:surface];
    }
    // 1.0.6-12（第 5 条）：与 ERReassertConnectivitySelectedSurface 用同一组取法，
    // 见 ERConnectivitySurfaceFrameForModuleView 的注释。
    surface.frame = ERConnectivitySurfaceFrameForModuleView(moduleView);
    surface.layer.cornerRadius = ERConnectivitySurfaceRadiusForModuleView(moduleView);
    // A converted tile's OFF background is a real material, never a painted
    // colour, and it is resolved so it cannot end up stuck behind a switched-off
    // ancestor. See ERConvertedTileBackgroundMaterial.
    UIView *material = highlights ? ERConvertedTileBackgroundMaterial(moduleView)
                                  : ERFirstModuleMaterialSurface(moduleView);
    // A converted module paints white while ON, and nothing while OFF so the
    // material shows through. An unconverted module paints only its brand
    // colour while selected.
    surface.backgroundColor = highlights
        ? (selected ? ERConnectivityHighlightPlatterColor() : UIColor.clearColor)
        : (accentColor ?: [UIColor colorWithRed:0.0 green:0.48 blue:1.0 alpha:1.0]);
    // Stacking, back to front: material, then the white surface, then the glyph.
    // Both are sent to the back, the material last, so it stays underneath.
    [moduleView sendSubviewToBack:surface];
    if (highlights && material) [moduleView sendSubviewToBack:material];
    void (^changes)(void) = ^{
        surface.hidden = NO;
        surface.alpha = selected ? (available ? 1.0 : 0.42) : 0.0;
        if (highlights) {
            // ON  → the material is hidden, or its blur would tint the white.
            // OFF → the material *is* the background, so it is restored. This is
            //       also what undoes the native-content hide pass, which takes
            //       the module's MTMaterialView with it.
            ERRestoreConvertedTileMaterial(material, !selected, available);
        } else {
            material.alpha = selected ? 0.0 : (available ? 1.0 : 0.52);
            material.layer.opacity = material.alpha;
        }
    };
    void (^completion)(BOOL) = ^(__unused BOOL finished) {
        // A converted OFF tile shows only its material; an unconverted one is
        // fully transparent when off, exactly as before.
        surface.hidden = !selected;
    };
    if (animated) {
        [UIView animateWithDuration:0.24 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction animations:changes completion:completion];
    } else {
        changes();
        completion(YES);
    }
}

static CCUILayoutSize EREffectiveCustomSizeForModule(UIViewController *module, NSString *identifier) {
    CCUILayoutSize size = {1, 1};
    NSArray<NSNumber *> *customSize = gERCustomSizes[identifier];
    if (customSize.count >= 2) {
        size.width = MAX((NSUInteger)1, customSize[0].unsignedIntegerValue);
        size.height = MAX((NSUInteger)1, customSize[1].unsignedIntegerValue);
        return size;
    }
    NSValue *baseValue = gERBaseLayoutSizes[identifier];
    if (baseValue) {
        [baseValue getValue:&size];
        size.width = MAX((NSUInteger)1, size.width);
        size.height = MAX((NSUInteger)1, size.height);
        return size;
    }
    CGFloat width = CGRectGetWidth(module.view.bounds);
    CGFloat height = CGRectGetHeight(module.view.bounds);
    size.width = MAX((NSUInteger)1, (NSUInteger)llround((width + kERGridGap) / kERGridStep));
    size.height = MAX((NSUInteger)1, (NSUInteger)llround((height + kERGridGap) / kERGridStep));
    return size;
}

static NSString *ERTextSizeCompactValue(UIView *root) {
    if (!root) return nil;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if ([NSStringFromClass(candidate.class) isEqualToString:@"CCUISteppedSliderView"]) {
            NSString *accessibilityValue = candidate.accessibilityValue;
            if (accessibilityValue.length &&
                ![accessibilityValue isEqualToString:@"0"] &&
                ![accessibilityValue isEqualToString:@"1"]) return accessibilityValue;
            if ([candidate respondsToSelector:@selector(value)]) {
                float value = ((float (*)(id, SEL))objc_msgSend)((id)candidate, @selector(value));
                if (isfinite(value)) return [NSString stringWithFormat:@"%ld%%", (long)llroundf(value * 100.0f)];
            }
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
    return nil;
}

static UIView *EREnsureOwnedCompactPresentation(UIView *host) {
    UIView *presentation = [host viewWithTag:kERResizePresentationTag];
    if (!presentation) {
        presentation = [[UIView alloc] initWithFrame:host.bounds];
        presentation.tag = kERResizePresentationTag;
        presentation.userInteractionEnabled = NO;
        presentation.backgroundColor = UIColor.clearColor;
        presentation.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        presentation.clipsToBounds = YES;
        UILabel *title = [[UILabel alloc] initWithFrame:CGRectZero];
        title.tag = 1;
        title.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightSemibold];
        title.numberOfLines = 2;
        title.lineBreakMode = NSLineBreakByTruncatingTail;
        [presentation addSubview:title];
        UILabel *status = [[UILabel alloc] initWithFrame:CGRectZero];
        status.tag = 2;
        status.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightRegular];
        status.adjustsFontSizeToFitWidth = YES;
        status.minimumScaleFactor = 0.78;
        [presentation addSubview:status];
        [host addSubview:presentation];
    }
    presentation.hidden = NO;
    presentation.alpha = 1.0;
    return presentation;
}

// The 2x1 leading margin used by the converted connectivity tiles.
//
// The seven tiles have to line their captions up as one column, so there is a
// single margin for all of them. The reference is 蓝牙: its two-character title
// is what gets centred in the tile, and the left edge that centring produces
// becomes the shared margin.
//
// Deriving the margin from ONE reference title — rather than centring each title
// individually — is the whole point. Centring each one would put 无线局域网 and
// VPN at different lefts, which is exactly the misalignment this is fixing.
static CGFloat ERConnectivityCompactTextLeading(UIFont *font, CGFloat logicalWidth) {
    NSString *reference = @"蓝牙";
    CGFloat referenceWidth = ceil([reference sizeWithAttributes:@{NSFontAttributeName: font}].width);
    CGFloat leading = round((logicalWidth - referenceWidth) * 0.5);
    return MAX(0.0, leading);
}

// Lays out the glyph and the two captions for one footprint.
//
// Three arrangements, matching the spec exactly:
//
//   1x1  glyph only, centred in the cell. No captions.
//   2x1  glyph in the leading cell-sized square; the two captions form one block
//        beside it, left-aligned and vertically CENTRED in the (short) tile.
//   2x2  glyph in the top-left cell-sized square; the two captions form one
//        block pinned to the BOTTOM of the tile, left-aligned, starting at the
//        tile's own leading inset rather than at the glyph column.
//
// The 2x2 case previously reused the 2x1 rule and centred the text block
// vertically, which left a wide empty band between the icon and the words. The
// spec asks for the words to sit along the bottom, so the two footprints now
// have their own geometry instead of sharing one.
//
// `connectivityColumn` switches the 2x1 leading to the shared 蓝牙-referenced
// margin above. Only the seven converted connectivity tiles set it; every other
// presenter keeps the original glyph-column inset. The flag exists because the
// margin is derived, not constant, so the layout function has to own it.
// Vertical geometry is untouched by it — only the horizontal spacing changes.
static void ERLayoutOwnedCompactPresentation(UIView *presentation, NSString *symbolName, NSString *titleText, NSString *statusText, CCUILayoutSize gridSize, BOOL connectivityColumn) {
    if (!presentation) return;
    CGFloat logicalWidth = gridSize.width * kERGridCellSize + (gridSize.width > 1 ? (gridSize.width - 1) * kERGridGap : 0.0);
    CGFloat logicalHeight = gridSize.height * kERGridCellSize + (gridSize.height > 1 ? (gridSize.height - 1) * kERGridGap : 0.0);
    if (logicalWidth < 1.0) logicalWidth = CGRectGetWidth(presentation.superview.bounds);
    if (logicalHeight < 1.0) logicalHeight = CGRectGetHeight(presentation.superview.bounds);
    UILabel *title = (UILabel *)[presentation viewWithTag:1];
    UILabel *status = (UILabel *)[presentation viewWithTag:2];
    UIImageView *glyph = EREnsureResizePresentationGlyph(presentation, symbolName);
    BOOL isSingleCell = (gridSize.width == 1 && gridSize.height == 1);
    BOOL isSquare = (gridSize.width >= 2 && gridSize.height >= 2);
    // A 1x1 is glyph-only, so neither caption is shown there.
    BOOL showTitle = titleText.length && !isSingleCell;
    BOOL showStatus = showTitle && statusText.length;
    title.text = titleText;
    title.textColor = UIColor.whiteColor;
    status.text = statusText;
    status.textColor = [UIColor.whiteColor colorWithAlphaComponent:0.62];
    CGFloat lineHeight = 14.3333;

    // Leading inset and available text width, per arrangement.
    //
    // 2x1: the text sits beside the glyph, so it starts just past the glyph
    // square (which is mostly padding — the symbol is ~30pt of 67) and stops
    // short of the tile's trailing edge.
    // 2x2: the text is under the glyph on its own line, so it can use the whole
    // tile width and only needs the normal horizontal margin.
    CGFloat textX = 0.0;
    CGFloat textWidth = 0.0;
    if (isSquare) {
        // 2x2: the captions share the glyph's 16pt leading inset so the text
        // block sits on the same vertical edge as the artwork above it. Before
        // v0.3.11 the text started at 12pt while the symbol's visible ink began
        // around 17pt, which read as "底部文字太过于靠边" — the label jutted out
        // past the icon instead of lining up with it.
        textX = kERSquareContentInset;
        textWidth = MAX(0.0, logicalWidth - textX - kERSquareContentInset);
    } else {
        // 2x1: the glyph takes the leading cell-sized square and the captions sit
        // beside it. The seven connectivity tiles use one SHARED, 蓝牙-referenced
        // margin instead, so their captions line up as a column; every other
        // presenter keeps the original glyph-column inset.
        textX = connectivityColumn ? ERConnectivityCompactTextLeading(title.font, logicalWidth)
                                   : (kERGridCellSize + 6.0);
        textWidth = MAX(0.0, logicalWidth - textX - 10.0);
    }
    CGRect measuredTitle = [titleText boundingRectWithSize:CGSizeMake(textWidth, lineHeight * 2.0)
                                                   options:NSStringDrawingUsesLineFragmentOrigin | NSStringDrawingUsesFontLeading
                                                attributes:@{NSFontAttributeName: title.font}
                                                   context:nil];
    CGFloat titleHeight = measuredTitle.size.height > lineHeight + 1.0 ? lineHeight * 2.0 : lineHeight;
    CGFloat groupHeight = titleHeight + (showStatus ? lineHeight : 0.0);

    [UIView performWithoutAnimation:^{
        presentation.frame = CGRectMake(0.0, 0.0, logicalWidth, logicalHeight);
        // The glyph always occupies the leading cell-sized square for every
        // footprint larger than 1x1 — top-left on a 2x2, left-centre on a 2x1.
        if (isSingleCell) {
            CGFloat side = MIN(logicalWidth, logicalHeight);
            glyph.contentMode = UIViewContentModeCenter;
            glyph.frame = CGRectMake(round((logicalWidth - side) * 0.5), round((logicalHeight - side) * 0.5), side, side);
        } else if (isSquare) {
            // Top-left, on the same 16pt leading inset the captions use. The
            // glyph image is left-aligned inside its cell-sized square so the
            // *visible* symbol starts at 16pt — centring it in a 67pt box put
            // the ink ~4pt to the right of the labels below.
            glyph.contentMode = UIViewContentModeLeft;
            glyph.frame = CGRectMake(kERSquareContentInset, 4.0, kERGridCellSize, kERGridCellSize);
        } else {
            glyph.contentMode = UIViewContentModeCenter;
            glyph.frame = CGRectMake(0.0, 0.0, kERGridCellSize, kERGridCellSize);
        }
        glyph.hidden = NO;
        glyph.alpha = 1.0;

        if (isSingleCell) {
            // Nothing else to place: a 1x1 is glyph-only.
            title.frame = CGRectZero;
            status.frame = CGRectZero;
        } else if (isSquare) {
            // Captions pinned to the bottom, left-aligned, as one block.
            CGFloat bottomInset = 12.0;
            CGFloat top = logicalHeight - bottomInset - groupHeight;
            // Never let the block ride up into the glyph square on a short tile.
            top = MAX(top, kERGridCellSize + 8.0);
            title.frame = CGRectMake(textX, top, textWidth, titleHeight);
            status.frame = CGRectMake(textX, top + titleHeight, textWidth, lineHeight);
        } else {
            // 2x1: captions beside the glyph, vertically centred.
            CGFloat top = round((logicalHeight - groupHeight) * 0.5);
            title.frame = CGRectMake(textX, top, textWidth, titleHeight);
            status.frame = CGRectMake(textX, top + titleHeight, textWidth, lineHeight);
        }
        title.textAlignment = NSTextAlignmentLeft;
        status.textAlignment = NSTextAlignmentLeft;
        title.hidden = !showTitle;
        status.hidden = !showStatus;
        title.alpha = showTitle ? 1.0 : 0.0;
        status.alpha = showStatus ? 1.0 : 0.0;
        [presentation bringSubviewToFront:glyph];
    }];
}

// Paints the glyph and the two labels for the current state.
//
// Colours are driven by the module's interaction style:
//   * Converted modules (white/grey platter): the module's own accent glyph
//     (blue for Wi-Fi/Bluetooth/AirDrop/VPN, yellow for 飞行模式, green for
//     蜂窝数据/个人热点) on the white platter when ON, with dark labels; a white
//     glyph and white labels when OFF on the grey platter.
//   * The unconverted remainder (brand platter): white glyph, white labels in
//     both states, because the colour already lives in the tile background.
//
// The identifier is required rather than inferred from the accent colour,
// because the two styles can share the same accent (a converted module and
// 个人热点 can both resolve to a blue/green) — the accent alone cannot decide
// how the tile is painted.
static void ERApplyOwnedCompactPresentationState(UIView *presentation, NSString *identifier, BOOL selected, BOOL active, UIColor *accentColor, BOOL animated) {
    if (!presentation) return;
    UILabel *title = (UILabel *)[presentation viewWithTag:1];
    UILabel *status = (UILabel *)[presentation viewWithTag:2];
    UIImageView *glyph = (UIImageView *)[presentation viewWithTag:kERResizePresentationGlyphTag];
    UIView *packageGlyph = [presentation viewWithTag:kERConnectivityBluetoothPackageGlyphTag];
    BOOL whiteHighlight = ERConnectivityIdentifierUsesWhiteHighlight(identifier);
    UIColor *glyphColor = nil;
    if (selected) {
        if (whiteHighlight) {
            // The module's accent on the white platter. `active` only softens
            // it, so an unavailable-but-on radio does not look fully live.
            glyphColor = active ? accentColor
                                : [accentColor colorWithAlphaComponent:0.55];
        } else {
            glyphColor = active ? UIColor.whiteColor : [UIColor.whiteColor colorWithAlphaComponent:0.72];
        }
    } else {
        // Off: white glyph on the grey (or blurred) tile, both styles.
        glyphColor = UIColor.whiteColor;
    }
    UIColor *titleColor = ERConnectivityPrimaryTextColor(identifier, selected);
    UIColor *statusColor = ERConnectivitySecondaryTextColor(identifier, selected);
    void (^changes)(void) = ^{
        title.textColor = titleColor;
        status.textColor = statusColor;
        glyph.tintColor = glyphColor;
        packageGlyph.tintColor = glyphColor;
    };
    if (animated) {
        [UIView transitionWithView:presentation duration:0.18 options:UIViewAnimationOptionTransitionCrossDissolve | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowAnimatedContent animations:changes completion:nil];
    } else {
        changes();
    }
    // The CAPackage and the SF Symbol are painted through different paths, so
    // the package needs its own scheduled passes — `setStateName:` rebuilds the
    // CAStateLayer tree asynchronously and would otherwise undo a one-shot
    // recolour.
    ERScheduleBluetoothPackageRecolor(presentation, glyphColor, animated);
}

static void ERApplyOwnedCompactPresentationAvailability(UIView *presentation, BOOL available) {
    if (!presentation) return;
    presentation.alpha = available ? 1.0 : 0.44;
    for (UIView *subview in presentation.subviews) subview.alpha = available ? 1.0 : 0.72;
}

static void ERSetConnectivityProxyPressed(UIControl *sender, BOOL pressed) {
    if (!sender || gEditModeActive || gERExpandedModuleOpen) return;
    UIView *moduleView = sender.superview;
    NSString *identifier = objc_getAssociatedObject(sender, kERConnectivityIdentifierKey);
    if (!moduleView || !ERConnectivityIdentifierIsOwned(identifier)) return;
    BOOL selected = ERConnectivitySelectedForIdentifier(identifier);
    BOOL available = ERConnectivityAvailableForIdentifier(identifier);
    UIView *presentation = [moduleView viewWithTag:kERResizePresentationTag];
    UIView *surface = [moduleView viewWithTag:kERConnectivitySelectedSurfaceTag];
    BOOL highlights = ERConnectivityIdentifierUsesWhiteHighlight(identifier);
    // Same resolution as the layout path, so the press preview and the resting
    // tile agree on what the OFF background is.
    UIView *material = highlights ? ERConvertedTileBackgroundMaterial(moduleView)
                                  : ERFirstModuleMaterialSurface(moduleView);
    // The press preview fades the same surface in, so it has to carry the right
    // colour even on the very first press, before the tile has ever been
    // selected and ERSetConnectivitySelectedSurface has run.
    //   ON  → the white platter
    //   OFF → no platter at all: the material underneath is the background
    surface.backgroundColor = highlights
        ? (selected ? ERConnectivityHighlightPlatterColor() : UIColor.clearColor)
        : ERConnectivityAccentColorForIdentifier(identifier);
    if (surface.superview == moduleView) [moduleView sendSubviewToBack:surface];
    if (highlights && material && material.superview == moduleView) [moduleView sendSubviewToBack:material];
    BOOL brightenForEnable = pressed && !selected && available;
    [UIView animateWithDuration:pressed ? 0.10 : 0.26
                          delay:0.0
         usingSpringWithDamping:pressed ? 1.0 : 0.74
          initialSpringVelocity:0.0
                        options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction
                     animations:^{
        moduleView.transform = CGAffineTransformIdentity;
        presentation.alpha = available ? 1.0 : 0.44;
        surface.hidden = NO;
        // A press on an OFF tile previews the ON look; a press on an ON tile
        // simply keeps showing it.
        if (selected) {
            surface.alpha = available ? 1.0 : 0.42;
        } else if (brightenForEnable) {
            // Previewing ON, so the platter must preview white too.
            if (highlights) surface.backgroundColor = ERConnectivityHighlightPlatterColor();
            surface.alpha = 0.82;
        } else {
            surface.alpha = 0.0;
        }
        // The press previews ON, so the material dims with it and comes back on
        // release — which is also what puts it back after the hide pass.
        if (!selected && material) {
            CGFloat alpha = brightenForEnable ? (available ? 0.4 : 0.2) : (available ? 1.0 : 0.52);
            material.hidden = NO;
            material.alpha = alpha;
            material.layer.opacity = alpha;
        }
    } completion:^(__unused BOOL finished) {
        if (!selected) {
            // A cancelled preview must not leave a white platter on an OFF tile.
            if (highlights) surface.backgroundColor = UIColor.clearColor;
            surface.hidden = YES;
            ERRestoreConvertedTileMaterial(material, highlights, available);
        }
    }];
}

// Drives the *native* toggle behind a connectivity tile.
//
// The old code called sendActionsForControlEvents:UIControlEventTouchUpInside
// on the CCUIRoundButton and hoped for the best. That is fragile in exactly the
// situation EchoReborn creates: the button is hidden (hidden=YES, alpha=0.0) by
// our own hide pass, and several iOS builds route the real toggle through the
// per-toggle controller's target/action pair rather than through the button's
// event stream — so the send either did nothing or hit a control that had been
// detached from its controller by the hide.
//
// Two routes, tried in order, first success wins:
//   1. The owning controller's setSelected: — Control Center's toggle modules
//      repaint and run their own side effects there, and unlike the button it
//      is not affected by our hide pass.
//   2. sendActionsForControlEvents: — the documented path, kept as the
//      fallback for modules whose controller does not answer setSelected:.
//
// Nothing here calls a runtime-introspection helper, so it cannot re-enter
// through another tweak's interposed function (see the EchoReborn swizzling rule).
static BOOL ERToggleNativeConnectivityControl(UIView *moduleView, UIControl *control, BOOL targetState) {
    if (moduleView) {
        for (UIViewController *overlay in gOverlayControllers.allObjects) {
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (module.view != moduleView) continue;
                SEL setSelected = NSSelectorFromString(@"setSelected:");
                if (![module respondsToSelector:setSelected]) break;
                @try {
                    ((void (*)(id, SEL, BOOL))objc_msgSend)(module, setSelected, targetState);
                } @catch (__unused NSException *exception) {
                    break;
                }
                // Ask the module's own content view controller too: for the
                // seven EchoReborn bundles that is the CCUIToggleModule, which is
                // where CCUI actually reads isSelected from.
                UIViewController *content = nil;
                @try { content = [module valueForKey:@"contentViewController"]; } @catch (__unused NSException *exception) { content = nil; }
                if (content && [content respondsToSelector:setSelected]) {
                    @try { ((void (*)(id, SEL, BOOL))objc_msgSend)(content, setSelected, targetState); } @catch (__unused NSException *exception) {}
                }
                return YES;
            }
        }
    }
    if (!control) return NO;
    if ([control respondsToSelector:@selector(sendActionsForControlEvents:)]) {
        [control sendActionsForControlEvents:UIControlEventTouchUpInside];
        return YES;
    }
    return NO;
}

// A module's own view is laid out for the footprint its provider declared
// (2x2 for Now Playing, 2x1 for the audio slider, ...). Shrinking it — 2x2
// down to 1x1 being the common case — leaves that content sized for the
// larger frame, where the smaller frame simply crops it. Take rendering over
// with the glyph-only compact presentation plus a fresh platter so the tile
// reads as complete instead of cut off.
// ---------------------------------------------------------------------------
static CCUILayoutSize ERNaturalSizeForIdentifier(NSString *identifier, UIViewController *module) {
    CCUILayoutSize size = {0, 0};
    if (identifier.length) {
        NSValue *baseValue = gERBaseLayoutSizes[identifier];
        if (baseValue) [baseValue getValue:&size];
        if ((!size.width || !size.height) && gERNativeLayoutRects[identifier]) {
            CCUILayoutRect rect = {};
            [gERNativeLayoutRects[identifier] getValue:&rect];
            size = rect.size;
        }
    }
    if ((!size.width || !size.height) && module.view && CGRectGetWidth(module.view.bounds) > 1.0) {
        size.width = (NSUInteger)llround((CGRectGetWidth(module.view.bounds) + kERGridGap) / kERGridStep);
        size.height = (NSUInteger)llround((CGRectGetHeight(module.view.bounds) + kERGridGap) / kERGridStep);
    }
    size.width = MAX((NSUInteger)1, size.width);
    size.height = MAX((NSUInteger)1, size.height);
    return size;
}

// Hides the module's own content, remembering exactly what it replaced so it
// can be put back untouched. EchoReborn's own chrome (tags >= 181000) and any
// platter are deliberately left alone.
//
// Walks `levels` generations of subviews, not one.
//
// The original single pass only looked at the module view's direct subviews. A
// connectivity tile does not keep its controls there: the button cluster lives
// inside an intermediate container, so a one-level walk hid the container's
// siblings and left the cluster's own buttons painting their glyphs — the
// "中间会多一个图标" symptom on a widened tile. Two levels reach the container
// *and* the controls inside it while still stopping well short of system views
// EchoReborn does not own.
//
// Every node it touches is recorded in `saved` (keyed by pointer) so
// ERSetModuleNativeContentHidden:NO can restore it exactly, and so a repeat
// call can tell "already hidden by us" from "rebuilt by SpringBoard".
static void ERSTerHideNativeSubviews(UIView *root, NSUInteger levels, NSMutableDictionary<NSString *, NSArray<NSNumber *> *> *saved) {
    if (!root || levels == 0) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    NSUInteger remaining = levels;
    while (queue.count && remaining > 0) {
        NSUInteger levelCount = queue.count;
        for (NSUInteger index = 0; index < levelCount; index++) {
            UIView *node = queue.firstObject;
            [queue removeObjectAtIndex:0];
            for (UIView *subview in node.subviews) {
                if (subview.tag >= 181000) continue;
                if ([subview isKindOfClass:[UIVisualEffectView class]]) continue;
                NSString *key = [NSString stringWithFormat:@"%p", subview];
                if (saved && !saved[key]) {
                    saved[key] = @[@(subview.hidden), @(subview.alpha)];
                }
                subview.hidden = YES;
                subview.alpha = 0.0;
                [queue addObject:subview];
            }
        }
        remaining--;
    }
}

static void ERSetModuleNativeContentHidden(UIView *moduleView, BOOL hidden) {
    if (!moduleView) return;
    NSMutableDictionary<NSString *, NSArray<NSNumber *> *> *saved =
        objc_getAssociatedObject(moduleView, kERModuleNativeContentStateKey);
    if (!hidden) {
        if (!saved.count) return;
        // 0.5.10/0.5.11: 恢复必须与隐藏对称地走两级，而不是只看直接子视图。
        //
        // 隐藏走的是两级（ERSTerHideNativeSubviews，levels = 2），但原来的恢复只
        // 遍历一层，于是第二级里被 EchoReborn 关掉的视图永远回不来——磁贴看起来就是
        // 「内容没了」。音乐模块从 4x2 改成 4x1 后整块空白正是这个原因：shrunk
        // 接管隐藏了两级，切回去时只还原了第一级。
        //
        // 只有 `saved` 里记过的视图会被还原，EchoReborn 没碰过的视图不受影响。
        //
        // 0.5.11: 严格限制在两级。0.5.10 改成了遍历整棵子树，看似更彻底，实则把一
        // 个 O(整棵模块视图树) 的遍历放进了每次恢复调用—— CC 模块树在实机上可以很
        // 深，这是主线程被拖住的其中一个来源。隐藏只走两级，恢复也就只需要两级。
        NSMutableArray<UIView *> *currentLevel = [NSMutableArray arrayWithObject:moduleView];
        for (NSUInteger depth = 0; depth < 2 && currentLevel.count; depth++) {
            NSMutableArray<UIView *> *nextLevel = [NSMutableArray array];
            for (UIView *node in currentLevel) {
                for (UIView *subview in node.subviews) {
                    NSArray<NSNumber *> *original = saved[[NSString stringWithFormat:@"%p", subview]];
                    if (original.count >= 2) {
                        subview.hidden = original[0].boolValue;
                        subview.alpha = original[1].floatValue;
                    }
                    [nextLevel addObject:subview];
                }
            }
            currentLevel = nextLevel;
        }
        objc_setAssociatedObject(moduleView, kERModuleNativeContentStateKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }
    if (saved.count) {
        // SpringBoard can rebuild the native control after a state change (a
        // toggle that re-creates its platter, a rotation, a size change) and
        // the rebuilt subviews come back visible. Sweep the same two levels
        // again and hide anything that is not already recorded, instead of
        // returning early and leaving the duplicate glyph on screen.
        ERSTerHideNativeSubviews(moduleView, 2, saved);
        return;
    }
    saved = [NSMutableDictionary dictionary];
    ERSTerHideNativeSubviews(moduleView, 2, saved);
    objc_setAssociatedObject(moduleView, kERModuleNativeContentStateKey, saved, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

static void ERApplyShrunkModulePresentation(UIViewController *module, NSString *identifier, CCUILayoutSize size) {
    UIView *moduleView = module.view;
    if (!moduleView) return;
    ERSetModuleNativeContentHidden(moduleView, YES);
    UIView *material = [moduleView viewWithTag:kERShrunkModuleMaterialTag];
    if (!material) {
        UIVisualEffectView *platter = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemUltraThinMaterialDark]];
        platter.tag = kERShrunkModuleMaterialTag;
        platter.userInteractionEnabled = NO;
        platter.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        platter.layer.cornerCurve = kCACornerCurveContinuous;
        platter.clipsToBounds = YES;
        [moduleView insertSubview:platter atIndex:0];
        material = platter;
    }
    material.hidden = NO;
    material.alpha = 1.0;
    material.frame = moduleView.bounds;
    material.layer.cornerRadius = MAX(12.0, MIN(CGRectGetWidth(moduleView.bounds), CGRectGetHeight(moduleView.bounds)) * 0.34);
    UIView *presentation = EREnsureOwnedCompactPresentation(moduleView);
    NSString *title = ERFriendlyNameForIdentifier(identifier) ?: ERPrettyNameForIdentifier(identifier);
    NSString *symbol = ERFallbackSymbolForIdentifier(identifier) ?: @"square.grid.2x2";
    ERLayoutOwnedCompactPresentation(presentation, symbol, title, nil, size, NO);
    [moduleView bringSubviewToFront:presentation];
}

static void ERRemoveShrunkModulePresentation(UIViewController *module) {
    UIView *moduleView = module.view;
    if (!moduleView) return;
    ERSetModuleNativeContentHidden(moduleView, NO);
    [[moduleView viewWithTag:kERShrunkModuleMaterialTag] removeFromSuperview];
}

// Gallery safety net. A freshly instantiated module sometimes lays itself out
// for a larger footprint than the cell it was given (its provider has not
// reported a size yet, or the bundle declares none), so the painted artwork
// spills past the cell.
//
// The fix is a CENTRE CROP, not a downscale. An earlier build scaled the whole
// content down until it fitted; on a 1x1 cell that shrank a 1x2-shaped module
// by ~0.61, so the same module looked visibly smaller and off-centre at 1x1
// while 1x2 looked correct — exactly the "1x1 is broken, 1x2 is fine" report.
// Real Control Center never scales a module either: it centres the module's
// own compact presentation inside the tile and lets the tile clip it. Keep the
// content at 1:1 and only make sure it is centred, then clip at the container.
static void ERFitPreviewContentIntoBounds(UIView *content, CGSize bounds) {
    if (!content || bounds.width < 1.0 || bounds.height < 1.0) return;
    CGRect painted = CGRectNull;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:content];
    while (queue.count) {
        UIView *view = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if (view.hidden || view.alpha <= 0.01) continue;
        CGRect frame = [view convertRect:view.bounds toView:content];
        if (CGRectGetWidth(frame) > 0.0 && CGRectGetHeight(frame) > 0.0) {
            painted = CGRectIsNull(painted) ? frame : CGRectUnion(painted, frame);
        }
        [queue addObjectsFromArray:view.subviews];
    }
    content.transform = CGAffineTransformIdentity;
    content.bounds = (CGRect){CGPointZero, bounds};
    CGPoint containerCenter = CGPointMake(bounds.width * 0.5, bounds.height * 0.5);
    content.center = containerCenter;
    if (CGRectIsNull(painted) || CGRectIsEmpty(painted)) {
        objc_setAssociatedObject(content, kERPreviewFitTransformKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }
    // Nothing to do when the art already sits inside the cell.
    if (CGRectGetWidth(painted) <= bounds.width + 1.0 && CGRectGetHeight(painted) <= bounds.height + 1.0) {
        objc_setAssociatedObject(content, kERPreviewFitTransformKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }
    // Centre the painted artwork on the cell without resizing it. Only the
    // oversized axis is shifted, so a module that is merely wider than the cell
    // (the common 1x1 case) is centred horizontally and keeps its full size.
    CGPoint paintedCenter = CGPointMake(CGRectGetMidX(painted), CGRectGetMidY(painted));
    CGFloat dx = containerCenter.x - paintedCenter.x;
    CGFloat dy = containerCenter.y - paintedCenter.y;
    CGAffineTransform transform = CGAffineTransformMakeTranslation(dx, dy);
    content.transform = transform;
    // reloadGrid resets the transform when it re-positions the preview, so the
    // fitted transform travels with the view and is re-applied there.
    objc_setAssociatedObject(content, kERPreviewFitTransformKey,
                             [NSValue valueWithCGAffineTransform:transform], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    ERLogInfo(@"preview: centred oversized content (painted %.0fx%.0f) in %.0fx%.0f",
               CGRectGetWidth(painted), CGRectGetHeight(painted), bounds.width, bounds.height);
}

// 0.5.11: 布局路径重入闸门。
//
// EchoReborn 把大量工作挂在 layoutSubviews 上（模块呈现、磁贴背景不变量、玻璃同步）。
// 只要其中任何一环让某个视图再次失效，UIKit 会在同一个 runloop 里再跑一次布局，
// 于是又进来一次 —— 主线程就这么被自己占满，最后被 watchdog 判死（0.5.10 的
// 「一直注销、进不去桌面」）。
//
// 这道闸门不修具体成因，只保证最坏情况下插件自己让路而不是拖死 SpringBoard：
// 同一条调用链上重入超过 kERLayoutReentryLimit 就直接返回，并只记一次日志。
// 正常布局是「一层套一层」的有向流程，深度不该到 2，绝不会到 3。
// 一个模块（含快捷指令磁贴这类「自有克隆体」）当前落在第几页。
//
// 口径与 ERNormalizePagedLayoutInner 完全一致：先取自定义原点，没有才用原生布局
// 矩形，再按 kERMinimumGridRows 换算页号。快捷指令磁贴是走 owned-duplicate 机制
// 进来的，它的归属页同样由 gERCustomOrigins 决定。
static NSUInteger ERPageForModuleIdentifier(NSString *identifier) {
    if (!identifier.length) return NSNotFound;
    CCUILayoutRect rect = {};
    NSValue *value = gERNativeLayoutRects[identifier];
    if (value) [value getValue:&rect];
    NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
    if (origin.count >= 2) {
        rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
    } else if (!value) {
        return NSNotFound;
    }
    return (NSUInteger)(rect.origin.y / kERMinimumGridRows);
}


static NSUInteger const kERLayoutReentryLimit = 2;
static NSInteger gERConfigLayoutDepth = 0;
static void ERConfigureOddResizedModuleLayoutInner(UIViewController *module);

static void ERConfigureOddResizedModuleLayout(UIViewController *module) {
    if (gERConfigLayoutDepth >= (NSInteger)kERLayoutReentryLimit) {
        static BOOL warned = NO;
        if (!warned) {
            warned = YES;
            ERLogInfo(@"LAYOUTGUARD ver=1.0.9-103 reentry=%ld id=%@ (bailing out)",
                       (long)gERConfigLayoutDepth, ERModuleIdentifier(module) ?: @"(nil)");
        }
        return;
    }
    gERConfigLayoutDepth++;
    @try {
        ERConfigureOddResizedModuleLayoutInner(module);
    } @finally {
        gERConfigLayoutDepth--;
    }
}

static void ERConfigureOddResizedModuleLayoutInner(UIViewController *module) {
    NSString *identifier = ERModuleIdentifier(module);
    UIView *oddPresentation = [module.view viewWithTag:kERResizePresentationTag];
    BOOL isTextSize = [identifier isEqualToString:@"com.apple.accessibility.controlcenter.text.size"];
    BOOL expandedNow = ERModuleLooksExpandedNow(module);
    BOOL isERConnectivityModule = [identifier.lowercaseString containsString:@"echoreborn.connectivity"];
    if (isERConnectivityModule) {
        ERInstallStandaloneConnectivityDetailMethod();
        if (expandedNow) {
            oddPresentation.hidden = YES;
            oddPresentation.alpha = 0.0;
            return;
        }
        // Capture the native glyph BEFORE hiding anything.
        //
        // ERConnectivityNativeGlyphImage reads the artwork *out of* a live
        // CCUIRoundButton, and it prefers an image view that is visible. The
        // hide passes below set hidden=YES and alpha=0.0 on exactly those
        // buttons, so reading the glyph afterwards always fell through to the
        // fallback branch and every tile dropped to the generic SF Symbol.
        // Read first, hide second.
        BOOL usesBluetoothPackageGlyph = [identifier.lowercaseString containsString:@".bluetooth"];
        UIImage *nativeGlyph = usesBluetoothPackageGlyph ? ERConnectivityStockProxyGlyphImage(identifier)
                                                        : (ERConnectivityStockProxyGlyphImage(identifier) ?: ERConnectivityNativeGlyphImage(module.view));
        // Two passes, deliberately.
        //
        // The first hides by class name (CCUIRoundButton and friends) because
        // those controls carry their own glyph, material, and caption, and they
        // are what the old code was aiming at. The second is the catch-all that
        // actually guarantees the result: ERSetModuleNativeContentHidden walks
        // two levels of subviews and hides everything that is not EchoReborn's own
        // chrome (tag >= 181000) — including whatever the native tile is using
        // on this iOS build, under a class name we have never seen.
        //
        // Hiding only by class name is what produced "变成 1×2 和 2×2，中间会多一个
        // 图标": the compact cluster is not one CCUILabeledRoundButton, it is a
        // container of per-toggle controls, and the classes that survived the
        // filter kept painting their glyphs next to ours.
        ERHideNativeConnectivityCompactViews(module.view);
        ERSetModuleNativeContentHidden(module.view, YES);
        oddPresentation = EREnsureOwnedCompactPresentation(module.view);
        CCUILayoutSize size = EREffectiveCustomSizeForModule(module, identifier);
        NSString *title = ERFriendlyNameForIdentifier(identifier) ?: ERPrettyNameForIdentifier(identifier);
        NSString *status = ERConnectivityStatusForIdentifier(identifier);
        NSString *symbol = ERFallbackSymbolForIdentifier(identifier) ?: @"switch.2";
        ERLayoutOwnedCompactPresentation(oddPresentation, symbol, title, status, size, YES);
        UIImageView *ownedGlyph = (UIImageView *)[oddPresentation viewWithTag:kERResizePresentationGlyphTag];
        // 0.5.11: 只在归一化结果尺寸与当前不同时才赋值。
        // 无条件每次赋一个新对象会让 UIImageView 反复失效并请求布局（见
        // ERUniformConnectivityGlyphImage 的说明），这里用尺寸做闸门把这个回环切断。
        if (nativeGlyph && ownedGlyph) {
            UIImage *uniform = ERUniformConnectivityGlyphImage([nativeGlyph imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate], kERConnectivityGlyphBox);
            CGSize currentSize = ownedGlyph.image.size;
            if (fabs(currentSize.width - uniform.size.width) > 0.5 ||
                fabs(currentSize.height - uniform.size.height) > 0.5) {
                ownedGlyph.image = uniform;
            }
        }
        BOOL selected = ERConnectivitySelectedForIdentifier(identifier);
        BOOL active = ERConnectivityActiveForIdentifier(identifier);
        BOOL available = ERConnectivityAvailableForIdentifier(identifier);
        if (usesBluetoothPackageGlyph) {
            UIView *packageGlyph = EREnsureConnectivityBluetoothPackageGlyph(oddPresentation, selected);
            if (ownedGlyph) {
                ownedGlyph.hidden = packageGlyph != nil;
                ownedGlyph.alpha = packageGlyph ? 0.0 : 1.0;
            }
            ERAlignConnectivityPackageGlyphForLayout(packageGlyph, size);
            if (packageGlyph) [oddPresentation bringSubviewToFront:packageGlyph];
        } else {
            UIView *packageGlyph = [oddPresentation viewWithTag:kERConnectivityBluetoothPackageGlyphTag];
            packageGlyph.hidden = YES;
            packageGlyph.alpha = 0.0;
            if (ownedGlyph) {
                ownedGlyph.hidden = NO;
                ownedGlyph.alpha = 1.0;
            }
        }
        NSNumber *previousSelected = objc_getAssociatedObject(module.view, kERConnectivitySelectedStateKey);
        BOOL animateState = previousSelected && previousSelected.boolValue != selected;
        objc_setAssociatedObject(module.view, kERConnectivitySelectedStateKey, @(selected), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        ERApplyOwnedCompactPresentationState(oddPresentation, identifier, selected, active, ERConnectivityAccentColorForIdentifier(identifier), animateState);
        ERApplyOwnedCompactPresentationAvailability(oddPresentation, available);
        ERSetConnectivitySelectedSurface(module, selected, available, ERConnectivityAccentColorForIdentifier(identifier), animateState);
        [module.view bringSubviewToFront:oddPresentation];
        if (gEditModeActive) ERDiagEditConnectivityModule(module);
        // 背景不变量：无论本函数因何种布局/玻璃状态分支结束，都重新断言连通性磁贴
        // 一定持有一块可见的系统材质底（关闭液态玻璃后 GlassKit 会移除唯一的玻璃层，
        // 这里把兜底毛玻璃重新挂上，避免磁贴变透明）。
        ERSyncConnectivityTileChrome(module.view);
        // 1.0.6-12（第 2 条）：白底在这一刻重新对齐到磁贴的最终几何。
        // 必须放在 ERSyncConnectivityTileChrome 之后 —— 那里才跑完材质/圆角断言，
        // moduleView.layer.cornerRadius 到这一步才是收敛值。
        ERReassertConnectivitySelectedSurface(module.view);
        // Edit-mode / relayout safety: guarantee the EchoReborn presentation stays
        // on screen regardless of any prior native-content hide pass or clip.
        // Guards the reported "部分 1x1 按钮在编辑模式不显示" symptom.
        oddPresentation.hidden = NO;
        oddPresentation.alpha = 1.0;
        UIControl *nativeControl = ERFirstConnectivityRoundButton(module.view);
        UIButton *proxy = (UIButton *)[module.view viewWithTag:kERConnectivityTileActionProxyTag];
        if (!proxy) {
            proxy = [ERConnectivityForceButton buttonWithType:UIButtonTypeCustom];
            proxy.tag = kERConnectivityTileActionProxyTag;
            proxy.backgroundColor = UIColor.clearColor;
            proxy.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
            id coordinator = ((id (*)(id, SEL))objc_msgSend)(NSClassFromString(@"EchoRebornCoordinator"), @selector(shared));
            [proxy addTarget:coordinator action:@selector(connectivityTileProxyTapped:) forControlEvents:UIControlEventTouchUpInside];
            [proxy addTarget:coordinator action:@selector(connectivityTileProxyTouchDown:) forControlEvents:UIControlEventTouchDown | UIControlEventTouchDragEnter];
            [proxy addTarget:coordinator action:@selector(connectivityTileProxyTouchUp:) forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside | UIControlEventTouchCancel | UIControlEventTouchDragExit];
            UILongPressGestureRecognizer *hold = [[UILongPressGestureRecognizer alloc] initWithTarget:coordinator action:@selector(connectivityTileProxyHeld:)];
            hold.minimumPressDuration = 0.45;
            [proxy addGestureRecognizer:hold];
            [module.view addSubview:proxy];
        }
        proxy.frame = module.view.bounds;
        proxy.hidden = gEditModeActive || gERExpandedModuleOpen;
        proxy.enabled = !gEditModeActive && !gERExpandedModuleOpen;
        objc_setAssociatedObject(proxy, kERConnectivityForwardControlKey, nativeControl, OBJC_ASSOCIATION_ASSIGN);
        objc_setAssociatedObject(proxy, kERConnectivityIdentifierKey, identifier, OBJC_ASSOCIATION_COPY_NONATOMIC);
        objc_setAssociatedObject(proxy, @selector(connectivityTileProxyTapped:), @(available), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [module.view bringSubviewToFront:proxy];
    } else if (ERShortcutIdentifierIsShortcut(identifier)) {
        if (ERShortcutSlotIndexFromIdentifier(identifier)) {
            // 槽位标识符（0.5.5+ 起）对应的是**真实的 Control Center 模块**：bundle
            // 自己的磁贴控制器把白色字形、名称与运行提示直接画在系统模块背景上。
            // 这个分支过去往模块上叠的东西 —— 深色材质底板（tag 181038）、承载快捷
            // 指令圆角图标的自绘紧凑呈现、以及点击代理 —— 全是 0.5.5 以前「自绘磁贴」
            // 的遗留。叠在真实模块上，正是「灰底 + 两个图标」的来源：一个图标来自
            // 自绘呈现，第二个来自底下真实磁贴；再加上一层压住系统背景的板。
            // 全部剥掉，让模块自己画；磁贴自身的点击目标经 ShortcutRunRequest +
            // WFSpringBoardWorkflowRunnerClient 运行快捷指令。
            //
            // 控制中心还会在容器里建一个原生的 CCUIButtonModuleView（圆形按钮：材质 +
            // 字形），它是 module.view 的**兄弟**，所以要在容器里找它。剥掉两者的遗留
            // 板与自绘呈现，再把原生按钮隐藏，只留下 bundle 自己的磁贴。
            UIView *stockButton = ERFindStockButtonForModuleView(module.view);
            for (UIView *target in @[module.view, stockButton]) {
                if (!target) continue;
                UIView *plate = [target viewWithTag:kERShortcutTileBackgroundTag];
                if (plate) [plate removeFromSuperview];
                UIView *owned = [target viewWithTag:kERResizePresentationTag];
                if (owned) [owned removeFromSuperview];
            }
            if (stockButton) stockButton.hidden = YES;
            // 容器把 toggle 模块的点击路由给 setSelected:（这里是空操作），于是 bundle
            // 自己的点击目标永远不触发 —— 这就是「点了没反应」。照连通性磁贴的做法，
            // 在最上层放一个透明代理，把点击交给运行路径。
            UIButton *slotProxy = (UIButton *)[module.view viewWithTag:kERShortcutTileActionProxyTag];
            if (!slotProxy) {
                slotProxy = [UIButton buttonWithType:UIButtonTypeCustom];
                slotProxy.tag = kERShortcutTileActionProxyTag;
                slotProxy.backgroundColor = UIColor.clearColor;
                slotProxy.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
                id coordinator = ((id (*)(id, SEL))objc_msgSend)(NSClassFromString(@"EchoRebornCoordinator"), @selector(shared));
                [slotProxy addTarget:coordinator action:@selector(shortcutTileProxyTapped:) forControlEvents:UIControlEventTouchUpInside];
                [module.view addSubview:slotProxy];
            }
            slotProxy.frame = module.view.bounds;
            slotProxy.hidden = gEditModeActive || gERExpandedModuleOpen;
            slotProxy.enabled = !gEditModeActive && !gERExpandedModuleOpen;
            objc_setAssociatedObject(slotProxy, kERConnectivityIdentifierKey, identifier, OBJC_ASSOCIATION_COPY_NONATOMIC);
            [module.view bringSubviewToFront:slotProxy];
            return;
        }
        if (expandedNow) {
            oddPresentation.hidden = YES;
            oddPresentation.alpha = 0.0;
            return;
        }
        // Shortcut tiles have no native module view; give them the same
        // module-material platter the rest of Control Center uses.
        UIView *tileBackground = [module.view viewWithTag:kERShortcutTileBackgroundTag];
        if (!tileBackground) {
            UIVisualEffectView *material = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemUltraThinMaterialDark]];
            material.tag = kERShortcutTileBackgroundTag;
            material.userInteractionEnabled = NO;
            material.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
            material.frame = module.view.bounds;
            [module.view insertSubview:material atIndex:0];
            tileBackground = material;
        }
        oddPresentation = EREnsureOwnedCompactPresentation(module.view);
        CCUILayoutSize size = EREffectiveCustomSizeForModule(module, identifier);
        NSDictionary *shortcut = ERShortcutForIdentifier(identifier);
        NSString *title = ([shortcut[@"name"] isKindOfClass:[NSString class]]) ? shortcut[@"name"] : @"快捷指令";
        ERLayoutOwnedCompactPresentation(oddPresentation, @"sparkles", title, @"轻点运行", size, NO);
        // Replace the placeholder SF Symbol with the shortcut's native icon
        // after the presentation layout pass (which resets the glyph image).
        UIImageView *ownedGlyph = (UIImageView *)[oddPresentation viewWithTag:kERResizePresentationGlyphTag];
        UIImage *icon = ERShortcutIconImage(shortcut);
        if (ownedGlyph) {
            if (icon) {
                ownedGlyph.image = icon;
                ownedGlyph.contentMode = UIViewContentModeScaleAspectFit;
                // A 1x1 tile shows the glyph alone; the two-cell presentations
                // carry a left-aligned title that needs the icon clear of it.
                CGFloat tileWidth = size.width * kERGridCellSize + (size.width > 1 ? (size.width - 1) * kERGridGap : 0.0);
                CGFloat tileHeight = size.height * kERGridCellSize + (size.height > 1 ? (size.height - 1) * kERGridGap : 0.0);
                CGFloat side = MIN(MIN(kERGridCellSize - 20.0, 44.0), MIN(tileWidth, tileHeight) - 14.0);
                if (side < 20.0) side = MAX(20.0, MIN(tileWidth, tileHeight) - 8.0);
                CGFloat originX = size.width > 1 ? 21.0 : (tileWidth - side) * 0.5;
                CGFloat originY = (tileHeight - side) * 0.5;
                ownedGlyph.frame = CGRectMake(round(originX), round(originY), side, side);
                ownedGlyph.layer.cornerRadius = side * 0.24;
                ownedGlyph.layer.cornerCurve = kCACornerCurveContinuous;
                ownedGlyph.layer.masksToBounds = YES;
                ownedGlyph.layer.borderWidth = 0.0;
            } else {
                ownedGlyph.image = nil;
            }
            ownedGlyph.hidden = NO;
            ownedGlyph.alpha = 1.0;
        }
        [module.view bringSubviewToFront:oddPresentation];
        UIButton *shortcutProxy = (UIButton *)[module.view viewWithTag:kERShortcutTileActionProxyTag];
        if (!shortcutProxy) {
            shortcutProxy = [UIButton buttonWithType:UIButtonTypeCustom];
            shortcutProxy.tag = kERShortcutTileActionProxyTag;
            shortcutProxy.backgroundColor = UIColor.clearColor;
            shortcutProxy.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
            id coordinator = ((id (*)(id, SEL))objc_msgSend)(NSClassFromString(@"EchoRebornCoordinator"), @selector(shared));
            [shortcutProxy addTarget:coordinator action:@selector(shortcutTileProxyTapped:) forControlEvents:UIControlEventTouchUpInside];
            [module.view addSubview:shortcutProxy];
        }
        shortcutProxy.frame = module.view.bounds;
        shortcutProxy.hidden = gEditModeActive || gERExpandedModuleOpen;
        shortcutProxy.enabled = !gEditModeActive && !gERExpandedModuleOpen;
        objc_setAssociatedObject(shortcutProxy, kERConnectivityIdentifierKey, identifier, OBJC_ASSOCIATION_COPY_NONATOMIC);
        module.view.accessibilityLabel = title;
        module.view.accessibilityHint = @"运行快捷指令";
        [module.view bringSubviewToFront:shortcutProxy];
    } else if (isTextSize) {
        if (expandedNow) {
            oddPresentation.hidden = YES;
            oddPresentation.alpha = 0.0;
            ERRestoreTextSizeNativeViews(module.view);
            return;
        }
        ERHideNativeTextSizeCompactViews(module.view);
        oddPresentation = EREnsureOwnedCompactPresentation(module.view);
        CCUILayoutSize size = EREffectiveCustomSizeForModule(module, identifier);
        NSString *value = ERTextSizeCompactValue(module.view);
        ERLayoutOwnedCompactPresentation(oddPresentation, @"textformat.size", @"Text Size", value, size, NO);
        [module.view bringSubviewToFront:oddPresentation];
    } else if ([identifier isEqualToString:@"com.mtac.ccpowermenu"]) {
        NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:module.view];
        while (queue.count) {
            UIView *candidate = queue.firstObject;
            [queue removeObjectAtIndex:0];
            if ([candidate isKindOfClass:[UIActivityIndicatorView class]]) {
                candidate.hidden = YES;
                candidate.alpha = 0.0;
            }
            [queue addObjectsFromArray:candidate.subviews];
        }
    } else if ([identifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"]) {
        // 0.5.10: 音乐模块必须走自己的布局，绝不能落进下面那条通用分支。
        //
        // 通用分支的判据是「比自然尺寸小就算被缩小」：
        //     shrunk = size.width < natural.width || size.height < natural.height
        // 音乐模块的自然尺寸是 2x2，改成 4x1 时高度从 2 变成 1，于是 shrunk = YES，
        // EchoReborn 把整块原生正在播放界面隐藏掉、换上一个纯图标磁贴——用户看到的
        // 就是「松手之后显示异常 / 直接空白不可见」。而且这个状态会一直留着，
        // 只有注销重登（重建模块）才恢复，和报的现象完全吻合。
        //
        // 实际上音乐模块有自己完整的 compact / wide1 / wide2 / wide4 四套布局
        // （ERConfigureNowPlayingLayout），4x1 是受支持的尺寸，不需要接管。
        ERRemoveShrunkModulePresentation(module);
        if (oddPresentation) [oddPresentation removeFromSuperview];
        ERSetModuleNativeContentHidden(module.view, NO);
        [UIView performWithoutAnimation:^{
            module.view.hidden = NO;
            module.view.alpha = 1.0;
            module.view.layer.opacity = 1.0;
        }];
        UIView *npView = ERFindSubviewWithClassName(module.view, @"MRUNowPlayingView");
        if (npView) {
            // 丢掉可能残留的旧模式，让 ERConfigureNowPlayingLayout 按当前尺寸重算。
            objc_setAssociatedObject(npView, kERNowPlayingLayoutModeKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
            // 0.5.11: 只用 setNeedsLayout，**不要**在这里调 layoutIfNeeded。
            // 本函数本身就在布局回调里被调用，同步强制子视图布局会和
            // MRUNowPlayingView 的 layoutSubviews hook（它也会调
            // ERConfigureNowPlayingLayout）形成布局反馈回环。
            [npView setNeedsLayout];
            ERConfigureNowPlayingLayout(npView);
        }
        CCUILayoutSize mediaSize = EREffectiveCustomSizeForModule(module, identifier);
        ERLogModuleState(identifier, (CCUILayoutSize){2, 2}, mediaSize, @"nowplaying-native");
        // 只在结论变化时记一行，避免布局刷新把日志淹掉。
        static const void *kERMediaFixLogKey = &kERMediaFixLogKey;
        NSString *mediaState = [NSString stringWithFormat:@"%lux%lu np=%d mode=%@",
                                (unsigned long)mediaSize.width, (unsigned long)mediaSize.height,
                                npView ? 1 : 0,
                                npView ? (objc_getAssociatedObject(npView, kERNowPlayingLayoutModeKey) ?: @"(nil)") : @"(none)"];
        if (![objc_getAssociatedObject(module.view, kERMediaFixLogKey) isEqual:mediaState]) {
            objc_setAssociatedObject(module.view, kERMediaFixLogKey, mediaState, OBJC_ASSOCIATION_COPY_NONATOMIC);
            ERLogInfo(@"MEDIAFIX ver=1.0.9-103 id=%@ %@", identifier, mediaState);
        }
    } else {
        // Every other module EchoReborn has no bespoke presentation for. Left
        // alone while it is shown at its natural size; taken over with the
        // glyph-only presentation whenever the user shrinks it, because the
        // native content would otherwise be cropped by the smaller frame.
        if (expandedNow) {
            oddPresentation.hidden = YES;
            oddPresentation.alpha = 0.0;
            ERRemoveShrunkModulePresentation(module);
            return;
        }
        CCUILayoutSize size = EREffectiveCustomSizeForModule(module, identifier);
        CCUILayoutSize natural = ERNaturalSizeForIdentifier(identifier, module);
        BOOL shrunk = (size.width < natural.width) || (size.height < natural.height);
        ERLogModuleState(identifier, natural, size, shrunk ? @"compact-glyph" : @"native");
        if (shrunk) {
            ERApplyShrunkModulePresentation(module, identifier, size);
        } else {
            ERRemoveShrunkModulePresentation(module);
            if (oddPresentation && !ERFindSubviewWithClassName(module.view, @"CCUIButtonModuleView")) [oddPresentation removeFromSuperview];
        }
    }
}

static NSArray<UIView *> *ERCompactGlyphHosts(UIView *buttonView) {
    if (!buttonView) return @[];
    NSMutableArray<UIView *> *glyphHosts = [NSMutableArray array];
    for (NSString *key in @[@"glyphImageView", @"_glyphImageView", @"glyphPackageView", @"_glyphPackageView"]) {
        @try {
            id candidate = [(id)buttonView valueForKey:key];
            if ([candidate isKindOfClass:[UIView class]] && ![glyphHosts containsObject:candidate]) [glyphHosts addObject:candidate];
        } @catch (__unused NSException *exception) {}
    }
    for (UIView *candidate in buttonView.subviews) {
        NSString *className = NSStringFromClass(candidate.class);
        if (([className isEqualToString:@"CCUICAPackageView"] || [candidate isKindOfClass:[UIImageView class]]) && ![glyphHosts containsObject:candidate]) {
            [glyphHosts addObject:candidate];
        }
    }
    return glyphHosts;
}

static void ERBeginResizeGlyphHandoff(UIView *moduleView, UIView *buttonView, UIView *stableHost) {
    if (!moduleView || !buttonView || !stableHost || objc_getAssociatedObject(moduleView, kERResizeGlyphHandoffViewKey)) return;
    NSArray<UIView *> *glyphHosts = ERCompactGlyphHosts(buttonView);
    if (!glyphHosts.count) return;

    UIView *handoff = [[UIView alloc] initWithFrame:stableHost.bounds];
    handoff.userInteractionEnabled = NO;
    handoff.backgroundColor = UIColor.clearColor;
    handoff.clipsToBounds = NO;
    NSMutableArray<NSDictionary *> *hostStates = [NSMutableArray array];
    for (UIView *glyph in glyphHosts) {
        [hostStates addObject:@{@"view": glyph, @"hidden": @(glyph.hidden)}];
        if (!glyph.hidden && glyph.alpha > 0.01 && glyph.window) {
            UIView *snapshot = [glyph snapshotViewAfterScreenUpdates:NO];
            if (snapshot) {
                snapshot.frame = [glyph convertRect:glyph.bounds toView:stableHost];
                [handoff addSubview:snapshot];
            }
        }
    }
    if (!handoff.subviews.count) return;

    [stableHost addSubview:handoff];
    objc_setAssociatedObject(moduleView, kERResizeGlyphHandoffViewKey, handoff, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(moduleView, kERResizeGlyphHandoffHostsKey, hostStates, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [UIView performWithoutAnimation:^{
        for (NSDictionary *state in hostStates) ((UIView *)state[@"view"]).hidden = YES;
    }];
}

static void EREndResizeGlyphHandoff(UIView *moduleView) {
    if (!moduleView) return;
    UIView *handoff = objc_getAssociatedObject(moduleView, kERResizeGlyphHandoffViewKey);
    NSArray<NSDictionary *> *hostStates = objc_getAssociatedObject(moduleView, kERResizeGlyphHandoffHostsKey);
    [UIView performWithoutAnimation:^{
        for (NSDictionary *state in hostStates) ((UIView *)state[@"view"]).hidden = [state[@"hidden"] boolValue];
        [handoff removeFromSuperview];
    }];
    objc_setAssociatedObject(moduleView, kERResizeGlyphHandoffViewKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(moduleView, kERResizeGlyphHandoffHostsKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

static BOOL ERLogicalRectsOverlap(CCUILayoutRect a, CCUILayoutRect b) {
    BOOL xOverlap = a.origin.x < b.origin.x + b.size.width && b.origin.x < a.origin.x + a.size.width;
    BOOL yOverlap = a.origin.y < b.origin.y + b.size.height && b.origin.y < a.origin.y + a.size.height;
    return xOverlap && yOverlap;
}

static BOOL ERLogicalRectRespectsColumnBands(CCUILayoutRect rect) {
    // iOS 18's grid behaves like two visual lanes: columns 1-2 and 3-4. Small
    // modules may live in either lane, but a two-wide module must not straddle
    // the gutter between columns 2 and 3. Full-width layouts are exempt.
    if (rect.size.width > 2) return rect.origin.x == 0 && rect.size.width <= 4;
    return !(rect.origin.x < 2 && rect.origin.x + rect.size.width > 2);
}

static BOOL ERPagedRectIsValid(CCUILayoutRect rect) {
    if (!rect.size.width || !rect.size.height || rect.origin.x + rect.size.width > 4 || rect.size.height > kERMinimumGridRows) return NO;
    if (!ERLogicalRectRespectsColumnBands(rect)) return NO;
    NSUInteger localRow = rect.origin.y % kERMinimumGridRows;
    return localRow + rect.size.height <= kERMinimumGridRows;
}

static BOOL ERPagedRectFits(NSString *identifier, CCUILayoutRect rect, NSDictionary<NSString *, NSValue *> *layout) {
    if (!ERPagedRectIsValid(rect)) return NO;
    for (NSString *otherIdentifier in layout) {
        if ([otherIdentifier isEqualToString:identifier]) continue;
        CCUILayoutRect other = {};
        [layout[otherIdentifier] getValue:&other];
        if (ERLogicalRectsOverlap(rect, other)) return NO;
    }
    return YES;
}

static BOOL ERFindPagedSlot(NSString *identifier, CCUILayoutSize size, NSUInteger startPage, NSDictionary<NSString *, NSValue *> *layout, CCUILayoutPoint *destination) {
    NSUInteger pageLimit = MIN(kERMaxPages, MAX(startPage + 2, layout.count + 2));
    for (NSUInteger page = startPage; page < pageLimit; page++) {
        NSUInteger pageStart = page * kERMinimumGridRows;
        for (NSUInteger localRow = 0; localRow + size.height <= kERMinimumGridRows; localRow++) {
            for (NSUInteger column = 0; column + size.width <= 4; column++) {
                CCUILayoutRect candidate = {(CCUILayoutPoint){column, pageStart + localRow}, size};
                if (ERPagedRectFits(identifier, candidate, layout)) {
                    if (destination) *destination = candidate.origin;
                    return YES;
                }
            }
        }
    }
    return NO;
}

static NSUInteger ERPageForRect(CCUILayoutRect rect) {
    return rect.origin.y / kERMinimumGridRows;
}

// Like ERFindPagedSlot, but guaranteed to return a destination. A module must
// never be dropped from the layout just because its preferred neighbourhood is
// full: an unplaced control silently vanishes from every page and leaves its
// stale rect free to collide with whatever lands on top of it. When no clean
// slot exists near startPage we widen the search to every page, then fall back
// to a fresh page. A rare, self-healing extra page is always preferable to a
// disappeared control (and to the inconsistent layout that can abort a present).
static BOOL ERGuaranteedPagedSlot(NSString *identifier, CCUILayoutSize size, NSUInteger startPage, NSDictionary<NSString *, NSValue *> *layout, CCUILayoutPoint *destination) {
    CCUILayoutSize clamped = size;
    if (clamped.width == 0) clamped.width = 1;
    if (clamped.height == 0) clamped.height = 1;
    if (clamped.width > 4) clamped.width = 4;
    if (clamped.height > kERMinimumGridRows) clamped.height = kERMinimumGridRows;
    if (ERFindPagedSlot(identifier, clamped, startPage, layout, destination)) return YES;
    if (startPage != 0 && ERFindPagedSlot(identifier, clamped, 0, layout, destination)) return YES;
    NSUInteger highestOccupiedPage = 0;
    for (NSString *other in layout) {
        if ([other isEqualToString:identifier]) continue;
        CCUILayoutRect rect = {};
        [layout[other] getValue:&rect];
        highestOccupiedPage = MAX(highestOccupiedPage, ERPageForRect(rect));
    }
    for (NSUInteger page = highestOccupiedPage + 1; page < kERMaxPages; page++) {
        if (ERFindPagedSlot(identifier, clamped, page, layout, destination)) return YES;
    }
    // Absolute last resort: the top-left of the final page. Only reachable if
    // every one of the ~288 cells is occupied, which the page cap makes
    // impossible in practice; kept so the function is total by construction.
    if (destination) *destination = (CCUILayoutPoint){0, (kERMaxPages - 1) * kERMinimumGridRows};
    return YES;
}

// A page owned by a single module gets a themed scrubber indicator (music
// note for now playing, cellular glyph for connectivity). Returns nil when
// the page holds anything else so the caller falls back to the plain dot.
static NSString *ERThemedPageIndicatorSymbolForPage(NSUInteger page) {
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    if (!overlay) return nil;
    NSString *soleIdentifier = nil;
    NSUInteger moduleCount = 0;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *identifier = ERModuleIdentifier(module);
        NSValue *value = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!value) continue;
        CCUILayoutRect rect = {};
        [value getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *size = gERCustomSizes[identifier];
        if (size.count >= 2) rect.size = (CCUILayoutSize){size[0].unsignedIntegerValue, size[1].unsignedIntegerValue};
        if (!ERPagedRectIsValid(rect) || ERPageForRect(rect) != page) continue;
        moduleCount++;
        if (moduleCount > 1) return nil;
        soleIdentifier = identifier;
    }
    if (moduleCount != 1) return nil;
    if ([soleIdentifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"]) return @"music.note";
    if ([soleIdentifier isEqualToString:@"com.apple.control-center.ConnectivityModule"]) return @"antenna.radiowaves.left.and.right";
    return nil;
}

static BOOL ERLogicalRectFits(NSString *identifier, CCUILayoutRect rect, NSDictionary<NSString *, NSValue *> *layout, NSUInteger maxRows) {
    if (rect.size.width == 0 || rect.size.height == 0 || rect.origin.x + rect.size.width > 4 || rect.origin.y + rect.size.height > maxRows) return NO;
    if (!ERLogicalRectRespectsColumnBands(rect)) return NO;
    for (NSString *otherIdentifier in layout) {
        if ([otherIdentifier isEqualToString:identifier]) continue;
        CCUILayoutRect other = {};
        [layout[otherIdentifier] getValue:&other];
        if (ERLogicalRectsOverlap(rect, other)) return NO;
    }
    return YES;
}

static BOOL ERLogicalLayoutIsLegal(NSDictionary<NSString *, NSValue *> *layout, NSUInteger maxRows) {
    NSArray<NSString *> *identifiers = layout.allKeys;
    for (NSUInteger first = 0; first < identifiers.count; first++) {
        CCUILayoutRect a = {};
        [layout[identifiers[first]] getValue:&a];
        if (a.size.width == 0 || a.size.height == 0 || a.origin.x + a.size.width > 4 || a.origin.y + a.size.height > maxRows) return NO;
        if (!ERLogicalRectRespectsColumnBands(a)) return NO;
        for (NSUInteger second = first + 1; second < identifiers.count; second++) {
            CCUILayoutRect b = {};
            [layout[identifiers[second]] getValue:&b];
            if (ERLogicalRectsOverlap(a, b)) return NO;
        }
    }
    return YES;
}

static NSMutableDictionary<NSString *, NSValue *> *ERLayoutForPage(UIViewController *overlay, NSUInteger page, NSUInteger maxRows) {
    NSMutableDictionary<NSString *, NSValue *> *layout = [NSMutableDictionary dictionary];
    NSUInteger pageStart = page * kERMinimumGridRows;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *identifier = ERModuleIdentifier(module);
        NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!nativeValue) continue;
        CCUILayoutRect rect = {};
        [nativeValue getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *size = gERCustomSizes[identifier];
        if (size.count >= 2) rect.size = (CCUILayoutSize){size[0].unsignedIntegerValue, size[1].unsignedIntegerValue};
        if (rect.origin.y < pageStart || rect.origin.y >= pageStart + maxRows) continue;
        rect.origin.y -= pageStart;
        if (rect.origin.x + rect.size.width > 4 || rect.origin.y + rect.size.height > maxRows) continue;
        layout[identifier] = [NSValue value:&rect withObjCType:@encode(CCUILayoutRect)];
    }
    return layout;
}

static NSMutableDictionary<NSString *, NSValue *> *ERCurrentPageLayout(UIViewController *overlay, NSUInteger maxRows) {
    return ERLayoutForPage(overlay, gERCurrentPage, maxRows);
}

static NSUInteger ERDerivedVisiblePageForOverlay(UIViewController *overlay) {
    if (!overlay.view) return MIN(gERCurrentPage, MAX((NSUInteger)1, gERPageCount) - 1);
    NSMutableDictionary<NSNumber *, NSNumber *> *scores = [NSMutableDictionary dictionary];
    CGRect overlayBounds = overlay.view.bounds;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        if (!module.view || module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
        NSString *identifier = ERModuleIdentifier(module);
        NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!nativeValue) continue;
        CCUILayoutRect rect = {};
        [nativeValue getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSUInteger page = ERPageForRect(rect);
        CGRect visibleFrame = [module.view convertRect:module.view.bounds toView:overlay.view];
        if (CGRectIsEmpty(CGRectIntersection(visibleFrame, overlayBounds))) continue;
        NSNumber *key = @(page);
        scores[key] = @([scores[key] unsignedIntegerValue] + 1);
    }
    NSNumber *bestPage = nil;
    NSUInteger bestScore = 0;
    for (NSNumber *page in scores) {
        NSUInteger score = scores[page].unsignedIntegerValue;
        if (!bestPage || score > bestScore) {
            bestPage = page;
            bestScore = score;
        }
    }
    if (bestPage) return MIN(bestPage.unsignedIntegerValue, MAX((NSUInteger)1, gERPageCount) - 1);
    return MIN(gERCurrentPage, MAX((NSUInteger)1, gERPageCount) - 1);
}

@interface ERExtendedModuleHitBridge : UIView
@property (nonatomic, weak) UIViewController *overlay;
@end

@implementation ERExtendedModuleHitBridge
- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    if (!gEnabled || !gERControlCenterPresented || gEditModeActive || gERExpandedModuleOpen || !self.overlay) return nil;
    UIView *quickAccessHost = [self.overlay.view viewWithTag:181000];
    if (quickAccessHost && !quickAccessHost.hidden && quickAccessHost.alpha > 0.05) {
        for (UIView *candidate in quickAccessHost.subviews) {
            if (![candidate isKindOfClass:[UIControl class]] || candidate.hidden || candidate.alpha <= 0.05) continue;
            CGRect frame = [candidate convertRect:candidate.bounds toView:self];
            if (!CGRectContainsPoint(frame, point)) continue;
            CGPoint controlPoint = [self convertPoint:point toView:candidate];
            return [candidate hitTest:controlPoint withEvent:event] ?: candidate;
        }
    }
    for (UIViewController *module in ERCollectModuleControllers(self.overlay)) {
        if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
        CGRect frame = ERVisibleModuleFrame(module, self.overlay);
        if (!CGRectContainsPoint(frame, point)) continue;
        CGPoint modulePoint = [self convertPoint:point toView:module.view];
        return [module.view hitTest:modulePoint withEvent:event] ?: module.view;
    }
    return nil;
}
@end


