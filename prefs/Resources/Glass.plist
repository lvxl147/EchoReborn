<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>边缘高光</string><key>defaults</key><string>com.strive.echoreborn.preferences</string><key>key</key><string>ControlCenter.SpecularEnabled</string><key>default</key><true/><key>PostNotification</key><string>com.strive.echoreborn/ReloadPrefs</string></dict>
