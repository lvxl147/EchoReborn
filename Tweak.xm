#pragma mark - ① 锁屏快捷按钮（手电筒 / 相机）

static void *kQAGlassKey = &kQAGlassKey;
static void *kQABackdropKey = &kQABackdropKey;
static void *kQABackdropAlphaKey = &kQABackdropAlphaKey;
static NSHashTable<UIVisualEffectView *> *sQuickActionHosts;
static void removeQuickActionsGlass(UIVisualEffectView *fx);

static UIView *qaBackdropView(UIView *effectView) {
    for (UIView *sub in effectView.subviews) {
        if ([sub isKindOfClass:[LGLiveBackdropView class]]) continue;
        if ([NSStringFromClass(sub.class) containsString:@"Backdrop"]) return sub;
        for (UIView *inner in sub.subviews) {
            if ([inner isKindOfClass:[LGLiveBackdropView class]]) continue;
            if ([NSStringFromClass(inner.class) containsString:@"Backdrop"]) return inner;
        }
    }
    return nil;
}

static void qaSetBackdropHidden(UIVisualEffectView *effectView) {
    // 1.0.9-53 · **不再把原生 backdrop 的 alpha 置 0**。
    //
    // 你的反馈：装完后「锁屏按钮透明」（= 按钮看不见）。原因就是这里：上游把系统材质
    // 隐藏掉，让玻璃层取而代之 —— 但如果玻璃渲染没有生效（需要主开关 + 注销），
    // 玻璃层就是空的，净效果变成"完全透明"。
    //
    // 现在改为**保留系统材质**，玻璃层叠在它上面：
    //   · 玻璃生效 → 呈现玻璃效果（覆盖系统材质）
    //   · 玻璃未生效 → 至少还是原来的样子，不会变成一片透明
    // 只记录原始 alpha（供将来需要恢复隐藏行为时使用），不做修改。
    UIView *backdrop = qaBackdropView(effectView);
    if (!backdrop) return;
    if (!objc_getAssociatedObject(effectView, kQABackdropAlphaKey)) {
        objc_setAssociatedObject(effectView, kQABackdropKey, backdrop, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(effectView, kQABackdropAlphaKey, @(backdrop.alpha), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    // 刻意不修改 backdrop.alpha
}

static BOOL isQuickActionsHost(UIView *view) {
    if (![view isKindOfClass:[UIVisualEffectView class]] || !view.window) return NO;
    if (view.window.safeAreaInsets.bottom <= 0.0) return NO;
    Class qaCls = NSClassFromString(@"CSQuickActionsButton");
    for (UIView *a = view.superview; a; a = a.superview) {
        if (qaCls && [a isKindOfClass:qaCls]) return YES;
        if ([a isKindOfClass:[UIVisualEffectView class]]) return NO;
    }
    return NO;
}

static void injectQuickActionsGlass(UIVisualEffectView *fx) {
    if (!ERGlassSwitchEnabled(@"QuickActions.Enabled")) {
        removeQuickActionsGlass(fx);
        return;
    }
    UIView *container = fx.contentView;
    if (CGRectGetWidth(container.bounds) < 4.0 || CGRectGetHeight(container.bounds) < 4.0) return;
    qaSetBackdropHidden(fx);
    if (@available(iOS 13.0, *)) {
        fx.overrideUserInterfaceStyle        = UIUserInterfaceStyleLight;
        container.overrideUserInterfaceStyle = UIUserInterfaceStyleLight;
    }
    LGLiveBackdropView *glass = objc_getAssociatedObject(fx, kQAGlassKey);
    if (!glass) {
        glass = LGCreateRegisteredGlass(container.bounds, nil, @"QuickActions");
        if (!glass) return;
        glass.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        [container insertSubview:glass atIndex:0];
        objc_setAssociatedObject(fx, kQAGlassKey, glass, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (glass.superview != container) [container insertSubview:glass atIndex:0];
    glass.frame               = container.bounds;
    glass.layer.cornerRadius  = fmin(CGRectGetWidth(container.bounds), CGRectGetHeight(container.bounds)) * 0.5;
    glass.layer.cornerCurve   = kCACornerCurveContinuous;
    glass.layer.masksToBounds = YES;
    [glass applyFilters];
    if (!sQuickActionHosts) sQuickActionHosts = [NSHashTable weakObjectsHashTable];
    [sQuickActionHosts addObject:fx];
    lgTrackGlass(glass, @"QuickActions", nil);
}

static void removeQuickActionsGlass(UIVisualEffectView *fx) {
    LGLiveBackdropView *glass = objc_getAssociatedObject(fx, kQAGlassKey);
    if (@available(iOS 13.0, *)) {
        fx.overrideUserInterfaceStyle             = UIUserInterfaceStyleUnspecified;
        fx.contentView.overrideUserInterfaceStyle = UIUserInterfaceStyleUnspecified;
    }
    UIView *backdrop = objc_getAssociatedObject(fx, kQABackdropKey);
    NSNumber *alpha = objc_getAssociatedObject(fx, kQABackdropAlphaKey);
    if (backdrop && alpha) backdrop.alpha = alpha.doubleValue;
    objc_setAssociatedObject(fx, kQABackdropKey, nil, OBJC_ASSOCIATION_ASSIGN);
    objc_setAssociatedObject(fx, kQABackdropAlphaKey, nil, OBJC_ASSOCIATION_ASSIGN);
    if (glass) {
        [glass removeFromSuperview];
        objc_setAssociatedObject(fx, kQAGlassKey, nil, OBJC_ASSOCIATION_ASSIGN);
    }
    [sQuickActionHosts removeObject:fx];
}

static void LGReconcileQuickActionHosts(void) {
    for (UIVisualEffectView *host in sQuickActionHosts.allObjects) {
        if (ERGlassSwitchEnabled(@"QuickActions.Enabled")) injectQuickActionsGlass(host);
        else removeQuickActionsGlass(host);
    }
}


#pragma mark - ③ 灵动岛（Liquidify 复刻）—— 目标类取自上游字符串表

// Logos 需要完整类声明（否则 self.window/self.class 在 forward class 上不可用）
@interface SBSystemApertureWindow : UIWindow
@end

// 读字符串偏好（Liquidify 渐变色等；域与 GlassKit 一致）
static NSString *ERPreferenceStringFor(NSString *key) {
    if (!key.length) return nil;
    CFPropertyListRef v = CFPreferencesCopyAppValue((__bridge CFStringRef)key,
                                                    CFSTR("com.strive.echoreborn.preferences"));
    NSString *out = nil;
    if (v) {
        if (CFGetTypeID(v) == CFStringGetTypeID()) out = [(__bridge NSString *)v copy];
        CFRelease(v);
    }
    return out;
}

// 上游特征：SBSystemApertureWindow 是灵动岛所在窗口；_SBUISystemApertureCAPackageView
// 是主视图。我们对**窗口**做 layoutSubviews 钩子，在其子树里找"最外层的圆角容器"加玻璃，
// 这样不依赖具体子类在 iOS 17 是否还在（窗口类稳定得多）。
// 渐变：按上游的 5 色渐变（LiquidifyApertureGradientColor1..5）做一层 CAGradientLayer 叠加；
//       字体颜色模式 native/gradient/solid 影响文字层（后续批），本批先做玻璃+渐变+隐藏。

static void *kERDIGlassKey = &kERDIGlassKey;
static void *kERDIGradientKey = &kERDIGradientKey;
static void *kERDIGlowKey = &kERDIGlowKey;   // 1.0.9-103 · 渐变阴影（辉光层）

static BOOL ERDIEnabled(void) { return ERGlassSwitchEnabled(@"LiquidifyDynamicIslandLiquidGlassEnabled"); } // 1.0.9-103 · 去掉总开关；液态玻璃直接成为 DI 玻璃门控（打开液态玻璃=给灵动岛加玻璃）
static BOOL ERDIHideEnabled(void) { return ERGlassSwitchEnabled(@"LiquidifyHideDynamicIslandEnabled"); }

// 1.0.9-103 · **空闲判定**（修复 1.0.9-57"把所有灵动岛都隐藏"的 bug）：
//   隐藏灵动岛 = 仅当系统岛**无活动元素**时才收起成原生感叹号 Pill；
//   有活动（计时/音乐/通话/录屏/导航…）→ 视为使用中，绝不收起。
//   判定来源：SBSystemApertureController 的 attachedElementIdentifiers
//   （空闲时集合为空，有活动时非空）。拿不到控制器时保守返回「非空闲」，
//   绝不误隐藏使用中的灵动岛。
static id ERSBSystemApertureController(UIWindow *win) {
    @try {
        Class cls = NSClassFromString(@"SBSystemApertureController");
        if (cls && [cls respondsToSelector:@selector(sharedInstance)]) {
            id c = [cls performSelector:@selector(sharedInstance)];
            if (c) return c;
        }
        if (win) {
            id scene = [win valueForKey:@"windowScene"];
            for (NSString *k in @[@"systemApertureController", @"apertureController"]) {
                @try { id c = [scene valueForKey:k]; if (c) return c; } @catch (__unused NSException *e) {}
            }
            for (NSString *k in @[@"systemApertureController", @"apertureController"]) {
                @try { id c = [win valueForKey:k]; if (c) return c; } @catch (__unused NSException *e) {}
            }
        }
    } @catch (__unused NSException *e) {}
    return nil;
}

static BOOL ERDIisIdle(UIWindow *win) {
    id ctrl = ERSBSystemApertureController(win);
    if (ctrl) {
        NSArray *attached = nil;
        @try {
            // 经 performSelector 取（避免对 id 直接发未知 selector 触发编译错误）
            if ([ctrl respondsToSelector:@selector(attachedElementIdentifiers)])
                attached = [ctrl performSelector:@selector(attachedElementIdentifiers)];
            else
                attached = [ctrl valueForKey:@"attachedElementIdentifiers"];
        } @catch (__unused NSException *e) {}
        if (attached && [(NSArray *)attached count] > 0) return NO;
        for (NSString *k in @[@"elementContexts", @"presentedElementIdentifiers", @"attachedElementContexts"]) {
            @try {
                id v = [ctrl valueForKey:k];
                if (v && [v respondsToSelector:@selector(count)] && [(NSArray *)v count] > 0) return NO;
            } @catch (__unused NSException *e) {}
        }
        return YES;
    }
    static BOOL loggedNoCtrl = NO;
    if (!loggedNoCtrl) { loggedNoCtrl = YES; ERLogInfo(@"DI-IDLE 未取到 SBSystemApertureController（保守：视为使用中，不隐藏）"); }
    return NO; // 控制器不可用 → 保守：视为使用中，绝不误隐藏
}

static NSArray<UIColor *> *ERDIGradientColors(void) {
    NSMutableArray<UIColor *> *colors = [NSMutableArray array];
    for (NSUInteger i = 1; i <= 5; i++) {
        NSString *hex = ERPreferenceStringFor([NSString stringWithFormat:@"LiquidifyApertureGradientColor%lu", (unsigned long)i]);
        if (!hex.length) continue;
        NSString *h = [hex stringByReplacingOccurrencesOfString:@"#" withString:@""];
        if (h.length != 6) continue;
        unsigned v = 0;
        [[NSScanner scannerWithString:h] scanHexInt:&v];
        [colors addObject:[UIColor colorWithRed:((v >> 16) & 0xFF) / 255.0
                                          green:((v >> 8) & 0xFF) / 255.0
                                           blue:(v & 0xFF) / 255.0
                                          alpha:1.0]];
    }
    return colors;
}

static void ERApplyDynamicIslandGlass(UIWindow *win) {
    // 1.0.9-93 · **隐藏灵动岛 = 独立功能**（"不使用时收起"），与玻璃互不干扰：
    //   隐藏开 → 只隐藏窗口，**绝不创建玻璃**（也不再走后面的查找/创建流程）
    //   隐藏关 → 恢复显示；玻璃是否创建由【灵动岛】开关决定
    // 1.0.9-103 · **隐藏与玻璃解耦**：隐藏只在【空闲】时收起；使用中不收起、且照常建玻璃。
    if (ERDIHideEnabled()) {
        if (!win) return;
        if (ERDIisIdle(win)) {
            if (!win.hidden) { win.hidden = YES; ERLogInfo(@"DI-HIDE 空闲→收起灵动岛(感叹号 Pill)"); }
            return;   // 空闲+隐藏：收起，不建玻璃
        }
        if (win.hidden) { win.hidden = NO; ERLogInfo(@"DI-HIDE 使用中→恢复正常系统状态"); }
        // 使用中：继续往下 → 建玻璃
    }
    if (!ERDIEnabled()) {
        LGLiveBackdropView *g = objc_getAssociatedObject(win, kERDIGlassKey);
        if (g) g.hidden = YES;
        CAGradientLayer *gr = objc_getAssociatedObject(win, kERDIGradientKey);
        if (gr) gr.hidden = YES;
        UIView *gl = objc_getAssociatedObject(win, kERDIGlowKey);
        if (gl) gl.hidden = YES;
        return;
    }
    // 1.0.9-103 · 删除无条件的「隐藏分支」——它正是 1.0.9-57「隐藏所有灵动岛」bug 的根源
    //           （隐藏逻辑已统一上移，并改为仅空闲时收起）。

    // 1.0.9-58 · **收紧目标选择**：只认"胶囊形"的那块视图（灵动岛本体），
    // 1.0.9-57 用"面积最大的子视图"会选中整个覆盖层/全屏容器 → 玻璃铺满 → 画面被盖住，
    // 这正是"完全看不见灵动岛"的原因。现在：
    //   候选条件 = 宽 50~320 且 高 20~80 且 宽高比 > 1.6（横向胶囊）
    //   只取其中面积最大的一个
    // 找不到合适候选就**什么都不做**（宁可没有玻璃效果，也不能破坏灵动岛显示）。
    // 1.0.9-68 · **递归遍历整个子树**（逆向发现：灵动岛窗口是 430×932 的**全屏窗口**，
    // 胶囊在更深的层级里；之前只看 win.subviews 自然找不到 → 表现为"没有任何效果"）。
    // 1.0.9-69 · **照上游判定**（逆向结果）：
    //   上游 `Liquidify.dylib` 的符号/字符串表里有：`SBSystemApertureWindow`、
    //   `SBUISystemApertureCAPackageButton`、**`BSUICAPackageView`**，以及 `SystemAperture`、
    //   `DynamicIsland` 两个判定用字符串 —— 说明它是**按类名/父链包含这些关键词**来定位的，
    //   **不是**按尺寸猜（我之前按"宽高像胶囊"判定是自己发明的，所以总找不到目标）。
    // 1.0.9-103 · **修正目标查找根因**：
    //   旧逻辑遍历从 `win`(SBSystemApertureWindow) 自身起步，它类名含 "Aperture" 且面积
    //   430×932 最大 → `root` 永远等于窗口自身 → 后面 `root != win` 恒假 → 跳过坐标换算、
    //   走兜底小框且采样源是整个窗口 → 玻璃几乎不可见（你报的"看不出来，有什么变化"）。
    //   修正：① 排除窗口自身及任何 UIWindow；② 候选类 = 含 DynamicIsland / CAPackageView /
    //   含 Aperture 但不含 Window；③ 在候选里取**面积最小且 ≥1500** 的那个（灵动岛本体约
    //   125×37≈4625，远小于中间容器；用"最小"而非"最大"才能穿透到真正的胶囊内容视图，
    //   与 1.0.9-62 设备日志里 `_SBUISystemApertureCAPackageView=有` 的取证一致）。
    __block UIView *root = nil;
    __block UIView *exactCapsule = nil;   // 1.0.9-103 · 精确类名优先（比面积启发式可靠）
    __block CGFloat bestArea = CGFLOAT_MAX;
    NSMutableArray<UIView *> *stack = [NSMutableArray arrayWithArray:win.subviews];
    NSInteger guardCount = 0;
    while (stack.count && guardCount++ < 6000) {
        UIView *v = stack.lastObject;
        [stack removeLastObject];
        if ([v isKindOfClass:[UIWindow class]]) continue;
        NSString *cn = NSStringFromClass(v.class);
        // 1.0.9-103 · 收紧：必须含 Aperture / DynamicIsland；**不再接受通用 CAPackageView**
        //   （CCUICAPackageView / MRUCAPackageView / BSUICAPackageView 都是控制中心/媒体图标，
        //    之前就是被它们抢先命中，玻璃加到了控制中心图标上）
        BOOL isCapsule = [cn containsString:@"DynamicIsland"] ||
                         ([cn containsString:@"Aperture"] && ![cn containsString:@"Window"]);
        if (isCapsule) {
            CGRect b = v.bounds;
            CGFloat area = CGRectGetWidth(b) * CGRectGetHeight(b);
            if (area >= 1500.0 && area < bestArea) { bestArea = area; root = v; }
            if (!exactCapsule && [cn isEqualToString:@"_SBUISystemApertureCAPackageView"] && area >= 1500.0) {
                exactCapsule = v;
            }
        }
        [stack addObjectsFromArray:v.subviews];
    }
    if (exactCapsule) root = exactCapsule;   // 1.0.9-103 · 精确命中优先
    if (root) {
        static CFTimeInterval lastFound = 0.0;
        CFTimeInterval nowF = CACurrentMediaTime();
        if (nowF - lastFound > 5.0) {
            lastFound = nowF;
            ERLogInfo(@"DI-GLASS 找到目标: %@ frame=%@", NSStringFromClass(root.class),
                      NSStringFromCGRect(root.frame));
        }
    }
    if (!root) {
        static CFTimeInterval lastMiss = 0.0;
        CFTimeInterval nowM = CACurrentMediaTime();
        if (nowM - lastMiss > 5.0) {
            lastMiss = nowM;
            ERLogInfo(@"DI-GLASS 未找到胶囊形视图（不动灵动岛）win=%@", NSStringFromClass(win.class));
        }
        return;
    }

    LGLiveBackdropView *glass = objc_getAssociatedObject(win, kERDIGlassKey);
    if (!glass) {
        glass = LGCreateRegisteredGlass(CGRectZero, nil, @"DynamicIsland");
        if (!glass) return;
        objc_setAssociatedObject(win, kERDIGlassKey, glass, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        lgTrackGlass(glass, @"DynamicIsland", root);
    }
    // ---------------------------------------------------------------------
    // 1.0.9-103 · **玻璃只盖住胶囊区域，绝不铺满窗口**（延续 1.0.9-94 的约束）。
    //
    // 现在 `root` 已是正确的胶囊子视图（不再是窗口自身），`root != win` 成立，
    // 走坐标换算分支。兜底坐标取 iPhone 15 Pro Max 已知胶囊位置（顶部居中 125×37），
    // 仅在换算结果明显畸形（全屏/退化）时回退，避免玻璃铺满或错位。
    // ---------------------------------------------------------------------
    CGRect glassFrame = CGRectMake((CGRectGetWidth(win.bounds) - 125.0) / 2.0, 11.0, 125.0, 37.0);
    if (root && root != win) {
        CGRect r = [root convertRect:root.bounds toView:win];
        // 合理性判定：宽度 40~400、高度 15~160（含默认态与展开态），排除整窗级矩形
        if (r.size.width >= 40.0 && r.size.width <= 400.0 &&
            r.size.height >= 15.0 && r.size.height <= 160.0) {
            glassFrame = r;
        }
    }
    if (glass.superview != win) [win addSubview:glass];
    [win bringSubviewToFront:glass];   // 1.0.9-103 · 保证玻璃压在胶囊内容之上，避免被系统子视图盖住
    glass.hidden = NO;
    glass.frame = glassFrame;
    glass.layer.cornerRadius = CGRectGetHeight(glassFrame) * 0.5;
    glass.userInteractionEnabled = NO;   // 绝不吃触摸（避免影响灵动岛交互）
    if (@available(iOS 13.0, *)) glass.layer.cornerCurve = kCACornerCurveContinuous;
    glass.layer.masksToBounds = YES;
    [glass applyFilters];

    // 5 色渐变叠加（跟随上游 LiquidifyApertureGradientColor1..5）
    CAGradientLayer *grad = objc_getAssociatedObject(win, kERDIGradientKey);
    if (!grad) {
        grad = [CAGradientLayer layer];
        objc_setAssociatedObject(win, kERDIGradientKey, grad, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (grad.superlayer == nil || grad.superlayer != glass.layer) [glass.layer addSublayer:grad];
    NSArray<UIColor *> *cols = ERDIGradientColors();
    if (cols.count < 2) {
        // 1.0.9-103 · 未设渐变时给一组默认色：灵动岛是黑底，玻璃叠黑底几乎看不出来，
        //   给默认渐变后才看得出"液态玻璃"。
        cols = @[[UIColor colorWithRed:0.36 green:0.78 blue:1.00 alpha:1.0],
                 [UIColor colorWithRed:0.58 green:0.45 blue:1.00 alpha:1.0],
                 [UIColor colorWithRed:1.00 green:0.98 blue:1.00 alpha:1.0]];
    }
    if (cols.count >= 2) {
        grad.frame = glass.bounds;
        grad.colors = (id)[cols valueForKey:@"CGColor"];
        grad.startPoint = CGPointMake(0.0, 0.5);
        grad.endPoint = CGPointMake(1.0, 0.5);
        grad.opacity = 0.55;   // 1.0.9-103 · 0.35 → 0.55：让灵动岛上明显看出玻璃
        grad.hidden = NO;
    } else {
        grad.hidden = YES;
    }

    // 1.0.9-103 · 渐变阴影（LiquidifyApertureGlowEnabled）：在玻璃**之后**加一层彩色辉光，
    //   只向外发光、不遮灵动岛内容。颜色取渐变色 1（未设则白）。
    UIView *glow = objc_getAssociatedObject(win, kERDIGlowKey);
    if (ERGlassSwitchEnabled(@"LiquidifyApertureGlowEnabled")) {
        if (!glow) {
            glow = [[UIView alloc] initWithFrame:CGRectZero];
            glow.userInteractionEnabled = NO;
            glow.backgroundColor = [UIColor clearColor];
            glow.layer.masksToBounds = NO;
            objc_setAssociatedObject(win, kERDIGlowKey, glow, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        if (glow.superview != win) [win insertSubview:glow belowSubview:glass];
        glow.frame = glassFrame;
        glow.layer.cornerRadius = glass.layer.cornerRadius;
        glow.layer.shadowColor = (cols.count ? cols.firstObject : [UIColor whiteColor]).CGColor;
        glow.layer.shadowOpacity = 0.9f;
        glow.layer.shadowRadius = 14.0f;
        glow.layer.shadowOffset = CGSizeZero;
        glow.layer.shadowPath = [UIBezierPath bezierPathWithRoundedRect:glow.bounds
                                                           cornerRadius:glow.layer.cornerRadius].CGPath;
        glow.hidden = NO;
        static CFTimeInterval lastGlow = 0.0;
        CFTimeInterval nowG = CACurrentMediaTime();
        if (nowG - lastGlow > 5.0) { lastGlow = nowG; ERLogInfo(@"DI-GLOW 已应用辉光 frame=%@", NSStringFromCGRect(glow.frame)); }
    } else if (glow) {
        glow.hidden = YES;
    }
}

// 1.0.9-59 · **已整体撤销对灵动岛的系统改动**。
//
// 实测（-57/-58 的日志）：`DI-GLASS` 与 `LIQUIDASS-HIT` 均为 0 条 —— 说明
// `SBSystemApertureWindow` 这个类在本机 iOS 17 上**根本没有被创建/hook 到**，
// 我的代码从未执行过。因此"灵动岛不显示"并非本插件造成（iOS 在无活动时本就会
// 把灵动岛收起成顶部小条）。
//
// 为彻底排除风险，本版删除所有对灵动岛窗口的修改（不隐藏、不插入任何视图），
// 仅保留下面这段**只读探针**：把 iOS 17 上灵动岛的真实类名与窗口列表打出来，
// 拿到证据后再做精确实现。





// ===========================================================================
// 1.0.9-66 · 灵动岛（安全 hook 版）
//
// 卡在注销界面进不去桌面的根因（已确认）：
//   `class_getInstanceMethod(cls, @selector(layoutSubviews))` 在目标类**没有自己实现**
//   该方法时，返回的是**父类 UIView 的 Method**；随后 `method_setImplementation` 会
//   **替换掉 UIView 的 layoutSubviews 实现** —— 于是系统里每一个视图的布局都要走
//   我们的 block（里面还要遍历窗口、创建玻璃），开销爆炸 → 界面卡死。
//
// 修法（两步）：
//   ① 本版**先彻底停用**这段 hook，保证能正常进桌面；
//   ② 下一版改用**安全 swizzle**：先 `class_addMethod` 给目标类新增一个方法，
//      再 `method_exchangeImplementations` —— 这样即使方法是继承来的，也只影响
//      目标类本身，绝不会污染 UIView。
// ===========================================================================
#import <objc/runtime.h>

// 安全 swizzle：只影响目标类自身，不污染继承来的实现
// 1.0.9-66 · **关键修正**：必须用 `class_replaceMethod`，不能用 `method_setImplementation`。
//
//   · method_setImplementation(Method) 改的是那个 Method 对象本身 —— 若方法是**继承来的**，
//     它属于父类 UIView → 等于把 UIView 的 layoutSubviews 换掉 → 全系统视图布局都中招（上一版卡死的原因）。
//   · class_replaceMethod(cls, …) 只作用于**传入的那个类**：该类没实现时就给它**新增**一个；
//     绝不会向上修改父类。
static void ERSafeSwizzleLayout(Class cls, SEL origSel, void (^afterOrig)(UIView *view)) {
    if (!cls) return;
    Method origM = class_getInstanceMethod(cls, origSel);
    if (!origM) return;
    // 取"当前生效的实现"（可能来自父类），供新方法内部调用 —— 继承链上的正常调用，不是递归。
    IMP origImp = method_getImplementation(origM);
    IMP newImp = imp_implementationWithBlock(^(__unsafe_unretained UIView *view) {
        ((void (*)(id, SEL))origImp)(view, origSel);
        // 1.0.9-73 · 入口打点（5 秒节流）：带上是哪个 selector 触发的，便于判断该挂哪个时机
        static CFTimeInterval lastTick = 0.0;
        CFTimeInterval nowT = CACurrentMediaTime();
        if (nowT - lastTick > 5.0) {
            lastTick = nowT;
            ERLogInfo(@"DI-TICK 触发 cls=%@ sel=%@ enabled=%d hide=%d",
                      NSStringFromClass([view class]), NSStringFromSelector(origSel),
                      ERDIEnabled() ? 1 : 0, ERDIHideEnabled() ? 1 : 0);
        }
        if (afterOrig) afterOrig(view);
    });
    class_replaceMethod(cls, origSel, newImp, method_getTypeEncoding(origM));
}

// 本版**不调用**该函数（急救）。下一版确认安全后再启用。
static void ERInstallDynamicIslandHooks(void) {
    // 1.0.9-71 · 幂等：装过就不再装（ERLoadPrefs 会多次调用本函数）
    static BOOL diHooked = NO;
    if (diHooked) {
        ERLogInfo(@"DI-HOOK 已挂载过（本次跳过）");
        return;
    }
    NSArray<NSString *> *candidates = @[@"_SBUISystemApertureCAPackageView",
                                        @"BSUICAPackageView",
                                        @"SBSystemApertureWindow",
                                        @"SBUISystemApertureCAPackageView",
                                        @"SBSystemApertureViewController",
                                        @"SBSystemApertureElementViewController"];
    for (NSString *cname in candidates) {
        Class cls = NSClassFromString(cname);
        if (!cls) continue;
        @try {
            // 1.0.9-73 · **两个时机都挂**：
            // 日志证明只挂 layoutSubviews 时 DI-TICK 为 0（该窗口根本不走 layoutSubviews），
            // 而上游方法清单里还有 didMoveToWindow（视图入窗口时必然调用）—— 一并挂上。
            // 1.0.9-74 · **隐藏状态改为"翻转时才写一次"，并在关闭开关后恢复显示**。
            // 之前只写了 `hidden = YES`，开关关掉后没有恢复 → 窗口可能一直处于隐藏态
            // （这正是你担心的"灵动岛被关掉了"）。现在两个方向都处理，并打日志。
            ERSafeSwizzleLayout(cls, @selector(layoutSubviews), ^(UIView *view) {
                if (ERDIHideEnabled()) {
                    UIWindow *w = view.window;
                    if (w) {
                        if (ERDIisIdle(w)) { if (!w.hidden) { w.hidden = YES; ERLogInfo(@"DI-HIDE 空闲→收起灵动岛"); } }
                        else { if (w.hidden) { w.hidden = NO; ERLogInfo(@"DI-HIDE 使用中→恢复"); } }
                    }
                    return;
                }
                if (!ERDIEnabled()) return;
                @try { ERApplyDynamicIslandGlass(view.window ?: (UIWindow *)view); }
                @catch (__unused NSException *e) {}
            });
            ERSafeSwizzleLayout(cls, @selector(didMoveToWindow), ^(UIView *view) {
                if (ERDIHideEnabled()) {
                    UIWindow *w = view.window;
                    if (w) {
                        if (ERDIisIdle(w)) { if (!w.hidden) { w.hidden = YES; ERLogInfo(@"DI-HIDE 空闲→收起灵动岛(didMoveToWindow)"); } }
                        else { if (w.hidden) { w.hidden = NO; ERLogInfo(@"DI-HIDE 使用中→恢复"); } }
                    }
                    return;
                }
                if (!ERDIEnabled()) return;
                @try { ERApplyDynamicIslandGlass(view.window ?: (UIWindow *)view); }
                @catch (__unused NSException *e) {}
            });
            diHooked = YES;
            ERLogInfo(@"DI-HOOK 已挂载(安全swizzle): %@", cname);
            // 1.0.9-72 · **不再在第一个命中的类后 return**：
            // 首选的 CAPackageView 可能根本没有实例（于是 block 永不触发，表现为"没效果"）。
            // 现在对所有存在的候选类都挂，确保至少 `SBSystemApertureWindow`（已证实存在）会触发。
            continue;
        } @catch (__unused NSException *e) {}
    }
    ERLogInfo(@"DI-HOOK 未找到任何灵动岛候选类");
}

static void ERProbeDynamicIslandOnce(void) {
    NSArray<NSString *> *names = @[@"SBSystemApertureWindow",
                                   @"_SBUISystemApertureCAPackageView",
                                   @"SBUISystemApertureCAPackageView",
                                   @"SBSystemApertureViewController",
                                   @"SBSystemApertureElementViewController",
                                   @"SBSystemAperturePresentableManager",
                                   @"SBDynamicIslandWindow",
                                   @"SBSystemApertureSceneManager"];
    NSMutableArray<NSString *> *rows = [NSMutableArray array];
    for (NSString *n in names) {
        [rows addObject:[NSString stringWithFormat:@"%@=%@", n, NSClassFromString(n) ? @"有" : @"无"]];
    }
    ERLogInfo(@"DI-PROBE 类存在性: %@", [rows componentsJoinedByString:@" "]);

    NSMutableArray<UIWindow *> *wins = [NSMutableArray array];
    @try {
        NSArray<UIWindow *> *legacy = UIApplication.sharedApplication.windows;
        if (legacy.count) [wins addObjectsFromArray:legacy];
        for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
            if ([scene isKindOfClass:[UIWindowScene class]]) {
                UIWindowScene *ws = (UIWindowScene *)scene;
                if (ws.windows.count) [wins addObjectsFromArray:ws.windows];
            }
        }
    } @catch (...) {}
    for (UIWindow *w in wins) {
        ERLogInfo(@"DI-PROBE 窗口: %@ level=%.0f frame=%@", NSStringFromClass(w.class), w.windowLevel,
                  NSStringFromCGRect(w.frame));
    }
}

// ===========================================================================



%hook UIVisualEffectView
- (void)didMoveToWindow {
    %orig;
    UIView *self_ = (UIView *)self;
    if (!self_.window) { removeQuickActionsGlass((UIVisualEffectView *)self_); return; }
    if (isQuickActionsHost(self_)) {
        static CFTimeInterval lastQA = 0.0;
        CFTimeInterval now = CACurrentMediaTime();
        if (now - lastQA > 2.0) {
            lastQA = now;
            ERLogInfo(@"LIQUIDASS-HIT 快捷按钮宿主命中 parent=%@", NSStringFromClass(self_.superview.class));
        }
        injectQuickActionsGlass((UIVisualEffectView *)self_);
    }
}
- (void)layoutSubviews {
    %orig;
    UIView *self_ = (UIView *)self;
    if (isQuickActionsHost(self_)) {
        static CFTimeInterval lastQAL = 0.0;
        CFTimeInterval nowL = CACurrentMediaTime();
        if (nowL - lastQAL > 2.0) {
            lastQAL = nowL;
            ERLogInfo(@"LIQUIDASS-HIT 快捷按钮宿主命中(layout) parent=%@", NSStringFromClass(self_.superview.class));
        }
        injectQuickActionsGlass((UIVisualEffectView *)self_);
    }
}
%end

#pragma mark - ② 音量 / 亮度 HUD

@interface LGVolumeHUDVibranceView : UIView
@end

@implementation LGVolumeHUDVibranceView

+ (Class)layerClass {
    return NSClassFromString(@"CABackdropLayer") ?: [CALayer class];
}

- (instancetype)initWithFrame:(CGRect)frame {
    self = [super initWithFrame:frame];
    if (self) {
        self.userInteractionEnabled = NO;
        self.backgroundColor = [UIColor clearColor];
        self.autoresizingMask = UIViewAutoresizingNone;
        [self applyVibranceFilters];
    }
    return self;
}

- (void)applyVibranceFilters {
    @try {
        CALayer *layer = self.layer;
        if (![layer isKindOfClass:NSClassFromString(@"CABackdropLayer")]) return;
        Class filterCls = NSClassFromString(@"CAFilter");
        if (!filterCls) return;
        NSMutableArray *filters = [NSMutableArray array];
        id satFilter = ((id (*)(Class, SEL, NSString *))objc_msgSend)(
            filterCls, NSSelectorFromString(@"filterWithType:"), @"colorSaturate");
        if (satFilter) {
            @try { [satFilter setValue:@(1.85) forKey:@"inputAmount"]; } @catch (...) {}
            [filters addObject:satFilter];
        }
        id contrastFilter = ((id (*)(Class, SEL, NSString *))objc_msgSend)(
            filterCls, NSSelectorFromString(@"filterWithType:"), @"colorContrast");
        if (contrastFilter) {
            @try { [contrastFilter setValue:@(1.06) forKey:@"inputAmount"]; } @catch (...) {}
            [filters addObject:contrastFilter];
        }
        layer.filters = filters;
    } @catch (NSException *e) {}
}

@end

static const void * const kLGVolumeHUDGlassKey = &kLGVolumeHUDGlassKey;
static const void * const kLGVolumeHUDVibranceKey = &kLGVolumeHUDVibranceKey;
static const void * const kLGVolumeHUDMaterialHiddenKey = &kLGVolumeHUDMaterialHiddenKey;

static BOOL LGVolumeHUDEnabled(void) { return ERGlassSwitchEnabled(@"VolumeHUD.Enabled"); }

// ---------------------------------------------------------------------------
// 1.0.9-51 · **音量 HUD 类名抓取（只为 iOS 17 适配取证，纯只读）**
//
// 背景：`%hook SBElasticSliderMaterialWrapperView` 在 iOS 17 上完全没有命中
// （日志里「音量HUD宿主命中」0 条，而你在上游项目里同样是"音量无变化"），
// 说明该类在 iOS 17 上不存在或已改名。
//
// 做法：每 0.4 秒扫描一次所有窗口的视图树，把**类名含 Volume / Elastic / HUD /
// Slider** 的视图记下来，**只打印新出现的类名**（含高度），日志量极低。
// 你只需在 HUD 出现时（按一下音量键）让它扫到即可。
// ---------------------------------------------------------------------------
static void ERScanVolumeHUDClasses(void) {
    static NSMutableSet<NSString *> *seen = nil;
    if (!seen) seen = [NSMutableSet set];
    NSMutableArray<NSString *> *fresh = [NSMutableArray array];
    // 1.0.9-53 · **必须遍历所有 scene 的 windows**：
    // 上一版只用了 UIApplication.sharedApplication.windows（iOS 15+ 已废弃），
    // 它返回的列表里**不含**音量 HUD 所在的窗口（实测只扫到主屏 backdrop
    // BSUIBackdropView(h=932 w=430) 与 VibrancyBackdrop，没有 HUD）。
    NSMutableArray<UIWindow *> *windows = [NSMutableArray array];
    @try {
        NSArray<UIWindow *> *legacy = UIApplication.sharedApplication.windows;
        if (legacy.count) [windows addObjectsFromArray:legacy];
        for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
            if ([scene isKindOfClass:[UIWindowScene class]]) {
                UIWindowScene *ws = (UIWindowScene *)scene;
                if (ws.windows.count) [windows addObjectsFromArray:ws.windows];
            }
        }
    } @catch (...) {}
    for (UIWindow *w in windows) {
        NSMutableArray<UIView *> *stack = [NSMutableArray arrayWithObject:w];
        NSInteger guard = 0;
        while (stack.count && guard++ < 6000) {
            UIView *v = stack.lastObject;
            [stack removeLastObject];
            NSString *cls = NSStringFromClass(v.class);
            if ([cls containsString:@"Volume"] || [cls containsString:@"Elastic"] ||
                [cls containsString:@"HUD"]    || [cls containsString:@"Slider"] ||
                [cls containsString:@"Backdrop"]) {
                if (![seen containsObject:cls]) {
                    [seen addObject:cls];
                    [fresh addObject:[NSString stringWithFormat:@"%@(h=%.0f w=%.0f)", cls,
                                      CGRectGetHeight(v.bounds), CGRectGetWidth(v.bounds)]];
                }
            }
            [stack addObjectsFromArray:v.subviews];
        }
    }
    if (fresh.count) ERLogInfo(@"VHUD-SCAN 新类名(%lu): %@",
                               (unsigned long)fresh.count, [fresh componentsJoinedByString:@" "]);
}

// ===========================================================================
// 1.0.9-75 · 灵动岛：**放弃 hook，改为定时器主动查找**（不依赖任何系统回调）
//
// 证据链：
//   · `DI-TICK` 连续三版为 0 → `layoutSubviews` 与 `didMoveToWindow` 都不会被调用
//     （该类在运行时不接收这两个消息），hook 这条路在本机走不通。
//   · 上游 `Liquidify.dylib` 实际调用的方法里有 `windows` / `windowScene` / `subviews` /
//     `viewWithTag:` —— 说明它同样是**靠遍历窗口树主动查找**目标，而不是只等 hook 回调。
//
// 因此本版：每 0.5 秒扫一次所有窗口（含 UIWindowScene.windows），按上游的类名关键词
// （`Aperture` / `DynamicIsland` / `BSUICAPackageView`）递归查找目标视图，找到就给它加玻璃
// （用关联对象做幂等标记，绝不重复插入）。前 12 次扫描打印结果，便于确认"到底扫到了什么"。
// ===========================================================================
static BOOL ERDIFindApertureInTree(UIView *root, UIView **outView) {
    if (!root) return NO;
    // 1.0.9-103 · 与 ERApplyDynamicIslandGlass 同款修正：排除窗口、取最小面积胶囊候选
    NSMutableArray<UIView *> *stack = [NSMutableArray arrayWithArray:root.subviews];
    NSInteger guardCount = 0;
    UIView *best = nil;
    CGFloat bestArea = CGFLOAT_MAX;
    while (stack.count && guardCount++ < 6000) {
        UIView *v = stack.lastObject;
        [stack removeLastObject];
        if ([v isKindOfClass:[UIWindow class]]) continue;
        NSString *cn = NSStringFromClass(v.class);
        // 1.0.9-103 · 收紧：必须含 Aperture / DynamicIsland；**不再接受通用 CAPackageView**
        //   （CCUICAPackageView / MRUCAPackageView / BSUICAPackageView 都是控制中心/媒体图标，
        //    之前就是被它们抢先命中，玻璃加到了控制中心图标上）
        BOOL isCapsule = [cn containsString:@"DynamicIsland"] ||
                         ([cn containsString:@"Aperture"] && ![cn containsString:@"Window"]);
        if (isCapsule) {
            CGFloat area = CGRectGetWidth(v.bounds) * CGRectGetHeight(v.bounds);
            if (area >= 1500.0 && area < bestArea) { bestArea = area; best = v; }
        }
        [stack addObjectsFromArray:v.subviews];
    }
    if (best && outView) *outView = best;
    return best != nil;
}

// 1.0.9-103 · 全窗口 dump：列出所有窗口的类名 + frame + level，用来判断"灵动岛到底在哪个窗口"。
static void ERDIDumpWindows(NSArray<UIWindow *> *wins) {
    ERLogInfo(@"DI-WINS ---- total=%lu ----", (unsigned long)wins.count);
    NSMutableSet<NSString *> *seen = [NSMutableSet set];
    for (UIWindow *w in wins) {
        NSString *n = NSStringFromClass(w.class);
        NSString *key = [NSString stringWithFormat:@"%@%@%.1f", n, NSStringFromCGRect(w.frame), w.windowLevel];
        if ([seen containsObject:key]) continue;
        [seen addObject:key];
        ERLogInfo(@"DI-WINS %@ frame=%@ lvl=%.1f%@", n, NSStringFromCGRect(w.frame), w.windowLevel, w.hidden ? @" hidden" : @"");
    }
}

// 1.0.9-103 · 灵动岛视图树诊断：把 aperture 窗口里"可能候选"的视图（类名 + 窗口坐标 frame）打出来，
//   用来定位真正的灵动岛胶囊（真机基准：顶部居中、宽约 120~130pt；`*` 表示类名含灵动岛关键词）。
static void ERDIDumpTree(UIWindow *win) {
    if (!win) return;
    ERLogInfo(@"DI-TREE ---- win=%@ frame=%@ subviews=%lu ----",
              NSStringFromClass(win.class), NSStringFromCGRect(win.frame), (unsigned long)win.subviews.count);
    NSMutableArray<UIView *> *stack = [NSMutableArray arrayWithArray:win.subviews];
    NSInteger guard = 0, logged = 0;
    while (stack.count && guard++ < 8000 && logged < 90) {
        UIView *v = stack.lastObject;
        [stack removeLastObject];
        if ([v isKindOfClass:[UIWindow class]]) continue;
        NSString *cn = NSStringFromClass(v.class);
        CGRect r = [v convertRect:v.bounds toView:win];
        BOOL kw = [cn containsString:@"Aperture"] || [cn containsString:@"DynamicIsland"] ||
                  [cn containsString:@"Island"] || [cn containsString:@"Capsule"] ||
                  [cn containsString:@"Pill"] || [cn containsString:@"CAPackage"] ||
                  [cn containsString:@"SystemAperture"];
        BOOL topCand = (CGRectGetWidth(r) >= 60.0 && CGRectGetMinY(r) < 90.0 && CGRectGetHeight(r) >= 12.0);
        if (kw || topCand) {
            ERLogInfo(@"DI-TREE %@ %@ frame=%@%@", kw ? @"*" : @" ", cn, NSStringFromCGRect(r),
                      v.hidden ? @" hidden" : @"");
            logged++;
        }
        [stack addObjectsFromArray:v.subviews];
    }
    ERLogInfo(@"DI-TREE ---- end logged=%ld ----", (long)logged);
}

// 1.0.9-103 · 几何诊断：不依赖类名，在**所有窗口**里找"顶部居中横条"（灵动岛大概率形状），
//   因为第三方灵动岛(aperture-rootless)没有 SBSystemApertureWindow、类名未知。
static void ERDIDumpPill(NSArray<UIWindow *> *wins) {
    CGFloat sw = UIScreen.mainScreen.bounds.size.width;
    ERLogInfo(@"DI-PILL ---- scan %lu windows (screenW=%.0f) ----", (unsigned long)wins.count, sw);
    NSInteger n = 0;
    for (UIWindow *w in wins) {
        if (w.hidden) continue;
        NSMutableArray<UIView *> *stack = [NSMutableArray arrayWithArray:w.subviews];
        NSInteger guard = 0;
        while (stack.count && guard++ < 5000 && n < 70) {
            UIView *v = stack.lastObject; [stack removeLastObject];
            if (v.hidden) continue;
            CGRect r = [v convertRect:v.bounds toView:w];
            CGFloat wd = CGRectGetWidth(r), ht = CGRectGetHeight(r);
            CGFloat cx = CGRectGetMidX(r), cy = CGRectGetMinY(r);
            if (wd >= 60.0 && wd <= 260.0 && ht >= 18.0 && ht <= 90.0 && cy < 90.0 && fabs(cx - sw / 2.0) < 70.0) {
                ERLogInfo(@"DI-PILL %@ win=%@ lvl=%.0f frame=%@", NSStringFromClass(v.class),
                          NSStringFromClass(w.class), w.windowLevel, NSStringFromCGRect(r));
                n++;
            }
            [stack addObjectsFromArray:v.subviews];
        }
    }
    ERLogInfo(@"DI-PILL ---- end n=%ld ----", (long)n);
}

static void ERDITimerScan(void) {
    static NSInteger scanCount = 0;
    scanCount++;
    BOOL verbose = (scanCount <= 12);

    // 1.0.9-76 · **先无条件把状态打出来**（之前"开关关闭就静默 return"导致日志全空，
    // 无法判断到底是"没跑"还是"跑了但开关读到 false"）。
    BOOL diOn = ERDIEnabled();
    BOOL diHide = ERDIHideEnabled();
    if (verbose) {
        ERLogInfo(@"DI-SCAN#%ld 进入 开关=%d 隐藏=%d", (long)scanCount, diOn ? 1 : 0, diHide ? 1 : 0);
    }

    // 1.0.9-103 · **无论开关状态都先扫描**（隐藏与玻璃相互独立）：
    //   隐藏开关可独立于「液态玻璃」工作，故不能因玻璃关就 early-return。
    NSMutableArray<UIWindow *> *wins = [NSMutableArray array];
    @try {
        NSArray<UIWindow *> *legacy = UIApplication.sharedApplication.windows;
        if (legacy.count) [wins addObjectsFromArray:legacy];
        for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
            if ([scene isKindOfClass:[UIWindowScene class]]) {
                UIWindowScene *ws = (UIWindowScene *)scene;
                if (ws.windows.count) [wins addObjectsFromArray:ws.windows];
            }
        }
    } @catch (...) {}

    // 1.0.9-103 · 只认灵动岛窗口：**跳过控制中心**（之前被 CC 里的 CCUICAPackageView 抢先命中，
    //   玻璃加到控制中心图标上 → 灵动岛本体没效果）。优先类名含 Aperture 的窗口。
    {
        static CFTimeInterval lastWins = 0.0;
        CFTimeInterval nowW = CACurrentMediaTime();
        if (nowW - lastWins > 30.0) { lastWins = nowW;
            @try { ERDIDumpWindows(wins); } @catch (__unused NSException *e) {}
            @try { ERDIDumpPill(wins); } @catch (__unused NSException *e) {}
        }
    }
    NSMutableArray<UIWindow *> *ordered = [NSMutableArray array];
    for (UIWindow *w in wins) if ([NSStringFromClass(w.class) containsString:@"Aperture"]) [ordered addObject:w];
    for (UIWindow *w in wins) if (![ordered containsObject:w]) [ordered addObject:w];
    UIView *found = nil;
    UIWindow *foundWindow = nil;
    for (UIWindow *w in ordered) {
        if ([NSStringFromClass(w.class) containsString:@"ControlCenter"]) continue;   // 1.0.9-103 · 排除控制中心
        UIView *v = nil;
        if (ERDIFindApertureInTree(w, &v)) { found = v; foundWindow = w; break; }
    }

    if (verbose) {
        ERLogInfo(@"DI-SCAN#%ld 窗口=%lu 找到=%@ %@", (long)scanCount, (unsigned long)wins.count,
                  found ? NSStringFromClass(found.class) : @"无",
                  found ? NSStringFromCGRect(found.frame) : @"");
    }
    if (!found) return;

    // 1.0.9-103 · 诊断：定期 dump aperture 窗口视图树（30s 一次，便于定位真正的灵动岛胶囊）
    {
        static CFTimeInterval lastDump = 0.0;
        CFTimeInterval nowD = CACurrentMediaTime();
        if (nowD - lastDump > 30.0) { lastDump = nowD; @try { ERDIDumpTree(foundWindow); } @catch (__unused NSException *e) {} }
    }

    // 1.0.9-103 · **隐藏与玻璃解耦**：隐藏只在【空闲】时收起；使用中不收起、且照常加玻璃。
    BOOL idle = ERDIisIdle(foundWindow);
    if (diHide) {
        if (idle) {
            if (!foundWindow.hidden) { foundWindow.hidden = YES; ERLogInfo(@"DI-HIDE 空闲→收起灵动岛(感叹号 Pill)"); }
            return;   // 空闲+隐藏：收起，不加玻璃
        }
        if (foundWindow.hidden) { foundWindow.hidden = NO; ERLogInfo(@"DI-HIDE 使用中→恢复正常系统状态"); }
        // 使用中：继续 → 加玻璃
    } else if (foundWindow.hidden) {
        foundWindow.hidden = NO; ERLogInfo(@"DI-HIDE 开关关闭→恢复灵动岛显示");
    }

    if (diOn) {
        @try { ERApplyDynamicIslandGlass(foundWindow ?: (UIWindow *)found); }
        @catch (__unused NSException *e) {}
    }

    // 1.0.9-103 · 常驻状态打点（每 10s 一次），不再依赖 verbose，便于真机定位
    {
        static CFTimeInterval lastStatus = 0.0;
        CFTimeInterval nowS = CACurrentMediaTime();
        if (nowS - lastStatus > 10.0) {
            lastStatus = nowS;
            LGLiveBackdropView *g = objc_getAssociatedObject(foundWindow, kERDIGlassKey);
            UIView *glw = objc_getAssociatedObject(foundWindow, kERDIGlowKey);
            ERLogInfo(@"DI-STATUS di=%d hide=%d idle=%d hidden=%d found=%@ glass=%@ glow=%@",
                      diOn ? 1 : 0, diHide ? 1 : 0, idle ? 1 : 0, foundWindow.hidden ? 1 : 0,
                      found ? NSStringFromClass(found.class) : @"无",
                      g ? (g.hidden ? @"hidden" : @"on") : @"nil",
                      glw ? (glw.hidden ? @"hidden" : @"on") : @"nil");
        }
    }
}

static void ERStartDynamicIslandScanner(void) {
    static dispatch_source_t diTimer = nil;
    if (diTimer) {
        ERLogInfo(@"DI-SCAN 定时器已在运行（跳过重复启动）");
        return;
    }
    ERLogInfo(@"DI-SCAN 正在创建定时器…");
    diTimer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
    if (!diTimer) {
        ERLogInfo(@"DI-SCAN 定时器创建失败（dispatch_source_create 返回 NULL）");
        return;
    }
    dispatch_source_set_timer(diTimer, dispatch_time(DISPATCH_TIME_NOW, 0),
                              (uint64_t)(2.0 * NSEC_PER_SEC), (uint64_t)(0.5 * NSEC_PER_SEC));
    dispatch_source_set_event_handler(diTimer, ^{
        @try { ERDITimerScan(); } @catch (__unused NSException *e) {}
    });
    dispatch_resume(diTimer);
    ERLogInfo(@"DI-SCAN 定时器已启动（0.5s/次，主动查找，不依赖 hook）");
}

static void ERStartVolumeHUDClassScanner(void) {
    static dispatch_source_t timer = nil;
    if (timer) return;
    timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
    if (!timer) return;
    dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, 0), (uint64_t)(0.4 * NSEC_PER_SEC), (uint64_t)(0.1 * NSEC_PER_SEC));
    dispatch_source_set_event_handler(timer, ^{ ERScanVolumeHUDClasses(); });
    dispatch_resume(timer);
    ERLogInfo(@"VHUD-SCAN 类名扫描已启动（0.4s/次，只打新类名）");
}

static UIView *LGVolumeHUDDescendant(UIView *view, Class targetClass) {
    if ([view isKindOfClass:targetClass]) return view;
    for (UIView *subview in view.subviews) {
        UIView *found = LGVolumeHUDDescendant(subview, targetClass);
        if (found) return found;
    }
    return nil;
}

static void LGSetVolumeHUDBackgroundMaterialsHidden(UIView *view, BOOL hidden) {
    if ([view isKindOfClass:NSClassFromString(@"MTMaterialView")] &&
        [view.superview isKindOfClass:NSClassFromString(@"MTMaterialShadowView")]) {
        NSNumber *original = objc_getAssociatedObject(view, kLGVolumeHUDMaterialHiddenKey);
        if (hidden) {
            if (!original) objc_setAssociatedObject(view, kLGVolumeHUDMaterialHiddenKey, @(view.hidden), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            view.hidden = YES;
        } else if (original) {
            view.hidden = original.boolValue;
            objc_setAssociatedObject(view, kLGVolumeHUDMaterialHiddenKey, nil, OBJC_ASSOCIATION_ASSIGN);
        }
    }
    for (UIView *subview in view.subviews) LGSetVolumeHUDBackgroundMaterialsHidden(subview, hidden);
}

static void LGUpdateVolumeHUDGlass(SBElasticSliderMaterialWrapperView *self) {
    if (!self) return;
    id base = nil, cap = nil;
    UIView *shadow = nil, *sliderWrapper = nil, *sliderView = nil;
    @try {
        base = [self valueForKey:@"_baseMaterialView"];
        cap = [self valueForKey:@"_captureOnlyMaterialView"];
        shadow = [self valueForKey:@"_shadowView"];
        sliderWrapper = [self valueForKey:@"_sliderWrapperView"];
        sliderView = [self valueForKey:@"_sliderView"];
    } @catch (...) {}
    if (!sliderView) sliderView = LGVolumeHUDDescendant(self, NSClassFromString(@"SBElasticVolumeSliderView"));

    if (!LGVolumeHUDEnabled()) {
        LGLiveBackdropView *existing = objc_getAssociatedObject(self, kLGVolumeHUDGlassKey);
        if (existing) existing.hidden = YES;
        LGVolumeHUDVibranceView *existingVib = objc_getAssociatedObject(self, kLGVolumeHUDVibranceKey);
        if (existingVib) existingVib.hidden = YES;
        if (base) ((UIView *)base).hidden = NO;
        if (cap) ((UIView *)cap).hidden = NO;
        if (shadow) shadow.hidden = NO;
        LGSetVolumeHUDBackgroundMaterialsHidden(self, NO);
        return;
    }

    static CFTimeInterval lastVH = 0.0;
    CFTimeInterval vhNow = CACurrentMediaTime();
    if (vhNow - lastVH > 2.0) {
        lastVH = vhNow;
        ERLogInfo(@"LIQUIDASS-HIT 音量HUD宿主命中 cls=%@", NSStringFromClass(self.class));
    }

    if (base) ((UIView *)base).hidden = YES;
    if (cap) ((UIView *)cap).hidden = YES;
    if (shadow) shadow.hidden = YES;
    LGSetVolumeHUDBackgroundMaterialsHidden(self, YES);

    LGVolumeHUDVibranceView *vibrance = objc_getAssociatedObject(self, kLGVolumeHUDVibranceKey);
    if (!vibrance) {
        vibrance = [[LGVolumeHUDVibranceView alloc] initWithFrame:self.bounds];
        if (vibrance) {
            objc_setAssociatedObject(self, kLGVolumeHUDVibranceKey, vibrance, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            if (sliderWrapper) [self insertSubview:vibrance belowSubview:sliderWrapper];
            else [self addSubview:vibrance];
        }
    }

    LGLiveBackdropView *glass = objc_getAssociatedObject(self, kLGVolumeHUDGlassKey);
    if (!glass) {
        glass = LGCreateRegisteredGlass(self.bounds, nil, @"VolumeHUD");
        if (!glass) return;
        objc_setAssociatedObject(self, kLGVolumeHUDGlassKey, glass, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        lgTrackGlass(glass, @"VolumeHUD", self);
        [self insertSubview:glass atIndex:0];
    }

    CGFloat radius = MIN(self.bounds.size.width, self.bounds.size.height) * 0.5f;
    glass.hidden = NO;
    glass.frame = self.bounds;
    glass.layer.cornerRadius = radius;
    if (@available(iOS 13.0, *)) glass.layer.cornerCurve = kCACornerCurveContinuous;
    glass.layer.masksToBounds = YES;
    [glass applyFilters];

    if (vibrance) {
        vibrance.hidden = NO;
        vibrance.frame = self.bounds;
        vibrance.layer.cornerRadius = radius;
        if (@available(iOS 13.0, *)) vibrance.layer.cornerCurve = kCACornerCurveContinuous;
        vibrance.layer.masksToBounds = YES;
    }

    self.layer.cornerRadius = radius;
    if (@available(iOS 13.0, *)) self.layer.cornerCurve = kCACornerCurveContinuous;

    if (sliderWrapper) {
        sliderWrapper.layer.cornerRadius = radius;
        if (@available(iOS 13.0, *)) sliderWrapper.layer.cornerCurve = kCACornerCurveContinuous;
        sliderWrapper.layer.masksToBounds = YES;
    }
    if (sliderView) {
        sliderView.layer.cornerRadius = radius;
        if (@available(iOS 13.0, *)) sliderView.layer.cornerCurve = kCACornerCurveContinuous;
        sliderView.layer.masksToBounds = YES;
    }
}

%hook SBElasticSliderMaterialWrapperView

- (instancetype)initWithFrame:(CGRect)frame {
    self = %orig;
    if (self) LGUpdateVolumeHUDGlass(self);
    return self;
}

- (void)layoutSubviews {
    %orig;
    LGUpdateVolumeHUDGlass(self);
}

- (void)_setContinuousCornerRadius:(double)radius {
    if (LGVolumeHUDEnabled()) {
        CGFloat pillRadius = MIN(self.bounds.size.width, self.bounds.size.height) * 0.5f;
        %orig((double)pillRadius);
        LGLiveBackdropView *glass = objc_getAssociatedObject(self, kLGVolumeHUDGlassKey);
        if (glass) {
            glass.layer.cornerRadius = pillRadius;
            if (@available(iOS 13.0, *)) glass.layer.cornerCurve = kCACornerCurveContinuous;
        }
        LGVolumeHUDVibranceView *vibrance = objc_getAssociatedObject(self, kLGVolumeHUDVibranceKey);
        if (vibrance) {
            vibrance.layer.cornerRadius = pillRadius;
            if (@available(iOS 13.0, *)) vibrance.layer.cornerCurve = kCACornerCurveContinuous;
        }
    } else {
        %orig;
    }
}

%end

// 偏好变化时即时协调（与上游一致）


static BOOL gERDragInProgress = NO;
static __weak UIView *gERActiveDragModuleView = nil;
static NSString *gERActiveDragModuleIdentifier = nil;
static BOOL gERResizeInProgress = NO;
static __weak UIView *gERActiveResizeModuleView = nil;
// One physical home press/swipe can reach both EchoReborn's bottom-zone pan and
// the native dismissal seams. Whichever exits edit mode first opens this
// window so the sibling request from the same gesture cannot also close CC.
static CFTimeInterval gEREditExitConsumedUntil = 0;
static CFTimeInterval gERExpandedChromeRevealUntil = 0;
static NSUInteger gERCurrentPage = 0;
static NSUInteger gERPageCount = 1;
static NSUInteger gEROccupiedPageCount = 1;
static CGFloat gERPagerInteractiveTranslation = 0.0;
static NSUInteger gERPagerInteractiveStartPage = 0;
static CGFloat gERPagerInteractiveProgress = 0.0;
static CFTimeInterval gERPagerInteractiveBeganTime = 0.0;
static CGFloat gERPagerHeldScale = 1.0;
static CGFloat gERPagerHeldAlphaFactor = 1.0;
static CGFloat gERPagerViscousProgress = 0.0;
static CGFloat gERPagerPreviousRawProgress = 0.0;
static CGFloat gERPagerFilteredVelocity = 0.0;
static CGFloat gERPagerJelloScaleX = 1.0;
static CGFloat gERPagerJelloScaleY = 1.0;
static CFTimeInterval gERPagerLastSampleTime = 0.0;
static NSUInteger gERPendingPageAfterRebuild = NSNotFound;

static BOOL ERModuleViewIsPageHidden(UIView *view) {
    return [objc_getAssociatedObject(view, kERPageHiddenKey) boolValue];
}

static BOOL ERIsActiveDragModuleIdentifier(NSString *identifier) {
    return gERDragInProgress && identifier.length && gERActiveDragModuleIdentifier.length && [identifier isEqualToString:gERActiveDragModuleIdentifier];
}

// ---------------------------------------------------------------------------
// 横屏折行（0.5.15）
//
// 一「页」在配置空间里恒为 4 列 × 8 行（8 个 2×2 位）。竖屏下它铺满一屏：
// 8 行 + 若干填高行 = 约一屏高。
//
// 横屏时屏幕变宽变矮，若仍按 4 列渲染，会出现两个问题：
//   1) 页面在竖屏行空间里仍高 632pt+，远高于横屏可视高度（约 320pt），
//      于是只有顶部约 4 行可见，其余 4 行被裁在屏幕外（「只显示了 4 行」）；
//   2) 4 列宽（304pt）的网格被水平居中，两侧留下大片空白，且不做重排。
//
// 修法是把这一页的 8 行折成左右两块，每块 4 列 × 4 行：
//       行 0-3 → 左块（列 0-3）
//       行 4-7 → 右块（列 4-7，行号 -4）
// 一页的内容总量不变（仍是 8 个 2×2 位），但整体变为 8 列 × 4 行，
// 既放得下横屏可视高度，又能均匀铺满横屏宽度。
static NSUInteger const kERLandscapeBlockRows = 4;      // 每块 4 行
// 1.0.9-10 · 编辑网格纵向基准的「上一稳定值」键（抖动过滤用）
static const void *kEREditGridStableBaseYKey = &kEREditGridStableBaseYKey;
// 1.0.9-12 · 快捷按钮「位置校正」用的键与定时器（**必须 static 保活**：
// dispatch_source_t 若是局部变量，函数返回后立即释放，定时器永远不会触发 —— 这就是
// 前四版 QABTN-PROBE 零命中、以及按钮一直"让位"却抓不到数据的原因）。
static NSArray<UIWindow *> *ERAllApplicationWindows(void);   // 前向声明（本函数后面才定义）
static BOOL ERLandscapePresentationActive(void);   // 同上：前向声明
static NSArray<UIViewController *> *ERCollectModuleControllers(UIViewController *root);   // 前向声明
static NSString *ERModuleIdentifier(UIViewController *controller);                        // 前向声明
static const void *kERQAHostBaselineWinYKey = &kERQAHostBaselineWinYKey;
// 1.0.9-19 · 按钮「开环补偿」的两个独立偏移量（用户确认：横竖屏显示位置不同，必须分开）。
// 依据：20260921-2009 日志实测 —— 正常时 hostWinY=45.7、胶囊在场时稳定在 69.2，差值 ≈ 23.5pt。
// 开环 = 只用「是否被压低」这个状态决定偏移，位移取固定常量：
//   · 不参与闭环累加 → 不可能像 1.0.9-17 那样发散（ty 曾累加到 -9269）
//   · 横竖屏各自独立，互不影响
static CGFloat gERQABtnCompensationLandscape = 23.5;   // 横屏：胶囊在场时的上移量
static CGFloat gERQABtnCompensationPortrait  = 23.5;   // 竖屏：同上（初值，按实测各自微调）
static dispatch_source_t gERQABtnCorrectionTimer = nil;

// 把快捷按钮 host 的窗口 Y 钉在「安装时的基线」上：胶囊出现/消失引起的任何漂移，
// 都用 host.transform 反向抵消（不动约束体系，不会被 Auto Layout 覆盖）。
// 1.0.9-15 · 在视图树里按文本找系统编辑态的「添加控制项」按钮（返回它的按钮容器）。
static UIView *EREditAddModuleButtonContainer(UIView *view, NSUInteger depth) {
    if (!view || depth > 16) return nil;
    if ([view isKindOfClass:[UILabel class]]) {
        UILabel *label = (UILabel *)view;
        NSString *text = label.text ?: @"";
        // 1.0.9-20 · 收敛条件（上一版误命中我们自己的 ERExpandedHitButton）：
        //   · 文本必须是短标签且包含「添加控制项」
        //   · 命中的容器不能是自有类（ER 前缀）
        // 1.0.9-22 · **修正上一版的误判**：日志 ADDTEXT 实测「添加控制项」标签就在我们自己的
        // `ERExpandedHitButton` 里 —— 这正是目标按钮，不是"误命中"。上一版加的「排除 ER 类」
        // 过滤恰好把真目标排除了，所以一直没生效。这里恢复为纯文本匹配（文本已足够精确）。
        if (text.length > 0 && text.length <= 12 && [text containsString:@"添加控制项"]) {
            return label.superview ?: view;
        }
    }
    for (UIView *sub in view.subviews) {
        UIView *found = EREditAddModuleButtonContainer(sub, depth + 1);
        if (found) return found;
    }
    return nil;
}

static void ERStartQuickAccessPositionCorrection(void) {
    if (gERQABtnCorrectionTimer) return;
    dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
    if (!timer) return;
    gERQABtnCorrectionTimer = timer;                 // static 保活
    ERLogInfo(@"QACORR 位置校正定时器已启动（每 100ms）");
    dispatch_source_set_timer(timer, DISPATCH_TIME_NOW,
                              (uint64_t)(0.1 * NSEC_PER_SEC),     // 10Hz
                              (uint64_t)(0.02 * NSEC_PER_SEC));
    dispatch_source_set_event_handler(timer, ^{
        @try {
            if (!gEnabled) return;
            // 1.0.9-16 · 心跳：每 5 秒一行，用于确认定时器是否真的在跑、host 找没找到、漂移修正量多少。
            static CFTimeInterval gERQACorrHeartbeat = 0.0;
            CFTimeInterval hbNow = CACurrentMediaTime();
            BOOL hbDue = (hbNow - gERQACorrHeartbeat > 5.0);
            if (hbDue) gERQACorrHeartbeat = hbNow;
            BOOL hbFoundHost = NO;
            CGFloat hbWinY = -1.0, hbBase = -1.0, hbTransformTY = 0.0;
            for (UIWindow *window in ERAllApplicationWindows()) {
                UIView *host = [window viewWithTag:181000];
                if (!host || !host.window) continue;
                if (hbDue) {
                    hbFoundHost = YES;
                    hbWinY = [host.superview convertPoint:host.frame.origin toView:window].y;
                    NSNumber *hbBaseNum = objc_getAssociatedObject(host, kERQAHostBaselineWinYKey);
                    hbBase = hbBaseNum ? hbBaseNum.doubleValue : -1.0;
                    // 1.0.9-17 · 同时记录 transform.ty：校正若写入失败（被系统重置），这里会一直是 0。
                    hbTransformTY = host.transform.ty;
                }
                // 1.0.9-19 · **开环状态机**（用户确认方案）：
                //   状态判据：读一次「布局位置」（= 最终位置 − 当前 ty，剥离自身补偿，避免自我反馈）
                //   位移取值：**固定常量**（横屏/竖屏各一份），不参与任何累加
                //   → 位置只有两种状态，不可能发散、不可能震荡
                CGFloat finalWinY = [host.superview convertPoint:host.frame.origin toView:window].y;
                CGFloat currentTy = host.transform.ty;
                CGFloat layoutWinY = finalWinY - currentTy;
                if (layoutWinY <= 1.0) break;              // 控制中心尚未稳定，不判断
                NSNumber *baselineNum = objc_getAssociatedObject(host, kERQAHostBaselineWinYKey);
                if (!baselineNum || layoutWinY < baselineNum.doubleValue) {
                    // 基线 = 未被压低时的布局位置（取见过的最小值）
                    objc_setAssociatedObject(host, kERQAHostBaselineWinYKey, @(layoutWinY), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    baselineNum = @(layoutWinY);
                }
                BOOL suppressed = (layoutWinY > baselineNum.doubleValue + 8.0);   // 被压低（胶囊在场等）
                CGFloat compensation = suppressed
                    ? (ERLandscapePresentationActive() ? gERQABtnCompensationLandscape : gERQABtnCompensationPortrait)
                    : 0.0;
                CGFloat desiredTy = -compensation;
                if (fabs(currentTy - desiredTy) > 0.5) {
                    // 只在状态切换时写入（两个取值之间切换），写入走禁用动作 + 移除动画
                    ERLogInfo(@"QABTN-COMP 状态切换 suppressed=%d 补偿=%.1f ty=%.1f landscape=%d layoutWinY=%.1f baseline=%.1f",
                              (int)suppressed, compensation, desiredTy,
                              (int)ERLandscapePresentationActive(), layoutWinY, baselineNum.doubleValue);
                    [CATransaction begin];
                    [CATransaction setDisableActions:YES];
                    [host.layer removeAllAnimations];
                    host.transform = CGAffineTransformMakeTranslation(0.0, desiredTy);
                    [CATransaction commit];
                }
                break;
            }
            if (hbDue) {
                UIView *hbAddButton = nil;
                for (UIWindow *hbWindow in ERAllApplicationWindows()) {
                    hbAddButton = EREditAddModuleButtonContainer(hbWindow, 0);
                    if (hbAddButton) break;
                }
                ERLogInfo(@"QACORR 心跳 host=%d hostWinY=%.1f baseline=%.1f ty=%.1f edit=%d 添加控制项=%@",
                          (int)hbFoundHost, hbWinY, hbBase, hbTransformTY, (int)gEditModeActive,
                          hbAddButton ? NSStringFromClass(hbAddButton.class) : @"未找到");
            }
            // 1.0.9-20 · **MODSIZE-PROBE**（问题 8 / 10 的数据来源）：
            // 横屏下每 2 秒打印一次「音量模块 / 亮度模块 / 编辑网格层 gridStack / 它的剪裁 mask」的窗口几何。
            //   · 问题 8（音量/亮度被拉长）：看模块的 h 与容器高，判断是不是横屏行数换算导致
            //   · 问题 10（第四排拖不动）：看 gridStack 与 mask 是否覆盖到第四排，判断是否有层挡住了触摸
            {
                static CFTimeInterval gERModSizeProbeLast = 0.0;
                CFTimeInterval msNow = CACurrentMediaTime();
                if (ERLandscapePresentationActive() && gERControlCenterPresented && msNow - gERModSizeProbeLast > 2.0) {
                    gERModSizeProbeLast = msNow;
                    for (UIViewController *probeOverlay in gOverlayControllers.allObjects) {
                        UIWindow *probeWin = probeOverlay.view.window;
                        if (!probeWin) continue;
                        NSMutableArray<NSString *> *rows = [NSMutableArray array];
                        for (UIViewController *module in ERCollectModuleControllers(probeOverlay)) {
                            NSString *ident = ERModuleIdentifier(module);
                            if (![ident isEqualToString:@"controlcenter.audio"] &&
                                ![ident isEqualToString:@"displaymodule"]) continue;
                            CGRect r = [module.view convertRect:module.view.bounds toView:probeWin];
                            [rows addObject:[NSString stringWithFormat:@"%@={%.0f,%.0f %.0fx%.0f}",
                                             ident, CGRectGetMinX(r), CGRectGetMinY(r),
                                             CGRectGetWidth(r), CGRectGetHeight(r)]];
                        }
                        UIView *stack = objc_getAssociatedObject(probeOverlay, kEREditGridStackKey);
                        CGRect stackRect = stack ? [stack convertRect:stack.bounds toView:probeWin] : CGRectZero;
                        // 1.0.9-21 · 全量采集（上一版按 identifier 猜名字失败 → 这次把**所有模块**打出来）：
                        //   ALLMODS = 每个模块的 identifier + 窗口几何（我据此找音量/亮度真正叫什么）
                        //   OVERLAYS = 编辑态下自有的覆盖层（class/坐标/是否可交互/是否隐藏）→ 判断谁挡住了第四排拖动
                        //   ADDTEXT = 编辑态下所有含「添加」文字的视图（class/文本/坐标）→ 精确匹配「添加控制项」按钮
                        NSMutableArray<NSString *> *allMods = [NSMutableArray array];
                        for (UIViewController *module in ERCollectModuleControllers(probeOverlay)) {
                            if (allMods.count >= 40) break;   // 1.0.9-22 · 12 条不够（音量/亮度被截断）→ 放宽到 40
                            NSString *ident = ERModuleIdentifier(module) ?: @"?";
                            CGRect r = [module.view convertRect:module.view.bounds toView:probeWin];
                            [allMods addObject:[NSString stringWithFormat:@"%@={%.0f,%.0f %.0fx%.0f}",
                                               ident, CGRectGetMinX(r), CGRectGetMinY(r),
                                               CGRectGetWidth(r), CGRectGetHeight(r)]];
                        }
                        NSMutableArray<NSString *> *overlays = [NSMutableArray array];
                        if (gEditModeActive) {
                            for (UIView *sub in probeOverlay.view.subviews) {
                                NSString *cls = NSStringFromClass(sub.class);
                                if (![cls hasPrefix:@"ER"] && ![cls containsString:@"Edit"]) continue;
                                CGRect r = [sub convertRect:sub.bounds toView:probeWin];
                                [overlays addObject:[NSString stringWithFormat:@"%@={%.0f,%.0f %.0fx%.0f}%s%s",
                                                     cls, CGRectGetMinX(r), CGRectGetMinY(r),
                                                     CGRectGetWidth(r), CGRectGetHeight(r),
                                                     sub.userInteractionEnabled ? "" : ":NOinter",
                                                     sub.hidden ? ":hidden" : ""]];
                            }
                        }
                        NSMutableArray<NSString *> *addTexts = [NSMutableArray array];
                        if (gEditModeActive) {
                            NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:probeOverlay.view];
                            NSUInteger head = 0, guard = 0;
                            while (head < queue.count && guard++ < 6000 && addTexts.count < 8) {
                                UIView *v = queue[head++];
                                if ([v isKindOfClass:[UILabel class]]) {
                                    NSString *txt = ((UILabel *)v).text;
                                    if (txt.length && [txt containsString:@"添加"]) {
                                        CGRect r = [v convertRect:v.bounds toView:probeWin];
                                        [addTexts addObject:[NSString stringWithFormat:@"%@\"%@\"={%.0f,%.0f %.0fx%.0f}@%@",
                                                             NSStringFromClass(v.class), txt,
                                                             CGRectGetMinX(r), CGRectGetMinY(r),
                                                             CGRectGetWidth(r), CGRectGetHeight(r),
                                                             NSStringFromClass(v.superview.class)]];
                                    }
                                }
                                if (v.subviews.count) [queue addObjectsFromArray:v.subviews];
                            }
                        }
                        ERLogInfo(@"MODSIZE-PROBE 横屏 gridStack={%.0f,%.0f %.0fx%.0f} mask=%@ edit=%d",
                                  stackRect.origin.x, stackRect.origin.y,
                                  stackRect.size.width, stackRect.size.height,
                                  stack.layer.mask ? NSStringFromCGRect(stack.layer.mask.frame) : @"无",
                                  (int)gEditModeActive);
                        ERLogInfo(@"ALLMODS(%lu)=%@", (unsigned long)allMods.count,
                                  [allMods componentsJoinedByString:@" "]);
                        // 1.0.9-22 · **HIT-PROBE**（问题 10）：在「第四排中心」与「第四排末尾」各做一次 hitTest 模拟，
                        // 打印真正接住触摸的视图链 —— 若有全屏自有覆盖层（EREditTouchShield 等）吃掉了触摸，这里会直接显示出来。
                        if (gEditModeActive) {
                            // 取样点改用**实际模块位置**：取屏幕可见区内（0..容器高）最靠下那个模块的中心，
                            // 这样命中测试一定落在「第四排」上，而不是我猜的固定坐标。
                            CGFloat containerH = CGRectGetHeight(probeWin.bounds);
                            CGPoint lowestCenter = CGPointMake(-1.0, -1.0);
                            CGFloat lowestY = -1.0;
                            for (UIViewController *module in ERCollectModuleControllers(probeOverlay)) {
                                CGRect r = [module.view convertRect:module.view.bounds toView:probeWin];
                                CGFloat cy = CGRectGetMidY(r);
                                if (cy < 0.0 || cy > containerH) continue;      // 只取屏幕内的
                                if (cy > lowestY) { lowestY = cy; lowestCenter = CGPointMake(CGRectGetMidX(r), cy); }
                            }
                            NSMutableArray<NSArray<NSNumber *> *> *probePoints = [NSMutableArray array];
                            if (lowestY > 0.0) {
                                [probePoints addObject:@[@(lowestCenter.x), @(lowestCenter.y)]];
                                [probePoints addObject:@[@(lowestCenter.x), @(lowestCenter.y + 28.0)]];
                            } else {
                                [probePoints addObject:@[@(466.0), @(360.0)]];
                            }
                            NSMutableArray<NSString *> *hits = [NSMutableArray array];
                            for (NSArray<NSNumber *> *pt in probePoints) {
                                CGPoint p = CGPointMake(pt[0].doubleValue, pt[1].doubleValue);
                                UIView *hit = [probeWin hitTest:p withEvent:nil];
                                NSMutableArray<NSString *> *chain = [NSMutableArray array];
                                UIView *node = hit;
                                for (NSUInteger d = 0; node && d < 6; d++, node = node.superview) {
                                    [chain addObject:NSStringFromClass(node.class)];
                                }
                                [hits addObject:[NSString stringWithFormat:@"(%.0f,%.0f)->%@",
                                                 p.x, p.y, chain.count ? [chain componentsJoinedByString:@"<"] : @"nil"]];
                            }
                            ERLogInfo(@"HIT-PROBE 第四排=%@", [hits componentsJoinedByString:@"  "]);
                        }
                        if (gEditModeActive) {
                            ERLogInfo(@"OVERLAYS(%lu)=%@", (unsigned long)overlays.count,
                                      overlays.count ? [overlays componentsJoinedByString:@" "] : @"(无自有覆盖层)");
                            ERLogInfo(@"ADDTEXT(%lu)=%@", (unsigned long)addTexts.count,
                                      addTexts.count ? [addTexts componentsJoinedByString:@" "] : @"(未找到含「添加」的标签)");
                        }
                        break;
                    }
                }
            }
            // 1.0.9-15 · 横屏「添加控制项」按钮：下移一段并打印它的位置（用户要求先给位置与移动量，便于下版微调）。
            // 只作用于横屏；竖屏不动。
            if (gEditModeActive && ERLandscapePresentationActive()) {
                static CFTimeInterval gEREditAddProbeLast = 0.0;
                CFTimeInterval addNow = CACurrentMediaTime();
                if (addNow - gEREditAddProbeLast > 1.0) {
                    for (UIWindow *editWindow in ERAllApplicationWindows()) {
                        UIView *button = EREditAddModuleButtonContainer(editWindow, 0);
                        if (!button) continue;
                        gEREditAddProbeLast = addNow;
                        static const CGFloat kERLandscapeEditAddShift = 12.0;   // 下移量（pt）
                        if (fabs(button.transform.ty - kERLandscapeEditAddShift) > 0.5) {
                            // 1.0.9-20 · 用 layer.position（不含 transform）测原始位置，避免读到补偿后的值
                            CGFloat originalCenterY = [button.superview convertPoint:button.center toView:editWindow].y
                                                      - button.transform.ty;
                            [CATransaction begin];
                            [CATransaction setDisableActions:YES];
                            button.transform = CGAffineTransformMakeTranslation(0.0, kERLandscapeEditAddShift);
                            [CATransaction commit];
                            ERLogInfo(@"EDITADD-PROBE 横屏「添加控制项」cls=%@ 原中心Y=%.1f 下移=%.1f 现中心Y=%.1f",
                                      NSStringFromClass(button.class), originalCenterY,
                                      kERLandscapeEditAddShift, originalCenterY + kERLandscapeEditAddShift);
                        }
                        break;
                    }
                }
            }
        } @catch (__unused NSException *exception) {}
    });
    dispatch_resume(timer);
}
static NSUInteger const kERLandscapeBlockColumns = 4;   // 每块 4 列

// ---- 横屏顶部 chrome 布局（0.5.17）----
// 全部常数来自 932×430pt 横屏截图 + 430×932pt 竖屏截图的逐像素实测，不是估的。
//
// 修复前的横屏实测：
//   · 状态栏本体（双卡/WiFi/电量）   y  76.9 – 119.3pt   —— 偏下
//   · 「+」字形                      y   0    –  10.1pt   —— 中心 4.6pt，被顶部裁掉约 15pt
//   · 电源键字形 x                   380.7 – 394.8pt      —— 竖屏值！横屏应为右边缘
//   · 竖屏对照：「+」中心 45.7pt、状态栏 104–147pt
//
// 两个根因：
//   ① host 宽度按竖屏 430pt 固定（x=430−22−20=388 → 实测 387.8 完全吻合），
//      所以电源键停在屏幕中间，没有「显示在两边」；
//   ② ERQuickAccessCenterYOffset 用 safeAreaInsets.top，横屏该值为 0 → 落到
//      硬编码 56 兜底 → 偏移 −28 → 按钮被顶出屏外。
//
// 0.5.19 横屏状态栏：修掉 0.5.18「改了但完全没动」。
//
// 用户标注的目标（截图像素实测）：状态栏希望落在 y 16.5 – 46.1pt，中心 31.3pt。
// 0.5.18 装上去毫无变化，两个原因叠在一起：
//   ① 找状态栏用的是 containsString:@"StatusBar"，可 CC 里这条通栏状态栏
//      （双卡 主号/副号 + WiFi + 蓝牙 + 电量）类名叫 CCUIStatusLabel ——
//      是 StatusLabel，不是 StatusBar，从头到尾就没被匹配上。
//   ② 唯一匹配上的 CCUIHeaderPocketView 顶边本来就是 0，反算
//      rise = 0 − 16.5 < 0 被夹到 0，就算匹配上了也不会动。诊断日志里
//      只有隐私指示条有 rise（41.5），正是这个原因。
//
// 0.5.19 的实测依据：0.5.18 未生效态（等同原生位置）的横屏截图里，状态栏
// 内容带落在 y 86.0 – 100.8pt，中心 93.4pt；目标中心 31.3pt → 上移 62pt。
// 平移量与坐标系原点无关（窗口偏移被约掉），所以这里直接用固定量，不再拿
// convertRect:toView:window 反算 —— 那个坐标在 CC 呈现动画期间会漂，
// 0.5.18 同一容器量到过 -12 / 58 / 12 三个值，反算出来的 rise 自然是废的。
//
//   状态栏本体   上移 kERLandscapeStatusBarFixedRise，落到 y 16.5 – 46.1
//   隐私指示条   目标顶边 16.5（沿用 0.5.18 的反算）
//   「+」/电源   维持 0.5.17 的侧沟排布，本版不动
//   模块块       0.5.16 的居中结果，本版不动
// 1.0.8-31：用户反馈横屏状态栏「过于靠下」，目标顶边 16.5 → 8.0（整体再上抬 8.5pt）。
// 只动这一个常数；MaxRise / FixedRise / 圆角按钮的下落量都不动。
static CGFloat const kERLandscapeStatusBarTargetTop = 8.0;
static CGFloat const kERLandscapeStatusBarTargetCenterY = 31.3;
static CGFloat const kERLandscapeStatusBarMaxRise = 200.0;
// 1.0.9-5 · 76 → 56：上移 20pt，与状态栏行（钉死后顶 43.7）平齐方向。用户实测原 76 偏低。
static CGFloat const kERLandscapeCornerButtonDrop = 41.0;   // 1.0.9-12 · 40 → 41（用户要求向下 1pt）
// 状态栏本体固定上移量（由上面的实测反算）。
static CGFloat const kERLandscapeStatusBarFixedRise = 62.0;
// 1.0.7-23 · 横屏顶部保留带（v2 思路图 R1/R2）。
// 状态栏带（上升后 16.5 – 46.1）与系统隐私指示器（定位药丸实测底 54、相机绿点 /
// 麦克风橙点排在状态栏带端部）同处这一条带里。网格只能落在它下方，
// 这样指示器出现与否网格都不动，模块也不会被顶到带里或被裁掉。
static CGFloat const kERLandscapeReservedTop = 56.0;
// 「够宽够薄」判定：宽 ≥ 窗口一半、高 ≤ 60pt。只会命中那条通栏状态栏，
// 40pt 的「+」/电源按钮、整块材质背景（高 ≈ 90pt）都不会被误伤。
static CGFloat const kERLandscapeStatusBarMinWidthRatio = 0.5;
static CGFloat const kERLandscapeStatusBarMaxHeight = 60.0;

// 当前是否处于横屏呈现。
//
// 注意：不能用 UIScreen.mainScreen.bounds 判断方向 —— iOS 8 起它不随转屏
// 变化，恒为竖屏尺寸。CC 呈现窗口的 bounds 才会跟着转屏更新，因此从
// overlay 所在窗口读取。
static BOOL ERLandscapePresentationActive(void) {
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        UIWindow *window = overlay.view.window;
        if (!window) continue;
        CGRect bounds = window.bounds;
        if (CGRectGetWidth(bounds) < 1.0 || CGRectGetHeight(bounds) < 1.0) continue;
        return CGRectGetWidth(bounds) > CGRectGetHeight(bounds) + 1.0;
    }
    return NO;   // 没有 overlay 时按竖屏处理，保持既有行为
}

// 一页横向铺开的网格宽度。竖屏 4 列；横屏折成左右两块，合计 8 列。
static CGFloat ERGridVisibleWidth(void) {
    CGFloat columns = ERLandscapePresentationActive() ? (CGFloat)(kERLandscapeBlockColumns * 2) : 4.0;
    return kERGridCellSize * columns + kERGridGap * (columns - 1.0);
}

static CGFloat ERGridHorizontalCenteringCompensationForFrame(CGRect frame, CCUILayoutRect layoutRect, CGFloat containerWidth) {
    if (containerWidth < 1.0) containerWidth = CGRectGetWidth(UIScreen.mainScreen.bounds);
    CGFloat nativeBase = CGRectGetMinX(frame) - (CGFloat)layoutRect.origin.x * kERGridStep;
    CGFloat desiredBase = (containerWidth - ERGridVisibleWidth()) * 0.5;
    CGFloat shift = desiredBase - nativeBase;
    // 竖屏的网格宽度就是原生网格宽度（4 列），原生已经居中，只需补正（不左移）；
    // 横屏的网格是 8 列、比原生的 4 列宽，位移必然为负，必须允许左移才能居中。
    if (ERLandscapePresentationActive()) return shift;
    return MAX(0.0, shift);
}

// 横屏纵向居中补偿。
//
// 竖屏下「一页」的高度本来就约等于一屏高，原生把纵向摆得刚好，EchoReborn 一个纵向
// 偏移都不加。横屏折行后一页只剩 4 行，原生却仍按竖屏那套给出顶部基准，实测结果
// （932×430pt 的横屏）：内容块顶部基准 101pt，可见内容高 340pt，底部只剩 21pt
// 安全区——即整块内容贴底、顶部空出一大块，横向居中而纵向失衡。
//
// 这里把「4 行块」改成在容器里居中，并对顶部安全区 / 底部安全区做夹取：
//   · 不低于顶部安全区（有状态栏带时就不会压上去）
//   · 不越过底部安全区（不会被 Home 指示条盖住，也不会出屏被裁）
// 放不下时（ceiling < floor）优先保住顶部安全区，宁可略微下沉。
static CGFloat ERGridVerticalCenteringCompensationForFrame(CGRect frame, CCUILayoutRect layoutRect, CGFloat containerHeight, CGFloat topInset, CGFloat bottomInset) {
    if (containerHeight < 1.0) containerHeight = CGRectGetHeight(UIScreen.mainScreen.bounds);
    CGFloat nativeBase = CGRectGetMinY(frame) - (CGFloat)layoutRect.origin.y * kERGridStep;
    // 可见内容高度 = 4 行 - 最后一个间距（行间不留尾隙）。
    CGFloat extent = (CGFloat)kERLandscapeBlockRows * kERGridStep - kERGridGap;
    CGFloat centered = (containerHeight - extent) * 0.5;
    CGFloat floorY = MAX(0.0, topInset);
    // 1.0.7-23：横屏给顶部保留带让位（状态栏 + 隐私指示器）—— 网格不得高于它。
    if (ERLandscapePresentationActive()) floorY = MAX(floorY, kERLandscapeReservedTop);
    CGFloat ceiling = containerHeight - MAX(0.0, bottomInset) - extent;
    if (ceiling < floorY) ceiling = floorY;
    CGFloat target = MIN(MAX(centered, floorY), ceiling);
    return target - nativeBase;
}

static NSUInteger ERVisualPageSpacerRows(void) {
    CGFloat screenHeight = CGRectGetHeight(UIScreen.mainScreen.bounds);
    CGFloat extraHeight = screenHeight - kERPageSpan;
    if (extraHeight <= kERGridStep * 0.35) return 0;
    return (NSUInteger)ceil(extraHeight / kERGridStep);
}

// 相邻两页在「布局行空间」里的起始行间隔。
//   竖屏：8 行 + 填高行（与改动前逐字等价）
//   横屏：4 行（每块只有 4 行，页面按 4 行步进）
static NSUInteger ERLayoutPageStrideRows(void) {
    if (ERLandscapePresentationActive()) return kERLandscapeBlockRows;
    return kERMinimumGridRows + ERVisualPageSpacerRows();
}

static CGFloat ERVisualPageSpan(void) {
    return (CGFloat)ERLayoutPageStrideRows() * kERGridStep;
}

static BOOL ERInteractivePagingGeometryActive(void) {
    return gERPresentationNativeSettlePending ||
        gERPresentationPageHandoffActive ||
        gERPagerTransitionActive ||
        gERPagerScrubbingActive ||
        fabs(gERPagerInteractiveTranslation) > 0.01;
}

// CCUILayoutOptions stores the grid metrics in ivars whose names are not part
// of any public contract.  Probe a few spellings so a rename on a newer
// firmware (iOS 17.x incl.) degrades to the compiled-in defaults instead of
// silently producing a grid that no longer matches the native one.
static Ivar ERLayoutOptionsIvar(id layoutOptions, NSArray<NSString *> *names) {
    if (!layoutOptions) return nil;
    Class cls = object_getClass(layoutOptions);
    Class instanceCls = [layoutOptions class];
    for (NSString *name in names) {
        Ivar ivar = class_getInstanceVariable(cls, name.UTF8String);
        if (!ivar) ivar = class_getInstanceVariable(instanceCls, name.UTF8String);
        if (ivar) return ivar;
    }
    return nil;
}

// Settings > Control Center persists the module order here.  The literal path
// is correct for stock and rootless; under roothide the same file lives inside
// the randomised root, so fall back to the jbroot()-resolved location.
static NSString *ERModuleConfigurationPath(void) {
    static NSString *resolved = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        NSString *literal = @"/var/mobile/Library/ControlCenter/ModuleConfiguration.plist";
        NSFileManager *manager = [NSFileManager defaultManager];
        NSArray<NSString *> *candidates = @[literal, jbroot(literal)];
        for (NSString *candidate in candidates) {
            if ([manager fileExistsAtPath:candidate]) { resolved = [candidate copy]; break; }
        }
        resolved = resolved ?: [literal copy];
    });
    return resolved;
}

static void ERApplyCompactGridSpacingToLayoutOptions(id layoutOptions) {
    if (!gEnabled || !layoutOptions) return;
    static NSArray<NSString *> *spacingNames;
    static NSArray<NSString *> *edgeNames;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        spacingNames = @[@"_itemSpacing", @"itemSpacing", @"_spacing", @"spacing"];
        edgeNames = @[@"_itemEdgeSize", @"itemEdgeSize", @"_edgeSize", @"edgeSize"];
    });
    Ivar spacingIvar = ERLayoutOptionsIvar(layoutOptions, spacingNames);
    Ivar edgeIvar = ERLayoutOptionsIvar(layoutOptions, edgeNames);
    uint8_t *bytes = (uint8_t *)(__bridge void *)layoutOptions;
    CGFloat nativeGap = spacingIvar ? *((CGFloat *)(bytes + ivar_getOffset(spacingIvar))) : 0.0;
    CGFloat nativeCell = edgeIvar ? *((CGFloat *)(bytes + ivar_getOffset(edgeIvar))) : 0.0;
    BOOL alreadyCompact = nativeCell > 0.0 && nativeGap > 0.0 &&
        fabs(nativeCell - kERGridCellSize) < 0.5 &&
        fabs(nativeGap - kERGridGap) < 0.5;
    if (!alreadyCompact) {
        if (nativeCell > 1.0) kERGridCellSize = round(nativeCell * kERGridCellScale);
        if (nativeGap > 1.0) kERGridGap = round(nativeGap * kERGridGapScale);
    }
    if (spacingIvar) *((CGFloat *)(bytes + ivar_getOffset(spacingIvar))) = kERGridGap;
    if (edgeIvar) *((CGFloat *)(bytes + ivar_getOffset(edgeIvar))) = kERGridCellSize;
}

static NSArray<UIViewController *> *ERCollectModuleControllers(UIViewController *root);
static CGRect ERVisibleModuleFrame(UIViewController *module, UIViewController *overlay);
static UIViewController *ERConnectivityChild(UIViewController *controller, NSString *className);
static void ERRefreshSettledCompactMediaSnapshot(UIViewController *overlay);
static void ERBeginConnectivityOpeningTransition(UIViewController *controller);
static void ERStartConnectivityOpeningReveal(UIPresentationController *presentationController);
static void ERBeginConnectivityClosingTransition(UIPresentationController *presentationController);
static void ERFinishConnectivityClosingTransition(UIViewController *controller);
static void ERConfigureConnectivityLayout(UIViewController *controller);
static UIView *ERNewConnectivityMaterialView(UIView *root);
static void ERConfigureNowPlayingLayout(UIView *nowPlayingView);
static CGRect ERExpandedConnectivityFrameForClass(NSString *className, CGSize containerSize);
static CGRect ERConnectivityScreenFrameForView(UIView *view);
static void EROpenPendingConnectivityDetailFromPresentation(UIPresentationController *presentationController);
static void ERInstallStandaloneConnectivityDetailMethod(void);
static void ERStopConnectivitySubviewAnimations(UIView *view, BOOL includeRoot);
static BOOL ERIsConnectivityTransitionLeafController(UIViewController *controller);
static void ERSetConnectivityProxyPressed(UIControl *sender, BOOL pressed);
// Defined far below with the detail-presentation family of helpers, but needed
// here by ERConnectivityIdentifierHasNativeExpandedMenu.
static NSString *ERConnectivityDetailChildClassForIdentifier(NSString *identifier);
// Defined with the connectivity colour helpers, but needed by
// ERModuleIdentifierSupportsOwnedDuplicates near the top of the file.
static BOOL ERConnectivityIdentifierUsesWhiteHighlight(NSString *identifier);

static UIPanGestureRecognizer *ERFindActiveControlCenterPresentationPan(UIView *root) {
    if (!root) return nil;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    UIPanGestureRecognizer *fallback = nil;
    while (queue.count) {
        UIView *view = queue.firstObject;
        [queue removeObjectAtIndex:0];
        for (UIGestureRecognizer *gesture in view.gestureRecognizers) {
            if (![gesture isKindOfClass:[UIPanGestureRecognizer class]] ||
                [objc_getAssociatedObject(gesture, kEROwnGestureKey) boolValue] ||
                gesture.numberOfTouches == 0 ||
                (gesture.state != UIGestureRecognizerStateBegan && gesture.state != UIGestureRecognizerStateChanged)) continue;
            UIPanGestureRecognizer *pan = (UIPanGestureRecognizer *)gesture;
            CGPoint location = [pan locationInView:root];
            CGPoint velocity = [pan velocityInView:root];
            BOOL plausiblePull = location.x >= CGRectGetWidth(root.bounds) * 0.45 &&
                location.y <= CGRectGetHeight(root.bounds) * 0.72 && velocity.y > -40.0;
            if (!plausiblePull) continue;
            NSString *name = NSStringFromClass(pan.class);
            if ([name containsString:@"PanSystemGestureRecognizer"] ||
                [name containsString:@"ControlCenter"] || [name containsString:@"StatusBar"]) return pan;
            if (!fallback) fallback = pan;
        }
        [queue addObjectsFromArray:view.subviews];
    }
    return fallback;
}

static NSString *ERThemedPageIndicatorSymbolForPage(NSUInteger page);

static NSString *ERPageIndicatorSymbolForPage(NSUInteger page) {
    if (page == 0) return @"heart.fill";
    if (page >= gEROccupiedPageCount) return @"circle";
    return ERThemedPageIndicatorSymbolForPage(page) ?: @"circle.fill";
}

static CGFloat ERPageIndicatorBasePointSizeForPage(NSUInteger page) {
    return page == 0 ? 16.0 : 12.0;
}

static CGFloat ERPageProgressForScrubY(CGFloat y, CGFloat step, NSUInteger pageCount) {
    if (pageCount <= 1 || step <= 0.0) return 0.0;
    return (y - step * 0.5) / step;
}

static UIScrollView *ERNativeScrollViewForOverlay(UIViewController *overlay) {
    if (!overlay) return nil;
    @try {
        id scrollView = [(id)overlay valueForKey:@"overlayScrollView"];
        return [scrollView isKindOfClass:[UIScrollView class]] ? scrollView : nil;
    } @catch (__unused NSException *exception) {
        return nil;
    }
}

static NSValue *EREnsureNativeScrollBaseline(UIViewController *overlay) {
    NSValue *baseline = objc_getAssociatedObject(overlay, kERNativeScrollBaselineKey);
    if (baseline) return baseline;
    UIScrollView *scrollView = ERNativeScrollViewForOverlay(overlay);
    if (!scrollView) return nil;
    baseline = [NSValue valueWithCGPoint:scrollView.contentOffset];
    objc_setAssociatedObject(overlay, kERNativeScrollBaselineKey, baseline, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(overlay, kERNativeScrollBoundsOriginBaselineKey, [NSValue valueWithCGPoint:scrollView.bounds.origin], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(overlay, kERNativeScrollContentInsetBaselineKey, [NSValue valueWithUIEdgeInsets:scrollView.contentInset], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    return baseline;
}

static BOOL ERViewTreeContainsClassName(UIView *root, NSString *className) {
    if (!root || !className.length) return NO;
    if ([NSStringFromClass(root.class) isEqualToString:className]) return YES;
    for (UIView *subview in root.subviews) {
        if (ERViewTreeContainsClassName(subview, className)) return YES;
    }
    return NO;
}

static void ERSuppressNativeOverflowMaterialForOverlay(UIViewController *overlay) {
    UIScrollView *scrollView = ERNativeScrollViewForOverlay(overlay);
    if (!scrollView || gERExpandedModuleOpen) return;
    CGSize overlaySize = overlay.view.bounds.size;
    for (UIView *child in scrollView.subviews) {
        if (ERViewTreeContainsClassName(child, @"CCUIModuleCollectionView")) continue;
        if (ERViewTreeContainsClassName(child, @"CCUIHeaderPocketView")) continue;
        BOOL hostsSensorHeader = ERViewTreeContainsClassName(child, @"CCUISensorAttributionPrivacyHeaderView");
        BOOL fullScreenSurface = fabs(CGRectGetWidth(child.bounds) - overlaySize.width) < 8.0 &&
                                 fabs(CGRectGetHeight(child.bounds) - overlaySize.height) < 8.0;
        if (!hostsSensorHeader || !fullScreenSurface) continue;
        for (UIView *surface in child.subviews) {
            NSString *name = NSStringFromClass(surface.class);
            if ([name isEqualToString:@"MTMaterialView"] || [name containsString:@"VisualEffect"] || [name containsString:@"Backdrop"]) {
                surface.hidden = YES;
                surface.alpha = 0.0;
                surface.layer.opacity = 0.0;
            }
        }
    }
}

static void ERSuppressHeaderPocketMaterialForOverlay(UIViewController *overlay) {
    if (!overlay.view || gERExpandedModuleOpen) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:overlay.view];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if ([NSStringFromClass(candidate.class) isEqualToString:@"CCUIHeaderPocketView"]) {
            CGFloat pocketHeight = CGRectGetHeight(candidate.bounds);
            for (UIView *child in candidate.subviews) {
                if ([NSStringFromClass(child.class) isEqualToString:@"MTMaterialView"]) {
                    child.hidden = YES;
                    child.alpha = 0.0;
                    child.layer.opacity = 0.0;
                    continue;
                }
                BOOL bottomHairline = CGRectGetWidth(child.bounds) > CGRectGetWidth(candidate.bounds) * 0.5 &&
                                      CGRectGetHeight(child.bounds) <= 2.5 &&
                                      fabs(CGRectGetMaxY(child.frame) - pocketHeight) <= 3.0;
                if (bottomHairline) {
                    child.hidden = YES;
                    child.alpha = 0.0;
                    child.layer.opacity = 0.0;
                }
            }
            for (CALayer *layer in candidate.layer.sublayers) {
                BOOL bottomHairline = CGRectGetWidth(layer.bounds) > CGRectGetWidth(candidate.bounds) * 0.5 &&
                                      CGRectGetHeight(layer.bounds) <= 2.5 &&
                                      fabs(CGRectGetMaxY(layer.frame) - pocketHeight) <= 3.0;
                if (bottomHairline) {
                    layer.hidden = YES;
                    layer.opacity = 0.0;
                }
            }
            continue;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

static void ERClampNativeScrollViewForOverlay(UIViewController *overlay) {
    UIScrollView *scrollView = ERNativeScrollViewForOverlay(overlay);
    if (!scrollView) return;
    ERSuppressNativeOverflowMaterialForOverlay(overlay);
    ERSuppressHeaderPocketMaterialForOverlay(overlay);
    CGSize viewportSize = scrollView.bounds.size;
    scrollView.alwaysBounceVertical = NO;
    scrollView.alwaysBounceHorizontal = NO;
    scrollView.bounces = NO;
    scrollView.showsVerticalScrollIndicator = NO;
    scrollView.showsHorizontalScrollIndicator = NO;
    NSValue *contentInsetValue = objc_getAssociatedObject(overlay, kERNativeScrollContentInsetBaselineKey);
    UIEdgeInsets contentInset = contentInsetValue ? contentInsetValue.UIEdgeInsetsValue : scrollView.contentInset;
    if (!contentInsetValue) {
        NSValue *boundsOriginValue = objc_getAssociatedObject(overlay, kERNativeScrollBoundsOriginBaselineKey);
        CGPoint boundsOrigin = boundsOriginValue ? boundsOriginValue.CGPointValue : scrollView.bounds.origin;
        if (contentInset.top < 1.0 && boundsOrigin.y < -1.0) contentInset.top = -boundsOrigin.y;
        objc_setAssociatedObject(overlay, kERNativeScrollContentInsetBaselineKey, [NSValue valueWithUIEdgeInsets:contentInset], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    scrollView.contentInset = contentInset;
    scrollView.scrollIndicatorInsets = UIEdgeInsetsZero;
    scrollView.contentSize = viewportSize;
    NSValue *boundsOriginValue = objc_getAssociatedObject(overlay, kERNativeScrollBoundsOriginBaselineKey);
    CGPoint boundsOrigin = boundsOriginValue ? boundsOriginValue.CGPointValue : scrollView.bounds.origin;
    if (!boundsOriginValue) {
        objc_setAssociatedObject(overlay, kERNativeScrollBoundsOriginBaselineKey, [NSValue valueWithCGPoint:boundsOrigin], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    CGRect bounds = scrollView.bounds;
    if (fabs(bounds.origin.x - boundsOrigin.x) > 0.25 || fabs(bounds.origin.y - boundsOrigin.y) > 0.25) {
        bounds.origin = boundsOrigin;
        scrollView.bounds = bounds;
    }
    NSValue *offsetValue = objc_getAssociatedObject(overlay, kERNativeScrollBaselineKey);
    CGPoint offset = offsetValue ? offsetValue.CGPointValue : scrollView.contentOffset;
    if (!offsetValue) {
        objc_setAssociatedObject(overlay, kERNativeScrollBaselineKey, [NSValue valueWithCGPoint:offset], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (fabs(scrollView.contentOffset.x - offset.x) > 0.25 || fabs(scrollView.contentOffset.y - offset.y) > 0.25) {
        [scrollView setContentOffset:offset animated:NO];
    }
    if (gERExpandedModuleOpen) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:overlay.view];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if (candidate != scrollView && [candidate isKindOfClass:[UIScrollView class]]) {
            NSString *className = NSStringFromClass(candidate.class);
            BOOL nativePager = [className isEqualToString:@"CCUIModuleCollectionView"] || [className isEqualToString:@"FCUIActivityListView"];
            UIScrollView *internal = (UIScrollView *)candidate;
            if (nativePager) {
                internal.alwaysBounceVertical = NO;
                internal.alwaysBounceHorizontal = NO;
                internal.bounces = NO;
                internal.showsVerticalScrollIndicator = NO;
                internal.showsHorizontalScrollIndicator = NO;
                internal.scrollIndicatorInsets = UIEdgeInsetsZero;
                if ([className isEqualToString:@"FCUIActivityListView"]) internal.scrollEnabled = NO;
                if ([className isEqualToString:@"CCUIModuleCollectionView"]) [internal setContentOffset:CGPointZero animated:NO];
            } else {
                internal.alwaysBounceVertical = NO;
                internal.alwaysBounceHorizontal = NO;
                internal.bounces = NO;
                internal.showsVerticalScrollIndicator = NO;
                internal.showsHorizontalScrollIndicator = NO;
                internal.scrollIndicatorInsets = UIEdgeInsetsZero;
                internal.scrollEnabled = NO;
                CGSize size = internal.contentSize;
                BOOL smallerThanViewport = size.height <= CGRectGetHeight(internal.bounds) + 2.0 &&
                                           size.width <= CGRectGetWidth(internal.bounds) + 2.0;
                if (smallerThanViewport) internal.contentSize = internal.bounds.size;
                BOOL genericScroll = [className isEqualToString:@"UIScrollView"];
                BOOL nearOverlayHeight = CGRectGetHeight(internal.bounds) >= CGRectGetHeight(overlay.view.bounds) - 12.0;
                BOOL oversizedInBothAxes = size.height > CGRectGetHeight(internal.bounds) + 48.0 &&
                                           size.width > CGRectGetWidth(internal.bounds) + 48.0;
                if (genericScroll && nearOverlayHeight && oversizedInBothAxes) {
                    internal.contentInset = UIEdgeInsetsZero;
                    internal.contentSize = internal.bounds.size;
                    [internal setContentOffset:CGPointZero animated:NO];
                    internal.clipsToBounds = YES;
                }
            }
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

static void ERReassertNativeScrollClampForOverlay(UIViewController *overlay) {
    if (!overlay || gERExpandedModuleOpen) return;
    ERClampNativeScrollViewForOverlay(overlay);
    for (NSNumber *delay in @[@0.016, @0.050, @0.120, @0.240]) {
        __weak UIViewController *weakOverlay = overlay;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIViewController *strongOverlay = weakOverlay;
            if (strongOverlay && !gERExpandedModuleOpen) ERClampNativeScrollViewForOverlay(strongOverlay);
        });
    }
}

static void ERRestoreNativeScrollBaseline(UIViewController *overlay) {
    UIScrollView *scrollView = ERNativeScrollViewForOverlay(overlay);
    NSValue *baseline = EREnsureNativeScrollBaseline(overlay);
    if (!scrollView || !baseline) return;
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    ERClampNativeScrollViewForOverlay(overlay);
    CGPoint target = baseline.CGPointValue;
    CGPoint current = scrollView.contentOffset;
    if (fabs(current.x - target.x) > 0.25 || fabs(current.y - target.y) > 0.25) {
        [scrollView setContentOffset:target animated:NO];
    }
    [CATransaction commit];
}

static CGFloat ERNativeScrollOpeningCompensation(UIViewController *overlay) {
    if (!gERUseNativeOpeningCompensation) return 0.0;
    UIScrollView *scrollView = ERNativeScrollViewForOverlay(overlay);
    NSValue *baselineValue = objc_getAssociatedObject(overlay, kERNativeScrollBoundsOriginBaselineKey);
    if (!scrollView || !baselineValue) return 0.0;
    if (gERControlCenterPresentationState != 1 && gERControlCenterPresentationState != 2) {
        objc_setAssociatedObject(overlay, kERNativeScrollOpeningCompensationKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return 0.0;
    }
    CALayer *presentation = (CALayer *)scrollView.layer.presentationLayer;
    CGPoint visibleOrigin = presentation ? presentation.bounds.origin : scrollView.bounds.origin;
    CGFloat compensation = MIN(160.0, MAX(-160.0, visibleOrigin.y - baselineValue.CGPointValue.y));
    objc_setAssociatedObject(overlay, kERNativeScrollOpeningCompensationKey, @(compensation), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    return compensation;
}

static void ERStabilizeNativeScrollPresentationForOverlay(UIViewController *overlay) {
    UIScrollView *scrollView = ERNativeScrollViewForOverlay(overlay);
    if (!scrollView) return;
    NSValue *baseValue = objc_getAssociatedObject(scrollView, kERNativeScrollBaseSublayerTransformKey);
    if (!baseValue) {
        baseValue = [NSValue valueWithCATransform3D:scrollView.layer.sublayerTransform];
        objc_setAssociatedObject(scrollView, kERNativeScrollBaseSublayerTransformKey, baseValue, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    CATransform3D base = baseValue.CATransform3DValue;
    if (gERControlCenterPresentationState == 1) {
        NSValue *boundsBaselineValue = objc_getAssociatedObject(overlay, kERNativeScrollBoundsOriginBaselineKey);
        NSValue *offsetBaselineValue = objc_getAssociatedObject(overlay, kERNativeScrollBaselineKey);
        [scrollView.layer removeAnimationForKey:@"bounds"];
        [CATransaction begin];
        [CATransaction setDisableActions:YES];
        if (boundsBaselineValue) {
            CGRect bounds = scrollView.layer.bounds;
            bounds.origin = boundsBaselineValue.CGPointValue;
            scrollView.layer.bounds = bounds;
        }
        if (offsetBaselineValue) {
            [scrollView setContentOffset:offsetBaselineValue.CGPointValue animated:NO];
        }
        [CATransaction commit];
    }
    CGFloat compensation = ERNativeScrollOpeningCompensation(overlay);
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    scrollView.layer.sublayerTransform = CATransform3DTranslate(base, 0.0, compensation, 0.0);
    [CATransaction commit];
}

static void ERFinishNativeScrollOpeningStabilization(UIViewController *overlay) {
    UIScrollView *scrollView = ERNativeScrollViewForOverlay(overlay);
    UIView *duplicateHost = [overlay.view viewWithTag:kEROwnedDuplicateHostTag];
    NSValue *baseValue = objc_getAssociatedObject(scrollView, kERNativeScrollBaseSublayerTransformKey);
    CATransform3D base = baseValue ? baseValue.CATransform3DValue : CATransform3DIdentity;
    objc_setAssociatedObject(overlay, kERNativeScrollOpeningCompensationKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);

    // State 2 means CCUI's bounds presentation has reached its resting value.
    // Drop the inverse correction's stale presentation tree immediately; a
    // model-only reset leaves the previous +114pt frame visible once more.
    [scrollView.layer removeAllAnimations];
    [duplicateHost.layer removeAllAnimations];
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    scrollView.layer.sublayerTransform = base;
    duplicateHost.transform = CGAffineTransformIdentity;
    [CATransaction commit];
    [CATransaction flush];
}

// Directly regenerating iOS 16's live provider can desynchronize its parallel
// identifier/size state, producing stretched sliders and compact-view labels.
// Keep provider mutation disabled until EchoReborn owns an independent preview map.
static BOOL const gERUseNativeLiveReflow = NO;
static NSMutableDictionary<NSString *, NSValue *> *gERNativeLayoutRects;
static NSMutableDictionary<NSString *, NSArray<NSNumber *> *> *gERCustomOrigins;
static NSMutableDictionary<NSString *, NSValue *> *gERBaseLayoutSizes;
static NSMutableDictionary<NSString *, NSArray<NSNumber *> *> *gERCustomSizes;
static NSMutableDictionary<NSString *, NSString *> *gERDuplicateFamilies;
static NSMutableDictionary<NSString *, NSNumber *> *gERConnectivityOptimisticStates;
static UIImage *gERSheetScreenImage;
static NSDictionary<NSString *, NSValue *> *gERSheetModuleFrames;

// ---------------------------------------------------------------------------
// 1.0.7-22 · 保存横屏布局
//
// 开关关（默认 = 1.0.7-21 的行为）：横屏位置一律由竖屏账本折行推导
// （行 ≥ 4 → 列 + 4、行 − 4），横屏不能单独摆放。
// 开关开：横屏拥有一套**独立账本** gERLandscapeOrigins。横屏呈现时先查它，
// 命中就用账本里的格位；没摆放过的模块回退折行位。竖屏完全不受影响。
//
// 坐标口径（关键）：横屏账本存的**不是**横屏像素坐标，而是与竖屏同一套
// 「配置空间」格位（4 列 × 8 行 / 页，绝对行 = 页 × 8 + 行）。折叠
// （行 ≥ 4 → 列 + 4、行 − 4）是 32 格 ↔ 32 格的**双射**，所以横屏的任意
// 一格都能反算成唯一的竖屏格位 —— 折叠、翻页、合法性校验、占用判定因此
// 全部复用现有代码，不必为横屏再写一套几何。拖动落点（8 列 × 4 行的横屏
// 格位）在写入前用 ERPortraitCellFromLandscapeCell 反算即可。
static BOOL gERLandscapeLayoutEnabled = NO;
static NSMutableDictionary<NSString *, NSArray<NSNumber *> *> *gERLandscapeOrigins;

// 开关开 **且** 当前确实是横屏呈现 —— 两者都成立才走横屏账本。
static BOOL ERLandscapeLayoutActive(void) {
    return gERLandscapeLayoutEnabled && ERLandscapePresentationActive();
}

// 读取一个模块的**生效格位**：横屏账本优先，否则竖屏账本。
static NSArray<NSNumber *> *ERStoredOriginForIdentifier(NSString *identifier) {
    if (!identifier.length) return nil;
    // 1.0.9-42 · 移除 1.0.9-40 加的"越界自愈"：它拦不住真正的问题（每页 8 行时 row=9 属合法值），
    // 却有误判正常布局的风险。错页问题改用下面 %ctor 里的一次性重置解决。
    if (ERLandscapeLayoutActive()) {
        NSArray<NSNumber *> *landscape = gERLandscapeOrigins[identifier];
        if (landscape.count >= 2) return landscape;
    }
    return gERCustomOrigins[identifier];
}


// 写入一个模块的格位（只动内存；落盘统一由 ERPersistStoredOrigins 做）。
static void ERStoreOriginForIdentifier(NSString *identifier, NSUInteger column, NSUInteger absoluteRow) {
    if (!identifier.length) return;
    NSArray<NSNumber *> *value = @[@(column), @(absoluteRow)];
    BOOL landscape = ERLandscapeLayoutActive();
    if (landscape) gERLandscapeOrigins[identifier] = value;
    else gERCustomOrigins[identifier] = value;
    ERLogInfo(@"LANDSCAPE ver=1.0.9-103 store id=%@ cell={%lu,%lu} ledger=%@",
              identifier, (unsigned long)column, (unsigned long)absoluteRow,
              landscape ? @"landscape" : @"portrait");
}

static void ERPersistStoredOrigins(void) {
    if (ERLandscapeLayoutActive()) {
        CFPreferencesSetAppValue(CFSTR("COSMICLandscapeOrigins"), (__bridge CFPropertyListRef)[gERLandscapeOrigins copy], kERPrefsDomain);
    } else {
        CFPreferencesSetAppValue(CFSTR("ModuleGridOrigins"), (__bridge CFPropertyListRef)[gERCustomOrigins copy], kERPrefsDomain);
    }
    CFPreferencesAppSynchronize(kERPrefsDomain);
}

// 横屏格位（8 列 × 4 行）→ 等价的竖屏格位（4 列 × 8 行）。折叠的逆运算。
static CCUILayoutPoint ERPortraitCellFromLandscapeCell(CCUILayoutPoint cell) {
    if (cell.x >= kERLandscapeBlockColumns) {
        return (CCUILayoutPoint){cell.x - kERLandscapeBlockColumns, cell.y + kERLandscapeBlockRows};
    }
    return cell;
}

// 1.0.7-28：状态栏位移的目标选择 / 节奏补写（定义在文件后部、hook 之前）。
static UIView *ERLandscapeStatusChromeTarget(UIView *view);
static void ERChromeReassertRegisterView(UIView *view, CGFloat rise);
static void ERStartLandscapeChromeReassertIfNeeded(void);
static void ERStopLandscapeChromeReassert(void);

static CGRect ERRemoveButtonFrameForModuleFrame(CGRect moduleFrame) {
    CGFloat originOffset = kERRemoveVisualCenterOffset - kERRemoveHitSize * 0.5;
    return CGRectMake(CGRectGetMinX(moduleFrame) + originOffset,
                      CGRectGetMinY(moduleFrame) + originOffset,
                      kERRemoveHitSize, kERRemoveHitSize);
}

static void ERNormalizePreviewCornerRadii(UIView *root, CGSize moduleSize, CGFloat radius) {
    if (!root) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        BOOL fillsModule = fabs(CGRectGetWidth(candidate.bounds) - moduleSize.width) <= 4.0 &&
                           fabs(CGRectGetHeight(candidate.bounds) - moduleSize.height) <= 4.0;
        if (fillsModule) {
            candidate.layer.cornerRadius = radius;
            candidate.layer.cornerCurve = kCACornerCurveContinuous;
            candidate.layer.masksToBounds = YES;
            candidate.layer.borderWidth = 0.0;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

// ---------------------------------------------------------------------------
// Gallery preview clean-up
//
// A detached module renders exactly what it would draw inside Control Center —
// including chrome that is only correct on the live overlay:
//
//   * "辅助功能快捷键" (accessibility.controlcenter.general) ships an internal
//     hairline/separator view above its button. On the real tile that line is
//     invisible against the platter's own edge; inside EchoReborn's preview
//     container it reads as a stray horizontal rule and must go.
//   * The 计时器 (controlcenter.timer) wakes up with an opaque black backing
//     layer (its native background is transparent, so a freshly detached render
//     shows the empty window colour). Every other card in the gallery uses the
//     shared translucent material, so an untinted black platter looks wrong.
//
// Both are pure presentation repairs applied to the preview copy only — the
// live module instances are never touched.
// ---------------------------------------------------------------------------
static BOOL ERPreviewClassNameLooksLikeSeparator(UIView *view) {
    NSString *name = NSStringFromClass(view.class);
    if ([name containsString:@"Separator"] || [name containsString:@"Divider"] ||
        [name containsString:@"Hairline"]) return YES;
    // Some UIKit builds ship a bare, unnamed 1pt rule instead of a named class.
    CGFloat height = CGRectGetHeight(view.bounds);
    CGFloat width = CGRectGetWidth(view.bounds);
    return (height > 0.0 && height <= 1.5 / UIScreen.mainScreen.scale + 0.5) && width >= 8.0;
}

static void ERLogPreviewBacking(UIView *root, NSString *identifier) {
    if (!gERLoggingEnabled || !root) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        [queue addObjectsFromArray:candidate.subviews];
        NSString *className = NSStringFromClass(candidate.class);
        BOOL isMaterialClass = [className containsString:@"Material"] ||
                               [className containsString:@"VisualEffect"] ||
                               [className containsString:@"Platter"] ||
                               [className containsString:@"Backdrop"];
        UIColor *background = candidate.backgroundColor;
        CGColorRef layerBackground = candidate.layer.backgroundColor;
        BOOL coversTile = CGRectGetWidth(candidate.bounds) >= CGRectGetWidth(root.bounds) - 4.0 &&
                          CGRectGetHeight(candidate.bounds) >= CGRectGetHeight(root.bounds) - 4.0;
        // A view can render black without carrying any colour at all: an
        // MTMaterialView with an unconfigured recipe, or a view marked opaque.
        // The colour-only dump missed those entirely, which is why the first
        // log showed nothing but white and the black survived. Report opaque
        // and material surfaces unconditionally.
        BOOL interesting = isMaterialClass || candidate.opaque || coversTile;
        if (!interesting && !background && !layerBackground) continue;
        CGFloat red = -1.0, green = -1.0, blue = -1.0, alpha = -1.0;
        BOOL haveColor = NO;
        if (background) haveColor = [background getRed:&red green:&green blue:&blue alpha:&alpha];
        if (!haveColor && layerBackground) {
            const CGFloat *components = CGColorGetComponents(layerBackground);
            size_t count = CGColorGetNumberOfComponents(layerBackground);
            if (components && count >= 3) {
                red = components[0]; green = components[1]; blue = components[2];
                alpha = count >= 4 ? components[3] : 1.0;
                haveColor = YES;
            }
        }
        ERLogInfo(@"previewbacking: %@ %@ color=%@ r=%.2f g=%.2f b=%.2f a=%.2f opaque=%d tile=%d size=%.0fx%.0f",
                   identifier, className, haveColor ? @"yes" : @"none",
                   red, green, blue, alpha, candidate.opaque ? 1 : 0, coversTile ? 1 : 0,
                   CGRectGetWidth(candidate.bounds), CGRectGetHeight(candidate.bounds));
    }
}

static void ERCleanGalleryPreviewChrome(UIView *root, NSString *identifier, CGSize moduleSize) {
    if (!root) return;
    NSString *lower = identifier.lowercaseString ?: @"";
    BOOL isAccessibilityShortcut = [lower containsString:@"accessibility.controlcenter.general"];
    // The Timer module's bundle identifier has shown up in more than one form
    // across iOS builds, so match on "timer" anywhere rather than the exact
    // "controlcenter.timer" string.
    BOOL isTimer = [lower containsString:@"timer"];
    if (!isAccessibilityShortcut && !isTimer) return;

    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    NSUInteger strippedCount = 0;
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        [queue addObjectsFromArray:candidate.subviews];
        BOOL isRoot = (candidate == root);

        if (isAccessibilityShortcut && !isRoot && ERPreviewClassNameLooksLikeSeparator(candidate)) {
            candidate.hidden = YES;
            candidate.alpha = 0.0;
            candidate.layer.opacity = 0.0;
            continue;
        }
        if (!isTimer) continue;

        // Only the module's OWN full-tile material is the problem. The timer
        // paints a detached MTMaterialView with an unconfigured recipe, which
        // renders as the window's opaque black instead of the sheet's
        // translucent grey. Nothing else may be touched: the previous attempt
        // also neutralised anything "large", which caught
        // CCUISteppedSliderView / CCUIButtonModuleView / CCUICAPackageView /
        // UIImageView — the timer's real dial artwork — and flattened the
        // module to a blank tile without removing the black.
        NSString *className = NSStringFromClass(candidate.class);
        BOOL isMaterialClass = [className containsString:@"Material"] ||
                               [className containsString:@"VisualEffect"] ||
                               [className containsString:@"Platter"] ||
                               [className containsString:@"Backdrop"];
        // Which surface actually paints the tile: it must cover essentially the
        // whole module, not merely most of it (a 60% threshold admitted the
        // slider subviews above).
        BOOL coversTile = CGRectGetWidth(candidate.bounds) >= moduleSize.width - 4.0 &&
                          CGRectGetHeight(candidate.bounds) >= moduleSize.height - 4.0;
        // The timer has no legitimate material of its own at any size: every
        // material inside it came from the detached-shell render. Trust the
        // class test alone there so a mis-sized or nested backing is still
        // caught, while every other module keeps the strict covers-the-tile
        // requirement that protects real content.
        if (!isMaterialClass && !coversTile) continue;
        BOOL nestedInsideContent = NO;
        for (UIView *ancestor = candidate.superview; ancestor && ancestor != root; ancestor = ancestor.superview) {
            NSString *ancestorName = NSStringFromClass(ancestor.class);
            if ([ancestorName containsString:@"Slider"] || [ancestorName containsString:@"ButtonModule"]) {
                nestedInsideContent = YES;
                break;
            }
        }
        if (nestedInsideContent) continue;

        BOOL stripped = NO;
        // The definitive fix for a material: give it the SAME recipe the
        // container uses, so the tile is genuinely the sheet's grey rather
        // than a transparent hole over the dark sheet background.
        if ([candidate isKindOfClass:[UIVisualEffectView class]]) {
            UIVisualEffectView *effectView = (UIVisualEffectView *)candidate;
            [effectView setEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemUltraThinMaterialDark]];
            // A bare blur inside a detached preview has nothing meaningful
            // behind it and composites as black. Give it the same concrete grey
            // the container uses so it cannot come out dark.
            effectView.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.12];
            effectView.opaque = NO;
            stripped = YES;
        } else if (isMaterialClass) {
            // MTMaterialView and friends: clear whatever dark variant they
            // carry and hand the surface the container's own translucent grey.
            @try {
                if ([candidate respondsToSelector:NSSelectorFromString(@"setRecipe:")]) {
                    ((void (*)(id, SEL, id))objc_msgSend)(candidate, NSSelectorFromString(@"setRecipe:"), nil);
                }
            } @catch (__unused NSException *exception) {}
            candidate.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.09];
            candidate.layer.backgroundColor = UIColor.clearColor.CGColor;
            candidate.opaque = NO;
            stripped = YES;
        }
        if (candidate.opaque) {
            candidate.opaque = NO;
            if (!candidate.backgroundColor || CGColorGetAlpha(candidate.backgroundColor.CGColor) < 0.01) {
                candidate.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.09];
            }
            stripped = YES;
        }
        if (stripped) {
            strippedCount++;
            ERLogInfo(@"preview: neutralised tile material %@ on %@", className, identifier);
        }
    }
    // One summary line per timer preview. The previous builds logged only the
    // surfaces they acted on, so a run where nothing matched produced no output
    // at all and looked identical to a run where the cleaning worked. Reporting
    // the counts makes the difference visible.
    if (isTimer) {
        ERLogInfo(@"preview: timer chrome pass finished on %@ (stripped=%lu)", identifier, (unsigned long)strippedCount);
    }
}


@interface ERLowBlurView : UIView
@end

@implementation ERLowBlurView

+ (Class)layerClass {
    return NSClassFromString(@"CABackdropLayer") ?: CALayer.class;
}

- (instancetype)initWithFrame:(CGRect)frame {
    self = [super initWithFrame:frame];
    if (!self) return nil;
    self.userInteractionEnabled = NO;
    self.backgroundColor = UIColor.clearColor;
    self.opaque = NO;
    [self er_configureLowBlur];
    return self;
}

- (void)didMoveToWindow {
    [super didMoveToWindow];
    [self er_configureLowBlur];
}

- (void)layoutSubviews {
    [super layoutSubviews];
    [self er_configureLowBlur];
}

- (void)er_configureLowBlur {
    Class backdropClass = NSClassFromString(@"CABackdropLayer");
    if (!backdropClass || ![self.layer isKindOfClass:backdropClass]) return;
    @try {
        [self.layer setValue:@NO forKey:@"layerUsesCoreImageFilters"];
        [self.layer setValue:@YES forKey:@"windowServerAware"];
        if (![self.layer valueForKey:@"groupName"]) [self.layer setValue:NSUUID.UUID.UUIDString forKey:@"groupName"];
        Class filterClass = NSClassFromString(@"CAFilter");
        SEL selector = NSSelectorFromString(@"filterWithName:");
        id blur = nil;
        if (filterClass && [filterClass respondsToSelector:selector]) {
            blur = ((id (*)(Class, SEL, NSString *))objc_msgSend)(filterClass, selector, @"gaussianBlur");
        }
        if (blur) {
            [blur setValue:@3.0 forKey:@"inputRadius"];
            [blur setValue:@YES forKey:@"inputNormalizeEdges"];
            self.layer.filters = @[ blur ];
        }
    } @catch (__unused NSException *exception) {}
}

@end

@interface ERTopFadeView : UIView
@end

@implementation ERTopFadeView {
    UIView *_blurView;
    CAGradientLayer *_maskLayer;
}

- (instancetype)initWithFrame:(CGRect)frame {
    self = [super initWithFrame:frame];
    if (!self) return nil;
    self.userInteractionEnabled = NO;
    self.backgroundColor = UIColor.clearColor;
    self.opaque = NO;

    _blurView = [[ERLowBlurView alloc] initWithFrame:self.bounds];
    _blurView.userInteractionEnabled = NO;
    [self addSubview:_blurView];

    _maskLayer = [CAGradientLayer layer];
    _maskLayer.colors = @[
        (__bridge id)UIColor.blackColor.CGColor,
        (__bridge id)[UIColor.blackColor colorWithAlphaComponent:0.96].CGColor,
        (__bridge id)[UIColor.blackColor colorWithAlphaComponent:0.78].CGColor,
        (__bridge id)[UIColor.blackColor colorWithAlphaComponent:0.34].CGColor,
        (__bridge id)[UIColor.blackColor colorWithAlphaComponent:0.10].CGColor,
        (__bridge id)UIColor.clearColor.CGColor,
    ];
    _maskLayer.locations = @[ @0.0, @0.34, @0.62, @0.82, @0.94, @1.0 ];
    _maskLayer.startPoint = CGPointMake(0.5, 0.0);
    _maskLayer.endPoint = CGPointMake(0.5, 1.0);
    _blurView.layer.mask = _maskLayer;

    return self;
}

- (void)layoutSubviews {
    [super layoutSubviews];
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    _blurView.frame = self.bounds;
    _maskLayer.frame = _blurView.bounds;
    [CATransaction commit];
}

@end

static BOOL ERRectArraysNearlyEqual(NSArray<NSValue *> *a, NSArray<NSValue *> *b) {
    if (a == b) return YES;
    if (a.count != b.count) return NO;
    for (NSUInteger i = 0; i < a.count; i++) {
        CGRect ra = a[i].CGRectValue;
        CGRect rb = b[i].CGRectValue;
        if (fabs(CGRectGetMinX(ra) - CGRectGetMinX(rb)) > 0.25 ||
            fabs(CGRectGetMinY(ra) - CGRectGetMinY(rb)) > 0.25 ||
            fabs(CGRectGetWidth(ra) - CGRectGetWidth(rb)) > 0.25 ||
            fabs(CGRectGetHeight(ra) - CGRectGetHeight(rb)) > 0.25) return NO;
    }
    return YES;
}

@interface EREditGridView : UIView
@property (nonatomic, copy) NSArray<NSValue *> *slotRects;
@property (nonatomic, copy) NSArray<NSValue *> *occupiedRects;
@property (nonatomic, copy) NSArray<NSValue *> *landingRects;
@property (nonatomic, strong) NSMutableArray<CAShapeLayer *> *circleLayers;
@property (nonatomic, strong) CAShapeLayer *landingLayer;
@property (nonatomic) CGFloat landingCornerRadius;
@property (nonatomic) NSUInteger columns;
@property (nonatomic) NSUInteger rows;
@end

@implementation EREditGridView
- (instancetype)initWithFrame:(CGRect)frame {
    if ((self = [super initWithFrame:frame])) {
        self.backgroundColor = UIColor.clearColor;
        self.userInteractionEnabled = NO;
        self.opaque = NO;
        self.circleLayers = [NSMutableArray array];
        self.landingLayer = [CAShapeLayer layer];
        self.landingLayer.fillColor = [UIColor.whiteColor colorWithAlphaComponent:0.08].CGColor;
        self.landingLayer.strokeColor = [UIColor.whiteColor colorWithAlphaComponent:0.48].CGColor;
        self.landingLayer.lineWidth = 2.0;
        self.landingLayer.opacity = 0.0;
        [self.layer addSublayer:self.landingLayer];
    }
    return self;
}
- (BOOL)rect:(CGRect)slot overlapsAny:(NSArray<NSValue *> *)rects {
    CGPoint center = CGPointMake(CGRectGetMidX(slot), CGRectGetMidY(slot));
    for (NSValue *value in rects) if (CGRectContainsPoint(CGRectInset(value.CGRectValue, -2.0, -2.0), center)) return YES;
    return NO;
}
- (void)layoutSubviews {
    [super layoutSubviews];
    self.landingLayer.frame = self.bounds;
}
- (void)setSlotRects:(NSArray<NSValue *> *)slotRects {
    if (ERRectArraysNearlyEqual(_slotRects, slotRects)) return;
    _slotRects = [slotRects copy];
    for (CAShapeLayer *layer in self.circleLayers) [layer removeFromSuperlayer];
    [self.circleLayers removeAllObjects];
    for (NSValue *value in _slotRects) {
        CGRect slot = value.CGRectValue;
        CGFloat diameter = MIN(CGRectGetWidth(slot), CGRectGetHeight(slot)) * 0.92;
        CGRect circle = CGRectMake(CGRectGetMidX(slot) - diameter * 0.5, CGRectGetMidY(slot) - diameter * 0.5, diameter, diameter);
        CAShapeLayer *layer = [CAShapeLayer layer];
        layer.path = [UIBezierPath bezierPathWithOvalInRect:circle].CGPath;
        layer.fillColor = [UIColor.whiteColor colorWithAlphaComponent:0.06].CGColor;
        [self.layer addSublayer:layer];
        [self.circleLayers addObject:layer];
    }
    [self updateCircleVisibilityAnimated:NO];
}
- (void)setOccupiedRects:(NSArray<NSValue *> *)occupiedRects {
    if (ERRectArraysNearlyEqual(_occupiedRects, occupiedRects)) return;
    _occupiedRects = [occupiedRects copy];
    [self updateCircleVisibilityAnimated:YES];
}
- (void)setLandingRects:(NSArray<NSValue *> *)landingRects {
    if (ERRectArraysNearlyEqual(_landingRects, landingRects)) return;
    _landingRects = [landingRects copy];
    // The footprint is only state for fading the background cells. Drawing a
    // second rounded outline reads as a module left behind and also exposes any
    // transient disagreement between the visual grid and the native layout.
    self.landingLayer.path = nil;
    self.landingLayer.opacity = 0.0f;
    [self updateCircleVisibilityAnimated:!gERDragInProgress];
}
- (void)updateCircleVisibilityAnimated:(BOOL)animated {
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    for (NSUInteger index = 0; index < self.circleLayers.count && index < self.slotRects.count; index++) {
        CAShapeLayer *layer = self.circleLayers[index];
        CGRect slot = self.slotRects[index].CGRectValue;
        float target = ([self rect:slot overlapsAny:self.occupiedRects] || [self rect:slot overlapsAny:self.landingRects]) ? 0.0f : 1.0f;
        if (animated && fabs(layer.opacity - target) > 0.01) {
            CABasicAnimation *fade = [CABasicAnimation animationWithKeyPath:@"opacity"];
            fade.fromValue = @(layer.presentationLayer ? ((CALayer *)layer.presentationLayer).opacity : layer.opacity);
            fade.toValue = @(target);
            fade.duration = 0.12;
            fade.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
            [layer addAnimation:fade forKey:@"EchoRebornCellFade"];
        }
        layer.opacity = target;
    }
    [CATransaction commit];
}
@end

