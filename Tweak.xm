// ---------------------------------------------------------------------------
// 1.0.1：控制按钮交互改造 —— 关机图标由「长按 0.75s 弹系统关机面板」改为「单击弹菜单」
// 1.0.2：菜单形态改为**按类分组的面板**（参考 EvoCenter16 的排列方式）
// ---------------------------------------------------------------------------
// 面板是一块毛玻璃圆角卡片：顶部「电源」标题 + 关闭按钮，下面按用途分组 ——
// 每组一个组标题（「重启」/「安全与电源」）加若干横行条目，条目是
// 「色块图标 + 动作名 + chevron」。落位用弹簧放大，条目再逐条错峰上移淡入；
// 点遮罩、点关闭按钮或再点一次电源键即整体收起。
//
// 相比 1.0.1 的弧线放射：放射布局在右上角只能朝左下摊开，五个圆点互相挤、文字只有
// 9.5pt 两行；改成面板后条目是满宽的行，可点区域大、文字 16pt 一眼可读，
// 横屏 / 大字号下也只是面板变高，不会出屏。
//
// 执行：优先用设备上现成的命令行（sbreload / killall / launchctl），
// posix_spawnp 直接 exec、按 PATH 查找，不经过 shell，也不需要为
// rootless(/var/jb) 与 roothide(随机 jbroot) 分别拼路径。
// 「关机」保留系统自带的关机面板 —— SpringBoard 以 mobile 身份运行，没有直接断电
// 的权限，系统面板是唯一正规路径。
static NSInteger const kERPowerMenuContainerTag = 181062;
static NSInteger const kERPowerMenuItemTag = 181061;
static NSInteger const kERPowerMenuPanelTag = 181063;

// ---------------------------------------------------------------------------
// 1.0.5：电源面板按参考图重做
// ---------------------------------------------------------------------------
// 版式（对齐用户给的参考截图）：一块**浅色**毛玻璃圆角卡片，里面是五行**满宽**条目，
// 文字左对齐、图标右对齐，行与行之间一条通栏细分割线，**没有标题栏、没有色块、没有
// chevron**。行高 56pt、左右内边距 20pt、图标 26pt、文字 21pt Medium。
static CGFloat const kERPowerMenuItemSide   = 56.0;
static CGFloat const kERPowerMenuPanelWidth = 340.0;
static CGFloat const kERPowerMenuPanelPad   = 20.0;
static CGFloat const kERPowerMenuGlyphSize  = 26.0;
static CGFloat const kERPowerMenuCaptionSize = 21.0;
static CGFloat const kERPowerMenuCornerRadius = 28.0;

// 面板刚展示出来的时刻（CFAbsoluteTimeGetCurrent）。
//
// 这是「第一次点没反应 / 第二下却进了安全模式」的两条真实路径的公共刹车：
//   · 用户点一下没看到东西，立刻补第二下 —— 补的那一下正好压在还没淡入完、
//     却又已经挂上屏的条目上（旧版就是这里误触到「安全模式」）；
//   · 用户双击电源键 —— 第一下弹面板、第二下被 powerTapped: 当成「再点一次」
//     立刻收回，观感就是「点了没反应」。
// 所以在展示后的 kERPowerMenuTapGuard 秒内，面板条目与电源键本身都不接受操作。
static CFAbsoluteTime gERPowerMenuPresentedAt = 0.0;
static CFTimeInterval const kERPowerMenuTapGuard = 0.28;

// 参考图里的图标都是「圆环 + 内部符号」这一类的描边 SF Symbol。符号名在 iOS 大版本
// 之间会变，所以给一串候选逐个试，避免某一版上恰好不存在时留下一个空白。
static UIImage *ERPowerMenuGlyph(NSArray<NSString *> *names) {
    UIImageSymbolConfiguration *configuration =
        [UIImageSymbolConfiguration configurationWithPointSize:kERPowerMenuGlyphSize
                                                       weight:UIImageSymbolWeightRegular];
    for (NSString *name in names) {
        UIImage *image = [UIImage systemImageNamed:name withConfiguration:configuration];
        if (image) return image;
    }
    return [UIImage systemImageNamed:@"circle" withConfiguration:configuration];
}

static NSString *const kERPowerActionRespring = @"respring";
static NSString *const kERPowerActionSafeMode = @"safemode";
static NSString *const kERPowerActionUserspace = @"userspace";
static NSString *const kERPowerActionReboot = @"reboot";
static NSString *const kERPowerActionShutdown = @"shutdown";

// posix_spawnp 直接 exec 一个工具，返回是否成功拉起。
// 工具不存在时返回 ENOENT，这里只返回 NO 让调用方试下一个候选，不抛异常。
static BOOL ERRunTool(NSString *tool, NSArray<NSString *> *arguments) {
    if (![tool length]) return NO;
    NSMutableArray<NSString *> *argv = [NSMutableArray arrayWithObject:tool];
    [argv addObjectsFromArray:arguments ?: @[]];
    NSUInteger count = argv.count;
    // C++（Tweak.xm 按 ObjC++ 编译）不允许 void* 隐式转 char**，必须显式转换。
    char **cargv = (char **)calloc(count + 1, sizeof(char *));
    if (!cargv) return NO;
    for (NSUInteger index = 0; index < count; index++) cargv[index] = strdup(argv[index].UTF8String);
    cargv[count] = NULL;
    pid_t pid = 0;
    int status = posix_spawnp(&pid, tool.UTF8String, NULL, NULL, cargv, *_NSGetEnviron());
    for (NSUInteger index = 0; index < count; index++) free(cargv[index]);
    free(cargv);
    return status == 0;
}

// ---------------------------------------------------------------------------
// 1.0.3：FBS 重启/关机入口的 options 构造器
// ---------------------------------------------------------------------------
// `-[FBSSystemService rebootWithOptions:]` 收的是 FBSShutdownOptions 实例；
// 早先这里传了 nil，FBS 内部解引用空指针，而调用发生在 SpringBoard 进程里 ——
// SpringBoard 当场崩溃，被 ellekit 拉起时进入安全模式。这就是用户报的
// 「点关机 → 应用崩溃 → 直接进安全模式」。
//
// 现在一律构造真实实例：依次尝试历史上出现过的构造器，一个都拿不到就返回 nil，
// 由调用方放弃这次操作（宁可不重启，也不拿 nil 去撞 FBS）。
static id ERFBSShutdownOptions(void) {
    Class optionsClass = NSClassFromString(@"FBSShutdownOptions");
    if (!optionsClass) return nil;
    SEL allocSelector = NSSelectorFromString(@"alloc");
    if (![optionsClass respondsToSelector:allocSelector]) return nil;
    id allocated = ((id (*)(id, SEL))objc_msgSend)(optionsClass, allocSelector);
    if (!allocated) return nil;

    id options = nil;
    SEL reasonSelector = NSSelectorFromString(@"initWithReason:");
    if ([allocated respondsToSelector:reasonSelector]) {
        @try { options = ((id (*)(id, SEL, id))objc_msgSend)(allocated, reasonSelector, @"EchoReborn"); }
        @catch (__unused NSException *exception) { options = nil; }
    }
    if (!options) {
        SEL reasonSourceSelector = NSSelectorFromString(@"initWithReason:source:");
        if ([allocated respondsToSelector:reasonSourceSelector]) {
            @try { options = ((id (*)(id, SEL, id, long long))objc_msgSend)(allocated, reasonSourceSelector, @"EchoReborn", 0); }
            @catch (__unused NSException *exception) { options = nil; }
        }
    }
    return options;
}

// 电源面板里的单个动作条目（1.0.5 起按参考图重做）。
//
// 版式（对齐用户给的参考截图）：**动作名左对齐、图标右对齐**，行底一条通栏细分割线。
// 1.0.2~1.0.4 那套「左侧彩色圆角色块 + 中间文字 + 右侧 chevron」的三栏版式已废弃 ——
// 参考图里既没有色块也没有 chevron。
@interface ERPowerMenuItemButton : UIControl
@property (nonatomic, copy) NSString *actionIdentifier;
@property (nonatomic, copy) NSString *caption;
// 图标用一串候选 SF Symbol：第一个在当版 iOS 上存在就用它。
- (instancetype)initWithCaption:(NSString *)caption symbols:(NSArray<NSString *> *)symbols;
// 最后一行不画分割线。面板构造完后按行序统一设置。
- (void)setShowsSeparator:(BOOL)showsSeparator;
@end

@implementation ERPowerMenuItemButton {
    UILabel *_captionLabel;
    UIImageView *_glyph;
    UIView *_separator;
}

- (instancetype)initWithCaption:(NSString *)caption symbols:(NSArray<NSString *> *)symbols {
    self = [super initWithFrame:CGRectMake(0.0, 0.0, kERPowerMenuPanelWidth, kERPowerMenuItemSide)];
    if (!self) return nil;
    self.tag = kERPowerMenuItemTag;
    self.opaque = NO;
    self.backgroundColor = UIColor.clearColor;
    self.exclusiveTouch = YES;
    _caption = [caption copy];

    _captionLabel = [[UILabel alloc] initWithFrame:CGRectZero];
    _captionLabel.text = caption;
    // 浅色面板 → 用语义色，深色模式下面板也会跟着变成深色材质，文字自动反白。
    _captionLabel.textColor = UIColor.labelColor;
    _captionLabel.font = [UIFont systemFontOfSize:kERPowerMenuCaptionSize weight:UIFontWeightMedium];
    _captionLabel.lineBreakMode = NSLineBreakByTruncatingTail;
    _captionLabel.userInteractionEnabled = NO;
    [self addSubview:_captionLabel];

    _glyph = [[UIImageView alloc] initWithImage:ERPowerMenuGlyph(symbols)];
    _glyph.tintColor = UIColor.labelColor;
    _glyph.contentMode = UIViewContentModeScaleAspectFit;
    _glyph.userInteractionEnabled = NO;
    [self addSubview:_glyph];

    _separator = [[UIView alloc] initWithFrame:CGRectZero];
    _separator.backgroundColor = UIColor.separatorColor;
    _separator.userInteractionEnabled = NO;
    [self addSubview:_separator];

    self.isAccessibilityElement = YES;
    self.accessibilityLabel = caption;
    self.accessibilityTraits = UIAccessibilityTraitButton;
    return self;
}

- (void)setShowsSeparator:(BOOL)showsSeparator {
    _separator.hidden = !showsSeparator;
}

- (void)layoutSubviews {
    [super layoutSubviews];
    CGFloat width = CGRectGetWidth(self.bounds);
    CGFloat height = CGRectGetHeight(self.bounds);
    CGFloat pad = kERPowerMenuPanelPad;
    CGFloat glyphSide = kERPowerMenuGlyphSize;

    _captionLabel.frame = CGRectMake(pad, 0.0,
                                     MAX(0.0, width - pad * 2.0 - glyphSide - 12.0), height);
    _glyph.frame = CGRectMake(width - pad - glyphSide,
                              round((height - glyphSide) * 0.5),
                              glyphSide, glyphSide);

    // 真·一像素线：1 / scale，圆整到屏幕像素网格上，避免在 2x / 3x 上糊成两点。
    CGFloat hairline = 1.0 / UIScreen.mainScreen.scale;
    _separator.frame = CGRectMake(0.0, height - hairline, width, hairline);
}

- (void)setHighlighted:(BOOL)highlighted {
    [super setHighlighted:highlighted];
    [UIView animateWithDuration:0.10 delay:0.0 options:UIViewAnimationOptionBeginFromCurrentState animations:^{
        // 浅色面板上高亮用「压暗」而不是「提亮」，与参考图的观感一致。
        self.backgroundColor = highlighted ? [UIColor colorWithWhite:0.0 alpha:0.07] : UIColor.clearColor;
    } completion:nil];
}

@end




// ---------------------------------------------------------------------------
// 1.0.7-8 · 控制中心**编辑态 ⊖ 圆钮**的液态玻璃 —— 按 LiquidAss 的做法实现
//
// LiquidAss 对小圆元素（Hooks/PillHUD.x）的标准做法：
//   · 玻璃**自建**：LGCreateRegisteredGlass(bounds, nil, host)，不挂在材质上；
//   · 每次布局：frame=元素 bounds、radius=短边一半、masksToBounds、**applyFilters()**；
//   · 开关切换用 glass.hidden，不移除不重建；关闭时恢复被藏起来的系统材质。
//
// 我在 1.0.7-6 用错了 API：LGInstallRegisteredGlassInMaterial 是给「真材质视图」用的，
// 装到一个模块大小的点击区按钮上，既没生效（玻璃没建起来）又留下残层（退出编辑态错乱）。
// 本版完全照 PillHUD 的模式来：玻璃挂在 ⊖ 按钮上、frame 精确等于那颗 26×26 的圆底，
// 因此无论玻璃渲染成什么样子，视觉上都不会超出圆钮，也不会有额外的一层。
// ---------------------------------------------------------------------------
static NSInteger const kEREditBadgeBubbleTag = 181070;
static NSInteger const kEREditBadgeGlyphTag  = 181071;
static const void *kEREditBadgeBgGlassKey   = &kEREditBadgeBgGlassKey;
static const void *kEREditBadgeLineGlassKey = &kEREditBadgeLineGlassKey;
static const void *kEREditBadgeGlassStateKey = &kEREditBadgeGlassStateKey;

static BOOL EREditBadgeGlassOn(NSString *key) {
    if (!ERPreferenceBool(@"Global.Enabled", YES)) return NO;   // 总开关
    if (!lgHostEnabled(@"ControlCenter")) return NO;            // 控制中心宿主开关
    return ERPreferenceBool(key, YES);
}

// LiquidAss 模式：frame / radius / applyFilters，玻璃自建、随布局刷新。
static LGLiveBackdropView *EREditBadgeEnsureGlass(UIView *badge, const void *key,
                                                  CGRect frame, CGFloat radius) {
    LGLiveBackdropView *glass = objc_getAssociatedObject(badge, key);
    if (!glass) {
        glass = LGCreateRegisteredGlass(frame, nil, @"ControlCenter");
        if (!glass) return nil;
        objc_setAssociatedObject(badge, key, glass, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        lgTrackGlass(glass, @"ControlCenter", badge);
        [badge addSubview:glass];
    }
    glass.hidden = NO;
    if (!CGRectEqualToRect(glass.frame, frame)) glass.frame = frame;
    if (fabs(glass.layer.cornerRadius - radius) > 0.5) {
        glass.layer.cornerRadius = radius;
        glass.lgShapeCornerRadius = radius;
        // applyFilters 只在尺寸真正变化时调：它要改 layer.filters、重配原生模糊覆盖层，
        // 不该进每个布局周期（GlassKit 自己的重试节奏仍然保留）。
        [glass applyFilters];
    }
    return glass;
}

static void EREditBadgeHideGlass(UIView *badge, const void *key) {
    LGLiveBackdropView *glass = objc_getAssociatedObject(badge, key);
    if (glass) glass.hidden = YES;      // 只藏不移除：LiquidAss 同款，切换零重建
}

// 幂等入口：编辑态每次刷新都调，稳态下只是几次比较。
//
// 1.0.7-9 的观感修正（按用户反馈「关闭液态玻璃就是 iOS 样式，开启就是 iOS26 效果」）：
//   · 「顶部按钮」开  → 圆钮的毛玻璃底**隐藏**、玻璃顶上（LiquidAss 同款：
//     `if (base) base.hidden = YES;`）—— 这才是 iOS26 的观感；
//     关 → 玻璃隐藏、毛玻璃底回来 = iOS 原样。
//   · 「编辑液态效果」开 → 那条横线从黑色改成**白色**（iOS26 的玻璃上高光就是白的；
//     上一版给它套玻璃胶囊，实机渲染成一个黑环，用户明确否定 —— 已删除）。
static void EREditBadgeApplyGlass(UIButton *badge) {
    if (!badge) return;
    UIView *bubble = [badge viewWithTag:kEREditBadgeBubbleTag];
    UIView *glyph = [badge viewWithTag:kEREditBadgeGlyphTag];
    if (!bubble || !glyph) return;

    BOOL bgOn = EREditBadgeGlassOn(@"ControlCenter.TopButtonGlass");
    BOOL lineOn = EREditBadgeGlassOn(@"ControlCenter.EditChromeGlass");

    CGFloat radius = bubble.layer.cornerRadius > 1.0
        ? bubble.layer.cornerRadius
        : CGRectGetHeight(bubble.bounds) * 0.5;

    LGLiveBackdropView *bgGlass = objc_getAssociatedObject(badge, kEREditBadgeBgGlassKey);
    if (bgOn) {
        bgGlass = EREditBadgeEnsureGlass(badge, kEREditBadgeBgGlassKey, bubble.frame, radius);
        if (bgGlass) {
            bubble.hidden = YES;                       // iOS26：玻璃独占背景（1.0.7-9 效果，用户已认可）
            [badge insertSubview:bgGlass aboveSubview:bubble];
            [badge bringSubviewToFront:glyph];
        }
    } else {
        if (bgGlass) bgGlass.hidden = YES;
        bubble.hidden = NO;                            // iOS 原样：毛玻璃圆底回来
    }

    // 横线：玻璃上用白色高光，原生上用黑色 —— 与「关=iOS / 开=iOS26」一一对应。
    glyph.tintColor = (bgOn && lineOn) ? UIColor.whiteColor : UIColor.blackColor;

    // 状态变化才落一行日志（含实测尺寸，便于后续按 CCAster 0.2.2 调背景大小）。
    NSString *state = [NSString stringWithFormat:@"bg=%d line=%d bnd={%.0fx%.0f} bubble={%.0f,%.0f,%.0fx%.0f} r=%.1f",
                       bgOn, lineOn,
                       CGRectGetWidth(badge.bounds), CGRectGetHeight(badge.bounds),
                       bubble.frame.origin.x, bubble.frame.origin.y,
                       CGRectGetWidth(bubble.frame), CGRectGetHeight(bubble.frame), radius];
    if (![objc_getAssociatedObject(badge, kEREditBadgeGlassStateKey) isEqual:state]) {
        objc_setAssociatedObject(badge, kEREditBadgeGlassStateKey, state, OBJC_ASSOCIATION_COPY_NONATOMIC);
        ERLogInfo(@"EDITGLASS ver=1.0.9-103 %@", state);
    }
}

// ---------------------------------------------------------------------------
// 1.0.7-11 · 编辑态**拖动扶手**：把扶手的「图标」（那段白色弧线 + 毛玻璃弧带）
// 做成与 ⊖ 圆钮 1.0.7-9 完全相同的效果 —— 玻璃替换毛玻璃、弧线保持在上。
//
// 扶手的可见材质 grabberMaterial 是一块**被弧线描边遮罩**的毛玻璃
// （mask = cornerPath 的 12.5pt 描边），所以玻璃也用**同一条弧线描边**当遮罩，
// 形状与原毛玻璃弧带完全重合；iOS26 开时毛玻璃隐藏，关时恢复原状。
// 用户在 1.0.7-10 否定了我做的「同心圆盘」—— 圆盘会铺满整个扶手区域，不是 ⊖ 那种
// 「玻璃替换材质」的观感，本版按 ⊖ 的做法重来。
// ---------------------------------------------------------------------------
static NSInteger const kEREditHandleGlassTag = 181074;
static const void *kEREditHandleGlassKey = &kEREditHandleGlassKey;

static void EREditHandleApplyGlass(UIButton *resize, UIBezierPath *cornerPath, CGFloat bandWidth) {
    if (!resize || !cornerPath) return;
    BOOL on = EREditBadgeGlassOn(@"ControlCenter.TopButtonGlass");
    LGLiveBackdropView *glass = objc_getAssociatedObject(resize, kEREditHandleGlassKey);
    UIView *material = [resize viewWithTag:kERResizeMaterialTag];
    if (!on) {
        if (glass) glass.hidden = YES;
        if (material) material.hidden = NO;      // 关 → 毛玻璃弧带回来 = iOS 原样
        return;
    }
    if (!glass) {
        glass = LGCreateRegisteredGlass(resize.bounds, nil, @"ControlCenter");
        if (!glass) return;
        objc_setAssociatedObject(resize, kEREditHandleGlassKey, glass, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        lgTrackGlass(glass, @"ControlCenter", resize);
        [resize addSubview:glass];
    }
    // 玻璃的遮罩 = 弧线描边，宽度随「玻璃模式收细」同步（12.5 → 6.0），否则玻璃弧带
    // 会比细弧线宽出一圈，看起来又变成胖逗号。
    CAShapeLayer *mask = [CAShapeLayer layer];
    mask.path = cornerPath.CGPath;
    mask.fillColor = UIColor.clearColor.CGColor;
    mask.strokeColor = UIColor.blackColor.CGColor;
    mask.lineWidth = bandWidth;
    mask.lineCap = kCALineCapRound;
    mask.lineJoin = kCALineJoinRound;
    glass.layer.mask = mask;
    glass.hidden = NO;
    CGRect frame = CGRectMake(0, 0, 40.0, 40.0);   // cornerPath 的坐标空间
    if (!CGRectEqualToRect(glass.frame, frame)) glass.frame = frame;
    glass.layer.masksToBounds = NO;
    [glass applyFilters];
    if (material) material.hidden = YES;           // iOS26：玻璃替换毛玻璃弧带
    // 白色弧线必须保持在玻璃之上（它可能是 resize.layer 的一个子层）
    for (CALayer *layer in [resize.layer.sublayers copy]) {
        if ([layer.name isEqualToString:@"EchoRebornResizePill"]) {
            [resize.layer insertSublayer:glass.layer below:layer];
            break;
        }
    }
}


//
// ---------------------------------------------------------------------------
// 1.0.7-5：翻页落位的**帧级探针**。
//
// 用户连续 5 个版本反馈「向上停留然后落下」，而我此前每一版都在拿「起点 / 终点 /
// 时长」这三个数去推 —— 日志里根本没有中间过程，等于闭着眼改。这次先把运动过程
// 采下来：落位后用 CADisplayLink 逐帧记录**呈现层的真实位置**，一次滑动就能看出
// 曲线到底是
//     · 一路单调走到底（那问题在别处，比如内容层自己的位移）；
//     · 先冲过头再回落（overshoot，问题在曲线/时长）；
//     · 中间有几帧完全不动（卡帧，问题在同步工作太重）；
//     · 走到底之后又被挪回去（问题在 completion 里的收尾写入）。
// 42 帧 ≈ 0.7s @60Hz，覆盖整段落位。只在翻页时启动，绝无常驻开销。
// ---------------------------------------------------------------------------
static CADisplayLink *gERPageSettleProbeLink = nil;
static NSInteger gERPageSettleProbeFrames = 0;
static NSTimeInterval gERPageSettleProbeStart = 0;
static CALayer *gERPageSettleProbeLayer = nil;

@interface ERPageSettleProbeTarget : NSObject
@end

@implementation ERPageSettleProbeTarget
+ (void)tick:(CADisplayLink *)link {
    if (!gERPageSettleProbeLayer) {
        [link invalidate];
        gERPageSettleProbeLink = nil;
        return;
    }
    gERPageSettleProbeFrames++;
    CALayer *layer = gERPageSettleProbeLayer;
    CALayer *presentation = (CALayer *)layer.presentationLayer;
    NSTimeInterval elapsed = CACurrentMediaTime() - gERPageSettleProbeStart;
    if (gERPageSettleProbeFrames <= 42) {
        ERLogInfo(@"SETTLEPROBE ver=1.0.9-103 f=%ld t=%.3f pres=%.1f model=%.1f",
                  (long)gERPageSettleProbeFrames, elapsed,
                  presentation ? presentation.sublayerTransform.m42 : 0.0,
                  layer.sublayerTransform.m42);
    }
    if (gERPageSettleProbeFrames >= 42) {
        ERLogInfo(@"SETTLEPROBE ver=1.0.9-103 done frames=%ld", (long)gERPageSettleProbeFrames);
        [link invalidate];
        gERPageSettleProbeLink = nil;
        gERPageSettleProbeLayer = nil;
    }
}
@end

static void ERStartPageSettleProbe(CALayer *layer) {
    if (!layer) return;
    if (gERPageSettleProbeLink) {
        [gERPageSettleProbeLink invalidate];
        gERPageSettleProbeLink = nil;
    }
    gERPageSettleProbeLayer = layer;
    gERPageSettleProbeFrames = 0;
    gERPageSettleProbeStart = CACurrentMediaTime();
    CADisplayLink *link = [CADisplayLink displayLinkWithTarget:[ERPageSettleProbeTarget class]
                                                     selector:@selector(tick:)];
    gERPageSettleProbeLink = link;
    [link addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
}


@implementation EchoRebornCoordinator

+ (instancetype)shared {
    static EchoRebornCoordinator *shared;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{ shared = [self new]; });
    return shared;
}

- (UIImage *)symbol:(NSString *)name size:(CGFloat)size {
    UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:size weight:UIImageSymbolWeightSemibold];
    return [UIImage systemImageNamed:name withConfiguration:configuration];
}

// The quick-access buttons render as bare glyphs: no material disk, no
// backdrop.  materialRoot is retained in the signature for its existing call
// sites but is no longer used.
- (UIButton *)cornerButtonWithSymbol:(NSString *)symbol action:(SEL)action tag:(NSInteger)tag materialRoot:(UIView *)materialRoot {
    (void)materialRoot;
    UIButton *button = [UIButton buttonWithType:UIButtonTypeCustom];
    button.tag = tag;
    button.backgroundColor = UIColor.clearColor;
    button.opaque = NO;
    button.tintColor = [UIColor colorWithWhite:1.0 alpha:0.97];
    // 字形尺寸随「按钮大小」设置缩放（40pt 按钮 → 30pt 字形，即 0.75 比例），
    // 字形视图与字形名都存到按钮上，供 updateQuickAccessGeometryForHost: 原地重算。
    CGFloat side = ERQuickAccessButtonSide();
    CGFloat glyphSide = round(side * 0.75);
    UIImage *image = [[self symbol:symbol size:MAX(11.0, round(side * 0.375))]
        imageWithTintColor:[UIColor colorWithWhite:1.0 alpha:0.97]
             renderingMode:UIImageRenderingModeAlwaysOriginal];
    [button setImage:nil forState:UIControlStateNormal];
    UIImageView *glyphView = [[UIImageView alloc] initWithImage:image];
    glyphView.userInteractionEnabled = NO;
    glyphView.contentMode = UIViewContentModeCenter;
    glyphView.translatesAutoresizingMaskIntoConstraints = NO;
    [button addSubview:glyphView];
    [NSLayoutConstraint activateConstraints:@[
        [glyphView.centerXAnchor constraintEqualToAnchor:button.centerXAnchor],
        [glyphView.centerYAnchor constraintEqualToAnchor:button.centerYAnchor],
        [glyphView.widthAnchor constraintEqualToConstant:glyphSide],
        [glyphView.heightAnchor constraintEqualToConstant:glyphSide],
    ]];
    [button bringSubviewToFront:glyphView];
    objc_setAssociatedObject(button, kERQuickAccessGlyphViewKey, glyphView, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(button, kERQuickAccessGlyphNameKey, symbol ?: @"", OBJC_ASSOCIATION_COPY_NONATOMIC);
    [button addTarget:self action:action forControlEvents:UIControlEventTouchUpInside];
    button.translatesAutoresizingMaskIntoConstraints = NO;
    button.accessibilityIdentifier = tag == 181001 ? @"EchoRebornAddButton" : @"EchoRebornPowerButton";
    return button;
}

- (void)setQuickAccessButtonsHidden:(BOOL)hidden forOverlay:(UIViewController *)overlay animated:(BOOL)animated {
    UIView *host = [overlay.view viewWithTag:181000];
    if (!host) return;
    BOOL shouldHide = hidden || !gQuickAccessButtonsEnabled;
    host.userInteractionEnabled = !shouldHide;
    if (!shouldHide && host.superview) [host.superview bringSubviewToFront:host];
    NSObject *token = [NSObject new];
    objc_setAssociatedObject(host, kERQuickAccessAnimationTokenKey, token, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    UIView *dismissalProxy = [overlay.view viewWithTag:kERQuickAccessDismissalProxyTag];
    if (!shouldHide && dismissalProxy && ERExpandedChromeRevealActive()) {
        [UIView performWithoutAnimation:^{
            host.hidden = NO;
            host.alpha = 0.0;
            host.transform = CGAffineTransformIdentity;
        }];
        return;
    }
    if (!shouldHide && ERExpandedChromeRevealActive() &&
        (!host.hidden || host.alpha > 0.05 || host.layer.animationKeys.count > 0)) {
        host.hidden = NO;
        return;
    }
    if (!shouldHide) host.hidden = NO;
    void (^changes)(void) = ^{
        host.alpha = shouldHide ? 0.0 : 1.0;
        host.transform = shouldHide ? CGAffineTransformMakeTranslation(0.0, -9.0) : CGAffineTransformIdentity;
        if (!shouldHide) ERSetQuickAccessMaterialsHidden(host, NO);
    };
    void (^completion)(BOOL) = ^(__unused BOOL finished) {
        // Expansion and presentation-state callbacks can overlap. Never let an
        // obsolete hide completion make the newly revealed chrome disappear.
        if (objc_getAssociatedObject(host, kERQuickAccessAnimationTokenKey) != token) return;
        host.hidden = shouldHide;
    };
    if (animated) {
        [UIView animateWithDuration:0.28 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:changes completion:completion];
    } else {
        changes();
        completion(YES);
    }
}

- (void)hideOwnedChromeForExpandedPlatterInOverlay:(UIViewController *)overlay {
    if (!overlay.view) return;
    UIView *quickAccess = [overlay.view viewWithTag:181000];
    quickAccess.hidden = YES;
    quickAccess.alpha = 0.0;
    UIView *topFade = [overlay.view viewWithTag:kERTopFadeTag];
    topFade.hidden = YES;
    topFade.alpha = 0.0;
    UIView *pageIndicators = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    pageIndicators.hidden = YES;
    pageIndicators.alpha = 0.0;
    UIView *duplicateHost = [overlay.view viewWithTag:kEROwnedDuplicateHostTag];
    duplicateHost.hidden = YES;
    duplicateHost.alpha = 0.0;
    for (UIView *subview in overlay.view.subviews) {
        if (subview.tag == kEREditGridTag || subview.tag == kEREditTouchShieldTag ||
            subview.tag == kERAddControlButtonTag || subview.tag == kERRemoveButtonTag ||
            subview.tag == kERResizeButtonTag || subview.tag == kERResizeBlurSnapshotTag) {
            subview.hidden = YES;
            subview.alpha = 0.0;
        }
    }
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        UIVisualEffectView *border = objc_getAssociatedObject(module.view, @selector(applyEditingToModule:editing:));
        border.hidden = YES;
        border.alpha = 0.0;
        UIButton *remove = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
        UIButton *resize = objc_getAssociatedObject(module.view, kERResizeButtonKey);
        remove.hidden = YES;
        remove.alpha = 0.0;
        resize.hidden = YES;
        resize.alpha = 0.0;
        // Hide the resized-presentation overlay only for the module actually
        // expanding: identifier match, or (for identifier-less expansions) the
        // module whose container is flagged expanded. Hiding all of them left
        // every resizable module label-less afterwards.
        BOOL moduleIsExpanding = [ERModuleIdentifier(module) isEqualToString:gERExpandedModuleIdentifier];
        if (!moduleIsExpanding && !gERExpandedModuleIdentifier.length) {
            @try {
                UIView *container = module.view;
                while (container && ![NSStringFromClass(container.class) isEqualToString:@"CCUIContentModuleContentContainerView"]) container = container.superview;
                moduleIsExpanding = [[container valueForKey:@"_expanded"] boolValue];
            } @catch (__unused NSException *exception) {}
        }
        if (moduleIsExpanding) {
            UIView *buttonView = ERFindSubviewWithClassName(module.view, @"CCUIButtonModuleView");
            UIView *presentation = [buttonView viewWithTag:kERResizePresentationTag] ?: [module.view viewWithTag:kERResizePresentationTag];
            presentation.hidden = YES;
            presentation.alpha = 0.0;
        }
    }
}

- (UIViewController *)moduleCollectionControllerInOverlay:(UIViewController *)overlay {
    NSMutableArray *queue = [NSMutableArray arrayWithObject:overlay];
    while (queue.count) {
        UIViewController *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if ([NSStringFromClass(candidate.class) containsString:@"ModuleCollectionViewController"]) return candidate;
        [queue addObjectsFromArray:candidate.childViewControllers];
    }
    return nil;
}

- (UIView *)ownedDuplicateHostForOverlay:(UIViewController *)overlay {
    if (!overlay.view) return nil;
    UIView *host = [overlay.view viewWithTag:kEROwnedDuplicateHostTag];
    if (!host) {
        host = [[EROwnedDuplicateHostView alloc] initWithFrame:overlay.view.bounds];
        host.tag = kEROwnedDuplicateHostTag;
        host.backgroundColor = UIColor.clearColor;
        host.opaque = NO;
        host.clipsToBounds = NO;
        host.userInteractionEnabled = YES;
        host.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
        if (collection.view && collection.view.superview == overlay.view) [overlay.view insertSubview:host aboveSubview:collection.view];
        else [overlay.view addSubview:host];
        host.hidden = YES;
        host.alpha = 0.0;
    } else if (host.superview != overlay.view) {
        [host removeFromSuperview];
        UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
        if (collection.view && collection.view.superview == overlay.view) [overlay.view insertSubview:host aboveSubview:collection.view];
        else [overlay.view addSubview:host];
    }
    host.frame = overlay.view.bounds;
    return host;
}

- (CGPoint)gridBaseOriginForOverlay:(UIViewController *)overlay {
    CGPoint fallback = CGPointMake(CGFLOAT_MAX, CGFLOAT_MAX);
    CGFloat span = ERVisualPageSpan();
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        if ([module isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
        NSString *identifier = ERModuleIdentifier(module);
        NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!nativeValue || !module.view) continue;
        CCUILayoutRect logical = {};
        [nativeValue getValue:&logical];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) logical.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *size = gERCustomSizes[identifier];
        if (size.count >= 2) logical.size = (CCUILayoutSize){size[0].unsignedIntegerValue, size[1].unsignedIntegerValue};
        if (!logical.size.width || !logical.size.height) continue;
        UIView *presentationWrapper = ERPresentationWrapperForModuleController(module);
        UIView *container = presentationWrapper.superview;
        CGRect frame = CGRectZero;
        if (container && [NSStringFromClass(container.class) containsString:@"ContentModuleContainerView"] && container.superview) {
            // Native presentation drives each container from a translated and
            // scaled closed state. Deriving the grid origin from convertRect:
            // therefore changed the duplicate layout base during the opening
            // animation. Recover the container's untransformed model rect from
            // its position/bounds so the base is the final grid origin from the
            // first frame onward.
            CGSize size = container.bounds.size;
            CGPoint anchor = container.layer.anchorPoint;
            CGPoint position = container.layer.position;
            CGRect untransformed = CGRectMake(position.x - anchor.x * size.width,
                                               position.y - anchor.y * size.height,
                                               size.width, size.height);
            frame = [container.superview convertRect:untransformed toView:overlay.view];
        } else {
            frame = [module.view convertRect:module.view.bounds toView:overlay.view];
        }
        if (CGRectIsEmpty(frame)) continue;
        NSUInteger page = ERPageForRect(logical);
        NSUInteger localRow = logical.origin.y % kERMinimumGridRows;
        NSUInteger layoutColumn = logical.origin.x;
        if (ERLandscapePresentationActive() && localRow >= kERLandscapeBlockRows) {
            // 横屏下这些行折到了右块：列 +4、行 -4。反推 baseline 必须同样换算，
            // 否则右块模块会把 baseX 少算 4 个步长（编辑/拖拽落点整体左偏）。
            layoutColumn += kERLandscapeBlockColumns;
            localRow -= kERLandscapeBlockRows;
        }
        CGFloat baseX = CGRectGetMinX(frame) - layoutColumn * kERGridStep;
        // 1.0.6-1（分页修正）：这里的 `frame` 是用上面那段 `container.layer.position`
        // + `bounds` 还原出来的**模型矩形**（1.0.4 为躲开开机动画期间的基准漂移，特意
        // 从 convertRect: 换成了它）。模型矩形**不随翻页移动** —— 分页是变换层做的，
        // 不是滚动（实机 PAGEGEO 里 by=0.0 而 sub=-1936.0 即为证）。
        //
        // 但补偿项仍按「frame 会跟着翻页动」来写，于是 base 被凭空塞进 +cur×span；
        // 而 layoutOwnedDuplicateModulesForOverlay: 又把 (page − cur)×span 加回去，
        // **cur 于是完全抵消** —— 磁贴的纵向位置只取决于它自己属于哪一页，翻页对它
        // 毫无作用。实机实测（span=968、step=88、base≈190）：
        //     第 0 页 → y ≈ 190      （看得见）
        //     第 1 页 → y ≈ 1158     （屏幕外）
        //     第 2 页 → y ≈ 2126+88L （屏幕外）← 13 块快捷指令磁贴都在这
        //     第 3 页 → y ≈ 3094     （屏幕外）← 另 1 块在这
        // 与 cur 取值无关，所以翻到哪一页都看不见。这就是「磁贴确实存在、但是不显示」。
        //
        // 正解：模型矩形里已经含有该模块所属页的绝对偏移，所以只减 **page**，
        // 不要减当前页。对照参照 —— 本文件编辑网格那处同款公式（另一处 baseY）
        // 取的是 convertRect: 的表现矩形，保留 (page − cur) 是正确的：
        // **这个补偿项只能配表现矩形，不能配模型矩形。**
        CGFloat baseY = CGRectGetMinY(frame) - localRow * kERGridStep - ((CGFloat)(NSInteger)page * span) - gERPagerInteractiveTranslation;
        fallback.x = MIN(fallback.x, baseX);
        fallback.y = MIN(fallback.y, baseY);
    }
    if (fallback.x == CGFLOAT_MAX || fallback.y == CGFLOAT_MAX) {
        CGFloat width = overlay.view ? CGRectGetWidth(overlay.view.bounds) : CGRectGetWidth(UIScreen.mainScreen.bounds);
        return CGPointMake((width - ERGridVisibleWidth()) * 0.5, 125.0);
    }
    return fallback;
}

- (void)syncOwnedDuplicateModulesForOverlay:(UIViewController *)overlay {
    if (!overlay.view) return;
    // 1.0.6：先修账本再统计。以前这行打印的是账本条目数，却写成「已登记磁贴数」——
    // 坏账（值为空串）明明一个磁贴都创建不出来，日志却报「10 owned tile(s)
    // registered」，把排查方向长期带偏。现在打印的是账本条目数与**实际挂载数**。
    NSUInteger ledgerCount = gERDuplicateFamilies.count;
    ERRepairDuplicateLedger();
    NSUInteger attachedCount = 0;
    for (UIViewController *child in overlay.childViewControllers) {
        if ([child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) attachedCount++;
    }
    ERLogInfo(@"sync: ledger=%lu attached=%lu owned tile(s)",
              (unsigned long)ledgerCount, (unsigned long)attachedCount);
    UIView *host = [self ownedDuplicateHostForOverlay:overlay];
    NSMutableDictionary<NSString *, EROwnedDuplicateModuleViewController *> *existing = [NSMutableDictionary dictionary];
    for (UIViewController *child in overlay.childViewControllers) {
        if (![child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
        EROwnedDuplicateModuleViewController *duplicate = (EROwnedDuplicateModuleViewController *)child;
        if (duplicate.moduleIdentifier.length) existing[duplicate.moduleIdentifier] = duplicate;
    }
    for (NSString *identifier in existing.allKeys) {
        if (gERDuplicateFamilies[identifier]) continue;
        UIViewController *stale = existing[identifier];
        UIView *container = objc_getAssociatedObject(stale, kEROwnedDuplicateContainerKey);
        [stale willMoveToParentViewController:nil];
        [container removeFromSuperview];
        if (!container) [stale.view removeFromSuperview];
        [stale removeFromParentViewController];
        [existing removeObjectForKey:identifier];
    }
    for (NSString *identifier in gERDuplicateFamilies) {
        if (!identifier.length) continue;
        NSString *baseIdentifier = gERDuplicateFamilies[identifier];
        // 1.0.6：值缺失/非法时按标识符自身兜底，而不是整条跳过。跳过等于「这块磁贴
        // 不属于任何 family」，后面每一处布局都会把它 continue 掉，磁贴从此不可能被
        // 创建 —— 这正是「快捷指令磁贴不显示」最直接的那条路径。
        //
        // 补齐动作统一由本方法开头的 ERRepairDuplicateLedger() 完成；这里只做兜底，
        // 绝不在遍历 gERDuplicateFamilies 的过程中回写它 —— 那会触发
        // "collection was mutated while being enumerated" 崩溃。
        if (![baseIdentifier isKindOfClass:[NSString class]] || !baseIdentifier.length) {
            baseIdentifier = identifier;
        }
        EROwnedDuplicateModuleViewController *duplicate = existing[identifier];
        BOOL createdDuplicate = NO;
        if (!duplicate) {
            duplicate = [[EROwnedDuplicateModuleViewController alloc] initWithModuleIdentifier:identifier baseIdentifier:baseIdentifier];
            [overlay addChildViewController:duplicate];
            UIView *container = [[UIView alloc] initWithFrame:CGRectZero];
            container.backgroundColor = UIColor.clearColor;
            container.opaque = NO;
            container.clipsToBounds = NO;
            UIView *presentation = [[UIView alloc] initWithFrame:CGRectZero];
            presentation.backgroundColor = UIColor.clearColor;
            presentation.opaque = NO;
            presentation.clipsToBounds = NO;
            [container addSubview:presentation];
            [presentation addSubview:duplicate.view];
            [host addSubview:container];
            objc_setAssociatedObject(duplicate, kEROwnedDuplicateContainerKey, container, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(duplicate, kEROwnedDuplicatePresentationKey, presentation, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [duplicate didMoveToParentViewController:overlay];
            existing[identifier] = duplicate;
            createdDuplicate = YES;
        } else {
            UIView *container = objc_getAssociatedObject(duplicate, kEROwnedDuplicateContainerKey);
            UIView *presentation = objc_getAssociatedObject(duplicate, kEROwnedDuplicatePresentationKey);
            if (!container || !presentation) {
                [duplicate.view removeFromSuperview];
                container = [[UIView alloc] initWithFrame:CGRectZero];
                container.backgroundColor = UIColor.clearColor;
                container.opaque = NO;
                container.clipsToBounds = NO;
                presentation = [[UIView alloc] initWithFrame:CGRectZero];
                presentation.backgroundColor = UIColor.clearColor;
                presentation.opaque = NO;
                presentation.clipsToBounds = NO;
                [container addSubview:presentation];
                [presentation addSubview:duplicate.view];
                objc_setAssociatedObject(duplicate, kEROwnedDuplicateContainerKey, container, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                objc_setAssociatedObject(duplicate, kEROwnedDuplicatePresentationKey, presentation, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
            if (container.superview != host) {
                [container removeFromSuperview];
                [host addSubview:container];
            }
        }
        NSValue *baseSize = gERBaseLayoutSizes[baseIdentifier] ?: gERProviderSizes[baseIdentifier];
        CCUILayoutSize size = {1, 1};
        if (baseSize) [baseSize getValue:&size];
        if (!size.width) size.width = 1;
        if (!size.height) size.height = 1;
        gERBaseLayoutSizes[identifier] = [NSValue value:&size withObjCType:@encode(CCUILayoutSize)];
        CCUILayoutRect rect = {(CCUILayoutPoint){0, 0}, size};
        NSValue *nativeValue = gERNativeLayoutRects[identifier];
        if (nativeValue) [nativeValue getValue:&rect];
        rect.size = size;
        gERNativeLayoutRects[identifier] = [NSValue value:&rect withObjCType:@encode(CCUILayoutRect)];
        if (createdDuplicate || ![duplicate.view viewWithTag:kERResizePresentationTag]) {
            [self applyRefinedLookToModule:duplicate];
        }
    }
    [self layoutOwnedDuplicateModulesForOverlay:overlay];
}

// 1.0.6-8（第 3 条）：原生网格锚点。
//
// 磁贴的纵向基准此前是「自己算出来的 base」：gridBaseOriginForOverlay: 用
// container.layer.position + bounds 把模块位置还原成**模型矩形**（1.0.4 为躲开机型
// 开机动画期间的基准漂移，特意从 convertRect: 换成了它），再从一堆模块里取最小值
// 反推网格原点。问题是这套还原量出来的空间与「系统真正把模块摆在屏幕上的那个空间」
// 并不重合。实机 220436 日志同一时刻（cur=2、trans=0）：
//     原生 LowPower (cell{2,16}, row 0) frame.y = 114.0
//     原生 general  (cell{3,17}, row 1) frame.y = 202.0     ← 步距精确 88，网格本身没问题
//     而三块磁贴 self.y = 426 / 514 / 602，按 row 3/4/5 应为 378 / 466 / 554
//     ⇒ 三块**同时、同量**低了 48pt。是常数偏移，与尺寸、步距都无关。
//
// 同一份日志还证明拖动时磁贴完全不跟手：原生参照的 Y 随 trans 精确平移
// （1218.0 → 1177.7，正好 −40.3），而磁贴纹丝不动 —— 因为 baseY 里减了一次
// gERPagerInteractiveTranslation，磁贴定位又加了一次，恰好抵消。
//
// 正解是不要再自己造基准：**直接锚在一块原生模块的实测 frame 上**。原生模块由系统
// 按真实网格摆放，它就是用户眼睛里那套基准（也是编辑模式里那 32 个圆的基准），
// 而它的 frame 天然带着翻页/拖动的位移。于是
//     tileY = anchorY + (tileRow − anchorRow) × step + (tilePage − anchorPage) × span
// 既自动落在同一格上（消掉 48pt 常数），又自动跟手（不再有 trans 抵消），也不需要
// cur —— 少一个自由度就少一处能算错的地方。X 轴保持原样：日志里 dCells.x 一直是
// 整数（−1.00 / −3.00 / 0.00），说明 X 本来就是对的那一侧，不动它。
typedef struct {
    BOOL valid;
    CGRect frame;          // 锚点模块在 host 坐标系里的 frame
    NSInteger physicalRow; // 已做过横屏折行换算的物理行号
    NSInteger page;
} ERGridAnchorRef;

// 1.0.6-9（第 3 / 4 条）：锚点选择规则重写。
//
// 上一版有两个问题，一个关于代价、一个关于正确性：
//
//  【代价（第 4 条）】每帧、每页、最多两轮**全量 BFS**（ERCollectModuleControllers）
//  加两次 convertRect:。它跑在展示同步 display link 的每帧路径上，代价随页数线性增长：
//  6 页最坏就是 12 次 BFS + 12 次跨视图坐标换算。这是本版必须消掉的主线程开销。
//
//  【正确性（第 3 条）】「BFS 里第一个命中的模块」可能是**任意一页**的模块。跨页时
//  磁贴位置 = 锚点Y + 行差×step + 页差×span，页差越大，span（页跨度）本身的误差
//  被放大得越多；用户报的「只有第 3 页滑过去模块慢慢落下来一点才恢复」正是这种
//  「基准离得太远/基准自己在动」的表现。现在改为：
//     同页优先 → 页距最近优先（不再是「碰到的第一个」），
//     并且排除正在被拖动的模块（它的 frame 正随手指跑，不是基准）。
//
//  【稳定性】选中的标识符按页记住，跨帧复用；每帧只对这一个视图做一次 convertRect:。
//  模块被删/被换导致标识符失效时，当帧重新选择。选择发生变化才落一行 SHORTCUTANCHOR，
//  一行日志就能确认「第 3 页的基准到底是谁」。
static NSMutableDictionary<NSNumber *, NSString *> *gERGridAnchorIdentifierByPage = nil;

static void ERResetGridAnchorCache(void) {
    [gERGridAnchorIdentifierByPage removeAllObjects];
}

// 量一个候选：能当基准才返回 YES。逻辑矩形（含用户改过的 origin）→ 页号 / 物理行，
// 视图 frame → host 坐标系。
static BOOL ERGridAnchorMeasure(UIViewController *candidate, NSString *identifier, UIView *host,
                                NSUInteger *outPage, NSInteger *outRow, CGRect *outFrame) {
    if (!candidate || !identifier.length) return NO;
    UIView *view = candidate.view;
    // 不在窗口里的视图量不出可用 frame：锚点必须是**已经摆上屏幕**的模块。
    if (!view || !view.window) return NO;
    NSValue *nativeValue = gERNativeLayoutRects[identifier];
    if (!nativeValue) return NO;
    CCUILayoutRect logical = {};
    [nativeValue getValue:&logical];
    NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
    if (origin.count >= 2) {
        logical.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
    }
    if (!logical.size.width || !logical.size.height) return NO;
    CGRect frame = [view convertRect:view.bounds toView:host];
    if (CGRectIsEmpty(frame)) return NO;
    NSInteger row = (NSInteger)(logical.origin.y % kERMinimumGridRows);
    // 横屏下高行会折到右块（列 +4、行 −4）。锚点与磁贴都先折成物理行，
    // 行差才等于屏幕上真实的行差。
    if (ERLandscapePresentationActive() && row >= (NSInteger)kERLandscapeBlockRows) {
        row -= (NSInteger)kERLandscapeBlockRows;
    }
    if (outPage) *outPage = ERPageForRect(logical);
    if (outRow) *outRow = row;
    if (outFrame) *outFrame = frame;
    return YES;
}

// 1.0.6-9：`modules` 由调用方传进来（一次 BFS 供全部页共用）。传 nil 时本函数自行收集，
// 保持对旧调用点的兼容。
static ERGridAnchorRef ERGridAnchorForTilePage(UIViewController *overlay, UIView *host,
                                               NSArray<UIViewController *> *modules,
                                               NSUInteger tilePage) {
    ERGridAnchorRef anchor = { NO, CGRectZero, 0, 0 };
    if (!overlay || !host) return anchor;
    if (!modules) modules = ERCollectModuleControllers(overlay);
    if (!gERGridAnchorIdentifierByPage) gERGridAnchorIdentifierByPage = [NSMutableDictionary dictionary];

    // 命中缓存：只量一次 convertRect:，不做任何候选筛选。
    NSString *cachedIdentifier = gERGridAnchorIdentifierByPage[@(tilePage)];
    if (cachedIdentifier.length) {
        for (UIViewController *candidate in modules) {
            if (ERIsOwnedDuplicateModuleController(candidate)) continue;
            if (![ERModuleIdentifier(candidate) isEqualToString:cachedIdentifier]) continue;
            // 注意形参类型：页号是 NSUInteger，行号是 NSInteger —— 与结构体字段的
            // NSInteger page 不同，必须用局部变量中转，不能直接把 &anchor.page 传进去。
            NSUInteger cachedPage = 0;
            NSInteger cachedRow = 0;
            CGRect cachedFrame = CGRectZero;
            if (ERGridAnchorMeasure(candidate, cachedIdentifier, host, &cachedPage, &cachedRow, &cachedFrame)) {
                anchor.valid = YES;
                anchor.page = (NSInteger)cachedPage;
                anchor.physicalRow = cachedRow;
                anchor.frame = cachedFrame;
                return anchor;
            }
            break;
        }
        // 那个模块没了（被删 / 被换 / 还没摆上屏幕）：本帧重新选，不改动其它页。
        [gERGridAnchorIdentifierByPage removeObjectForKey:@(tilePage)];
    }

    // 首次选择，或缓存失效：同页优先，其次页距最近。
    NSString *bestIdentifier = nil;
    ERGridAnchorRef best = { NO, CGRectZero, 0, 0 };
    NSUInteger bestDistance = NSUIntegerMax;
    for (UIViewController *candidate in modules) {
        if (ERIsOwnedDuplicateModuleController(candidate)) continue;
        NSString *identifier = ERModuleIdentifier(candidate);
        if (!identifier.length) continue;
        if (ERShortcutIdentifierIsShortcut(identifier)) continue;
        // 拖动中的模块 frame 正随手指跑，拿它当基准等于把基准绑在手指上。
        if (ERIsActiveDragModuleIdentifier(identifier)) continue;
        NSUInteger page = 0;
        NSInteger row = 0;
        CGRect frame = CGRectZero;
        if (!ERGridAnchorMeasure(candidate, identifier, host, &page, &row, &frame)) continue;
        NSUInteger distance = (page > tilePage) ? (page - tilePage) : (tilePage - page);
        if (best.valid && distance >= bestDistance) continue;
        bestDistance = distance;
        bestIdentifier = identifier;
        best.valid = YES;
        best.frame = frame;
        best.physicalRow = row;
        best.page = (NSInteger)page;
    }
    // 1.0.6-10（第 1 条）：锚点求解在每页、每次布局都会跑，本行同样落在翻页热路径上。
    // 闸门只影响这一行诊断，锚点缓存（上一句的赋值）与返回值完全不受影响。
    BOOL anchorDiag = ERDiagShouldLog(@"SHORTCUTANCHOR", 1.0);
    if (best.valid && bestIdentifier.length) {
        gERGridAnchorIdentifierByPage[@(tilePage)] = bestIdentifier;
        if (anchorDiag) {
            ERLogInfo(@"SHORTCUTANCHOR ver=1.0.9-103 tilePage=%lu anchor=%@ anchorPage=%ld anchorRow=%ld dist=%lu frame={%.1f,%.1f,%.0fx%.0f}",
                      (unsigned long)tilePage, bestIdentifier, (long)best.page, (long)best.physicalRow,
                      (unsigned long)bestDistance, best.frame.origin.x, best.frame.origin.y,
                      best.frame.size.width, best.frame.size.height);
        }
    } else if (anchorDiag) {
        // 整页（以及所有页）都没有可用的原生模块 —— 只能走 base 回退。这一行就是回退的证据。
        ERLogInfo(@"SHORTCUTANCHOR ver=1.0.9-103 tilePage=%lu anchor=(none) candidates=%lu",
                  (unsigned long)tilePage, (unsigned long)modules.count);
    }
    return best;
}

- (void)layoutOwnedDuplicateModulesForOverlay:(UIViewController *)overlay {


    UIView *host = [overlay.view viewWithTag:kEROwnedDuplicateHostTag];
    if (!host) return;
    if (host.superview != overlay.view) {
        [host removeFromSuperview];
        UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
        if (collection.view && collection.view.superview == overlay.view) [overlay.view insertSubview:host aboveSubview:collection.view];
        else [overlay.view addSubview:host];
    }
    host.frame = overlay.view.bounds;
    CGPoint base = [self gridBaseOriginForOverlay:overlay];
    CGFloat span = ERVisualPageSpan();
    CGFloat scrubScaleX = gERPagerHeldScale * gERPagerJelloScaleX;
    CGFloat scrubScaleY = gERPagerHeldScale * gERPagerJelloScaleY;
    CGPoint scrubCenter = CGPointMake(CGRectGetMidX(overlay.view.bounds), CGRectGetMidY(overlay.view.bounds));
    // 1.0.6-1（自验证）：分页修正的正确性只用一行就能判定。这里把基准、页跨度、步长、
    // 当前页与页数打出来 —— 任何一块磁贴的预期位置都能据此算出：
    //     predictedY = base.y + localRow * step + (page − cur) * span
    // 与同一时刻 SHORTCUTVIS 里的 center.y 对照：
    //   · 修好后  base.y 应当**与 cur 无关**（≈190），第 2 页磁贴在 cur=2 时落在
    //     y ≈ 190 + 88L（屏幕内），cur=0 时才落到 2126 附近（屏幕外）
    //   · 若 base.y 仍随 cur 每页增加 968，说明存在反向补偿，需要改另一侧
    {
        // 1.0.6-12（第 4 条）：闸门前置 + 记忆集封顶。
        //
        // 原实现「用一个只增不减的 NSMutableSet 去重」有两个问题：
        //   ① 去重前要先构造那条含 5 个浮点的 state 字符串，仍在主线程上；
        //   ② 记忆集永不清理，条目随会话线性增长，containsObject: 越来越慢。
        // 一次会话仍落了 89 行。现在改为 1 行/秒，且集合超过上限即整体丢弃重建
        // （诊断价值不丢：只要还有变化，下一秒仍会重新记录）。
        if (ERDiagShouldLog(@"BASEGEO", 1.0)) {
            static NSMutableSet<NSString *> *erBaseGeoLoggedStates;
            if (!erBaseGeoLoggedStates) erBaseGeoLoggedStates = [NSMutableSet set];
            if (erBaseGeoLoggedStates.count > 200) [erBaseGeoLoggedStates removeAllObjects];
            NSString *state = [NSString stringWithFormat:@"base={%.1f,%.1f} span=%.1f step=%.0f cur=%lu pages=%lu trans=%.1f",
                               base.x, base.y, span, (double)kERGridStep,
                               (unsigned long)gERCurrentPage, (unsigned long)gERPageCount,
                               (double)gERPagerInteractiveTranslation];
            if (![erBaseGeoLoggedStates containsObject:state]) {
                [erBaseGeoLoggedStates addObject:state];
                ERLogInfo(@"BASEGEO ver=1.0.9-103 %@", state);
            }
        }
    }
    // 1.0.6-9（第 4 条）：本方法的耗时探头。单帧超过 4ms 就已经吃掉 60Hz 四分之一的
    // 预算，所以只在超阈值时落一行、且每秒最多一行 —— 让「卡」变成可量化的数字，
    // 而不是感觉。
    CFTimeInterval erPerfLayoutStart = CACurrentMediaTime();
    NSUInteger erPerfTileCount = 0;
    // 1.0.6-9（第 3 / 4 条）：一次 BFS 供所有页共用。上一版是把收集放在锚点求解里，
    // 于是「每页 × 最多两轮」各跑一遍；本版只跑一次。
    NSArray<UIViewController *> *anchorModules = ERCollectModuleControllers(overlay);
    // 1.0.6-8（第 3 条）：本帧的原生锚点缓存，键是页号。
    NSMutableDictionary<NSNumber *, NSValue *> *anchorCache = [NSMutableDictionary dictionary];
    for (UIViewController *child in overlay.childViewControllers) {
        if (![child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
        NSString *identifier = ERModuleIdentifier(child);
        NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!nativeValue) continue;
        CCUILayoutRect rect = {};
        [nativeValue getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *size = gERCustomSizes[identifier];
        if (size.count >= 2) rect.size = (CCUILayoutSize){size[0].unsignedIntegerValue, size[1].unsignedIntegerValue};
        if (!rect.size.width) rect.size.width = 1;
        if (!rect.size.height) rect.size.height = 1;
        NSUInteger page = ERPageForRect(rect);
        NSUInteger localRow = rect.origin.y % kERMinimumGridRows;
        CGSize pointSize = [self catalogPointSizeForLayoutSize:rect.size];
        // 1.0.6-8（第 3 条）：纵向基准改锚原生模块（见 ERGridAnchorForTilePage 的说明）。
        // 按页缓存：同一页的磁贴共用一块原生模块做基准，一帧只量一次 convertRect:。
        NSNumber *anchorKey = @(page);
        NSValue *cachedAnchor = anchorCache[anchorKey];
        if (!cachedAnchor) {
            ERGridAnchorRef measured = ERGridAnchorForTilePage(overlay, host, anchorModules, page);
            cachedAnchor = [NSValue valueWithBytes:&measured objCType:@encode(ERGridAnchorRef)];
            anchorCache[anchorKey] = cachedAnchor;
        }
        ERGridAnchorRef anchor = { NO, CGRectZero, 0, 0 };
        [cachedAnchor getValue:&anchor];
        CGFloat tileY = base.y + localRow * kERGridStep +
                        ((CGFloat)((NSInteger)page - (NSInteger)gERCurrentPage) * span) +
                        gERPagerInteractiveTranslation;
        if (anchor.valid) {
            NSInteger physicalRow = (NSInteger)localRow;
            if (ERLandscapePresentationActive() && physicalRow >= (NSInteger)kERLandscapeBlockRows) {
                physicalRow -= (NSInteger)kERLandscapeBlockRows;
            }
            tileY = CGRectGetMinY(anchor.frame) +
                    (CGFloat)(physicalRow - anchor.physicalRow) * kERGridStep +
                    (CGFloat)((NSInteger)page - anchor.page) * span;
        }
        CGRect frame = CGRectMake(base.x + rect.origin.x * kERGridStep,
                                  tileY,
                                  pointSize.width,
                                  pointSize.height);
        UIView *container = objc_getAssociatedObject(child, kEROwnedDuplicateContainerKey);
        UIView *presentation = objc_getAssociatedObject(child, kEROwnedDuplicatePresentationKey);
        if (!container || !presentation) continue;
        // 1.0.7-21（用户第 4 条）：收尾期间布局不再摆放磁贴。实测录屏里残留磁贴的
        // 位置正是「关闭动画进行到一半时锚点模块的瞬时 frame」被这里重新摆出来的；
        // 抑制期内跳过摆放，等下次呈现（state 1/2）再恢复。
        if (gERDismissSuppressDuplicates) continue;
        CGPoint frameCenter = CGPointMake(CGRectGetMidX(frame), CGRectGetMidY(frame));
        if (gERPagerScrubbingActive) {
            frameCenter.x = scrubCenter.x + (frameCenter.x - scrubCenter.x) * scrubScaleX;
            frameCenter.y = scrubCenter.y + (frameCenter.y - scrubCenter.y) * scrubScaleY;
        }
        container.bounds = (CGRect){CGPointZero, pointSize};
        container.center = frameCenter;
        presentation.bounds = (CGRect){CGPointZero, pointSize};
        presentation.center = CGPointMake(pointSize.width * 0.5, pointSize.height * 0.5);
        child.view.bounds = (CGRect){CGPointZero, pointSize};
        child.view.center = CGPointMake(pointSize.width * 0.5, pointSize.height * 0.5);
        child.view.layer.cornerRadius = [self refinedCornerRadiusForSize:pointSize];
        child.view.layer.cornerCurve = kCACornerCurveContinuous;
        child.view.layer.masksToBounds = YES;
        // 1.0.1：快捷指令磁贴的呈现层只在 -applyRefinedLookToModule: 里绘了一次，
        // 而那一刻磁贴的 bounds 还是 0（几何要到本方法才定），于是图标/文字的尺寸
        // 是按 0 算的。这里在几何确定之后补一次布局，让呈现层按真实边长重画。
        if (ERShortcutIdentifierIsShortcut(identifier)) {
            erPerfTileCount++;
            ERConfigureOddResizedModuleLayout(child);
        }
        if (gEditModeActive) {
            BOOL activeDragSource = ERIsActiveDragModuleIdentifier(identifier);
            CGRect viewport = CGRectInset(overlay.view.bounds, -24.0, -24.0);
            CGRect overlayFrame = [child.view convertRect:child.view.bounds toView:overlay.view];
            BOOL ownerVisible = !activeDragSource && !ERModuleViewIsPageHidden(child.view) && CGRectIntersectsRect(overlayFrame, viewport);
            UIVisualEffectView *border = objc_getAssociatedObject(child.view, @selector(applyEditingToModule:editing:));
            UIButton *remove = objc_getAssociatedObject(child.view, kERRemoveButtonKey);
            UIButton *resize = objc_getAssociatedObject(child.view, kERResizeButtonKey);
            if (border && !gERResizeInProgress) {
                CGRect presentationFrame = CGRectMake(CGRectGetMinX(child.view.frame), CGRectGetMinY(child.view.frame),
                                                      CGRectGetWidth(child.view.bounds), CGRectGetHeight(child.view.bounds));
                [self configureEditingBorder:border moduleFrame:presentationFrame];
                border.hidden = !ownerVisible || !gModuleBordersEnabled;
                border.alpha = ownerVisible && gModuleBordersEnabled ? 1.0 : 0.0;
            }
            if (remove) {
                remove.hidden = !ownerVisible || !gRemovalButtonsEnabled;
                remove.alpha = ownerVisible && gRemovalButtonsEnabled ? 1.0 : 0.0;
            }
            BOOL supportsResize = [self moduleIdentifierSupportsResizing:identifier];
            if (resize) {
                resize.hidden = !ownerVisible || !supportsResize;
                resize.alpha = ownerVisible && supportsResize ? 1.0 : 0.0;
            }
            [self positionEditControlsForModuleView:child.view overlay:overlay overlayFrame:overlayFrame];
            if (remove && !remove.hidden) [remove.superview bringSubviewToFront:remove];
            if (resize && !resize.hidden) [resize.superview bringSubviewToFront:resize];
        }
    }
    UIView *hitBridge = [overlay.view viewWithTag:kERExtendedHitBridgeTag];
    if (hitBridge) [overlay.view bringSubviewToFront:hitBridge];
    UIView *addControl = [overlay.view viewWithTag:kERAddControlButtonTag];
    if (addControl && !addControl.hidden) [overlay.view bringSubviewToFront:addControl];
    // 1.0.6-8（第 4 条）：退出淡出窗口内，本方法尾部一律不许点亮磁贴 ——
    // 这里对页内磁贴写的是 presentation.layer.opacity = 1.0，与淡出争同一个属性。
    // 末一条与 updateOwnedDuplicateHostForOverlay: 的「闸门三」同口径：只要最近一次
    // 呈现方向是「走」且不处在呈现态，就不许把刚淡掉的磁贴再点亮回来。
    if (gERControlCenterPresented && !gEROwnedDuplicateHostDisplayLink && !gERExpandedModuleOpen &&
        !gERDismissSuppressDuplicates &&
        CACurrentMediaTime() >= gEROwnedDuplicateFadeOutUntil &&
        (gEROwnedDuplicateHostSyncPresented ||
         gERControlCenterPresentationState == 1 || gERControlCenterPresentationState == 2)) {
        host.transform = CGAffineTransformIdentity;
        host.alpha = gERPagerScrubbingActive ? gERPagerHeldAlphaFactor : 1.0;
        for (UIViewController *child in overlay.childViewControllers) {
            if (![child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
            UIView *container = objc_getAssociatedObject(child, kEROwnedDuplicateContainerKey);
            UIView *presentation = objc_getAssociatedObject(child, kEROwnedDuplicatePresentationKey);
            container.transform = CGAffineTransformIdentity;
            presentation.transform = gERPagerScrubbingActive ?
                CGAffineTransformMakeScale(scrubScaleX, scrubScaleY) :
                CGAffineTransformIdentity;
            // 1.0.6-6（第 4 条）：这两行原来对**页外磁贴也无条件执行**，等于每次布局都把
            // 页外磁贴点亮一次；而分页裁剪（updatePagedModuleVisibilityForOverlay:）只在
            // 裁剪回合里把 layer.opacity 压回 0。本文件有多处只调布局、不跟一次裁剪，
            // 页外磁贴于是会以 opacity=1 露出一帧 —— 正是用户报的「滑动退出时先显示该页
            // 全部快捷指令模块、随后消失」。
            //
            // 页内磁贴照旧点亮；页外磁贴的可见性完全交给分页裁剪，那里才是唯一权威。
            if (ERPageForModuleIdentifier(ERModuleIdentifier(child)) == gERCurrentPage) {
                // 另一处同类来源：退出控制中心时 animateOwnedDuplicateHostForOverlay:
                // 会做一段 0.18 秒的整体淡出，把 presentation.opacity 动画到 0；若恰好在
                // 这段时间里跑一次布局，把这个值硬设回 1.0 就会**在淡出过程中闪一下**
                // （用户看到的正是「先显示该页全部快捷指令模块、随后消失」）。
                // 判据用呈现层与模型层是否背离 —— 只在真的处于动画中时让路，静态时照旧
                // 拉满，不影响正常显示。
                CALayer *livePresentation = (CALayer *)presentation.layer.presentationLayer;
                BOOL fadeAnimating = livePresentation &&
                    fabs(livePresentation.opacity - presentation.layer.opacity) > 0.01;
                if (!fadeAnimating) {
                    presentation.layer.opacity = 1.0;
                    child.view.alpha = 1.0;
                }
            }
        }
    }
    // 1.0.6-9（第 4 条）：耗时探头。判据只有一条 —— 本方法单帧超过 4ms 就落一行，
    // 并且每秒最多一行。4ms 是 60Hz（16.7ms）的四分之一预算；连续超阈值就是用户
    // 主观感到的「卡」。tiles 是本次布局处理过的快捷指令磁贴数，用来判断开销是否
    // 随页数线性增长。
    {
        CFTimeInterval elapsed = CACurrentMediaTime() - erPerfLayoutStart;
        if (elapsed > 0.004) {
            static CFTimeInterval erPerfLastLog = 0.0;
            static NSUInteger erPerfSlowCount = 0;
            erPerfSlowCount++;
            CFTimeInterval now = CACurrentMediaTime();
            if (now - erPerfLastLog > 1.0) {
                erPerfLastLog = now;
                ERLogInfo(@"ERPERF ver=1.0.9-103 layout=%.2fms slow=%lu tiles=%lu modules=%lu edit=%d scrub=%d link=%d",
                          elapsed * 1000.0, (unsigned long)erPerfSlowCount, (unsigned long)erPerfTileCount,
                          (unsigned long)anchorModules.count, gEditModeActive ? 1 : 0,
                          gERPagerScrubbingActive ? 1 : 0, gEROwnedDuplicateHostDisplayLink ? 1 : 0);
            }
        }
    }
}

- (void)installQuickAccessHostOnOverlay:(UIViewController *)controller {
    if (!gEnabled || !controller.view) return;
    UIView *existingHost = [controller.view viewWithTag:181000];
    if (existingHost) {
        existingHost.userInteractionEnabled = gQuickAccessButtonsEnabled;
        // 0.5.17: host 只会被真正创建一次。宽度是安装那一刻按当时的宽度算出来的常量，
        // 所以「先在竖屏装好、再转横屏」时，这条约束会一直停在 430pt，电源键就卡在
        // 屏幕中间（实测 x=387.8，正是 430−22−20）。方向相关的几何必须在这里补刷新。
        [self updateQuickAccessGeometryForHost:existingHost overlay:controller];
        return;
    }
    // Keep this strictly inside the overlay. The system status-bar superview is
    // owned above Control Center and survives dismissal, which leaks buttons
    // onto the Home Screen. Header pocket is overlay-scoped and still carries
    // the native top-chrome presentation transform.
    UIView *animationHost = ERFindSubviewWithClassName(controller.view, @"CCUIHeaderPocketView");
    if (!animationHost) {
        @try {
            id candidate = [(id)controller valueForKey:@"overlayHeaderView"];
            if ([candidate isKindOfClass:[UIView class]]) animationHost = candidate;
        } @catch (__unused NSException *exception) {}
    }
    if (!animationHost) animationHost = controller.view;
    UIView *host = [[ERQuickAccessHostView alloc] initWithFrame:CGRectZero];
    host.tag = 181000;
    host.backgroundColor = UIColor.clearColor;
    host.userInteractionEnabled = YES;
    host.translatesAutoresizingMaskIntoConstraints = NO;
    // 1.0.9-16 · **回退到已验证可见的挂载方式**（1.0.9-12 的状态）：
    //   1.0.9-13 挂 overlay 根视图 → 完全看不见
    //   1.0.9-14 再加置顶     → 仍看不见
    //   1.0.9-15 挂窗口层     → 仍看不见
    // 另外 `installQuickAccessHostOnOverlay:` 用 `[controller.view viewWithTag:181000]` 判断
    // host 是否已存在 —— 挂到 controller.view 之外时这个判断会失效、host 被反复重建。
    // 所以挂载方式必须回到原来的 animationHost；胶囊带来的漂移交给保活定时器抵消。
    [animationHost addSubview:host];
    animationHost.clipsToBounds = NO;
    CGRect hostFrameInOverlay = [animationHost convertRect:animationHost.bounds toView:controller.view];
    CGFloat hostOriginY = MAX(CGRectGetMinY(animationHost.frame), CGRectGetMinY(hostFrameInOverlay));
    CGFloat hostOriginX = MAX(CGRectGetMinX(animationHost.frame), CGRectGetMinX(hostFrameInOverlay));
    // 0.5.17: 宽度取窗口宽度（会转屏），并把约束留个句柄供方向变化时原地更新。
    // 原实现用 CGRectGetWidth(controller.view.bounds)，横屏下仍是竖屏的 430pt。
    NSLayoutConstraint *hostWidthConstraint = [host.widthAnchor constraintEqualToConstant:ERQuickAccessHostWidth(controller)];
    objc_setAssociatedObject(host, kERQuickAccessWidthConstraintKey, hostWidthConstraint, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    ERStartQuickAccessPositionCorrection();   // 1.0.9-12 · 启动位置校正（每 100ms 把漂移抵消掉）
    // 1.0.9-16 · 约束锚点回到 animationHost（与可见版本逐字一致）；漂移由保活定时器用 transform 抵消。
    NSLayoutYAxisAnchor *topAnchorRef = animationHost.topAnchor;
    NSLayoutXAxisAnchor *leadingAnchorRef = animationHost.leadingAnchor;
    [NSLayoutConstraint activateConstraints:@[
        [host.topAnchor constraintEqualToAnchor:topAnchorRef constant:-hostOriginY],
        [host.leadingAnchor constraintEqualToAnchor:leadingAnchorRef constant:-hostOriginX],
        hostWidthConstraint,
        [host.heightAnchor constraintEqualToConstant:76.0]
    ]];

    UIView *materialRoot = controller.view;
    for (UIViewController *module in ERCollectModuleControllers(controller)) {
        if (!module.view || module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
        materialRoot = module.view;
        break;
    }

    CGFloat buttonCenterY = ERQuickAccessCenterYOffset(controller);
    // 1.0.9-8 · QABTN-PROBE（只读）：上一版条件太严（要求横屏且只在创建时执行）→ 零命中。
    // 改为「控制中心已呈现就每 2 秒打一条」，并直接给出**按钮中心的屏幕 Y**，
    // 与状态栏行中心（43.7 + 状态栏偏移 + 22）对比即可算出还差多少。
    @try {
        static CFTimeInterval gERQABtnProbeLast = 0.0;
        CFTimeInterval qaNow = CACurrentMediaTime();
        if (gEnabled && gERControlCenterPresented && qaNow - gERQABtnProbeLast > 2.0) {
            gERQABtnProbeLast = qaNow;
            UIView *qaHost = [controller.view viewWithTag:181000];
            UIWindow *qaWindow = controller.view.window;
            CGFloat hostWinY = (qaHost && qaWindow) ? [qaHost convertRect:qaHost.bounds toView:qaWindow].origin.y : -1.0;
            ERLogInfo(@"QABTN-PROBE landscape=%d centerY=%.1f btnCenterWinY=%.1f hostWinY=%.1f topInsetUsed=%.1f drop=%.1f",
                      (int)ERLandscapePresentationActive(), buttonCenterY,
                      hostWinY >= 0.0 ? hostWinY + buttonCenterY : -1.0, hostWinY, gERQABaselineTopInset,
                      kERLandscapeCornerButtonDrop);
        }
    } @catch (__unused NSException *exception) {}
    // 1.0.1：「操作按钮」的两个滑杆在这里落地。缩进/边长都走夹取后的取值，
    // 四条约束（leading/trailing/width/height）全部存到按钮上，供
    // updateQuickAccessGeometryForHost: 原地刷新 —— 滑杆调完立即生效，不用 respring。
    CGFloat buttonInset = ERQuickAccessButtonInset();
    CGFloat buttonSide = ERQuickAccessButtonSide();
    if (gAddButtonEnabled) {
        UIButton *add = [self cornerButtonWithSymbol:@"plus" action:@selector(addTapped:) tag:181001 materialRoot:materialRoot];
        [host addSubview:add];
        NSLayoutConstraint *addCenterY = [add.centerYAnchor constraintEqualToAnchor:host.topAnchor constant:buttonCenterY];
        NSLayoutConstraint *addLeading = [add.leadingAnchor constraintEqualToAnchor:host.leadingAnchor constant:buttonInset];
        NSLayoutConstraint *addWidth = [add.widthAnchor constraintEqualToConstant:buttonSide];
        NSLayoutConstraint *addHeight = [add.heightAnchor constraintEqualToConstant:buttonSide];
        objc_setAssociatedObject(add, kERQuickAccessCenterYConstraintKey, addCenterY, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(add, kERQuickAccessLeadingConstraintKey, addLeading, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(add, kERQuickAccessSizeConstraintsKey, @[addWidth, addHeight], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [NSLayoutConstraint activateConstraints:@[addLeading, addCenterY, addWidth, addHeight]];
    }
    if (gPowerButtonEnabled) {
        UIButton *power = [self cornerButtonWithSymbol:@"power" action:@selector(powerTapped:) tag:181002 materialRoot:materialRoot];
        power.backgroundColor = UIColor.clearColor;
        [host addSubview:power];
        NSLayoutConstraint *powerCenterY = [power.centerYAnchor constraintEqualToAnchor:host.topAnchor constant:buttonCenterY];
        NSLayoutConstraint *powerTrailing = [power.trailingAnchor constraintEqualToAnchor:host.trailingAnchor constant:-buttonInset];
        NSLayoutConstraint *powerWidth = [power.widthAnchor constraintEqualToConstant:buttonSide];
        NSLayoutConstraint *powerHeight = [power.heightAnchor constraintEqualToConstant:buttonSide];
        objc_setAssociatedObject(power, kERQuickAccessCenterYConstraintKey, powerCenterY, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(power, kERQuickAccessTrailingConstraintKey, powerTrailing, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(power, kERQuickAccessSizeConstraintsKey, @[powerWidth, powerHeight], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [NSLayoutConstraint activateConstraints:@[powerTrailing, powerCenterY, powerWidth, powerHeight]];
    }
    // The provider-driven collection rebuild replaces the header pocket, so
    // this host can be re-created mid-session. When Control Center is already
    // presented, reveal immediately instead of waiting for the state callback.
    BOOL revealed = gERControlCenterPresented && gQuickAccessButtonsEnabled;
    host.alpha = revealed ? 1.0 : 0.0;
    host.hidden = !revealed;
    host.userInteractionEnabled = revealed;
}

- (void)normalizePagedLayoutForOverlay:(UIViewController *)overlay {
    if (!overlay) return;
    [self syncOwnedDuplicateModulesForOverlay:overlay];
    NSArray<UIViewController *> *modules = ERCollectModuleControllers(overlay);
    if (!modules.count) return;

    NSMutableDictionary<NSString *, UIViewController *> *moduleByIdentifier = [NSMutableDictionary dictionary];
    for (UIViewController *module in modules) {
        NSString *identifier = ERModuleIdentifier(module);
        if (identifier.length) moduleByIdentifier[identifier] = module;
    }
    NSMutableArray<NSString *> *order = [NSMutableArray array];
    for (NSString *identifier in gERProviderOrder) if (moduleByIdentifier[identifier]) [order addObject:identifier];
    for (NSString *identifier in moduleByIdentifier) if (![order containsObject:identifier]) [order addObject:identifier];

    NSMutableDictionary<NSString *, NSValue *> *placed = [NSMutableDictionary dictionary];
    BOOL changed = NO;
    NSUInteger highestPage = 0;

    // Drop saved origins/sizes for controls that are no longer part of the
    // layout. These process-wide dictionaries outlive provider rebuilds, so a
    // removed or disabled module otherwise leaves a stale rect behind that can
    // inflate the page count or, when the identifier reappears, resurrect an
    // overlap. Only prune identifiers that are neither currently collected nor
    // still enabled, and only once a plausible full module set is present, so a
    // transient partial rebuild can never clear live positions.
    if (moduleByIdentifier.count >= 2) {
        NSArray<NSString *> *enabledForPrune = [self enabledModuleIdentifiers];
        for (NSString *staleID in gERCustomOrigins.allKeys) {
            if (!moduleByIdentifier[staleID] && ![enabledForPrune containsObject:staleID]) {
                [gERCustomOrigins removeObjectForKey:staleID];
                changed = YES;
            }
        }
        for (NSString *staleID in gERCustomSizes.allKeys) {
            if (!moduleByIdentifier[staleID] && ![enabledForPrune containsObject:staleID]) {
                [gERCustomSizes removeObjectForKey:staleID];
            }
        }
        for (NSString *staleID in gERLandscapeOrigins.allKeys) {
            if (!moduleByIdentifier[staleID] && ![enabledForPrune containsObject:staleID]) {
                [gERLandscapeOrigins removeObjectForKey:staleID];
                changed = YES;
            }
        }
    }

    for (NSString *identifier in order) {
        CCUILayoutRect desired = {};
        NSValue *nativeValue = gERNativeLayoutRects[identifier];
        if (nativeValue) [nativeValue getValue:&desired];
        NSValue *baseValue = gERBaseLayoutSizes[identifier] ?: gERProviderSizes[identifier];
        if ((!desired.size.width || !desired.size.height) && baseValue) [baseValue getValue:&desired.size];
        NSArray<NSNumber *> *savedSize = gERCustomSizes[identifier];
        if (savedSize.count >= 2) desired.size = (CCUILayoutSize){savedSize[0].unsignedIntegerValue, savedSize[1].unsignedIntegerValue};
        // Clamp rather than skip. A missing or out-of-range logical size used to
        // drop the control from the layout entirely (it vanished); a control
        // that is present on screen must always be given a placeable footprint.
        if (!desired.size.width) desired.size.width = 1;
        if (!desired.size.height) desired.size.height = 1;
        if (desired.size.width > 4) desired.size.width = 4;
        if (desired.size.height > kERMinimumGridRows) desired.size.height = kERMinimumGridRows;

        NSArray<NSNumber *> *savedOrigin = ERStoredOriginForIdentifier(identifier);
        BOOL hadSavedOrigin = savedOrigin.count >= 2;
        if (hadSavedOrigin) desired.origin = (CCUILayoutPoint){savedOrigin[0].unsignedIntegerValue, savedOrigin[1].unsignedIntegerValue};
        BOOL crossesBoundary = (desired.origin.y % kERMinimumGridRows) + desired.size.height > kERMinimumGridRows;
        if (!hadSavedOrigin && !nativeValue) desired.origin = (CCUILayoutPoint){0, 0};

        if (!ERPagedRectFits(identifier, desired, placed)) {
            NSUInteger startPage = desired.origin.y / kERMinimumGridRows;
            if (crossesBoundary) startPage++;
            CCUILayoutPoint destination = {};
            // Guaranteed to succeed: reflow the control to the nearest free slot
            // instead of leaving it unplaced (and therefore invisible) when its
            // saved neighbourhood is full.
            ERGuaranteedPagedSlot(identifier, desired.size, startPage, placed, &destination);
            desired.origin = destination;
        }
        placed[identifier] = [NSValue value:&desired withObjCType:@encode(CCUILayoutRect)];
        highestPage = MAX(highestPage, ERPageForRect(desired));
        if (!hadSavedOrigin || savedOrigin[0].unsignedIntegerValue != desired.origin.x || savedOrigin[1].unsignedIntegerValue != desired.origin.y) {
            gERCustomOrigins[identifier] = @[@(desired.origin.x), @(desired.origin.y)];
            changed = YES;
        }
    }

    gEROccupiedPageCount = MAX((NSUInteger)1, highestPage + 1);
    gERPageCount = MIN(kERMaxPages, gEROccupiedPageCount + (gEditModeActive && gEROccupiedPageCount < kERMaxPages ? 1 : 0));
    if (gERPendingPageAfterRebuild != NSNotFound) {
        gERCurrentPage = MIN(gERPendingPageAfterRebuild, gERPageCount - 1);
        gERPendingPageAfterRebuild = NSNotFound;
    } else {
        gERCurrentPage = MIN(gERCurrentPage, gERPageCount - 1);
    }
    if (changed) {
        CFPreferencesSetAppValue(CFSTR("ModuleGridOrigins"), (__bridge CFPropertyListRef)[gERCustomOrigins copy], kERPrefsDomain);
        CFPreferencesAppSynchronize(kERPrefsDomain);
        UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
        [collection.view setNeedsLayout];
    }
    [self updatePageIndicatorsForOverlay:overlay];
    [self layoutOwnedDuplicateModulesForOverlay:overlay];
}

- (void)setEditControlsSuppressedForPaging:(BOOL)suppressed overlay:(UIViewController *)overlay animated:(BOOL)animated {
    // Remove/resize chrome used to float on overlay.view, so paging had to
    // suppress it while pages slid underneath.  The chrome now lives with the
    // module wrapper (like the border), so hiding it during paging just creates
    // the old disappear/reappear flash. Keep the method as a compatibility
    // synchronization point for existing callers, but do not enter the global
    // suppression state.
    gEREditChromeSuppressedForPaging = NO;
    if (!overlay || !gEditModeActive) return;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        UIButton *remove = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
        UIButton *resize = objc_getAssociatedObject(module.view, kERResizeButtonKey);
        if (!remove.hidden) [remove.superview bringSubviewToFront:remove];
        if (!resize.hidden) [resize.superview bringSubviewToFront:resize];
    }
}

- (void)updatePagedModuleVisibilityForOverlay:(UIViewController *)overlay showAdjacent:(BOOL)showAdjacent {
    if (!overlay || gERExpandedModuleOpen) return;
    [self layoutOwnedDuplicateModulesForOverlay:overlay];
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *identifier = ERModuleIdentifier(module);
        NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!nativeValue) continue;
        CCUILayoutRect rect = {};
        [nativeValue getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        // 1.0.6-7（第 4 条）：`showAdjacent` 原本是「任何页都算可见」，于是
        //     pageVisible = YES 被无条件写到底下那一行 layer.opacity = 1.0 上，
        //     页外磁贴（含隔着两页的）在拖拽/翻页过程中被整页点亮，随后裁剪回合再把
        //     它们压回 0，中间就露出一帧 —— 正是用户报的「滑动退出时先显示该页全部
        //     快捷指令模块、随后消失」，实机日志里能直接读到这一步：
        //         SHORTCUTVIS … page=2 cur=0 onPage=0 opacity=1.00     ← 隔着两页却被点亮
        //     「相邻页要保持可见」的本意是**相邻**（±1 页），不是**任意**页。这里把
        //     showAdjacent 收窄成 ±1 页：拖拽时真正可能出现在屏幕上的那两页照旧可见，
        //     隔了两页以上的一律保持裁剪值。1.0.6-6 加的两处「只在当前页才点亮」的
        //     闸门（layoutOwnedDuplicateModulesForOverlay: 尾部、updateOwnedDuplicateHost
        //     ForOverlay:）拦不住这一条，因为写 opacity 的是**本函数**。
        NSUInteger modulePage = ERPageForRect(rect);
        NSInteger pageDistance = (NSInteger)modulePage - (NSInteger)gERCurrentPage;
        if (pageDistance < 0) pageDistance = -pageDistance;
        BOOL pageVisible = (modulePage == gERCurrentPage) ||
                           (showAdjacent && pageDistance <= 1);
        // Keep UIView visibility and layout entirely under Control Center's
        // ownership. Mutating alpha plus setNeedsLayout here fed back through
        // the private module layout hooks while edit chrome's display link was
        // active, eventually watchdog-stalling SpringBoard. Layer opacity is a
        // compositor-only page clip and does not invalidate module layout.
        BOOL activeDragSource = ERIsActiveDragModuleIdentifier(identifier);
        BOOL pageHidden = (!pageVisible && !(gERDragInProgress && module.view == gERActiveDragModuleView)) || activeDragSource;
        objc_setAssociatedObject(module.view, kERPageHiddenKey, @(pageHidden), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [CATransaction begin];
        [CATransaction setDisableActions:YES];
        module.view.layer.opacity = pageHidden ? 0.0f : 1.0f;
        [CATransaction commit];
        UIVisualEffectView *border = objc_getAssociatedObject(module.view, @selector(applyEditingToModule:editing:));
        UIButton *remove = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
        UIButton *resize = objc_getAssociatedObject(module.view, kERResizeButtonKey);
        if (!pageVisible || activeDragSource) {
            border.hidden = YES;
            border.alpha = 0.0;
            remove.hidden = YES;
            remove.alpha = 0.0;
            resize.hidden = YES;
            resize.alpha = 0.0;
        } else if (gEditModeActive) {
            border.hidden = !gModuleBordersEnabled;
            border.alpha = 1.0;
            remove.hidden = gEREditChromeSuppressedForPaging || !gRemovalButtonsEnabled;
            remove.alpha = gEREditChromeSuppressedForPaging ? 0.0 : 1.0;
            resize.hidden = gEREditChromeSuppressedForPaging || ![self moduleIdentifierSupportsResizing:identifier];
            resize.alpha = gEREditChromeSuppressedForPaging ? 0.0 : 1.0;
        }
    }
}

- (void)installTopFadeForOverlay:(UIViewController *)overlay {
    if (!overlay.view) return;
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    UIView *fade = [overlay.view viewWithTag:kERTopFadeTag];
    if (!fade) {
        fade = [[ERTopFadeView alloc] initWithFrame:CGRectZero];
        fade.tag = kERTopFadeTag;
        fade.userInteractionEnabled = NO;
        fade.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleBottomMargin;
        [overlay.view addSubview:fade];
    }
    if (collection.view && collection.view.superview == overlay.view) {
        [overlay.view insertSubview:fade aboveSubview:collection.view];
    }
    CGFloat height = MAX(112.0, overlay.view.safeAreaInsets.top + 76.0);
    fade.frame = CGRectMake(0.0, 0.0, CGRectGetWidth(overlay.view.bounds), height);
    BOOL active = gERControlCenterPresented && !gERExpandedModuleOpen &&
        (gERPagerScrubbingActive || gERPagerTransitionActive || fabs(gERPagerInteractiveTranslation) > 0.5);
    fade.hidden = !active;
    fade.alpha = active ? 1.0 : 0.0;

    UIView *quickAccess = [overlay.view viewWithTag:181000];
    if (quickAccess && !quickAccess.hidden) [overlay.view bringSubviewToFront:quickAccess];
    for (UIViewController *child in overlay.childViewControllers) {
        NSString *name = NSStringFromClass(child.class);
        if (([name containsString:@"SensorAttribution"] || [name containsString:@"HeaderPocket"]) && child.view) {
            [overlay.view bringSubviewToFront:child.view];
        }
    }
    for (UIView *subview in overlay.view.subviews) {
        NSString *name = NSStringFromClass(subview.class);
        if ([name containsString:@"HeaderPocket"]) [overlay.view bringSubviewToFront:subview];
    }
    UIView *pageIndicators = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    if (pageIndicators && !pageIndicators.hidden) [overlay.view bringSubviewToFront:pageIndicators];
}

- (void)updateTopFadeForOverlay:(UIViewController *)overlay presentationAlpha:(CGFloat)alpha {
    UIView *fade = [overlay.view viewWithTag:kERTopFadeTag];
    if (!fade) {
        [self installTopFadeForOverlay:overlay];
        fade = [overlay.view viewWithTag:kERTopFadeTag];
    }
    if (!fade) return;
    BOOL active = !gERExpandedModuleOpen &&
        (gERPagerScrubbingActive || gERPagerTransitionActive || fabs(gERPagerInteractiveTranslation) > 0.5);
    CGFloat target = active ? MIN(1.0, MAX(0.0, alpha)) : 0.0;
    fade.hidden = target <= 0.001;
    fade.alpha = target;
    CGFloat height = MAX(112.0, overlay.view.safeAreaInsets.top + 76.0);
    fade.frame = CGRectMake(0.0, 0.0, CGRectGetWidth(overlay.view.bounds), height);
}

- (void)updateOwnedDuplicateHostForOverlay:(UIViewController *)overlay presentationAlpha:(CGFloat)alpha {
    if (!overlay.view) return;
    UIView *host = [overlay.view viewWithTag:kEROwnedDuplicateHostTag];
    if (!host) return;
    // 1.0.7-21（用户第 4 条）：收尾抑制闸门（第零道，先于下面三道旧闸门）。
    // 只要最近一次方向是「走」（见 animateOwnedDuplicateHostForOverlay:presented:NO
    // 置起的 gERDismissSuppressDuplicates），本方法一律不得再点亮/摆放磁贴 ——
    // 旧闸门依赖 state 与 syncPresented 的实时取值，实机录屏证明两者都可能被陈旧
    // 回调翻回「呈现」侧，从而把关闭动画中途的呈现值复刻到磁贴并悬在前台 App 上方。
    // 抑制位的解除只认 state 回到 1/2（真正的呈现态），不认任何单次回调。
    if (gERDismissSuppressDuplicates) {
        // 抑制期禁止一切「点亮 / 摆放」；但若已确认收起，仍允许「藏」这一件事发生 ——
        // 防止任何遗漏路径（例如 overlay 解析失败导致 forceHide 未执行）把宿主留在屏幕上。
        if (gERControlCenterPresentationState == 0 && !gERExpandedModuleOpen) {
            host.hidden = YES;
            host.alpha = 0.0;
            host.transform = CGAffineTransformIdentity;
            for (UIViewController *child in overlay.childViewControllers) {
                if (![child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
                UIView *childPresentation = objc_getAssociatedObject(child, kEROwnedDuplicatePresentationKey);
                if (childPresentation) childPresentation.layer.opacity = 0.0;
            }
        }
        return;
    }
    // 1.0.6-8（第 4 条）：两道闸门，都是为了让「退出」这件事说了算。
    //
    // 闸门一 —— 淡出正在飞：整段窗口内一律让路，不写任何属性。
    // 本方法对页内磁贴会把 presentation.layer.opacity 拉回 1.0，与退出淡出争同一个
    // 属性；而 ownedDuplicateHostDisplayLinkFired: 是**每帧**带着 alpha=1.0 调进来的，
    // 放松一帧淡出就被盖掉。
    if (CACurrentMediaTime() < gEROwnedDuplicateFadeOutUntil) return;
    // 闸门二 —— 控制中心已经收起：只允许把宿主藏起来，绝不允许再点亮它。
    // 宿主是原生模块集合视图的**兄弟节点**（见 layoutOwnedDuplicateModulesForOverlay:
    // 里的 insertSubview:aboveSubview:），因此不会跟着原生的消失动画一起走，它的
    // 可见性必须由我们自己在退出时收干净。这里同时把呈现层 opacity 归零，
    // 免得下一次布局/同步回合把一块已经不该存在的磁贴重新显示出来。
    if (!gERControlCenterPresented && !gERExpandedModuleOpen) {
        host.hidden = YES;
        host.alpha = 0.0;
        host.transform = CGAffineTransformIdentity;
        for (UIViewController *child in overlay.childViewControllers) {
            if (![child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
            UIView *presentation = objc_getAssociatedObject(child, kEROwnedDuplicatePresentationKey);
            presentation.layer.opacity = 0.0;
        }
        return;
    }
    // 闸门三 —— 收起中（state 3）且最近一次呈现方向是「走」：保持熄灭。
    //
    // 这一条是补闸门一的时间漏洞：淡出窗口只有 0.23 秒，而 state 3 → state 0 之间的
    // 收起动画通常更长。窗口一过，display link 的逐帧调用就会把页内磁贴重新点亮
    // （presentation.layer.opacity = 1.0），刚刚淡掉的磁贴又整块闪回来。
    // 判据用「最近一次 animate 的方向」而不是时间：只要方向还是「走」而且不处在
    // 呈现态（1 正在呈现 / 2 已呈现），就不许点亮；退出手势被取消时 state 2 会带着
    // presented:YES 回来，方向翻正，这里自然放行。
    if (!gEROwnedDuplicateHostSyncPresented &&
        gERControlCenterPresentationState != 1 && gERControlCenterPresentationState != 2) {
        return;
    }
    CGFloat clamped = MIN(1.0, MAX(0.0, alpha));
    BOOL hidden = clamped <= 0.001 || (gERExpandedModuleOpen && !gERExpandedModuleClosingActive);
    if (hidden) {
        host.hidden = YES;
        if (gERExpandedModuleOpen || clamped <= 0.001) host.alpha = 0.0;
        host.transform = CGAffineTransformIdentity;
        for (UIViewController *child in overlay.childViewControllers) {
            if (![child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
            UIView *container = objc_getAssociatedObject(child, kEROwnedDuplicateContainerKey);
            UIView *presentation = objc_getAssociatedObject(child, kEROwnedDuplicatePresentationKey);
            container.transform = CGAffineTransformIdentity;
            presentation.transform = CGAffineTransformIdentity;
            presentation.layer.opacity = 0.0;
        }
        return;
    }
    host.hidden = NO;
    // 1.0.7-20（用户第 4 条）：跟手缩放期间磁贴要与系统模块**同一个亮度**。
    // 原生那边在 updateInteractivePageTransitionForOverlay: 里写的是
    //     collection.view.alpha = baseAlpha * gERPagerHeldAlphaFactor
    // 本方法是每帧调用的唯一宿主写者，改这里就等于把磁贴的亮度并进同一条曲线。
    host.alpha = gERPagerScrubbingActive ? gERPagerHeldAlphaFactor : 1.0;
    host.layer.opacity = 1.0;
    host.transform = gERUseNativeOpeningCompensation ?
        CGAffineTransformMakeTranslation(0.0, ERNativeScrollOpeningCompensation(overlay)) :
        CGAffineTransformIdentity;

    // 1.0.6-9（第 4 条）：本方法由展示同步 display link **每帧**调用。这段收集只有
    // 「非快捷指令磁贴」的下半段用得上 —— 快捷指令磁贴在上面那个分支就 continue 了，
    // 而用户页面上往往全是快捷指令磁贴。改成命中再用，并且整帧只做一次。
    NSArray<UIViewController *> *modules = nil;
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    for (UIViewController *child in overlay.childViewControllers) {
        if (![child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
        EROwnedDuplicateModuleViewController *duplicate = (EROwnedDuplicateModuleViewController *)child;
        UIView *duplicateContainer = objc_getAssociatedObject(child, kEROwnedDuplicateContainerKey);
        UIView *duplicatePresentation = objc_getAssociatedObject(child, kEROwnedDuplicatePresentationKey);
        if (!duplicateContainer || !duplicatePresentation) continue;

        // 1.0.1：快捷指令磁贴没有「源模块」。此前它会掉进下面「拿第一个可见模块」
        // 的兜底分支，于是磁贴的 transform / opacity 被一个毫不相干的模块（例如计时器）
        // 驱动 —— 那个模块一旦处于淡出或翻页中，磁贴就跟着变透明，看起来就是「没显示」。
        // 快捷指令磁贴自己就是唯一的呈现来源，这里直接保持不透明、不做继承。
        if (ERShortcutIdentifierIsShortcut(duplicate.moduleIdentifier)) {
            // 1.0.7-20（用户第 4 条 · 「快捷指令模块感觉还是在上层」的可证成因）：
            // 这两行原来是**无条件** identity —— 而这个 display link 在「呈现跟手」
            // （gERPagerScrubbingActive）与退出期间是**每帧**在跑的，它恰好把
            // layoutOwnedDuplicateModulesForOverlay: 尾部刚写好的
            //     presentation.transform = Scale(scrubScaleX, scrubScaleY)
            // 覆盖回 identity。结果：系统模块已经缩到 0.7 并压暗到 0.7，磁贴却全程
            // 满尺寸、满亮度 —— 观感就是「一排大图标浮在缩小的页面上」。跟手过程
            // 结束时系统模块回弹，磁贴早已在终点，于是又「弹一下」。
            // 现在两侧用同一套系数：缩放跟 gERPagerHeldScale×jello（与
            // applyPageTransformToOverlay: 的 collection 缩放逐项同源），
            // 亮度由上面的 host.alpha 统一承担。
            CGFloat scrubScaleX = gERPagerHeldScale * gERPagerJelloScaleX;
            CGFloat scrubScaleY = gERPagerHeldScale * gERPagerJelloScaleY;
            duplicateContainer.transform = CGAffineTransformIdentity;
            duplicatePresentation.transform = gERPagerScrubbingActive
                ? CGAffineTransformMakeScale(scrubScaleX, scrubScaleY)
                : CGAffineTransformIdentity;
            // 1.0.6-6（第 4 条）：这里原来对**页外磁贴也无条件**把三层可见性全部拉满
            // （presentation.layer.opacity / view.alpha / view.layer.opacity），而第三项
            // 正是分页裁剪所写的那个属性（updatePagedModuleVisibilityForOverlay: 里的
            // `module.view.layer.opacity = pageHidden ? 0 : 1`）。于是只要本函数被调到，
            // 页外磁贴就被重新点亮一次 —— 这正是「滑动退出时先显示该页全部快捷指令模块、
            // 随后消失」的闪烁来源。页内磁贴照旧拉满；页外磁贴保持裁剪给它的值。
            if (ERPageForModuleIdentifier(duplicate.moduleIdentifier) == gERCurrentPage) {
                duplicatePresentation.layer.opacity = 1.0;
                child.view.alpha = 1.0;
                child.view.layer.opacity = 1.0;
            }
            continue;
        }

        UIViewController *source = nil;
        if (!modules) modules = ERCollectModuleControllers(overlay);
        for (UIViewController *candidate in modules) {
            if (ERIsOwnedDuplicateModuleController(candidate)) continue;
            if ([ERModuleIdentifier(candidate) isEqualToString:duplicate.baseModuleIdentifier]) {
                source = candidate;
                break;
            }
        }
        if (!source) {
            for (UIViewController *candidate in modules) {
                if (ERIsOwnedDuplicateModuleController(candidate) || candidate.view.hidden ||
                    candidate.view.alpha <= 0.01 || ERModuleViewIsPageHidden(candidate.view)) continue;
                source = candidate;
                break;
            }
        }

        UIView *sourcePresentation = ERPresentationWrapperForModuleController(source);
        UIView *sourceContainer = sourcePresentation.superview;
        CALayer *sourcePresentationLayer = (CALayer *)sourcePresentation.layer.presentationLayer;
        CALayer *sourceContainerLayer = (CALayer *)sourceContainer.layer.presentationLayer;
        if (sourcePresentationLayer && sourceContainerLayer) {
            duplicateContainer.transform = sourceContainerLayer.affineTransform;
            duplicatePresentation.transform = sourcePresentationLayer.affineTransform;
            duplicatePresentation.layer.opacity = sourcePresentationLayer.opacity;
        } else {
            CGFloat scale = 0.80 + 0.20 * clamped;
            duplicateContainer.transform = CGAffineTransformMakeTranslation(0.0, -70.0 * (1.0 - clamped));
            duplicatePresentation.transform = CGAffineTransformMakeScale(scale, scale);
            duplicatePresentation.layer.opacity = clamped;
        }
        child.view.alpha = 1.0;
        child.view.layer.opacity = 1.0;
    }
    [CATransaction commit];
}

- (void)animateOwnedDuplicateHostForOverlay:(UIViewController *)overlay presented:(BOOL)presented {
    if (!overlay.view) return;
    UIView *host = [overlay.view viewWithTag:kEROwnedDuplicateHostTag];
    if (!host) return;
    // 1.0.7-21（用户第 4 条）：陈旧「呈现」回调防护。
    // significantPresentationProgressChange: 在收尾期间可能带着 >=0.999 的历史进度回来，
    // 旧实现会把方向翻回 YES —— 解封淡出窗口 + syncPresented=YES，随后每帧写者把磁贴
    // 重新点亮（实机录屏的悬停残留由此而来）。此刻若收尾抑制已置起、或呈现状态机仍在
    // 3（收尾）/0（已收），一律拒绝这次翻向；等 state 回到 1/2 时由那条回调正常放行。
    if (presented) {
        if (gERDismissSuppressDuplicates || gERControlCenterPresentationState == 3 ||
            gERControlCenterPresentationState == 0) {
            ERLogInfo(@"SHORTCUTEXIT ver=1.0.9-103 reject-presented state=%lu suppress=%d",
                      (unsigned long)gERControlCenterPresentationState,
                      gERDismissSuppressDuplicates ? 1 : 0);
            return;
        }
    }
    gEROwnedDuplicateHostSyncPresented = presented;
    if (gERExpandedModuleOpen && !gERExpandedModuleClosingActive) {
        host.hidden = YES;
        host.alpha = 0.0;
        host.transform = CGAffineTransformIdentity;
        return;
    }
    if (presented) {
        host.hidden = NO;
        if (host.alpha <= 0.001) host.alpha = 0.0;
    }
    if (gEROwnedDuplicateHostDisplayLink) {
        if (presented) return;
        // 1.0.6-8（第 4 条）：退出方向的淡出**不能**因为展示同步 display link 还活着
        // 就跳过。旧代码在这里无条件 return，而 dismissAnimated: 恰好先调
        // beginOwnedDuplicateHostPresentationSync（把 link 建好）再调本方法 ——
        // 于是这 0.18 秒淡出**从来没有执行过一次**，磁贴以 opacity=1 留在屏幕上，
        // 直到 link 到期（最长 0.85s）才被那条兜底隐藏收掉。这就是实机截图里
        // 「退出了控制中心却还显示模块」。退出时这个 link 已经没有要跟的原生动画，
        // 直接停掉，把淡出跑完 —— 隐藏不能再依赖 link 的到期时机。
        [gEROwnedDuplicateHostDisplayLink invalidate];
        gEROwnedDuplicateHostDisplayLink = nil;
        gEROwnedDuplicateHostSyncUntil = 0.0;
    }
    CGFloat targetOpacity = presented ? 1.0 : 0.0;
    CGAffineTransform targetContainerTransform = presented ? CGAffineTransformIdentity : CGAffineTransformMakeTranslation(0.0, -70.0);
    CGAffineTransform targetPresentationTransform = presented ? CGAffineTransformIdentity : CGAffineTransformMakeScale(0.80, 0.80);
    // 1.0.7-20（用户第 4 条 · 「退出时控制中心会闪一下」）：退出淡出原来只有 0.18s，
    // 而控制中心自己的收起动画约 0.35s —— 磁贴在退出动画的前 40% 就整块消失，
    // 剩下的时间里页面还在动、它已经没了，观感就是「先闪掉一块」。拉长到 0.30s
    // 并保持同一条缓动，让磁贴与控制中心一起离场；真正的隐藏仍由「控制中心已收起」
    // 那道闸门兜底（见下方 completion 与 updateOwnedDuplicateHostForOverlay: 闸门二）。
    NSTimeInterval duration = presented ? 0.20 : 0.30;
    if (presented) {
        // 重新呈现（例如退出手势中途被取消）必须立刻解封，否则磁贴回不来。
        gEROwnedDuplicateFadeOutUntil = 0.0;
    } else {
        // 1.0.6-9（第 3 条）：一次呈现结束时清掉锚点记忆。下一次呈现重新选一次基准，
        // 避免把上一次的模块选择（可能已经被删除或换页）带进来。
        ERResetGridAnchorCache();

        // 圈出淡出专享窗口：这段时间里 updateOwnedDuplicateHostForOverlay: 与布局尾部
        // 都不许再点亮磁贴（它们写的是同一个属性，谁后写谁赢）。
        gEROwnedDuplicateFadeOutUntil = CACurrentMediaTime() + duration + 0.05;

        // 1.0.7-21（用户第 4 条）：收尾方向一旦成立，置起全程抑制位（解除只认
        // state 回到 1/2），并排一道 0.55s 兜底 —— 万一 state 0 回调缺席（快速
        // 退出等路径），也要把宿主同步硬隐藏，绝不允许磁贴悬在前台 App 上方。
        gERDismissSuppressDuplicates = YES;
        gERDismissBackstopSeq++;
        uint64_t backstopSeq = gERDismissBackstopSeq;
        __weak UIViewController *weakOverlay = overlay;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.55 * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{
            if (backstopSeq != gERDismissBackstopSeq) return;
            NSUInteger state = gERControlCenterPresentationState;
            if (state == 1 || state == 2) return;   // 呈现方向已成立（例如取消退出），放行
            UIViewController *settled = weakOverlay;
            if (settled) [[EchoRebornCoordinator shared] forceHideOwnedDuplicateHostForOverlay:settled];
        });
    }
    [UIView animateWithDuration:duration
                          delay:0.0
                        options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction
                     animations:^{
        for (UIViewController *child in overlay.childViewControllers) {
            if (![child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
            UIView *container = objc_getAssociatedObject(child, kEROwnedDuplicateContainerKey);
            UIView *presentation = objc_getAssociatedObject(child, kEROwnedDuplicatePresentationKey);
            container.transform = targetContainerTransform;
            presentation.transform = targetPresentationTransform;
            presentation.layer.opacity = targetOpacity;
        }
    } completion:^(__unused BOOL finished) {
        // 1.0.6-8（第 4 条）：原来这里还要求「没有 display link 在跑」并顺带检查
        // 控制中心已收起。前一个条件会让唯一一次隐藏兜底也被跳过 —— 宿主的隐藏
        // 不该有任何前提。这里只保留「控制中心确实已经收起」这一个语义条件，然后
        // 无条件隐藏；否则磁贴会以淡出结束时的状态留在屏幕上。
        if (!presented && !gERControlCenterPresented) {
            host.hidden = YES;
            host.alpha = 0.0;
            host.transform = CGAffineTransformIdentity;
        }
    }];
}

// 1.0.7-21（用户第 4 条）：收尾硬隐藏 —— 同步、无条件、带日志。
// 触发点：state 0（控制中心确认收起）与 0.55s 兜底。做三件事：
//   1. 停掉展示同步 display link（它每帧都在调 updateOwned...，收尾期不再需要）；
//   2. 宿主 hidden + alpha 0，所有子容器的 transform / opacity 归零 —— 状态与
//      「还没呈现过」一致，下一次呈现会重新点亮（state 1/2 解除抑制位后由正常
//      路径接管）；
//   3. 全程维持在收尾抑制位，直到下一次呈现，防止任何残余回调把它重新点亮。
- (void)forceHideOwnedDuplicateHostForOverlay:(UIViewController *)overlay {
    if (!overlay.view) return;
    UIView *host = [overlay.view viewWithTag:kEROwnedDuplicateHostTag];
    if (!host) return;
    gERDismissSuppressDuplicates = YES;
    if (gEROwnedDuplicateHostDisplayLink) {
        [gEROwnedDuplicateHostDisplayLink invalidate];
        gEROwnedDuplicateHostDisplayLink = nil;
    }
    gEROwnedDuplicateHostSyncUntil = 0.0;
    gEROwnedDuplicateHostSyncPresented = NO;
    gEROwnedDuplicateFadeOutUntil = CACurrentMediaTime() + 0.25;
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    host.hidden = YES;
    host.alpha = 0.0;
    host.transform = CGAffineTransformIdentity;
    for (UIViewController *child in overlay.childViewControllers) {
        if (![child isKindOfClass:[EROwnedDuplicateModuleViewController class]]) continue;
        UIView *container = objc_getAssociatedObject(child, kEROwnedDuplicateContainerKey);
        UIView *presentation = objc_getAssociatedObject(child, kEROwnedDuplicatePresentationKey);
        if (container) container.transform = CGAffineTransformIdentity;
        if (presentation) {
            presentation.transform = CGAffineTransformIdentity;
            presentation.layer.opacity = 0.0;
        }
    }
    [CATransaction commit];
    ERLogInfo(@"SHORTCUTEXIT ver=1.0.9-103 force-hide state=%lu presented=%d",
              (unsigned long)gERControlCenterPresentationState, gERControlCenterPresented ? 1 : 0);
}

- (void)beginOwnedDuplicateHostPresentationSync {
    gEROwnedDuplicateHostSyncUntil = CACurrentMediaTime() + 0.85;
    if (!gEROwnedDuplicateHostDisplayLink) {
        gEROwnedDuplicateHostDisplayLink = [CADisplayLink displayLinkWithTarget:self selector:@selector(ownedDuplicateHostDisplayLinkFired:)];
        [gEROwnedDuplicateHostDisplayLink addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
    }
}

// Display-link trampoline for the live slider readout. The link is owned by
// the C helpers above; this exists only because CADisplayLink needs an object
// target, and EchoRebornCoordinator is the singleton already used for the other
// display links in this file.
- (void)sliderReadoutLinkFired:(CADisplayLink *)displayLink {
    ERSliderReadoutFrame(displayLink);
}

// Target of the observation recogniser EchoReborn installs on the brightness and
// volume sliders. This is the one code path that is guaranteed to see every
// touch sample on any iOS build, because we own the recogniser: the slider's
// own private class (CCUIContinuousSliderView, MRUContinuousSliderView, or
// whatever a future release introduces) is irrelevant here.
- (void)erSliderTrackingGestureFired:(UIPanGestureRecognizer *)gesture {
    if (!gEnabled || gEditModeActive) return;
    UIView *slider = gesture.view;
    if (!slider) return;
    UIGestureRecognizerState state = gesture.state;
    if (state == UIGestureRecognizerStateBegan) {
        ERSliderReadoutBegin(slider);
        ERSliderReadoutTrackGesture(slider, gesture);
        return;
    }
    if (state == UIGestureRecognizerStateChanged) {
        // The system may drive its own recogniser and never start ours in the
        // same order; beginning here as well makes the readout independent of
        // which recogniser reported the change first.
        if (!gERSliderReadoutTracking) ERSliderReadoutBegin(slider);
        ERSliderReadoutTrackGesture(slider, gesture);
        return;
    }
    // Ended: paint the settled value once more, then let the display link
    // retire.
    if (state == UIGestureRecognizerStateEnded) {
        ERRefreshSliderReadoutLive(slider);
        ERSliderReadoutEnd(slider);
        return;
    }
    // Cancelled / Failed: repaint but do NOT invalidate the display link.
    //
    // Tearing it down here froze the percentage for the rest of the drag
    // whenever the observer was cancelled early (a system interruption, or the
    // recogniser contest described in -ERSliderInstallTrackingGesture). The
    // idle safety net in -ERSliderReadoutFrame already retires the link 0.5s
    // after the last advance, so leaving it up costs nothing and lets the
    // readout resume untouched if more samples arrive.
    if (state == UIGestureRecognizerStateCancelled ||
        state == UIGestureRecognizerStateFailed) {
        ERRefreshSliderReadoutLive(slider);
    }
}

- (void)ownedDuplicateHostDisplayLinkFired:(__unused CADisplayLink *)displayLink {
    BOOL presentationTransitionActive = gERControlCenterPresentationState == 1 ||
                                        gERControlCenterPresentationState == 3;
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        if (!overlay.view.window) continue;
        [self updateOwnedDuplicateHostForOverlay:overlay presentationAlpha:1.0];
        if (gERUseNativeOpeningCompensation &&
            (gERControlCenterPresentationState == 1 || gERControlCenterPresentationState == 2) &&
            fabs(ERNativeScrollOpeningCompensation(overlay)) <= 0.5) {
            ERFinishNativeScrollOpeningStabilization(overlay);
        }

    }
    if (gERUseNativeOpeningCompensation &&
        (gERControlCenterPresentationState == 1 || gERControlCenterPresentationState == 2)) {
        // The native scroll presentation bounds and our inverse sublayer
        // offset must reach the render server in the same frame. Letting the
        // latter wait for the run-loop's normal commit leaves a one-frame
        // mismatch precisely when CCUI drops its opening bounds animation.
        [CATransaction flush];
    }

    if (presentationTransitionActive) gEROwnedDuplicateHostSyncUntil = CACurrentMediaTime() + 0.10;
    if (CACurrentMediaTime() > gEROwnedDuplicateHostSyncUntil) {
        [gEROwnedDuplicateHostDisplayLink invalidate];
        gEROwnedDuplicateHostDisplayLink = nil;
        if (!gEROwnedDuplicateHostSyncPresented && !gERControlCenterPresented) {
            for (UIViewController *overlay in gOverlayControllers.allObjects) {
                UIView *host = [overlay.view viewWithTag:kEROwnedDuplicateHostTag];
                if (!host) continue;
                host.hidden = YES;
                host.alpha = 0.0;
                host.transform = CGAffineTransformIdentity;
            }
        }
    }
}

- (void)settlePagedModuleVisibilityForOverlay:(UIViewController *)overlay animated:(BOOL)animated token:(id)token {
    if (!overlay || gERExpandedModuleOpen) return;
    NSTimeInterval duration = animated ? (gEditModeActive ? 0.12 : 0.07) : 0.0;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *identifier = ERModuleIdentifier(module);
        NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!nativeValue) continue;
        CCUILayoutRect rect = {};
        [nativeValue getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        BOOL selected = ERPageForRect(rect) == gERCurrentPage;
        UIVisualEffectView *border = objc_getAssociatedObject(module.view, @selector(applyEditingToModule:editing:));
        UIButton *remove = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
        UIButton *resize = objc_getAssociatedObject(module.view, kERResizeButtonKey);

        objc_setAssociatedObject(module.view, kERPageHiddenKey, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (gEditModeActive) {
            border.hidden = selected ? !gModuleBordersEnabled : NO;
            remove.hidden = gEREditChromeSuppressedForPaging || (selected ? !gRemovalButtonsEnabled : NO);
            resize.hidden = gEREditChromeSuppressedForPaging || (selected ? ![self moduleIdentifierSupportsResizing:identifier] : NO);
        } else {
            border.hidden = YES;
            remove.hidden = YES;
            resize.hidden = YES;
        }
        [border.layer removeAnimationForKey:@"EchoRebornBreathing"];

        float targetOpacity = selected ? 1.0f : 0.0f;
        if (animated) {
            float startingOpacity = module.view.layer.presentationLayer ? ((CALayer *)module.view.layer.presentationLayer).opacity : module.view.layer.opacity;
            [CATransaction begin];
            [CATransaction setDisableActions:YES];
            module.view.layer.opacity = targetOpacity;
            [CATransaction commit];
            CABasicAnimation *fade = [CABasicAnimation animationWithKeyPath:@"opacity"];
            fade.fromValue = @(startingOpacity);
            fade.toValue = @(targetOpacity);
            fade.duration = duration;
            fade.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
            [module.view.layer addAnimation:fade forKey:@"EchoRebornPageSettleFade"];
            [UIView animateWithDuration:duration delay:0.0 options:UIViewAnimationOptionCurveEaseOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
                border.alpha = gEditModeActive && selected ? 1.0 : 0.0;
                remove.alpha = gEditModeActive && selected && !gEREditChromeSuppressedForPaging ? 1.0 : 0.0;
                resize.alpha = gEditModeActive && selected && !gEREditChromeSuppressedForPaging ? 1.0 : 0.0;
            } completion:nil];
        } else {
            [CATransaction begin];
            [CATransaction setDisableActions:YES];
            module.view.layer.opacity = targetOpacity;
            [CATransaction commit];
            border.alpha = gEditModeActive && selected ? 1.0 : 0.0;
            remove.alpha = gEditModeActive && selected && !gEREditChromeSuppressedForPaging ? 1.0 : 0.0;
            resize.alpha = gEditModeActive && selected && !gEREditChromeSuppressedForPaging ? 1.0 : 0.0;
        }
    }

    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(duration * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (token && objc_getAssociatedObject(overlay, kERPageAnimationTokenKey) != token) return;
        [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
        if (gEditModeActive) {
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                NSString *identifier = ERModuleIdentifier(module);
                NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
                if (!nativeValue) continue;
                CCUILayoutRect rect = {};
                [nativeValue getValue:&rect];
                NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
                if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
                if (ERPageForRect(rect) == gERCurrentPage) [self applyEditingToModule:module editing:YES];
            }
            // applyEditingToModule owns creation/configuration and therefore
            // briefly restores alpha. Re-apply the page clip before revealing
            // only the destination page's overlay controls.
            [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
            [self updateEditControlFramesForOverlay:overlay];
            [self setEditControlsSuppressedForPaging:NO overlay:overlay animated:YES];
        }
    });
}

// 0.5.14 诊断探针：翻页期间记录 collection 视图的真实几何（模型值 + 呈现值），
// 只在数值发生变化时落一行。用来定位「翻页时页面被额外挪动一下」的写入点：
//   sub/presSub = sublayerTransform 的 ty（模型 / 呈现，两者不一致说明有未提交的动画）
//   ty          = UIView.transform 的 ty
//   by/pbY      = bounds.origin.y（模型 / 呈现）
static void ERLogPageGeometry(NSString *phase, UIViewController *overlay, UIView *collectionView, CGFloat pageOffset) {
    static NSString *lastState = nil;
    CALayer *layer = collectionView.layer;
    CALayer *visible = (CALayer *)layer.presentationLayer ?: layer;
    NSString *state = [NSString stringWithFormat:@"%@ page=%lu tr=%.1f off=%.1f sub=%.1f presSub=%.1f ty=%.1f by=%.1f pbY=%.1f",
                       phase,
                       (unsigned long)gERCurrentPage,
                       gERPagerInteractiveTranslation,
                       pageOffset,
                       layer.sublayerTransform.m42,
                       visible.sublayerTransform.m42,
                       collectionView.transform.ty,
                       layer.bounds.origin.y,
                       visible.bounds.origin.y];
    if (lastState && [state isEqualToString:lastState]) return;
    lastState = [state copy];
    ERLogInfo(@"PAGEGEO ver=1.0.9-103 %@", state);
}

- (void)applyPageTransformToOverlay:(UIViewController *)overlay animated:(BOOL)animated {
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    if (!collection.view) return;
    // 0.5.14 探针：翻页期间把「进入时」的真实几何和「写入后」的几何都记下来。
    // 只在数值变化时落一行，用来抓出到底是哪个写入点把页面挪走了。
    if (gERPagerTransitionActive) ERLogPageGeometry(@"in ", overlay, collection.view, 0.0);
    if (gERPagerScrubbingActive) {
        NSValue *boundsValue = objc_getAssociatedObject(collection.view, kERScrubCollectionBoundsKey);
        NSValue *positionValue = objc_getAssociatedObject(collection.view, kERScrubCollectionPositionKey);
        if (boundsValue && positionValue) {
            [CATransaction begin];
            [CATransaction setDisableActions:YES];
            collection.view.layer.bounds = boundsValue.CGRectValue;
            collection.view.layer.position = positionValue.CGPointValue;
            [CATransaction commit];
        }
    }
    BOOL atomicPresentationReconcile = !animated &&
        !gERPagerTransitionActive &&
        !gERPagerScrubbingActive &&
        fabs(gERPagerInteractiveTranslation) < 0.01 &&
        (gERControlCenterPresentationState == 0 || gERControlCenterPresentationState == 2);
    if (atomicPresentationReconcile) {
        [CATransaction begin];
        [CATransaction setDisableActions:YES];
    }
    [self layoutOwnedDuplicateModulesForOverlay:overlay];
    // 0.5.14: 翻页跟手期间不要每帧都做「整棵视图树的滚动视图夹紧」。它会逐帧重写
    // 覆盖层里每一个 UIScrollView 的 contentSize / contentInset / contentOffset，
    // 既拖慢主线程，又可能在翻页途中把内容挪一下。夹紧在手势开始、手势结束以及
    // 落位后的延迟补写里照旧执行，翻页过程本身不需要它。
    if (!gERPagerTransitionActive) ERRestoreNativeScrollBaseline(overlay);
    if (gERUseNativeOpeningCompensation) ERStabilizeNativeScrollPresentationForOverlay(overlay);
    [self capturePresentationStateForView:collection.view];
    CGAffineTransform base = [objc_getAssociatedObject(collection.view, kEROriginalTransformKey) CGAffineTransformValue];
    CATransform3D sublayerBase = [objc_getAssociatedObject(collection.view, kEROriginalSublayerTransformKey) CATransform3DValue];
    CGFloat editOffset = gEditModeActive ? 0.0 : kERRestingModuleOffset;
    CGFloat pageOffset = -(CGFloat)gERCurrentPage * ERVisualPageSpan() + gERPagerInteractiveTranslation;
    // While a module is expanded, CCUI's expand/collapse animation reads the
    // module's frame in window coordinates. UIView coordinate conversion honors
    // view.transform but NOT layer.sublayerTransform, so if the page offset
    // lives on the sublayer the module reports its untranslated model row (a
    // full page below the screen) and the platter flies to/from off the bottom.
    // Carry the page offset on the view transform (and neutralise the sublayer)
    // for the duration of the expansion so the source frame is correct. This
    // matches ERApplyExpansionPageGeometrySync and stops overriding it.
    BOOL flattenForExpansion = gERExpandedModuleOpen && !gEditModeActive && !gERPagerScrubbingActive;
    CGFloat viewTransformOffset = editOffset + (flattenForExpansion ? pageOffset : 0.0);
    CATransform3D targetSublayerTransform = flattenForExpansion ? sublayerBase : CATransform3DTranslate(sublayerBase, 0.0, pageOffset, 0.0);
    void (^changes)(void) = ^{
        // Keep page motion on one compositor property in both presentation
        // modes. Moving it between UIView.transform at rest and
        // sublayerTransform while editing allowed CCUI's edit-exit layout to
        // preserve one side of the handoff and either lose or double the page
        // offset. The view transform now owns only the small chrome spacing.
        collection.view.layer.transform = CATransform3DIdentity;
        if (gERPagerScrubbingActive) {
            CGPoint overlayCenter = CGPointMake(CGRectGetMidX(overlay.view.bounds), CGRectGetMidY(overlay.view.bounds));
            CGPoint collectionCenterInOverlay = [collection.view.superview convertPoint:collection.view.center toView:overlay.view];
            CGFloat scaleX = gERPagerHeldScale * gERPagerJelloScaleX;
            CGFloat scaleY = gERPagerHeldScale * gERPagerJelloScaleY;
            CGFloat compensationX = (overlayCenter.x - collectionCenterInOverlay.x) * (1.0 - scaleX);
            CGFloat compensationY = (overlayCenter.y - collectionCenterInOverlay.y) * (1.0 - scaleY);
            CGAffineTransform heldTransform = CGAffineTransformTranslate(base, compensationX,
                                                                          editOffset + compensationY);
            collection.view.transform = CGAffineTransformScale(heldTransform, scaleX, scaleY);
        } else {
            collection.view.transform = CGAffineTransformTranslate(base, 0.0, viewTransformOffset);
        }
        collection.view.layer.sublayerTransform = targetSublayerTransform;
        [self layoutOwnedDuplicateModulesForOverlay:overlay];
        [self updateEditPageGridTransformsForOverlay:overlay];
    };
    if (animated) {
        id token = [NSObject new];
        objc_setAssociatedObject(overlay, kERPageAnimationTokenKey, token, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        // 1.0.6-16（第 1 条）：动画**回来**了，但改成短促、且与磁贴可见性同帧。
        //
        // 1.0.6-14 把动画整个删掉之后，用户反馈「还是有明显的一个卡顿，或者说是
        // 向上停留」—— 页面变成一次硬切，读感就是卡。回看 1.0.6-13 之前那份
        // 0.52s 版本为什么「闪」：slide 在播的整段时间里，**磁贴的透明度还停在
        // 拖动时的「两页都可见」状态**，要等动画结束后的收尾块才 settle，于是
        // 目标页的磁贴在最后一帧才冒出来 —— 那一下 pop 才是「闪一下」的真正来源，
        // 不是 slide 本身。
        //
        // 所以这次做两件事：
        //   · 磁贴可见性**紧跟**在 changes() 之后同步 settle，与页面跳转同帧生效，
        //     不再推迟到动画结束；
        //   · 动画时长从 0.52s 收到 0.22s —— 足够读出方向，又不至于让人等。
        NSTimeInterval duration = 0.22;
        [collection.view.layer removeAnimationForKey:@"EchoRebornPageStackSlide"];
        // 1.0.6-15（第 1 条）：提交前先把原生滚动视图的偏移拉回基线。
        //
        // 函数开头那句 `if (!gERPagerTransitionActive) ERRestoreNativeScrollBaseline`
        // 在整段翻页期间都是跳过的（跟手时每帧夹紧太贵，见那里的注释）。以前这个
        // 缺口被 0.52s 的 slide 动画盖住了：动画结束后基线才恢复，肉眼看到的是
        // 连续滑动。现在动画没了，页面瞬间到位、基线却要等下一帧才被拉回，
        // 于是「先落位、再被挪一下」—— 用户描述的「明显卡顿 / 向上停留」正是这个。
        // 提交点只有一次（不是每帧），在这里夹紧既安全又正好与页面跳转同帧。
        ERRestoreNativeScrollBaseline(overlay);
        [CATransaction begin];
        [CATransaction setDisableActions:YES];
        changes();
        [CATransaction commit];
        [self settlePagedModuleVisibilityForOverlay:overlay animated:NO token:token];
        CATransform3D fromSublayerTransform = (gEditModeActive && gERPagerTransitionActive) ?
            collection.view.layer.sublayerTransform :
            (collection.view.layer.presentationLayer ? ((CALayer *)collection.view.layer.presentationLayer).sublayerTransform : collection.view.layer.sublayerTransform);
        CABasicAnimation *slide = [CABasicAnimation animationWithKeyPath:@"sublayerTransform"];
        slide.fromValue = [NSValue valueWithCATransform3D:fromSublayerTransform];
        slide.toValue = [NSValue valueWithCATransform3D:targetSublayerTransform];
        slide.duration = duration;
        // 1.0.7-7：与落位同一套缓动。原来这条 (0.18,0.88,0.20,1.0) 的起始斜率 ≈ 4.9，
        // 第一帧就冲掉全程的 37% —— 探针实测 f=1→f=2 之间 0→-359pt，就是「猛地一蹿」。
        slide.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
        [collection.view.layer addAnimation:slide forKey:@"EchoRebornPageStackSlide"];
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(duration * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            if (objc_getAssociatedObject(overlay, kERPageAnimationTokenKey) != token) return;
            gERPagerTransitionActive = NO;
            [self layoutOwnedDuplicateModulesForOverlay:overlay];
            // 磁贴可见性已经在上面与 changes() 同帧 settle 过了，这里不再重复；
            // 编辑态例外 —— 退出编辑时的 chrome 归位需要再走一次带动画的版本。
            if (gEditModeActive) [self settlePagedModuleVisibilityForOverlay:overlay animated:YES token:token];
            [self updateTopFadeForOverlay:overlay presentationAlpha:0.0];
            if (gEditModeActive) {
                [self prepareGridForOverlay:overlay collection:collection];
                [self updateEditControlFramesForOverlay:overlay];
                EREditTouchShield *shield = (EREditTouchShield *)[overlay.view viewWithTag:kEREditTouchShieldTag];
                UIButton *addControl = (UIButton *)[overlay.view viewWithTag:kERAddControlButtonTag];
                if (shield) [overlay.view bringSubviewToFront:shield];
                if (addControl) [overlay.view bringSubviewToFront:addControl];
                for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                    UIButton *remove = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
                    UIButton *resize = objc_getAssociatedObject(module.view, kERResizeButtonKey);
                    if (remove && !remove.hidden) [remove.superview bringSubviewToFront:remove];
                    if (resize && !resize.hidden) [resize.superview bringSubviewToFront:resize];
                }
                UIView *pageIndicators = [overlay.view viewWithTag:kERPageIndicatorHostTag];
                if (pageIndicators && !pageIndicators.hidden) [overlay.view bringSubviewToFront:pageIndicators];
            }
        });
    } else {
        [collection.view.layer removeAnimationForKey:@"EchoRebornPageStackSlide"];
        if (!atomicPresentationReconcile) {
            [CATransaction begin];
            [CATransaction setDisableActions:YES];
        }
        changes();
        [CATransaction commit];
        if (gERPagerTransitionActive) ERLogPageGeometry(@"out", overlay, collection.view, pageOffset);
        if (!gERPagerTransitionActive && fabs(gERPagerInteractiveTranslation) < 0.01) [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
    }
}

- (void)animatePageSettleForOverlay:(UIViewController *)overlay
                          duration:(NSTimeInterval)duration
                    timingFunction:(CAMediaTimingFunction *)timingFunction
                      modelChanges:(dispatch_block_t)modelChanges
                        completion:(dispatch_block_t)completion {
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    if (!collection.view) {
        if (modelChanges) modelChanges();
        if (completion) completion();
        return;
    }

    // 1.0.7-2（第 2 条）：把「落位」做成一次**真正的滑动**，而不是硬切。
    //
    // 这条链路上出现过三种状态，对应用户三次反馈：
    //   · 1.0.6-13 及以前：slide 在播的整段时间里磁贴透明度停在「两页都可见」，
    //     目标页磁贴在动画最后一帧才冒出来 —— 用户报「闪一下」；
    //   · 1.0.6-14：把动画整段删掉 —— 页面变成一次硬切，用户报「卡 / 向上停留」；
    //   · 1.0.6-16：只在 applyPageTransformToOverlay 的 animated 分支里做了
    //     「可见性与跳转同帧」，但实际翻页走的是 animated:NO 分支 —— 根本没修到，
    //     用户仍报「还是很卡」。
    //
    // 本版两件事一起做：
    //   · 这里恢复 sublayerTransform 的滑动补间：**先**抓当前呈现值，**再**执行
    //     modelChanges，然后从旧值滑到新值 —— 时长与曲线由调用方按松手速度算好；
    //   · 调用方在 modelChanges 里**同步**收敛磁贴可见性（同帧，不再等动画结束），
    //     目标页磁贴从第一帧就在 —— 「闪」的根源就此消除。
    NSMutableArray<CALayer *> *layers = [NSMutableArray arrayWithObject:collection.view.layer];
    UIView *gridStack = objc_getAssociatedObject(overlay, kEREditGridStackKey);
    if (gridStack.layer) [layers addObject:gridStack.layer];

    for (CALayer *layer in layers) {
        [layer removeAnimationForKey:@"EchoRebornPageSettleTransform"];
        [layer removeAnimationForKey:@"EchoRebornPageSettleSublayerTransform"];
        [layer removeAnimationForKey:@"EchoRebornPageSettleBounds"];
        [layer removeAnimationForKey:@"EchoRebornPageSettleOpacity"];
    }

    CALayer *collectionLayer = collection.view.layer;
    // 1.0.7-4（第 1 条）：起点取**模型值**，不能取呈现值。
    //
    // 实机日志（1.0.7-3，一次只拖了 75pt 的轻扫）：
    //     PAGEGEO in  page=0 tr=-75.3 off=0.0    sub=-4.3  presSub=-4.3
    //     PAGEGEO out page=0 tr=-75.3 off=-75.3  sub=-75.3 presSub=-4.3
    //     PAGEGEO out page=1 tr=0.0   off=-968.0 sub=-968.0 presSub=-4.3
    //     PAGESETTLE from=-4.3 to=-968.0 dur=0.43
    // 模型已经跟手走到 -75.3，但呈现层还停在两帧前的 -4.3。拿呈现值当起点，
    // 补间就会从 -4.3 开始跑完整整 968pt —— 画面上的表现是「先弹回手指起点、
    // 再整页滑落」，正是用户说的「向上停留然后落下，感觉有点卡」。
    //
    // 拖动期间所有写入都是 setDisableActions:YES，模型值本身就等于屏幕上的位置，
    // 所以这里直接取模型值既准确又不需要等下一帧提交。
    CATransform3D fromSub = collectionLayer.sublayerTransform;

    if (modelChanges) modelChanges();

    CATransform3D toSub = collectionLayer.sublayerTransform;
    CAMediaTimingFunction *curve = timingFunction ?: [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
    CABasicAnimation *slide = [CABasicAnimation animationWithKeyPath:@"sublayerTransform"];
    slide.fromValue = [NSValue valueWithCATransform3D:fromSub];
    slide.toValue = [NSValue valueWithCATransform3D:toSub];
    slide.duration = duration;
    slide.timingFunction = curve;
    [collectionLayer addAnimation:slide forKey:@"EchoRebornPageSettleSublayerTransform"];
    ERLogInfo(@"PAGESETTLE ver=1.0.9-103 from=%.1f to=%.1f dur=%.2f", fromSub.m42, toSub.m42, duration);
    ERStartPageSettleProbe(collectionLayer);

    // 1.0.7-17（方案 A，实装）：快捷指令磁贴的宿主层参与同一条落位补间。
    //
    // 上个版本宣布做了这个，但**实际没有落码** —— 实机复测「没发生任何改变」
    // 完全正确，是我的疏漏，在此更正。磁贴的 center 已按**目标页**写好；要让
    // 它从旧页位置滑过来，宿主的起点平移 = 旧偏移 - 新偏移（与 collection 的
    // 位移严格相反），终点 = 0 —— 两条曲线同频同步，浮层观感消失。
    UIView *duplicateHost = [overlay.view viewWithTag:kEROwnedDuplicateHostTag];
    if (duplicateHost && fromSub.m42 != toSub.m42) {
        CATransform3D hostStart = CATransform3DMakeTranslation(0.0, fromSub.m42 - toSub.m42, 0.0);
        CABasicAnimation *hostSlide = [CABasicAnimation animationWithKeyPath:@"sublayerTransform"];
        hostSlide.fromValue = [NSValue valueWithCATransform3D:hostStart];
        hostSlide.toValue = [NSValue valueWithCATransform3D:CATransform3DIdentity];
        hostSlide.duration = duration;
        hostSlide.timingFunction = curve;
        [duplicateHost.layer addAnimation:hostSlide forKey:@"EchoRebornPageSettleDuplicateHost"];
    }

    id token = [NSObject new];
    objc_setAssociatedObject(overlay, kERPageAnimationTokenKey, token, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(duration * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (objc_getAssociatedObject(overlay, kERPageAnimationTokenKey) != token) return;
        for (CALayer *layer in layers) {
            [layer removeAnimationForKey:@"EchoRebornPageSettleSublayerTransform"];
        }
        if (duplicateHost.layer) [duplicateHost.layer removeAnimationForKey:@"EchoRebornPageSettleDuplicateHost"];
        if (completion) completion();
    });
}

- (void)setCurrentPage:(NSUInteger)page forOverlay:(UIViewController *)overlay animated:(BOOL)animated {
    if (!overlay || !gERPageCount) return;
    if (!gPagingEnabled) {
        page = 0;
        animated = NO;
    }
    gERPagerScrubbingActive = NO;
    if (animated) {
        gERPagerTransitionActive = YES;
        if (gEditModeActive) [self setEditControlsSuppressedForPaging:YES overlay:overlay animated:YES];
        [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:YES];
    } else {
        gERPagerTransitionActive = NO;
    }
    gERPagerHeldScale = 1.0;
    gERPagerHeldAlphaFactor = 1.0;
    gERPagerJelloScaleX = 1.0;
    gERPagerJelloScaleY = 1.0;
    gERCurrentPage = MIN(page, gERPageCount - 1);
    gERPagerInteractiveTranslation = 0.0;
    [self updatePageIndicatorsForOverlay:overlay];
    [self applyPageTransformToOverlay:overlay animated:animated];
    if (gPagingEnabled && gERControlCenterPresented && gERControlCenterPresentationState == 2) {
        for (NSNumber *delay in @[@0.0, @0.12, @0.42]) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                if (!gPagingEnabled || !gERControlCenterPresented ||
                    gERControlCenterPresentationState != 2 ||
                    fabs(gERPagerInteractiveTranslation) >= 0.01) return;
                ERRestoreNativeScrollBaseline(overlay);
            });
        }
    }
}

- (void)pageIndicatorTapped:(UIButton *)sender {
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    NSNumber *page = objc_getAssociatedObject(sender, @selector(pageIndicatorTapped:));
    if (!gPagingEnabled || !overlay || !page || gERExpandedModuleOpen) return;
    UIView *host = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    if ([objc_getAssociatedObject(host, kERPageIndicatorDraggingKey) boolValue]) return;
    ERHaptic();
    if (gERPagerScrubbingActive || gERPagerTransitionActive) {
        [self updateInteractivePageTransitionForOverlay:overlay
                                               progress:(CGFloat)page.unsignedIntegerValue
                                                 touchY:CGRectGetMidY(sender.frame)];
        [self finishInteractivePageTransitionForOverlay:overlay targetPage:page.unsignedIntegerValue];
    } else {
        [self setCurrentPage:page.unsignedIntegerValue forOverlay:overlay animated:YES];
    }
}

- (void)pageIndicatorTouchDown:(UIButton *)sender {
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    NSNumber *page = objc_getAssociatedObject(sender, @selector(pageIndicatorTapped:));
    if (!gPagingEnabled || !overlay || !page || gERExpandedModuleOpen || gERPagerTransitionActive) return;
    if (gEditModeActive) return;
    ERReassertNativeScrollClampForOverlay(overlay);
    [self beginInteractivePageTransitionForOverlay:overlay startPage:gERCurrentPage];
    [self updateInteractivePageTransitionForOverlay:overlay
                                           progress:(CGFloat)page.unsignedIntegerValue
                                             touchY:CGRectGetMidY(sender.frame)];
}

- (void)beginInteractivePageTransitionForOverlay:(UIViewController *)overlay startPage:(NSUInteger)startPage {
    if (!gPagingEnabled || !overlay || gERPageCount <= 1 || gERPagerTransitionActive) return;
    gERPagerTransitionActive = YES;
    gERPagerInteractiveStartPage = MIN(startPage, gERPageCount - 1);
    gERPagerInteractiveProgress = gERPagerInteractiveStartPage;
    gERCurrentPage = gERPagerInteractiveStartPage;
    gERPagerInteractiveTranslation = 0.0;
    gERPagerInteractiveBeganTime = CACurrentMediaTime();
    gERPagerScrubbingActive = YES;
    gERPagerHeldScale = 1.0;
    gERPagerHeldAlphaFactor = 1.0;
    gERPagerViscousProgress = (CGFloat)gERPagerInteractiveStartPage;
    gERPagerPreviousRawProgress = (CGFloat)gERPagerInteractiveStartPage;
    gERPagerFilteredVelocity = 0.0;
    gERPagerJelloScaleX = 1.0;
    gERPagerJelloScaleY = 1.0;
    gERPagerLastSampleTime = CACurrentMediaTime();
    ERReassertNativeScrollClampForOverlay(overlay);
    if (gEditModeActive) [self setEditControlsSuppressedForPaging:YES overlay:overlay animated:YES];
    UIView *host = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    [host.layer removeAllAnimations];
    for (UIView *button in host.subviews) {
        [button.layer removeAllAnimations];
        button.transform = CGAffineTransformIdentity;
    }
    [self updateTopFadeForOverlay:overlay presentationAlpha:1.0];
    [self setHeaderChromeHiddenForScrubbing:YES overlay:overlay animated:YES];
    // Scrubbing is a discrete page picker, not a scrolling stack. Keep only
    // the selected page composited; crossing an indicator swaps that page in
    // place through the pop animation below.
    [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];

    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    [self capturePresentationStateForView:collection.view];
    if (collection.view) {
        objc_setAssociatedObject(collection.view, kERScrubCollectionBoundsKey,
                                 [NSValue valueWithCGRect:collection.view.layer.bounds],
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(collection.view, kERScrubCollectionPositionKey,
                                 [NSValue valueWithCGPoint:collection.view.layer.position],
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (gEditModeActive) {
        NSMutableSet<NSValue *> *seenWrappers = [NSMutableSet set];
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            UIView *wrapper = module.view.superview;
            if (!wrapper || wrapper == collection.view) continue;
            NSValue *key = [NSValue valueWithNonretainedObject:wrapper];
            if ([seenWrappers containsObject:key]) continue;
            [seenWrappers addObject:key];
            [wrapper.layer removeAllAnimations];
            objc_setAssociatedObject(wrapper,
                                     kEREditScrubWrapperBaseTransformKey,
                                     [NSValue valueWithCGAffineTransform:wrapper.transform],
                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
    }
}

- (void)updateInteractivePageTransitionForOverlay:(UIViewController *)overlay progress:(CGFloat)progress touchY:(CGFloat)touchY {
    if (!overlay || !gERPagerTransitionActive) return;
    ERClampNativeScrollViewForOverlay(overlay);
    CGFloat maxProgress = (CGFloat)gERPageCount - 1.0;
    CGFloat clamped = MIN(maxProgress, MAX(0.0, progress));
    // Selection is bounded, while physics is allowed to continue past either
    // endpoint through a logarithmic resistance curve. This keeps viscosity
    // and jello alive above the first icon and below the last without letting
    // an extreme pull accumulate an enormous delayed catch-up distance.
    CGFloat physicsProgress = progress;
    if (progress < 0.0) physicsProgress = -log1p(-progress);
    else if (progress > maxProgress) physicsProgress = maxProgress + log1p(progress - maxProgress);
    NSUInteger previousCandidate = gERCurrentPage;

    CFTimeInterval now = CACurrentMediaTime();
    CGFloat dt = gERPagerLastSampleTime > 0.0 ? (CGFloat)(now - gERPagerLastSampleTime) : (1.0 / 60.0);
    dt = MIN(0.050, MAX(1.0 / 120.0, dt));
    CGFloat rawVelocity = (physicsProgress - gERPagerPreviousRawProgress) / dt;
    rawVelocity = MIN(8.0, MAX(-8.0, rawVelocity));
    CGFloat velocityResponse = 1.0 - exp(-dt * kERPagerJelloVelocityResponse);
    gERPagerFilteredVelocity += (rawVelocity - gERPagerFilteredVelocity) * velocityResponse;
    // Keep the icons under the finger, but let the visible page trail the raw
    // scrub position by a few frames. Filtering the full progress (rather than
    // only its within-page offset) carries the glue feeling cleanly across a
    // page threshold as well.
    CGFloat dragResponse = 1.0 - exp(-dt * kERPagerViscosityResponse);
    gERPagerViscousProgress += (physicsProgress - gERPagerViscousProgress) * dragResponse;
    CGFloat visualProgress = gERPagerViscousProgress;
    NSUInteger candidate = (NSUInteger)llround(MIN(maxProgress, MAX(0.0, visualProgress)));
    BOOL changedPage = candidate != previousCandidate;
    if (changedPage) ERHaptic();
    CGFloat pageTension = physicsProgress - visualProgress;
    gERPagerPreviousRawProgress = physicsProgress;
    gERPagerLastSampleTime = now;
    gERPagerInteractiveProgress = clamped;
    gERCurrentPage = candidate;
    // Keep the selected page centered. A small opposing parallax (at most
    // roughly half a module gap) preserves the feeling that the finger is
    // still pulling without exposing an adjacent page.
    CGFloat overlayHeight = CGRectGetHeight(overlay.view.bounds);
    CGFloat scrubHostHeight = kERPageIndicatorScrubStep * gERPageCount;
    CGFloat scrubHostMinY = floor((overlayHeight - scrubHostHeight) * 0.5);
    CGFloat fingerY = scrubHostMinY + touchY;
    CGFloat translationTarget = 0.0;
    BOOL endpointPull = NO;
    if (progress < 0.0) {
        CGFloat firstIconY = scrubHostMinY + kERPageIndicatorScrubStep * 0.5;
        CGFloat upperLimitY = overlayHeight * 0.10;
        CGFloat pull = MIN(1.0, MAX(0.0, (firstIconY - fingerY) / MAX(1.0, firstIconY - upperLimitY)));
        CGFloat eased = 1.0 - pow(1.0 - pull, 1.35);
        translationTarget = -MIN(100.0, overlayHeight * 0.12) * eased;
        endpointPull = YES;
    } else if (progress > maxProgress) {
        CGFloat lastIconY = scrubHostMinY + ((CGFloat)gERPageCount - 0.5) * kERPageIndicatorScrubStep;
        CGFloat lowerLimitY = overlayHeight * 0.90;
        CGFloat pull = MIN(1.0, MAX(0.0, (fingerY - lastIconY) / MAX(1.0, lowerLimitY - lastIconY)));
        CGFloat eased = 1.0 - pow(1.0 - pull, 1.35);
        translationTarget = MIN(100.0, overlayHeight * 0.12) * eased;
        endpointPull = YES;
    } else {
        translationTarget = (visualProgress - (CGFloat)candidate) * 22.0;
    }
    if (endpointPull) {
        gERPagerInteractiveTranslation += (translationTarget - gERPagerInteractiveTranslation) * dragResponse;
    } else {
        gERPagerInteractiveTranslation = translationTarget;
    }
    // Ease the whole page inward around the collection's center as the scrub
    // handoff begins. Reapplying this after the page translation keeps the
    // interactive paging coordinate system unchanged while giving the held
    // page the compact, suspended iOS 18 presentation.
    CGFloat entrance = gERPagerInteractiveBeganTime > 0.0 ?
        MIN(1.0, MAX(0.0, (CACurrentMediaTime() - gERPagerInteractiveBeganTime) / 0.26)) : 1.0;
    entrance = entrance * entrance * entrance * (entrance * (entrance * 6.0 - 15.0) + 10.0);
    CGFloat heldScale = 1.0 - 0.30 * entrance;
    gERPagerHeldScale = heldScale;
    gERPagerHeldAlphaFactor = 1.0 - 0.30 * entrance;
    CGFloat jelloInput = gERPagerFilteredVelocity * kERPagerJelloVelocityToScale +
                         pageTension * kERPagerJelloTensionToScale;
    CGFloat jello = MIN(kERPagerMaximumJelloScale,
                        MAX(-kERPagerMaximumJelloScale, jelloInput)) * entrance;
    gERPagerJelloScaleX = 1.0 - jello * 0.42;
    gERPagerJelloScaleY = 1.0 + jello;
    [self applyPageTransformToOverlay:overlay animated:NO];
    if (changedPage) [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];

    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    CGFloat baseAlpha = [objc_getAssociatedObject(collection.view, kEROriginalAlphaKey) doubleValue];
    collection.view.alpha = baseAlpha * gERPagerHeldAlphaFactor;
    if (gEditModeActive) {
        CGFloat wrapperProgress = (1.0 - heldScale) / 0.30;
        CGFloat wrapperX = kEREditScrubModuleWrapperCenteringX * wrapperProgress;
        CGFloat wrapperY = kEREditScrubModuleWrapperCenteringY * wrapperProgress;
        NSMutableSet<NSValue *> *seenWrappers = [NSMutableSet set];
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            UIView *wrapper = module.view.superview;
            if (!wrapper || wrapper == collection.view) continue;
            NSValue *key = [NSValue valueWithNonretainedObject:wrapper];
            if ([seenWrappers containsObject:key]) continue;
            [seenWrappers addObject:key];
            NSValue *baseValue = objc_getAssociatedObject(wrapper, kEREditScrubWrapperBaseTransformKey);
            if (!baseValue) {
                baseValue = [NSValue valueWithCGAffineTransform:wrapper.transform];
                objc_setAssociatedObject(wrapper, kEREditScrubWrapperBaseTransformKey, baseValue, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
            CGAffineTransform baseWrapper = baseValue.CGAffineTransformValue;
            wrapper.transform = CGAffineTransformTranslate(baseWrapper,
                                                           wrapperX,
                                                           wrapperY);
        }
    }

    if (changedPage) {
        // Pop the newly selected page in place. Animating module presentation
        // layers avoids changing private CCUI layout or leaving a second page
        // onscreen. Persistent Gaussian filters on oversized wrapper layers
        // caused the black rectangular intermediate surface, so this path is
        // deliberately bounded to transform + opacity.
        EREditGridView *grid = gEditModeActive ? [self editGridForPage:candidate overlay:overlay] : nil;
        if (grid) {
            [grid.layer removeAnimationForKey:@"EchoRebornPagerPopScale"];
            [grid.layer removeAnimationForKey:@"EchoRebornPagerPopFade"];
            CAKeyframeAnimation *gridScale = [CAKeyframeAnimation animationWithKeyPath:@"transform.scale"];
            gridScale.values = @[@0.90, @1.025, @1.0];
            gridScale.keyTimes = @[@0.0, @0.68, @1.0];
            gridScale.duration = 0.20;
            gridScale.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
            [grid.layer addAnimation:gridScale forKey:@"EchoRebornPagerPopScale"];
            CAKeyframeAnimation *gridFade = [CAKeyframeAnimation animationWithKeyPath:@"opacity"];
            gridFade.values = @[@0.08, @0.86, @1.0];
            gridFade.keyTimes = @[@0.0, @0.62, @1.0];
            gridFade.duration = 0.18;
            gridFade.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
            [grid.layer addAnimation:gridFade forKey:@"EchoRebornPagerPopFade"];
        }
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            NSString *identifier = ERModuleIdentifier(module);
            NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
            if (!nativeValue) continue;
            CCUILayoutRect rect = {};
            [nativeValue getValue:&rect];
            NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
            if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
            if (ERPageForRect(rect) != candidate) continue;
            [module.view.layer removeAnimationForKey:@"EchoRebornPagerPopScale"];
            [module.view.layer removeAnimationForKey:@"EchoRebornPagerPopFade"];
            CAKeyframeAnimation *scale = [CAKeyframeAnimation animationWithKeyPath:@"transform.scale"];
            scale.values = @[@0.90, @1.025, @1.0];
            scale.keyTimes = @[@0.0, @0.68, @1.0];
            scale.duration = 0.20;
            scale.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
            [module.view.layer addAnimation:scale forKey:@"EchoRebornPagerPopScale"];
            CAKeyframeAnimation *fade = [CAKeyframeAnimation animationWithKeyPath:@"opacity"];
            fade.values = @[@0.08, @0.86, @1.0];
            fade.keyTimes = @[@0.0, @0.62, @1.0];
            fade.duration = 0.18;
            fade.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
            [module.view.layer addAnimation:fade forKey:@"EchoRebornPagerPopFade"];
        }
    }

    UIView *host = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    CGFloat itemHeight = kERPageIndicatorScrubStep;
    CGFloat hostHeight = itemHeight * gERPageCount;
    CGFloat hostMinY = scrubHostMinY;
    void (^layoutPager)(void) = ^{
        host.frame = CGRectMake(CGRectGetWidth(overlay.view.bounds) - kERPageIndicatorScrubHostWidth - kERPageIndicatorScrubRightInset,
                                hostMinY,
                                kERPageIndicatorScrubHostWidth,
                                hostHeight);
        [host.subviews enumerateObjectsUsingBlock:^(__kindof UIView *button, NSUInteger page, __unused BOOL *stop) {
        button.bounds = CGRectMake(0.0, 0.0, kERPageIndicatorScrubHostWidth, itemHeight);
        CGFloat centerY = ((CGFloat)page + 0.5) * itemHeight;
        BOOL selected = page == candidate;
        CGFloat proximity = MAX(0.0, 1.0 - fabs(touchY - centerY) / (gEditModeActive ? 92.0 : 78.0));
        if (gEditModeActive) proximity = selected ? MAX(0.72, proximity) : proximity * 0.58;
        CGFloat scale = 1.18 + 1.68 * proximity + (selected ? 0.18 : 0.0);
        CGFloat pointSize = MIN(38.0, ERPageIndicatorBasePointSizeForPage(page) * scale);
        UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:pointSize weight:UIImageSymbolWeightSemibold];
        [(UIButton *)button setImage:[UIImage systemImageNamed:ERPageIndicatorSymbolForPage(page) withConfiguration:configuration] forState:UIControlStateNormal];
        CGFloat slideOut = kERPageIndicatorMaxSlideOut * proximity;
        CGFloat targetAlpha = MIN(1.0, (selected ? 0.86 : 0.28) + 0.36 * proximity);
        CGFloat tintWhite = selected ? 1.0 : (0.12 + 0.72 * proximity);
        UIColor *targetTint = [UIColor colorWithWhite:tintWhite alpha:selected || proximity > 0.58 ? 1.0 : 0.88];
        button.alpha = targetAlpha;
        button.tintColor = targetTint;
        button.center = CGPointMake(kERPageIndicatorScrubHostWidth * 0.5 - slideOut, centerY);
        button.transform = CGAffineTransformIdentity;
    }];
    };
    if (gEditModeActive) {
        [UIView animateWithDuration:0.08 delay:0.0 options:UIViewAnimationOptionCurveEaseOut | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction animations:layoutPager completion:nil];
    } else {
        layoutPager();
    }
    [self updateTopFadeForOverlay:overlay presentationAlpha:1.0];
}

- (void)finishInteractivePageTransitionForOverlay:(UIViewController *)overlay targetPage:(NSUInteger)targetPage {
    if (!overlay) return;
    ERReassertNativeScrollClampForOverlay(overlay);
    gERPagerInteractiveBeganTime = 0.0;
    NSUInteger target = MIN(targetPage, gERPageCount - 1);
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    gERCurrentPage = target;
    gERPagerInteractiveTranslation = 0.0;
    [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:YES];
    [self setHeaderChromeHiddenForScrubbing:NO overlay:overlay animated:YES];
    CGFloat baseAlpha = [objc_getAssociatedObject(collection.view, kEROriginalAlphaKey) doubleValue];
    void (^restoreWrapperBaseline)(BOOL clearBaseline) = ^(BOOL clearBaseline) {
        NSMutableSet<NSValue *> *seenWrappers = [NSMutableSet set];
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            UIView *wrapper = module.view.superview;
            if (!wrapper || wrapper == collection.view) continue;
            NSValue *key = [NSValue valueWithNonretainedObject:wrapper];
            if ([seenWrappers containsObject:key]) continue;
            [seenWrappers addObject:key];
            NSValue *baseValue = objc_getAssociatedObject(wrapper, kEREditScrubWrapperBaseTransformKey);
            if (baseValue) wrapper.transform = baseValue.CGAffineTransformValue;
            if (clearBaseline) objc_setAssociatedObject(wrapper, kEREditScrubWrapperBaseTransformKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
    };
    if (gEditModeActive) {
        [UIView performWithoutAnimation:^{
            restoreWrapperBaseline(NO);
        }];
    }
    [self animatePageSettleForOverlay:overlay
                            duration:0.30
                      timingFunction:[CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut]
                        modelChanges:^{
        ERClampNativeScrollViewForOverlay(overlay);
        gERPagerHeldScale = 1.0;
        gERPagerHeldAlphaFactor = 1.0;
        gERPagerJelloScaleX = 1.0;
        gERPagerJelloScaleY = 1.0;
        [self applyPageTransformToOverlay:overlay animated:NO];
        collection.view.alpha = baseAlpha;
    } completion:^{
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            [module.view.layer removeAnimationForKey:@"EchoRebornPagerPopScale"];
            [module.view.layer removeAnimationForKey:@"EchoRebornPagerPopFade"];
        }
        NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
        for (EREditGridView *grid in pageGrids.allValues) {
            [grid.layer removeAnimationForKey:@"EchoRebornPagerPopScale"];
            [grid.layer removeAnimationForKey:@"EchoRebornPagerPopFade"];
        }
        gERPagerScrubbingActive = NO;
        gERPagerTransitionActive = NO;
        objc_setAssociatedObject(collection.view, kERScrubCollectionBoundsKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(collection.view, kERScrubCollectionPositionKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        ERReassertNativeScrollClampForOverlay(overlay);
        gERPagerViscousProgress = (CGFloat)target;
        gERPagerFilteredVelocity = 0.0;
        gERPagerLastSampleTime = 0.0;
        UIView *host = [overlay.view viewWithTag:kERPageIndicatorHostTag];
        objc_setAssociatedObject(host, kERPageIndicatorDraggingKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [self applyPageTransformToOverlay:overlay animated:NO];
        [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
        [self updatePageIndicatorsForOverlay:overlay];
        [self updateTopFadeForOverlay:overlay presentationAlpha:0.0];
        if (gEditModeActive) {
            [UIView performWithoutAnimation:^{
                restoreWrapperBaseline(YES);
            }];
            [self prepareGridForOverlay:overlay collection:collection];
            [self updateEditControlFramesForOverlay:overlay];
            [self setEditControlsSuppressedForPaging:NO overlay:overlay animated:YES];
            UIView *pageIndicators = [overlay.view viewWithTag:kERPageIndicatorHostTag];
            if (pageIndicators && !pageIndicators.hidden) [overlay.view bringSubviewToFront:pageIndicators];
        }
    }];
}

- (void)pageIndicatorPanned:(UIPanGestureRecognizer *)gesture {
    UIView *host = gesture.view;
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    if (!gPagingEnabled || !overlay || !host || gERPageCount <= 1 ||
        gERExpandedModuleOpen || gERDragInProgress) return;
    CGPoint location = [gesture locationInView:host];
    CGFloat step = gERPagerScrubbingActive ? kERPageIndicatorScrubStep : kERPageIndicatorRestStep;
    CGFloat progress = ERPageProgressForScrubY(location.y, step, gERPageCount);
    if (gesture.state == UIGestureRecognizerStateBegan) {
        objc_setAssociatedObject(host, kERPageIndicatorDraggingKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERPagerStartPageKey, @(gERCurrentPage), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [self beginInteractivePageTransitionForOverlay:overlay startPage:gERCurrentPage];
        location = [gesture locationInView:host];
        progress = ERPageProgressForScrubY(location.y, kERPageIndicatorScrubStep, gERPageCount);
        [self updateInteractivePageTransitionForOverlay:overlay progress:progress touchY:location.y];
    } else if (gesture.state == UIGestureRecognizerStateChanged) {
        [self updateInteractivePageTransitionForOverlay:overlay progress:progress touchY:location.y];
    } else if (gesture.state == UIGestureRecognizerStateEnded || gesture.state == UIGestureRecognizerStateCancelled || gesture.state == UIGestureRecognizerStateFailed) {
        NSUInteger startPage = [objc_getAssociatedObject(gesture, kERPagerStartPageKey) unsignedIntegerValue];
        NSUInteger target = gesture.state == UIGestureRecognizerStateEnded ? (NSUInteger)llround(MIN((CGFloat)gERPageCount - 1.0, MAX(0.0, progress))) : startPage;
        objc_setAssociatedObject(gesture, kERPagerStartPageKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [self finishInteractivePageTransitionForOverlay:overlay targetPage:target];
    }
}

- (void)trackControlCenterPresentationGesture:(UIPanGestureRecognizer *)gesture overlay:(UIViewController *)overlay controller:(id)controller {
    if (!gPagingEnabled || !gesture || gERExpandedModuleOpen || gERDragInProgress) return;
    if (controller) gERPresentationController = controller;
    if (overlay) {
        // The pull gesture can begin before viewDidAppear/viewDidLayoutSubviews
        // has installed EchoReborn's pager.  Previously the tracker returned here,
        // so manually touching the pager was effectively required to prime the
        // next presentation. Bootstrap the persistent overlay on the first
        // pull callback instead.
        if (![gOverlayControllers containsObject:overlay]) {

            [self installOnOverlay:overlay];
        } else if (![overlay.view viewWithTag:kERPageIndicatorHostTag]) {

            [self installPagingOnOverlay:overlay];
        } else if (gERPageCount <= 1) {

            [self normalizePagedLayoutForOverlay:overlay];
        }
    }
    if (!overlay || gERPageCount <= 1) {

        return;
    }
    BOOL live = gesture.numberOfTouches > 0 &&
        (gesture.state == UIGestureRecognizerStateBegan || gesture.state == UIGestureRecognizerStateChanged);
    if (!live) {
        // The system recognizer can transition from its last Changed event to
        // Ended between display frames. Finish synchronously so a quick pull
        // cannot strand or skip the pager handoff.
        if (gERPresentationPanGesture == gesture) [self presentationPanDisplayLinkFired:nil];
        return;
    }
    if (gERPresentationPanGesture != gesture) {
        gERPresentationPanGesture = gesture;
    }
    [gERPresentationPanDiscoveryDisplayLink invalidate];
    gERPresentationPanDiscoveryDisplayLink = nil;
    gERPresentationPanDiscoveryOverlay = nil;
    gERPresentationPanDiscoveryController = nil;
    if (!gERPresentationPanDisplayLink) {
        gERPresentationPanDisplayLink = [CADisplayLink displayLinkWithTarget:self selector:@selector(presentationPanDisplayLinkFired:)];
        [gERPresentationPanDisplayLink addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
    }
    // Sample every private pull callback in addition to the display link.
    // This makes the vertical crossing deterministic even when a fast gesture
    // enters the pager band and releases inside a single refresh interval.
    [self presentationPanDisplayLinkFired:nil];
}

- (void)beginPresentationPanDiscoveryForOverlay:(UIViewController *)overlay controller:(id)controller {
    if (!gPagingEnabled || !overlay || gERPresentationPanGesture || gERPresentationNativeSettlePending || gERPresentationPageHandoffActive) return;
    gERPresentationPanDiscoveryOverlay = overlay;
    gERPresentationPanDiscoveryController = controller;
    gERPresentationPanDiscoveryDeadline = CACurrentMediaTime() + 0.75;
    if (!gERPresentationPanDiscoveryDisplayLink) {
        gERPresentationPanDiscoveryDisplayLink = [CADisplayLink displayLinkWithTarget:self selector:@selector(presentationPanDiscoveryDisplayLinkFired:)];
        [gERPresentationPanDiscoveryDisplayLink addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
    }
    [self presentationPanDiscoveryDisplayLinkFired:nil];
}

- (void)presentationPanDiscoveryDisplayLinkFired:(__unused CADisplayLink *)displayLink {
    UIViewController *overlay = gERPresentationPanDiscoveryOverlay;
    if (!gPagingEnabled || !overlay || gERPresentationPanGesture || CACurrentMediaTime() > gERPresentationPanDiscoveryDeadline) {
        [gERPresentationPanDiscoveryDisplayLink invalidate];
        gERPresentationPanDiscoveryDisplayLink = nil;
        gERPresentationPanDiscoveryOverlay = nil;
        gERPresentationPanDiscoveryController = nil;
        return;
    }
    UIView *root = overlay.view.window ?: overlay.view;
    UIPanGestureRecognizer *pan = nil;
    id controller = gERPresentationPanDiscoveryController;
    NSMutableArray *ownedRecognizers = [NSMutableArray array];
    for (NSString *selectorName in @[@"statusBarPullGestureRecognizer", @"indirectStatusBarPullGestureRecognizer", @"_presentGestureRecognizers"]) {
        SEL selector = NSSelectorFromString(selectorName);
        if (![controller respondsToSelector:selector]) continue;
        id value = ((id (*)(id, SEL))objc_msgSend)(controller, selector);
        if ([value isKindOfClass:[UIGestureRecognizer class]]) [ownedRecognizers addObject:value];
        else if ([value isKindOfClass:[NSArray class]]) [ownedRecognizers addObjectsFromArray:(NSArray *)value];
        else if ([value isKindOfClass:[NSSet class]]) [ownedRecognizers addObjectsFromArray:[(NSSet *)value allObjects]];
    }
    for (UIGestureRecognizer *gesture in ownedRecognizers) {
        if (![gesture isKindOfClass:[UIPanGestureRecognizer class]] || gesture.numberOfTouches == 0 ||
            (gesture.state != UIGestureRecognizerStateBegan && gesture.state != UIGestureRecognizerStateChanged)) continue;
        pan = (UIPanGestureRecognizer *)gesture;
        break;
    }
    if (!pan) pan = ERFindActiveControlCenterPresentationPan(root);
    if (!pan) return;

    [self trackControlCenterPresentationGesture:pan overlay:overlay controller:controller];
}

- (void)presentationPanDisplayLinkFired:(__unused CADisplayLink *)displayLink {
    if (!gPagingEnabled) {
        [gERPresentationPanDisplayLink invalidate];
        gERPresentationPanDisplayLink = nil;
        gERPresentationPanGesture = nil;
        gERPresentationController = nil;
        gERPresentationNativeSettlePending = NO;
        gERPresentationReleasedWhileSettling = NO;
        gERPresentationPageHandoffActive = NO;
        gERPresentationHandoffArmed = NO;
        return;
    }
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    UIPanGestureRecognizer *pan = gERPresentationPanGesture;
    UIView *host = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    if (overlay && !host) {
        [self updatePageIndicatorsForOverlay:overlay];
        host = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    }
    // SBPanSystemGestureRecognizer can remain in Changed while SpringBoard
    // performs its post-release presentation animation. Touch count, unlike
    // state, drops to zero immediately and is the reliable handoff boundary.
    BOOL live = pan && pan.numberOfTouches > 0 &&
        (pan.state == UIGestureRecognizerStateBegan || pan.state == UIGestureRecognizerStateChanged);
    if (!overlay || !host || !live) {
        if (gERPresentationNativeSettlePending) {
            // A very fast pull can release during the single run-loop turn in
            // which the native reveal is being committed. Preserve that fact
            // so the deferred handoff can begin and settle to the sampled page
            // instead of discarding the crossing or exposing a half-open CC.
            gERPresentationReleasedWhileSettling = YES;
            return;
        }
        if (overlay && gERPresentationPageHandoffActive) {
            NSUInteger target = (NSUInteger)llround(MIN((CGFloat)gERPageCount - 1.0, MAX(0.0, gERPagerInteractiveProgress)));
            [self finishInteractivePageTransitionForOverlay:overlay targetPage:target];
        }
        if (overlay && gERPresentationHandoffArmed && !gERPresentationPageHandoffActive) {
            gERPresentationNativeSettlePending = YES;
            gERPresentationReleasedWhileSettling = YES;
            __weak UIViewController *weakOverlay = overlay;
            dispatch_async(dispatch_get_main_queue(), ^{
                UIViewController *settledOverlay = weakOverlay;
                id controller = gERPresentationController;
                if (!settledOverlay || !gERPresentationNativeSettlePending) return;
                if ([controller respondsToSelector:@selector(presentAnimated:)]) {
                    ((void (*)(id, SEL, BOOL))objc_msgSend)(controller, @selector(presentAnimated:), NO);
                }
                [settledOverlay.view.window layoutIfNeeded];
                [settledOverlay.view layoutIfNeeded];
                [CATransaction flush];
                dispatch_async(dispatch_get_main_queue(), ^{
                    UIViewController *committedOverlay = weakOverlay;
                    if (!committedOverlay || !gERPresentationNativeSettlePending) return;
                    [committedOverlay.view.window layoutIfNeeded];
                    [committedOverlay.view layoutIfNeeded];
                    [committedOverlay.view.layer removeAllAnimations];
                    UIViewController *collection = [self moduleCollectionControllerInOverlay:committedOverlay];
                    [collection.view.layer removeAllAnimations];
                    gERPagerTransitionActive = NO;
                    gERPagerScrubbingActive = NO;
                    gERPagerInteractiveTranslation = 0.0;
                    [self applyPageTransformToOverlay:committedOverlay animated:NO];
                    [self updatePagedModuleVisibilityForOverlay:committedOverlay showAdjacent:NO];
                    gERPresentationNativeSettlePending = NO;
                    gERPresentationPageHandoffActive = YES;
                    gERPresentationHandoffArmed = NO;
                    [self beginInteractivePageTransitionForOverlay:committedOverlay startPage:gERCurrentPage];
                    [self updateInteractivePageTransitionForOverlay:committedOverlay progress:gERPresentationPendingProgress touchY:gERPresentationPendingTouchY];
                    NSUInteger target = (NSUInteger)llround(MIN((CGFloat)gERPageCount - 1.0, MAX(0.0, gERPagerInteractiveProgress)));
                    [self finishInteractivePageTransitionForOverlay:committedOverlay targetPage:target];
                    gERPresentationPageHandoffActive = NO;
                    gERPresentationReleasedWhileSettling = NO;
                    gERPresentationPanGesture = nil;
                    gERPresentationController = nil;
                    [gERPresentationPanDisplayLink invalidate];
                    gERPresentationPanDisplayLink = nil;
                });
            });
            return;
        }
        gERPresentationPageHandoffActive = NO;
        gERPresentationHandoffArmed = NO;
        gERPresentationPanGesture = nil;
        gERPresentationController = nil;
        [gERPresentationPanDisplayLink invalidate];
        gERPresentationPanDisplayLink = nil;
        return;
    }

    UIView *windowView = overlay.view.window ?: overlay.view;
    CGPoint windowLocation = [pan locationInView:windowView];
    // The iOS 16 delegate only reports "significant" presentation progress
    // at the settled boundary on this hardware. Crossing the pager's vertical
    // origin is therefore the handoff boundary regardless of horizontal touch
    // position; the gesture is already the dedicated top-right CC recognizer.
    CGFloat scrubHostHeight = kERPageIndicatorScrubStep * gERPageCount;
    CGFloat scrubHostMinY = floor((CGRectGetHeight(windowView.bounds) - scrubHostHeight) * 0.5);
    CGFloat scrubTouchY = windowLocation.y - scrubHostMinY;
    // Opening starts on page zero. Do not transfer ownership merely because
    // the finger entered the pager's enlarged hit region: wait until it
    // actually reaches the visible first page icon. Once claimed, the normal
    // expanded scrub geometry below remains in effect.
    CGFloat handoffY = scrubHostMinY + kERPageIndicatorScrubStep * 0.5;
    if (host.subviews.count) {
        UIView *firstIndicator = host.subviews.firstObject;
        CGPoint visibleIconCenter = [host convertPoint:firstIndicator.center toView:windowView];
        if (isfinite(visibleIconCenter.y) && visibleIconCenter.y > 0.0) handoffY = visibleIconCenter.y;
    }
    CGFloat armY = handoffY;
    CGFloat progress = ERPageProgressForScrubY(scrubTouchY, kERPageIndicatorScrubStep, gERPageCount);
    gERPresentationPendingProgress = progress;
    gERPresentationPendingTouchY = scrubTouchY;
    if (!gERPresentationPageHandoffActive && !gERPresentationNativeSettlePending && windowLocation.y >= armY) {
        gERPresentationHandoffArmed = YES;
    }
    BOOL shouldStartHandoff = windowLocation.y >= handoffY;
    if (!gERPresentationPageHandoffActive && !gERPresentationNativeSettlePending && shouldStartHandoff) {

        // SpringBoard's pull recognizer leaves the modular overlay in an
        // interactive stretched presentation. Starting our compact pager in
        // that state makes its scale compose with a moving native transform,
        // which produces the jump/halfway state seen at the handoff. Claim the
        // gesture now, then finish the native reveal on the next main-loop turn
        // before applying any EchoReborn pager transforms.
        gERPresentationNativeSettlePending = YES;
        gERPresentationReleasedWhileSettling = NO;
        __weak UIViewController *weakOverlay = overlay;
        dispatch_async(dispatch_get_main_queue(), ^{
            UIViewController *settledOverlay = weakOverlay;
            id controller = gERPresentationController;
            if (!settledOverlay || !gERPresentationNativeSettlePending) return;
            if ([controller respondsToSelector:@selector(presentAnimated:)]) {
                ((void (*)(id, SEL, BOOL))objc_msgSend)(controller, @selector(presentAnimated:), NO);
            }
            [settledOverlay.view.window layoutIfNeeded];
            [settledOverlay.view layoutIfNeeded];
            [CATransaction flush];
            dispatch_async(dispatch_get_main_queue(), ^{
                UIViewController *committedOverlay = weakOverlay;
                if (!committedOverlay || !gERPresentationNativeSettlePending) return;
                [committedOverlay.view.window layoutIfNeeded];
                [committedOverlay.view layoutIfNeeded];
                [committedOverlay.view.layer removeAllAnimations];
                UIViewController *collection = [self moduleCollectionControllerInOverlay:committedOverlay];
                [collection.view.layer removeAllAnimations];
                gERPagerTransitionActive = NO;
                gERPagerScrubbingActive = NO;
                gERPagerInteractiveTranslation = 0.0;
                [self applyPageTransformToOverlay:committedOverlay animated:NO];
                [self updatePagedModuleVisibilityForOverlay:committedOverlay showAdjacent:NO];

                gERPresentationNativeSettlePending = NO;
                gERPresentationPageHandoffActive = YES;
                gERPresentationHandoffArmed = NO;
                [self beginInteractivePageTransitionForOverlay:committedOverlay startPage:gERCurrentPage];
                [self updateInteractivePageTransitionForOverlay:committedOverlay
                                                       progress:gERPresentationPendingProgress
                                                         touchY:gERPresentationPendingTouchY];

                UIPanGestureRecognizer *currentPan = gERPresentationPanGesture;
                BOOL stillLive = currentPan && currentPan.numberOfTouches > 0 &&
                    (currentPan.state == UIGestureRecognizerStateBegan || currentPan.state == UIGestureRecognizerStateChanged);
                if (gERPresentationReleasedWhileSettling || !stillLive) {
                    NSUInteger target = (NSUInteger)llround(MIN((CGFloat)gERPageCount - 1.0, MAX(0.0, gERPagerInteractiveProgress)));
                    [self finishInteractivePageTransitionForOverlay:committedOverlay targetPage:target];
                    gERPresentationPageHandoffActive = NO;
                    gERPresentationHandoffArmed = NO;
                    gERPresentationReleasedWhileSettling = NO;
                    gERPresentationPanGesture = nil;
                    gERPresentationController = nil;
                    [gERPresentationPanDisplayLink invalidate];
                    gERPresentationPanDisplayLink = nil;
                }
            });
        });
        return;
    }
    if (gERPresentationPageHandoffActive) {
        [self updateInteractivePageTransitionForOverlay:overlay progress:progress touchY:scrubTouchY];
    }
}

- (void)updatePageIndicatorsForOverlay:(UIViewController *)overlay {
    if (!overlay.view) return;
    UIView *host = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    if (!host) {
        host = [[UIView alloc] initWithFrame:CGRectZero];
        host.tag = kERPageIndicatorHostTag;
        host.backgroundColor = UIColor.clearColor;
        host.userInteractionEnabled = YES;
        [overlay.view addSubview:host];
    }
    UIPanGestureRecognizer *indicatorPan = objc_getAssociatedObject(host, kERPageIndicatorPanKey);
    if (!indicatorPan) {
        indicatorPan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(pageIndicatorPanned:)];
        indicatorPan.maximumNumberOfTouches = 1;
        indicatorPan.cancelsTouchesInView = YES;
        objc_setAssociatedObject(indicatorPan, kEROwnGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(host, kERPageIndicatorPanKey, indicatorPan, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [host addGestureRecognizer:indicatorPan];
    }
    indicatorPan.enabled = gPagingEnabled;
    host.userInteractionEnabled = gPagingEnabled;
    if (!gPagingEnabled) {
        objc_setAssociatedObject(host, kERPageIndicatorDraggingKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [host.layer removeAllAnimations];
        host.hidden = YES;
        host.alpha = 0.0;
        return;
    }
    if ([objc_getAssociatedObject(host, kERPageIndicatorDraggingKey) boolValue]) {
        host.hidden = gERPageCount <= 1 || !gERControlCenterPresented || (gERExpandedModuleOpen && !ERExpandedChromeRevealActive());
        if (!host.hidden) [overlay.view bringSubviewToFront:host];
        return;
    }
    NSUInteger previousCount = [objc_getAssociatedObject(host, kERPageIndicatorCountKey) unsignedIntegerValue];
    BOOL countChanged = previousCount != gERPageCount;
    if (host.subviews.count > gERPageCount) {
        NSArray<UIView *> *extra = [host.subviews subarrayWithRange:NSMakeRange(gERPageCount, host.subviews.count - gERPageCount)];
        [UIView animateWithDuration:0.18 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
            for (UIView *view in extra) {
                view.alpha = 0.0;
                view.transform = CGAffineTransformMakeScale(0.72, 0.72);
            }
        } completion:^(__unused BOOL finished) {
            for (UIView *view in extra) [view removeFromSuperview];
        }];
    }
    while (host.subviews.count < gERPageCount) {
        NSUInteger page = host.subviews.count;
        ERExpandedHitButton *button = [ERExpandedHitButton buttonWithType:UIButtonTypeCustom];
        button.tintColor = UIColor.whiteColor;
        button.alpha = countChanged ? 0.0 : 1.0;
        button.transform = countChanged ? CGAffineTransformMakeScale(0.72, 0.72) : CGAffineTransformIdentity;
        [button addTarget:self action:@selector(pageIndicatorTouchDown:) forControlEvents:UIControlEventTouchDown];
        [button addTarget:self action:@selector(pageIndicatorTapped:) forControlEvents:UIControlEventTouchUpInside];
        [button addTarget:self action:@selector(pageIndicatorTapped:) forControlEvents:UIControlEventTouchUpOutside | UIControlEventTouchCancel];
        objc_setAssociatedObject(button, @selector(pageIndicatorTapped:), @(page), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [host addSubview:button];
    }
    objc_setAssociatedObject(host, kERPageIndicatorCountKey, @(gERPageCount), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    CGFloat itemHeight = gERPagerScrubbingActive ? kERPageIndicatorScrubStep : kERPageIndicatorRestStep;
    CGFloat hostHeight = itemHeight * gERPageCount;
    CGFloat hostWidth = gERPagerScrubbingActive ? kERPageIndicatorScrubHostWidth : kERPageIndicatorRestHostWidth;
    CGFloat rightInset = gERPagerScrubbingActive ? kERPageIndicatorScrubRightInset : kERPageIndicatorRestRightInset;
    // 1.0.9-6 · 只有横屏左移，竖屏完全不变
    if (ERLandscapePresentationActive()) rightInset += kERLandscapePageIndicatorShift;
    // Rest in the native-looking edge gutter, then slide inward only while
    // scrubbing so the enlarged symbol remains visible under the finger.
    CGRect targetHostFrame = CGRectMake(CGRectGetWidth(overlay.view.bounds) - hostWidth - rightInset,
                                        floor((CGRectGetHeight(overlay.view.bounds) - hostHeight) * 0.5),
                                        hostWidth,
                                        hostHeight);
    void (^layoutIndicators)(void) = ^{
        host.frame = targetHostFrame;
        [host.subviews enumerateObjectsUsingBlock:^(__kindof UIView *button, NSUInteger page, __unused BOOL *stop) {
            button.frame = CGRectMake(0.0, page * itemHeight, hostWidth, itemHeight);
            UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:ERPageIndicatorBasePointSizeForPage(page) weight:UIImageSymbolWeightSemibold];
            [(UIButton *)button setImage:[UIImage systemImageNamed:ERPageIndicatorSymbolForPage(page) withConfiguration:configuration] forState:UIControlStateNormal];
            BOOL selected = page == gERCurrentPage;
            button.alpha = selected ? 1.0 : 0.72;
            button.tintColor = selected ? UIColor.whiteColor : [UIColor colorWithWhite:0.12 alpha:0.88];
            button.transform = CGAffineTransformIdentity;
            objc_setAssociatedObject(button, @selector(pageIndicatorTapped:), @(page), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }];
    };
    if (countChanged && host.window) {
        [UIView animateWithDuration:0.24 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction animations:layoutIndicators completion:nil];
    } else {
        [UIView animateWithDuration:0.22 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction animations:layoutIndicators completion:nil];
    }
    BOOL revealActive = ERExpandedChromeRevealActive();
    host.hidden = gERPageCount <= 1 || !gERControlCenterPresented || (gERExpandedModuleOpen && !revealActive);
    if (!host.hidden) {
        [overlay.view bringSubviewToFront:host];
        if (!revealActive) {
            [UIView animateWithDuration:0.20 delay:0.0
                                options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction
                             animations:^{ host.alpha = 1.0; }
                             completion:nil];
        }
    }
}

- (void)pagePanned:(UIPanGestureRecognizer *)gesture {
    UIViewController *overlay = nil;
    for (UIViewController *candidate in gOverlayControllers.allObjects) if (candidate.view == gesture.view) { overlay = candidate; break; }
    if (!gPagingEnabled || !overlay || gERPageCount <= 1 ||
        gERExpandedModuleOpen || gERDragInProgress) return;
    if (gesture.state == UIGestureRecognizerStateBegan) {
        gERPagerTransitionActive = YES;
        if (gEditModeActive) [self setEditControlsSuppressedForPaging:YES overlay:overlay animated:YES];
        [self updateTopFadeForOverlay:overlay presentationAlpha:1.0];
        objc_setAssociatedObject(gesture, kERPagerStartPageKey, @(gERCurrentPage), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        gERPagerInteractiveTranslation = 0.0;
        gERPagerHeldScale = 1.0;
        gERPagerHeldAlphaFactor = 1.0;
        [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:YES];
        UIScrollView *nativeScrollView = ERNativeScrollViewForOverlay(overlay);
        NSValue *nativeBaseline = EREnsureNativeScrollBaseline(overlay);
        if (nativeScrollView && nativeBaseline) {
            ERClampNativeScrollViewForOverlay(overlay);
            objc_setAssociatedObject(gesture, kERPagerNativeScrollViewKey, nativeScrollView, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(gesture, kERPagerNativeOffsetKey, nativeBaseline, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        NSMutableArray<UIGestureRecognizer *> *suppressed = [NSMutableArray array];
        NSMutableArray<UIView *> *viewQueue = [NSMutableArray arrayWithObject:overlay.view];
        while (viewQueue.count) {
            UIView *view = viewQueue.firstObject;
            [viewQueue removeObjectAtIndex:0];
            for (UIGestureRecognizer *other in view.gestureRecognizers) {
                if (other == gesture || [objc_getAssociatedObject(other, kEROwnGestureKey) boolValue]) continue;
                if ([other isKindOfClass:[UIPanGestureRecognizer class]] && other.enabled) {
                    other.enabled = NO;
                    [suppressed addObject:other];
                }
            }
            [viewQueue addObjectsFromArray:view.subviews];
        }
        objc_setAssociatedObject(gesture, kERPagerSuppressedGesturesKey, suppressed, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }
    NSUInteger startPage = [objc_getAssociatedObject(gesture, kERPagerStartPageKey) unsignedIntegerValue];
    CGPoint translation = [gesture translationInView:overlay.view];
    if ((startPage == 0 && translation.y > 0.0) || (startPage + 1 >= gERPageCount && translation.y < 0.0)) translation.y *= 0.24;
    if (gesture.state == UIGestureRecognizerStateChanged) {
        gERCurrentPage = startPage;
        gERPagerInteractiveTranslation = translation.y;
        [self applyPageTransformToOverlay:overlay animated:NO];
        [self updateTopFadeForOverlay:overlay presentationAlpha:1.0];
        if (gEditModeActive) [self updateEditControlFramesForOverlay:overlay];
        return;
    }
    if (gesture.state == UIGestureRecognizerStateEnded || gesture.state == UIGestureRecognizerStateCancelled || gesture.state == UIGestureRecognizerStateFailed) {
        CGPoint velocity = [gesture velocityInView:overlay.view];
        NSInteger target = (NSInteger)startPage;
        if (gesture.state == UIGestureRecognizerStateEnded) {
            CGFloat visualPageSpan = ERVisualPageSpan();
            if (translation.y < -visualPageSpan * 0.16 || velocity.y < -520.0) target++;
            else if (translation.y > visualPageSpan * 0.16 || velocity.y > 520.0) target--;
        }
        target = MAX(0, MIN((NSInteger)gERPageCount - 1, target));
        UIScrollView *nativeScrollView = objc_getAssociatedObject(gesture, kERPagerNativeScrollViewKey);
        NSValue *nativeOffsetValue = objc_getAssociatedObject(gesture, kERPagerNativeOffsetKey);
        CGPoint nativeOffset = nativeOffsetValue ? nativeOffsetValue.CGPointValue : CGPointZero;
        if (nativeScrollView && nativeOffsetValue) {
            ERClampNativeScrollViewForOverlay(overlay);
            [nativeScrollView setContentOffset:nativeOffset animated:NO];
        }
        NSArray<UIGestureRecognizer *> *suppressedGestures = objc_getAssociatedObject(gesture, kERPagerSuppressedGesturesKey);
        if (gEditModeActive) {
            [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:YES];
            NSInteger delta = (NSInteger)startPage - target;
            gERCurrentPage = startPage;
            CGFloat finalTranslation = (CGFloat)delta * ERVisualPageSpan();
            CGFloat remaining = fabs(finalTranslation - gERPagerInteractiveTranslation);
            CGFloat releaseVelocity = fabs(velocity.y);
            CGFloat distanceFactor = MIN(1.0, remaining / MAX(ERVisualPageSpan(), 1.0));
            CGFloat velocityFactor = MIN(1.0, releaseVelocity / 1800.0);
            NSTimeInterval duration = MIN(0.42, MAX(0.24, 0.22 + distanceFactor * 0.20 - velocityFactor * 0.10));
            CAMediaTimingFunction *settleCurve = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
            [self animatePageSettleForOverlay:overlay duration:duration timingFunction:settleCurve modelChanges:^{
                gERCurrentPage = (NSUInteger)target;
                gERPagerInteractiveTranslation = 0.0;
                [self applyPageTransformToOverlay:overlay animated:NO];
                // 1.0.7-2（第 2 条）：磁贴可见性与页面跳转**同帧**收敛。
                // 拖动时为了跟手是「两页都可见」，落位这一帧必须收回到「只显示目标页」；
                // 以前要等 settle 动画结束才做，目标页磁贴在最后一帧才冒出来 ——
                // 这正是用户报的「闪一下」。同帧收敛之后，滑动过程中不会再有 pop。
                [self settlePagedModuleVisibilityForOverlay:overlay animated:NO token:nil];
                [self updateTopFadeForOverlay:overlay presentationAlpha:1.0];
            } completion:^{
                gERPagerTransitionActive = NO;
                [self applyPageTransformToOverlay:overlay animated:NO];
                [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
                [self updatePageIndicatorsForOverlay:overlay];
                [self updateTopFadeForOverlay:overlay presentationAlpha:0.0];
                [self prepareGridForOverlay:overlay collection:[self moduleCollectionControllerInOverlay:overlay]];
                [self updateEditControlFramesForOverlay:overlay];
                [self setEditControlsSuppressedForPaging:NO overlay:overlay animated:YES];
                for (UIGestureRecognizer *suppressed in suppressedGestures) suppressed.enabled = YES;
                if (nativeScrollView && nativeOffsetValue) {
                    ERClampNativeScrollViewForOverlay(overlay);
                    [nativeScrollView setContentOffset:nativeOffset animated:NO];
                }
            }];
        } else {
            for (UIGestureRecognizer *suppressed in suppressedGestures) suppressed.enabled = YES;
            ERLogInfo(@"[PAGER] flip start=%lu target=%ld translation=%.1f velocity=%.1f span=%.1f",
                       (unsigned long)startPage, (long)target, translation.y, velocity.y, ERVisualPageSpan());
            // Velocity-aware settle (mirrors the edit-mode branch above). The old
            // path used a fixed-duration curve via setCurrentPage:, so a fast
            // flick to the last page crawled the final stretch into place — the
            // "jelly overstick". Hold the page and ride the interactive
            // translation to the target on a spring scaled by release velocity,
            // then rebase in the completion.
            gERPagerTransitionActive = YES;
            gERPagerScrubbingActive = NO;
            [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:YES];
            NSInteger delta = (NSInteger)startPage - target;
            gERCurrentPage = startPage;
            CGFloat finalTranslation = (CGFloat)delta * ERVisualPageSpan();
            CGFloat remaining = fabs(finalTranslation - gERPagerInteractiveTranslation);
            CGFloat releaseVelocity = fabs(velocity.y);
            CGFloat distanceFactor = MIN(1.0, remaining / MAX(ERVisualPageSpan(), 1.0));
            CGFloat velocityFactor = MIN(1.0, releaseVelocity / 1800.0);
            NSTimeInterval duration = MIN(0.42, MAX(0.24, 0.22 + distanceFactor * 0.20 - velocityFactor * 0.10));
            UIScrollView *settleScrollView = nativeScrollView;
            NSValue *settleOffsetValue = nativeOffsetValue;
            CGPoint settleOffset = nativeOffset;
            CAMediaTimingFunction *settleCurve = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
            [self animatePageSettleForOverlay:overlay duration:duration timingFunction:settleCurve modelChanges:^{
                gERCurrentPage = (NSUInteger)target;
                gERPagerInteractiveTranslation = 0.0;
                [self applyPageTransformToOverlay:overlay animated:NO];
                // 1.0.7-2（第 2 条）：磁贴可见性与页面跳转**同帧**收敛。
                // 拖动时为了跟手是「两页都可见」，落位这一帧必须收回到「只显示目标页」；
                // 以前要等 settle 动画结束才做，目标页磁贴在最后一帧才冒出来 ——
                // 这正是用户报的「闪一下」。同帧收敛之后，滑动过程中不会再有 pop。
                [self settlePagedModuleVisibilityForOverlay:overlay animated:NO token:nil];
                [self updateTopFadeForOverlay:overlay presentationAlpha:1.0];
            } completion:^{
                gERPagerTransitionActive = NO;
                [self applyPageTransformToOverlay:overlay animated:NO];
                [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
                [self updatePageIndicatorsForOverlay:overlay];
                [self updateTopFadeForOverlay:overlay presentationAlpha:0.0];
                if (settleScrollView && settleOffsetValue) {
                    ERClampNativeScrollViewForOverlay(overlay);
                    [settleScrollView setContentOffset:settleOffset animated:NO];
                }
            }];
        }
        // The private scroll view can receive a final deferred offset write
        // after its pan is re-enabled. Reassert both native and EchoReborn settled
        // geometry across the short snap window so no page remains one span
        // above or below its selected indicator.
        if (!gEditModeActive) {
            for (NSNumber *delay in @[@0.0, @0.08, @0.24, @0.42]) {
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    if (nativeScrollView && nativeOffsetValue) {
                        ERClampNativeScrollViewForOverlay(overlay);
                        [nativeScrollView setContentOffset:nativeOffset animated:NO];
                    }
                    if (delay.doubleValue >= 0.4 && fabs(gERPagerInteractiveTranslation) < 0.01) [self applyPageTransformToOverlay:overlay animated:NO];
                });
            }
        }
        objc_setAssociatedObject(gesture, kERPagerStartPageKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERPagerSuppressedGesturesKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERPagerNativeScrollViewKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERPagerNativeOffsetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
}

- (void)installPagingOnOverlay:(UIViewController *)overlay {
    if (!gEnabled || !overlay.view) return;
    EREnsureNativeScrollBaseline(overlay);
    ERClampNativeScrollViewForOverlay(overlay);
    ERRestoreNativeScrollBaseline(overlay);
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    collection.view.clipsToBounds = NO;
    UIView *nativeCollectionView = ERFindSubviewWithClassName(collection.view, @"CCUIModuleCollectionView");
    nativeCollectionView.clipsToBounds = NO;
    for (UIView *ancestor = collection.view.superview; ancestor && ancestor != overlay.view; ancestor = ancestor.superview) ancestor.clipsToBounds = NO;
    UIPanGestureRecognizer *pager = nil;
    for (UIGestureRecognizer *gesture in overlay.view.gestureRecognizers) {
        if ([objc_getAssociatedObject(gesture, kERPagerGestureKey) boolValue]) { pager = (UIPanGestureRecognizer *)gesture; break; }
    }
    if (!pager) {
        pager = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(pagePanned:)];
        pager.maximumNumberOfTouches = 1;
        pager.cancelsTouchesInView = NO;
        pager.delegate = self;
        objc_setAssociatedObject(pager, kEROwnGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(pager, kERPagerGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [overlay.view addGestureRecognizer:pager];
    }
    for (UIGestureRecognizer *gesture in overlay.view.gestureRecognizers) {
        if (![objc_getAssociatedObject(gesture, @selector(modulePanned:)) isEqual:@"overlayPan"]) continue;
        if (objc_getAssociatedObject(pager, kERPagerModulePanDependencyKey) != gesture) {
            [pager requireGestureRecognizerToFail:gesture];
            objc_setAssociatedObject(pager, kERPagerModulePanDependencyKey, gesture, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        break;
    }
    pager.enabled = gPagingEnabled;
    [self normalizePagedLayoutForOverlay:overlay];
    if (!gPagingEnabled) {
        gERCurrentPage = 0;
        gERPagerTransitionActive = NO;
        gERPagerScrubbingActive = NO;
        gERPagerInteractiveTranslation = 0.0;
        gERPagerInteractiveProgress = 0.0;
        gERPagerInteractiveStartPage = 0;
        gERPresentationNativeSettlePending = NO;
        gERPresentationReleasedWhileSettling = NO;
        gERPresentationPageHandoffActive = NO;
        gERPresentationHandoffArmed = NO;
        gERPresentationPanGesture = nil;
        gERPresentationController = nil;
        [gERPresentationPanDisplayLink invalidate];
        gERPresentationPanDisplayLink = nil;
        [gERPresentationPanDiscoveryDisplayLink invalidate];
        gERPresentationPanDiscoveryDisplayLink = nil;
        gERPresentationPanDiscoveryOverlay = nil;
        gERPresentationPanDiscoveryController = nil;
        [self setHeaderChromeHiddenForScrubbing:NO overlay:overlay animated:NO];
        [self setEditControlsSuppressedForPaging:NO overlay:overlay animated:NO];
    }
    [self installTopFadeForOverlay:overlay];
    [self updatePageIndicatorsForOverlay:overlay];
    [self applyPageTransformToOverlay:overlay animated:NO];
    [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
}

- (void)installOnOverlay:(UIViewController *)controller {
    if (!gEnabled || !controller.view) return;
    [self installQuickAccessHostOnOverlay:controller];
    [self installTopFadeForOverlay:controller];
    // 1.0.7-25：横屏 chrome 上升的保底触发链 —— 无论布局钩子是否走到都补几次。
    [self scheduleLandscapeChromeRetryForOverlay:controller];
    if ([gOverlayControllers containsObject:controller]) return;
    if (gBlankSpaceGestureEnabled) {
        UILongPressGestureRecognizer *blankHold = [[UILongPressGestureRecognizer alloc] initWithTarget:self action:@selector(blankHeld:)];
        blankHold.minimumPressDuration = 0.55;
        blankHold.delegate = self;
        objc_setAssociatedObject(blankHold, kEROwnGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(blankHold, @selector(blankHeld:), @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [controller.view addGestureRecognizer:blankHold];
    }
    // Tapping blank space (outside modules / vacant grid cells) exits edit
    // mode; the delegate's tap branch rejects touches on modules and chrome.
    UITapGestureRecognizer *editExitTap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(editExitTapped:)];
    editExitTap.cancelsTouchesInView = NO;
    editExitTap.delegate = self;
    objc_setAssociatedObject(editExitTap, kEROwnGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [controller.view addGestureRecognizer:editExitTap];
    UIPanGestureRecognizer *editDismissPan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(editDismissPanned:)];
    editDismissPan.maximumNumberOfTouches = 1;
    editDismissPan.cancelsTouchesInView = YES;
    editDismissPan.delegate = self;
    objc_setAssociatedObject(editDismissPan, kEROwnGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(editDismissPan, kEREditDismissPanKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [controller.view addGestureRecognizer:editDismissPan];
    UILongPressGestureRecognizer *modulePan = [[UILongPressGestureRecognizer alloc] initWithTarget:self action:@selector(modulePanned:)];
    modulePan.minimumPressDuration = 0.01;
    modulePan.allowableMovement = CGFLOAT_MAX;
    modulePan.cancelsTouchesInView = YES;
    modulePan.delaysTouchesBegan = NO;
    modulePan.delaysTouchesEnded = NO;
    modulePan.delegate = self;
    objc_setAssociatedObject(modulePan, kEROwnGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(modulePan, @selector(modulePanned:), @"overlayPan", OBJC_ASSOCIATION_COPY_NONATOMIC);
    [controller.view addGestureRecognizer:modulePan];
    [editExitTap requireGestureRecognizerToFail:modulePan];
    [gOverlayControllers addObject:controller];
    ERExtendedModuleHitBridge *hitBridge = [[ERExtendedModuleHitBridge alloc] initWithFrame:controller.view.bounds];
    hitBridge.tag = kERExtendedHitBridgeTag;
    hitBridge.overlay = controller;
    hitBridge.backgroundColor = UIColor.clearColor;
    hitBridge.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    [controller.view addSubview:hitBridge];
    [self syncOwnedDuplicateModulesForOverlay:controller];
    [self installPagingOnOverlay:controller];
    [self applyRestingModuleOffsetToOverlay:controller];
}

// 1.0.7-25 · 横屏 chrome 上升的保底触发链。
//
// 实机日志（2026-09-18 02:04，横屏会话，span=352 确认是横屏）里一次 CHROMADUMP 都没有：
// 原来只靠 -viewDidLayoutSubviews（还带呈现状态门槛）触发，那条链在本机没走到。
// 这里改在「安装」这条一定会执行的链路上补一组延迟重试：0.15 / 0.4 / 0.9 / 1.8s，
// 每次都重新判定「CC 呈现 + 横屏」，命中就整体施加一次（applyLandscapeRise 幂等）。
- (void)scheduleLandscapeChromeRetryForOverlay:(UIViewController *)overlay {
    if (!overlay) return;
    CFTimeInterval now = CACurrentMediaTime();
    NSNumber *last = objc_getAssociatedObject(overlay, kERChromeRetryStampKey);
    if (last && now - last.doubleValue < 1.5) return;   // 节流：一次呈现最多排一轮
    objc_setAssociatedObject(overlay, kERChromeRetryStampKey, @(now), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    __weak EchoRebornCoordinator *weakSelf = self;
    __weak UIViewController *weakOverlay = overlay;
    for (NSNumber *delay in @[ @0.15, @0.4, @0.9, @1.8 ]) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIViewController *target = weakOverlay;
            if (!target || !gEnabled) return;
            if (!gERControlCenterPresented) return;
            [weakSelf applyLandscapeChromeRiseForOverlay:target];
        });
    }
}

// 0.5.17: 原地刷新方向相关的几何。
//
// -installQuickAccessHostOnOverlay: 只在首次真正创建 host，后续调用都在
// existingHost 分支 early-return。host 宽度是安装那一刻算出的常量，所以
// 「竖屏装好 → 转横屏」时宽度会永久停在 430pt，电源键落在 x≈388 而不是右边缘。
// 这里把宽度约束和两枚按钮的纵向基准重新对齐到当前方向。
- (void)updateQuickAccessGeometryForHost:(UIView *)host overlay:(UIViewController *)controller {
    if (!host || !controller.view) return;
    NSLayoutConstraint *widthConstraint = objc_getAssociatedObject(host, kERQuickAccessWidthConstraintKey);
    CGFloat width = ERQuickAccessHostWidth(controller);
    if (widthConstraint && fabs(widthConstraint.constant - width) > 0.5) {
        widthConstraint.constant = width;
        ERLogInfo(@"LANDSCAPECHROME ver=1.0.9-103 host-width=%.1f", width);
    }
    CGFloat centerY = ERQuickAccessCenterYOffset(controller);
    // 1.0.1：横向缩进 / 按钮大小 / 字形尺寸也在这里原地刷新。
    // 这两个值来自「增强设置 → 操作按钮」的滑杆，写完只发一条 ReloadPrefs 通知，
    // host 不会重建；不在这里改约束，用户就得 respring 才能看到效果。
    CGFloat inset = ERQuickAccessButtonInset();
    CGFloat side = ERQuickAccessButtonSide();
    CGFloat glyphSide = round(side * 0.75);
    BOOL anySizeChanged = NO;
    for (UIView *button in host.subviews) {
        if (button.tag != 181001 && button.tag != 181002) continue;
        NSLayoutConstraint *centerYConstraint = objc_getAssociatedObject(button, kERQuickAccessCenterYConstraintKey);
        if (centerYConstraint && fabs(centerYConstraint.constant - centerY) > 0.5) centerYConstraint.constant = centerY;

        BOOL insetChanged = NO;
        NSLayoutConstraint *leading = objc_getAssociatedObject(button, kERQuickAccessLeadingConstraintKey);
        if (leading && fabs(leading.constant - inset) > 0.5) { leading.constant = inset; insetChanged = YES; }
        NSLayoutConstraint *trailing = objc_getAssociatedObject(button, kERQuickAccessTrailingConstraintKey);
        if (trailing && fabs(trailing.constant + inset) > 0.5) { trailing.constant = -inset; insetChanged = YES; }

        BOOL sizeChanged = NO;
        NSArray<NSLayoutConstraint *> *sizeConstraints = objc_getAssociatedObject(button, kERQuickAccessSizeConstraintsKey);
        for (NSLayoutConstraint *constraint in sizeConstraints) {
            if (fabs(constraint.constant - side) <= 0.5) continue;
            constraint.constant = side;
            sizeChanged = YES;
        }
        // 只缩进变了也要记一行日志（-Werror 下这个标志必须被读，否则判为未使用变量）。
        if (insetChanged) anySizeChanged = YES;
        if (!sizeChanged) continue;
        anySizeChanged = YES;

        // 边长变了，字形视图的框与字形图片本身都要跟着重算，
        // 否则小按钮上会留一圈空隙、大按钮上字形偏小。
        UIImageView *glyphView = objc_getAssociatedObject(button, kERQuickAccessGlyphViewKey);
        NSString *symbolName = objc_getAssociatedObject(button, kERQuickAccessGlyphNameKey);
        if (!glyphView || ![symbolName length]) continue;
        for (NSLayoutConstraint *constraint in glyphView.constraints) {
            if (constraint.firstAttribute != NSLayoutAttributeWidth &&
                constraint.firstAttribute != NSLayoutAttributeHeight) continue;
            constraint.constant = glyphSide;
        }
        if ([self respondsToSelector:@selector(symbol:size:)]) {
            UIImage *image = [[self symbol:symbolName size:MAX(11.0, round(side * 0.375))]
                imageWithTintColor:[UIColor colorWithWhite:1.0 alpha:0.97]
                     renderingMode:UIImageRenderingModeAlwaysOriginal];
            if (image) glyphView.image = image;
        }
    }
    if (anySizeChanged) {
        ERLogInfo(@"QUICKACCESSGEOM ver=1.0.9-103 inset=%.1f size=%.1f glyph=%.1f", inset, side, glyphSide);
    }
}

// 0.5.19 横屏：把顶部 chrome（状态栏本体 + 隐私指示条）移到用户标注的位置。
//
// 命中集与 0.5.18 的区别：
//   · 补上 "StatusLabel" —— 通栏状态栏的类名是 CCUIStatusLabel，0.5.18 用
//     "StatusBar" 匹配，永远够不到它，这是「完全没动」的第一根因。
//   · HeaderPocket 不再整体平移（它顶边 = 0，平移没有意义），改成「容器」：
//     挑里面够宽够薄的直接子视图，这样即便状态栏挂在匿名 UIView 上也能动。
//   · 解除 pocket 裁剪，避免状态栏移出 pocket 顶边后被切掉半截。
//
// 实现要点：
//   · 只改 transform，不动 frame（frame 是 iOS 的布局结果，且外壳还带着 CC 的
//     呈现动画 transform）。
//   · 基准 transform 自己存一份（kERLandscapeChromeBaseTransformKey）保证幂等：
//     每次重写成 base − rise，重复调用不会累积成双倍位移；rise = 0 即还原。
// 1.0.8-58 · 设置页「横屏状态栏 → 权限胶囊偏移」（-120…+120，正值往下）。
// 与状态栏行偏移**完全独立**：各自滑杆、各自偏好键，互不影响。
static CGFloat ERLandscapePillOffset(void) {
    CGFloat value = 0.0;
    CFPropertyListRef raw = CFPreferencesCopyAppValue(CFSTR("Landscape.PillOffset"),
                                                      CFSTR("com.strive.echoreborn.preferences"));
    if (raw) {
        if (CFGetTypeID(raw) == CFNumberGetTypeID()) {
            value = (CGFloat)[(__bridge NSNumber *)raw doubleValue];
        }
        CFRelease(raw);
    }
    return MIN(MAX(value, -120.0), 120.0);
}

- (void)applyLandscapeChromeRiseForOverlay:(UIViewController *)overlay {
    if (!gEnabled || !overlay.view) return;
    BOOL landscape = ERLandscapePresentationActive();
    BOOL active = landscape && gERControlCenterPresented;

    UIWindow *window = overlay.view.window;
    NSMutableArray<UIView *> *statusBar = [NSMutableArray array];
    NSMutableArray<UIView *> *indicator = [NSMutableArray array];
    [self collectLandscapeStatusBarViews:statusBar indicator:indicator inRoot:overlay.view window:window];
    // 1.0.7-24：类名一个都没命中时的几何兜底 —— 先在 CC 自己的窗口里找，
    // 再退到系统状态栏窗口里找（那条带可能根本不在 overlay 子树里）。
    BOOL usedFallback = NO;
    if (active && statusBar.count == 0) {
        usedFallback = YES;
        [self collectLandscapeFallbackStatusBarViews:statusBar inRoot:overlay.view window:window];
        if (statusBar.count == 0) {
            for (UIWindow *w in ERAllApplicationWindows()) {
                if (w == window) continue;
                if (![NSStringFromClass(w.class) containsString:@"StatusBar"]) continue;
                [self collectLandscapeFallbackStatusBarViews:statusBar inRoot:w window:w];
                if (statusBar.count) break;
            }
        }
        ERLogInfo(@"LANDSCAPECHROME ver=1.0.9-103 fallback hits=%lu", (unsigned long)statusBar.count);
    }
    // 1.0.7-25：进入日志（每秒最多一条）—— 用它判断这条链到底有没有被走到。
    static CFTimeInterval chromeEnterLoggedAt = 0.0;
    CFTimeInterval chromeNow = CACurrentMediaTime();
    if (chromeNow - chromeEnterLoggedAt > 1.0) {
        chromeEnterLoggedAt = chromeNow;
        ERLogInfo(@"LANDSCAPECHROME ver=1.0.9-103 enter landscape=%d active=%d presented=%d state=%lu hits=%lu fallback=%d",
                   (int)landscape, (int)active, (int)gERControlCenterPresented,
                   (unsigned long)gERControlCenterPresentationState, (unsigned long)statusBar.count,
                   (int)usedFallback);
        [self dumpLandscapeTopViewsForDiagnosis];
    }

    // 诊断先于改写：这时读到的还是「原生/基准」位置。
    [self dumpLandscapeChromeDiagnosticsForOverlay:overlay landscape:active matched:statusBar];

    // 1.0.7-27：rise 改为**逐视图反算**（base 顶边 − 16.5，夹取 [0,200]）。
    // 023615 日志实测这条带在 y 43.7 —— 不是 0.5.19 当时的 78.5，固定 62 会把它
    // 顶出屏幕外（43.7-62=-18.3）；反算后落到 16.5，与隐私指示头同一套打法。
    static BOOL statusRiseLogged = NO;
    if (active && !statusRiseLogged) {
        statusRiseLogged = YES;
        ERLogInfo(@"LANDSCAPECHROME ver=1.0.9-103 statusbar-rise targetTop=%.1f targetCenterY=%.1f hits=%lu",
                   kERLandscapeStatusBarTargetTop, kERLandscapeStatusBarTargetCenterY,
                   (unsigned long)statusBar.count);
    } else if (!active) {
        statusRiseLogged = NO;
    }
    // 1.0.7-28：位移改落在**外层容器**上。
    // 023615 日志里可见那条带（CCUIStatusBar）的 transform 会被系统在两次写入之间
    // 重置；叶子视图追不上，但它的外层容器（HeaderPocket / 匿名容器）不由系统逐帧驱动。
    NSMutableArray<UIView *> *appliedViews = [NSMutableArray array];
    NSMutableArray<NSNumber *> *appliedRises = [NSMutableArray array];
    for (UIView *view in statusBar) {
        // 1.0.8-4：与**已被证实可用**的隐私指示头那条路径完全一致 —— 位移直接落在这条带
        // 自己身上，rise 从它自己的基准顶边反算。
        //
        // 为什么放弃「移到外层小容器」：横屏截图（a9ae5185）里，屏幕上那条
        // 主号/副号/WiFi/电量 的带子仍在离顶约 90pt 处，而日志显示我们把 CCUIStatusBar
        // 写到 16.5 并没有反映到它身上 —— 被移动的不是可见的这一条。
        // 反过来，隐私指示头用「就地移动 + 20Hz 补写」一直很准（日志稳定 winY=16.5）。
        // 所以状态带照搬同一套：就地移动、逐视图反算、不共享会话级的单一数值。
        // 1.0.8-49 · 撤销 1.0.8-41~48 的「状态栏偏移」。
        // 五个版本的实测结论：这条行的位置**归系统所有**，系统会在自己的布局里把
        // transform/frame 写回 —— 我们写 transform，定时器方案闪（-44/45）、
        // 布局钩子方案无限布局卡死（-46/47）、显示链路方案依旧闪且滑杆无效（-48）。
        // 在没有逆向清楚 CCUI/STUI 内部布局来源之前，这条路不能再走。
        // 横屏状态栏回到长期稳定的系统原位（不再写它的 transform）。
        CGFloat statusRise = [self landscapeChromeRiseForContainer:view landscape:active];
        if (statusRise <= 0.0) continue;
        [self applyLandscapeRise:statusRise toView:view];
        if (![appliedViews containsObject:view]) {
            [appliedViews addObject:view];
            [appliedRises addObject:@(statusRise)];
        }
    }
    // 1.0.8-59 · 胶囊诊断：indicator 有没有找到视图、偏移读了多少（3 秒一条）
    static CFTimeInterval gERPillDiagLast = 0.0;
    CFTimeInterval pillDiagNow = CACurrentMediaTime();
    BOOL pillDiag = (active && pillDiagNow - gERPillDiagLast >= 3.0);
    if (pillDiag) gERPillDiagLast = pillDiagNow;
    for (UIView *view in indicator) {
        // 1.0.8-60 · 胶囊类改由 setFrame: 源头拦截持有，indicator 的 transform 写入让位
        if ([NSStringFromClass(view.class) hasPrefix:@"CCUISensorAttribution"]) continue;
        // 1.0.8-60 · 非 SensorAttribution 的 indicator 成员仍走原路径（目前为空集）
        [self applyLandscapeRise:0.0 toView:view];
    }
    if (active && pillDiag) {
        ERLogInfo(@"PILL-DIAG indicatorN=%lu pillOff=%.1f（胶囊类已改由源头拦截持有）",
                  (unsigned long)indicator.count, ERLandscapePillOffset());
    }
    if (active && pillDiag && indicator.count == 0) {
        ERLogInfo(@"PILL-DIAG indicator 为空 —— 胶囊不在 overlay 收集路径上（与状态栏行当年同款问题）");
    }
    if (active && appliedViews.count) {
        for (NSUInteger index = 0; index < appliedViews.count; index++) {
            ERChromeReassertRegisterView(appliedViews[index], appliedRises[index].doubleValue);
        }
        ERStartLandscapeChromeReassertIfNeeded();
    } else if (!active) {
        ERStopLandscapeChromeReassert();
        // 1.0.8-1：回到竖屏就作废这次量到的位移量，下一次横屏重新按真实位置反算。
        gERStatusBandRiseValid = NO;
        gERStatusBandRise = 0.0;
    }

    // 系统状态栏窗口（CC 里那条状态栏可能挂在这儿，不在 overlay 子树里）。
    if (active) {
        [self applyLandscapeRiseToSystemStatusBarExcludingWindow:window];
    } else {
        [self restoreLandscapeSystemStatusBarIfNeeded];
    }
}

// 判定「像不像那条通栏状态栏」：换算到窗口坐标后，宽 ≥ 窗口一半、高 ≤ 60pt。
//
// 实测 pocket 的直接子视图：MTMaterialView 高 ≈ 90pt（被高门槛排除）、
// 「+」/电源按钮宽 40pt（被宽门槛排除）、CCUIStatusLabel 宽 932 高 44（命中）。
// 1.0.8-41 · 设置页「横屏状态栏 → 状态栏偏移」（-120…+120，正值往下）。
// 每次都现读 —— 拖动滑杆走 ReloadPrefs 即时生效，不缓存。
static CGFloat ERLandscapeStatusBarOffset(void) {
    CGFloat value = 0.0;
    CFPropertyListRef raw = CFPreferencesCopyAppValue(CFSTR("Landscape.StatusBarOffset"),
                                                      CFSTR("com.strive.echoreborn.preferences"));
    if (raw) {
        if (CFGetTypeID(raw) == CFNumberGetTypeID()) {
            value = (CGFloat)[(__bridge NSNumber *)raw doubleValue];
        }
        CFRelease(raw);
    }
    return MIN(MAX(value, -120.0), 120.0);
}


// 1.0.8-57 · 横屏状态栏行的**原生基准 Y**（用户禁用全部插件实测：CCUIStatusBar 与
// STUIStatusBar_Wrapper 均为 y=43.7）。钉死模式用它 + 滑杆偏移作为唯一落点。
static CGFloat const kERLandscapeStatusBarNativeY = 43.7;

- (BOOL)isLandscapeStatusBarLikeView:(UIView *)view inWindow:(UIWindow *)window {
    if (!view || !window) return NO;
    CGRect rect = [view convertRect:view.bounds toView:window];
    if (CGRectIsEmpty(rect)) return NO;
    if (CGRectGetWidth(window.bounds) <= 1.0 || CGRectGetHeight(window.bounds) <= 1.0) return NO;
    // 1.0.8-49 · 恢复原始门槛（1.0.8-41~48 的放宽/排除全部撤销）
    if (CGRectGetWidth(rect) < CGRectGetWidth(window.bounds) * kERLandscapeStatusBarMinWidthRatio) return NO;
    if (CGRectGetHeight(rect) > kERLandscapeStatusBarMaxHeight) return NO;
    if (CGRectGetMinY(rect) > CGRectGetHeight(window.bounds) * 0.5) return NO;
    return YES;
}


// 收集横屏要平移的 chrome 视图。statusBar 走固定 rise，indicator 走反算 rise。
- (void)collectLandscapeStatusBarViews:(NSMutableArray<UIView *> *)statusBar
                             indicator:(NSMutableArray<UIView *> *)indicator
                                inRoot:(UIView *)root
                                window:(UIWindow *)window {
    if (!root) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    NSInteger visited = 0;
    while (queue.count && visited < 4000) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        visited++;
        // EchoReborn 自己的宿主与「+」/电源按钮绝不参与平移。
        if (candidate.tag == 181000 || candidate.tag == 181001 || candidate.tag == 181002) continue;
        NSString *name = NSStringFromClass(candidate.class);
        if ([name containsString:@"SensorAttribution"]) {
            if (indicator && ![indicator containsObject:candidate]) [indicator addObject:candidate];
            continue;   // 命中即不再下探：避免嵌套同名视图叠加成双倍位移
        }
        if ([name containsString:@"StatusLabel"] || [name containsString:@"StatusBar"]) {
            if (statusBar && ![statusBar containsObject:candidate]) [statusBar addObject:candidate];
            continue;
        }
        if ([name containsString:@"HeaderPocket"]) {
            candidate.clipsToBounds = NO;
            for (UIView *child in candidate.subviews) {
                if (child.tag == 181000 || child.tag == 181001 || child.tag == 181002) continue;
                if (![self isLandscapeStatusBarLikeView:child inWindow:window]) continue;
                if (statusBar && ![statusBar containsObject:child]) [statusBar addObject:child];
            }
            // 1.0.7-24：继续下探 pocket 的孙层。0.5.19 在这里直接 continue，
            // 于是「pocket → 匿名容器 → StatusLabel」这种多一层的情况永远够不到 ——
            // 实机「状态栏还是原样」的第一根因。
            [queue addObjectsFromArray:candidate.subviews];
            continue;   // pocket 自身不平移
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

// 1.0.7-24 · 几何兜底：类名认不出状态栏时的最后一道。
//
// 0.5.19 靠类名（StatusLabel / StatusBar）+ pocket 直接子视图认那条通栏状态栏。
// 实机反馈「状态栏还是原样」，说明命中的不是真正显示出来的那条带 —— 可能类名变了，
// 也可能它嵌得更深。这里的判定只用几何：横屏 + CC 呈现时，屏幕顶部 130pt 里
// 「够宽（≥ 窗口一半）又够薄（≤ 60pt）」的视图，除了那条通栏状态栏（双卡 / WiFi /
// 蓝牙 / 电量，实测高约 32pt），没有第二个候选：材质背景高约 90pt、「+」/电源只有
// 40pt 宽、分页指示器在底部。
- (void)collectLandscapeFallbackStatusBarViews:(NSMutableArray<UIView *> *)statusBar
                                        inRoot:(UIView *)root
                                        window:(UIWindow *)window {
    if (!root || !window) return;
    CGFloat windowWidth = CGRectGetWidth(window.bounds);
    if (windowWidth <= 1.0) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    NSInteger visited = 0;
    while (queue.count && visited < 4000) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        visited++;
        // EchoReborn 自己的宿主、「+」/电源、编辑网格都不参与。
        if (candidate.tag == 181000 || candidate.tag == 181001 || candidate.tag == 181002 ||
            candidate.tag == kEREditGridTag) continue;
        if (candidate.hidden || candidate.alpha < 0.05) continue;
        CGRect rect = [candidate convertRect:candidate.bounds toView:window];
        if (CGRectIsEmpty(rect)) continue;
        BOOL wide = CGRectGetWidth(rect) >= windowWidth * kERLandscapeStatusBarMinWidthRatio;
        BOOL thin = CGRectGetHeight(rect) <= kERLandscapeStatusBarMaxHeight;
        BOOL top = CGRectGetMinY(rect) <= 130.0 && CGRectGetMaxY(rect) > 0.0;
        if (wide && thin && top) {
            if (![statusBar containsObject:candidate]) [statusBar addObject:candidate];
            continue;   // 命中即停：父子同时命中会叠成双倍位移
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

// 系统状态栏窗口里的那条状态栏。
//
// iOS 在 CC 里显示的状态栏（双卡 主号/副号 + WiFi + 蓝牙 + 电量）未必挂在 CC 的
// overlay 子树里，也可能在独立的 UIStatusBarWindow —— 0.5.18 只扫 overlay，
// 这也是够不到它的原因之一。这里按窗口类名精确限定，只在「CC 呈现 + 横屏」时平移，
// 并把移过的视图登记起来，CC 收起 / 回到竖屏时统一还原，不把 App 的横屏状态栏带偏。
- (void)applyLandscapeRiseToSystemStatusBarExcludingWindow:(UIWindow *)excluded {
    if (!gERLandscapeSystemStatusBarMoved) {
        gERLandscapeSystemStatusBarMoved = [NSMutableArray array];
    }
    NSMutableArray<UIWindow *> *windows = [NSMutableArray array];
    NSArray<UIWindow *> *candidates = ERAllApplicationWindows();
    for (UIWindow *window in candidates) {
        if (window == excluded) continue;
        if (![NSStringFromClass(window.class) containsString:@"StatusBar"]) continue;
        if (![windows containsObject:window]) [windows addObject:window];
    }
    if (!windows.count) return;
    for (UIWindow *window in windows) {
        NSMutableArray<UIView *> *matches = [NSMutableArray array];
        NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:window];
        NSInteger visited = 0;
        while (queue.count && visited < 2000) {
            UIView *candidate = queue.firstObject;
            [queue removeObjectAtIndex:0];
            visited++;
            NSString *name = NSStringFromClass(candidate.class);
            // 系统状态栏窗口里不做「够薄」限制：_UIStatusBar 常常铺满整个窗口
            // （高=窗口高），加了高度门槛会被误杀。这个窗口本身专供状态栏，
            // 取「最外层的、够宽的状态栏类视图」即可 —— 连着窗口一起平移也是对的。
            CGRect rect = [candidate convertRect:candidate.bounds toView:window];
            BOOL wide = CGRectGetWidth(window.bounds) > 1.0 &&
                        CGRectGetWidth(rect) >= CGRectGetWidth(window.bounds) * kERLandscapeStatusBarMinWidthRatio;
            if (wide && ([name containsString:@"StatusBar"] || [name containsString:@"StatusLabel"])) {
                [matches addObject:candidate];
                continue;   // 只动最外层那一层，内部条目跟着走
            }
            [queue addObjectsFromArray:candidate.subviews];
        }
        if (!matches.count) [self collectLandscapeFallbackStatusBarViews:matches inRoot:window window:window];
        for (UIView *view in matches) {
            if (![gERLandscapeSystemStatusBarMoved containsObject:view]) {
                [gERLandscapeSystemStatusBarMoved addObject:view];
            }
            CGFloat windowRise = [self landscapeChromeRiseForContainer:view landscape:YES];
            if (windowRise > 0.0) [self applyLandscapeRise:windowRise toView:view];
            static NSMutableSet<NSString *> *systemLogged = nil;
            if (!systemLogged) systemLogged = [NSMutableSet set];
            NSString *key = NSStringFromClass(view.class);
            if (![systemLogged containsObject:key]) {
                [systemLogged addObject:key];
                CGRect r = [view convertRect:view.bounds toView:window];
                ERLogInfo(@"LANDSCAPECHROME ver=1.0.9-103 system-statusbar cls=%@ rise=%.1f y=%.1f h=%.1f w=%.1f",
                           key, kERLandscapeStatusBarFixedRise,
                           CGRectGetMinY(r), CGRectGetHeight(r), CGRectGetWidth(r));
            }
        }
    }
}

// 还原系统状态栏窗口里被移过的视图（transform 回基准）。
- (void)restoreLandscapeSystemStatusBarIfNeeded {
    if (!gERLandscapeSystemStatusBarMoved.count) return;
    for (UIView *view in gERLandscapeSystemStatusBarMoved) {
        NSValue *baseValue = objc_getAssociatedObject(view, kERLandscapeChromeBaseTransformKey);
        if (baseValue && !CGAffineTransformEqualToTransform(view.transform, baseValue.CGAffineTransformValue)) {
            view.transform = baseValue.CGAffineTransformValue;
        }
    }
    [gERLandscapeSystemStatusBarMoved removeAllObjects];
}

// 反算某个 chrome 容器需要上移多少：rise = 基准顶边 − 目标顶边。
//
// 基准顶边必须实测：先把 transform 还原成基准读一次窗口坐标下的顶边。frame 是
// 父视图坐标系里的，父视图未必贴顶，所以统一用 convertRect:toView:window 换算。
// 竖屏返回 0（等价还原）。
- (CGFloat)landscapeChromeRiseForContainer:(UIView *)container landscape:(BOOL)landscape {
    if (!container || !landscape) return 0.0;
    NSValue *baseValue = objc_getAssociatedObject(container, kERLandscapeChromeBaseTransformKey);
    if (!baseValue) {
        baseValue = [NSValue valueWithCGAffineTransform:container.transform];
        objc_setAssociatedObject(container, kERLandscapeChromeBaseTransformKey, baseValue, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    container.transform = baseValue.CGAffineTransformValue;   // 还原基准再量
    UIWindow *window = container.window;
    CGRect baseRect = window ? [container convertRect:container.bounds toView:window] : container.frame;
    CGFloat rise = CGRectGetMinY(baseRect) - kERLandscapeStatusBarTargetTop;
    if (rise < 0.0) rise = 0.0;
    if (rise > kERLandscapeStatusBarMaxRise) rise = kERLandscapeStatusBarMaxRise;
    static NSMutableSet<NSString *> *landscapeChromeRiseLogged = nil;
    if (!landscapeChromeRiseLogged) landscapeChromeRiseLogged = [NSMutableSet set];
    NSString *key = [NSString stringWithFormat:@"%@/%.1f/%.1f", NSStringFromClass(container.class),
                     CGRectGetMinY(baseRect), rise];
    if (![landscapeChromeRiseLogged containsObject:key]) {
        [landscapeChromeRiseLogged addObject:key];
        ERLogInfo(@"LANDSCAPECHROME ver=1.0.9-103 rise-plan cls=%@ baseTop=%.1f targetTop=%.1f rise=%.1f h=%.1f",
                   NSStringFromClass(container.class), CGRectGetMinY(baseRect),
                   kERLandscapeStatusBarTargetTop, rise, CGRectGetHeight(baseRect));
    }
    return rise;
}

// 0.5.19 横屏一次性诊断：把「方向判定输入」「全部窗口」和「被命中的状态栏视图」倒出来。
//
// 0.5.18 那版只打了 overlay 子树顶部 140pt（还截断在 48 行），结果既没看到真正的
// 状态栏，也看不出它挂在哪个窗口上。这版补上窗口清单 + 命中视图的类名/帧/所属窗口，
// 下一次日志能直接判定是「类名不对」「窗口不对」还是「rise 不对」。
// 横屏期间只打一次，回到竖屏复位。
- (void)dumpLandscapeChromeDiagnosticsForOverlay:(UIViewController *)overlay landscape:(BOOL)landscape matched:(NSArray<UIView *> *)matched {
    static CFTimeInterval dumpedAt = 0.0;
    if (!landscape) { dumpedAt = 0.0; return; }   // 竖屏复位，下次横屏再打
    // 1.0.7-26：原来一次会话只打一次，日志导出往往错过窗口 —— 改成 3 秒节流重复打。
    CFTimeInterval dumpNow = CACurrentMediaTime();
    if (dumpNow - dumpedAt < 3.0) return;
    dumpedAt = dumpNow;
    UIWindow *window = overlay.view.window;
    CGRect winRect = window ? window.bounds : CGRectZero;
    CGSize screenSize = UIScreen.mainScreen.bounds.size;
    ERLogInfo(@"CHROMADUMP ver=1.0.9-103 gate=%d win=%.1fx%.1f view=%.1fx%.1f screen=%.1fx%.1f inset(t=%.1f b=%.1f) overlays=%lu matched=%lu",
               (int)ERLandscapePresentationActive(),
               CGRectGetWidth(winRect), CGRectGetHeight(winRect),
               CGRectGetWidth(overlay.view.bounds), CGRectGetHeight(overlay.view.bounds),
               screenSize.width, screenSize.height,
               window ? window.safeAreaInsets.top : 0.0, window ? window.safeAreaInsets.bottom : 0.0,
               (unsigned long)gOverlayControllers.count, (unsigned long)matched.count);
    // 0.5.19：把窗口清单和被命中的状态栏视图各打一遍。前一次日志证明「状态栏
    // 到底挂在哪个窗口 / 哪个类」是靠类名猜不出来的，这里直接读数。
    for (UIWindow *w in ERAllApplicationWindows()) {
        ERLogInfo(@"CHROMADUMP ver=1.0.9-103 win cls=%@ y=%.1f h=%.1f w=%.1f lvl=%.1f hid=%d key=%d",
                   NSStringFromClass(w.class), CGRectGetMinY(w.frame), CGRectGetHeight(w.frame),
                   CGRectGetWidth(w.frame), w.windowLevel, (int)w.hidden, (int)w.isKeyWindow);
    }
    for (UIView *v in matched) {
        UIWindow *hostWindow = v.window;
        CGRect r = hostWindow ? [v convertRect:v.bounds toView:hostWindow] : v.frame;
        ERLogInfo(@"CHROMADUMP ver=1.0.9-103 hit cls=%@ y=%.1f h=%.1f x=%.1f w=%.1f a=%.2f hid=%d win=%@",
                   NSStringFromClass(v.class), CGRectGetMinY(r), CGRectGetHeight(r),
                   CGRectGetMinX(r), CGRectGetWidth(r), v.alpha, (int)v.hidden,
                   hostWindow ? NSStringFromClass(hostWindow.class) : @"(nil)");
    }
    NSMutableArray<UIView *> *top = [NSMutableArray array];
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:overlay.view];
    NSInteger visited = 0;
    while (queue.count && visited < 800) {
        UIView *v = queue.firstObject;
        [queue removeObjectAtIndex:0];
        visited++;
        CGRect r = window ? [v convertRect:v.bounds toView:window] : v.frame;
        if (CGRectGetMinY(r) < 140.0 && CGRectGetMaxY(r) > 0.0 &&
            CGRectGetWidth(r) > 4.0 && CGRectGetHeight(r) > 1.0) {
            [top addObject:v];
        }
        [queue addObjectsFromArray:v.subviews];
    }
    [top sortUsingComparator:^NSComparisonResult(id objA, id objB) {
        UIView *a = (UIView *)objA;
        UIView *b = (UIView *)objB;
        CGRect ra = window ? [a convertRect:a.bounds toView:window] : a.frame;
        CGRect rb = window ? [b convertRect:b.bounds toView:window] : b.frame;
        if (CGRectGetMinY(ra) < CGRectGetMinY(rb) - 0.5) return NSOrderedAscending;
        if (CGRectGetMinY(ra) > CGRectGetMinY(rb) + 0.5) return NSOrderedDescending;
        return NSOrderedSame;
    }];
    NSInteger n = 0;
    for (UIView *v in top) {
        if (n++ >= 48) break;
        CGRect r = window ? [v convertRect:v.bounds toView:window] : v.frame;
        ERLogInfo(@"CHROMADUMP ver=1.0.9-103 top y=%.1f h=%.1f x=%.1f w=%.1f a=%.2f hid=%d matched=%d cls=%@",
                   CGRectGetMinY(r), CGRectGetHeight(r), CGRectGetMinX(r), CGRectGetWidth(r),
                   v.alpha, (int)v.hidden, (int)[matched containsObject:v], NSStringFromClass(v.class));
    }
}


// 把某个视图的 transform 幂等地设成「基准 − rise」。
// 基准单独存一份（不复用 kEROriginalTransformKey：那条 key 被多处 capture/restore
// 共用，若在位移生效之后才首次捕获，基准就变成已上移过的值，再叠加一次即双倍位移）。
// 每次调用都从基准重算，所以重复调用、被别的路径还原过，都能自愈。
// ---------------------------------------------------------------------------
// 1.0.8-39 · 诊断：把「窗口里最靠上的 14 个视图」按窗口坐标 Y 排序打出来。
//
// 为什么需要它：日志已经证明我们把 `CCUIStatusBar` 从 y=43.7 抬到了 y=8.0 并且稳定保持，
// 但用户说"完全没变化"。同时 `SBStatusBarWindow`（h=932，系统状态栏窗口）rise=0 没动。
// 也就是说：**我们动的东西和用户看的东西很可能不是同一个**。
// 光靠类名猜不出来，只有把顶层视图按名次列出来（类名 + winY + 高 + 属于哪个窗口）
// 才能一眼定名 —— 下一版就能直接改成移动那个真正的目标。
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// 1.0.8-50 · 横屏状态栏偏移 —— 显示链路**独占持有**版。
//
// 1.0.8-48 的实测证明 CADisplayLink 能把 STUIStatusBar_Wrapper 稳稳按在目标位
// （4 次 top-views 全部 y=8、零跳动）。1.0.8-48 之所以还闪，是因为**另一条老路径**
// （状态栏收集 loop）同时在对 CCUIStatusBar 写 transform —— 两个 writer 打架。
//
// 本版规则：**显示链路是这条行唯一的持有者**。
//   · 老路径的收集 loop 对这些类全部让位（见 isLandscapeStatusBarLikeView）；
//   · 显示链路每帧把成员按「系统原位 + 滑杆偏移」固定住；
//   · 带指纹：系统改了 transform（转屏）→ 以当前值为新基准重算；
//   · 每帧最多写一次、写在渲染前 —— 无递归、肉眼不可见。
// 偏移语义：0 = 系统原位（43.7），正值往下，负值往上。

// ---------------------------------------------------------------------------
// 1.0.8-52 · 横屏状态栏偏移 —— 显示链路独占持有，以 **iOS 原生位置** 为基准。
//
// 用户做了关键实验：**禁用所有插件后，iOS 17.2 横屏 CC 的状态栏行本来就在
// y≈43.7**（CCUIStatusBar w=932）—— 这是系统原生的位置，不是插件造成的。
// 所以需求成立：把这条行从原生位置往上/往下调。
//
// 实现采用 1.0.8-48 已被验证有效的机制（CADisplayLink 每帧渲染前写，4 次采样
// 零跳动、无卡死），并遵守 1.0.8-51 学到的铁律 —— **这条行只能有一个 writer**：
//   · 老路径的状态栏收集 loop 对这些类全部让位（见状态栏 loop 内的判断）；
//   · 显示链路每帧把成员按「原生位置 + 滑杆偏移」固定住；
//   · 带指纹：系统改了 transform → 以当前值为新基准重算；
//   · 偏移语义：0 = iOS 原生位置（43.7），负值往上（-35 ≈ 8.7），正值往下。

- (void)dumpLandscapeTopViewsForDiagnosis {
    static CFTimeInterval lastDump = 0.0;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - lastDump < 8.0) return;   // 8 秒最多一条，避免刷日志
    lastDump = now;

    NSMutableArray<NSDictionary *> *found = [NSMutableArray array];
    for (UIWindow *window in ERAllApplicationWindows()) {
        if (window.hidden || window.alpha < 0.02) continue;
        NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:window];
        NSUInteger head = 0, guard = 0;
        while (head < queue.count && guard++ < 900) {
            UIView *view = queue[head++];
            if (view.hidden || view.alpha < 0.02) continue;
            CGRect rect = [view convertRect:view.bounds toView:window];
            CGFloat top = CGRectGetMinY(rect);
            CGFloat width = CGRectGetWidth(rect);
            CGFloat height = CGRectGetHeight(rect);
            // 1.0.8-40：**排除全屏容器**。
            // 1.0.8-39 的过滤条件里没有上限，结果 14 个名额全被 `y=0 h=932 w=430` 的
            // 全屏窗口/宿主视图占满，唯一一条有用的（CC 窗口里 y=-4 h=54 的那个）反而
            // 排在最后。现在只保留"控件尺寸"的东西：高 8–500、且小于屏高的 80%。
            CGFloat screenHeight = CGRectGetHeight(UIScreen.mainScreen.bounds);
            // 1.0.8-40：**不能用 continue** —— 全屏容器正是小控件的外层，跳过去就找不到里面的东西。
            // 这里只决定「这一条要不要记」，向下遍历照常进行。
            BOOL controlSized = (height >= 8.0 && height <= 500.0 && width >= 20.0);
            if (screenHeight > 0.0 && height >= screenHeight * 0.8) controlSized = NO;
            if (controlSized && top >= -60.0 && top <= 260.0) {
                [found addObject:@{
                    @"top": @(top),
                    @"text": [NSString stringWithFormat:@"%@ y=%.0f h=%.0f w=%.0f @%@",
                              NSStringFromClass(view.class), top,
                              CGRectGetHeight(rect), CGRectGetWidth(rect),
                              NSStringFromClass(window.class)]
                }];
            }
            if (view.subviews.count) [queue addObjectsFromArray:view.subviews];
        }
    }
    [found sortUsingComparator:^NSComparisonResult(NSDictionary *a, NSDictionary *b) {
        return [a[@"top"] compare:b[@"top"]];
    }];
    NSMutableArray<NSString *> *lines = [NSMutableArray array];
    for (NSUInteger index = 0; index < found.count && index < 14; index++) {
        [lines addObject:found[index][@"text"]];
    }
    ERLogInfo(@"LANDSCAPECHROME ver=1.0.9-103 top-views(窗口坐标 按Y排序)=%@", lines);
}

// ---------------------------------------------------------------------------
// 1.0.8-44 · iOS 17.2 横屏 CC 里**用户看到的那条状态栏**（运营商/时间/电量）。
//
// 实测（20260920-1455 的 top-views）：它是
//   STUIStatusBar_Wrapper → STUIStatusBar → STUIStatusBarForegroundView
// 三层嵌套，横屏自然位置在 **y=43**（430 高的横屏里往下 43pt）—— 用户说的
// 「过于靠下」就是它。而它挂在 **SBControlCenterWindow** 上、不在 overlay 的
// 视图树里，所以 collectLandscapeStatusBarViews 那条路径永远扫不到它
// （日志里 rise-plan 从来没有 STUI，滑杆自然"完全没有反应"）。
//
// 修法：单独扫一遍**所有可见窗口**，只对**最外层**的 STUIStatusBar_Wrapper
// 施加偏移（里面的两层是它的子级，三层都加会叠加成三倍位移）。
// 偏移语义沿用滑杆：offset > 0 → 往下，offset < 0 → 往上。
// ---------------------------------------------------------------------------
- (void)applyLandscapeRise:(CGFloat)rise toView:(UIView *)view {
    if (!view) return;
    NSValue *baseValue = objc_getAssociatedObject(view, kERLandscapeChromeBaseTransformKey);
    if (!baseValue) {
        baseValue = [NSValue valueWithCGAffineTransform:view.transform];
        objc_setAssociatedObject(view, kERLandscapeChromeBaseTransformKey, baseValue, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    CGAffineTransform target = CGAffineTransformTranslate(baseValue.CGAffineTransformValue, 0.0, -rise);
    if (CGAffineTransformEqualToTransform(view.transform, target)) return;
    view.transform = target;

    // 1.0.8-35 · **不要在这里登记重写集合**。
    //
    // 1.0.8-34 我在这里加了一句 ERChromeReassertRegisterView(view, rise)，那是错的：
    // 20Hz 定时器的写法是
    //     for (UIView *view in gERChromeReassertRises.keyEnumerator) {
    //         ... applyLandscapeRise(...)      ← 就在遍历这张表的过程中
    //     }
    // 而 ERChromeReassertRegisterView 内部是 [map setObject:forKey:] —— 等于**遍历中改表**，
    // 会抛 `NSGenericException: collection was mutated while being enumerated`（主线程定时器里，
    // 进程直接死）。登记改到安全的地方：两个 layoutSubviews 钩子里（那里不在任何遍历中）。
    static NSMutableDictionary<NSString *, NSNumber *> *landscapeChromeLogged = nil;
    if (!landscapeChromeLogged) landscapeChromeLogged = [NSMutableDictionary dictionary];
    NSString *key = [NSString stringWithFormat:@"%@/%.1f", NSStringFromClass(view.class), rise];
    // 1.0.7-26：改成 2 秒节流重复打，并在 0.15s 后复核一次 —— 用来区分
    // 「压根没写进去」和「写进去又被系统改回去」。
    CFTimeInterval chromeNow = CACurrentMediaTime();
    NSNumber *lastLogged = landscapeChromeLogged[key];
    if (!lastLogged || chromeNow - lastLogged.doubleValue > 2.0) {
        landscapeChromeLogged[key] = @(chromeNow);
        ERLogInfo(@"LANDSCAPECHROME ver=1.0.9-103 class=%@ rise=%.1f frameY=%.1f h=%.1f ty=%.1f winY=%.1f",
                   NSStringFromClass(view.class), rise, CGRectGetMinY(view.frame), CGRectGetHeight(view.frame),
                   view.transform.ty,
                   view.window ? CGRectGetMinY([view convertRect:view.bounds toView:view.window]) : -1.0);
        __weak UIView *weakChrome = view;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *alive = weakChrome;
            if (!alive) return;
            ERLogInfo(@"LANDSCAPECHROME ver=1.0.9-103 verify class=%@ ty=%.1f winY=%.1f",
                       NSStringFromClass(alive.class), alive.transform.ty,
                       alive.window ? CGRectGetMinY([alive convertRect:alive.bounds toView:alive.window]) : -1.0);
        });
    }
}

- (void)applyRestingModuleOffsetToOverlay:(UIViewController *)overlay {
    if (!overlay || gEditModeActive) return;
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    if (!collection.view) return;
    [self capturePresentationStateForView:collection.view];
    CGAffineTransform collectionBase = [objc_getAssociatedObject(collection.view, kEROriginalTransformKey) CGAffineTransformValue];
    CATransform3D sublayerBase = [objc_getAssociatedObject(collection.view, kEROriginalSublayerTransformKey) CATransform3DValue];
    // 0.5.13: 必须带上 gERPagerInteractiveTranslation。翻页跟手期间这个值不为 0，
    // 少了它就会把页面写回「未跟手」的位置——表现为翻页时整个页面先反向偏移一下，
    // 再被手势的下一帧 / 落位动画拉回来。这里与 -applyPageTransformToOverlay:
    // 使用完全相同的算式，保证任何一次布局回调都不会和翻页几何打架。
    collection.view.layer.sublayerTransform = CATransform3DTranslate(sublayerBase, 0.0, -(CGFloat)gERCurrentPage * ERVisualPageSpan() + gERPagerInteractiveTranslation, 0.0);
    collection.view.transform = CGAffineTransformTranslate(collectionBase, 0.0, kERRestingModuleOffset);

    // Keep module wrappers at their native transforms. Expansion transitions
    // temporarily own these wrappers; a persistent per-wrapper translation was
    // reapplied after dismissal and produced the visible upward landing hop.
    NSMutableSet<NSValue *> *seenWrappers = [NSMutableSet set];
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        UIView *wrapper = module.view.superview;
        if (!wrapper || wrapper == collection.view) continue;
        NSValue *key = [NSValue valueWithNonretainedObject:wrapper];
        if ([seenWrappers containsObject:key]) continue;
        [seenWrappers addObject:key];
        [self capturePresentationStateForView:wrapper];
        CGAffineTransform base = [objc_getAssociatedObject(wrapper, kEROriginalTransformKey) CGAffineTransformValue];
        wrapper.transform = base;
    }
}

- (BOOL)gestureRecognizerShouldBegin:(UIGestureRecognizer *)gesture {
    if ([objc_getAssociatedObject(gesture, kEREditDismissPanKey) boolValue]) {
        if (!gEditModeActive || gERExpandedModuleOpen || gERDragInProgress || gERResizeInProgress) return NO;
        CGPoint location = [gesture locationInView:gesture.view];
        if (location.y <= CGRectGetHeight(gesture.view.bounds) - MAX(92.0, gesture.view.safeAreaInsets.bottom + 68.0)) return NO;
        CGPoint velocity = [(UIPanGestureRecognizer *)gesture velocityInView:gesture.view];
        return velocity.y < -80.0 && fabs(velocity.y) > fabs(velocity.x);
    }
    if ([objc_getAssociatedObject(gesture, kERPagerGestureKey) boolValue]) {
        if (!gPagingEnabled || gERPageCount <= 1 || gERExpandedModuleOpen ||
            gERDragInProgress || gERResizeInProgress) return NO;
        CGPoint velocity = [(UIPanGestureRecognizer *)gesture velocityInView:gesture.view];
        CGPoint location = [gesture locationInView:gesture.view];
        if (location.y > CGRectGetHeight(gesture.view.bounds) - MAX(92.0, gesture.view.safeAreaInsets.bottom + 68.0)) return NO;
        // At the bottom of the pager, preserve iOS 16's native upward Control
        // Center dismissal instead of trapping the user in a rubber band — but
        // never while a drag is in flight, or the held module dumps out of edit.
        if (!gERDragInProgress && gERCurrentPage + 1 >= gERPageCount && velocity.y < 0.0) return NO;
        return fabs(velocity.y) > fabs(velocity.x) * 1.12;
    }
    return YES;
}

- (BOOL)gestureRecognizer:(UIGestureRecognizer *)gesture shouldReceiveTouch:(UITouch *)touch {
    // 单击震动观察型 tap 识别器：在任何模式下都必须收到触摸，否则它永远不触发。
    if (objc_getAssociatedObject(gesture, kERModuleTapFeedbackKey) != nil) return YES;
    // The slider observation recogniser must always receive its touch. The
    // generic UIControl rejection at the end of this method would otherwise
    // drop it, because sliders are controls — and that would silently bring
    // back exactly the "no per-sample updates" bug he was reporting.
    if (ERGestureIsSliderTracking(gesture)) return YES;
    if ([objc_getAssociatedObject(gesture, kEREditDismissPanKey) boolValue]) {
        if (!gEditModeActive || gERExpandedModuleOpen || gERDragInProgress || gERResizeInProgress) return NO;
        CGPoint location = [touch locationInView:gesture.view];
        return location.y > CGRectGetHeight(gesture.view.bounds) - MAX(92.0, gesture.view.safeAreaInsets.bottom + 68.0);
    }
    if ([objc_getAssociatedObject(gesture, kERPagerGestureKey) boolValue]) {
        if (!gPagingEnabled || gERPageCount <= 1 || gERExpandedModuleOpen ||
            gERDragInProgress || gERResizeInProgress) return NO;
        CGPoint location = [touch locationInView:gesture.view];
        if (location.y > CGRectGetHeight(gesture.view.bounds) - MAX(92.0, gesture.view.safeAreaInsets.bottom + 68.0)) return NO;
        UIView *candidate = touch.view;
        while (candidate) {
            if (candidate.tag == kERPageIndicatorHostTag || candidate.tag == kERRemoveButtonTag ||
                candidate.tag == kERResizeButtonTag || candidate.tag == kERAddControlButtonTag || candidate.tag == 181000) return NO;
            NSString *name = NSStringFromClass(candidate.class);
            if ([name containsString:@"Slider"]) return NO;
            candidate = candidate.superview;
        }
        if (gEditModeActive) {
            UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
            CGPoint point = [touch locationInView:overlay.view];
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
                if (CGRectContainsPoint(CGRectInset(ERVisibleModuleFrame(module, overlay), -8.0, -8.0), point)) return NO;
            }
        }
        return YES;
    }
    if ([objc_getAssociatedObject(gesture, @selector(blankHeld:)) boolValue]) {
        if (gEditModeActive || gERExpandedModuleOpen) return NO;
        UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
        CGPoint point = [touch locationInView:overlay.view];
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
            if (CGRectContainsPoint(CGRectInset(ERVisibleModuleFrame(module, overlay), -2.0, -2.0), point)) return NO;
        }
    }
    if ([objc_getAssociatedObject(gesture, @selector(modulePanned:)) isEqual:@"overlayPan"]) {
        if (!gEditModeActive) return NO;
        CGPoint location = [touch locationInView:gesture.view];
        // 1.0.9-38 · **修「横屏第四排拖动碰运气」**（依据 20260922-0053 日志）：
        //   grid=8x4，最后一排模块 y 范围 ≈ 330~405，而原拒绝线 = 430 − MAX(92, 21+68) = 338
        //   → 按在模块上半部（y<338）能拖、下半部（y>338）被拒 = "碰运气"。
        //   同时日志证明落点判定本身完全正常（nearest 有效、landing 非空），所以只需放低这条接收线：
        //   横屏把底部留白从 92 收到 24（拒绝线 → 406），最后一排整行可拖；
        //   最底部仍留 ~24pt 给系统 Home 指示条手势（safeBottom = 21）。竖屏保持原样 92。
        CGFloat bottomGuard = ERLandscapePresentationActive()
            ? MAX(24.0, gesture.view.safeAreaInsets.bottom + 8.0)
            : MAX(92.0, gesture.view.safeAreaInsets.bottom + 68.0);
        if (location.y > CGRectGetHeight(gesture.view.bounds) - bottomGuard) return NO;
        UIView *touchedView = touch.view;
        while (touchedView) {
            if (touchedView.tag == kERResizeButtonTag || touchedView.tag == kERRemoveButtonTag) return NO;
            touchedView = touchedView.superview;
        }
        UIViewController *overlay = nil;
        UIResponder *responder = gesture.view;
        while (responder && ![responder isKindOfClass:[UIViewController class]]) responder = responder.nextResponder;
        if ([responder isKindOfClass:[UIViewController class]]) overlay = (UIViewController *)responder;
        CGPoint point = [touch locationInView:overlay.view];
        // Geometric chrome guard: the tag walk above depends on hit-testing
        // having routed the touch to the button. If any other view claimed it,
        // a touch inside a remove/resize footprint must still never start a
        // drag; it would cancel the button's tap and shrink the module.
        // Non-generous zones keep 1x1 modules grabbable next to their handle.
        if ([self pointHitsEditChrome:point overlay:overlay generous:NO]) return NO;
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
            CGRect frame = ERVisibleModuleFrame(module, overlay);
            if (CGRectContainsPoint(CGRectInset(frame, -14.0, -14.0), point)) return YES;
        }
        return NO;
    }
    if (gesture.view.tag == kERResizeButtonTag) {
        return gEditModeActive && !gERExpandedModuleOpen && !gERDragInProgress;
    }
    if ([objc_getAssociatedObject(gesture, @selector(editShieldTapped:)) boolValue]) {
        if (!gEditModeActive || gERExpandedModuleOpen || gERDragInProgress || gERResizeInProgress) return NO;
        UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
        CGPoint location = [touch locationInView:overlay.view];
        return [self removeButtonAtPoint:location overlay:overlay] != nil;
    }
    UIView *view = touch.view;
    if ([gesture isKindOfClass:[UITapGestureRecognizer class]]) {
        if (!gEditModeActive) return NO;
        CGPoint overlayLocation = [touch locationInView:gesture.view];
        if (overlayLocation.y > CGRectGetHeight(gesture.view.bounds) - MAX(92.0, gesture.view.safeAreaInsets.bottom + 68.0)) return NO;
        if (view.tag == kEREditTouchShieldTag) {
            UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
            CGPoint location = [touch locationInView:overlay.view];
            UIButton *addControl = (UIButton *)[overlay.view viewWithTag:kERAddControlButtonTag];
            if (addControl && !addControl.hidden && CGRectContainsPoint(CGRectInset(addControl.frame, -12.0, -12.0), location)) return NO;
            // A near-miss on the remove bubble or resize grabber must reach
            // the control (or do nothing) — never read as a blank-space tap
            // that exits edit mode.
            if ([self pointHitsEditChrome:location overlay:overlay generous:YES]) return NO;
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
                CGRect frame = ERVisibleModuleFrame(module, overlay);
                if (CGRectContainsPoint(CGRectInset(frame, -14.0, -14.0), location)) return NO;
            }
            return YES;
        }
        while (view) {
            if (view.tag == 181000 || view.tag == kERRemoveButtonTag || view.tag == kERResizeButtonTag) return NO;
            if (view.tag == kERAddControlButtonTag) return NO;
            if (view.tag == kEREditShieldTag) return NO;
            view = view.superview;
        }
        return YES;
    }
    while (view) {
        if ([view isKindOfClass:[UIControl class]] || view.tag == 181000) return NO;
        view = view.superview;
    }
    return YES;
}

- (BOOL)gestureRecognizer:(UIGestureRecognizer *)gesture shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)otherGesture {
    // 单击震动观察型 tap 识别器：必须允许它与模块自身的 tap/长按同时识别。
    //
    // 0.5.8 的关键修复点就在这条规则上。0.5.7 虽然写了这条放行，却忘了给识别器
    // 设置 delegate——delegate 为 nil 时 UIKit 不会询问本方法，放行分支是死代码，
    // 于是这个观察型 tap 被模块自己已有的 tap/长按 prevent（默认 canBePreventedBy
    // = YES），一次都不会触发。实机日志里 TAPHAPTIC 为零就是这么来的。
    if (objc_getAssociatedObject(gesture, kERModuleTapFeedbackKey) != nil ||
        objc_getAssociatedObject(otherGesture, kERModuleTapFeedbackKey) != nil) return YES;
    if ([objc_getAssociatedObject(gesture, kEREditDismissPanKey) boolValue] || [objc_getAssociatedObject(otherGesture, kEREditDismissPanKey) boolValue]) return NO;
    if (gesture.view.tag == kERResizeButtonTag || otherGesture.view.tag == kERResizeButtonTag || gERResizeInProgress) return NO;
    BOOL gestureIsPager = [objc_getAssociatedObject(gesture, kERPagerGestureKey) boolValue];
    BOOL otherIsPager = [objc_getAssociatedObject(otherGesture, kERPagerGestureKey) boolValue];
    BOOL gestureIsModulePan = [objc_getAssociatedObject(gesture, @selector(modulePanned:)) isEqual:@"overlayPan"];
    BOOL otherIsModulePan = [objc_getAssociatedObject(otherGesture, @selector(modulePanned:)) isEqual:@"overlayPan"];
    if ((gestureIsPager && otherIsModulePan) || (otherIsPager && gestureIsModulePan) || gERDragInProgress) return NO;
    if (gestureIsPager || otherIsPager) return YES;
    // The slider observation recogniser must be allowed to run alongside the
    // slider's OWN pan; without this the two block each other and the drag or
    // the readout loses the race (see -ERSliderInstallTrackingGesture).
    //
    // It is deliberately the LAST rule: paging, resizing and module dragging
    // keep their existing answers, so wiring this delegate up cannot change
    // any interaction other than the one it exists to fix.
    if (ERGestureIsSliderTracking(gesture) || ERGestureIsSliderTracking(otherGesture)) return YES;
    return NO;
}

- (void)addTapped:(__unused UIButton *)sender { if (!gEnabled || gERExpandedModuleOpen) return; ERHaptic(); [self setEditing:!gEditModeActive]; }
- (void)expandConnectivityFromMiniCluster:(UIButton *)sender {
    if (!gEnabled || gEditModeActive || gERExpandedModuleOpen) return;
    NSString *identifier = sender ? objc_getAssociatedObject(sender, kERConnectivityIdentifierKey) : nil;
    // Read the identifier from the sender, and if the sender is a bare proxy
    // that lost its association (the held-gesture path can be re-entered by a
    // recycled tile), recover it from the last press so a hold still works.
    if (!identifier.length) identifier = gERConnectivityPendingDetailIdentifier;
    if (!ERConnectivityIdentifierIsOwned(identifier)) return;
    // A long press must never be a no-op. Wi-Fi / Bluetooth / AirDrop have a
    // real expanded controller; the rest get EchoReborn's own panel, which at
    // least shows the tile's state and offers the system Settings shortcut.
    // If even that cannot be produced, fall back to the system's own Settings
    // pane for this module rather than silently doing nothing.
    if (!ERConnectivityIdentifierHasNativeExpandedMenu(identifier)) {
        [self presentConnectivityInfoPanelForIdentifier:identifier sender:sender];
        return;
    }
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    // A missing collection controller used to end this method silently, which
    // is the same user-visible outcome as no handler at all. Let the press fall
    // back to EchoReborn's own panel instead of dying here.
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    SEL expand = NSSelectorFromString(@"expandModuleWithIdentifier:");
    if (!collection || ![collection respondsToSelector:expand]) {
        [self presentConnectivityInfoPanelForIdentifier:identifier sender:sender];
        return;
    }
    UIView *sourceView = sender.superview ?: sender;
    if (sourceView.window) {
        gERConnectivityProxySourceView = sourceView;
        gERConnectivityProxySourceWindowFrame = ERConnectivityScreenFrameForView(sourceView);
        gERConnectivityProxySourceCornerRadius = sourceView.layer.cornerRadius > 1.0 ? sourceView.layer.cornerRadius : 32.0;
        gERConnectivityHasProxySourceFrame = CGRectGetWidth(gERConnectivityProxySourceWindowFrame) > 1.0 &&
                                             CGRectGetHeight(gERConnectivityProxySourceWindowFrame) > 1.0;
        gERConnectivityProxyExpansionActive = gERConnectivityHasProxySourceFrame;
    } else {
        gERConnectivityProxySourceView = nil;
        gERConnectivityProxySourceWindowFrame = CGRectZero;
        gERConnectivityProxySourceCornerRadius = 32.0;
        gERConnectivityHasProxySourceFrame = NO;
        gERConnectivityProxyExpansionActive = NO;
    }
    ERHaptic();
    ((void (*)(id, SEL, id))objc_msgSend)((id)collection, expand, @"com.apple.control-center.ConnectivityModule");
}

// ---------------------------------------------------------------------------
// Compact panel for the connectivity tiles Apple has no expanded controller
// for (飞行模式 / 蜂窝数据 / 个人热点 / VPN).
//
// The requirement is simply that a long press does something visible on every
// module. Rather than inventing controls that would duplicate the tile itself,
// the panel shows what the tile currently is and hands off to the matching
// system Settings page — which is where a user actually goes to change an
// airplane-mode or hotspot preference anyway.
//
// It is a plain UIAlertController: no private API, no runtime introspection,
// and it tears itself down, so it cannot leave state behind if SpringBoard
// recycles the tile underneath it.
// ---------------------------------------------------------------------------
- (NSString *)connectivitySettingsPathForIdentifier:(NSString *)identifier {
    NSString *lower = identifier.lowercaseString;
    if ([lower containsString:@".airplane"]) return @"App-prefs:root=AIRPLANE_MODE";
    if ([lower containsString:@".cellular"]) return @"App-prefs:root=MOBILE_DATA_SETTINGS_ID";
    if ([lower containsString:@".hotspot"]) return @"App-prefs:root=INTERNET_TETHERING";
    if ([lower containsString:@".vpn"]) return @"App-prefs:root=General&path=VPN";
    return nil;
}

- (void)presentConnectivityInfoPanelForIdentifier:(NSString *)identifier sender:(UIControl *)sender {
    if (!identifier.length) return;
    // Double-presenting inside the same run loop is what produces a stuck
    // dimmed overlay, so a visible panel is reused rather than stacked.
    UIViewController *host = gOverlayControllers.allObjects.firstObject;
    if (!host) host = sender.window.rootViewController;
    if (!host || host.presentedViewController) return;

    NSString *title = ERFriendlyNameForIdentifier(identifier) ?: ERPrettyNameForIdentifier(identifier);
    BOOL selected = ERConnectivitySelectedForIdentifier(identifier);
    NSString *status = ERConnectivityStatusForIdentifier(identifier);
    NSString *stateText = selected ? @"已开启" : @"已关闭";
    if (status.length && ![status isEqualToString:@"On"] && ![status isEqualToString:@"Off"]) {
        stateText = [NSString stringWithFormat:@"已开启 · %@", status];
    }

    NSString *path = [self connectivitySettingsPathForIdentifier:identifier];
    NSString *message = [NSString stringWithFormat:@"%@\n当前状态：%@", title, stateText];

    ERHaptic();
    UIAlertController *panel = [UIAlertController alertControllerWithTitle:title
                                                                  message:message
                                                           preferredStyle:UIAlertControllerStyleActionSheet];
    if (path.length) {
        NSURL *url = [NSURL URLWithString:path];
        if (url) {
            __weak typeof(self) weakSelf = self;
            [panel addAction:[UIAlertAction actionWithTitle:@"打开系统设置"
                                                     style:UIAlertActionStyleDefault
                                                   handler:^(__unused UIAlertAction *action) {
                __strong typeof(weakSelf) strongSelf = weakSelf;
                if (!strongSelf) return;
                [UIApplication.sharedApplication openURL:url options:@{} completionHandler:nil];
            }]];
        }
    }
    [panel addAction:[UIAlertAction actionWithTitle:@"关闭" style:UIAlertActionStyleCancel handler:nil]];

    // An action sheet needs a popover anchor on iPad; without one it throws.
    panel.popoverPresentationController.sourceView = sender ?: host.view;
    panel.popoverPresentationController.sourceRect = sender ? sender.bounds : host.view.bounds;
    gERExpandedModuleOpen = YES;
    [host presentViewController:panel animated:YES completion:nil];
    // The flag gates taps on every tile, so it has to be cleared even if the
    // panel is dismissed by an outside tap that never runs a handler.
    __weak UIAlertController *weakPanel = panel;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (!weakPanel || weakPanel.presentingViewController == nil) gERExpandedModuleOpen = NO;
    });
}
- (void)openVPNSettings:(__unused UIControl *)sender {
    NSURL *url = [NSURL URLWithString:@"App-prefs:root=General&path=VPN"];
    if (!url) return;
    ERHaptic();
    [UIApplication.sharedApplication openURL:url options:@{} completionHandler:nil];
}
- (void)connectivityProxyTapped:(UIControl *)sender {
    UIControl *nativeControl = objc_getAssociatedObject(sender, kERConnectivityForwardControlKey);
    if (!nativeControl) return;
    // Same route as the connectivity tiles: reach the module's setSelected:
    // when the button is not the thing that owns the toggle.
    NSString *identifier = objc_getAssociatedObject(sender, kERConnectivityIdentifierKey);
    BOOL target = !ERConnectivitySelectedForIdentifier(identifier);
    if (ERToggleNativeConnectivityControl(sender.superview, nativeControl, target)) return;
    [nativeControl sendActionsForControlEvents:UIControlEventTouchUpInside];
}
- (void)connectivityTileProxyTouchDown:(UIControl *)sender {
    ERSetConnectivityProxyPressed(sender, YES);
}
- (void)connectivityTileProxyTouchUp:(UIControl *)sender {
    ERSetConnectivityProxyPressed(sender, NO);
}
- (void)connectivityTileProxyTapped:(UIControl *)sender {
    if (gEditModeActive || gERExpandedModuleOpen) return;
    if (![objc_getAssociatedObject(sender, @selector(connectivityTileProxyTapped:)) boolValue]) return;
    NSString *identifier = objc_getAssociatedObject(sender, kERConnectivityIdentifierKey);
    if ([identifier.lowercaseString containsString:@".airdrop"]) {
        ERSetConnectivityProxyPressed(sender, NO);
        [self expandConnectivityFromMiniCluster:(UIButton *)sender];
        return;
    }
    BOOL current = ERConnectivitySelectedForIdentifier(identifier);
    BOOL target = !current;
    ERSetConnectivityProxyPressed(sender, NO);
    UIView *moduleView = sender.superview;
    UIControl *nativeControl = objc_getAssociatedObject(sender, kERConnectivityForwardControlKey);
    BOOL changed = NO;
    if (identifier.length) {
        changed = ERConnectivitySetIdentifier(identifier, target);
    }
    ERHaptic();
    // Highlight optimistically even when every setter missed.
    //
    // The private setters (SBWiFiManager, BluetoothManager, CoreTelephonyClient,
    // RadiosPreferences …) either do not exist under that name on a given iOS
    // build or expose the toggle under a different selector. When all of the
    // candidates missed, `changed` came back NO and nothing happened on screen —
    // the tile stayed grey even though the user had just switched the radio on,
    // which is the "不显示高亮色" report.
    //
    // Two things follow from that:
    //   * the optimistic state is written unconditionally, so the tile repaints
    //     immediately regardless of which setter worked; and
    //   * the native control is driven through ERToggleNativeConnectivityControl,
    //     which can reach the module's own setSelected: — the route that still
    //     works after our hide pass has taken the button off screen.
    // The retry ticks then drop the optimistic override and re-read the truth,
    // so a working path self-corrects while a broken one no longer looks dead.
    if (identifier.length) {
        gERConnectivityOptimisticStates[identifier] = @(target);
        for (UIViewController *candidateOverlay in gOverlayControllers.allObjects) {
            for (UIViewController *module in ERCollectModuleControllers(candidateOverlay)) {
                if ([ERModuleIdentifier(module) isEqualToString:identifier]) ERConfigureOddResizedModuleLayout(module);
            }
        }
        BOOL forwarded = ERToggleNativeConnectivityControl(moduleView, nativeControl, target);
        for (NSNumber *delay in @[@0.22, @0.48, @0.82, @1.25]) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                if (delay.doubleValue >= 1.2) [gERConnectivityOptimisticStates removeObjectForKey:identifier];
                for (UIViewController *candidateOverlay in gOverlayControllers.allObjects) {
                    for (UIViewController *module in ERCollectModuleControllers(candidateOverlay)) {
                        if ([ERModuleIdentifier(module) isEqualToString:identifier]) ERConfigureOddResizedModuleLayout(module);
                    }
                }
            });
        }
        ERLogInfo(@"connectivity: %@ -> %@ (setter %@, forwarded %@)", identifier,
                   target ? @"on" : @"off", changed ? @"ok" : @"miss", forwarded ? @"yes" : @"no");
        return;
    }
    ERToggleNativeConnectivityControl(moduleView, nativeControl, target);
    {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.38 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            for (UIViewController *overlay in gOverlayControllers.allObjects) {
                for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                    if ([ERModuleIdentifier(module).lowercaseString containsString:@"echoreborn.connectivity"]) {
                        ERConfigureOddResizedModuleLayout(module);
                    }
                }
            }
        });
    }
}
- (void)connectivityTileProxyHeld:(UILongPressGestureRecognizer *)gesture {
    if (gesture && gesture.state != UIGestureRecognizerStateBegan) return;
    if (gEditModeActive || gERExpandedModuleOpen) return;
    UIControl *sender = [gesture.view isKindOfClass:[UIControl class]] ? (UIControl *)gesture.view : nil;
    NSString *identifier = sender ? objc_getAssociatedObject(sender, kERConnectivityIdentifierKey) : nil;
    if (!ERConnectivityIdentifierIsOwned(identifier)) return;
    // Every owned module routes here now. expandConnectivityFromMiniCluster:
    // picks the right response itself — Apple's child controller when the
    // toggle has one, EchoReborn's own panel when it does not — so there is no
    // longer a branch that ends in a haptic-only dead end.
    [self expandConnectivityFromMiniCluster:(UIButton *)sender];
}
- (void)connectivityTileProxyForcePressed:(UIControl *)sender {
    if (gEditModeActive || gERExpandedModuleOpen) return;
    NSString *identifier = sender ? objc_getAssociatedObject(sender, kERConnectivityIdentifierKey) : nil;
    if (!ERConnectivityIdentifierIsOwned(identifier)) return;
    gERConnectivityPendingDetailIdentifier = identifier.copy;
    [self expandConnectivityFromMiniCluster:(UIButton *)sender];
}
- (void)ignoreTap:(__unused UIButton *)sender {}
- (void)blankHeld:(UILongPressGestureRecognizer *)gesture {
    if (gesture.state == UIGestureRecognizerStateBegan && !gEditModeActive && !gERExpandedModuleOpen) {
        ERHaptic();
        [self setEditing:YES];
    }
}
- (void)editExitTapped:(UITapGestureRecognizer *)gesture {
    if (gesture.state == UIGestureRecognizerStateRecognized && gEditModeActive) {
        ERHaptic();
        [self setEditing:NO];
    }
}

- (void)editShieldTapped:(UITapGestureRecognizer *)gesture {
    if (gesture.state != UIGestureRecognizerStateRecognized || !gEditModeActive || gERExpandedModuleOpen) return;
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    CGPoint point = [gesture locationInView:overlay.view];
    UIButton *remove = [self removeButtonAtPoint:point overlay:overlay];
    if (remove) [self removeTapped:remove];
}

- (void)editDismissPanned:(UIPanGestureRecognizer *)gesture {
    if (!gEditModeActive || gERExpandedModuleOpen) return;
    if (gesture.state == UIGestureRecognizerStateBegan) {
        ERHaptic();
        gEREditExitConsumedUntil = CACurrentMediaTime() + 0.9;
        // The native home gesture races this pan and drives presentation
        // callbacks that clobber an animated exit; leave editing atomically.
        [self dismissEditingImmediately];
        gesture.enabled = NO;
        gesture.enabled = YES;
    }
}

#pragma mark - 控制按钮：单击弹电源面板（1.0.1 引入，1.0.2 改为按类分组面板）

- (UIView *)erExistingPowerMenu {
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        UIView *menu = [overlay.view viewWithTag:kERPowerMenuContainerTag];
        if (menu) return menu;
    }
    for (UIWindow *window in ERAllApplicationWindows()) {
        UIView *menu = [window viewWithTag:kERPowerMenuContainerTag];
        if (menu) return menu;
    }
    return nil;
}

- (void)powerTapped:(UIButton *)sender {
    if (gEditModeActive || gERExpandedModuleOpen) return;
    if ([self erExistingPowerMenu]) {
        // 刚弹出来的那一下不算「再点一次」。否则双击电源键 = 弹出后立刻收回，
        // 用户看到的就是「点了没反应」。kERPowerMenuTapGuard 秒内直接忽略。
        if (CFAbsoluteTimeGetCurrent() - gERPowerMenuPresentedAt < kERPowerMenuTapGuard) return;
        ERHaptic();
        [self dismissPowerMenuAnimated:YES];
        return;
    }
    ERHaptic();
    [self presentPowerMenuFromButton:sender];
}

// 1.0.5：电源面板按参考图重做，同时修掉真正的「点了没反应」。
//
// 旧实现（1.0.2 ~ 1.0.4）在把 menu 挂进宿主视图**之前**就激活了
// 「panel ↔ host.safeAreaLayoutGuide」这一批约束：
//     [menu addSubview:panel];
//     [NSLayoutConstraint activateConstraints:@[ [panel.topAnchor constraintEqualToAnchor:safeArea.topAnchor] … ]];
//     [host addSubview:menu];        // ← 太晚了
// 那一刻 panel 的祖先链止于 menu，而 safeAreaLayoutGuide 属于 host，两者**没有共同祖先**，
// UIKit 会当场抛 NSInternalInconsistencyException。异常发生在 SpringBoard 进程里，
// 方法就地中断 —— 面板根本不会出现，这就是用户说的「点一下没反应」；反复点反复抛，
// 最终把 SpringBoard 送进安全模式。
//
// 新实现彻底不依赖 Auto Layout：先把容器挂进宿主，再用 frame 摆面板与条目。
// 既不可能出现跨层级约束，也不存在「尚未落位就开动画」的中间态。
- (void)presentPowerMenuFromButton:(UIButton *)button {
    if (!button) return;
    if ([self erExistingPowerMenu]) return;   // 已在屏上就不再叠一层
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    // 按钮自己所在的窗口是最好的宿主：它必然覆盖按钮，也必然在控制中心之上。
    UIView *host = button.window ?: overlay.view;
    if (!host) return;

    // 动作表与顺序完全对齐参考图：注销桌面 / 安全模式 / 用户空间重启 / 重新启动 / 关机。
    // 图标一律是「圆环 + 内部符号」这一类描边字形，右对齐。
    NSArray<NSArray<NSString *> *> *items = @[
        @[@"注销桌面", @"arrow.clockwise.circle", kERPowerActionRespring],
        @[@"安全模式", @"shield.lefthalf.filled", kERPowerActionSafeMode],
        @[@"用户空间重启", @"exclamationmark.arrow.triangle.2.circlepath", kERPowerActionUserspace],
        @[@"重新启动", @"arrow.clockwise.circle", kERPowerActionReboot],
        @[@"关机", @"power", kERPowerActionShutdown],
    ];

    UIView *menu = [[UIView alloc] initWithFrame:host.bounds];
    menu.tag = kERPowerMenuContainerTag;
    menu.backgroundColor = UIColor.clearColor;
    menu.opaque = NO;
    menu.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;

    // 背景遮罩：轻点收起。它同时是「点面板以外任何地方都能关掉」的那一层。
    UIControl *scrim = [[UIControl alloc] initWithFrame:menu.bounds];
    scrim.backgroundColor = [UIColor colorWithWhite:0.0 alpha:0.28];
    scrim.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    scrim.alpha = 0.0;
    [scrim addTarget:self action:@selector(powerMenuScrimTapped:) forControlEvents:UIControlEventTouchUpInside];
    [menu addSubview:scrim];

    // 先入层级、再摆位置 —— 这个顺序反过来正是旧版崩溃的来源。
    [host addSubview:menu];

    // 参考图是一块**浅色**毛玻璃卡片。用 SystemMaterialLight：浅色模式下是浅灰白，
    // 系统切到深色时材质会自己变深，条目文字用的是 labelColor 也会跟着反白。
    UIVisualEffectView *panel = [[UIVisualEffectView alloc]
        initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterialLight]];
    panel.tag = kERPowerMenuPanelTag;
    panel.layer.cornerRadius = kERPowerMenuCornerRadius;
    panel.layer.cornerCurve = kCACornerCurveContinuous;
    panel.clipsToBounds = YES;
    panel.alpha = 0.0;
    panel.transform = CGAffineTransformMakeScale(0.96, 0.96);

    CGFloat panelWidth = MIN(kERPowerMenuPanelWidth, MAX(200.0, CGRectGetWidth(menu.bounds) - 40.0));
    CGFloat panelHeight = (CGFloat)items.count * kERPowerMenuItemSide;

    NSMutableArray<ERPowerMenuItemButton *> *itemViews = [NSMutableArray array];
    NSUInteger index = 0;
    for (NSArray<NSString *> *item in items) {
        ERPowerMenuItemButton *row = [[ERPowerMenuItemButton alloc] initWithCaption:item[0]
                                                                           symbols:@[item[1]]];
        row.actionIdentifier = item[2];
        row.frame = CGRectMake(0.0, (CGFloat)index * kERPowerMenuItemSide, panelWidth, kERPowerMenuItemSide);
        row.autoresizingMask = UIViewAutoresizingFlexibleWidth;
        [row setShowsSeparator:(index + 1 < items.count)];
        [row addTarget:self action:@selector(powerMenuItemTapped:) forControlEvents:UIControlEventTouchUpInside];
        [panel.contentView addSubview:row];
        [itemViews addObject:row];
        index++;
    }

    // 居中落位。面板整体高度固定 = 行高 × 行数，横屏 / 大字号下也不会出屏。
    panel.frame = CGRectMake(round((CGRectGetWidth(menu.bounds) - panelWidth) * 0.5),
                             round((CGRectGetHeight(menu.bounds) - panelHeight) * 0.5),
                             panelWidth, panelHeight);
    panel.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleRightMargin |
                             UIViewAutoresizingFlexibleTopMargin | UIViewAutoresizingFlexibleBottomMargin;
    [menu addSubview:panel];

    gERPowerMenuPresentedAt = CFAbsoluteTimeGetCurrent();

    // 条目**全程可点**，不再依赖「动画跑完才解禁」。
    //
    // 旧版把交互绑在动画 completion 上：一旦那次动画被别的东西打断、completion 没有按
    // 预期收尾，条目就永远停在 userInteractionEnabled = NO —— 这是「点了没反应」的
    // 第二条路径。现在改成「时间窗」：面板一出现即可点，但最初的 kERPowerMenuTapGuard
    // 秒内的点击在 powerMenuItemTapped: 里被丢弃，所以那一下绝不会误触到「安全模式」。
    [UIView animateWithDuration:0.20 delay:0.0
                        options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction
                     animations:^{
        scrim.alpha = 1.0;
        panel.alpha = 1.0;
        panel.transform = CGAffineTransformIdentity;
    } completion:nil];

    ERLogInfo(@"POWERMENU ver=1.0.9-103 presented panel=%.0fx%.0f items=%lu",
              panelWidth, panelHeight, (unsigned long)itemViews.count);
}

- (void)dismissPowerMenuAnimated:(BOOL)animated {
    UIView *menu = [self erExistingPowerMenu];
    if (!menu) return;
    UIView *panel = [menu viewWithTag:kERPowerMenuPanelTag];
    void (^cleanup)(void) = ^{ [menu removeFromSuperview]; };
    if (!animated) { cleanup(); return; }
    [UIView animateWithDuration:0.16 delay:0.0 options:UIViewAnimationOptionBeginFromCurrentState animations:^{
        for (UIView *sub in menu.subviews) if (sub != panel) sub.alpha = 0.0;
        panel.alpha = 0.0;
        panel.transform = CGAffineTransformMakeScale(0.97, 0.97);
    } completion:^(__unused BOOL finished) { cleanup(); }];
}

- (void)powerMenuScrimTapped:(__unused UIControl *)sender {
    // 与条目同一个时间窗：面板刚弹出的那一刻，用户「补的第二下」常常落在面板之外，
    // 若照收就会把面板立刻关掉，观感还是「点了没反应」。
    if (CFAbsoluteTimeGetCurrent() - gERPowerMenuPresentedAt < kERPowerMenuTapGuard) return;
    [self dismissPowerMenuAnimated:YES];
}

- (void)powerMenuItemTapped:(ERPowerMenuItemButton *)sender {
    // 展示后的极短时间窗内丢弃点击：面板刚出现时手指往往还压在屏幕上，
    // 用户也可能因为「看着没反应」立刻补第二下 —— 那一下就压在「安全模式」上。
    if (CFAbsoluteTimeGetCurrent() - gERPowerMenuPresentedAt < kERPowerMenuTapGuard) return;
    NSString *action = [sender.actionIdentifier copy];
    if (!action.length) return;
    ERHaptic();
    [self dismissPowerMenuAnimated:YES];
    // 先让收起动画跑完再执行：respring / killall 会立刻打断渲染，
    // 同帧执行会让菜单「僵」在半路。
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.20 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        [self erPerformPowerAction:action];
    });
}

- (void)erPerformPowerAction:(NSString *)action {
    if (![action length]) return;
    // 关机：系统面板是唯一正规路径（SpringBoard 是 mobile 身份，没有断电权限）。
    // 1.0.3：面板开不出来时**什么都不做**。此前这里会静默回落到
    // erRebootViaFrontBoard，而那正是「点关机 → SpringBoard 崩溃 → 安全模式」
    // 的根因（那次调用把 nil 当 FBSShutdownOptions 传进了 FBS）。关机绝不允许
    // 被悄悄替换成一次重启调用，所以现在只提示、不动作。
    if ([action isEqualToString:kERPowerActionShutdown]) {
        BOOL presented = [self erPresentNativePowerDownSheet];
        ERLogOperation(@"power", action, presented,
                       presented ? @"native sheet" : @"no native sheet available");
        if (!presented) [self erReportPowerDownUnavailable];
        return;
    }
    BOOL spawned = NO;
    if ([action isEqualToString:kERPowerActionRespring]) {
        // sbreload 是 Dopamine/roothide 自带的软注销；没有就退回 killall。
        spawned = ERRunTool(@"sbreload", @[]) || ERRunTool(@"killall", @[@"-9", @"SpringBoard"]);
    } else if ([action isEqualToString:kERPowerActionSafeMode]) {
        // 让 SpringBoard 收到 SIGSEGV：下一次被 launchd 拉起时 ellekit 会进入安全模式。
        spawned = ERRunTool(@"killall", @[@"-SEGV", @"SpringBoard"]);
    } else if ([action isEqualToString:kERPowerActionUserspace]) {
        spawned = ERRunTool(@"launchctl", @[@"reboot", @"userspace"]);
    } else if ([action isEqualToString:kERPowerActionReboot]) {
        spawned = ERRunTool(@"launchctl", @[@"reboot", @"hard"]);
        if (!spawned) spawned = [self erRebootViaFrontBoard];
    }
    ERLogOperation(@"power", action, spawned, spawned ? @"spawned" : @"no tool available");
}

- (BOOL)erPresentNativePowerDownSheet {
    Class factoryClass = NSClassFromString(@"SBUIPowerDownViewControllerFactory");
    UIViewController *powerController = nil;
    if (factoryClass) {
        // 工厂方法名在几个 iOS 大版本之间换过，两个都试。
        SEL selectors[2] = { NSSelectorFromString(@"newPowerDownViewController"),
                             NSSelectorFromString(@"powerDownViewController") };
        for (size_t index = 0; index < 2; index++) {
            if (![factoryClass respondsToSelector:selectors[index]]) continue;
            @try {
                powerController = ((id (*)(id, SEL))objc_msgSend)(factoryClass, selectors[index]);
            } @catch (__unused NSException *exception) {
                powerController = nil;
            }
            if (powerController) break;
        }
    }
    if (!powerController) return NO;
    // 有些系统版本自己已经把它摆上屏了，那就已经是成功。
    if (powerController.view.window) return YES;

    UIViewController *presenter = [self erModalPresenter];
    if (!presenter) return NO;
    @try {
        powerController.modalPresentationStyle = UIModalPresentationFullScreen;
        [presenter presentViewController:powerController animated:YES completion:nil];
    } @catch (__unused NSException *exception) {
        return NO;
    }
    return YES;
}

// 找一个「真的能 present」的宿主。
//
// 1.0.3：原来只取 gOverlayControllers 的第一个对象，并只检查它有没有
// presentedViewController。控制中心刚好在收起 / 正在做 present 的情况下，这个对象
// 要么已经不在窗口里、要么正忙，present 会失败；而失败之后旧代码会去做一次非法的
// 重启调用。现在改成「把所有 overlay 和关键窗口 root 链末端都当候选，只挑真的
// 已经上屏、且当前没有 presentedViewController、也不在收起过程中的那一个」。
- (UIViewController *)erModalPresenter {
    NSMutableArray<UIViewController *> *candidates = [NSMutableArray array];
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        if (overlay) [candidates addObject:overlay];
    }
    UIWindow *keyWindow = nil;
    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
        if (![scene isKindOfClass:[UIWindowScene class]]) continue;
        for (UIWindow *window in ((UIWindowScene *)scene).windows) {
            if (!window.isKeyWindow) continue;
            keyWindow = window;
            break;
        }
        if (keyWindow) break;
    }
    if (keyWindow.rootViewController) {
        UIViewController *root = keyWindow.rootViewController;
        NSUInteger guard = 0;
        while (root.presentedViewController && guard++ < 16) root = root.presentedViewController;
        [candidates addObject:root];
    }
    for (UIViewController *candidate in candidates) {
        if (!candidate.isViewLoaded) continue;
        if (!candidate.view.window) continue;
        if (candidate.presentedViewController) continue;
        if (candidate.isBeingDismissed) continue;
        return candidate;
    }
    return nil;
}

// 系统没有给出可用的关机面板时的说明。**不做任何破坏性动作** —— 不再试图
// 「顺手重启一下」，那正是把 SpringBoard 打进安全模式的原因。
- (void)erReportPowerDownUnavailable {
    UIViewController *presenter = [self erModalPresenter];
    if (!presenter) return;
    UIAlertController *alert = [UIAlertController
        alertControllerWithTitle:@"无法打开关机面板"
                         message:@"当前系统没有向插件提供可用的关机面板。请长按侧边按钮 + 任一音量键，再拖动「滑动来关机」。"
                  preferredStyle:UIAlertControllerStyleAlert];
    [alert addAction:[UIAlertAction actionWithTitle:@"好" style:UIAlertActionStyleDefault handler:nil]];
    @try {
        [presenter presentViewController:alert animated:YES completion:nil];
    } @catch (__unused NSException *exception) {
    }
}

- (BOOL)erRebootViaFrontBoard {
    Class serviceClass = NSClassFromString(@"FBSSystemService");
    SEL sharedSelector = NSSelectorFromString(@"sharedService");
    if (!serviceClass || ![serviceClass respondsToSelector:sharedSelector]) return NO;
    id service = ((id (*)(id, SEL))objc_msgSend)(serviceClass, sharedSelector);
    if (!service) return NO;
    SEL rebootSelector = NSSelectorFromString(@"rebootWithOptions:");
    if (![service respondsToSelector:rebootSelector]) return NO;
    // 1.0.3：这里原来传 nil。`rebootWithOptions:` 收的是 FBSShutdownOptions，
    // 传 nil 会在 FBS 内部解引用空指针；本函数跑在 SpringBoard 进程里，于是
    // SpringBoard 直接挂掉并被 ellekit 拉起成安全模式。拿不到合法 options 就
    // 干脆放弃这次调用，交由上层决定怎么提示。
    id options = ERFBSShutdownOptions();
    if (!options) return NO;
    @try {
        ((void (*)(id, SEL, id))objc_msgSend)(service, rebootSelector, options);
    } @catch (__unused NSException *exception) {
        return NO;
    }
    return YES;
}

- (id)moduleSettingsProvider {
    Class providerClass = NSClassFromString(@"CCSModuleSettingsProvider");
    SEL selector = NSSelectorFromString(@"sharedProvider");
    return [providerClass respondsToSelector:selector] ? ((id (*)(id, SEL))objc_msgSend)(providerClass, selector) : nil;
}

- (NSArray<NSString *> *)enabledModuleIdentifiers {
    id provider = [self moduleSettingsProvider];
    SEL selector = NSSelectorFromString(@"orderedUserEnabledModuleIdentifiers");
    return [provider respondsToSelector:selector] ? ((id (*)(id, SEL))objc_msgSend)(provider, selector) : @[];
}

- (void)saveEnabledModuleIdentifiers:(NSArray<NSString *> *)identifiers {
    id provider = [self moduleSettingsProvider];
    SEL selector = NSSelectorFromString(@"setAndSaveOrderedUserEnabledModuleIdentifiers:");
    if ([provider respondsToSelector:selector]) ((void (*)(id, SEL, id))objc_msgSend)(provider, selector, identifiers);
}

- (NSArray<NSString *> *)fixedModuleIdentifiers {
    id provider = [self moduleSettingsProvider];
    SEL selector = NSSelectorFromString(@"orderedFixedModuleIdentifiers");
    return [provider respondsToSelector:selector] ? ((id (*)(id, SEL))objc_msgSend)(provider, selector) : @[];
}

- (UIButton *)addControlButtonForOverlay:(UIViewController *)overlay {
    UIButton *button = (UIButton *)[overlay.view viewWithTag:kERAddControlButtonTag];
    if (button) return button;
    button = [ERExpandedHitButton buttonWithType:UIButtonTypeCustom];
    button.tag = kERAddControlButtonTag;
    button.accessibilityIdentifier = @"EchoRebornAddControlButton";
    button.backgroundColor = UIColor.clearColor;
    button.tintColor = UIColor.whiteColor;
    UIImageSymbolConfiguration *symbolConfiguration = [UIImageSymbolConfiguration configurationWithPointSize:10.0 weight:UIImageSymbolWeightSemibold];
    UIButtonConfiguration *configuration = [UIButtonConfiguration plainButtonConfiguration];
    configuration.image = [UIImage systemImageNamed:@"plus.circle.fill" withConfiguration:symbolConfiguration];
    configuration.attributedTitle = [[NSAttributedString alloc] initWithString:@"添加控制项" attributes:@{
        NSFontAttributeName: [UIFont systemFontOfSize:12.5 weight:UIFontWeightSemibold],
        NSForegroundColorAttributeName: UIColor.whiteColor,
    }];
    configuration.baseForegroundColor = UIColor.whiteColor;
    configuration.imagePadding = 4.0;
    configuration.contentInsets = NSDirectionalEdgeInsetsMake(6.0, 10.0, 6.0, 14.0);
    button.configuration = configuration;
    [button addTarget:self action:@selector(addControlTapped:) forControlEvents:UIControlEventTouchUpInside];
    button.alpha = 0.0;
    button.hidden = YES;
    [overlay.view addSubview:button];
    return button;
}

- (void)captureSheetSourceSnapshotForOverlay:(UIViewController *)overlay {
    gERSheetScreenImage = nil;
    gERSheetModuleFrames = nil;
    if (!overlay.view.window) return;
    // Materials (platters, slider fills, tints) only exist composited in the
    // framebuffer — live snapshot views lose them across windows and
    // drawViewHierarchyInRect never renders them. Grab the real screen with
    // EchoReborn's edit chrome hidden for one committed frame, then crop modules.
    NSMutableArray<UIView *> *hiddenViews = [NSMutableArray array];
    NSMutableArray<NSDictionary *> *detachedBorders = [NSMutableArray array];
    void (^hideView)(UIView *) = ^(UIView *view) {
        if (view && !view.hidden) {
            view.hidden = YES;
            [hiddenViews addObject:view];
        }
    };
    NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
    for (EREditGridView *grid in pageGrids.allValues) hideView(grid);
    hideView(objc_getAssociatedObject(overlay, kEREditGridKey));
    hideView([overlay.view viewWithTag:kERAddControlButtonTag]);
    for (UIView *subview in overlay.view.subviews) {
        if (subview.tag == kERRemoveButtonTag || subview.tag == kERResizeButtonTag) hideView(subview);
    }
    NSMutableDictionary<NSString *, NSValue *> *frames = [NSMutableDictionary dictionary];
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        hideView(objc_getAssociatedObject(module.view, kERRemoveButtonKey));
        hideView(objc_getAssociatedObject(module.view, kERResizeButtonKey));
        UIView *border = objc_getAssociatedObject(module.view, @selector(applyEditingToModule:editing:));
        UIView *borderParent = border.superview;
        if (borderParent) {
            NSUInteger borderIndex = [borderParent.subviews indexOfObjectIdenticalTo:border];
            [detachedBorders addObject:@{
                @"view": border,
                @"parent": borderParent,
                @"index": @(borderIndex == NSNotFound ? borderParent.subviews.count : borderIndex),
            }];
            // The breathing ring has an active presentation layer. Merely
            // hiding its model view can leave one composited frame in the
            // framebuffer crop, so detach it for the gallery snapshot.
            [border removeFromSuperview];
        }
        NSString *identifier = ERModuleIdentifier(module);
        if (identifier.length && module.view.window && !CGRectIsEmpty(module.view.bounds)) {
            frames[identifier] = [NSValue valueWithCGRect:[module.view convertRect:module.view.bounds toView:nil]];
        }
    }
    [overlay.view.window layoutIfNeeded];
    [CATransaction flush];
    UIView *screenSnapshot = [UIScreen.mainScreen snapshotViewAfterScreenUpdates:YES];
    UIImage *screenImage = nil;
    if (screenSnapshot) {
        [overlay.view.window addSubview:screenSnapshot];
        @try {
            UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithBounds:screenSnapshot.bounds];
            screenImage = [renderer imageWithActions:^(__unused UIGraphicsImageRendererContext *context) {
                [screenSnapshot drawViewHierarchyInRect:screenSnapshot.bounds afterScreenUpdates:YES];
            }];
        } @catch (__unused NSException *exception) { screenImage = nil; }
        [screenSnapshot removeFromSuperview];
    }
    for (NSDictionary *record in detachedBorders) {
        UIView *view = record[@"view"];
        UIView *parent = record[@"parent"];
        NSUInteger index = MIN([record[@"index"] unsignedIntegerValue], parent.subviews.count);
        [parent insertSubview:view atIndex:index];
    }
    for (UIView *view in hiddenViews) view.hidden = NO;
    gERSheetScreenImage = screenImage;
    gERSheetModuleFrames = screenImage ? [frames copy] : nil;
}

- (void)addControlTapped:(UIButton *)sender {
    if (!gEnabled || !gEditModeActive) return;
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    if (!overlay || overlay.presentedViewController) return;
    ERHaptic();
    sender.enabled = NO;
    dispatch_async(dispatch_get_main_queue(), ^{
        sender.enabled = YES;
        if (!gEnabled || !gEditModeActive || overlay.presentedViewController) return;
        ERAddControlSheetViewController *sheet = [ERAddControlSheetViewController new];
        sheet.catalog = [self availableControlCatalog];
        sheet.modalPresentationStyle = UIModalPresentationPageSheet;
        UISheetPresentationController *presentation = sheet.sheetPresentationController;
        presentation.detents = @[UISheetPresentationControllerDetent.largeDetent];
        presentation.prefersGrabberVisible = YES;
        presentation.preferredCornerRadius = 30.0;
        gERAddSheetPresentationActive = YES;
        [overlay presentViewController:sheet animated:YES completion:^{
            gERAddSheetPresentationActive = NO;
        }];
    });
}

- (NSArray<NSDictionary *> *)availableControlCatalog {
    NSArray<NSString *> *enabled = [self enabledModuleIdentifiers];
    NSMutableSet<NSString *> *present = [NSMutableSet setWithArray:enabled ?: @[]];
    [present addObjectsFromArray:[self fixedModuleIdentifiers]];
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *identifier = ERModuleIdentifier(module);
        if (identifier.length) [present addObject:identifier];
    }

    // EchoReborn-owned tiles (connectivity duplicates, shortcut tiles) are not
    // part of the system's enabled-module list; they only exist in our own
    // registry. Include them so the gallery reflects what is really on screen.
    // 1.0.6：只把**可用**的账本条目算进「已存在」。值为空串的坏账条目既渲染不出来，
    // 也不该把控制项从候选里挡掉 —— 否则用户点「添加」会被静默拒绝（`present` 命中即
    // 返回 NO），表现就是「点了没反应，怎么都加不回来」。
    for (NSString *duplicate in gERDuplicateFamilies) {
        if (ERDuplicateLedgerHasLiveEntry(duplicate)) [present addObject:duplicate];
    }

    NSMutableOrderedSet<NSString *> *identifiers = [NSMutableOrderedSet orderedSet];
    NSMutableDictionary<NSString *, NSURL *> *bundleURLs = [NSMutableDictionary dictionary];
    NSMutableDictionary<NSString *, NSString *> *names = [NSMutableDictionary dictionary];

    Class managerClass = NSClassFromString(@"CCUIModuleInstanceManager");
    SEL sharedSelector = NSSelectorFromString(@"sharedInstance");
    id manager = [managerClass respondsToSelector:sharedSelector] ? ((id (*)(id, SEL))objc_msgSend)(managerClass, sharedSelector) : nil;
    id repository = nil;
    for (NSString *key in @[@"_repository", @"repository", @"_moduleRepository", @"moduleRepository"]) {
        @try { repository = [manager valueForKey:key]; } @catch (__unused NSException *exception) {}
        if (repository) break;
    }
    NSArray *allMetadata = nil;
    for (NSString *key in @[@"allModuleMetadata", @"_allModuleMetadata", @"moduleMetadata", @"_moduleMetadata"]) {
        @try {
            id value = [repository valueForKey:key];
            if ([value isKindOfClass:[NSArray class]] && [(NSArray *)value count]) { allMetadata = value; break; }
        } @catch (__unused NSException *exception) {}
    }
    for (id metadata in allMetadata) {
        NSString *identifier = nil;
        for (NSString *key in @[@"moduleIdentifier", @"identifier"]) {
            @try {
                id value = [metadata valueForKey:key];
                if ([value isKindOfClass:[NSString class]] && [value length]) { identifier = value; break; }
            } @catch (__unused NSException *exception) {}
        }
        if (!identifier.length) continue;
        if (ERIdentifierIsLegacyPhysicalDuplicate(identifier)) continue;
        [identifiers addObject:identifier];
        for (NSString *key in @[@"moduleBundleURL", @"bundleURL", @"URL", @"url"]) {
            @try {
                id value = [metadata valueForKey:key];
                if ([value isKindOfClass:[NSURL class]]) { bundleURLs[identifier] = value; break; }
            } @catch (__unused NSException *exception) {}
        }
        @try {
            id value = [metadata valueForKey:@"displayName"];
            if ([value isKindOfClass:[NSString class]] && [value length]) names[identifier] = value;
        } @catch (__unused NSException *exception) {}
    }
    // The live repository object only reliably exposes instantiated modules.
    // The authoritative catalog is the module bundles on disk, exactly what
    // Settings > Control Center offers.
    // The first two cover the stock and rootless (/var/jb) layouts; the
    // jbroot() entries resolve to the randomised roothide root.  Non-existent
    // directories are simply skipped by contentsOfDirectoryAtPath:.
    NSArray<NSString *> *bundleDirectories = @[
        @"/System/Library/ControlCenter/Bundles",
        @"/Library/ControlCenter/Bundles",
        @"/var/jb/Library/ControlCenter/Bundles",
        jbroot(@"/Library/ControlCenter/Bundles"),
        jbroot(@"/var/jb/Library/ControlCenter/Bundles"),
    ];
    for (NSString *directory in bundleDirectories) {
        for (NSString *item in [[NSFileManager defaultManager] contentsOfDirectoryAtPath:directory error:nil]) {
            if (![item.pathExtension isEqualToString:@"bundle"]) continue;
            NSBundle *bundle = [NSBundle bundleWithPath:[directory stringByAppendingPathComponent:item]];
            NSString *identifier = bundle.bundleIdentifier;
            if (!identifier.length) continue;
            if (ERIdentifierIsLegacyPhysicalDuplicate(identifier)) continue;
            [identifiers addObject:identifier];
            if (!bundleURLs[identifier]) bundleURLs[identifier] = bundle.bundleURL;
            if (!names[identifier]) {
                // CFBundleName is the executable name ("OrientationLockModule")
                // and reads as junk; only the display name is trustworthy.
                id displayName = bundle.localizedInfoDictionary[@"CFBundleDisplayName"] ?: bundle.infoDictionary[@"CFBundleDisplayName"];
                if ([displayName isKindOfClass:[NSString class]] && [displayName length]) names[identifier] = displayName;
            }
        }
    }
    // The repository can omit fixed system modules; make sure everything that
    // is visibly part of Control Center still appears (dimmed) in the sheet.
    for (NSString *identifier in [self fixedModuleIdentifiers]) if (!ERIdentifierIsLegacyPhysicalDuplicate(identifier)) [identifiers addObject:identifier];
    for (NSString *identifier in enabled) if (!ERIdentifierIsLegacyPhysicalDuplicate(identifier)) [identifiers addObject:identifier];

    NSMutableArray<NSDictionary *> *catalog = [NSMutableArray array];
    NSUInteger hiddenAdded = 0;
    for (NSString *identifier in identifiers) {
        // Call-managed conference modules appear and disappear with the call;
        // real iOS never offers them in the gallery either. ContinuousExpose
        // (iPad Stage Manager) and PerformanceTrace (internal) are noise here.
        if ([identifier localizedCaseInsensitiveContainsString:@"conference"] ||
            [identifier localizedCaseInsensitiveContainsString:@"continuousexpose"] ||
            [identifier localizedCaseInsensitiveContainsString:@"performancetrace"] ||
            ERIdentifierIsLegacyPhysicalDuplicate(identifier)) continue;
        // 槽位标识符（…shortcut.N）由下面的快捷指令段负责提供，通用循环一律跳过，
        // 否则 32 个（大多是空的）槽位会全部冒出来。
        if (ERShortcutSlotIndexFromIdentifier(identifier) > 0) continue;
        // 模块开关：用户在「模块管理」设置页关掉某一行后，该模块不再出现在
        // 「添加控制项」中。覆盖两个家族 ——
        //   「连接」     echoreborn.connectivity.*（七个 CCUIToggleModule）
        //   「实用工具」 echoreborn.weather       （自绘天气磁贴，1.0.6-2 新增；
        //                                          1.0.6-12 起 4×1 / 4×2 自适应）
        // 只有键名带 ModuleEnabled_ 前缀这一条约定是共享的，读写两侧（设置页的
        // -erSwitchForModule: 与这里）必须用同一个 identifier 拼出来。
        NSString *lowerIdentifier = identifier.lowercaseString;
        if ([lowerIdentifier containsString:@"echoreborn.connectivity"] ||
            [lowerIdentifier containsString:@"echoreborn.weather"]) {
            CFPropertyListRef enabled = CFPreferencesCopyAppValue((__bridge CFStringRef)[NSString stringWithFormat:@"ModuleEnabled_%@", identifier], kERPrefsDomain);
            BOOL moduleEnabled = YES;
            if (enabled) {
                if (CFGetTypeID(enabled) == CFBooleanGetTypeID()) moduleEnabled = CFBooleanGetValue((CFBooleanRef)enabled);
                else if (CFGetTypeID(enabled) == CFNumberGetTypeID()) { int v = 1; CFNumberGetValue((CFNumberRef)enabled, kCFNumberIntType, &v); moduleEnabled = (v != 0); }
                CFRelease(enabled);
            }
            if (!moduleEnabled) continue;
        }
        NSString *name = ERFriendlyNameForIdentifier(identifier);
        if (!name.length) name = names[identifier];
        if (!name.length && overlay) {
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (![ERModuleIdentifier(module) isEqualToString:identifier]) continue;
                UIView *buttonView = ERFindSubviewWithClassName(module.view, @"CCUIButtonModuleView");
                if (buttonView.accessibilityLabel.length) name = buttonView.accessibilityLabel;
                break;
            }
        }
        if (!name.length) name = ERPrettyNameForIdentifier(identifier);
        // Unlocalized executable names still slip through repository metadata.
        if ([name hasSuffix:@"Module"] && ![name containsString:@" "]) name = ERPrettyNameForIdentifier(identifier);
        NSString *bundlePath = bundleURLs[identifier].path ?: @"";
        BOOL isTweak = bundlePath.length && ![bundlePath hasPrefix:@"/System/"];
        NSString *category = ERCategoryForIdentifier(identifier);
        // 1.0.6-14（第 4 条）：天气按用户要求归「实用工具」，自研模块只是**不参与**
        // 下面那条「第三方插件」重标。
        BOOL isOwnedModule = ERIdentifierIsEchoRebornOwned(identifier);
        if ([lowerIdentifier containsString:@"echoreborn.weather"]) {
            ERLogInfo(@"WEATHERCAT ver=1.0.9-103 id=%@ category=%@ isTweak=%d owned=%d bundle=%@",
                      identifier, category, isTweak, isOwnedModule, bundlePath);
        }
        BOOL allowsMultiple = ERModuleIdentifierSupportsOwnedDuplicates(identifier);
        NSUInteger instanceCount = allowsMultiple ? ERDuplicateCountForFamily(identifier, present) : 0;
        BOOL added = [present containsObject:identifier];
        // A control that is already in Control Center cannot be added a second
        // time, so it is hidden from the gallery entirely instead of being
        // offered as a dead tile. Families that genuinely accept several
        // copies (the standalone connectivity tiles) stay visible — each tap
        // places another instance and the badge shows how many exist.
        if (added && !allowsMultiple) {
            // Counted, not logged per item: the sheet rebuilds this catalog on
            // every presentation, so one line per hidden control turned into
            // dozens of file writes for a single open.
            hiddenAdded++;
            continue;
        }
        [catalog addObject:@{
            @"identifier": identifier,
            @"name": name,
            // 1.0.6-14：自研模块（连接七个 + 天气）不参与「第三方插件」重标 ——
            // 它们装在 /Library 下，isTweak 为真，但它们是本插件自己的功能，
            // 被改名成「第三方插件」与用户的预期分组不符。
            @"category": (isTweak && !isOwnedModule && [category isEqualToString:@"实用工具"]) ? @"第三方插件" : category,
            @"added": @(added),
            @"allowsMultiple": @(allowsMultiple),
            @"instanceCount": @(instanceCount),
            @"bundleURL": bundleURLs[identifier] ?: (id)NSNull.null,
        }];
    }
    // Shortcuts are user-created; they have no ControlCenter bundle, so they
    // are appended here straight from the Shortcuts database.
    //
    // The Settings pane is the gate. Every shortcut the tweak fetches lands in
    // its 未显示控制项 list, and only the ones the user has explicitly moved
    // into 显示控制项 are offered here. That keeps the gallery from being
    // flooded by a long shortcut library, and — more importantly — gives the
    // user a place to confirm what was actually fetched even when the gallery
    // is empty.
    NSUInteger hiddenShortcuts = 0;
    NSUInteger notEnabledShortcuts = 0;
    NSArray<NSString *> *visibleShortcuts = ERShortcutVisibleUUIDs();
    for (NSDictionary *shortcut in ERShortcutRecords()) {
        if (![shortcut[@"name"] isKindOfClass:[NSString class]] || ![shortcut[@"uuid"] isKindOfClass:[NSString class]]) continue;
        if (![visibleShortcuts containsObject:shortcut[@"uuid"]]) {
            notEnabledShortcuts++;
            continue;
        }
        // 槽位：为这条快捷指令绑一个槽位标识符（复用已有绑定，否则认领空槽）。
        NSString *slotIdentifier = ERShortcutSlotIdentifierForAddingUUID(shortcut[@"uuid"]);
        if (!slotIdentifier) { notEnabledShortcuts++; continue; }
        // 与原生模块同一规则：已经在控制中心里的槽位不再提供。移除后它会回来，
        // 因为面板每次打开都会重建目录。
        if ([present containsObject:slotIdentifier]) { hiddenShortcuts++; continue; }
        [catalog addObject:@{
            @"identifier": slotIdentifier,
            @"name": shortcut[@"name"],
            @"category": @"快捷指令",
            @"added": @NO,
            @"allowsMultiple": @NO,
            @"instanceCount": @0,
            @"bundleURL": (id)NSNull.null,
        }];
    }
    // Stable alphabetical order — a module's position never changes based on
    // whether it is currently added.
    [catalog sortUsingComparator:^NSComparisonResult(NSDictionary *left, NSDictionary *right) {
        return [left[@"name"] localizedCaseInsensitiveCompare:right[@"name"]];
    }];
    NSUInteger shortcutCount = 0;
    for (NSDictionary *entry in catalog) if ([entry[@"category"] isEqualToString:@"快捷指令"]) shortcutCount++;
    ERLogInfo(@"catalog: %lu selectable control(s) (%lu shortcut(s); %lu fetched but not enabled in Settings), %lu hidden as already added",
               (unsigned long)catalog.count, (unsigned long)shortcutCount,
               (unsigned long)notEnabledShortcuts,
               (unsigned long)(hiddenAdded + hiddenShortcuts));
    return catalog;
}

- (CCUILayoutSize)catalogLayoutSizeForIdentifier:(NSString *)identifier {
    // A converted connectivity tile may have been resized by the user; the
    // sheet must show the footprint it actually has on screen.
    if ([identifier.lowercaseString containsString:@"echoreborn.connectivity"]) {
        return ERConnectivityLayoutSizeForIdentifier(identifier);
    }
    NSValue *baseValue = gERBaseLayoutSizes[identifier];
    if (baseValue) {
        CCUILayoutSize base = {};
        [baseValue getValue:&base];
        if (base.width && base.height) return base;
    }
    NSDictionary<NSString *, NSArray<NSNumber *> *> *known = @{
        @"com.strive.echoreborn.connectivity.airplane": @[@1, @1],
        @"com.strive.echoreborn.connectivity.wifi": @[@1, @1],
        @"com.strive.echoreborn.connectivity.airdrop": @[@1, @1],
        @"com.strive.echoreborn.connectivity.cellular": @[@1, @1],
        @"com.strive.echoreborn.connectivity.bluetooth": @[@1, @1],
        @"com.strive.echoreborn.connectivity.hotspot": @[@1, @1],
        @"com.strive.echoreborn.connectivity.vpn": @[@1, @1],
        @"com.apple.control-center.ConnectivityModule": @[@2, @2],
        @"com.apple.mediaremote.controlcenter.nowplaying": @[@2, @2],
        @"com.apple.mediaremote.controlcenter.audio": @[@1, @2],
        @"com.apple.control-center.DisplayModule": @[@1, @2],
    };
    NSArray<NSNumber *> *dims = known[identifier];
    if (dims.count >= 2) return (CCUILayoutSize){dims[0].unsignedIntegerValue, dims[1].unsignedIntegerValue};
    return (CCUILayoutSize){1, 1};
}

- (CGSize)catalogPointSizeForLayoutSize:(CCUILayoutSize)size {
    CGFloat cell = kERGridCellSize, gap = kERGridGap;
    return CGSizeMake(cell * size.width + gap * (size.width - 1), cell * size.height + gap * (size.height - 1));
}

- (NSArray<NSDictionary *> *)temporarilyRevealModuleForSheetSnapshot:(UIView *)moduleView {
    if (!moduleView) return @[];
    NSMutableArray<NSDictionary *> *records = [NSMutableArray array];
    void (^captureView)(UIView *) = ^(UIView *view) {
        if (!view) return;
        id pageHidden = objc_getAssociatedObject(view, kERPageHiddenKey);
        [records addObject:@{
            @"view": view,
            @"hidden": @(view.hidden),
            @"alpha": @(view.alpha),
            @"opacity": @(view.layer.opacity),
            @"pageHidden": pageHidden ?: NSNull.null,
        }];
        view.hidden = NO;
        view.alpha = 1.0;
        view.layer.opacity = 1.0;
        if (pageHidden) objc_setAssociatedObject(view, kERPageHiddenKey, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    };
    captureView(moduleView.superview);
    captureView(moduleView);
    return records;
}

- (void)restoreModuleSheetSnapshotState:(NSArray<NSDictionary *> *)records {
    for (NSDictionary *record in records.reverseObjectEnumerator) {
        UIView *view = record[@"view"];
        if (![view isKindOfClass:[UIView class]]) continue;
        view.hidden = [record[@"hidden"] boolValue];
        view.alpha = [record[@"alpha"] doubleValue];
        view.layer.opacity = [record[@"opacity"] floatValue];
        id pageHidden = record[@"pageHidden"];
        objc_setAssociatedObject(view, kERPageHiddenKey, pageHidden == NSNull.null ? nil : pageHidden, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
}

- (UIView *)editChromeHostForModuleView:(UIView *)moduleView overlay:(UIViewController *)overlay {
    UIView *host = moduleView.superview ?: overlay.view;
    host.clipsToBounds = NO;
    return host;
}

- (void)positionEditControlsForModuleView:(UIView *)moduleView overlay:(UIViewController *)overlay overlayFrame:(CGRect)overlayFrame {
    if (!moduleView) return;
    UIButton *remove = objc_getAssociatedObject(moduleView, kERRemoveButtonKey);
    UIButton *resize = objc_getAssociatedObject(moduleView, kERResizeButtonKey);
    if (remove) {
        UIView *removeHost = remove.superview ?: [self editChromeHostForModuleView:moduleView overlay:overlay];
        CGRect removeHostFrame = overlay.view ? [overlay.view convertRect:overlayFrame toView:removeHost] : [moduleView convertRect:moduleView.bounds toView:removeHost];
        remove.frame = ERRemoveButtonFrameForModuleFrame(removeHostFrame);
    }
    if (resize) {
        UIView *resizeHost = resize.superview ?: overlay.view ?: [self editChromeHostForModuleView:moduleView overlay:overlay];
        CGRect resizeHostFrame = overlay.view ? [overlay.view convertRect:overlayFrame toView:resizeHost] : [moduleView convertRect:moduleView.bounds toView:resizeHost];
        resize.frame = CGRectMake(CGRectGetMaxX(resizeHostFrame) - 42.0, CGRectGetMaxY(resizeHostFrame) - 42.0, 42.0, 42.0);
    }
}

// Shared chrome hit test: YES when the point lands inside a visible
// remove/resize control. `generous` pads the zones (used to keep taps from
// slipping past chrome and exiting edit mode); non-generous shrinks the
// resize zone on 1x1 modules so their tiny surface stays grabbable.
- (BOOL)pointHitsEditChrome:(CGPoint)point overlay:(UIViewController *)overlay generous:(BOOL)generous {
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
        UIButton *removeChrome = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
        UIButton *resizeChrome = objc_getAssociatedObject(module.view, kERResizeButtonKey);
        // Resize grabber: a tight bottom-right corner that always keeps priority
        // over a drag (matches ERExpandedHitButton's own corner acceptance).
        if (resizeChrome && !resizeChrome.hidden && resizeChrome.alpha > 0.01 && resizeChrome.userInteractionEnabled && resizeChrome.superview) {
            BOOL small = [objc_getAssociatedObject(resizeChrome, kERSmallModuleChromeKey) boolValue];
            CGRect frame = [resizeChrome.superview convertRect:resizeChrome.frame toView:overlay.view];
            CGFloat cornerSize = small ? 26.0 : 34.0;
            CGRect hitFrame = CGRectMake(CGRectGetMaxX(frame) - cornerSize, CGRectGetMaxY(frame) - cornerSize, cornerSize, cornerSize);
            if (CGRectContainsPoint(hitFrame, point)) return YES;
        }
        // Remove bubble: a purely visual affordance now. It only participates in
        // the generous pass, whose sole job is to stop a near-corner tap from
        // reading as a blank-space tap that exits edit mode. In the non-generous
        // (drag) pass it never blocks, so the top-left stays grabbable and
        // removal is decided heuristically on drop.
        if (generous && removeChrome && !removeChrome.hidden && removeChrome.alpha > 0.01 && removeChrome.superview) {
            CGRect frame = [removeChrome.superview convertRect:removeChrome.frame toView:overlay.view];
            if (CGRectContainsPoint(CGRectInset(frame, -10.0, -10.0), point)) return YES;
        }
    }
    return NO;
}

- (UIButton *)removeButtonAtPoint:(CGPoint)point overlay:(UIViewController *)overlay {
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
        UIButton *remove = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
        if (!remove || remove.hidden || remove.alpha <= 0.01 || !remove.userInteractionEnabled || !remove.superview) continue;
        CGRect frame = [remove.superview convertRect:remove.frame toView:overlay.view];
        if (CGRectContainsPoint(CGRectInset(frame, -14.0, -14.0), point)) return remove;
    }
    return nil;
}

- (UIView *)previewViewForCatalogEntry:(NSDictionary *)entry {
    NSString *identifier = entry[@"identifier"];
    CCUILayoutSize layoutSize = [self catalogLayoutSizeForIdentifier:identifier];
    // Third-party (CCSupport-style) modules often declare their size in the
    // bundle's Info.plist rather than through the live provider.
    id bundleProbe = entry[@"bundleURL"];
    if (layoutSize.width == 1 && layoutSize.height == 1 && [bundleProbe isKindOfClass:[NSURL class]]) {
        NSDictionary *info = [NSBundle bundleWithURL:bundleProbe].infoDictionary;
        for (NSString *key in @[@"CCSModuleSize", @"ModuleSize", @"CCModuleSize"]) {
            id value = info[key];
            if (![value isKindOfClass:[NSDictionary class]]) continue;
            id width = value[@"Width"] ?: value[@"width"];
            id height = value[@"Height"] ?: value[@"height"];
            if ([width respondsToSelector:@selector(unsignedIntegerValue)] && [height respondsToSelector:@selector(unsignedIntegerValue)] &&
                [width unsignedIntegerValue] >= 1 && [height unsignedIntegerValue] >= 1) {
                layoutSize = (CCUILayoutSize){MIN(4, (NSUInteger)[width unsignedIntegerValue]), MIN(4, (NSUInteger)[height unsignedIntegerValue])};
                break;
            }
        }
    }
    CGSize pointSize = [self catalogPointSizeForLayoutSize:layoutSize];
    CGFloat radius = [self refinedCornerRadiusForSize:pointSize];

    UIView *container = [[UIView alloc] initWithFrame:(CGRect){CGPointZero, pointSize}];
    container.userInteractionEnabled = NO;
    container.layer.cornerRadius = radius;
    container.layer.cornerCurve = kCACornerCurveContinuous;
    container.clipsToBounds = YES;
    // The tile backing is an explicit translucent grey, not a bare blur.
    //
    // SystemUltraThinMaterialDark samples what is *behind* it. In a detached
    // preview there is nothing meaningful behind it, so it composites against
    // the sheet's own dark backdrop and reads as black. Modules with dense
    // artwork hide that; the 计时器 (an almost empty tile) does not, which is
    // why it was the one reported as black across three releases. A concrete
    // background colour makes the tile the same grey whether or not anything
    // sits behind it, and the blur on top still gives it the material look.
    container.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.12];
    UIVisualEffectView *material = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemUltraThinMaterialDark]];
    material.frame = container.bounds;
    material.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    material.userInteractionEnabled = NO;
    material.backgroundColor = UIColor.clearColor;
    [container addSubview:material];

    // 仅旧的 uuid 磁贴走这里。槽位标识符对应的是**真实模块**：让它们落到下面的通用
    // 实例化，渲染槽位 bundle 自己的磁贴（系统背景上的白色字形）—— 也就是用户添加后
    // 真正看到的那一块，而不是 0.5.5 以前那套自绘底板 + imageData 图标。
    if (ERShortcutIdentifierIsShortcut(identifier) && !ERShortcutSlotIndexFromIdentifier(identifier)) {
        NSDictionary *shortcut = ERShortcutForIdentifier(identifier);
        NSString *title = ([shortcut[@"name"] isKindOfClass:[NSString class]]) ? shortcut[@"name"] : @"快捷指令";
        UIView *presentation = EREnsureOwnedCompactPresentation(container);
        ERLayoutOwnedCompactPresentation(presentation, @"sparkles", title, nil, layoutSize, NO);
        UIImageView *ownedGlyph = (UIImageView *)[presentation viewWithTag:kERResizePresentationGlyphTag];
        UIImage *icon = ERShortcutIconImage(shortcut);
        if (ownedGlyph && icon) {
            ownedGlyph.image = icon;
            ownedGlyph.contentMode = UIViewContentModeScaleAspectFit;
            // Same geometry rule as the live tile: a 1x1 preview shows the icon
            // centred and alone, a two-cell preview puts it left of the title.
            CGFloat previewWidth = pointSize.width;
            CGFloat previewHeight = pointSize.height;
            CGFloat side = MIN(MIN(kERGridCellSize - 20.0, 44.0), MIN(previewWidth, previewHeight) - 14.0);
            if (side < 20.0) side = MAX(20.0, MIN(previewWidth, previewHeight) - 8.0);
            CGFloat originX = layoutSize.width > 1 ? 21.0 : (previewWidth - side) * 0.5;
            CGFloat originY = (previewHeight - side) * 0.5;
            ownedGlyph.frame = CGRectMake(round(originX), round(originY), side, side);
            ownedGlyph.layer.cornerRadius = side * 0.24;
            ownedGlyph.layer.cornerCurve = kCACornerCurveContinuous;
            ownedGlyph.layer.masksToBounds = YES;
        }
        [container bringSubviewToFront:presentation];
        return container;
    }

    if ([identifier.lowercaseString containsString:@"echoreborn.connectivity"]) {
        BOOL selected = ERConnectivitySelectedForIdentifier(identifier);
        BOOL active = ERConnectivityActiveForIdentifier(identifier);
        BOOL available = ERConnectivityAvailableForIdentifier(identifier);
        BOOL highlights = ERConnectivityIdentifierUsesWhiteHighlight(identifier);
        // Converted modules keep a platter in both states, so the preview has to
        // mirror the live tile exactly: white when ON, the timer grey when OFF.
        // Until v0.3.11 the preview painted white in BOTH states and also hid
        // the blur, so a switched-off tile looked lit up in the gallery.
        material.alpha = selected ? 0.0 : (available ? 1.0 : 0.52);
        CGFloat platterAlpha = available ? 1.0 : 0.42;
        UIColor *platterColor = highlights
            ? (selected ? ERConnectivityHighlightPlatterColor() : ERConnectivityRestingPlatterColor())
            : (selected ? [ERConnectivityAccentColorForIdentifier(identifier) colorWithAlphaComponent:platterAlpha] : UIColor.clearColor);
        container.backgroundColor = highlights ? [platterColor colorWithAlphaComponent:platterAlpha] : platterColor;
        NSString *title = ERFriendlyNameForIdentifier(identifier) ?: ERPrettyNameForIdentifier(identifier);
        NSString *status = ERConnectivityStatusForIdentifier(identifier);
        NSString *symbol = ERFallbackSymbolForIdentifier(identifier) ?: @"switch.2";
        UIView *presentation = EREnsureOwnedCompactPresentation(container);
        // The gallery preview must show the same three footprints as the live
        // tile. A converted tile the user has already resized carries its
        // current footprint in gERCustomSizes; anything else falls back to the
        // sheet's declared base size.
        CCUILayoutSize previewSize = layoutSize;
        NSArray<NSNumber *> *resized = gERCustomSizes[identifier];
        if (resized.count >= 2) {
            previewSize = (CCUILayoutSize){resized[0].unsignedIntegerValue, resized[1].unsignedIntegerValue};
        }
        ERLayoutOwnedCompactPresentation(presentation, symbol, title, status, previewSize, YES);
        UIImage *nativeGlyph = ERConnectivityStockProxyGlyphImage(identifier);
        UIImageView *ownedGlyph = (UIImageView *)[presentation viewWithTag:kERResizePresentationGlyphTag];
        if (nativeGlyph && ownedGlyph) {
            UIImage *uniform = ERUniformConnectivityGlyphImage([nativeGlyph imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate], kERConnectivityGlyphBox);
            CGSize currentSize = ownedGlyph.image.size;
            if (fabs(currentSize.width - uniform.size.width) > 0.5 ||
                fabs(currentSize.height - uniform.size.height) > 0.5) {
                ownedGlyph.image = uniform;
            }
        }
        if ([identifier.lowercaseString containsString:@".bluetooth"]) {
            UIView *packageGlyph = EREnsureConnectivityBluetoothPackageGlyph(presentation, selected);
            if (ownedGlyph) {
                ownedGlyph.hidden = packageGlyph != nil;
                ownedGlyph.alpha = packageGlyph ? 0.0 : 1.0;
            }
            ERAlignConnectivityPackageGlyphForLayout(packageGlyph, previewSize);
            if (packageGlyph) [presentation bringSubviewToFront:packageGlyph];
        } else {
            UIView *packageGlyph = [presentation viewWithTag:kERConnectivityBluetoothPackageGlyphTag];
            packageGlyph.hidden = YES;
            packageGlyph.alpha = 0.0;
            if (ownedGlyph) {
                ownedGlyph.hidden = NO;
                ownedGlyph.alpha = 1.0;
            }
        }
        ERApplyOwnedCompactPresentationState(presentation, identifier, selected, active, ERConnectivityAccentColorForIdentifier(identifier), NO);
        ERApplyOwnedCompactPresentationAvailability(presentation, available);
        [container bringSubviewToFront:presentation];
        return container;
    }

    // Not-yet-added modules have no live instance in iOS 16, so instantiate
    // the module bundle's principal class directly for a real, inert render.
    // Constructing a real CCUIContentModuleContext first (the way the instance
    // manager does) lets far more modules initialize with proper glyphs/state.
    UIView *content = nil;
    id bundleValue = entry[@"bundleURL"];
    if ([bundleValue isKindOfClass:[NSURL class]]) {
        @try {
            NSBundle *bundle = [NSBundle bundleWithURL:bundleValue];
            if (bundle && (bundle.isLoaded || [bundle load])) {
                Class principal = bundle.principalClass;
                id context = nil;
                Class contextClass = NSClassFromString(@"CCUIContentModuleContext");
                if (principal && contextClass) {
                    SEL contextInit = NSSelectorFromString(@"initWithModuleIdentifier:");
                    if ([contextClass instancesRespondToSelector:contextInit]) {
                        @try { context = ((id (*)(id, SEL, id))objc_msgSend)([contextClass alloc], contextInit, identifier); } @catch (__unused NSException *exception) { context = nil; }
                    }
                    if (!context) {
                        @try {
                            context = [contextClass new];
                            [context setValue:identifier forKey:@"moduleIdentifier"];
                        } @catch (__unused NSException *exception) { context = nil; }
                    }
                }
                id module = nil;
                SEL moduleContextInit = NSSelectorFromString(@"initWithContentModuleContext:");
                if (principal && context && [principal instancesRespondToSelector:moduleContextInit]) {
                    @try { module = ((id (*)(id, SEL, id))objc_msgSend)([principal alloc], moduleContextInit, context); } @catch (__unused NSException *exception) { module = nil; }
                }
                if (principal && !module) {
                    @try { module = [[principal alloc] init]; } @catch (__unused NSException *exception) { module = nil; }
                }
                if (module && context) {
                    @try {
                        SEL setContext = NSSelectorFromString(@"setContentModuleContext:");
                        if ([module respondsToSelector:setContext]) ((void (*)(id, SEL, id))objc_msgSend)(module, setContext, context);
                    } @catch (__unused NSException *exception) {}
                }
                UIViewController *contentController = nil;
                if ([module isKindOfClass:[UIViewController class]]) contentController = module;
                else if ([module respondsToSelector:NSSelectorFromString(@"contentViewController")]) {
                    @try { contentController = ((id (*)(id, SEL))objc_msgSend)(module, NSSelectorFromString(@"contentViewController")); } @catch (__unused NSException *exception) { contentController = nil; }
                }
                UIView *moduleContent = [contentController isKindOfClass:[UIViewController class]] ? contentController.view : nil;
                if (moduleContent) {
                    // Keep the module, controller, and context alive for the
                    // preview's lifetime.
                    objc_setAssociatedObject(container, kERAddSheetModuleKey, module, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    objc_setAssociatedObject(container, kERAddSheetControllerKey, contentController, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    objc_setAssociatedObject(container, kERAddSheetContextKey, context, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    moduleContent.frame = container.bounds;
                    moduleContent.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
                    moduleContent.userInteractionEnabled = NO;
                    [container addSubview:moduleContent];
                    @try {
                        [contentController beginAppearanceTransition:YES animated:NO];
                        [contentController endAppearanceTransition];
                    } @catch (__unused NSException *exception) {}
                    [moduleContent setNeedsLayout];
                    @try { [moduleContent layoutIfNeeded]; } @catch (__unused NSException *exception) {}
                    // Freshly instantiated content renders its accessory title
                    // label on top of the glyph (real CC positions it outside
                    // the platter). Hide any text; the sheet draws its own.
                    NSMutableArray<UIView *> *labelQueue = [NSMutableArray arrayWithObject:moduleContent];
                    while (labelQueue.count) {
                        UIView *candidate = labelQueue.firstObject;
                        [labelQueue removeObjectAtIndex:0];
                        if ([candidate isKindOfClass:[UILabel class]]) candidate.hidden = YES;
                        [labelQueue addObjectsFromArray:candidate.subviews];
                    }
                    // Detached module previews often carry a native 1x2/2x1
                    // material mask underneath EchoReborn's outer backing. Make
                    // every full-size surface share one continuous radius so
                    // no second rounded layer peeks around the perimeter.
                    ERNormalizePreviewCornerRadii(moduleContent, container.bounds.size, radius);
                    ERLogPreviewBacking(moduleContent, identifier);
                    ERCleanGalleryPreviewChrome(moduleContent, identifier, container.bounds.size);
                    // Clearing a backing colour changes what the view draws at
                    // render time, but the module may cache its own composition
                    // during the first layout pass. A second pass after the
                    // clean-up makes the neutralised backing take effect before
                    // the preview is handed to the grid.
                    [moduleContent setNeedsLayout];
                    @try { [moduleContent layoutIfNeeded]; } @catch (__unused NSException *exception) {}
                    ERFitPreviewContentIntoBounds(moduleContent, container.bounds.size);
                    content = moduleContent;
                }
            }
        } @catch (__unused NSException *exception) { content = nil; }
    }
    if (!content) {
        // Curated SF Symbol stand-ins for modules that refuse to instantiate;
        // the generic grid glyph is a last resort only.
        NSString *symbolName = ERFallbackSymbolForIdentifier(identifier) ?: @"square.grid.2x2";
        UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:26.0 weight:UIImageSymbolWeightMedium];
        UIImage *symbol = [UIImage systemImageNamed:symbolName withConfiguration:configuration] ?: [UIImage systemImageNamed:@"square.grid.2x2" withConfiguration:configuration];
        UIImageView *glyph = [[UIImageView alloc] initWithImage:symbol];
        glyph.tintColor = [UIColor.whiteColor colorWithAlphaComponent:0.9];
        glyph.contentMode = UIViewContentModeCenter;
        glyph.frame = container.bounds;
        glyph.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        [container addSubview:glyph];
    }
    return container;
}

- (BOOL)addShortcutSlotToControlCenter:(NSString *)identifier {
    NSInteger slot = ERShortcutSlotIndexFromIdentifier(identifier);
    if (slot <= 0) return NO;
    NSArray<NSString *> *enabled = [self enabledModuleIdentifiers];
    if ([enabled containsObject:identifier]) return NO;
    NSMutableArray<NSString *> *updated = [enabled mutableCopy] ?: [NSMutableArray array];
    [updated addObject:identifier];
    [self saveEnabledModuleIdentifiers:updated];
    ERLogInfo(@"add: slot %ld enabled as a real Control Center module (native layout)", (long)slot);
    return YES;
}

- (BOOL)addShortcutModuleToControlCenter:(NSString *)identifier {
    if (!ERShortcutIdentifierIsShortcut(identifier) || !ERShortcutForIdentifier(identifier)) return NO;
    NSArray<NSString *> *enabled = [self enabledModuleIdentifiers];
    NSMutableSet<NSString *> *present = [NSMutableSet setWithArray:enabled ?: @[]];
    [present addObjectsFromArray:[self fixedModuleIdentifiers]];
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *moduleIdentifier = ERModuleIdentifier(module);
        if (moduleIdentifier.length) [present addObject:moduleIdentifier];
    }
    // 1.0.6：只把**可用**的账本条目算进「已存在」。值为空串的坏账条目既渲染不出来，
    // 也不该把控制项从候选里挡掉 —— 否则用户点「添加」会被静默拒绝（`present` 命中即
    // 返回 NO），表现就是「点了没反应，怎么都加不回来」。
    for (NSString *duplicate in gERDuplicateFamilies) {
        if (ERDuplicateLedgerHasLiveEntry(duplicate)) [present addObject:duplicate];
    }
    if ([present containsObject:identifier]) return NO;

    CCUILayoutSize size = (CCUILayoutSize){1, 1};
    NSMutableDictionary<NSString *, NSValue *> *layout = [NSMutableDictionary dictionary];
    for (NSString *existing in gERNativeLayoutRects) {
        if (![present containsObject:existing]) continue;
        CCUILayoutRect rect = {};
        [gERNativeLayoutRects[existing] getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(existing);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *customSize = gERCustomSizes[existing];
        if (customSize.count >= 2) rect.size = (CCUILayoutSize){customSize[0].unsignedIntegerValue, customSize[1].unsignedIntegerValue};
        layout[existing] = [NSValue value:&rect withObjCType:@encode(CCUILayoutRect)];
    }
    NSUInteger startPage = overlay ? ERDerivedVisiblePageForOverlay(overlay) : MIN(gERCurrentPage, kERMaxPages - 1);
    CCUILayoutPoint destination = {0, 0};
    if (!ERGuaranteedPagedSlot(identifier, size, startPage, layout, &destination)) return NO;

    // Shortcut tiles ride the owned-duplicate machinery with the shortcut as
    // its own family, so persistence, layout, and removal all reuse the
    // existing paths.
    gERDuplicateFamilies[identifier] = identifier;
    gERCustomOrigins[identifier] = @[@(destination.x), @(destination.y)];
    [gERCustomSizes removeObjectForKey:identifier];
    gERPendingPageAfterRebuild = destination.y / kERMinimumGridRows;
    ERSaveDuplicateFamilies();
    ERSaveGridPreferences();
    if (overlay) {
        [self syncOwnedDuplicateModulesForOverlay:overlay];
        [self normalizePagedLayoutForOverlay:overlay];
        [self setCurrentPage:gERPendingPageAfterRebuild == NSNotFound ? gERCurrentPage : MIN(gERPendingPageAfterRebuild, MAX((NSUInteger)1, gERPageCount) - 1) forOverlay:overlay animated:NO];
        gERPendingPageAfterRebuild = NSNotFound;
        if (gEditModeActive) [self setEditPresentation:YES forOverlay:overlay animated:NO];
    }
    return YES;
}

- (void)shortcutTileProxyTapped:(UIButton *)sender {
    if (gEditModeActive || gERExpandedModuleOpen) return;
    NSString *identifier = objc_getAssociatedObject(sender, kERConnectivityIdentifierKey);
    NSDictionary *shortcut = ERShortcutForIdentifier(identifier);
    NSString *name = [shortcut[@"name"] isKindOfClass:[NSString class]] ? shortcut[@"name"] : nil;
    if (!name.length) return;
    NSString *uuid = [shortcut[@"uuid"] isKindOfClass:[NSString class]] ? shortcut[@"uuid"] : nil;
    ERHaptic();
    // 0.5.4: run it in the background through the private runner client, so the
    // Shortcuts app is never brought up. Only when that is unavailable do we
    // fall back to the foreground URL — the behaviour the user sees as "it opens
    // the Shortcuts app".
    NSString *encoded = [name stringByAddingPercentEncodingWithAllowedCharacters:[NSCharacterSet URLQueryAllowedCharacterSet]];
    NSURL *url = [NSURL URLWithString:[NSString stringWithFormat:@"shortcuts://run-shortcut?name=%@", encoded ?: @""]];
    void (^openShortcut)(void) = ^{
        if (ERRunShortcutInBackground(name, uuid)) return;
        if (!url) return;
        [[UIApplication sharedApplication] openURL:url options:@{} completionHandler:nil];
    };
    // 0.5.1: Control Center is owned by SBControlCenterController, not by the
    // overlay view controller. Dismissing the overlay did nothing visible, so
    // the panel stayed up while the shortcut opened underneath it. Ask the real
    // controller to dismiss, then launch; neither step waits on the other.
    id controller = gERSBControlCenterController;
    SEL dismissSelector = @selector(dismissAnimated:);
    if (controller && [controller respondsToSelector:dismissSelector]) {
        // Single call: -dismissAnimated: returns void, so its result must not
        // be inspected (and the selector must not be sent twice).
        ((void (*)(id, SEL, BOOL))objc_msgSend)(controller, dismissSelector, NO);
    } else {
        UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
        if (overlay) [overlay dismissViewControllerAnimated:NO completion:nil];
    }
    // Long enough that the panel is on its way out, short enough that the run
    // does not feel delayed.
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), openShortcut);
}

- (BOOL)addOwnedDuplicateForIdentifier:(NSString *)identifier {
    NSString *familyIdentifier = ERDuplicateFamilyIdentifierForIdentifier(identifier);
    if (!ERModuleIdentifierSupportsOwnedDuplicates(familyIdentifier)) return NO;
    NSArray<NSString *> *enabled = [self enabledModuleIdentifiers];
    NSMutableSet<NSString *> *present = [NSMutableSet setWithArray:enabled ?: @[]];
    [present addObjectsFromArray:[self fixedModuleIdentifiers]];
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *moduleIdentifier = ERModuleIdentifier(module);
        if (moduleIdentifier.length) [present addObject:moduleIdentifier];
    }
    if (![present containsObject:familyIdentifier]) return NO;
    NSString *duplicateIdentifier = ERNextDuplicateIdentifierForFamily(familyIdentifier, present);
    if (!duplicateIdentifier.length) return NO;

    CCUILayoutSize size = [self catalogLayoutSizeForIdentifier:familyIdentifier];
    NSMutableDictionary<NSString *, NSValue *> *layout = [NSMutableDictionary dictionary];
    NSMutableSet<NSString *> *occupied = [present mutableCopy];
    [occupied addObject:duplicateIdentifier];
    for (NSString *existing in gERNativeLayoutRects) {
        if (![occupied containsObject:existing]) continue;
        CCUILayoutRect rect = {};
        [gERNativeLayoutRects[existing] getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(existing);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *customSize = gERCustomSizes[existing];
        if (customSize.count >= 2) rect.size = (CCUILayoutSize){customSize[0].unsignedIntegerValue, customSize[1].unsignedIntegerValue};
        layout[existing] = [NSValue value:&rect withObjCType:@encode(CCUILayoutRect)];
    }
    NSUInteger startPage = overlay ? ERDerivedVisiblePageForOverlay(overlay) : MIN(gERCurrentPage, kERMaxPages - 1);
    CCUILayoutPoint destination = {0, 0};
    if (!ERGuaranteedPagedSlot(duplicateIdentifier, size, startPage, layout, &destination)) return NO;

    gERDuplicateFamilies[duplicateIdentifier] = familyIdentifier;
    gERCustomOrigins[duplicateIdentifier] = @[@(destination.x), @(destination.y)];
    [gERCustomSizes removeObjectForKey:duplicateIdentifier];
    gERPendingPageAfterRebuild = destination.y / kERMinimumGridRows;
    ERSaveDuplicateFamilies();
    ERSaveGridPreferences();
    if (overlay) {
        [self syncOwnedDuplicateModulesForOverlay:overlay];
        [self normalizePagedLayoutForOverlay:overlay];
        [self setCurrentPage:gERPendingPageAfterRebuild == NSNotFound ? gERCurrentPage : MIN(gERPendingPageAfterRebuild, MAX((NSUInteger)1, gERPageCount) - 1) forOverlay:overlay animated:NO];
        gERPendingPageAfterRebuild = NSNotFound;
        if (gEditModeActive) [self setEditPresentation:YES forOverlay:overlay animated:NO];
    }
    return YES;
}

- (BOOL)addModuleIdentifierToControlCenter:(NSString *)identifier {
    if (!identifier.length) return NO;
    ERLogInfo(@"add: request for %@", identifier);
    // 槽位是真实的 Control Center 模块：通过控制中心原生的 enabled-modules 列表添加，
    // 由控制中心自己布局（EvoCenter16 的机制）。旧的 uuid 磁贴仍走自绘那条路。
    if (ERShortcutIdentifierIsShortcut(identifier) && !ERShortcutSlotIndexFromIdentifier(identifier)) {
        return [self addShortcutModuleToControlCenter:identifier];
    }
    if (ERShortcutSlotIndexFromIdentifier(identifier)) {
        return [self addShortcutSlotToControlCenter:identifier];
    }
    NSArray<NSString *> *enabled = [self enabledModuleIdentifiers];
    NSMutableSet<NSString *> *present = [NSMutableSet setWithArray:enabled ?: @[]];
    [present addObjectsFromArray:[self fixedModuleIdentifiers]];
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *moduleIdentifier = ERModuleIdentifier(module);
        if (moduleIdentifier.length) [present addObject:moduleIdentifier];
    }
    if ([present containsObject:identifier]) {
        if ([self addOwnedDuplicateForIdentifier:identifier]) return YES;
        return NO;
    }

    CCUILayoutSize size = [self catalogLayoutSizeForIdentifier:identifier];
    NSMutableDictionary<NSString *, NSValue *> *layout = [NSMutableDictionary dictionary];
    for (NSString *existing in gERNativeLayoutRects) {
        // Rects for previously removed modules linger in the native map; only
        // modules that are actually part of Control Center occupy cells.
        if (![present containsObject:existing]) continue;
        CCUILayoutRect rect = {};
        [gERNativeLayoutRects[existing] getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(existing);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *customSize = gERCustomSizes[existing];
        if (customSize.count >= 2) rect.size = (CCUILayoutSize){customSize[0].unsignedIntegerValue, customSize[1].unsignedIntegerValue};
        layout[existing] = [NSValue value:&rect withObjCType:@encode(CCUILayoutRect)];
    }
    CCUILayoutPoint destination = {0, 0};
    // Prefer the page the user is visibly editing. If it is full, the paged
    // allocator spills forward or opens a fresh page instead of silently
    // routing new controls through stale pager state.
    NSUInteger startPage = ERDerivedVisiblePageForOverlay(overlay);
    BOOL found = ERGuaranteedPagedSlot(identifier, size, startPage, layout, &destination);
    if (!found) return NO;

    [gERCustomSizes removeObjectForKey:identifier];
    gERCustomOrigins[identifier] = @[@(destination.x), @(destination.y)];
    gERPendingPageAfterRebuild = destination.y / kERMinimumGridRows;
    CFPreferencesSetAppValue(CFSTR("ModuleGridOrigins"), (__bridge CFPropertyListRef)[gERCustomOrigins copy], kERPrefsDomain);
    CFPreferencesSetAppValue(CFSTR("ModuleGridSizes"), (__bridge CFPropertyListRef)[gERCustomSizes copy], kERPrefsDomain);
    CFPreferencesAppSynchronize(kERPrefsDomain);
    NSMutableArray<NSString *> *updated = [enabled mutableCopy] ?: [NSMutableArray array];
    [updated addObject:identifier];
    [self saveEnabledModuleIdentifiers:updated];
    return YES;
}

// 1.0.6-12（第 2 条）：点击路径异常兜底。
//
// 用户报「点击模块框里会闪退」，但到目前为止拿到的两份日志都不是这条路径 ——
// Spotlight 那份是 com.apple.Spotlight 的 EXC_GUARD，镜像列表里没有任何
// EchoReborn；另一份 Preferences 的 SIGABRT 崩溃点也不在本工程的调用链上。
// 在拿到真堆栈之前先止血：把点击入口整体包起来，抛异常时不再让进程崩掉，而是把
// name / reason / 栈顶符号写进日志 —— 下一次导出日志就能直接定位，不必再靠猜。
static void ERLogCaughtException(NSString *where, NSException *exception) {
    NSString *name = exception.name ?: @"(nil)";
    NSString *reason = exception.reason ?: @"(no reason)";
    NSArray<NSString *> *symbols = exception.callStackSymbols ?: @[];
    NSUInteger count = MIN(symbols.count, (NSUInteger)10);
    NSString *stack = count ? [[symbols subarrayWithRange:NSMakeRange(0, count)] componentsJoinedByString:@" | "] : @"(no symbols)";
    ERLogInfo(@"ERGUARD ver=1.0.9-103 at=%@ name=%@ reason=%@ stack=%@", where, name, reason, stack);
}

// 真正的实现搬到这里，外层只留 @try/@catch。
- (void)erAddControlSheetDidSelectIdentifierCore:(NSString *)identifier fromSheet:(UIViewController *)sheet {
    BOOL added = [self addModuleIdentifierToControlCenter:identifier];
    if (!added) {
        // No legal slot (or already present): leave the sheet as-is for now;
        // multi-page support will give this a real destination later.
        ERLogOperation(@"add", identifier, NO, @"no legal slot");
        UINotificationFeedbackGenerator *feedback = [UINotificationFeedbackGenerator new];
        [feedback notificationOccurred:UINotificationFeedbackTypeWarning];
        if ([sheet isKindOfClass:[ERAddControlSheetViewController class]]) {
            [(ERAddControlSheetViewController *)sheet refreshCatalogFromCoordinator];
        }
        return;
    }
    ERLogOperation(@"add", identifier, YES, @"placed");
    ERHaptic();
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    [sheet.presentingViewController dismissViewControllerAnimated:YES completion:nil];
    (void)overlay;
    [self resettleAfterCollectionRebuild];
}

- (void)addControlSheetDidSelectIdentifier:(NSString *)identifier fromSheet:(UIViewController *)sheet {
    @try {
        [self erAddControlSheetDidSelectIdentifierCore:identifier fromSheet:sheet];
    } @catch (NSException *exception) {
        ERLogCaughtException(@"addControlSheetDidSelectIdentifier", exception);
    }
}

- (BOOL)persistStoredOrderBySwappingSource:(NSString *)sourceID target:(NSString *)targetID {
    NSString *configurationPath = ERModuleConfigurationPath();
    NSDictionary *settings = [NSDictionary dictionaryWithContentsOfFile:configurationPath];
    if (!settings) return NO;
    NSMutableArray *storedOrder = [settings[@"module-identifiers"] mutableCopy];
    NSUInteger sourceIndex = [storedOrder indexOfObject:sourceID];
    NSUInteger targetIndex = [storedOrder indexOfObject:targetID];
    if (sourceIndex == NSNotFound || targetIndex == NSNotFound || sourceIndex == targetIndex) {
        return NO;
    }
    [storedOrder exchangeObjectAtIndex:sourceIndex withObjectAtIndex:targetIndex];
    NSMutableDictionary *updatedSettings = [settings mutableCopy];
    updatedSettings[@"module-identifiers"] = storedOrder;
    // Persist the Settings ordering without invoking the live provider setter.
    // That setter rebuilds the complete CC collection and caused the whole
    // surface to jump immediately after our origin-only layout had settled.
    return [updatedSettings writeToFile:configurationPath atomically:YES];
}

- (void)erRemoveTappedCore:(UIButton *)sender {
    ERHaptic();
    NSString *identifier = objc_getAssociatedObject(sender, @selector(removeTapped:));
    if (!identifier.length) return;
    ERLogOperation(@"remove", identifier, YES, @"begin");
    if (gERDuplicateFamilies[identifier]) {
        [gERDuplicateFamilies removeObjectForKey:identifier];
        [gERCustomOrigins removeObjectForKey:identifier];
        [gERCustomSizes removeObjectForKey:identifier];
        [gERNativeLayoutRects removeObjectForKey:identifier];
        [gERBaseLayoutSizes removeObjectForKey:identifier];
        ERSaveDuplicateFamilies();
        CFPreferencesSetAppValue(CFSTR("ModuleGridOrigins"), (__bridge CFPropertyListRef)[gERCustomOrigins copy], kERPrefsDomain);
        CFPreferencesSetAppValue(CFSTR("ModuleGridSizes"), (__bridge CFPropertyListRef)[gERCustomSizes copy], kERPrefsDomain);
        CFPreferencesAppSynchronize(kERPrefsDomain);
        UIView *moduleView = objc_getAssociatedObject(sender, kERRemoveModuleViewKey);
        UIViewController *module = ERModuleControllerForView(moduleView);
        UIVisualEffectView *border = objc_getAssociatedObject(moduleView, @selector(applyEditingToModule:editing:));
        UIButton *resizeButton = objc_getAssociatedObject(moduleView, kERResizeButtonKey);
        [UIView animateWithDuration:0.22 animations:^{
            moduleView.transform = CGAffineTransformMakeScale(0.86, 0.86);
            moduleView.alpha = 0.0;
            border.alpha = 0.0;
            sender.alpha = 0.0;
            resizeButton.alpha = 0.0;
        } completion:^(__unused BOOL finished) {
            [border removeFromSuperview];
            [sender removeFromSuperview];
            [resizeButton removeFromSuperview];
            [module willMoveToParentViewController:nil];
            [module.view removeFromSuperview];
            [module removeFromParentViewController];
            UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
            if (overlay) {
                [self normalizePagedLayoutForOverlay:overlay];
                if (gEditModeActive) [self setEditPresentation:YES forOverlay:overlay animated:NO];
            }
        }];
        return;
    }
    NSArray *current = [self enabledModuleIdentifiers];
    NSMutableArray *updated = [current mutableCopy];
    [updated removeObject:identifier];
    UIView *moduleView = objc_getAssociatedObject(sender, kERRemoveModuleViewKey);
    CGFloat removalRadius = moduleView.layer.cornerRadius > 1.0 ? moduleView.layer.cornerRadius : MIN(CGRectGetWidth(moduleView.bounds), CGRectGetHeight(moduleView.bounds)) * 0.28;
    moduleView.layer.cornerRadius = removalRadius;
    moduleView.layer.cornerCurve = kCACornerCurveContinuous;
    moduleView.layer.masksToBounds = YES;
    UIVisualEffectView *blur = [[UIVisualEffectView alloc] initWithEffect:nil];
    blur.frame = moduleView.bounds;
    blur.layer.cornerRadius = moduleView.layer.cornerRadius;
    blur.clipsToBounds = YES;
    blur.userInteractionEnabled = NO;
    [moduleView addSubview:blur];
    // The module's edit chrome is owned partly by the wrapper (border) and
    // partly by the overlay root (remove/resize). None of it belongs to the
    // rebuilt hierarchy, so it must leave with the module or it lingers.
    UIVisualEffectView *border = objc_getAssociatedObject(moduleView, @selector(applyEditingToModule:editing:));
    UIButton *resizeButton = objc_getAssociatedObject(moduleView, kERResizeButtonKey);
    [UIView animateWithDuration:0.28 animations:^{
        blur.effect = [UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThinMaterial];
        moduleView.transform = CGAffineTransformMakeScale(0.88, 0.88);
        moduleView.alpha = 0.0;
        border.alpha = 0.0;
        sender.alpha = 0.0;
        resizeButton.alpha = 0.0;
    } completion:^(__unused BOOL finished) {
        [border.layer removeAllAnimations];
        [border removeFromSuperview];
        [sender removeFromSuperview];
        [resizeButton removeFromSuperview];
        objc_setAssociatedObject(moduleView, @selector(applyEditingToModule:editing:), nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(moduleView, kERRemoveButtonKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(moduleView, kERResizeButtonKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [self saveEnabledModuleIdentifiers:updated];
        ERLogOperation(@"remove", identifier, YES, @"saved enabled list");
        [self resettleAfterCollectionRebuild];
    }];
}

- (void)removeTapped:(UIButton *)sender {
    @try {
        [self erRemoveTappedCore:sender];
    } @catch (NSException *exception) {
        ERLogCaughtException(@"removeTapped", exception);
    }
}

- (void)resettleAfterCollectionRebuild {
    // Saving through the settings provider rebuilds the whole collection
    // asynchronously: fresh wrappers arrive without the edit translation, the
    // header pocket (and quick-access host) is replaced, and overlay-rooted
    // controls for dead modules become orphans. Sweep repeatedly as the new
    // hierarchy settles.
    for (NSNumber *delay in @[@0.15, @0.35, @0.65]) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
            if (!overlay) return;
            [self installQuickAccessHostOnOverlay:overlay];
            NSMutableSet<UIView *> *validControls = [NSMutableSet set];
            for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                UIButton *candidateRemove = objc_getAssociatedObject(candidate.view, kERRemoveButtonKey);
                UIButton *candidateResize = objc_getAssociatedObject(candidate.view, kERResizeButtonKey);
                if (candidateRemove) [validControls addObject:candidateRemove];
                if (candidateResize) [validControls addObject:candidateResize];
            }
            for (UIView *subview in [overlay.view.subviews copy]) {
                if ((subview.tag == kERRemoveButtonTag || subview.tag == kERResizeButtonTag) && ![validControls containsObject:subview]) {
                    [subview removeFromSuperview];
                }
            }
            if (!gEditModeActive) return;
            for (UIViewController *candidate in ERCollectModuleControllers(overlay)) [self applyEditingToModule:candidate editing:YES];
            [self setEditPresentation:YES forOverlay:overlay animated:NO];
        });
    }
}

// 0.4.1-1: the 2x4 Now Playing card is the ONE thing this release touches.
//
// The card is a rectangle, so it must not read as a capsule or a pill: iOS 26
// gives it a restrained 22pt continuous curve. The iOS 18 branch keeps the
// 36pt this tweak was originally measured against, so with the liquid glass
// switch off the card — like every other module — is byte-for-byte the 0.4.1
// look.
static CGFloat EROversizedMediaCornerRadius(void) {
    // 1.0.6-12（第 3 条）：这一支以前是 `lgHostEnabled(@"ControlCenter") ? 22.0 : 36.0`，
    // 于是同一块「音乐」模块拖成 4×2 之后，关液态玻璃是 36、开液态玻璃变 22 ——
    // 用户报的「只有打开情况才有问题 / 需要开启液态玻璃也是这样的圆角」正是这一行。
    //
    // 现在两支取同一个值：关闭态本来就是 36（用户给出的参考截图就是这一态），所以
    // 本次修改**只改变开启态**（22 → 36），对关闭态的观感零回归。
    //
    // 1.0.6-13（第 7 条）：36 → 32。
    //
    // 用户实测反馈：「音乐模块和天气模块 4×2，开启液态玻璃下圆角过于圆」。36 是
    // 1.0.6-12 为了让开/关两态一致挑的数，但它比同网格里**每一个**非 1×1 模块都大 ——
    // refinedCornerRadiusForSize 对 2×2（304×304 之外的一切 ≥2×2 尺寸）一律给 32：
    //   2×2 → MIN(32, MAX(22, 151/2-6)) = 32
    //   4×2 → MIN(32, MAX(22, 146/2-6)) = 32
    //   4×4 → MIN(32, MAX(22, 304/2-6)) = 32
    // 于是 4×2 的 36 在一屏 32 的模块里显得格外鼓。降到 32 之后，4×2 / 2×4 / 4×4
    // 与 2×2 取到同一个数，网格里不再有「某一块特别圆」。
    //
    // 这一行仍然是唯一的旋钮：想再收一点就往下调，玻璃侧会因为有同一个真值源自动跟上。
    return 32.0;
}

- (CGFloat)refinedCornerRadiusForSize:(CGSize)size {
    CGFloat width = size.width;
    CGFloat height = size.height;
    CGFloat minimum = MIN(width, height);
    if (minimum <= 0.0) return 0.0;
    BOOL isOneByOne = fabs(width - height) <= 3.0 && minimum <= 76.0;
    return isOneByOne ? minimum * 0.5 : MIN(32.0, MAX(22.0, minimum * 0.5 - 6.0));
}

- (CGFloat)refinedCornerRadiusForModuleView:(UIView *)view {
    return [self refinedCornerRadiusForSize:view.bounds.size];
}

// v0.3.20: iOS 18 reference radius for the oversized Now Playing card only.
// The generic scale gives a 163x304 card 32pt; iOS 18's 2x4 media card reads
// noticeably softer (~36pt continuous curve). Scoped strictly to the Now
// Playing identifier at a 2x4-class footprint, so no other module or footprint
// changes. The exact iOS 18 value is not publicly documented — 36pt is a
// measured approximation against iOS 18 screenshots.
- (BOOL)moduleUsesOversizedMediaRadius:(UIViewController *)module view:(UIView *)view {
    if (![ERModuleIdentifier(module) isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"]) return NO;
    CGFloat w = CGRectGetWidth(view.bounds), h = CGRectGetHeight(view.bounds);
    CGFloat mn = MIN(w, h), mx = MAX(w, h);
    // 1.0.6-12（第 1 条）：命中条件由「长宽比 ≥ 1.6」改成「两边都过了 4 格门槛」。
    //
    // 旧条件把 4×4（304×304，比值 1.0）排除在外：4×4 走 refinedCornerRadiusForSize
    // 得 32，4×2（304×146，比值 2.08）走 EROversizedMediaCornerRadius 得 36。
    // 于是「4×2 圆角改成和 4×4 一样」这个需求从构造上就不可能成立 ——
    // 1.0.6-12 只把开启态的 22 拉到 36，修掉的是开/关分叉，没修掉尺寸分叉。
    //
    // 新条件对 4×2 / 2×4 / 4×4 一律命中，三者同取 EROversizedMediaCornerRadius；
    // 2×2（半宽半高）与 4×1 仍然走通用规则，观感不变。
    return (mn > 120.0 && mx > 200.0);
}

- (CGFloat)editingModuleCornerRadiusForSize:(CGSize)size {
    CGFloat radius = [self refinedCornerRadiusForSize:size];
    CGFloat minimum = MIN(size.width, size.height);
    CGFloat maximum = MAX(size.width, size.height);
    BOOL isRectangularGridModule = minimum > 55.0 && minimum < 82.0 && maximum > 120.0 && maximum < 180.0;
    return isRectangularGridModule ? radius + 4.0 : radius;
}

- (void)configureEditingBorder:(UIVisualEffectView *)border moduleFrame:(CGRect)moduleFrame {
    if (!border) return;
    border.frame = CGRectInset(moduleFrame, -3.5, -3.5);
    CGFloat radius = [self refinedCornerRadiusForSize:moduleFrame.size];
    UIBezierPath *ring = [UIBezierPath bezierPathWithRoundedRect:border.bounds cornerRadius:radius + 3.5];
    [ring appendPath:[UIBezierPath bezierPathWithRoundedRect:CGRectInset(border.bounds, 3.5, 3.5) cornerRadius:radius]];
    CAShapeLayer *mask = [CAShapeLayer layer];
    mask.path = ring.CGPath;
    mask.fillRule = kCAFillRuleEvenOdd;
    border.layer.mask = mask;
}

- (id)labelBlurFilterWithRadius:(CGFloat)radius {
    Class filterClass = NSClassFromString(@"CAFilter");
    SEL factory = NSSelectorFromString(@"filterWithName:");
    if (!filterClass || ![filterClass respondsToSelector:factory]) return nil;
    id filter = ((id (*)(id, SEL, id))objc_msgSend)(filterClass, factory, @"gaussianBlur");
    @try {
        [filter setValue:@"EchoRebornLabelBlur" forKey:@"name"];
        [filter setValue:@(radius) forKey:@"inputRadius"];
        [filter setValue:@YES forKey:@"inputNormalizeEdges"];
    } @catch (__unused NSException *exception) { return nil; }
    return filter;
}

- (void)legacyTransitionResizedPresentation:(UIView *)presentation appearing:(BOOL)appearing completion:(void (^)(void))completion {
    if (!presentation) { if (completion) completion(); return; }
    objc_setAssociatedObject(presentation, kERResizePresentationTransitionKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [presentation.layer removeAnimationForKey:@"EchoRebornLabelBlurRadius"];
    CGFloat startRadius = appearing ? 7.0 : 0.0;
    CGFloat endRadius = appearing ? 0.0 : 7.0;
    id filter = [self labelBlurFilterWithRadius:startRadius];
    presentation.layer.filters = filter ? @[filter] : nil;
    presentation.alpha = appearing ? 0.0 : 1.0;
    NSTimeInterval delay = appearing ? 0.12 : 0.0;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (filter) {
            CABasicAnimation *blur = [CABasicAnimation animationWithKeyPath:@"filters.EchoRebornLabelBlur.inputRadius"];
            blur.fromValue = @(startRadius);
            blur.toValue = @(endRadius);
            blur.duration = 0.18;
            blur.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
            @try { [filter setValue:@(endRadius) forKey:@"inputRadius"]; } @catch (__unused NSException *exception) {}
            [presentation.layer addAnimation:blur forKey:@"EchoRebornLabelBlurRadius"];
        }
        [UIView animateWithDuration:0.18 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
            presentation.alpha = appearing ? 1.0 : 0.0;
        } completion:^(__unused BOOL finished) {
            presentation.layer.filters = nil;
            objc_setAssociatedObject(presentation, kERResizePresentationTransitionKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            if (completion) completion();
        }];
    });
}

- (UIImage *)snapshotForPresentation:(UIView *)presentation {
    if (!presentation || CGRectIsEmpty(presentation.bounds)) return nil;
    CGFloat savedAlpha = presentation.alpha;
    [UIView performWithoutAnimation:^{ presentation.alpha = 1.0; }];
    UIGraphicsBeginImageContextWithOptions(presentation.bounds.size, NO, UIScreen.mainScreen.scale);
    [presentation.layer renderInContext:UIGraphicsGetCurrentContext()];
    UIImage *source = UIGraphicsGetImageFromCurrentImageContext();
    UIGraphicsEndImageContext();
    [UIView performWithoutAnimation:^{ presentation.alpha = savedAlpha; }];
    return source;
}

- (UIImage *)blurredImageFromImage:(UIImage *)source {
    if (!source.CGImage) return nil;
    CIImage *input = [[CIImage alloc] initWithCGImage:source.CGImage];
    CIFilter *blur = [CIFilter filterWithName:@"CIGaussianBlur"];
    [blur setValue:input forKey:kCIInputImageKey];
    [blur setValue:@3.25 forKey:kCIInputRadiusKey];
    CIImage *output = [blur.outputImage imageByCroppingToRect:input.extent];
    static CIContext *context;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{ context = [CIContext contextWithOptions:@{kCIContextUseSoftwareRenderer: @NO}]; });
    CGImageRef imageRef = [context createCGImage:output fromRect:input.extent];
    if (!imageRef) return nil;
    UIImage *result = [UIImage imageWithCGImage:imageRef scale:source.scale orientation:UIImageOrientationUp];
    CGImageRelease(imageRef);
    return result;
}

- (UIImage *)blurredSnapshotForPresentation:(UIView *)presentation {
    return [self blurredImageFromImage:[self snapshotForPresentation:presentation]];
}

- (void)transitionResizedPresentation:(UIView *)presentation
                             appearing:(BOOL)appearing
                    outgoingSharpImage:(UIImage *)outgoingSharpImage
                         outgoingImage:(UIImage *)outgoingImage
                         outgoingFrame:(CGRect)outgoingFrame
                            completion:(void (^)(void))completion {
    if (!presentation || !presentation.superview) { if (completion) completion(); return; }
    (void)outgoingSharpImage;
    (void)outgoingImage;
    (void)outgoingFrame;
    NSObject *token = [NSObject new];
    objc_setAssociatedObject(presentation, kERResizePresentationTransitionKey, token, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    for (UIView *view in [presentation.superview.subviews copy]) if (view.tag == kERResizeBlurSnapshotTag) [view removeFromSuperview];

    // Snapshot crossfades briefly rendered both label endpoints. During live
    // resize that read as a third, floating label. Keep the content at its
    // snapped endpoint and animate only its visibility.
    [presentation.layer removeAllAnimations];
    presentation.alpha = appearing ? 0.0 : 1.0;
    [UIView animateWithDuration:0.16 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
        presentation.alpha = appearing ? 1.0 : 0.0;
    } completion:^(__unused BOOL finished) {
        if (objc_getAssociatedObject(presentation, kERResizePresentationTransitionKey) != token) return;
        objc_setAssociatedObject(presentation, kERResizePresentationTransitionKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (completion) completion();
    }];
}

- (void)applyResizedPresentationToModule:(UIViewController *)module {
    UIView *moduleView = module.view;
    if (ERShortcutIdentifierIsShortcut(ERModuleIdentifier(module)) &&
        ERShortcutSlotIndexFromIdentifier(ERModuleIdentifier(module))) {
        // 槽位是真实控制中心模块，磁贴完全由 bundle 画在系统模块背景上；本插件在这里
        // 不允许再加任何东西 —— 不加材质板、不加自绘呈现、不加第二个图标。
        return;
    }
    // 单击震动（0.5.8）：把观察型 tap 装在磁贴外框（CCUIContentModuleContainerView）上。
    // 它是磁贴内容的祖先，命中点无论落在模块内容还是按钮 chrome 上都会经过它，因此一定
    // 能收到触摸。安装点放在本方法里——它对所有模块都会被调到（由
    // -applyRefinedLookToModule: 及各处刷新的循环驱动），不依赖某个具体 hook 类名是否
    // 真的匹配到实机。宿主只装一次，重复调用无副作用。
    {
        UIView *feedbackHost = moduleView;
        for (UIView *ancestor = moduleView; ancestor; ancestor = ancestor.superview) {
            if ([NSStringFromClass(ancestor.class) isEqualToString:@"CCUIContentModuleContainerView"]) {
                feedbackHost = ancestor;
                break;
            }
        }
        ERInstallModuleTapFeedback(feedbackHost);
    }
    NSString *identifier = ERModuleIdentifier(module);
    if ([identifier.lowercaseString containsString:@"echoreborn.connectivity"]) {
        ERConfigureOddResizedModuleLayout(module);
        return;
    }
    NSArray<NSNumber *> *customSize = gERCustomSizes[identifier];
    CCUILayoutSize base = {};
    [gERBaseLayoutSizes[identifier] getValue:&base];
    UIView *buttonView = ERFindSubviewWithClassName(moduleView, @"CCUIButtonModuleView");
    if (!buttonView) return;
    NSArray<NSNumber *> *previewSize = objc_getAssociatedObject(buttonView, kERResizePresentationSizeOverrideKey);
    NSArray<NSNumber *> *effectiveSize = previewSize.count >= 2 ? previewSize : customSize;
    BOOL isNativeCompactButton = base.width == 1 && base.height == 1;
    BOOL presentsAsWideButton = isNativeCompactButton && effectiveSize.count >= 2 && effectiveSize[0].unsignedIntegerValue == 2 && effectiveSize[1].unsignedIntegerValue == 1;
    BOOL presentsAsLargeButton = isNativeCompactButton && effectiveSize.count >= 2 && effectiveSize[0].unsignedIntegerValue == 2 && effectiveSize[1].unsignedIntegerValue == 2;
    BOOL presentsExpandedButton = presentsAsWideButton || presentsAsLargeButton;
    BOOL isPowerModule = [identifier isEqualToString:@"com.mtac.ccpowermenu"];

    UIView *presentation = [buttonView viewWithTag:kERResizePresentationTag];
    if (ERModuleLooksExpandedNow(module)) {
        // The compact labels are EchoReborn-owned and must not be copied into the
        // system detail platter. Keep the source view intact, but suppress its
        // adornment for the live expanded hierarchy.
        presentation.hidden = YES;
        presentation.alpha = 0.0;
        return;
    }
    presentation.hidden = NO;
    // Un-hide path for overlays suppressed while their module was expanded;
    // skip while a fade transition owns the alpha.
    if (presentation && !gERExpandedModuleOpen && presentation.alpha < 0.999 &&
        !objc_getAssociatedObject(presentation, kERResizePresentationTransitionKey)) {
        presentation.alpha = 1.0;
    }
    if (isPowerModule) {
        for (UIView *glyph in ERCompactGlyphHosts(buttonView)) {
            glyph.hidden = YES;
            glyph.alpha = 0.0;
            glyph.layer.opacity = 0.0;
        }
        NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:moduleView];
        while (queue.count) {
            UIView *candidate = queue.firstObject;
            [queue removeObjectAtIndex:0];
            if ([candidate isKindOfClass:[UIActivityIndicatorView class]]) {
                candidate.hidden = YES;
                candidate.alpha = 0.0;
            }
            [queue addObjectsFromArray:candidate.subviews];
        }
        presentation = EREnsureOwnedCompactPresentation(buttonView);
        CCUILayoutSize size = EREffectiveCustomSizeForModule(module, identifier);
        ERLayoutOwnedCompactPresentation(presentation, @"power", @"Power", nil, size, NO);
        [buttonView bringSubviewToFront:presentation];
        return;
    }
    // A 1x1 tile that is still presented at its own native 1x1 footprint keeps
    // Control Center's own glyph geometry. Re-pinning the glyph to the cell
    // origin in that case desynced it from the module's own layout pass, which
    // re-centres it right afterwards — the two writers disagreed and the tile
    // came out visibly offset (and stayed that way while edit chrome breathed).
    BOOL keepsNativeCompactGeometry = isNativeCompactButton &&
        (!effectiveSize.count || (effectiveSize[0].unsignedIntegerValue == 1 && effectiveSize[1].unsignedIntegerValue == 1));
    if (isNativeCompactButton && !keepsNativeCompactGeometry) {
        // Shortcut-style modules do not all use the same glyph class:
        // Calculator uses an image host, while Flashlight and several system
        // controls use a CAPackage host. Anchor whichever host is active to
        // the same visual point for every supported size.
        // Always merge direct hosts with the KVC-discovered host. Some modules
        // retain separate active/inactive image views; stopping after the first
        // match left the other view carrying the old -42pt translation.
        NSArray<UIView *> *glyphHosts = ERCompactGlyphHosts(buttonView);
        // The platter grows around the compact control; its glyph does not
        // travel between 1x1, 2x1, and 2x2 presentations.
        CGPoint target = CGPointMake(kERGridCellSize * 0.5, kERGridCellSize * 0.5);
        for (UIView *glyph in glyphHosts) {
            [UIView performWithoutAnimation:^{
                [CATransaction begin];
                [CATransaction setDisableActions:YES];
                if (gERResizeInProgress) {
                    [glyph.layer removeAnimationForKey:@"position"];
                    [glyph.layer removeAnimationForKey:@"bounds"];
                    [glyph.layer removeAnimationForKey:@"transform"];
                }
                // Several shortcut modules expose a module-sized image/package
                // container through the same KVC keys as their actual glyph.
                // Keep that container at the original compact footprint so its
                // own centered artwork remains at the 1x1 visual coordinate.
                if (CGRectGetWidth(glyph.bounds) > 72.0 || CGRectGetHeight(glyph.bounds) > 72.0) {
                    CGPoint compactOrigin = [buttonView convertPoint:CGPointZero toView:glyph.superview];
                    glyph.layer.transform = CATransform3DIdentity;
                    glyph.frame = (CGRect){compactOrigin, CGSizeMake(kERGridCellSize, kERGridCellSize)};
                } else {
                    // Centering and translating the same image host displaced it
                    // by a second 42pt step in older builds. One fixed center is
                    // the sole geometry writer for glyph-sized views.
                    glyph.layer.transform = CATransform3DIdentity;
                    glyph.center = [buttonView convertPoint:target toView:glyph.superview];
                }
                if (gERResizeInProgress) {
                    [glyph.layer removeAnimationForKey:@"position"];
                    [glyph.layer removeAnimationForKey:@"bounds"];
                    [glyph.layer removeAnimationForKey:@"transform"];
                }
                [CATransaction commit];
            }];
        }
    }
    if (!presentsExpandedButton) {
        if (presentation) objc_setAssociatedObject(presentation, kERResizePresentationLayoutKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
        if (presentation && !objc_getAssociatedObject(presentation, kERResizePresentationTransitionKey)) {
            [self transitionResizedPresentation:presentation appearing:NO outgoingSharpImage:nil outgoingImage:nil outgoingFrame:CGRectZero completion:^{ [presentation removeFromSuperview]; }];
        }
        return;
    }

    BOOL createdPresentation = NO;
    if (!presentation) {
        presentation = [[UIView alloc] initWithFrame:buttonView.bounds];
        presentation.tag = kERResizePresentationTag;
        // Never expose the newly created labels for a frame before their
        // blurred reveal owns the transition.
        presentation.alpha = 0.0;
        presentation.userInteractionEnabled = NO;
        presentation.backgroundColor = UIColor.clearColor;
        presentation.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        presentation.clipsToBounds = YES;

        UILabel *title = [[UILabel alloc] initWithFrame:CGRectZero];
        title.tag = 1;
        title.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightSemibold];
        title.numberOfLines = 2;
        title.lineBreakMode = NSLineBreakByTruncatingTail;
        [presentation addSubview:title];

        UILabel *status = [[UILabel alloc] initWithFrame:CGRectZero];
        status.tag = 2;
        status.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightRegular];
        status.adjustsFontSizeToFitWidth = YES;
        status.minimumScaleFactor = 0.78;
        [presentation addSubview:status];
        [buttonView addSubview:presentation];
        createdPresentation = YES;
    }
    UILabel *title = (UILabel *)[presentation viewWithTag:1];
    UILabel *status = (UILabel *)[presentation viewWithTag:2];
    UIImageView *ownedGlyph = (UIImageView *)[presentation viewWithTag:kERResizePresentationGlyphTag];
    NSString *layoutMode = presentsAsLargeButton ? @"large" : @"wide";
    NSString *previousLayoutMode = objc_getAssociatedObject(presentation, kERResizePresentationLayoutKey);
    BOOL snappedLayoutChanged = previousLayoutMode.length && ![previousLayoutMode isEqualToString:layoutMode];
    if (snappedLayoutChanged) [UIView performWithoutAnimation:^{ presentation.alpha = 0.0; }];

    NSString *moduleLabel = buttonView.accessibilityLabel;
    NSString *lowerIdentifier = identifier.lowercaseString;
    BOOL isMuteModule = [lowerIdentifier containsString:@"mutemodule"];
    BOOL isOrientationModule = [lowerIdentifier containsString:@"orientationlock"];
    BOOL isFlashlightModule = [lowerIdentifier containsString:@"flashlightmodule"];
    BOOL isERConnectivityModule = [lowerIdentifier containsString:@"echoreborn.connectivity"];
    if (isMuteModule) moduleLabel = @"Silent Mode";
    else if (isOrientationModule) moduleLabel = @"Orientation";
    else if (isERConnectivityModule) moduleLabel = ERFriendlyNameForIdentifier(identifier) ?: moduleLabel;
    BOOL hasGenericLabel = !moduleLabel.length ||
        [moduleLabel caseInsensitiveCompare:@"Control"] == NSOrderedSame ||
        [moduleLabel caseInsensitiveCompare:@"Button"] == NSOrderedSame;
    if (hasGenericLabel) {
        NSString *stableLabel = ERFriendlyNameForIdentifier(identifier);
        if (!stableLabel.length && identifier.length) stableLabel = ERPrettyNameForIdentifier(identifier);
        if (stableLabel.length) moduleLabel = stableLabel;
    }
    if (!moduleLabel.length) moduleLabel = @"Control";
    NSString *rawValue = buttonView.accessibilityValue;
    BOOL hasBooleanState = [rawValue isEqualToString:@"0"] || [rawValue isEqualToString:@"1"] ||
        isMuteModule || isOrientationModule || isFlashlightModule;
    BOOL enabled = hasBooleanState && [(UIControl *)buttonView isSelected];
    NSString *statusText = nil;
    if (isERConnectivityModule) statusText = ERConnectivityStatusForIdentifier(identifier);
    else if (isMuteModule) statusText = enabled ? @"Vibrate" : @"Ring";
    else if (isOrientationModule) statusText = enabled ? @"Locked" : @"Unlocked";
    else if (hasBooleanState) statusText = enabled ? @"On" : @"Off";
    else if (rawValue.length &&
             [rawValue caseInsensitiveCompare:@"Ready"] != NSOrderedSame &&
             [rawValue caseInsensitiveCompare:@"Open"] != NSOrderedSame) statusText = rawValue;
    UIColor *primaryColor = enabled ? [UIColor colorWithWhite:0.08 alpha:0.92] : UIColor.whiteColor;
    UIColor *secondaryColor = enabled ? [UIColor colorWithWhite:0.18 alpha:0.72] : [UIColor.whiteColor colorWithAlphaComponent:0.62];
    title.text = moduleLabel;
    title.textColor = primaryColor;
    status.text = statusText;
    status.textColor = secondaryColor;
    CGFloat twoCellSize = kERGridCellSize * 2.0 + kERGridGap;
    CGSize logicalSize = presentsAsLargeButton ? CGSizeMake(twoCellSize, twoCellSize) : CGSizeMake(twoCellSize, kERGridCellSize);
    CGFloat textX = presentsAsLargeButton ? 21.0 : 71.0;
    CGFloat textWidth = presentsAsLargeButton ? MAX(0.0, logicalSize.width - textX - 24.0) : MAX(0.0, logicalSize.width - 83.0);
    CGFloat lineHeight = 14.3333;
    CGRect measuredTitle = [moduleLabel boundingRectWithSize:CGSizeMake(textWidth, lineHeight * 2.0)
                                                     options:NSStringDrawingUsesLineFragmentOrigin | NSStringDrawingUsesFontLeading
                                                  attributes:@{NSFontAttributeName: title.font}
                                                     context:nil];
    CGFloat titleHeight = measuredTitle.size.height > lineHeight + 1.0 ? lineHeight * 2.0 : lineHeight;
    BOOL showsStatus = statusText.length > 0;
    CGFloat groupHeight = titleHeight + (showsStatus ? lineHeight : 0.0);
    CGFloat groupTop = presentsAsLargeButton ? logicalSize.height - 17.3333 - groupHeight : (logicalSize.height - groupHeight) * 0.5;
    [UIView performWithoutAnimation:^{
        presentation.frame = (CGRect){CGPointZero, logicalSize};
        title.frame = CGRectMake(textX, groupTop, textWidth, titleHeight);
        status.frame = CGRectMake(textX, groupTop + titleHeight, textWidth, lineHeight);
        status.hidden = !showsStatus;
        title.textAlignment = NSTextAlignmentLeft;
        status.textAlignment = NSTextAlignmentLeft;
        if (isPowerModule) {
            UIImageView *glyph = EREnsureResizePresentationGlyph(presentation, @"power");
            glyph.frame = CGRectMake(0.0, 0.0, kERGridCellSize, kERGridCellSize);
            [presentation bringSubviewToFront:glyph];
        } else if (ownedGlyph) {
            ownedGlyph.hidden = YES;
        }
    }];
    objc_setAssociatedObject(presentation, kERResizePresentationLayoutKey, layoutMode, OBJC_ASSOCIATION_COPY_NONATOMIC);
    [buttonView bringSubviewToFront:presentation];
    if (createdPresentation || snappedLayoutChanged) {
        [self transitionResizedPresentation:presentation appearing:YES outgoingSharpImage:nil outgoingImage:nil outgoingFrame:CGRectZero completion:nil];
    }
}

#pragma mark - on-device diagnostic (0.3.17, removable)

static void ERDiagAppend(NSString *line) {
    @try {
        NSString *path = @"/var/mobile/Documents/er_diag.txt";
        NSFileManager *fm = [NSFileManager defaultManager];
        if ([fm fileExistsAtPath:path]) {
            NSDictionary *attrs = [fm attributesOfItemAtPath:path error:nil];
            if (attrs && [attrs fileSize] > 200000) [fm removeItemAtPath:path error:nil];
        }
        NSString *existing = [fm fileExistsAtPath:path] ? [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:nil] : @"";
        NSString *out = [existing stringByAppendingFormat:@"%@\n", line];
        [out writeToFile:path atomically:NO encoding:NSUTF8StringEncoding error:nil];
    } @catch (__unused NSException *e) {}
}

// Logs the connectivity module's real runtime hierarchy so we can confirm
// whether liquidass's CCUIContentModuleContainerView hooks actually fire.
static void ERDiagConnectivityModule(UIViewController *module) {
    @try {
        UIView *v = module.view;
        if (!v) return;
        NSMutableString *chain = [NSMutableString string];
        for (UIView *c = v; c; c = c.superview) [chain appendFormat:@"%@>", NSStringFromClass(c.class)];
        BOOL inMod = NO;
        for (UIView *c = v; c; c = c.superview)
            if ([NSStringFromClass(c.class) isEqualToString:@"CCUIContentModuleContainerView"]) { inMod = YES; break; }
        BOOL hasMT = NO; BOOL hasUIVisual = NO;
        NSMutableArray *q = [NSMutableArray arrayWithObject:v];
        while (q.count) {
            UIView *n = q.firstObject; [q removeObjectAtIndex:0];
            NSString *cn = NSStringFromClass(n.class);
            if ([cn isEqualToString:@"MTMaterialView"]) hasMT = YES;
            if ([cn isEqualToString:@"UIVisualEffectView"]) hasUIVisual = YES;
            [q addObjectsFromArray:n.subviews];
        }
        ERDiagAppend([NSString stringWithFormat:
            @"CONN id=%@ inModule=%d hasMTMaterialView=%d hasUIVisualEffectView=%d chain=%@ bounds=%@",
            ERModuleIdentifier(module), inMod, hasMT, hasUIVisual, chain, NSStringFromCGRect(v.bounds)]);
    } @catch (__unused NSException *e) {}
}

// Edit-mode diagnostic (0.3.18, removable). Dumps the exact runtime geometry
// of one owned connectivity presentation so the reported "编辑态 1×1 只显示
// 大约三分之一" can be attributed to a real frame instead of guessed at:
// module bounds/transform, wrapper bounds/transform, the presentation frame
// and its clipping flag, the glyph frame and its image's intrinsic size, and
// the Bluetooth package frame when present.
static void ERDiagEditConnectivityModule(UIViewController *module) {
    @try {
        UIView *mv = module.view;
        if (!mv) return;
        NSString *identifier = ERModuleIdentifier(module);
        UIView *wrapper = mv.superview;
        UIView *presentation = [mv viewWithTag:kERResizePresentationTag];
        UIImageView *glyph = (UIImageView *)[mv viewWithTag:kERResizePresentationGlyphTag];
        UIView *packageGlyph = [mv viewWithTag:kERConnectivityBluetoothPackageGlyphTag];
        CGAffineTransform mt = mv.transform;
        CGAffineTransform wt = wrapper ? wrapper.transform : CGAffineTransformIdentity;
        CGSize glyphImage = glyph.image ? glyph.image.size : CGSizeZero;
        CCUILayoutSize gridSize = EREffectiveCustomSizeForModule(module, identifier);
        // v0.3.19 additions: the 0.3.18 log proved the owned presentation is
        // geometrically correct, so the remaining suspects are the backdrop
        // layers. Dump the ancestor chain (does a CCUIContentModuleContainerView
        // even wrap the duplicate view?), the native MTMaterialView count (does
        // the glass-target clone have a source at all?), and the platter /
        // glass-target geometry wherever they actually live.
        NSMutableString *chain = [NSMutableString string];
        for (UIView *c = mv; c; c = c.superview) [chain appendFormat:@"%@>", NSStringFromClass(c.class)];
        NSUInteger mtCount = 0;
        NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:mv];
        while (queue.count) {
            UIView *n = queue.firstObject; [queue removeObjectAtIndex:0];
            if ([NSStringFromClass(n.class) isEqualToString:@"MTMaterialView"]) mtCount++;
            [queue addObjectsFromArray:n.subviews];
        }
        UIView *platterView = [mv viewWithTag:kERConnectivityTileMaterialTag];
        UIView *glassView = nil;
        for (UIView *a = mv; a && !glassView; a = a.superview) glassView = [a viewWithTag:kERConnectivityTileGlassTag];
        ERDiagAppend([NSString stringWithFormat:
            @"EDITMODE mode=%d id=%@ grid=%lux%lu mvBounds=%@ mvT=[%.3f %.3f %.1f %.1f] wrapBounds=%@ wrapT=[%.3f %.3f %.1f %.1f] presFrame=%@ presClip=%d presHidden=%d presAlpha=%.2f glyphFrame=%@ glyphImg=%@ glyphHidden=%d pkgFrame=%@ chain=%@ hasMT=%lu platterFrame=%@ glassFrame=%@ glassSuper=%@",
            gEditModeActive ? 1 : 0,
            identifier,
            (unsigned long)gridSize.width, (unsigned long)gridSize.height,
            NSStringFromCGRect(mv.bounds),
            mt.a, mt.d, mt.tx, mt.ty,
            wrapper ? NSStringFromCGRect(wrapper.bounds) : @"nil",
            wt.a, wt.d, wt.tx, wt.ty,
            presentation ? NSStringFromCGRect(presentation.frame) : @"nil",
            presentation ? (presentation.clipsToBounds ? 1 : 0) : -1,
            presentation ? (presentation.hidden ? 1 : 0) : -1,
            presentation ? presentation.alpha : -1.0,
            glyph ? NSStringFromCGRect(glyph.frame) : @"nil",
            NSStringFromCGSize(glyphImage),
            glyph ? (glyph.hidden ? 1 : 0) : -1,
            packageGlyph ? NSStringFromCGRect(packageGlyph.frame) : @"nil",
            chain,
            (unsigned long)mtCount,
            platterView ? NSStringFromCGRect(platterView.frame) : @"nil",
            glassView ? NSStringFromCGRect(glassView.frame) : @"nil",
            glassView ? NSStringFromClass(glassView.superview.class) : @"nil"]);
    } @catch (__unused NSException *e) {}
}

// 单击震动（0.5.8）。
//
// 这是观察型 tap 的目标，也是它的 delegate（见 ERInstallModuleTapFeedback）。
// 它只做一件事：用户点了某个基础 1×1 模块（手电筒、计时器……）时给一次触感反馈。
//
// 关于日志：TAPHAPTIC 放在最前面、在任何判断之前。0.5.7 把它放在函数末尾，于是
// 「识别器根本没触发」和「触发了但被后面的条件挡掉」在日志里长得一模一样，无法区分；
// 这也是上一轮排查被卡住的原因之一。TAPHAPTIC-OK 表示这一次真的震了。
- (void)erModuleTapFiredCore:(UITapGestureRecognizer *)gesture {
    UIView *host = gesture.view;
    if (!host) return;
    UIViewController *module = ERModuleControllerForView(host);
    if (!module) {
        // 命中点落在磁贴外框上时，responder 链未必直接给出模块控制器；用可见几何
        // 兜一次，把「点到了哪块磁贴」确定下来。
        CGPoint point = [gesture locationInView:host];
        for (UIViewController *overlay in gOverlayControllers.allObjects) {
            for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                UIView *view = candidate.view;
                if (!view || view.hidden || view.alpha <= 0.01) continue;
                CGRect frame = [view convertRect:view.bounds toView:host];
                if (CGRectContainsPoint(frame, point)) { module = candidate; break; }
            }
            if (module) break;
        }
    }
    NSString *identifier = module ? ERModuleIdentifier(module) : nil;
    ERLogInfo(@"TAPHAPTIC ver=1.0.9-103 id=%@", identifier ?: @"(nil)");
    if (!gHapticsEnabled || !identifier.length) return;
    // 编辑态 / 已有模块展开 / 拖拽与改尺寸进行中，都不算「点一个普通模块」。
    if (gEditModeActive || gERExpandedModuleOpen || gERDragInProgress || gERResizeInProgress) return;
    // 排除系统自带长按震动的四类：音乐 / 连接（含七个 echoreborn.connectivity）/ 亮度 / 声音，
    // 避免一次手势两次震动。
    if ([identifier.lowercaseString containsString:@"echoreborn.connectivity"]) return;
    if ([identifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"]) return;
    if ([identifier isEqualToString:@"com.apple.control-center.ConnectivityModule"]) return;
    if ([identifier isEqualToString:@"com.apple.control-center.DisplayModule"]) return;
    if ([identifier isEqualToString:@"com.apple.mediaremote.controlcenter.audio"]) return;
    // 只对基础 1×1 方块模块（手电筒、计时器等）给单击震动。优先用 EchoReborn 的可调整
    // 尺寸表；该表尚未填好时用磁贴当前占位兜底，避免因布局顺序而静默失效。
    BOOL supported = [self moduleIdentifierSupportsResizing:identifier];
    if (!supported && module) {
        CCUILayoutSize size = EREffectiveCustomSizeForModule(module, identifier);
        supported = (size.width == 1 && size.height == 1);
    }
    if (!supported) return;
    NSInteger strength = ERHapticCurrentStrength();
    ERHapticWithStrength(strength);
    ERLogInfo(@"TAPHAPTIC-OK ver=1.0.9-103 id=%@ strength=%ld", identifier, (long)strength);
}

// 观察型 tap 的目标与 delegate 仍挂在这个选择器上（见 ERInstallModuleTapFeedback），
// 真正的实现搬到 erModuleTapFiredCore:，这里只留 @try/@catch。
- (void)erModuleTapFired:(UITapGestureRecognizer *)gesture {
    @try {
        [self erModuleTapFiredCore:gesture];
    } @catch (NSException *exception) {
        ERLogCaughtException(@"erModuleTapFired", exception);
    }
}

- (void)applyRefinedLookToModule:(UIViewController *)module {
    UIView *view = module.view;
    if (!view) return;
    if (!objc_getAssociatedObject(view, kEROriginalCornerRadiusKey)) {
        objc_setAssociatedObject(view, kEROriginalCornerRadiusKey, @(view.layer.cornerRadius), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(view, kEROriginalMasksToBoundsKey, @(view.layer.masksToBounds), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (gEnabled) {
        // Connectivity tiles are owned by liquidass: it rounds the
        // CCUIContentModuleContainerView (roundModuleContainer) and glasses the
        // MTMaterialView we inject. EchoReborn must NOT overwrite that radius, or
        // the tiles keep EchoReborn's smaller radius and never match the rest of
        // Control Center. We only keep the continuous curve + clipping; liquidass
        // sets the actual radius.
        BOOL isConnectivityModule = [[ERModuleIdentifier(module) lowercaseString] containsString:@"echoreborn.connectivity"];
        if (isConnectivityModule) {
            view.layer.cornerCurve = kCACornerCurveContinuous;
            view.layer.masksToBounds = YES;
        } else {
            CGFloat refined = [self refinedCornerRadiusForModuleView:view];
            if ([self moduleUsesOversizedMediaRadius:module view:view]) refined = EROversizedMediaCornerRadius();
            view.layer.cornerRadius = refined;
            view.layer.cornerCurve = kCACornerCurveContinuous;
            view.layer.masksToBounds = YES;
        }
    } else {
        view.layer.cornerRadius = [objc_getAssociatedObject(view, kEROriginalCornerRadiusKey) doubleValue];
        view.layer.masksToBounds = [objc_getAssociatedObject(view, kEROriginalMasksToBoundsKey) boolValue];
    }
    [self applyResizedPresentationToModule:module];
    ERConfigureOddResizedModuleLayout(module);
    // Connectivity's individual button controllers lay themselves out after
    // their container. Re-apply the compact iOS 18 arrangement from EchoReborn's
    // stable module refresh path as well as the controller hook below.
    UIViewController *connectivity = ERConnectivityChild(module, @"CCUIConnectivityModuleViewController");
    if ([NSStringFromClass(module.class) isEqualToString:@"CCUIConnectivityModuleViewController"]) connectivity = module;
    if (connectivity) {
        ERConfigureConnectivityLayout(connectivity);
        ERDiagConnectivityModule(module);
    }
}

- (void)applyTransitionRadiusToModule:(UIViewController *)module {
    if (!gEnabled || !module.view) return;
    UIView *moduleView = module.view;
    // 1.0.6-12（第 1 / 2 / 4 条）：连通性磁贴的圆角不归本函数管，直接让路。
    //
    // 与 -applyRefinedLookToModule: 里既有的同一条规则一致：七个连通性磁贴的圆角由
    // liquidass 拥有（它给 CCUIContentModuleContainerView 做圆角、给 EchoReborn 注入的
    // MTMaterialView 装玻璃）。本函数若一并改写，两边就会互相覆盖 —— 实机 OFFBGFIX
    // 日志（EchoReborn-log-20260917-003524）里同一个模块的 tileR 在
    //
    //     00:33:59.472 tileR=35.5 / .478 tileR=31.5 / .485 tileR=35.5 / .493 tileR=31.5 ...
    //
    // 以约 30ms 周期**无限来回跳**（wifi / airdrop / bluetooth / vpn 四个模块各 27+28 次），
    // 一次会话里单是这一项就落了 212 行日志、并把 layout 推到 27.6ms。
    //
    // 跳变的两个值分别来自两条算术：35.5 = refinedCornerRadiusForSize(71×71)（近正方形
    // 分支，min*0.5），31.5 = refinedCornerRadiusForSize(163×75)（矩形分支，min*0.5-6）。
    // 同一块磁贴的 bounds 在两次布局之间被当成两种尺寸，圆角就永远收敛不了：
    //   · 白色选中底（ERSetConnectivitySelectedSurface）的圆角取自 moduleView.layer.cornerRadius，
    //     随之错位 —— 四角「超出一点」正是这么来的（第 2 条）；
    //   · 承载玻璃的 MTMaterialView 类名含 "Material"，圆角被一并改写，而玻璃自身仍是
    //     ERGlassPillRadius 的 37.5 —— 材质与玻璃的圆角边线对不上，背景因此「还是有问题」
    //     （第 1 条）。
    if ([[ERModuleIdentifier(module) lowercaseString] containsString:@"echoreborn.connectivity"]) return;
    CGFloat radius = [self refinedCornerRadiusForModuleView:moduleView];
    if ([self moduleUsesOversizedMediaRadius:module view:moduleView]) radius = EROversizedMediaCornerRadius();
    // The platter-return animation targets the container's stored compact
    // radius. Seed it with the refined value so modules come home at the
    // tweaked radius instead of settling native and snapping afterwards.
    UIView *contentContainer = ERFindAncestorOrSubviewWithClassName(moduleView, @"CCUIContentModuleContentContainerView");
    ERSetContinuousCornerRadiusIvar(contentContainer, @"_compactContinuousCornerRadius", radius);
    ERSetContinuousCornerRadiusIvar(contentContainer, @"_expandedContinuousCornerRadius", radius);
    @try { [contentContainer setValue:@(radius) forKey:@"compactContinuousCornerRadius"]; } @catch (__unused NSException *exception) {}
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:moduleView];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        NSString *name = NSStringFromClass(candidate.class);
        BOOL buttonSurface = [name isEqualToString:@"CCUIButtonModuleView"];
        BOOL materialSurface = [name containsString:@"Material"] || [name containsString:@"VisualEffect"] || [name containsString:@"Platter"];
        BOOL fillsModule = fabs(CGRectGetWidth(candidate.bounds) - CGRectGetWidth(moduleView.bounds)) < 3.0 &&
                           fabs(CGRectGetHeight(candidate.bounds) - CGRectGetHeight(moduleView.bounds)) < 3.0;
        if (candidate == moduleView || buttonSurface || (materialSurface && fillsModule)) {
            // 1.0.6-12（第 4 条）：只在圆角真的变化时才赋值。
            //
            // 本函数在 layout / 展开 / 收回路径上被反复调用（一次收回就有 1 + 8 轮全量扫描），
            // 每一轮都会遍历整棵子树。无条件逐层赋值会让 CALayer 判定「几何已变」并重新
            // 生成圆角遮罩、重新提交渲染事务 —— 日志里 layout 交替出现 6ms / 20ms 的锯齿
            // 就是这个开销。改成差量写入后，稳态下这些写入全部变成空操作。
            if (fabs(candidate.layer.cornerRadius - radius) > 0.01) {
                candidate.layer.cornerRadius = radius;
            }
            candidate.layer.cornerCurve = kCACornerCurveContinuous;
            if (candidate == moduleView && !candidate.layer.masksToBounds) candidate.layer.masksToBounds = YES;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

- (void)applyClosingCompactRadiusToModule:(UIViewController *)module overlay:(UIViewController *)overlay sourceObject:(id)object {
    if (!gEnabled || !module.view) return;
    NSString *identifier = [ERModuleIdentifier(module) copy] ?: [ERIdentifierFromObject(object) copy];
    UIViewController *compactModule = nil;
    if (identifier.length) {
        for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
            if ([ERModuleIdentifier(candidate) isEqualToString:identifier] &&
                CGRectGetWidth(candidate.view.bounds) < 190.0 &&
                CGRectGetHeight(candidate.view.bounds) < 190.0) {
                compactModule = candidate;
                break;
            }
        }
    }
    CCUILayoutSize layoutSize = identifier.length ? [self catalogLayoutSizeForIdentifier:identifier] : (CCUILayoutSize){1, 1};
    NSArray<NSNumber *> *customSize = identifier.length ? gERCustomSizes[identifier] : nil;
    if (customSize.count >= 2) {
        layoutSize.width = MAX((NSUInteger)1, customSize[0].unsignedIntegerValue);
        layoutSize.height = MAX((NSUInteger)1, customSize[1].unsignedIntegerValue);
    }
    CGSize compactSize = compactModule ? compactModule.view.bounds.size : [self catalogPointSizeForLayoutSize:layoutSize];
    CGFloat radius = [self refinedCornerRadiusForSize:compactSize];
    UIView *root = module.view;
    UIView *contentContainer = ERFindAncestorOrSubviewWithClassName(root, @"CCUIContentModuleContentContainerView");
    ERSetContinuousCornerRadiusIvar(contentContainer, @"_compactContinuousCornerRadius", radius);
    @try { [contentContainer setValue:@(radius) forKey:@"compactContinuousCornerRadius"]; } @catch (__unused NSException *exception) {}
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        NSString *name = NSStringFromClass(candidate.class);
        BOOL isTransitionSurface = candidate == root ||
            [name containsString:@"ContentModule"] ||
            [name containsString:@"Platter"] ||
            [name containsString:@"Material"] ||
            [name containsString:@"VisualEffect"];
        if (isTransitionSurface) {
            [candidate.layer removeAnimationForKey:@"cornerRadius"];
            candidate.layer.cornerRadius = radius;
            candidate.layer.cornerCurve = kCACornerCurveContinuous;
            if (candidate == root) candidate.layer.masksToBounds = YES;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

- (void)applyLivePreviewOrder:(NSArray<NSString *> *)order overlay:(UIViewController *)overlay {
    if (!gERUseNativeLiveReflow) return;
    if (!order.count || !overlay) return;
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    SEL providerSelector = NSSelectorFromString(@"_activePositionProvider");
    id provider = [collection respondsToSelector:providerSelector] ? ((id (*)(id, SEL))objc_msgSend)(collection, providerSelector) : nil;
    SEL regenerateSelector = NSSelectorFromString(@"regenerateRectsWithOrderedIdentifiers:orderedSizes:");
    if (!provider || ![provider respondsToSelector:regenerateSelector]) return;
    NSMutableArray<NSValue *> *sizes = [NSMutableArray arrayWithCapacity:order.count];
    for (NSString *identifier in order) {
        NSValue *sizeValue = gERProviderSizes[identifier];
        if (!sizeValue) {
            UIViewController *match = nil;
            for (UIViewController *candidate in ERCollectModuleControllers(overlay)) if ([ERModuleIdentifier(candidate) isEqualToString:identifier]) { match = candidate; break; }
            CGFloat step = kERGridStep;
            CCUILayoutSize size = {
                MAX(1, (NSUInteger)llround((CGRectGetWidth(match.view.bounds) + kERGridGap) / step)),
                MAX(1, (NSUInteger)llround((CGRectGetHeight(match.view.bounds) + kERGridGap) / step))
            };
            sizeValue = [NSValue value:&size withObjCType:@encode(CCUILayoutSize)];
        }
        [sizes addObject:sizeValue];
    }
    ((void (*)(id, SEL, id, id))objc_msgSend)(provider, regenerateSelector, order, sizes);
    [collection.view setNeedsLayout];
    [UIView animateWithDuration:0.20 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
        [collection.view layoutIfNeeded];
    } completion:nil];
}

- (BOOL)layoutHasIllegalOverlapInOverlay:(UIViewController *)overlay {
    NSArray<UIViewController *> *modules = ERCollectModuleControllers(overlay);
    for (NSUInteger first = 0; first < modules.count; first++) {
        CGRect firstFrame = ERVisibleModuleFrame(modules[first], overlay);
        if (CGRectIsEmpty(firstFrame)) continue;
        for (NSUInteger second = first + 1; second < modules.count; second++) {
            CGRect secondFrame = ERVisibleModuleFrame(modules[second], overlay);
            CGRect intersection = CGRectIntersection(CGRectInset(firstFrame, 2.0, 2.0), CGRectInset(secondFrame, 2.0, 2.0));
            if (!CGRectIsNull(intersection) && CGRectGetWidth(intersection) > 4.0 && CGRectGetHeight(intersection) > 4.0) return YES;
        }
    }
    return NO;
}

- (BOOL)applyExplicitGridSwapFrom:(NSString *)sourceID to:(NSString *)targetID overlay:(UIViewController *)overlay {
    NSValue *sourceValue = gERNativeLayoutRects[sourceID];
    NSValue *targetValue = gERNativeLayoutRects[targetID];
    if (!sourceValue || !targetValue) return NO;
    CCUILayoutRect sourceRect = {}, targetRect = {};
    [sourceValue getValue:&sourceRect];
    [targetValue getValue:&targetRect];
    NSMutableDictionary<NSString *, NSValue *> *proposed = ERCurrentPageLayout(overlay, kERMinimumGridRows);
    for (NSString *identifier in proposed) {
        CCUILayoutRect rect = {}; [proposed[identifier] getValue:&rect];
        if ([identifier isEqualToString:sourceID]) sourceRect = rect;
        if ([identifier isEqualToString:targetID]) targetRect = rect;
    }
    if (!proposed[sourceID] || !proposed[targetID]) return NO;
    CCUILayoutPoint originalSourceOrigin = sourceRect.origin;
    sourceRect.origin = targetRect.origin;
    targetRect.origin = originalSourceOrigin;
    proposed[sourceID] = [NSValue value:&sourceRect withObjCType:@encode(CCUILayoutRect)];
    proposed[targetID] = [NSValue value:&targetRect withObjCType:@encode(CCUILayoutRect)];

    if (!ERLogicalLayoutIsLegal(proposed, kERMinimumGridRows)) return NO;

    NSArray<NSString *> *identifiers = proposed.allKeys;
    for (NSUInteger first = 0; first < identifiers.count; first++) {
        CCUILayoutRect a = {}; [proposed[identifiers[first]] getValue:&a];
        if (a.origin.x + a.size.width > 4) return NO;
        for (NSUInteger second = first + 1; second < identifiers.count; second++) {
            CCUILayoutRect b = {}; [proposed[identifiers[second]] getValue:&b];
            BOOL xOverlap = a.origin.x < b.origin.x + b.size.width && b.origin.x < a.origin.x + a.size.width;
            BOOL yOverlap = a.origin.y < b.origin.y + b.size.height && b.origin.y < a.origin.y + a.size.height;
            if (xOverlap && yOverlap) return NO;
        }
    }
    NSUInteger pageStart = gERCurrentPage * kERMinimumGridRows;
    ERStoreOriginForIdentifier(sourceID, sourceRect.origin.x, pageStart + sourceRect.origin.y);
    ERStoreOriginForIdentifier(targetID, targetRect.origin.x, pageStart + targetRect.origin.y);
    ERPersistStoredOrigins();
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    [collection.view setNeedsLayout];
    [UIView animateWithDuration:0.22 animations:^{ [collection.view layoutIfNeeded]; }];
    return YES;
}

- (BOOL)applyExplicitGridMoveFrom:(NSString *)sourceID toOrigin:(CCUILayoutPoint)destination overlay:(UIViewController *)overlay {
    return [self applyExplicitGridMoveFrom:sourceID toOrigin:destination onPage:gERCurrentPage overlay:overlay];
}

- (BOOL)applyExplicitGridMoveFrom:(NSString *)sourceID toOrigin:(CCUILayoutPoint)destination onPage:(NSUInteger)page overlay:(UIViewController *)overlay {
    NSValue *sourceValue = gERNativeLayoutRects[sourceID];
    if (!sourceValue) return NO;
    NSMutableDictionary<NSString *, NSValue *> *proposed = ERLayoutForPage(overlay, page, kERMinimumGridRows);
    CCUILayoutRect sourceRect = {};
    BOOL sourceWasOnTargetPage = proposed[sourceID] != nil;
    if (sourceWasOnTargetPage) [proposed[sourceID] getValue:&sourceRect];
    else {
        [sourceValue getValue:&sourceRect];
        NSArray<NSNumber *> *savedSize = gERCustomSizes[sourceID];
        if (savedSize.count >= 2) sourceRect.size = (CCUILayoutSize){savedSize[0].unsignedIntegerValue, savedSize[1].unsignedIntegerValue};
    }
    if (sourceWasOnTargetPage && sourceRect.origin.x == destination.x && sourceRect.origin.y == destination.y) return NO;
    sourceRect.origin = destination;
    if (sourceRect.origin.x + sourceRect.size.width > 4 || sourceRect.origin.y + sourceRect.size.height > kERMinimumGridRows) return NO;
    proposed[sourceID] = [NSValue value:&sourceRect withObjCType:@encode(CCUILayoutRect)];

    if (!ERLogicalLayoutIsLegal(proposed, kERMinimumGridRows)) return NO;

    NSArray<NSString *> *identifiers = proposed.allKeys;
    for (NSUInteger first = 0; first < identifiers.count; first++) {
        CCUILayoutRect a = {};
        [proposed[identifiers[first]] getValue:&a];
        if (a.origin.x + a.size.width > 4) return NO;
        for (NSUInteger second = first + 1; second < identifiers.count; second++) {
            CCUILayoutRect b = {};
            [proposed[identifiers[second]] getValue:&b];
            BOOL xOverlap = a.origin.x < b.origin.x + b.size.width && b.origin.x < a.origin.x + a.size.width;
            BOOL yOverlap = a.origin.y < b.origin.y + b.size.height && b.origin.y < a.origin.y + a.size.height;
            if (xOverlap && yOverlap) return NO;
        }
    }
    NSUInteger pageStart = page * kERMinimumGridRows;
    ERStoreOriginForIdentifier(sourceID, destination.x, pageStart + destination.y);
    ERPersistStoredOrigins();
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    [collection.view setNeedsLayout];
    [UIView animateWithDuration:0.22 animations:^{ [collection.view layoutIfNeeded]; }];
    return YES;
}

- (BOOL)applyExplicitGridInsertionFrom:(NSString *)sourceID toOrigin:(CCUILayoutPoint)destination maxRows:(NSUInteger)maxRows overlay:(UIViewController *)overlay {
    return [self applyExplicitGridInsertionFrom:sourceID toOrigin:destination onPage:gERCurrentPage maxRows:maxRows overlay:overlay];
}

- (BOOL)applyExplicitGridInsertionFrom:(NSString *)sourceID toOrigin:(CCUILayoutPoint)destination onPage:(NSUInteger)page maxRows:(NSUInteger)maxRows overlay:(UIViewController *)overlay {
    NSValue *sourceValue = gERNativeLayoutRects[sourceID];
    if (!sourceValue || maxRows == 0) return NO;
    NSMutableDictionary<NSString *, NSValue *> *initial = ERLayoutForPage(overlay, page, maxRows);
    NSMutableDictionary<NSString *, NSValue *> *proposed = [initial mutableCopy];
    CCUILayoutRect sourceRect = {};
    if (proposed[sourceID]) [proposed[sourceID] getValue:&sourceRect];
    else {
        [sourceValue getValue:&sourceRect];
        NSArray<NSNumber *> *savedSize = gERCustomSizes[sourceID];
        if (savedSize.count >= 2) sourceRect.size = (CCUILayoutSize){savedSize[0].unsignedIntegerValue, savedSize[1].unsignedIntegerValue};
        sourceRect.origin = destination;
        initial[sourceID] = [NSValue value:&sourceRect withObjCType:@encode(CCUILayoutRect)];
    }
    sourceRect.origin = destination;
    if (sourceRect.origin.x + sourceRect.size.width > 4 || sourceRect.origin.y + sourceRect.size.height > maxRows) return NO;
    proposed[sourceID] = [NSValue value:&sourceRect withObjCType:@encode(CCUILayoutRect)];

    NSMutableArray<NSString *> *remaining = [proposed.allKeys mutableCopy];
    [remaining removeObject:sourceID];
    [remaining sortUsingComparator:^NSComparisonResult(NSString *left, NSString *right) {
        CCUILayoutRect a = {}, b = {};
        [proposed[left] getValue:&a]; [proposed[right] getValue:&b];
        if (a.origin.y != b.origin.y) return a.origin.y < b.origin.y ? NSOrderedAscending : NSOrderedDescending;
        if (a.origin.x != b.origin.x) return a.origin.x < b.origin.x ? NSOrderedAscending : NSOrderedDescending;
        return [left compare:right];
    }];
    NSMutableArray<NSString *> *placed = [NSMutableArray arrayWithObject:sourceID];
    BOOL displacedAny = NO;
    for (NSString *identifier in remaining) {
        CCUILayoutRect candidate = {};
        [proposed[identifier] getValue:&candidate];
        BOOL overlapsPlaced = NO;
        for (NSString *blockerID in placed) {
            CCUILayoutRect blocker = {};
            [proposed[blockerID] getValue:&blocker];
            if (ERLogicalRectsOverlap(candidate, blocker)) { overlapsPlaced = YES; break; }
        }
        if (overlapsPlaced && candidate.origin.y > 0) {
            for (NSInteger row = (NSInteger)candidate.origin.y - 1; row >= 0; row--) {
                CCUILayoutRect upward = candidate;
                upward.origin.y = (NSUInteger)row;
                if (ERLogicalRectFits(identifier, upward, proposed, maxRows)) {
                    candidate = upward;
                    proposed[identifier] = [NSValue value:&candidate withObjCType:@encode(CCUILayoutRect)];
                    displacedAny = YES;
                    overlapsPlaced = NO;
                    break;
                }
            }
        }
        BOOL adjusted = YES;
        while (overlapsPlaced && adjusted) {
            adjusted = NO;
            NSUInteger requiredY = candidate.origin.y;
            for (NSString *blockerID in placed) {
                CCUILayoutRect blocker = {};
                [proposed[blockerID] getValue:&blocker];
                BOOL xOverlap = candidate.origin.x < blocker.origin.x + blocker.size.width && blocker.origin.x < candidate.origin.x + candidate.size.width;
                BOOL yOverlap = candidate.origin.y < blocker.origin.y + blocker.size.height && blocker.origin.y < candidate.origin.y + candidate.size.height;
                if (xOverlap && yOverlap) requiredY = MAX(requiredY, blocker.origin.y + blocker.size.height);
            }
            if (requiredY != candidate.origin.y) {
                candidate.origin.y = requiredY;
                adjusted = YES;
                displacedAny = YES;
                if (candidate.origin.y + candidate.size.height > maxRows) return NO;
            }
        }
        proposed[identifier] = [NSValue value:&candidate withObjCType:@encode(CCUILayoutRect)];
        [placed addObject:identifier];
    }
    if (!displacedAny) return NO;
    if (!ERLogicalLayoutIsLegal(proposed, maxRows)) return NO;

    // Commit every changed origin together only after the complete cascade fits.
    NSUInteger sourcePageStart = page * kERMinimumGridRows;
    ERStoreOriginForIdentifier(sourceID, destination.x, sourcePageStart + destination.y);
    for (NSString *identifier in proposed) {
        CCUILayoutRect before = {}, after = {};
        [initial[identifier] getValue:&before]; [proposed[identifier] getValue:&after];
        if (before.origin.x != after.origin.x || before.origin.y != after.origin.y) {
            NSUInteger pageStart = page * kERMinimumGridRows;
            ERStoreOriginForIdentifier(identifier, after.origin.x, pageStart + after.origin.y);
        }
    }
    ERPersistStoredOrigins();
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    [collection.view setNeedsLayout];
    [UIView animateWithDuration:0.22 animations:^{ [collection.view layoutIfNeeded]; }];
    return YES;
}

- (BOOL)moduleIdentifierSupportsResizing:(NSString *)identifier {
    if (!identifier.length || [identifier isEqualToString:@"com.apple.control-center.DisplayModule"] || [identifier isEqualToString:@"com.apple.mediaremote.controlcenter.audio"] || [identifier isEqualToString:@"com.apple.control-center.ConnectivityModule"]) return NO;
    if ([identifier.lowercaseString containsString:@"echoreborn.connectivity"]) return YES;
    // 1.0.6-12（第 3 条）：天气磁贴允许在 4×1 与 4×2 之间拖着改尺寸。
    //
    // 它按**实测高度**切版式（ERWeatherContentViewController 的
    // applyLayoutModeForHeight:，阈值 92pt；一行 67pt、两行 146pt），所以只要放开
    // 改尺寸，一个 identifier 就覆盖两个形态 —— 控制项里始终只有一条「天气」，
    // 不需要再加第二个条目。
    if ([identifier.lowercaseString containsString:@"echoreborn.weather"]) return YES;
    NSValue *baseValue = gERBaseLayoutSizes[identifier];
    if (!baseValue) return NO;
    CCUILayoutSize base = {};
    [baseValue getValue:&base];
    return (base.width == 1 && base.height == 1) || (base.width == 2 && base.height == 2);
}

- (BOOL)applyGridResizeForIdentifier:(NSString *)sourceID size:(CCUILayoutSize)newSize overlay:(UIViewController *)overlay {
    NSValue *sourceValue = gERNativeLayoutRects[sourceID];
    if (!sourceValue) return NO;
    NSUInteger pageStart = gERCurrentPage * kERMinimumGridRows;
    // gERNativeLayoutRects is process-wide and intentionally survives native
    // provider rebuilds. It can therefore contain controls that were removed,
    // disabled, or last lived beyond the current eight-row page. Including
    // those stale rects made the final legality check reject every resize --
    // even a shrink that could not collide with anything visible.
    NSMutableDictionary<NSString *, NSValue *> *initial = [NSMutableDictionary dictionary];
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *identifier = ERModuleIdentifier(module);
        NSValue *nativeRect = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!identifier.length || !nativeRect) continue;
        CCUILayoutRect effectiveRect = {};
        [nativeRect getValue:&effectiveRect];
        NSArray<NSNumber *> *savedOrigin = ERStoredOriginForIdentifier(identifier);
        if (savedOrigin.count >= 2) effectiveRect.origin = (CCUILayoutPoint){savedOrigin[0].unsignedIntegerValue, savedOrigin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *savedSize = gERCustomSizes[identifier];
        if (savedSize.count >= 2) effectiveRect.size = (CCUILayoutSize){savedSize[0].unsignedIntegerValue, savedSize[1].unsignedIntegerValue};
        if (effectiveRect.origin.y < pageStart || effectiveRect.origin.y >= pageStart + kERMinimumGridRows) continue;
        effectiveRect.origin.y -= pageStart;
        if (effectiveRect.origin.x + effectiveRect.size.width > 4 || effectiveRect.origin.y + effectiveRect.size.height > kERMinimumGridRows) continue;
        initial[identifier] = [NSValue value:&effectiveRect withObjCType:@encode(CCUILayoutRect)];
    }
    if (!initial[sourceID]) return NO;
    NSMutableDictionary<NSString *, NSValue *> *proposed = [initial mutableCopy];
    CCUILayoutRect sourceRect = {};
    [proposed[sourceID] getValue:&sourceRect];
    sourceRect.size = newSize;
    if (sourceRect.origin.x + sourceRect.size.width > 4 || sourceRect.origin.y + sourceRect.size.height > kERMinimumGridRows) return NO;
    proposed[sourceID] = [NSValue value:&sourceRect withObjCType:@encode(CCUILayoutRect)];

    NSMutableArray<NSString *> *remaining = [proposed.allKeys mutableCopy];
    [remaining removeObject:sourceID];
    [remaining sortUsingComparator:^NSComparisonResult(NSString *left, NSString *right) {
        CCUILayoutRect a = {}, b = {};
        [proposed[left] getValue:&a]; [proposed[right] getValue:&b];
        if (a.origin.y != b.origin.y) return a.origin.y < b.origin.y ? NSOrderedAscending : NSOrderedDescending;
        if (a.origin.x != b.origin.x) return a.origin.x < b.origin.x ? NSOrderedAscending : NSOrderedDescending;
        return [left compare:right];
    }];
    // Keep the resized module fixed, preserve every unaffected module at its
    // current origin, and move only modules whose footprints now collide. The
    // old cascade could only push downward in the same columns, so it rejected
    // otherwise legal resizes whenever that path reached row eight.
    NSMutableArray<NSString *> *placed = [NSMutableArray arrayWithObject:sourceID];
    NSMutableDictionary<NSString *, NSArray<NSNumber *> *> *overflowOrigins = [NSMutableDictionary dictionary];
    NSMutableDictionary<NSString *, NSValue *> *globalOccupied = [NSMutableDictionary dictionary];
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        NSString *identifier = ERModuleIdentifier(module);
        NSValue *nativeRect = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!nativeRect) continue;
        CCUILayoutRect rect = {};
        [nativeRect getValue:&rect];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *size = gERCustomSizes[identifier];
        if (size.count >= 2) rect.size = (CCUILayoutSize){size[0].unsignedIntegerValue, size[1].unsignedIntegerValue};
        if (ERPagedRectIsValid(rect)) globalOccupied[identifier] = [NSValue value:&rect withObjCType:@encode(CCUILayoutRect)];
    }
    for (NSString *identifier in remaining) {
        CCUILayoutRect candidate = {};
        [proposed[identifier] getValue:&candidate];
        BOOL overlapsPlaced = NO;
        for (NSString *blockerID in placed) {
            CCUILayoutRect blocker = {};
            [proposed[blockerID] getValue:&blocker];
            if (ERLogicalRectsOverlap(candidate, blocker)) { overlapsPlaced = YES; break; }
        }
        if (overlapsPlaced) {
            CCUILayoutRect original = candidate;
            BOOL found = NO;
            NSUInteger bestDistance = NSUIntegerMax;
            CCUILayoutRect best = {};
            for (NSUInteger row = 0; row + candidate.size.height <= kERMinimumGridRows; row++) {
                for (NSUInteger column = 0; column + candidate.size.width <= 4; column++) {
                    CCUILayoutRect trial = candidate;
                    trial.origin = (CCUILayoutPoint){column, row};
                    BOOL fitsPlaced = YES;
                    for (NSString *blockerID in placed) {
                        CCUILayoutRect blocker = {};
                        [proposed[blockerID] getValue:&blocker];
                        if (ERLogicalRectsOverlap(trial, blocker)) { fitsPlaced = NO; break; }
                    }
                    if (!fitsPlaced) continue;
                    NSUInteger horizontal = column > original.origin.x ? column - original.origin.x : original.origin.x - column;
                    NSUInteger vertical = row > original.origin.y ? row - original.origin.y : original.origin.y - row;
                    NSUInteger distance = horizontal + vertical;
                    // Prefer the closest legal footprint. For an equal move,
                    // favor upward placement, then retain the original column.
                    BOOL betterTie = found && distance == bestDistance &&
                        (row < best.origin.y || (row == best.origin.y && horizontal < (best.origin.x > original.origin.x ? best.origin.x - original.origin.x : original.origin.x - best.origin.x)));
                    if (!found || distance < bestDistance || betterTie) {
                        found = YES;
                        bestDistance = distance;
                        best = trial;
                    }
                }
            }
            if (!found) {
                [globalOccupied removeObjectForKey:identifier];
                CCUILayoutPoint overflowDestination = {};
                if (!ERFindPagedSlot(identifier, candidate.size, gERCurrentPage + 1, globalOccupied, &overflowDestination)) return NO;
                overflowOrigins[identifier] = @[@(overflowDestination.x), @(overflowDestination.y)];
                CCUILayoutRect overflowRect = {overflowDestination, candidate.size};
                globalOccupied[identifier] = [NSValue value:&overflowRect withObjCType:@encode(CCUILayoutRect)];
                [proposed removeObjectForKey:identifier];
                continue;
            }
            candidate = best;
        }
        proposed[identifier] = [NSValue value:&candidate withObjCType:@encode(CCUILayoutRect)];
        [placed addObject:identifier];
    }

    // Nothing is committed unless the complete post-resize layout fits inside
    // the fixed 4x8 grid.  This also rejects unchanged modules that were pushed
    // or inherited into an illegal ninth row.
    if (!ERLogicalLayoutIsLegal(proposed, kERMinimumGridRows)) return NO;

    for (NSString *identifier in proposed) {
        CCUILayoutRect before = {}, after = {};
        [initial[identifier] getValue:&before]; [proposed[identifier] getValue:&after];
        if (before.origin.x != after.origin.x || before.origin.y != after.origin.y) ERStoreOriginForIdentifier(identifier, after.origin.x, pageStart + after.origin.y);
    }
    if (ERLandscapeLayoutActive()) [gERLandscapeOrigins addEntriesFromDictionary:overflowOrigins];
    else [gERCustomOrigins addEntriesFromDictionary:overflowOrigins];
    gERCustomSizes[sourceID] = @[@(newSize.width), @(newSize.height)];
    ERPersistStoredOrigins();
    CFPreferencesSetAppValue(CFSTR("ModuleGridSizes"), (__bridge CFPropertyListRef)[gERCustomSizes copy], kERPrefsDomain);
    CFPreferencesAppSynchronize(kERPrefsDomain);

    UIViewController *matchingModule = nil;
    for (UIViewController *candidate in ERCollectModuleControllers(overlay)) if ([ERModuleIdentifier(candidate) isEqualToString:sourceID]) { matchingModule = candidate; break; }
    id context = nil;
    @try {
        id contentModule = [matchingModule valueForKey:@"module"];
        context = [contentModule valueForKey:@"contentModuleContext"];
    } @catch (__unused NSException *exception) {}
    if ([context respondsToSelector:NSSelectorFromString(@"requestLayoutSizeUpdate")]) ((void (*)(id, SEL))objc_msgSend)(context, NSSelectorFromString(@"requestLayoutSizeUpdate"));
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    [collection.view setNeedsLayout];
    [UIView animateWithDuration:0.24 animations:^{ [collection.view layoutIfNeeded]; } completion:^(__unused BOOL finished) {
        for (UIViewController *candidate in ERCollectModuleControllers(overlay)) [self applyEditingToModule:candidate editing:YES];
        // The edit grid caches the module frames that hide its vacant-cell
        // circles. A resize changes the footprint without recreating edit mode,
        // so refresh that cache as soon as the native layout has settled.
        if (gEditModeActive) {
            [self prepareGridForOverlay:overlay collection:collection];
            NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
            for (EREditGridView *pageGrid in pageGrids.allValues) pageGrid.alpha = gERPagerScrubbingActive ? gERPagerHeldAlphaFactor : 1.0;
            EREditTouchShield *shield = (EREditTouchShield *)[overlay.view viewWithTag:kEREditTouchShieldTag];
            if (shield) [overlay.view bringSubviewToFront:shield];
            UIButton *settledAddControl = (UIButton *)[overlay.view viewWithTag:kERAddControlButtonTag];
            if (settledAddControl) [overlay.view bringSubviewToFront:settledAddControl];
            for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                UIButton *remove = objc_getAssociatedObject(candidate.view, kERRemoveButtonKey);
                UIButton *resize = objc_getAssociatedObject(candidate.view, kERResizeButtonKey);
                if (remove) [remove.superview bringSubviewToFront:remove];
                if (resize) [resize.superview bringSubviewToFront:resize];
            }
        }
    }];
    return YES;
}

- (CCUILayoutSize)currentResizeSizeForIdentifier:(NSString *)identifier base:(CCUILayoutSize)base {
    NSArray<NSNumber *> *saved = gERCustomSizes[identifier];
    return saved.count >= 2 ? (CCUILayoutSize){saved[0].unsignedIntegerValue, saved[1].unsignedIntegerValue} : base;
}

- (CCUILayoutSize)resizeCandidateForIdentifier:(NSString *)identifier base:(CCUILayoutSize)base start:(CCUILayoutSize)start translation:(CGPoint)translation {
    BOOL isNowPlaying = [identifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"];
    if (isNowPlaying && base.width == 2 && base.height == 2) {
        CGFloat desiredWidth = (CGFloat)start.width + translation.x / kERGridStep;
        CGFloat desiredHeight = (CGFloat)start.height + translation.y / kERGridStep;
        if (desiredWidth < 3.0) return (CCUILayoutSize){2, 2};
        if (desiredHeight < 1.5) return (CCUILayoutSize){4, 1};
        if (desiredHeight >= 3.0) return (CCUILayoutSize){4, 4};
        return (CCUILayoutSize){4, 2};
    }
    // 1.0.6-12（第 3 条）：天气磁贴只有两档 —— 4×1 与 4×2，宽度恒为满宽，
    // 只按竖直拖动的格数决定。
    if ([identifier.lowercaseString containsString:@"echoreborn.weather"]) {
        CGFloat desiredHeight = (CGFloat)start.height + translation.y / kERGridStep;
        return desiredHeight >= 1.5 ? (CCUILayoutSize){4, 2} : (CCUILayoutSize){4, 1};
    }
    if (base.width == 1 && base.height == 1) {
        CGFloat desiredWidth = (CGFloat)start.width + translation.x / kERGridStep;
        CGFloat desiredHeight = (CGFloat)start.height + translation.y / kERGridStep;
        if (desiredHeight >= 1.5) return (CCUILayoutSize){2, 2};
        if (desiredWidth >= 1.5) return (CCUILayoutSize){2, 1};
        return (CCUILayoutSize){1, 1};
    }
    if (base.width == 2 && base.height == 2) {
        CGFloat desiredWidth = (CGFloat)start.width + translation.x / kERGridStep;
        return desiredWidth >= 3.0 ? (CCUILayoutSize){4, 2} : (CCUILayoutSize){2, 2};
    }
    return base;
}

- (CGRect)liveResizeFrameForIdentifier:(NSString *)identifier base:(CCUILayoutSize)base startSize:(CCUILayoutSize)start startFrame:(CGRect)startFrame translation:(CGPoint)translation {
    CGRect frame = startFrame;
    BOOL isNowPlaying = [identifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"];
    if (isNowPlaying && base.width == 2 && base.height == 2) {
        CGFloat twoCellSize = kERGridCellSize * 2.0 + kERGridGap;
        CGFloat fourCellSize = kERGridCellSize * 4.0 + kERGridGap * 3.0;
        CGFloat width = MIN(fourCellSize, MAX(twoCellSize, CGRectGetWidth(startFrame) + translation.x));
        CGFloat minimumHeight = width >= (twoCellSize + fourCellSize) * 0.5 ? kERGridCellSize : twoCellSize;
        CGFloat height = MIN(fourCellSize, MAX(minimumHeight, CGRectGetHeight(startFrame) + translation.y));
        frame.size = CGSizeMake(width, height);
        return frame;
    }
    // 1.0.6-12（第 3 条）：天气磁贴宽度锁满宽，高度在 1 格与 2 格之间跟手。
    if ([identifier.lowercaseString containsString:@"echoreborn.weather"]) {
        CGFloat fourCellSize = kERGridCellSize * 4.0 + kERGridGap * 3.0;
        CGFloat twoCellSize = kERGridCellSize * 2.0 + kERGridGap;
        CGFloat height = MIN(twoCellSize, MAX(kERGridCellSize, CGRectGetHeight(startFrame) + translation.y));
        frame.size = CGSizeMake(fourCellSize, height);
        return frame;
    }
    if (base.width == 1 && base.height == 1) {
        CGFloat twoCellSize = kERGridCellSize * 2.0 + kERGridGap;
        CGFloat width = MIN(twoCellSize, MAX(kERGridCellSize, CGRectGetWidth(startFrame) + translation.x));
        CGFloat height = MIN(twoCellSize, MAX(kERGridCellSize, CGRectGetHeight(startFrame) + translation.y));
        if (start.height == 1 && height > kERGridCellSize) width = MAX(width, height);
        if (start.width == 2 && height > kERGridCellSize) width = twoCellSize;
        frame.size = CGSizeMake(width, height);
    } else if (base.width == 2 && base.height == 2) {
        CGFloat twoCellSize = kERGridCellSize * 2.0 + kERGridGap;
        CGFloat fourCellSize = kERGridCellSize * 4.0 + kERGridGap * 3.0;
        frame.size = CGSizeMake(MIN(fourCellSize, MAX(twoCellSize, CGRectGetWidth(startFrame) + translation.x)), twoCellSize);
    }
    return frame;
}

- (void)resizePanned:(UIPanGestureRecognizer *)gesture {
    UIButton *handle = (UIButton *)gesture.view;
    NSString *identifier = objc_getAssociatedObject(handle, @selector(resizePanned:));
    NSValue *baseValue = gERBaseLayoutSizes[identifier];
    if (![self moduleIdentifierSupportsResizing:identifier] || !baseValue) return;
    CCUILayoutSize base = {};
    [baseValue getValue:&base];
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;

    if (gesture.state == UIGestureRecognizerStateBegan) {
        CCUILayoutSize start = [self currentResizeSizeForIdentifier:identifier base:base];
        NSValue *startValue = [NSValue value:&start withObjCType:@encode(CCUILayoutSize)];
        objc_setAssociatedObject(gesture, kERResizeStartSizeKey, startValue, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERResizeCandidateSizeKey, startValue, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        UIView *moduleView = objc_getAssociatedObject(handle, kERRemoveModuleViewKey);
        gERResizeInProgress = YES;
        gERActiveResizeModuleView = moduleView;
        if (overlay.view) {
            NSMutableArray<UIGestureRecognizer *> *suppressed = [NSMutableArray array];
            NSMutableArray<UIView *> *viewQueue = [NSMutableArray arrayWithObject:overlay.view];
            while (viewQueue.count) {
                UIView *view = viewQueue.firstObject;
                [viewQueue removeObjectAtIndex:0];
                for (UIGestureRecognizer *other in view.gestureRecognizers) {
                    if (other == gesture || !other.enabled) continue;
                    if ([other isKindOfClass:[UIPanGestureRecognizer class]]) {
                        other.enabled = NO;
                        [suppressed addObject:other];
                    }
                }
                [viewQueue addObjectsFromArray:view.subviews];
            }
            objc_setAssociatedObject(gesture, kERResizeSuppressedGesturesKey, suppressed, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        if (moduleView) {
            CGRect startFrame = CGRectMake(CGRectGetMinX(moduleView.frame), CGRectGetMinY(moduleView.frame), CGRectGetWidth(moduleView.bounds), CGRectGetHeight(moduleView.bounds));
            objc_setAssociatedObject(gesture, kERResizePreviewStartFrameKey, [NSValue valueWithCGRect:startFrame], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            UIView *buttonView = ERFindSubviewWithClassName(moduleView, @"CCUIButtonModuleView");
            // Modules without a button hierarchy (now playing) host the snap
            // preview override on the module view itself so descendant layout
            // (ERResizedPreviewSizeForDescendant) tracks the candidate size.
            UIView *overrideHost = buttonView ?: moduleView;
            if (overrideHost) {
                objc_setAssociatedObject(overrideHost, kERResizePreviewKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                objc_setAssociatedObject(overrideHost, kERResizePresentationSizeOverrideKey, @[@(start.width), @(start.height)], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
        }
        [UIView animateWithDuration:0.12 animations:^{ handle.transform = CGAffineTransformMakeScale(1.08, 1.08); handle.alpha = 1.0; }];
        ERHaptic();
        return;
    }

    CCUILayoutSize start = {};
    [objc_getAssociatedObject(gesture, kERResizeStartSizeKey) getValue:&start];
    UIView *moduleView = objc_getAssociatedObject(handle, kERRemoveModuleViewKey);
    CGRect startFrame = [objc_getAssociatedObject(gesture, kERResizePreviewStartFrameKey) CGRectValue];
    UIView *wrapper = moduleView.superview;
    CGPoint translation = [gesture translationInView:wrapper ?: handle.superview];
    CCUILayoutSize candidate = [self resizeCandidateForIdentifier:identifier base:base start:start translation:translation];
    if (moduleView && wrapper && !CGRectIsEmpty(startFrame)) {
        CGRect liveFrame = [self liveResizeFrameForIdentifier:identifier base:base startSize:start startFrame:startFrame translation:translation];
        [UIView performWithoutAnimation:^{
            moduleView.frame = liveFrame;
            moduleView.layer.cornerRadius = [self editingModuleCornerRadiusForSize:liveFrame.size];
            UIVisualEffectView *border = objc_getAssociatedObject(moduleView, @selector(applyEditingToModule:editing:));
            [self configureEditingBorder:border moduleFrame:liveFrame];
            if (overlay) {
                UIView *handleHost = handle.superview ?: overlay.view;
                CGRect handleFrame = handleHost == wrapper ? liveFrame : [wrapper convertRect:liveFrame toView:handleHost];
                handle.frame = CGRectMake(CGRectGetMaxX(handleFrame) - 42.0, CGRectGetMaxY(handleFrame) - 42.0, 42.0, 42.0);
                CGRect visibleFrame = [wrapper convertRect:liveFrame toView:overlay.view];
                // Treat the live resize footprint like a drag landing region so
                // newly covered vacant-cell circles fade before the snap commits.
                NSValue *layoutValue = gERNativeLayoutRects[identifier];
                NSUInteger page = gERCurrentPage;
                if (layoutValue) {
                    CCUILayoutRect rect = {};
                    [layoutValue getValue:&rect];
                    NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
                    if (origin.count >= 2) rect.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
                    page = ERPageForRect(rect);
                }
                [self setEditGridLandingRects:@[[NSValue valueWithCGRect:visibleFrame]] forPage:page overlay:overlay];
            }
        }];
    }
    NSValue *priorValue = objc_getAssociatedObject(gesture, kERResizeCandidateSizeKey);
    CCUILayoutSize prior = {};
    [priorValue getValue:&prior];
    if (candidate.width != prior.width || candidate.height != prior.height) {
        objc_setAssociatedObject(gesture, kERResizeCandidateSizeKey, [NSValue value:&candidate withObjCType:@encode(CCUILayoutSize)], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        UIView *buttonView = ERFindSubviewWithClassName(moduleView, @"CCUIButtonModuleView");
        UIView *overrideHost = buttonView ?: moduleView;
        if (overrideHost) objc_setAssociatedObject(overrideHost, kERResizePresentationSizeOverrideKey, @[@(candidate.width), @(candidate.height)], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if ([identifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"]) {
            for (UIView *view = moduleView; view; view = view.superview) [view setNeedsLayout];
            [moduleView layoutIfNeeded];
        }
        ERHaptic();
    }

    if (gesture.state == UIGestureRecognizerStateEnded || gesture.state == UIGestureRecognizerStateCancelled || gesture.state == UIGestureRecognizerStateFailed) {
        [UIView animateWithDuration:0.16 animations:^{ handle.transform = CGAffineTransformIdentity; handle.alpha = 1.0; }];
        BOOL committed = NO;
        UIView *buttonView = ERFindSubviewWithClassName(moduleView, @"CCUIButtonModuleView");
        if (gesture.state == UIGestureRecognizerStateEnded && (candidate.width != start.width || candidate.height != start.height)) {
            // The private button hierarchy recenters one of its intermediate
            // glyph containers during the native resize. Preserve the exact
            // on-screen glyph above that moving hierarchy until it settles;
            // otherwise a correct endpoint correction appears as an opposite-
            // direction jump during the animation.
            if (base.width == 1 && base.height == 1 && overlay.view) {
                ERBeginResizeGlyphHandoff(moduleView, buttonView, overlay.view);
            }
            committed = [self applyGridResizeForIdentifier:identifier size:candidate overlay:overlay];
            ERLogOperation(@"resize", identifier, committed,
                            [NSString stringWithFormat:@"%lux%lu", (unsigned long)candidate.width, (unsigned long)candidate.height]);
            if (!committed) {
                EREndResizeGlyphHandoff(moduleView);
                UINotificationFeedbackGenerator *feedback = [UINotificationFeedbackGenerator new];
                [feedback notificationOccurred:UINotificationFeedbackTypeWarning];
            }
        }
        if (committed) {
            // Native layout begins as soon as applyGridResize returns. Release
            // the preview suppression now so every layout frame during that
            // animation reapplies the invariant compact glyph anchor.
            UIView *commitOverrideHost = buttonView ?: moduleView;
            if (commitOverrideHost) {
                objc_setAssociatedObject(commitOverrideHost, kERResizePreviewKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                objc_setAssociatedObject(commitOverrideHost, kERResizePresentationSizeOverrideKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
            CGRect endpointFrame = startFrame;
            endpointFrame.size = CGSizeMake(kERGridCellSize + (candidate.width - 1) * kERGridStep,
                                            kERGridCellSize + (candidate.height - 1) * kERGridStep);
            UIVisualEffectView *border = objc_getAssociatedObject(moduleView, @selector(applyEditingToModule:editing:));
            [UIView animateWithDuration:0.24 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
                moduleView.frame = endpointFrame;
                moduleView.layer.cornerRadius = [self editingModuleCornerRadiusForSize:endpointFrame.size];
                [self configureEditingBorder:border moduleFrame:endpointFrame];
                if (overlay && wrapper) {
                    UIView *handleHost = handle.superview ?: overlay.view;
                    CGRect handleFrame = handleHost == wrapper ? endpointFrame : [wrapper convertRect:endpointFrame toView:handleHost];
                    handle.frame = CGRectMake(CGRectGetMaxX(handleFrame) - 42.0, CGRectGetMaxY(handleFrame) - 42.0, 42.0, 42.0);
                }
            } completion:nil];
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (module.view == moduleView) { [self applyResizedPresentationToModule:module]; break; }
            }
        }
        void (^finishPreview)(void) = ^{
            NSArray<UIGestureRecognizer *> *suppressedGestures = objc_getAssociatedObject(gesture, kERResizeSuppressedGesturesKey);
            for (UIGestureRecognizer *suppressed in suppressedGestures) suppressed.enabled = YES;
            objc_setAssociatedObject(gesture, kERResizeSuppressedGesturesKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            UIView *finishOverrideHost = buttonView ?: moduleView;
            if (finishOverrideHost) {
                objc_setAssociatedObject(finishOverrideHost, kERResizePreviewKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                objc_setAssociatedObject(finishOverrideHost, kERResizePresentationSizeOverrideKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
            [self clearEditGridLandingRectsForOverlay:overlay];
            if (moduleView && !committed && !CGRectIsEmpty(startFrame)) {
                moduleView.frame = startFrame;
                moduleView.layer.cornerRadius = [self editingModuleCornerRadiusForSize:startFrame.size];
                UIVisualEffectView *border = objc_getAssociatedObject(moduleView, @selector(applyEditingToModule:editing:));
                [self configureEditingBorder:border moduleFrame:startFrame];
                if (overlay && wrapper) {
                    UIView *handleHost = handle.superview ?: overlay.view;
                    CGRect handleFrame = handleHost == wrapper ? startFrame : [wrapper convertRect:startFrame toView:handleHost];
                    handle.frame = CGRectMake(CGRectGetMaxX(handleFrame) - 42.0, CGRectGetMaxY(handleFrame) - 42.0, 42.0, 42.0);
                }
            }
            gERResizeInProgress = NO;
            gERActiveResizeModuleView = nil;
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (module.view == moduleView) {
                    [self applyEditingToModule:module editing:gEditModeActive];
                    [self applyResizedPresentationToModule:module];
                    break;
                }
            }
            EREndResizeGlyphHandoff(moduleView);
        };
        if (committed) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.30 * NSEC_PER_SEC)), dispatch_get_main_queue(), finishPreview);
        else [UIView animateWithDuration:0.20 animations:finishPreview];
        objc_setAssociatedObject(gesture, kERResizeStartSizeKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERResizeCandidateSizeKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERResizePreviewStartFrameKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
}

- (void)modulePanned:(UIGestureRecognizer *)gesture {
    UIViewController *overlay = nil;
    UIResponder *responder = gesture.view;
    while (responder && ![responder isKindOfClass:[UIViewController class]]) responder = responder.nextResponder;
    if ([responder isKindOfClass:[UIViewController class]]) overlay = (UIViewController *)responder;
    if (!overlay) overlay = gOverlayControllers.allObjects.firstObject;
    UIView *moduleView = objc_getAssociatedObject(gesture, @selector(moduleControllerForShield:));
    NSString *sourceID = objc_getAssociatedObject(gesture, @selector(modulePanned:));
    CGPoint currentPoint = [gesture locationInView:overlay.view];
    CGPoint startPoint = [objc_getAssociatedObject(gesture, kERDragStartPointKey) CGPointValue];
    CGPoint translation = CGPointMake(currentPoint.x - startPoint.x, currentPoint.y - startPoint.y);
    if (gesture.state == UIGestureRecognizerStateBegan) {
        if (gERPagerTransitionActive || gERPagerScrubbingActive || gERPresentationPageHandoffActive) {
            gesture.enabled = NO;
            gesture.enabled = YES;
            return;
        }
        CGPoint location = currentPoint;
        UIViewController *source = nil;
        CGFloat sourceDistance = CGFLOAT_MAX;
        for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
            CGRect frame = ERVisibleModuleFrame(candidate, overlay);
            CGFloat distance = hypot(CGRectGetMidX(frame) - location.x, CGRectGetMidY(frame) - location.y);
            if (CGRectContainsPoint(CGRectInset(frame, -14.0, -14.0), location) && distance < sourceDistance) {
                source = candidate;
                sourceDistance = distance;
            }
        }
        moduleView = source.view;
        sourceID = ERModuleIdentifier(source);
        if (!sourceID.length || !moduleView) { gesture.enabled = NO; gesture.enabled = YES; return; }
        gERDragInProgress = YES;
        gERActiveDragModuleView = moduleView;
        gERActiveDragModuleIdentifier = [sourceID copy];
        objc_setAssociatedObject(gesture, @selector(moduleControllerForShield:), moduleView, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, @selector(modulePanned:), sourceID, OBJC_ASSOCIATION_COPY_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragStartPointKey, [NSValue valueWithCGPoint:location], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        CGRect visibleSourceFrame = ERVisibleModuleFrame(source, overlay);
        CGPoint grabOffset = CGPointMake(location.x - CGRectGetMinX(visibleSourceFrame), location.y - CGRectGetMinY(visibleSourceFrame));
        objc_setAssociatedObject(gesture, kERDragGrabOffsetKey, [NSValue valueWithCGPoint:grabOffset], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragMovedKey, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        NSArray *baseOrder = gERProviderOrder.count ? gERProviderOrder : [self enabledModuleIdentifiers];
        objc_setAssociatedObject(gesture, kERDragBaseOrderKey, [baseOrder copy], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        UIView *proxy = [[UIView alloc] initWithFrame:ERVisibleModuleFrame(source, overlay)];
        proxy.bounds = (CGRect){CGPointZero, moduleView.bounds.size};
        proxy.layer.cornerRadius = moduleView.layer.cornerRadius;
        proxy.layer.cornerCurve = kCACornerCurveContinuous;
        proxy.clipsToBounds = NO;
        proxy.userInteractionEnabled = NO;
        UIView *buttonView = ERFindSubviewWithClassName(moduleView, @"CCUIButtonModuleView");
        BOOL selectedButton = [buttonView isKindOfClass:[UIControl class]] && [(UIControl *)buttonView isSelected];
        NSString *dragIdentifier = sourceID;
        BOOL dragIsConnectivity = ERConnectivityIdentifierIsOwned(dragIdentifier);
        UIView *proxyMaterial = nil;
        if (dragIsConnectivity && selectedButton) {
            // A connectivity tile lifts with its brand fill, matching the live
            // tile and iOS 18/26. The generic light platter below is what the
            // system itself uses for other selected buttons, so it stays.
            proxyMaterial = [[UIView alloc] initWithFrame:proxy.bounds];
            proxyMaterial.backgroundColor = ERConnectivityAccentColorForIdentifier(dragIdentifier);
        } else if (selectedButton) {
            proxyMaterial = [[UIView alloc] initWithFrame:proxy.bounds];
            proxyMaterial.backgroundColor = [UIColor colorWithWhite:0.96 alpha:0.92];
        } else {
            proxyMaterial = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemUltraThinMaterialDark]];
            proxyMaterial.frame = proxy.bounds;
        }
        proxyMaterial.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        proxyMaterial.userInteractionEnabled = NO;
        proxyMaterial.layer.cornerRadius = moduleView.layer.cornerRadius;
        proxyMaterial.layer.cornerCurve = kCACornerCurveContinuous;
        proxyMaterial.clipsToBounds = YES;
        [proxy addSubview:proxyMaterial];
        // Material and the edit ring are already owned by the proxy. Capture
        // only module content so the wrapper's original border cannot become a
        // second ring or a stationary-looking ghost in the drag snapshot.
        UIView *proxyContent = [moduleView snapshotViewAfterScreenUpdates:YES];
        if (!proxyContent) proxyContent = [moduleView resizableSnapshotViewFromRect:moduleView.bounds afterScreenUpdates:YES withCapInsets:UIEdgeInsetsZero];
        proxyContent.frame = proxy.bounds;
        proxyContent.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        proxyContent.userInteractionEnabled = NO;
        proxyContent.layer.cornerRadius = moduleView.layer.cornerRadius;
        proxyContent.layer.cornerCurve = kCACornerCurveContinuous;
        proxyContent.clipsToBounds = YES;
        [proxy addSubview:proxyContent];
        UIVisualEffectView *proxyBorder = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThinMaterialLight]];
        proxyBorder.frame = proxy.bounds;
        proxyBorder.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        proxyBorder.userInteractionEnabled = NO;
        CGFloat proxyRadius = moduleView.layer.cornerRadius;
        UIBezierPath *proxyRing = [UIBezierPath bezierPathWithRoundedRect:proxyBorder.bounds cornerRadius:proxyRadius];
        [proxyRing appendPath:[UIBezierPath bezierPathWithRoundedRect:CGRectInset(proxyBorder.bounds, 3.5, 3.5) cornerRadius:MAX(0.0, proxyRadius - 3.5)]];
        CAShapeLayer *proxyMask = [CAShapeLayer layer];
        proxyMask.path = proxyRing.CGPath;
        proxyMask.fillRule = kCAFillRuleEvenOdd;
        proxyBorder.layer.mask = proxyMask;
        [proxy addSubview:proxyBorder];
        UIButton *sourceRemove = objc_getAssociatedObject(moduleView, kERRemoveButtonKey);
        UIButton *sourceResize = objc_getAssociatedObject(moduleView, kERResizeButtonKey);
        for (UIButton *chromeButton in @[sourceRemove ?: (UIButton *)NSNull.null, sourceResize ?: (UIButton *)NSNull.null]) {
            if ((id)chromeButton == NSNull.null || chromeButton.hidden || chromeButton.alpha <= 0.01) continue;
            UIView *chromeSnapshot = [[UIView alloc] initWithFrame:chromeButton.bounds];
            chromeSnapshot.backgroundColor = UIColor.clearColor;
            chromeSnapshot.opaque = NO;
            if (chromeButton.tag == kERRemoveButtonTag) {
                UIVisualEffectView *bubble = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterialLight]];
                bubble.frame = CGRectMake(9.0, 9.0, 26.0, 26.0);
                bubble.layer.cornerRadius = 13.0;
                bubble.clipsToBounds = YES;
                bubble.userInteractionEnabled = NO;
                [chromeSnapshot addSubview:bubble];
                UIImageView *minusGlyph = [[UIImageView alloc] initWithImage:[[self symbol:@"minus" size:13.0] imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate]];
                minusGlyph.tintColor = UIColor.blackColor;
                minusGlyph.contentMode = UIViewContentModeCenter;
                minusGlyph.frame = CGRectMake(9.0, 9.0, 26.0, 26.0);
                minusGlyph.userInteractionEnabled = NO;
                [chromeSnapshot addSubview:minusGlyph];
            } else if (chromeButton.tag == kERResizeButtonTag) {
                UIBezierPath *cornerPath = [UIBezierPath bezierPath];
                [cornerPath moveToPoint:CGPointMake(20.29, 40.01)];
                [cornerPath addCurveToPoint:CGPointMake(40.01, 20.29)
                              controlPoint1:CGPointMake(31.20, 40.01)
                              controlPoint2:CGPointMake(40.01, 31.20)];
                UIVisualEffectView *grabberMaterial = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThinMaterialLight]];
                grabberMaterial.frame = chromeSnapshot.bounds;
                grabberMaterial.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
                grabberMaterial.userInteractionEnabled = NO;
                CAShapeLayer *materialMask = [CAShapeLayer layer];
                materialMask.path = cornerPath.CGPath;
                materialMask.fillColor = UIColor.clearColor.CGColor;
                materialMask.strokeColor = UIColor.blackColor.CGColor;
                materialMask.lineWidth = 12.0;
                materialMask.lineCap = kCALineCapRound;
                materialMask.lineJoin = kCALineJoinRound;
                grabberMaterial.layer.mask = materialMask;
                [chromeSnapshot addSubview:grabberMaterial];
                CAShapeLayer *pill = [CAShapeLayer layer];
                pill.path = cornerPath.CGPath;
                pill.fillColor = UIColor.clearColor.CGColor;
                pill.strokeColor = [UIColor.whiteColor colorWithAlphaComponent:0.82].CGColor;
                pill.lineWidth = 12.5;
                pill.lineCap = kCALineCapRound;
                pill.lineJoin = kCALineJoinRound;
                [chromeSnapshot.layer addSublayer:pill];
            } else {
                UIView *fallbackSnapshot = [chromeButton snapshotViewAfterScreenUpdates:NO];
                if (!fallbackSnapshot) fallbackSnapshot = [chromeButton resizableSnapshotViewFromRect:chromeButton.bounds afterScreenUpdates:NO withCapInsets:UIEdgeInsetsZero];
                if (!fallbackSnapshot) continue;
                fallbackSnapshot.frame = chromeSnapshot.bounds;
                fallbackSnapshot.userInteractionEnabled = NO;
                [chromeSnapshot addSubview:fallbackSnapshot];
            }
            CGRect overlayChromeFrame = [chromeButton convertRect:chromeButton.bounds toView:overlay.view];
            chromeSnapshot.frame = [overlay.view convertRect:overlayChromeFrame toView:proxy];
            chromeSnapshot.autoresizingMask = UIViewAutoresizingFlexibleRightMargin | UIViewAutoresizingFlexibleBottomMargin;
            chromeSnapshot.userInteractionEnabled = NO;
            [proxy addSubview:chromeSnapshot];
        }
        [overlay.view addSubview:proxy];
        objc_setAssociatedObject(gesture, kERDragProxyKey, proxy, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragProxyStartFrameKey, [NSValue valueWithCGRect:proxy.frame], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        NSMutableDictionary<NSString *, NSValue *> *baseFrames = [NSMutableDictionary dictionary];
        for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
            NSString *candidateID = ERModuleIdentifier(candidate);
            if (candidateID.length) baseFrames[candidateID] = [NSValue valueWithCGRect:ERVisibleModuleFrame(candidate, overlay)];
        }
        objc_setAssociatedObject(gesture, kERDragBaseFramesKey, baseFrames, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        NSUInteger sourcePage = gERCurrentPage;
        CCUILayoutRect sourceLogical = {};
        BOOL hasSourceLogical = NO;
        NSValue *layoutValue = gERNativeLayoutRects[sourceID];
        if (layoutValue) {
            [layoutValue getValue:&sourceLogical];
            NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(sourceID);
            if (origin.count >= 2) sourceLogical.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
            NSArray<NSNumber *> *size = gERCustomSizes[sourceID];
            if (size.count >= 2) sourceLogical.size = (CCUILayoutSize){size[0].unsignedIntegerValue, size[1].unsignedIntegerValue};
            sourcePage = ERPageForRect(sourceLogical);
            hasSourceLogical = sourceLogical.size.width > 0 && sourceLogical.size.height > 0;
        }
        objc_setAssociatedObject(gesture, kERDragStartPageKey, @(sourcePage), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        EREditGridView *grid = [self editGridForPage:sourcePage overlay:overlay];
        if (!grid) grid = objc_getAssociatedObject(overlay, kEREditGridKey);
        grid.landingCornerRadius = moduleView.layer.cornerRadius;
        CGRect startFrame = [moduleView convertRect:moduleView.bounds toView:grid];
        if (hasSourceLogical && grid.columns > 0) {
            NSUInteger localRow = sourceLogical.origin.y % kERMinimumGridRows;
            NSUInteger slotIndex = localRow * grid.columns + sourceLogical.origin.x;
            if (slotIndex < grid.slotRects.count) {
                CGRect slot = grid.slotRects[slotIndex].CGRectValue;
                startFrame = CGRectMake(CGRectGetMinX(slot),
                                        CGRectGetMinY(slot),
                                        kERGridCellSize + (sourceLogical.size.width - 1) * kERGridStep,
                                        kERGridCellSize + (sourceLogical.size.height - 1) * kERGridStep);
            }
        }
        objc_setAssociatedObject(gesture, kERDragStartFrameKey, [NSValue valueWithCGRect:startFrame], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        NSMutableArray<NSValue *> *remainingOccupied = [NSMutableArray array];
        for (NSValue *value in grid.occupiedRects) if (!CGRectIntersectsRect(value.CGRectValue, startFrame)) [remainingOccupied addObject:value];
        grid.occupiedRects = remainingOccupied;
        [grid setNeedsDisplay];
        ERHaptic();
        UIButton *remove = objc_getAssociatedObject(moduleView, kERRemoveButtonKey);
        UIButton *resize = objc_getAssociatedObject(moduleView, kERResizeButtonKey);
        NSMutableArray<NSDictionary *> *hiddenChrome = [NSMutableArray array];
        for (UIView *chrome in @[remove ?: (UIButton *)NSNull.null, resize ?: (UIButton *)NSNull.null]) {
            if ((id)chrome == NSNull.null) continue;
            [hiddenChrome addObject:@{@"view": chrome, @"hidden": @(chrome.hidden), @"alpha": @(chrome.alpha)}];
            chrome.hidden = YES;
            chrome.alpha = 0.0;
        }
        objc_setAssociatedObject(gesture, kERDragHiddenChromeKey, hiddenChrome, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        UIVisualEffectView *dragBorder = objc_getAssociatedObject(moduleView, @selector(applyEditingToModule:editing:));
        moduleView.alpha = 0.0;
        dragBorder.alpha = 0.0;
        dragBorder.hidden = YES;
        [overlay.view bringSubviewToFront:proxy];
        [UIView animateWithDuration:0.16 animations:^{ proxy.transform = CGAffineTransformMakeScale(1.04, 1.04); proxy.alpha = 0.92; }];
    } else if (gesture.state == UIGestureRecognizerStateChanged) {
        if (!moduleView) return;
        BOOL moved = hypot(translation.x, translation.y) >= 9.0;
        if (moved) objc_setAssociatedObject(gesture, kERDragMovedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        UIView *proxy = objc_getAssociatedObject(gesture, kERDragProxyKey);
        // Translate in overlay coordinates first, then retain the small lifted
        // scale around the proxy.  Reversing these transforms scales the drag
        // distance too, which makes the independently hosted corner controls
        // drift farther away the longer the module is moved.
        proxy.transform = CGAffineTransformConcat(CGAffineTransformMakeTranslation(translation.x, translation.y), CGAffineTransformMakeScale(1.04, 1.04));
        CGRect proxyStartFrame = [objc_getAssociatedObject(gesture, kERDragProxyStartFrameKey) CGRectValue];
        CGRect draggedFrame = CGRectOffset(proxyStartFrame, translation.x, translation.y);
        NSUInteger dragPage = MIN(gERCurrentPage, gERPageCount ? gERPageCount - 1 : 0);
        objc_setAssociatedObject(gesture, kERDragStartPageKey, @(dragPage), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        EREditGridView *grid = [self editGridForPage:dragPage overlay:overlay];
        if (!grid) grid = objc_getAssociatedObject(overlay, kEREditGridKey);
        // Edge dwell auto-paging: the finger must sit beyond the actual
        // first/last grid row for a beat. A fixed screen band fired while a
        // module was merely high or low on the current page.
        if (gPagingEnabled && moved && grid.slotRects.count) {
            CGRect gridBounds = CGRectNull;
            for (NSValue *slotValue in grid.slotRects) {
                CGRect slot = slotValue.CGRectValue;
                gridBounds = CGRectIsNull(gridBounds) ? slot : CGRectUnion(gridBounds, slot);
            }
            CGPoint pointInGrid = [overlay.view convertPoint:currentPoint toView:grid];
            CGFloat dwellMargin = MAX(18.0, kERGridGap + 8.0);
            NSInteger dwellDirection = 0;
            if (pointInGrid.y < CGRectGetMinY(gridBounds) - dwellMargin && gERCurrentPage > 0) dwellDirection = -1;
            else if (pointInGrid.y > CGRectGetMaxY(gridBounds) + dwellMargin && gERCurrentPage + 1 < gERPageCount) dwellDirection = 1;
            if (dwellDirection != 0) {
                NSNumber *storedDirection = objc_getAssociatedObject(gesture, kERDragEdgeDwellDirectionKey);
                NSNumber *dwellStart = objc_getAssociatedObject(gesture, kERDragEdgeDwellKey);
                if (!dwellStart || storedDirection.integerValue != dwellDirection) {
                    objc_setAssociatedObject(gesture, kERDragEdgeDwellKey, @(CACurrentMediaTime()), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    objc_setAssociatedObject(gesture, kERDragEdgeDwellDirectionKey, @(dwellDirection), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                } else if (CACurrentMediaTime() - dwellStart.doubleValue > 0.72) {
                    objc_setAssociatedObject(gesture, kERDragEdgeDwellKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    objc_setAssociatedObject(gesture, kERDragEdgeDwellDirectionKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    NSUInteger targetPage = dwellDirection < 0 ? gERCurrentPage - 1 : gERCurrentPage + 1;
                    ERHaptic();
                    [self clearEditGridLandingRectsForOverlay:overlay];
                    [self setCurrentPage:targetPage forOverlay:overlay animated:YES];
                    objc_setAssociatedObject(gesture, kERDragStartPageKey, @(targetPage), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    objc_setAssociatedObject(gesture, kERDragLandingOriginKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    objc_setAssociatedObject(gesture, kERDragPreviewTargetIDKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
                    objc_setAssociatedObject(gesture, kERDragPendingTargetIDKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
                }
            } else {
                objc_setAssociatedObject(gesture, kERDragEdgeDwellKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                objc_setAssociatedObject(gesture, kERDragEdgeDwellDirectionKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
        } else {
            objc_setAssociatedObject(gesture, kERDragEdgeDwellKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(gesture, kERDragEdgeDwellDirectionKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        CGRect startFrame = [objc_getAssociatedObject(gesture, kERDragStartFrameKey) CGRectValue];
        CGPoint grabOffset = [objc_getAssociatedObject(gesture, kERDragGrabOffsetKey) CGPointValue];
        CGPoint proposedOriginOverlay = CGPointMake(currentPoint.x - grabOffset.x, currentPoint.y - grabOffset.y);
        CGPoint proposedOriginGrid = [overlay.view convertPoint:proposedOriginOverlay toView:grid];
        CGRect proposed = (CGRect){proposedOriginGrid, startFrame.size};
        // Snap the proposed top-left corner to the nearest logical grid slot.
        // This is the destination for true anywhere placement even when no
        // other module exists beneath the dragged footprint.
        NSUInteger nearestSlot = NSNotFound;
        CGFloat nearestSlotDistance = CGFLOAT_MAX;
        NSUInteger footprintColumns = MAX(1, (NSUInteger)llround((CGRectGetWidth(startFrame) + kERGridGap) / kERGridStep));
        NSUInteger footprintRows = MAX(1, (NSUInteger)llround((CGRectGetHeight(startFrame) + kERGridGap) / kERGridStep));
        for (NSUInteger index = 0; index < grid.slotRects.count; index++) {
            NSUInteger column = index % grid.columns;
            NSUInteger row = index / grid.columns;
            CCUILayoutRect candidateRect = {(CCUILayoutPoint){column, row}, (CCUILayoutSize){footprintColumns, footprintRows}};
            if (!ERLogicalRectRespectsColumnBands(candidateRect) || column + footprintColumns > grid.columns || row + footprintRows > grid.rows) continue;
            CGRect slot = grid.slotRects[index].CGRectValue;
            CGFloat distance = hypot(CGRectGetMinX(slot) - CGRectGetMinX(proposed), CGRectGetMinY(slot) - CGRectGetMinY(proposed));
            if (distance < nearestSlotDistance) { nearestSlotDistance = distance; nearestSlot = index; }
        }
        if (moved && nearestSlot != NSNotFound && grid.columns > 0) {
            NSUInteger landingColumn = nearestSlot % grid.columns;
            NSUInteger landingRow = nearestSlot / grid.columns;
            objc_setAssociatedObject(gesture, kERDragLandingOriginKey, @[@(landingColumn), @(landingRow)], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            NSMutableArray<NSValue *> *snappedLanding = [NSMutableArray array];
            for (NSUInteger dy = 0; dy < footprintRows; dy++) {
                for (NSUInteger dx = 0; dx < footprintColumns; dx++) {
                    NSUInteger slotIndex = (landingRow + dy) * grid.columns + landingColumn + dx;
                    if (slotIndex < grid.slotRects.count) [snappedLanding addObject:grid.slotRects[slotIndex]];
                }
            }
            [self setEditGridLandingRects:snappedLanding forPage:dragPage overlay:overlay];
        } else {
            objc_setAssociatedObject(gesture, kERDragLandingOriginKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [self clearEditGridLandingRectsForOverlay:overlay];
        }

        // The proxy is the one geometry guaranteed to match what is visibly
        // under the finger. Use its unscaled frame for target acquisition so
        // edit-mode collection/grid translations cannot bias the drop row.
        CGPoint previewCenter = CGPointMake(CGRectGetMidX(draggedFrame), CGRectGetMidY(draggedFrame));
        UIViewController *previewTargetController = nil;
        CGFloat bestOverlap = 0.0;
        CGFloat previewDistance = CGFLOAT_MAX;
        NSDictionary<NSString *, NSValue *> *baseFrames = objc_getAssociatedObject(gesture, kERDragBaseFramesKey);
        for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
            NSString *candidateID = ERModuleIdentifier(candidate);
            if ([candidateID isEqualToString:sourceID]) continue;
            CGRect candidateFrame = [baseFrames[candidateID] CGRectValue];
            if (CGRectIsEmpty(candidateFrame)) continue;
            CGRect intersection = CGRectIntersection(draggedFrame, candidateFrame);
            CGFloat overlap = CGRectIsNull(intersection) ? 0.0 : CGRectGetWidth(intersection) * CGRectGetHeight(intersection);
            CGFloat requiredOverlap = MIN(CGRectGetWidth(draggedFrame) * CGRectGetHeight(draggedFrame), CGRectGetWidth(candidateFrame) * CGRectGetHeight(candidateFrame)) * 0.18;
            CGFloat distance = hypot(CGRectGetMidX(candidateFrame) - previewCenter.x, CGRectGetMidY(candidateFrame) - previewCenter.y);
            if (moved && overlap >= requiredOverlap && (overlap > bestOverlap + 1.0 || (fabs(overlap - bestOverlap) <= 1.0 && distance < previewDistance))) {
                bestOverlap = overlap;
                previewDistance = distance;
                previewTargetController = candidate;
            }
        }
        NSString *previewTargetID = ERModuleIdentifier(previewTargetController);
        NSString *previousTargetID = objc_getAssociatedObject(gesture, kERDragPreviewTargetIDKey);
        NSString *pendingTargetID = objc_getAssociatedObject(gesture, kERDragPendingTargetIDKey);
        BOOL previewLocked = [objc_getAssociatedObject(gesture, kERDragPreviewLockedKey) boolValue];
        if (!previewTargetID.length) {
            objc_setAssociatedObject(gesture, kERDragPendingTargetIDKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
            if (previousTargetID.length) {
                objc_setAssociatedObject(gesture, kERDragPreviewTargetIDKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
            }
            if (!previewLocked && previousTargetID.length) {
                [self applyLivePreviewOrder:objc_getAssociatedObject(gesture, kERDragBaseOrderKey) overlay:overlay];
            }
        }
        if (!previewLocked && previewTargetID.length && ![previewTargetID isEqualToString:previousTargetID] && ![previewTargetID isEqualToString:pendingTargetID]) {
            objc_setAssociatedObject(gesture, kERDragPendingTargetIDKey, previewTargetID, OBJC_ASSOCIATION_COPY_NONATOMIC);
            NSString *candidateTargetID = [previewTargetID copy];
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.06 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                NSString *stillPending = objc_getAssociatedObject(gesture, kERDragPendingTargetIDKey);
                if (gesture.state != UIGestureRecognizerStateChanged || ![stillPending isEqualToString:candidateTargetID]) return;
                NSMutableArray *previewOrder = [objc_getAssociatedObject(gesture, kERDragBaseOrderKey) mutableCopy];
                NSUInteger sourceIndex = [previewOrder indexOfObject:sourceID];
                NSUInteger targetIndex = [previewOrder indexOfObject:candidateTargetID];
                if (sourceIndex == NSNotFound || targetIndex == NSNotFound) return;
                [previewOrder exchangeObjectAtIndex:sourceIndex withObjectAtIndex:targetIndex];
                objc_setAssociatedObject(gesture, kERDragPreviewTargetIDKey, candidateTargetID, OBJC_ASSOCIATION_COPY_NONATOMIC);
                objc_setAssociatedObject(gesture, kERDragPreviewLockedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                [self applyLivePreviewOrder:previewOrder overlay:overlay];
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.22 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    NSString *committedTarget = objc_getAssociatedObject(gesture, kERDragPreviewTargetIDKey);
                    if (gesture.state == UIGestureRecognizerStateChanged && [committedTarget isEqualToString:candidateTargetID] && [self layoutHasIllegalOverlapInOverlay:overlay]) {
                        objc_setAssociatedObject(gesture, kERDragPreviewTargetIDKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
                        objc_setAssociatedObject(gesture, kERDragPendingTargetIDKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
                        [self applyLivePreviewOrder:objc_getAssociatedObject(gesture, kERDragBaseOrderKey) overlay:overlay];
                        [self clearEditGridLandingRectsForOverlay:overlay];
                    }
                });
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.26 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    objc_setAssociatedObject(gesture, kERDragPreviewLockedKey, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                });
            });
        }

    } else if (gesture.state == UIGestureRecognizerStateEnded || gesture.state == UIGestureRecognizerStateCancelled) {
        if (!moduleView || !sourceID.length) return;
        NSUInteger dragPage = MIN(gERCurrentPage, gERPageCount ? gERPageCount - 1 : 0);
        EREditGridView *grid = [self editGridForPage:dragPage overlay:overlay];
        if (!grid) grid = objc_getAssociatedObject(overlay, kEREditGridKey);
        UIView *previewTarget = objc_getAssociatedObject(gesture, kERDragPreviewTargetKey);
        BOOL moved = [objc_getAssociatedObject(gesture, kERDragMovedKey) boolValue];
        // Heuristic removal: a press that never became a drag and lifted near the
        // module's top-left corner (the remove bubble) is read as a remove. The
        // module is otherwise restored in place by the normal (no-target) path
        // below; the actual removal is fired from the settle block so it reuses
        // all of that teardown instead of duplicating it.
        __block BOOL heuristicRemove = NO;
        UIButton *heuristicRemoveButton = nil;
        if (!moved && gesture.state == UIGestureRecognizerStateEnded && gRemovalButtonsEnabled) {
            UIButton *removeButton = objc_getAssociatedObject(moduleView, kERRemoveButtonKey);
            if (removeButton) {
                CGPoint startPoint = [objc_getAssociatedObject(gesture, kERDragStartPointKey) CGPointValue];
                CGRect sourceFrame = CGRectNull;
                for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                    if ([ERModuleIdentifier(candidate) isEqualToString:sourceID]) { sourceFrame = ERVisibleModuleFrame(candidate, overlay); break; }
                }
                if (!CGRectIsNull(sourceFrame) && !CGRectIsEmpty(sourceFrame)) {
                    CGFloat cornerDistance = hypot(startPoint.x - CGRectGetMinX(sourceFrame), startPoint.y - CGRectGetMinY(sourceFrame));
                    if (cornerDistance <= kERRemoveTapCornerRadius) { heuristicRemove = YES; heuristicRemoveButton = removeButton; }
                }
            }
        }
        NSString *targetID = nil;
        if (moved) {
            // A normal quick release can arrive before the short preview dwell
            // promotes the newest candidate. The pending ID is already derived
            // from the current visible overlap, so it is the authoritative
            // release target; the committed preview is only the fallback.
            targetID = objc_getAssociatedObject(gesture, kERDragPendingTargetIDKey);
            if (!targetID.length) targetID = objc_getAssociatedObject(gesture, kERDragPreviewTargetIDKey);
        }
        NSMutableArray *order = [objc_getAssociatedObject(gesture, kERDragBaseOrderKey) mutableCopy];
        if (!order.count) order = [[self enabledModuleIdentifiers] mutableCopy];
        NSUInteger sourceIndex = [order indexOfObject:sourceID];
        NSUInteger targetIndex = [order indexOfObject:targetID];
        BOOL didSwap = sourceIndex != NSNotFound && targetIndex != NSNotFound && sourceIndex != targetIndex;
        NSArray<NSNumber *> *landingOrigin = moved ? objc_getAssociatedObject(gesture, kERDragLandingOriginKey) : nil;
        BOOL didBlankMove = NO;
        // 1.0.7-23：横屏编辑网格是 8 列 × 4 行（= 页内 32 圆位，且在顶部保留带之下），
        // 落点是**横屏格位**；写入前反算成等价的竖屏格位（折叠是双射），竖屏那套
        // 合法性 / 占用判定即可原样复用，横屏再按折叠渲染回同一格。
        // 写进哪本账本由「保存布局」开关决定（ERStoreOriginForIdentifier）。
        CCUILayoutPoint landingCell = {0, 0};
        if (landingOrigin.count >= 2) {
            landingCell = (CCUILayoutPoint){landingOrigin[0].unsignedIntegerValue, landingOrigin[1].unsignedIntegerValue};
            if (ERLandscapePresentationActive()) landingCell = ERPortraitCellFromLandscapeCell(landingCell);
        }
        if (landingOrigin.count >= 2) {
            didBlankMove = [self applyExplicitGridMoveFrom:sourceID
                                                  toOrigin:landingCell
                                                    onPage:dragPage
                                                   overlay:overlay];
            if (!didBlankMove) {
                didBlankMove = [self applyExplicitGridInsertionFrom:sourceID
                                                           toOrigin:landingCell
                                                             onPage:dragPage
                                                            maxRows:ERLandscapePresentationActive() ? kERMinimumGridRows : grid.rows
                                                            overlay:overlay];
            }
        }
        if (!didBlankMove && didSwap && [self layoutHasIllegalOverlapInOverlay:overlay]) {
            didSwap = NO;
            targetID = nil;
        }
        if (!didSwap) [self applyLivePreviewOrder:order overlay:overlay];
        if (!didBlankMove && didSwap) {
            BOOL appliedExplicitSwap = [self applyExplicitGridSwapFrom:sourceID to:targetID overlay:overlay];
            if (appliedExplicitSwap) {
                [self persistStoredOrderBySwappingSource:sourceID target:targetID];
            } else {
                // A rejected explicit footprint must return to its source. The
                // old ordered-provider fallback can repack differently sized
                // modules into an overlapping layout during a fast release.
                didSwap = NO;
                targetID = nil;
            }
        }
        // 1.0.9-40 · **回退 1.0.9-39 的「空白落点写入」**：那次写入没有做列带/边界校验，
        // 结果把落点写成越界值（如"绝对行 9"，而当时只有 2 页 = 8 行）→ 模块被放到不存在的页
        // → 表现为"拖完就看不见 / 出现在网格以外"。宁可保持原来的"复位"行为，也不产生坏数据。
        if (didBlankMove) didSwap = YES;
        UIButton *remove = objc_getAssociatedObject(moduleView, kERRemoveButtonKey);
        UIButton *resize = objc_getAssociatedObject(moduleView, kERResizeButtonKey);
        void (^restoreHiddenChrome)(void) = ^{
            NSArray<NSDictionary *> *hiddenChrome = objc_getAssociatedObject(gesture, kERDragHiddenChromeKey);
            for (NSDictionary *record in hiddenChrome) {
                UIView *view = record[@"view"];
                if (![view isKindOfClass:[UIView class]]) continue;
                view.hidden = [record[@"hidden"] boolValue];
                view.alpha = [record[@"alpha"] doubleValue];
            }
        };
        void (^finishSource)(void) = ^{
            UIViewController *sourceController = nil;
            for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                if (candidate.view == moduleView) { sourceController = candidate; break; }
            }
            CGRect moduleFrame = sourceController ? [sourceController.view convertRect:sourceController.view.bounds toView:overlay.view] : [moduleView convertRect:moduleView.bounds toView:overlay.view];
            [self positionEditControlsForModuleView:moduleView overlay:overlay overlayFrame:moduleFrame];
            restoreHiddenChrome();
            [UIView animateWithDuration:0.12 animations:^{ remove.alpha = 1.0; resize.alpha = 1.0; }];
        };
        if (didSwap) {
            // The settings provider immediately replaces/repositions the module
            // containers. Returning the outgoing view to its old frame with an
            // animation creates a visible fly-in from the drag destination.
            [UIView performWithoutAnimation:^{
                moduleView.transform = CGAffineTransformIdentity;
                moduleView.alpha = 0.0;
                UIVisualEffectView *dragBorder = objc_getAssociatedObject(moduleView, @selector(applyEditingToModule:editing:));
                dragBorder.transform = CGAffineTransformIdentity;
                dragBorder.alpha = 0.0;
                dragBorder.hidden = YES;
                previewTarget.transform = CGAffineTransformIdentity;
            }];
        } else {
            [UIView animateWithDuration:0.24 animations:^{
                moduleView.transform = CGAffineTransformIdentity;
                moduleView.alpha = 1.0;
                UIVisualEffectView *dragBorder = objc_getAssociatedObject(moduleView, @selector(applyEditingToModule:editing:));
                dragBorder.transform = CGAffineTransformIdentity;
                dragBorder.hidden = NO;
                previewTarget.transform = CGAffineTransformIdentity;
            } completion:^(__unused BOOL finished) { finishSource(); }];
        }
        UIView *dragProxy = objc_getAssociatedObject(gesture, kERDragProxyKey);
        if (didSwap && dragProxy) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                UIViewController *settledSource = nil;
                for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                    if ([ERModuleIdentifier(candidate) isEqualToString:sourceID]) { settledSource = candidate; break; }
                }
                CGRect destination = settledSource ? ERVisibleModuleFrame(settledSource, overlay) : dragProxy.frame;
                settledSource.view.alpha = 0.0;
                UIVisualEffectView *settledBorder = objc_getAssociatedObject(settledSource.view, @selector(applyEditingToModule:editing:));
                settledBorder.alpha = 0.0;
                settledBorder.hidden = YES;
                CGRect visibleProxyFrame = dragProxy.layer.presentationLayer ? ((CALayer *)dragProxy.layer.presentationLayer).frame : dragProxy.frame;
                [UIView performWithoutAnimation:^{ dragProxy.transform = CGAffineTransformIdentity; dragProxy.frame = visibleProxyFrame; }];
                [UIView animateWithDuration:0.20 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
                    dragProxy.frame = destination;
                    dragProxy.alpha = 0.88;
                } completion:^(__unused BOOL finished) {
                    settledSource.view.alpha = 1.0;
                    settledBorder.alpha = 1.0;
                    settledBorder.hidden = NO;
                    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                        [UIView animateWithDuration:0.18 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
                            dragProxy.alpha = 0.0;
                        } completion:^(__unused BOOL finished) {
                            [dragProxy removeFromSuperview];
                        }];
                    });
                }];
            });
        } else if (dragProxy) {
            [UIView animateWithDuration:0.20 animations:^{ dragProxy.transform = CGAffineTransformIdentity; } completion:^(__unused BOOL finished) {
                moduleView.alpha = 1.0;
                UIVisualEffectView *dragBorder = objc_getAssociatedObject(moduleView, @selector(applyEditingToModule:editing:));
                dragBorder.alpha = 1.0;
                dragBorder.hidden = NO;
                restoreHiddenChrome();
                [dragProxy removeFromSuperview];
            }];
        }
        // The provider relays out both sides of a swap asynchronously. Removal
        // controls are now wrapper-hosted, so resynchronize every control as
        // those new module frames settle instead of updating only the source.
        for (NSNumber *delay in @[@0.02, @0.14, @0.30]) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                NSMutableSet<UIButton *> *validButtons = [NSMutableSet set];
                for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                    // Swaps may create replacement containers after their first
                    // layout pass. Reapply both the refined clipping radius and
                    // edit chrome to those new views before they become visible.
                    [self applyEditingToModule:candidate editing:YES];
                    UIButton *candidateRemove = objc_getAssociatedObject(candidate.view, kERRemoveButtonKey);
                    if (candidateRemove) [validButtons addObject:candidateRemove];
                }
                for (UIView *subview in [overlay.view.subviews copy]) {
                    if (subview.tag == kERRemoveButtonTag && ![validButtons containsObject:(UIButton *)subview]) [subview removeFromSuperview];
                }
                [UIView animateWithDuration:0.18 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
                    for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                        UIButton *candidateRemove = objc_getAssociatedObject(candidate.view, kERRemoveButtonKey);
                        if (!candidateRemove || candidateRemove.hidden) continue;
                        CGRect candidateFrame = [candidate.view convertRect:candidate.view.bounds toView:overlay.view];
                        [self positionEditControlsForModuleView:candidate.view overlay:overlay overlayFrame:candidateFrame];
                    }
                } completion:nil];
                UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
                if (collection && gEditModeActive) {
                    [self prepareGridForOverlay:overlay collection:collection];
                    NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
                    for (EREditGridView *pageGrid in pageGrids.allValues) pageGrid.alpha = gERPagerScrubbingActive ? gERPagerHeldAlphaFactor : 1.0;
                    EREditTouchShield *shield = (EREditTouchShield *)[overlay.view viewWithTag:kEREditTouchShieldTag];
                    if (shield) [overlay.view bringSubviewToFront:shield];
                    UIButton *settledAddControl = (UIButton *)[overlay.view viewWithTag:kERAddControlButtonTag];
                    if (settledAddControl) [overlay.view bringSubviewToFront:settledAddControl];
                    for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                        UIButton *candidateRemove = objc_getAssociatedObject(candidate.view, kERRemoveButtonKey);
                        UIButton *candidateResize = objc_getAssociatedObject(candidate.view, kERResizeButtonKey);
                        if (candidateRemove) [candidateRemove.superview bringSubviewToFront:candidateRemove];
                        if (candidateResize) [candidateResize.superview bringSubviewToFront:candidateResize];
                    }
                }
            });
        }
        [self clearEditGridLandingRectsForOverlay:overlay];
        CGRect originalFrame = [objc_getAssociatedObject(gesture, kERDragStartFrameKey) CGRectValue];
        if (!didSwap && !didBlankMove && !CGRectIsEmpty(originalFrame)) grid.occupiedRects = [grid.occupiedRects arrayByAddingObject:[NSValue valueWithCGRect:originalFrame]];
        [grid setNeedsDisplay];
        objc_setAssociatedObject(gesture, @selector(moduleControllerForShield:), nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, @selector(modulePanned:), @"overlayPan", OBJC_ASSOCIATION_COPY_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragStartFrameKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragStartPointKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragPreviewTargetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragProxyKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragBaseOrderKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragPreviewTargetIDKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragProxyStartFrameKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragBaseFramesKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragPendingTargetIDKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragPreviewLockedKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragGrabOffsetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragLandingOriginKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragStartPageKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragEdgeDwellKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragEdgeDwellDirectionKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragMovedKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(gesture, kERDragHiddenChromeKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        UIViewController *settleOverlay = overlay;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.35 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            gERDragInProgress = NO;
            gERActiveDragModuleView = nil;
            gERActiveDragModuleIdentifier = nil;
            // A heuristic remove (tap near the top-left corner) reuses the normal
            // restore-in-place teardown above, then removes the module here so no
            // drag bookkeeping is duplicated.
            if (heuristicRemove && heuristicRemoveButton) [self removeTapped:heuristicRemoveButton];
            // Re-sanitise the whole layout once the drop has settled. Each commit
            // path (swap / move / insertion) only validates the page it touched;
            // this guarantees the persisted layout is globally consistent — every
            // control placed, nothing overlapping, no stale entries — before the
            // next Control Center presentation can read it.
            [self normalizePagedLayoutForOverlay:settleOverlay];
            [self updatePagedModuleVisibilityForOverlay:settleOverlay showAdjacent:NO];
            [self updateEditControlFramesForOverlay:settleOverlay];
        });
    }
}

- (void)applyEditingToModule:(UIViewController *)module editing:(BOOL)editing {
    UIView *view = module.view;
    if (!view) return;
    [self applyRefinedLookToModule:module];
    if (editing && gEnabled) {
        view.layer.cornerRadius = [self editingModuleCornerRadiusForSize:view.bounds.size];
    }
    UIVisualEffectView *border = objc_getAssociatedObject(view, @selector(applyEditingToModule:editing:));
    BOOL ownsLiveResize = gERResizeInProgress && view == gERActiveResizeModuleView;
    UIView *shield = [view viewWithTag:kEREditShieldTag];
    UIButton *remove = objc_getAssociatedObject(view, kERRemoveButtonKey);
    UIButton *resize = objc_getAssociatedObject(view, kERResizeButtonKey);
    if (editing && gModuleBordersEnabled) {
        if (!border) {
            border = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemUltraThinMaterialLight]];
            border.userInteractionEnabled = NO;
            objc_setAssociatedObject(view, @selector(applyEditingToModule:editing:), border, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        UIView *wrapper = view.superview;
        if (wrapper && border.superview != wrapper) {
            [border removeFromSuperview];
            [wrapper insertSubview:border belowSubview:view];
        }
        if (!ownsLiveResize) {
            CGRect stableModuleFrame = CGRectMake(CGRectGetMinX(view.frame), CGRectGetMinY(view.frame), CGRectGetWidth(view.bounds), CGRectGetHeight(view.bounds));
            [self configureEditingBorder:border moduleFrame:stableModuleFrame];
        }
        border.hidden = NO;
        border.alpha = 1.0;
        if (gBorderBreathingEnabled && ![border.layer animationForKey:@"EchoRebornBreathing"]) {
            CABasicAnimation *animation = [CABasicAnimation animationWithKeyPath:@"opacity"];
            animation.fromValue = @0.24; animation.toValue = @1.0; animation.duration = 0.7;
            animation.autoreverses = YES; animation.repeatCount = HUGE_VALF;
            [border.layer addAnimation:animation forKey:@"EchoRebornBreathing"];
        }
    } else if (border) { border.hidden = YES; [border.layer removeAllAnimations]; }

    if (editing && !shield) {
        shield = [[UIView alloc] initWithFrame:view.bounds];
        shield.tag = kEREditShieldTag;
        shield.backgroundColor = UIColor.clearColor;
        shield.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        [view addSubview:shield];
    }
    shield.hidden = !editing;
    if (gEnabled) view.layer.masksToBounds = YES;

    NSString *moduleIdentifier = ERModuleIdentifier(module);
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    UIView *chromeHost = [self editChromeHostForModuleView:view overlay:overlay];
    UIView *resizeHost = chromeHost ?: overlay.view;
    BOOL supportsResize = [self moduleIdentifierSupportsResizing:moduleIdentifier];
    if (ERIsActiveDragModuleIdentifier(moduleIdentifier)) {
        [CATransaction begin];
        [CATransaction setDisableActions:YES];
        view.layer.opacity = 0.0f;
        [CATransaction commit];
        border.hidden = YES;
        border.alpha = 0.0;
        remove.hidden = YES;
        remove.alpha = 0.0;
        resize.hidden = YES;
        resize.alpha = 0.0;
        return;
    }
    if (editing && supportsResize) {
        if (!resize) {
            resize = [ERExpandedHitButton buttonWithType:UIButtonTypeCustom];
            resize.tag = kERResizeButtonTag;
            resize.accessibilityIdentifier = @"EchoRebornResizeHandle";
            resize.backgroundColor = UIColor.clearColor;
            resize.autoresizingMask = UIViewAutoresizingFlexibleTopMargin | UIViewAutoresizingFlexibleLeftMargin;
            resize.clipsToBounds = NO;
            UIBlurEffect *grabberBlur = [UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThinMaterialLight];
            UIVisualEffectView *grabberMaterial = [[UIVisualEffectView alloc] initWithEffect:grabberBlur];
            grabberMaterial.tag = kERResizeMaterialTag;
            grabberMaterial.frame = resize.bounds;
            grabberMaterial.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
            grabberMaterial.userInteractionEnabled = NO;
            [resize addSubview:grabberMaterial];
            CAShapeLayer *pill = [CAShapeLayer layer];
            pill.name = @"EchoRebornResizePill";
            pill.fillColor = UIColor.clearColor.CGColor;
            pill.strokeColor = [UIColor.whiteColor colorWithAlphaComponent:0.82].CGColor;
            pill.lineWidth = 12.5;
            pill.lineCap = kCALineCapRound;
            pill.lineJoin = kCALineJoinRound;
            [resize.layer addSublayer:pill];
            UIPanGestureRecognizer *resizePan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(resizePanned:)];
            resizePan.maximumNumberOfTouches = 1;
            resizePan.cancelsTouchesInView = YES;
            resizePan.delegate = self;
            [resize addGestureRecognizer:resizePan];
            objc_setAssociatedObject(resize, @selector(resizePanned:), moduleIdentifier, OBJC_ASSOCIATION_COPY_NONATOMIC);
            objc_setAssociatedObject(resize, kERRemoveModuleViewKey, view, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(view, kERResizeButtonKey, resize, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [resizeHost addSubview:resize];
        }
        objc_setAssociatedObject(resize, @selector(resizePanned:), moduleIdentifier, OBJC_ASSOCIATION_COPY_NONATOMIC);
        NSString *resizeTarget = ERFriendlyNameForIdentifier(moduleIdentifier) ?: (moduleIdentifier.lastPathComponent ?: @"控制项");
        resize.accessibilityLabel = [NSString stringWithFormat:@"调整 %@ 大小", resizeTarget];
        resize.accessibilityHint = @"拖动以更改控制项大小";
        if (resizeHost && resize.superview != resizeHost) {
            [resize removeFromSuperview];
            [resizeHost addSubview:resize];
        }
        CGRect moduleFrame = [view convertRect:view.bounds toView:overlay.view];
        [self positionEditControlsForModuleView:view overlay:overlay overlayFrame:moduleFrame];
        // A broad circular arc follows the module's continuous bottom-right
        // corner instead of forming a tight, unrelated elbow. Its centerline
        // sits on the edit border so the ring visually bisects the grabber.
        UIBezierPath *cornerPath = [UIBezierPath bezierPath];
        [cornerPath moveToPoint:CGPointMake(20.29, 40.01)];
        [cornerPath addCurveToPoint:CGPointMake(40.01, 20.29)
                      controlPoint1:CGPointMake(31.20, 40.01)
                      controlPoint2:CGPointMake(40.01, 31.20)];
        UIVisualEffectView *grabberMaterial = [resize viewWithTag:kERResizeMaterialTag];
        // 1.0.7-13：弧线宽度**保持原生 12.5pt 不变** —— 用户要的只是液态材质，
        // 不是改外形（上一版收细到 5pt 是我过度发挥，已回退）。玻璃模式只替换
        // 弧带材质：毛玻璃 → 玻璃，粗细、形状、位置一律不动。
        BOOL handleGlassOn = EREditBadgeGlassOn(@"ControlCenter.TopButtonGlass");
        CGFloat ringWidth = 12.5;
        CGFloat bandWidth = 12.0;   // 毛玻璃/玻璃弧带比弧线略宽一点（原生值）
        CAShapeLayer *materialMask = [CAShapeLayer layer];
        materialMask.path = cornerPath.CGPath;
        materialMask.fillColor = UIColor.clearColor.CGColor;
        materialMask.strokeColor = UIColor.blackColor.CGColor;
        // Keep the live material wholly beneath the translucent 12.5pt pill.
        // A wider mask leaked past the stroke over dark modules and read as a
        // one-sided outline even though the foreground shape had no border.
        materialMask.lineWidth = bandWidth;
        materialMask.lineCap = kCALineCapRound;
        materialMask.lineJoin = kCALineJoinRound;
        grabberMaterial.layer.mask = materialMask;
        for (CALayer *layer in [resize.layer.sublayers copy]) {
            if ([layer.name isEqualToString:@"EchoRebornResizeBacking"]) [layer removeFromSuperlayer];
            else if ([layer.name isEqualToString:@"EchoRebornResizePill"] && [layer isKindOfClass:[CAShapeLayer class]]) {
                ((CAShapeLayer *)layer).path = cornerPath.CGPath;
                ((CAShapeLayer *)layer).lineWidth = ringWidth;
            }
        }
        objc_setAssociatedObject(resize, kERSmallModuleChromeKey,
            @(MIN(CGRectGetWidth(view.bounds), CGRectGetHeight(view.bounds)) < 100.0), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        resize.hidden = NO;
        resize.alpha = 1.0;
        [resize.superview bringSubviewToFront:resize];
        // 1.0.7-11：扶手图标做成与 ⊖ 1.0.7-9 相同的效果（玻璃替换毛玻璃弧带）。
        EREditHandleApplyGlass(resize, cornerPath, bandWidth);
    } else if (resize) {
        resize.hidden = YES;
    }

    if (editing && gRemovalButtonsEnabled) {
        NSString *identifier = moduleIdentifier;
        if (!remove && identifier.length) {
            remove = [ERExpandedHitButton buttonWithType:UIButtonTypeCustom];
            remove.tag = kERRemoveButtonTag;
            remove.backgroundColor = UIColor.clearColor;
            remove.tintColor = UIColor.blackColor;
            UIView *bubble = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterialLight]];
            bubble.frame = CGRectMake(9.0, 9.0, 26.0, 26.0);
            bubble.layer.cornerRadius = 13.0; bubble.clipsToBounds = YES; bubble.userInteractionEnabled = NO;
            // 1.0.7-8：打 tag，供 EREditBadgeApplyGlass 定位（LiquidAss 同款玻璃）。
            bubble.tag = kEREditBadgeBubbleTag;
            [remove insertSubview:bubble atIndex:0];
            UIImageView *minusGlyph = [[UIImageView alloc] initWithImage:[[self symbol:@"minus" size:13.0] imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate]];
            minusGlyph.tintColor = UIColor.blackColor;
            minusGlyph.contentMode = UIViewContentModeCenter;
            minusGlyph.frame = CGRectMake(9.0, 9.0, 26.0, 26.0);
            minusGlyph.userInteractionEnabled = NO;
            minusGlyph.tag = kEREditBadgeGlyphTag;
            [remove addSubview:minusGlyph];
            // 1.0.7-8：按两个子开关加液态玻璃（PillHUD 同款：玻璃自建 + applyFilters）。
            EREditBadgeApplyGlass(remove);
            [remove addTarget:self action:@selector(removeTapped:) forControlEvents:UIControlEventTouchUpInside];
            objc_setAssociatedObject(remove, @selector(removeTapped:), identifier, OBJC_ASSOCIATION_COPY_NONATOMIC);
            objc_setAssociatedObject(remove, kERRemoveModuleViewKey, view, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(view, kERRemoveButtonKey, remove, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [chromeHost addSubview:remove];
        }
        if (chromeHost && remove.superview != chromeHost) {
            [remove removeFromSuperview];
            [chromeHost addSubview:remove];
        }
        if (identifier.length) objc_setAssociatedObject(remove, @selector(removeTapped:), identifier, OBJC_ASSOCIATION_COPY_NONATOMIC);
        objc_setAssociatedObject(remove, kERRemoveModuleViewKey, view, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        // 1.0.7-8：每次编辑态刷新都调（幂等，稳态只是几次比较）。
        // 设置页改开关后不用重建按钮即可生效。
        EREditBadgeApplyGlass(remove);
        // The remove bubble is now a visual affordance only; it must not swallow
        // touches or the module underneath it can't be picked up. Removal is
        // triggered heuristically from the drag recogniser on drop (a tap that
        // never moved, released near this top-left corner).
        remove.userInteractionEnabled = NO;
        CGRect moduleFrame = [view convertRect:view.bounds toView:overlay.view];
        [self positionEditControlsForModuleView:view overlay:overlay overlayFrame:moduleFrame];
        objc_setAssociatedObject(remove, kERSmallModuleChromeKey,
            @(MIN(CGRectGetWidth(view.bounds), CGRectGetHeight(view.bounds)) < 100.0), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [remove.superview bringSubviewToFront:remove];
        remove.hidden = NO;
        remove.alpha = 1.0;
    } else { remove.hidden = YES; }
}

- (void)collectEnabledNativeEditingGesturesFromView:(UIView *)view into:(NSMutableArray<UIGestureRecognizer *> *)gestures {
    for (UIGestureRecognizer *gesture in view.gestureRecognizers) {
        NSString *gestureName = NSStringFromClass(gesture.class);
        BOOL blocksEditing = [gesture isKindOfClass:[UITapGestureRecognizer class]] ||
            [gesture isKindOfClass:[UILongPressGestureRecognizer class]] ||
            [gestureName localizedCaseInsensitiveContainsString:@"force"] ||
            [gestureName localizedCaseInsensitiveContainsString:@"click"] ||
            [gestureName localizedCaseInsensitiveContainsString:@"context"];
        if (blocksEditing && gesture.enabled && !objc_getAssociatedObject(gesture, kEROwnGestureKey)) {
            [gestures addObject:gesture];
        }
    }
    for (UIView *subview in view.subviews) [self collectEnabledNativeEditingGesturesFromView:subview into:gestures];
}

- (void)restoreEchoRebornDisabledGesturesFromView:(UIView *)view {
    for (UIGestureRecognizer *gesture in view.gestureRecognizers) {
        if ([objc_getAssociatedObject(gesture, kERDisabledGesturesKey) boolValue]) {
            gesture.enabled = YES;
            objc_setAssociatedObject(gesture, kERDisabledGesturesKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
    }
    for (UIView *subview in view.subviews) [self restoreEchoRebornDisabledGesturesFromView:subview];
}

- (void)setNativeDismissTapGesturesEnabled:(BOOL)enabled forOverlay:(UIViewController *)overlay {
    if (!enabled) {
        NSMutableArray<UIGestureRecognizer *> *disabled = [NSMutableArray array];
        [self collectEnabledNativeEditingGesturesFromView:overlay.view into:disabled];
        for (UIGestureRecognizer *gesture in disabled) {
            objc_setAssociatedObject(gesture, kERDisabledGesturesKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            gesture.enabled = NO;
        }
        objc_setAssociatedObject(overlay, kERDisabledGesturesKey, disabled, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    } else {
        NSArray<UIGestureRecognizer *> *disabled = objc_getAssociatedObject(overlay, kERDisabledGesturesKey);
        for (UIGestureRecognizer *gesture in disabled) gesture.enabled = YES;
        [self restoreEchoRebornDisabledGesturesFromView:overlay.view];
        objc_setAssociatedObject(overlay, kERDisabledGesturesKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
}

- (NSArray<UIView *> *)chromeViewsInOverlay:(UIViewController *)overlay excludingCollection:(UIViewController *)collection {
    NSMutableArray<UIView *> *views = [NSMutableArray array];
    UIView *host = [overlay.view viewWithTag:181000];
    // A host nested under native header chrome inherits that chrome's transform
    // and alpha. Only animate it directly on the compatibility fallback path.
    if (host && host.superview == overlay.view) [views addObject:host];
    UIView *topFade = [overlay.view viewWithTag:kERTopFadeTag];
    if (topFade) [views addObject:topFade];
    for (UIViewController *child in overlay.childViewControllers) {
        if (child == collection) continue;
        NSString *name = NSStringFromClass(child.class);
        if ([name containsString:@"SensorAttribution"] || [name containsString:@"HeaderPocket"]) {
            if (child.view) [views addObject:child.view];
        }
    }
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithArray:overlay.view.subviews];
    while (queue.count) {
        UIView *view = queue.firstObject;
        [queue removeObjectAtIndex:0];
        NSString *name = NSStringFromClass(view.class);
        BOOL headerPocket = [name containsString:@"HeaderPocket"];
        if (headerPocket && view != collection.view && view != host) [views addObject:view];
        [queue addObjectsFromArray:view.subviews];
    }
    return [[NSOrderedSet orderedSetWithArray:views] array];
}

- (void)setHeaderChromeHiddenForScrubbing:(BOOL)hidden overlay:(UIViewController *)overlay animated:(BOOL)animated {
    if (!overlay) return;
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    NSMutableArray<UIView *> *headerViews = [[self chromeViewsInOverlay:overlay excludingCollection:collection] mutableCopy];
    [headerViews filterUsingPredicate:[NSPredicate predicateWithBlock:^BOOL(UIView *view, __unused NSDictionary *bindings) {
        return view.tag != kERTopFadeTag;
    }]];
    // Capture the resting alpha only while the chrome is actually shown. The
    // capture used to be a one-shot, so a scrub that ran before the chrome had
    // settled recorded 0.0 as the "resting" value and every later restore
    // re-applied it — the status bar stayed invisible until the overlay was
    // rebuilt. Re-capturing when the view is visible keeps the record honest.
    if (!hidden) {
        for (UIView *view in headerViews) [self capturePresentationStateForView:view];
    }
    void (^changes)(void) = ^{
        for (UIView *view in headerViews) {
            CGFloat restingAlpha = [objc_getAssociatedObject(view, kEROriginalAlphaKey) doubleValue];
            // A recorded resting alpha of 0 is never legitimate for visible
            // chrome; fall back to fully visible rather than hiding it.
            if (!hidden && restingAlpha <= 0.001) restingAlpha = 1.0;
            view.alpha = hidden || gEditModeActive ? 0.0 : restingAlpha;
        }
    };
    if (animated) {
        [UIView animateWithDuration:hidden ? 0.16 : 0.26
                              delay:0.0
                            options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction
                         animations:changes
                         completion:nil];
    } else {
        changes();
    }
}

- (void)capturePresentationStateForView:(UIView *)view {
    // The alpha record is refreshed whenever the view is visible; the transform
    // records stay one-shot because they describe the pre-EchoReborning geometry,
    // which does not change while a page is being scrubbed.
    if (!objc_getAssociatedObject(view, kEROriginalTransformKey)) {
        objc_setAssociatedObject(view, kEROriginalTransformKey, [NSValue valueWithCGAffineTransform:view.transform], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (view.alpha > 0.001 && !gEditModeActive) {
        objc_setAssociatedObject(view, kEROriginalAlphaKey, @(view.alpha), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    } else if (!objc_getAssociatedObject(view, kEROriginalAlphaKey)) {
        objc_setAssociatedObject(view, kEROriginalAlphaKey, @(view.alpha), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (!objc_getAssociatedObject(view, kEROriginalSublayerTransformKey)) {
        objc_setAssociatedObject(view, kEROriginalSublayerTransformKey, [NSValue valueWithCATransform3D:view.layer.sublayerTransform], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
}

- (EREditGridView *)editGridForPage:(NSUInteger)page overlay:(UIViewController *)overlay {
    NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
    EREditGridView *grid = pageGrids[@(page)];
    if (!grid && page == gERCurrentPage) grid = objc_getAssociatedObject(overlay, kEREditGridKey);
    return grid;
}

- (void)clearEditGridLandingRectsForOverlay:(UIViewController *)overlay {
    NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
    for (EREditGridView *grid in pageGrids.allValues) grid.landingRects = @[];
    EREditGridView *currentGrid = objc_getAssociatedObject(overlay, kEREditGridKey);
    if (currentGrid && ![pageGrids.allValues containsObject:currentGrid]) currentGrid.landingRects = @[];
}

- (void)setEditGridLandingRects:(NSArray<NSValue *> *)rects forPage:(NSUInteger)page overlay:(UIViewController *)overlay {
    [self clearEditGridLandingRectsForOverlay:overlay];
    EREditGridView *grid = [self editGridForPage:page overlay:overlay];
    if (grid) grid.landingRects = rects ?: @[];
}

- (void)updateEditPageGridTransformsForOverlay:(UIViewController *)overlay {
    NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
    UIView *gridStack = objc_getAssociatedObject(overlay, kEREditGridStackKey);
    if (!pageGrids.count || !gridStack) return;
    CGFloat span = ERVisualPageSpan();
    CGFloat scrollY = (CGFloat)gERCurrentPage * span - gERPagerInteractiveTranslation;
    CGRect bounds = gridStack.bounds;
    bounds.origin = CGPointMake(0.0, scrollY);
    gridStack.bounds = bounds;
    // 1.0.9-14 · **编辑网格裁剪到中间有效区**（用户截图：顶部保留带/底部安全区里也能看到落点圆）。
    // 用 mask layer 把可见范围限制在「保留带之下、安全区之上」，纯显示层裁剪：
    //   · 不动任何网格几何（避免像 1.0.9-9 那样改坏翻页）
    //   · 相邻页伸进来的圆也一并被裁掉
    {
        UIEdgeInsets editInsets = overlay.view.safeAreaInsets;
        CGFloat topLimit = MAX(kERLandscapeReservedTop, editInsets.top);
        CGFloat bottomLimit = MAX(21.0, editInsets.bottom);
        CGFloat stackHeight = CGRectGetHeight(gridStack.bounds);
        CGFloat maskHeight = MAX(0.0, stackHeight - topLimit - bottomLimit);
        CALayer *maskLayer = gridStack.layer.mask;
        if (!maskLayer) {
            maskLayer = [CALayer layer];
            maskLayer.backgroundColor = UIColor.blackColor.CGColor;
            gridStack.layer.mask = maskLayer;
        }
        // mask 位于 layer 坐标空间，随 bounds.origin 平移 → 加上 scrollY 补偿，屏幕位置恒定
        maskLayer.frame = CGRectMake(0.0, scrollY + topLimit,
                                     CGRectGetWidth(gridStack.bounds), maskHeight);
    }
    gridStack.layer.transform = CATransform3DIdentity;
    gridStack.layer.sublayerTransform = CATransform3DIdentity;
    if (gERPagerScrubbingActive) {
        UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
        CGPoint overlayCenter = CGPointMake(CGRectGetMidX(overlay.view.bounds), CGRectGetMidY(overlay.view.bounds));
        CGPoint scaleCenter = overlayCenter;
        if (collection.view && collection.view.superview) {
            scaleCenter = [collection.view.superview convertPoint:collection.view.center toView:overlay.view];
        }
        CGFloat scaleX = gERPagerHeldScale * gERPagerJelloScaleX;
        CGFloat scaleY = gERPagerHeldScale * gERPagerJelloScaleY;
        CGFloat compensationX = (overlayCenter.x - scaleCenter.x) * (1.0 - scaleX);
        CGFloat compensationY = (overlayCenter.y - scaleCenter.y) * (1.0 - scaleY);
        gridStack.transform = CGAffineTransformScale(CGAffineTransformMakeTranslation(compensationX, compensationY),
                                                     scaleX,
                                                     scaleY);
    } else {
        gridStack.transform = CGAffineTransformIdentity;
    }
    gridStack.alpha = gEditModeActive ? (gERPagerScrubbingActive ? gERPagerHeldAlphaFactor : 1.0) : 0.0;
    gridStack.hidden = !gEditModeActive || gERExpandedModuleOpen;
    for (NSNumber *pageKey in pageGrids) {
        EREditGridView *grid = pageGrids[pageKey];
        grid.transform = CGAffineTransformIdentity;
        grid.alpha = 1.0;
        grid.hidden = !gEditModeActive || gERExpandedModuleOpen;
        // 1.0.9-12 · **彻底移除「按页隐藏」**：两版尝试（单值隐藏 / 当前+下一页）都改坏了 ——
        // 用户实测「234 页看不见」正是被它挡掉的。编辑网格的可见性回到最初逻辑，
        // 页与页之间的重叠问题改由**几何/裁剪**层面处理（不再用显示开关）。
    }
    // 1.0.6-9（第 1 条）：编辑模式下「32 个圆」的对齐探针。
    //
    // 落点圆是本 tweak 自绘的（EREditGridView），它的位置由三层决定：
    //   ① build 期：slotRects 的基准 cachedBase（prepareGridForOverlay: 反推出来的）；
    //   ② 本函数：gridStack.bounds.origin.y（翻页位移）；
    //   ③ 本函数：gridStack 的 transform（抓取态缩放/补偿）。
    // 任何一层和原生模块的实际位置不重合，用户看到的就是「圆和模块对不上」。这里把三层
    // 的数值一次打全，并附上「第一格圆换算到覆盖层坐标后的实际位置」—— 只要它和原生
    // 第一格不重合，就能立刻断定是哪一层跑偏，不必再猜。
    // 翻页抓取期间本函数每帧都被调到、且各层数值连续变化，落日志会淹掉导出文件；
    // 第 1 条报的是「编辑模式下拖动磁贴」，与翻页抓取无关，所以抓取期间不打。
    if (gEditModeActive && !gERPagerScrubbingActive) {
        EREditGridView *probe = [self editGridForPage:gERCurrentPage overlay:overlay];
        NSValue *firstSlot = probe.slotRects.firstObject;
        CGRect slotInOverlay = CGRectZero;
        if (firstSlot) slotInOverlay = [probe convertRect:firstSlot.CGRectValue toView:overlay.view];
        NSString *state = [NSString stringWithFormat:@"page=%lu y=%.1f sub=%.1f tr={%.1f,%.1f} slot0={%.1f,%.1f,%.0fx%.0f} slots=%lu occ=%lu drag=%d src=%@",
                           (unsigned long)gERCurrentPage, gridStack.bounds.origin.y,
                           gridStack.layer.sublayerTransform.m42,
                           gridStack.transform.tx, gridStack.transform.ty,
                           slotInOverlay.origin.x, slotInOverlay.origin.y,
                           slotInOverlay.size.width, slotInOverlay.size.height,
                           (unsigned long)probe.slotRects.count, (unsigned long)probe.occupiedRects.count,
                           gERDragInProgress ? 1 : 0, gERActiveDragModuleIdentifier ?: @"-"];
        if (![objc_getAssociatedObject(overlay, kEREditGridProbeStateKey) isEqual:state]) {
            objc_setAssociatedObject(overlay, kEREditGridProbeStateKey, state, OBJC_ASSOCIATION_COPY_NONATOMIC);
            ERLogInfo(@"EREDITGRID ver=1.0.9-103 %@", state);
        }
    }
}

- (EREditGridView *)prepareGridForOverlay:(UIViewController *)overlay collection:(UIViewController *)collection {
    CGFloat span = ERVisualPageSpan();
    NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
    if (!pageGrids) {
        pageGrids = [NSMutableDictionary dictionary];
        objc_setAssociatedObject(overlay, kEREditPageGridsKey, pageGrids, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    UIView *gridStack = objc_getAssociatedObject(overlay, kEREditGridStackKey);
    if (!gridStack) {
        gridStack = [[UIView alloc] initWithFrame:overlay.view.bounds];
        gridStack.tag = kEREditGridTag;
        gridStack.backgroundColor = UIColor.clearColor;
        gridStack.opaque = NO;
        gridStack.clipsToBounds = YES;
        gridStack.userInteractionEnabled = NO;
        gridStack.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        objc_setAssociatedObject(overlay, kEREditGridStackKey, gridStack, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (gridStack.superview != overlay.view) {
        [gridStack removeFromSuperview];
        [overlay.view insertSubview:gridStack aboveSubview:collection.view ?: overlay.view.subviews.firstObject];
    }
    gridStack.frame = overlay.view.bounds;
    gridStack.layer.transform = CATransform3DIdentity;
    gridStack.layer.sublayerTransform = CATransform3DIdentity;
    NSArray<UIViewController *> *modules = ERCollectModuleControllers(overlay);
    NSMutableDictionary<NSNumber *, NSMutableIndexSet *> *occupiedIndexesByPage = [NSMutableDictionary dictionary];
    NSMutableDictionary<NSNumber *, NSValue *> *baseByPage = [NSMutableDictionary dictionary];
    CGPoint fallbackBase = CGPointMake(CGFLOAT_MAX, CGFLOAT_MAX);
    for (UIViewController *module in modules) {
        NSString *identifier = ERModuleIdentifier(module);
        NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!nativeValue) continue;
        // 1.0.6-9（第 1 条）：**正在被拖动的模块不能参与基准反推**。
        //
        // 下面这一段是对所有模块的 convertRect 结果取 MIN 来反推网格原点。拖动中的
        // 模块 frame 正随手指跑，一旦它离开原位，MIN 就被它带走 —— 整个编辑网格的
        // 基准随之偏移，32 个落点圆整体错位（用户报的「一拖动就出现底部 32 个圆、
        // 布局错误」）。更糟的是这个被污染的基准还会被写进 kEREditGridBaseOriginKey
        // 一直留着，松手之后仍然用错基准，直到下一次重建网格。
        //
        // 本文件其它位置（分页可见性、编辑 chrome、1.0.6-9 的锚点选择）早就用
        // ERIsActiveDragModuleIdentifier 排除拖动源，只有这里漏了。
        if (identifier.length && ERIsActiveDragModuleIdentifier(identifier)) continue;
        CCUILayoutRect logical = {};
        [nativeValue getValue:&logical];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) logical.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *size = gERCustomSizes[identifier];
        if (size.count >= 2) logical.size = (CCUILayoutSize){size[0].unsignedIntegerValue, size[1].unsignedIntegerValue};
        CGRect frame = [module.view convertRect:module.view.bounds toView:overlay.view];
        if (CGRectIsEmpty(frame)) continue;
        NSUInteger page = ERPageForRect(logical);
        NSUInteger localRow = logical.origin.y % kERMinimumGridRows;
        NSUInteger layoutColumn = logical.origin.x;
        if (ERLandscapePresentationActive() && localRow >= kERLandscapeBlockRows) {
            // 同 gridBaseOriginForOverlay：横屏右块需按列 +4、行 -4 换算后再反推。
            layoutColumn += kERLandscapeBlockColumns;
            localRow -= kERLandscapeBlockRows;
        }
        CGFloat baseX = CGRectGetMinX(frame) - layoutColumn * kERGridStep;
        // 1.0.9-5 · 编辑态原生模块带着 kEREditingModuleOffset(-48) 的额外上移，
        // 反推基准时必须把它剔除，否则编辑网格整体上移 48（实测 slot0 y 56↔8 交替）。
        CGFloat moduleMinY = CGRectGetMinY(frame);
        // 1.0.9-14 · **回到最初的反推**（用户实测：加了剔除/抖动过滤后，竖屏编辑态圆贴不上模块）。
        // 编辑偏移由 wrapper.transform 施加，模块的 convertRect 结果本就包含它 —— 最初的实现
        // 不做任何加减、直接用模块位置反推，竖屏一直是准的。这里把后续两版加的修补全部撤掉。
        CGFloat baseY = moduleMinY - localRow * kERGridStep - ((CGFloat)((NSInteger)page - (NSInteger)gERCurrentPage) * span) - gERPagerInteractiveTranslation;
        fallbackBase.x = MIN(fallbackBase.x, baseX);
        fallbackBase.y = MIN(fallbackBase.y, baseY);
        NSNumber *pageKey = @(page);
        CGPoint pageBase = baseByPage[pageKey] ? baseByPage[pageKey].CGPointValue : CGPointMake(CGFLOAT_MAX, CGFLOAT_MAX);
        pageBase.x = MIN(pageBase.x, baseX);
        pageBase.y = MIN(pageBase.y, baseY);
        baseByPage[pageKey] = [NSValue valueWithCGPoint:pageBase];
    }

    NSValue *cachedBaseValue = objc_getAssociatedObject(overlay, kEREditGridBaseOriginKey);
    CGPoint cachedBase = cachedBaseValue ? cachedBaseValue.CGPointValue : fallbackBase;
    if (cachedBase.x == CGFLOAT_MAX || cachedBase.y == CGFLOAT_MAX) cachedBase = CGPointMake(0.0, 0.0);

    NSValue *currentBaseValue = baseByPage[@(gERCurrentPage)];
    if (currentBaseValue) {
        cachedBase = currentBaseValue.CGPointValue;
        objc_setAssociatedObject(overlay, kEREditGridBaseOriginKey, currentBaseValue, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    } else if (!cachedBaseValue && fallbackBase.x != CGFLOAT_MAX && fallbackBase.y != CGFLOAT_MAX) {
        cachedBase = fallbackBase;
        objc_setAssociatedObject(overlay, kEREditGridBaseOriginKey, [NSValue valueWithCGPoint:fallbackBase], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }

    CGFloat cell = kERGridCellSize;
    CGFloat step = kERGridStep;
    occupiedIndexesByPage = [NSMutableDictionary dictionary];
    NSMutableOrderedSet<NSString *> *occupancyIdentifiers = [NSMutableOrderedSet orderedSet];
    for (UIViewController *module in modules) {
        NSString *identifier = ERModuleIdentifier(module);
        if (identifier.length) [occupancyIdentifiers addObject:identifier];
    }
    for (NSString *identifier in [self enabledModuleIdentifiers]) if (identifier.length) [occupancyIdentifiers addObject:identifier];
    if (!occupancyIdentifiers.count) for (NSString *identifier in gERNativeLayoutRects.allKeys) if (identifier.length) [occupancyIdentifiers addObject:identifier];
    for (NSString *identifier in occupancyIdentifiers) {
        NSValue *nativeValue = identifier.length ? gERNativeLayoutRects[identifier] : nil;
        if (!nativeValue) continue;
        CCUILayoutRect logical = {};
        [nativeValue getValue:&logical];
        NSArray<NSNumber *> *origin = ERStoredOriginForIdentifier(identifier);
        if (origin.count >= 2) logical.origin = (CCUILayoutPoint){origin[0].unsignedIntegerValue, origin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *size = gERCustomSizes[identifier];
        if (size.count >= 2) logical.size = (CCUILayoutSize){size[0].unsignedIntegerValue, size[1].unsignedIntegerValue};
        if (!logical.size.width || !logical.size.height) continue;
        NSUInteger page = ERPageForRect(logical);
        NSUInteger localRow = logical.origin.y % kERMinimumGridRows;
        NSNumber *pageKey = @(page);
        NSMutableIndexSet *indexes = occupiedIndexesByPage[pageKey];
        if (!indexes) {
            indexes = [NSMutableIndexSet indexSet];
            occupiedIndexesByPage[pageKey] = indexes;
        }
        for (NSUInteger dy = 0; dy < logical.size.height; dy++) {
            NSUInteger row = localRow + dy;
            if (row >= kERMinimumGridRows) continue;
            for (NSUInteger dx = 0; dx < logical.size.width; dx++) {
                NSUInteger column = logical.origin.x + dx;
                if (column >= 4) continue;
                if (ERLandscapePresentationActive()) {
                    // 横屏网格是 8 列 × 4 行：占用格按同一套折叠规则换算过去。
                    NSUInteger foldedRow = row;
                    NSUInteger foldedColumn = column;
                    if (foldedRow >= kERLandscapeBlockRows) {
                        foldedRow -= kERLandscapeBlockRows;
                        foldedColumn += kERLandscapeBlockColumns;
                    }
                    if (foldedRow >= kERLandscapeBlockRows || foldedColumn >= (kERLandscapeBlockColumns * 2)) continue;
                    [indexes addIndex:foldedRow * (kERLandscapeBlockColumns * 2) + foldedColumn];
                } else {
                    [indexes addIndex:row * 4 + column];
                }
            }
        }
    }

    for (NSNumber *pageKey in [pageGrids.allKeys copy]) {
        if (pageKey.unsignedIntegerValue >= gERPageCount) {
            [pageGrids[pageKey] removeFromSuperview];
            [pageGrids removeObjectForKey:pageKey];
        }
    }

    EREditGridView *currentGrid = nil;
    for (NSUInteger page = 0; page < gERPageCount; page++) {
        NSNumber *pageKey = @(page);
        EREditGridView *grid = pageGrids[pageKey];
        if (!grid) {
            grid = [[EREditGridView alloc] initWithFrame:overlay.view.bounds];
            grid.tag = kEREditGridTag;
            grid.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
            pageGrids[pageKey] = grid;
        }
        if (grid.superview != gridStack) {
            [grid removeFromSuperview];
            [gridStack addSubview:grid];
        }
        grid.frame = CGRectMake(0.0,
                                (CGFloat)page * span,
                                CGRectGetWidth(gridStack.bounds),
                                CGRectGetHeight(gridStack.bounds));
        CGPoint base = cachedBase;
        NSMutableArray<NSValue *> *slots = [NSMutableArray array];
        // 1.0.7-23：横屏编辑网格**一律**按折行后的 8 列 × 4 行重建 —— 也就是用户
        // 真正看到的 32 个圆位（此前只有 4 列、右块的圆被高度裁掉，落点够不着）。
        // 竖屏仍是 4 列 × 8 行。整块必须落在顶部保留带之下（见 R1/R2）。
        NSUInteger gridColumnCount = ERLandscapePresentationActive() ? (NSUInteger)(kERLandscapeBlockColumns * 2) : 4;
        NSUInteger gridRowCount = ERLandscapePresentationActive() ? (NSUInteger)kERLandscapeBlockRows : (NSUInteger)kERMinimumGridRows;
        for (NSUInteger row = 0; row < gridRowCount; row++) {
            for (NSUInteger column = 0; column < gridColumnCount; column++) {
                CGRect slot = CGRectMake(base.x + column * step, base.y + row * step, cell, cell);
                if (CGRectGetMaxX(slot) <= CGRectGetWidth(grid.bounds) + 1.0 && CGRectGetMaxY(slot) <= CGRectGetHeight(grid.bounds) + 1.0) [slots addObject:[NSValue valueWithCGRect:slot]];
            }
        }
        NSMutableArray<NSValue *> *occupied = [NSMutableArray array];
        NSMutableIndexSet *occupiedIndexes = occupiedIndexesByPage[pageKey];
        [occupiedIndexes enumerateIndexesUsingBlock:^(NSUInteger index, __unused BOOL *stop) {
            if (index < slots.count) [occupied addObject:slots[index]];
        }];
        grid.columns = gridColumnCount;
        grid.rows = gridRowCount;
        grid.slotRects = slots;
        grid.occupiedRects = occupied;
        grid.alpha = 1.0;
        [grid setNeedsDisplay];
        if (page == gERCurrentPage) currentGrid = grid;
    }
    if (!currentGrid) currentGrid = pageGrids[@0];
    objc_setAssociatedObject(overlay, kEREditGridKey, currentGrid, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [self updateEditPageGridTransformsForOverlay:overlay];
    return currentGrid;
}

- (void)setEditPresentation:(BOOL)editing forOverlay:(UIViewController *)overlay animated:(BOOL)animated {
    UIViewController *collection = [self moduleCollectionControllerInOverlay:overlay];
    if (!collection.view) return;
    [self capturePresentationStateForView:collection.view];
    EREditGridView *grid = [self prepareGridForOverlay:overlay collection:collection];
    [self capturePresentationStateForView:grid];
    EREditTouchShield *touchShield = (EREditTouchShield *)[overlay.view viewWithTag:kEREditTouchShieldTag];
    if (!touchShield) {
        touchShield = [[EREditTouchShield alloc] initWithFrame:overlay.view.bounds];
        touchShield.tag = kEREditTouchShieldTag;
        touchShield.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        UITapGestureRecognizer *shieldTap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(editShieldTapped:)];
        shieldTap.cancelsTouchesInView = YES;
        shieldTap.delegate = self;
        objc_setAssociatedObject(shieldTap, kEROwnGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(shieldTap, @selector(editShieldTapped:), @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [touchShield addGestureRecognizer:shieldTap];
        [overlay.view addSubview:touchShield];
    }
    touchShield.frame = overlay.view.bounds;
    touchShield.hidden = !editing;
    if (editing) [overlay.view bringSubviewToFront:touchShield];
    UIButton *addControl = [self addControlButtonForOverlay:overlay];
    touchShield.passthroughView = addControl;
    if (editing) addControl.hidden = NO;
    NSMutableArray<UIView *> *moduleWrappers = [NSMutableArray array];
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        if (ERIsOwnedDuplicateModuleController(module)) continue;
        UIView *wrapper = module.view.superview;
        // Some sparse/late-created pages attach a module directly to the
        // collection view. Treating the collection itself as a per-module
        // wrapper overwrites the page transform with the edit-mode -48pt
        // wrapper offset, which makes every nonzero page disappear.
        if (wrapper == collection.view) continue;
        if (wrapper && ![moduleWrappers containsObject:wrapper]) {
            [moduleWrappers addObject:wrapper];
            [self capturePresentationStateForView:wrapper];
        }
    }
    NSArray<UIView *> *chromeViews = [self chromeViewsInOverlay:overlay excludingCollection:collection];
    for (UIView *view in chromeViews) [self capturePresentationStateForView:view];
    NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
    if (editing) for (EREditGridView *pageGrid in pageGrids.allValues) pageGrid.alpha = 0.0;
    void (^changes)(void) = ^{
        CGAffineTransform collectionBase = [objc_getAssociatedObject(collection.view, kEROriginalTransformKey) CGAffineTransformValue];
        CATransform3D sublayerBase = [objc_getAssociatedObject(collection.view, kEROriginalSublayerTransformKey) CATransform3DValue];
        CGFloat pageOffset = -(CGFloat)gERCurrentPage * ERVisualPageSpan();
        collection.view.transform = CGAffineTransformTranslate(collectionBase, 0.0, editing ? 0.0 : kERRestingModuleOffset);
        collection.view.layer.sublayerTransform = CATransform3DTranslate(sublayerBase, 0.0, pageOffset, 0.0);
        for (UIView *wrapper in moduleWrappers) {
            CGAffineTransform base = [objc_getAssociatedObject(wrapper, kEROriginalTransformKey) CGAffineTransformValue];
            // 1.0.9-6 · 编辑态给模块 wrapper 加 kEREditingModuleOffset(-48) 的上移；
            // 横屏纵向只有 430，这 48 直接把整屏模块顶到贴边（用户报的「编辑态整体上移、不居中」）。
            // 横屏取消该偏移（0），竖屏保持原值。
            CGFloat editOffset = ERLandscapePresentationActive() ? 0.0 : kEREditingModuleOffset;
            wrapper.transform = editing ? CGAffineTransformTranslate(base, 0.0, editOffset) : base;
        }
        [self layoutOwnedDuplicateModulesForOverlay:overlay];
        [self updateEditControlFramesForOverlay:overlay];
        addControl.alpha = editing ? 1.0 : 0.0;
        [self updateEditPageGridTransformsForOverlay:overlay];
        for (EREditGridView *pageGrid in pageGrids.allValues) if (!editing) pageGrid.alpha = 0.0;
        for (UIView *view in chromeViews) {
            CGAffineTransform base = [objc_getAssociatedObject(view, kEROriginalTransformKey) CGAffineTransformValue];
            view.transform = editing ? CGAffineTransformTranslate(base, 0.0, -22.0) : base;
            view.alpha = editing ? 0.0 : [objc_getAssociatedObject(view, kEROriginalAlphaKey) doubleValue];
        }
    };
    void (^completion)(BOOL) = ^(__unused BOOL finished) {
        if (editing) {
            [self prepareGridForOverlay:overlay collection:collection];
            NSMutableDictionary<NSNumber *, EREditGridView *> *finalPageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
            for (EREditGridView *pageGrid in finalPageGrids.allValues) pageGrid.alpha = 0.0;
            [UIView animateWithDuration:0.12 animations:^{ for (EREditGridView *pageGrid in finalPageGrids.allValues) pageGrid.alpha = 1.0; }];
            [overlay.view bringSubviewToFront:touchShield];
            [overlay.view bringSubviewToFront:addControl];
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                UIButton *remove = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
                UIButton *resize = objc_getAssociatedObject(module.view, kERResizeButtonKey);
                if (remove) [remove.superview bringSubviewToFront:remove];
                if (resize) [resize.superview bringSubviewToFront:resize];
                if ([ERModuleIdentifier(module).lowercaseString containsString:@"echoreborn.connectivity"]) ERDiagEditConnectivityModule(module);
            }
            // The full-screen edit grid and touch shield are inserted after
            // the pager host. Keep the visible indicator gutter above both so
            // dense pages can scrub immediately, not only after one switch.
            UIView *pageIndicators = [overlay.view viewWithTag:kERPageIndicatorHostTag];
            if (pageIndicators && !pageIndicators.hidden) [overlay.view bringSubviewToFront:pageIndicators];
            // The wrapper translation is committed at the end of this block.
            // Re-read converted frames afterward so first-open controls do not
            // retain the pre-edit vertical coordinate until the next resize.
            [self updateEditControlFramesForOverlay:overlay];
            dispatch_async(dispatch_get_main_queue(), ^{ [self updateEditControlFramesForOverlay:overlay]; });
        } else {
            addControl.hidden = YES;
            NSMutableDictionary<NSNumber *, EREditGridView *> *oldPageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
            for (EREditGridView *pageGrid in oldPageGrids.allValues) [pageGrid removeFromSuperview];
            [oldPageGrids removeAllObjects];
            UIView *oldGridStack = objc_getAssociatedObject(overlay, kEREditGridStackKey);
            [oldGridStack removeFromSuperview];
            objc_setAssociatedObject(overlay, kEREditGridStackKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(overlay, kEREditGridKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            // The private module collection performs one more layout pass as
            // edit mode finishes. On nonzero pages that pass can replace our
            // collection transform with its native identity transform, which
            // leaves the selected page one full span below the viewport. The
            // edit animation already targets this exact settled transform, so
            // reassert it at completion and once after the deferred layout.
            [self applyPageTransformToOverlay:overlay animated:NO];
            [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.12 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                if (!gEditModeActive && fabs(gERPagerInteractiveTranslation) < 0.01) {
                    [self applyPageTransformToOverlay:overlay animated:NO];
                    [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
                }
            });
        }
    };
    if (animated) [UIView animateWithDuration:0.28 delay:0.0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState animations:changes completion:completion];
    else { changes(); completion(YES); }
}

- (void)updateEditControlFramesForOverlay:(UIViewController *)overlay {
    if (!overlay.view) return;
    if (gERDragInProgress || gERPagerTransitionActive || gERPagerScrubbingActive) return;
    UIButton *addControl = (UIButton *)[overlay.view viewWithTag:kERAddControlButtonTag];
    if (addControl) {
        // Centered in the blank space between the last module row and the
        // bottom of the display, sitting just above the home indicator.
        [addControl sizeToFit];
        CGSize size = CGSizeMake(CGRectGetWidth(addControl.bounds), 30.0);
        CGRect bounds = overlay.view.bounds;
        // 1.0.6-10（第 4 条）：整体上移 2pt（对应「距底 4 → 6，增加二分之一」）。
        //
        // 方向务必注意：origin.y = 高度 − bottomInset − size.height，所以**增大**
        // bottomInset 才是上移。此前记录里写的「−14 → −16」会得到更小的 bottomInset，
        // 方向相反、实际是下移 2pt。这里两个分支同时 +2：常规分支 −14 → −12，
        // 下限分支 16 → 18 —— 无论设备是否命中下限，视觉位移都恰好是 2pt。
        CGFloat bottomInset = MAX(overlay.view.safeAreaInsets.bottom - 12.0, 18.0);
        addControl.frame = CGRectMake((CGRectGetWidth(bounds) - size.width) / 2.0, CGRectGetHeight(bounds) - bottomInset - size.height, size.width, size.height);
    }
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        if ((gERDragInProgress && module.view == gERActiveDragModuleView) ||
            (gERResizeInProgress && module.view == gERActiveResizeModuleView)) continue;
        UIButton *remove = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
        UIButton *resize = objc_getAssociatedObject(module.view, kERResizeButtonKey);
        CGRect moduleFrame = [module.view convertRect:module.view.bounds toView:overlay.view];
        // Borders live with their module wrapper and are naturally clipped by
        // the moving collection. Remove/resize controls live on overlay.view,
        // so explicitly cull them when their owner is outside the viewport;
        // otherwise chrome from the adjacent page floats over blank space.
        CGRect chromeViewport = CGRectInset(overlay.view.bounds, -24.0, -24.0);
        NSString *identifier = ERModuleIdentifier(module);
        BOOL activeDragSource = ERIsActiveDragModuleIdentifier(identifier);
        BOOL ownerVisible = gEditModeActive && !activeDragSource && !gEREditChromeSuppressedForPaging && !ERModuleViewIsPageHidden(module.view) && CGRectIntersectsRect(moduleFrame, chromeViewport);
        UIVisualEffectView *border = objc_getAssociatedObject(module.view, @selector(applyEditingToModule:editing:));
        if (border && !gERResizeInProgress) {
            UIView *borderHost = border.superview ?: module.view.superview;
            CGRect borderFrame = borderHost ? [overlay.view convertRect:moduleFrame toView:borderHost] : CGRectMake(CGRectGetMinX(module.view.frame), CGRectGetMinY(module.view.frame), CGRectGetWidth(module.view.bounds), CGRectGetHeight(module.view.bounds));
            [self configureEditingBorder:border moduleFrame:borderFrame];
            border.hidden = !ownerVisible || !gModuleBordersEnabled;
            border.alpha = ownerVisible && gModuleBordersEnabled ? 1.0 : 0.0;
        }
        if (remove) remove.hidden = !ownerVisible || !gRemovalButtonsEnabled;
        if (resize) resize.hidden = !ownerVisible || ![self moduleIdentifierSupportsResizing:identifier];
        [self positionEditControlsForModuleView:module.view overlay:overlay overlayFrame:moduleFrame];
    }
}

- (void)editChromeDisplayLinkFired:(__unused CADisplayLink *)displayLink {
    if (!gEditModeActive) return;
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        if (overlay.view.window) [self updateEditControlFramesForOverlay:overlay];
    }
}

- (void)updateEditingChromeForPresentationProgress:(CGFloat)progress overlay:(UIViewController *)overlay {
    if (!overlay || !gEditModeActive) return;
    if (gERAddSheetPresentationActive || [overlay.presentedViewController isKindOfClass:[ERAddControlSheetViewController class]]) return;
    CGFloat clamped = MIN(1.0, MAX(0.0, progress));
    [self updateEditControlFramesForOverlay:overlay];
    UIButton *addControl = (UIButton *)[overlay.view viewWithTag:kERAddControlButtonTag];
    NSMutableDictionary<NSNumber *, EREditGridView *> *pageGrids = objc_getAssociatedObject(overlay, kEREditPageGridsKey);
    UIView *gridStack = objc_getAssociatedObject(overlay, kEREditGridStackKey);
    EREditTouchShield *touchShield = (EREditTouchShield *)[overlay.view viewWithTag:kEREditTouchShieldTag];
    addControl.alpha = clamped;
    gridStack.alpha = clamped;
    for (EREditGridView *grid in pageGrids.allValues) grid.alpha = clamped;
    touchShield.userInteractionEnabled = clamped > 0.98;
    for (UIViewController *module in ERCollectModuleControllers(overlay)) {
        UIVisualEffectView *border = objc_getAssociatedObject(module.view, @selector(applyEditingToModule:editing:));
        UIButton *remove = objc_getAssociatedObject(module.view, kERRemoveButtonKey);
        UIButton *resize = objc_getAssociatedObject(module.view, kERResizeButtonKey);
        if (clamped < 0.999) [border.layer removeAnimationForKey:@"EchoRebornBreathing"];
        border.alpha = clamped;
        remove.alpha = clamped;
        resize.alpha = clamped;
    }
}

- (void)setEditing:(BOOL)editing {
    if (!gEnabled) editing = NO;
    if (editing && gERExpandedModuleOpen) return;
    NSUInteger editTransitionGeneration = ++gEREditTransitionGeneration;
    gEREditTransitionActive = YES;
    gEREditChromeSuppressedForPaging = NO;
    gEditModeActive = editing;
    if (editing && !gEREditChromeDisplayLink) {
        gEREditChromeDisplayLink = [CADisplayLink displayLinkWithTarget:self selector:@selector(editChromeDisplayLinkFired:)];
        [gEREditChromeDisplayLink addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
    } else if (!editing && gEREditChromeDisplayLink) {
        [gEREditChromeDisplayLink invalidate];
        gEREditChromeDisplayLink = nil;
    }
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        ERRestoreNativeScrollBaseline(overlay);
        [self normalizePagedLayoutForOverlay:overlay];
        if (editing) [self setNativeDismissTapGesturesEnabled:NO forOverlay:overlay];
        for (UIViewController *module in ERCollectModuleControllers(overlay)) [self applyEditingToModule:module editing:editing];
        [self setEditPresentation:editing forOverlay:overlay animated:YES];
        [self updatePageIndicatorsForOverlay:overlay];
        [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
        // Sheet presentation/dismissal can run the CC state callbacks while
        // editing is active, leaving the quick-access host hidden with nothing
        // to re-show it. Manage its visibility explicitly on edit transitions.
        [self setQuickAccessButtonsHidden:(editing || gERExpandedModuleOpen || !gERControlCenterPresented) forOverlay:overlay animated:YES];
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.32 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (editTransitionGeneration != gEREditTransitionGeneration || gEditModeActive != editing) return;
        gEREditTransitionActive = NO;
        if (!editing) {
            for (UIViewController *overlay in gOverlayControllers.allObjects) {
                [self setNativeDismissTapGesturesEnabled:YES forOverlay:overlay];
            }
        }
    });
}

- (void)dismissEditingImmediately {
    if (!gEditModeActive) return;
    ++gEREditTransitionGeneration;
    gEREditTransitionActive = NO;
    gEditModeActive = NO;
    gEREditChromeSuppressedForPaging = NO;
    [gEREditChromeDisplayLink invalidate];
    gEREditChromeDisplayLink = nil;
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        if ([overlay.presentedViewController isKindOfClass:[ERAddControlSheetViewController class]]) {
            [overlay dismissViewControllerAnimated:NO completion:nil];
        }
        [self normalizePagedLayoutForOverlay:overlay];
        [self setNativeDismissTapGesturesEnabled:YES forOverlay:overlay];
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            [self applyEditingToModule:module editing:NO];
        }
        [self setEditPresentation:NO forOverlay:overlay animated:NO];
        // Leaving edit mode reveals the header chrome again. `setEditPresentation:`
        // runs the same alpha pass, but doing it explicitly here keeps the status
        // bar restore tied to the edit-exit path itself rather than to whatever
        // the presentation helper happens to do on a given iOS build.
        [self setHeaderChromeHiddenForScrubbing:NO overlay:overlay animated:NO];
        [self updatePageIndicatorsForOverlay:overlay];
        [self updatePagedModuleVisibilityForOverlay:overlay showAdjacent:NO];
        [self setQuickAccessButtonsHidden:!gERControlCenterPresented forOverlay:overlay animated:NO];
    }
}

@end

@implementation ERAddControlSheetViewController

- (void)viewDidLoad {
    [super viewDidLoad];
    self.previewCache = [NSMutableDictionary dictionary];
    // Control Center is a dark surface regardless of system appearance; an
    // opaque dark sheet keeps module platters and text readable in both modes.
    self.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
    self.view.backgroundColor = [UIColor colorWithRed:0.11 green:0.11 blue:0.12 alpha:1.0];

    UISearchBar *search = [[UISearchBar alloc] initWithFrame:CGRectZero];
    search.tag = 11;
    search.placeholder = @"搜索控制项";
    search.searchBarStyle = UISearchBarStyleMinimal;
    search.barStyle = UIBarStyleBlack;
    search.tintColor = UIColor.whiteColor;
    search.delegate = self;
    search.searchTextField.textColor = UIColor.whiteColor;
    // Minimal style suppresses the field's own backing and quietly discards
    // backgroundColor set on the text field. A resizable background image is
    // the one supported path that reliably draws the pill.
    CGFloat fieldHeight = 42.0, fieldRadius = 12.0;
    UIGraphicsImageRenderer *fieldRenderer = [[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(fieldRadius * 2.0 + 2.0, fieldHeight)];
    UIImage *fieldImage = [fieldRenderer imageWithActions:^(__unused UIGraphicsImageRendererContext *context) {
        [[UIColor colorWithRed:0.46 green:0.46 blue:0.50 alpha:0.28] setFill];
        [[UIBezierPath bezierPathWithRoundedRect:CGRectMake(0.0, 0.0, fieldRadius * 2.0 + 2.0, fieldHeight) cornerRadius:fieldRadius] fill];
    }];
    fieldImage = [fieldImage resizableImageWithCapInsets:UIEdgeInsetsMake(0.0, fieldRadius, 0.0, fieldRadius)];
    [search setSearchFieldBackgroundImage:fieldImage forState:UIControlStateNormal];
    [self.view addSubview:search];

    UIScrollView *scroll = [[UIScrollView alloc] initWithFrame:CGRectZero];
    scroll.tag = 12;
    scroll.alwaysBounceVertical = YES;
    scroll.showsVerticalScrollIndicator = YES;
    scroll.contentInsetAdjustmentBehavior = UIScrollViewContentInsetAdjustmentNever;
    scroll.keyboardDismissMode = UIScrollViewKeyboardDismissModeOnDrag;
    [self.view addSubview:scroll];
    UIView *container = [[UIView alloc] initWithFrame:CGRectZero];
    container.tag = 50;
    [scroll addSubview:container];
}

- (void)viewWillAppear:(BOOL)animated {
    [super viewWillAppear:animated];
    // The gallery is rebuilt from live state every time it is shown, so a
    // control removed moments ago is offered again and one that was just
    // added is no longer listed.
    [self refreshCatalogFromCoordinator];
}

- (void)refreshCatalogFromCoordinator {
    Class coordinatorClass = NSClassFromString(@"EchoRebornCoordinator");
    if (!coordinatorClass || ![coordinatorClass respondsToSelector:@selector(shared)]) return;
    id coordinator = ((id (*)(id, SEL))objc_msgSend)(coordinatorClass, @selector(shared));
    if (![coordinator respondsToSelector:@selector(availableControlCatalog)]) return;
    NSArray *catalog = ((NSArray * (*)(id, SEL))objc_msgSend)(coordinator, @selector(availableControlCatalog));
    if (![catalog isKindOfClass:[NSArray class]] || !catalog.count) return;
    self.catalog = catalog;
    [self.previewCache removeAllObjects];
    if (self.builtGrid) [self reloadGrid];
}

- (void)viewDidLayoutSubviews {
    [super viewDidLayoutSubviews];
    UISearchBar *search = (UISearchBar *)[self.view viewWithTag:11];
    UIScrollView *scroll = (UIScrollView *)[self.view viewWithTag:12];
    CGRect bounds = self.view.bounds;
    search.frame = CGRectMake(12.0, 18.0, CGRectGetWidth(bounds) - 24.0, 54.0);
    scroll.frame = CGRectMake(0.0, 82.0, CGRectGetWidth(bounds), CGRectGetHeight(bounds) - 82.0);
    if (!self.builtGrid && CGRectGetWidth(bounds) > 1.0) {
        self.builtGrid = YES;
        [self reloadGrid];
    }
}

- (NSArray<NSDictionary *> *)visibleSections {
    NSString *query = self.query ?: @"";
    NSMutableArray<NSDictionary *> *sections = [NSMutableArray array];
    // The gallery no longer opens with a headerless "建议/推荐" strip. EchoReborn
    // always listed those tiles again inside their own categories, so the strip
    // only ever duplicated the first rows of the sheet (and its rotating fill
    // made the same control appear twice). The first group is now the first real
    // category.
    NSArray<NSString *> *order = ERCategoryOrder();
    NSMutableDictionary<NSString *, NSMutableArray *> *byCategory = [NSMutableDictionary dictionary];
    for (NSDictionary *entry in self.catalog) {
        if (query.length && ![entry[@"name"] localizedCaseInsensitiveContainsString:query]) continue;
        NSString *category = entry[@"category"] ?: @"实用工具";
        if (!byCategory[category]) byCategory[category] = [NSMutableArray array];
        [byCategory[category] addObject:entry];
    }
    NSMutableSet<NSString *> *placed = [NSMutableSet set];
    NSMutableArray<NSString *> *hidden = [NSMutableArray array];
    for (NSString *category in order) {
        // A category switched off in Settings takes its whole menu with it. The
        // rule is enforced here — the one place the sheet builds its sections —
        // so hiding a group can never leave an orphan section behind.
        //
        // This is the ONLY place the switch affects anything. It filters what
        // this sheet offers; it never touches the live Control Center layout.
        // That is what makes "关闭分类后已添加的模块不受影响" true: a module
        // the user already placed lives in the module-collection view
        // controller's own model, which nothing here reads or writes. Turning a
        // category off removes the offer to ADD another module of that kind; it
        // cannot remove one that is already on a page.
        if (ERCategoryIsDisabled(category)) {
            if (byCategory[category].count) [hidden addObject:category];
            continue;
        }
        NSArray *entries = byCategory[category];
        if (!entries.count) continue;
        [placed addObject:category];
        [sections addObject:@{@"title": category, @"entries": entries}];
    }
    // Any category the catalog produced but the order list does not mention
    // (a third-party module with an unusual identifier) still has to be
    // reachable, so append the leftovers in a stable order.
    NSArray<NSString *> *leftovers = [byCategory.allKeys sortedArrayUsingSelector:@selector(localizedCaseInsensitiveCompare:)];
    for (NSString *category in leftovers) {
        if ([placed containsObject:category]) continue;
        if (ERCategoryIsDisabled(category)) {
            if (byCategory[category].count) [hidden addObject:category];
            continue;
        }
        [sections addObject:@{@"title": category, @"entries": byCategory[category]}];
    }
    if (hidden.count) {
        ERLogInfo(@"catalog: %lu category(ies) hidden by Settings: %@",
                   (unsigned long)hidden.count, [hidden componentsJoinedByString:@", "]);
    }
    return sections;
}

- (UIView *)previewForEntry:(NSDictionary *)entry usedIdentifiers:(NSMutableSet<NSString *> *)usedIdentifiers {
    NSString *identifier = entry[@"identifier"];
    // A cached preview belongs to exactly one cell. If the same entry somehow
    // resolves twice in a single pass the second use gets a fresh, uncached
    // view instead of stealing the one already placed.
    BOOL firstUse = identifier && ![usedIdentifiers containsObject:identifier];
    if (identifier) [usedIdentifiers addObject:identifier];
    UIView *preview = firstUse ? self.previewCache[identifier] : nil;
    if (!preview) {
        preview = [[EchoRebornCoordinator shared] previewViewForCatalogEntry:entry];
        if (identifier && firstUse && preview) self.previewCache[identifier] = preview;
    }
    [preview removeFromSuperview];
    preview.transform = CGAffineTransformIdentity;
    return preview;
}

- (void)reloadGrid {
    UIScrollView *scroll = (UIScrollView *)[self.view viewWithTag:12];
    UIView *container = [scroll viewWithTag:50];
    for (UIView *subview in [container.subviews copy]) [subview removeFromSuperview];

    CGFloat width = CGRectGetWidth(self.view.bounds);
    CGFloat gap = kERGridGap;
    CGFloat contentWidth = 4.0 * kERGridCellSize + 3.0 * gap; // one Control Center page wide
    CGFloat margin = MAX(16.0, (width - contentWidth) / 2.0);
    CGFloat labelBand = 38.0;
    CGFloat y = 6.0;
    NSMutableSet<NSString *> *usedIdentifiers = [NSMutableSet set];

    for (NSDictionary *section in [self visibleSections]) {
        NSString *title = section[@"title"];
        if ([title length]) {
            // The hairline caps the PREVIOUS group, so it must not be drawn
            // above the very first section — with the old suggested strip gone
            // the first group is a real category, and its divider had nothing
            // to cap: it showed up as a stray rule above "辅助功能".
            if (y > 6.0 + 0.5) {
                UIView *divider = [[UIView alloc] initWithFrame:CGRectMake(margin, y, contentWidth, 1.0 / UIScreen.mainScreen.scale)];
                divider.backgroundColor = [UIColor.whiteColor colorWithAlphaComponent:0.16];
                [container addSubview:divider];
                y += 13.0;
            } else {
                y += 6.0;
            }
            UILabel *header = [[UILabel alloc] initWithFrame:CGRectMake(margin, y, contentWidth, 18.0)];
            header.text = title;
            header.font = [UIFont systemFontOfSize:13.0 weight:UIFontWeightSemibold];
            header.textColor = [UIColor.whiteColor colorWithAlphaComponent:0.55];
            [container addSubview:header];
            y += 28.0;
        }
        // Pack each category on a real four-column occupancy map. The preview
        // supplies the current footprint, so resized/live controls naturally
        // influence the arrangement the next time the sheet opens.
        NSMutableArray<NSDictionary *> *items = [NSMutableArray array];
        NSUInteger originalIndex = 0;
        for (NSDictionary *entry in section[@"entries"]) {
            UIView *preview = [self previewForEntry:entry usedIdentifiers:usedIdentifiers];
            CGSize size = preview.bounds.size;
            if (size.width < 1.0 || size.height < 1.0) size = CGSizeMake(kERGridCellSize, kERGridCellSize);
            NSUInteger columns = MAX(1, MIN(4, (NSUInteger)llround((size.width + gap) / kERGridStep)));
            NSUInteger rows = MAX(1, MIN(4, (NSUInteger)llround((size.height + gap) / kERGridStep)));
            [items addObject:@{@"entry": entry, @"preview": preview, @"size": [NSValue valueWithCGSize:size], @"columns": @(columns), @"rows": @(rows), @"index": @(originalIndex++)}];
        }
        [items sortUsingComparator:^NSComparisonResult(NSDictionary *left, NSDictionary *right) {
            NSUInteger leftArea = [left[@"columns"] unsignedIntegerValue] * [left[@"rows"] unsignedIntegerValue];
            NSUInteger rightArea = [right[@"columns"] unsignedIntegerValue] * [right[@"rows"] unsignedIntegerValue];
            if (leftArea != rightArea) return leftArea < rightArea ? NSOrderedAscending : NSOrderedDescending;
            NSUInteger leftRows = [left[@"rows"] unsignedIntegerValue], rightRows = [right[@"rows"] unsignedIntegerValue];
            if (leftRows != rightRows) return leftRows > rightRows ? NSOrderedAscending : NSOrderedDescending;
            return [left[@"index"] compare:right[@"index"]];
        }];

        CGFloat sectionTop = y;
        CGFloat rowPitch = kERGridCellSize + labelBand + 14.0;
        CGFloat sectionBottom = sectionTop;
        NSMutableArray<NSMutableArray<NSNumber *> *> *occupancy = [NSMutableArray array];
        void (^ensureRows)(NSUInteger) = ^(NSUInteger count) {
            while (occupancy.count < count) [occupancy addObject:[@[@NO, @NO, @NO, @NO] mutableCopy]];
        };
        for (NSDictionary *item in items) {
            NSDictionary *entry = item[@"entry"];
            UIView *preview = item[@"preview"];
            CGSize size = [item[@"size"] CGSizeValue];
            NSUInteger columns = [item[@"columns"] unsignedIntegerValue];
            NSUInteger rows = [item[@"rows"] unsignedIntegerValue];
            NSUInteger placedRow = 0, placedColumn = 0;
            BOOL found = NO;
            for (NSUInteger row = 0; !found && row < 64; row++) {
                ensureRows(row + rows);
                for (NSUInteger column = 0; !found && column + columns <= 4; column++) {
                    BOOL fits = YES;
                    for (NSUInteger testRow = row; fits && testRow < row + rows; testRow++) {
                        for (NSUInteger testColumn = column; testColumn < column + columns; testColumn++) {
                            if ([occupancy[testRow][testColumn] boolValue]) { fits = NO; break; }
                        }
                    }
                    if (fits) { placedRow = row; placedColumn = column; found = YES; }
                }
            }
            if (!found) continue;
            for (NSUInteger markRow = placedRow; markRow < placedRow + rows; markRow++) {
                for (NSUInteger markColumn = placedColumn; markColumn < placedColumn + columns; markColumn++) occupancy[markRow][markColumn] = @YES;
            }
            CGFloat x = margin + placedColumn * kERGridStep;
            CGFloat itemY = sectionTop + placedRow * rowPitch;
            CGFloat cellHeight = size.height + labelBand;
            UIView *cell = [[UIView alloc] initWithFrame:CGRectMake(x, itemY, size.width, cellHeight)];
            preview.frame = (CGRect){CGPointZero, size};
            NSValue *fitTransform = objc_getAssociatedObject(preview, kERPreviewFitTransformKey);
            if (fitTransform) preview.transform = [fitTransform CGAffineTransformValue];
            [cell addSubview:preview];
            if ([entry[@"allowsMultiple"] boolValue] && [entry[@"instanceCount"] unsignedIntegerValue] > 0) {
                UILabel *badge = [[UILabel alloc] initWithFrame:CGRectMake(CGRectGetWidth(preview.bounds) - 24.0, -7.0, 31.0, 23.0)];
                badge.text = [NSString stringWithFormat:@"%lu", (unsigned long)[entry[@"instanceCount"] unsignedIntegerValue]];
                badge.font = [UIFont systemFontOfSize:13.0 weight:UIFontWeightBold];
                badge.textColor = UIColor.whiteColor;
                badge.textAlignment = NSTextAlignmentCenter;
                badge.backgroundColor = [UIColor colorWithRed:0.12 green:0.50 blue:1.0 alpha:0.96];
                badge.layer.cornerRadius = 11.5;
                badge.layer.cornerCurve = kCACornerCurveContinuous;
                badge.layer.masksToBounds = YES;
                badge.layer.borderWidth = 1.5;
                badge.layer.borderColor = [UIColor colorWithWhite:0.05 alpha:0.72].CGColor;
                badge.userInteractionEnabled = NO;
                [cell addSubview:badge];
            }
            UILabel *name = [[UILabel alloc] initWithFrame:CGRectMake(-gap / 2.0, size.height + 4.0, size.width + gap, labelBand - 8.0)];
            name.text = entry[@"name"];
            name.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightMedium];
            name.textColor = UIColor.whiteColor;
            name.textAlignment = NSTextAlignmentCenter;
            name.numberOfLines = 2;
            name.lineBreakMode = NSLineBreakByTruncatingTail;
            [cell addSubview:name];
            UITapGestureRecognizer *tap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(cellTapped:)];
            [cell addGestureRecognizer:tap];
            objc_setAssociatedObject(cell, @selector(cellTapped:), entry[@"identifier"], OBJC_ASSOCIATION_COPY_NONATOMIC);
            [container addSubview:cell];
            sectionBottom = MAX(sectionBottom, itemY + cellHeight);
        }
        y = sectionBottom + 20.0;
    }
    container.frame = CGRectMake(0.0, 0.0, width, y);
    scroll.contentSize = CGSizeMake(width, y + 44.0);
    if (self.query.length && scroll.contentOffset.y > 0.0) [scroll setContentOffset:CGPointZero animated:NO];
}

- (void)searchBar:(__unused UISearchBar *)searchBar textDidChange:(NSString *)searchText {
    self.query = searchText;
    [self reloadGrid];
}

- (void)searchBarSearchButtonClicked:(UISearchBar *)searchBar {
    [searchBar resignFirstResponder];
}

- (void)cellTapped:(UITapGestureRecognizer *)gesture {
    @try {
        if (gesture.state != UIGestureRecognizerStateRecognized) return;
        NSString *identifier = objc_getAssociatedObject(gesture.view, @selector(cellTapped:));
        if (!identifier.length) return;
        [UIView animateWithDuration:0.10 animations:^{ gesture.view.transform = CGAffineTransformMakeScale(0.94, 0.94); } completion:^(__unused BOOL finished) {
            [UIView animateWithDuration:0.14 animations:^{ gesture.view.transform = CGAffineTransformIdentity; }];
            @try {
                [[EchoRebornCoordinator shared] addControlSheetDidSelectIdentifier:identifier fromSheet:self];
            } @catch (NSException *exception) {
                ERLogCaughtException(@"cellTapped.addControl", exception);
            }
        }];
    } @catch (NSException *exception) {
        ERLogCaughtException(@"cellTapped", exception);
    }
}

@end

%hook CCUIModuleCollectionViewController

- (CCUILayoutSize)moduleLayoutSizeForContentModuleContext:(id)context forOrientation:(NSInteger)orientation {
    CCUILayoutSize size = %orig;
    NSString *identifier = [context respondsToSelector:@selector(moduleIdentifier)] ? ((id (*)(id, SEL))objc_msgSend)(context, @selector(moduleIdentifier)) : nil;
    if (identifier.length && !gERBaseLayoutSizes[identifier]) gERBaseLayoutSizes[identifier] = [NSValue value:&size withObjCType:@encode(CCUILayoutSize)];
    NSArray<NSNumber *> *custom = gERCustomSizes[identifier];
    if (custom.count >= 2) size = (CCUILayoutSize){custom[0].unsignedIntegerValue, custom[1].unsignedIntegerValue};
    return size;
}

- (CCUILayoutRect)layoutView:(id)layoutView layoutRectForSubview:(UIView *)subview {
    CCUILayoutRect rect = %orig;
    NSDictionary *containers = nil;
    @try { containers = [(id)self valueForKey:@"moduleContainerViewByIdentifier"]; } @catch (__unused NSException *exception) {}
    __block NSString *identifier = nil;
    [containers enumerateKeysAndObjectsUsingBlock:^(NSString *key, id value, BOOL *stop) {
        UIView *candidateView = [value isKindOfClass:[UIView class]] ? value : ([value respondsToSelector:@selector(view)] ? [value view] : nil);
        if (candidateView == subview) { identifier = key; *stop = YES; }
    }];
    if (identifier.length) {
        if (!gERBaseLayoutSizes[identifier]) gERBaseLayoutSizes[identifier] = [NSValue value:&rect.size withObjCType:@encode(CCUILayoutSize)];
        gERNativeLayoutRects[identifier] = [NSValue value:&rect withObjCType:@encode(CCUILayoutRect)];
        NSArray<NSNumber *> *customOrigin = ERStoredOriginForIdentifier(identifier);
        if (customOrigin.count >= 2) rect.origin = (CCUILayoutPoint){customOrigin[0].unsignedIntegerValue, customOrigin[1].unsignedIntegerValue};
        NSArray<NSNumber *> *customSize = gERCustomSizes[identifier];
        if (customSize.count >= 2) rect.size = (CCUILayoutSize){customSize[0].unsignedIntegerValue, customSize[1].unsignedIntegerValue};
        if (gEnabled) {
            // page / localRow 必须在本行改写 origin.y 之前算：此刻
            // rect.origin.y 仍是配置空间里的「page*8 + localRow」。
            NSUInteger page = ERPageForRect(rect);
            NSUInteger localRow = rect.origin.y % kERMinimumGridRows;
            if (ERLandscapePresentationActive()) {
                // 横屏折行：行 4-7 折到右侧（列 +4、行 -4），页面按 4 行步进。
                if (localRow >= kERLandscapeBlockRows) {
                    rect.origin.x += kERLandscapeBlockColumns;
                    localRow -= kERLandscapeBlockRows;
                }
                rect.origin.y = page * kERLandscapeBlockRows + localRow;
            } else {
                rect.origin.y += page * ERVisualPageSpacerRows();
            }
        }
    }
    if (gEnabled && gEditModeActive && gERDragInProgress && rect.size.width == 1 && rect.size.height == 3) {
        rect.size.height = 2;
    }
    return rect;
}


%end

%hook MTMaterialView

- (void)didMoveToSuperview {
    %orig;
    if (!gEnabled) return;
    UIView *view = (UIView *)(id)self;
    UIView *parent = view.superview;
    if (![parent.superview isKindOfClass:[UIScrollView class]]) return;
    if (ERViewTreeContainsClassName(parent, @"CCUIHeaderPocketView")) return;
    if (!ERViewTreeContainsClassName(parent, @"CCUISensorAttributionPrivacyHeaderView")) return;
    CGSize screenSize = UIScreen.mainScreen.bounds.size;
    BOOL fullScreen = fabs(CGRectGetWidth(view.bounds) - screenSize.width) < 8.0 &&
                      fabs(CGRectGetHeight(view.bounds) - screenSize.height) < 8.0;
    if (!fullScreen) return;
    view.hidden = YES;
    view.alpha = 0.0;
    view.layer.opacity = 0.0;
}

- (void)layoutSubviews {
    %orig;
    if (!gEnabled) return;
    UIView *view = (UIView *)(id)self;
    UIView *parent = view.superview;
    if (![parent.superview isKindOfClass:[UIScrollView class]]) return;
    if (ERViewTreeContainsClassName(parent, @"CCUIHeaderPocketView")) return;
    if (!ERViewTreeContainsClassName(parent, @"CCUISensorAttributionPrivacyHeaderView")) return;
    CGSize screenSize = UIScreen.mainScreen.bounds.size;
    BOOL fullScreen = fabs(CGRectGetWidth(view.bounds) - screenSize.width) < 8.0 &&
                      fabs(CGRectGetHeight(view.bounds) - screenSize.height) < 8.0;
    if (!fullScreen) return;
    view.hidden = YES;
    view.alpha = 0.0;
    view.layer.opacity = 0.0;
}

%end

%hook CCUIModuleCollectionView

- (instancetype)initWithFrame:(CGRect)frame layoutOptions:(id)layoutOptions {
    ERApplyCompactGridSpacingToLayoutOptions(layoutOptions);
    id result = %orig;
    @try { ERApplyCompactGridSpacingToLayoutOptions([(id)result valueForKey:@"layoutOptions"]); } @catch (__unused NSException *exception) {}
    return result;
}

- (void)layoutSubviews {
    %orig;
    if (!gEnabled) return;
    UIScrollView *scrollView = (UIScrollView *)(id)self;
    scrollView.alwaysBounceVertical = NO;
    scrollView.alwaysBounceHorizontal = NO;
    scrollView.bounces = NO;
    scrollView.showsVerticalScrollIndicator = NO;
    scrollView.showsHorizontalScrollIndicator = NO;
    scrollView.scrollIndicatorInsets = UIEdgeInsetsZero;
    if (fabs(scrollView.contentOffset.x) > 0.25 || fabs(scrollView.contentOffset.y) > 0.25) {
        [scrollView setContentOffset:CGPointZero animated:NO];
    }
}

- (CGRect)frameForLayoutRect:(CCUILayoutRect)layoutRect {
    CGRect frame = %orig;
    if (gEnabled) {
        UIView *collectionView = (UIView *)(id)self;
        CGFloat containerWidth = CGRectGetWidth(collectionView.window.bounds);
        if (containerWidth < 1.0) containerWidth = CGRectGetWidth(UIScreen.mainScreen.bounds);
        CGFloat nativeX = CGRectGetMinX(frame);
        CGFloat shift = ERGridHorizontalCenteringCompensationForFrame(frame, layoutRect, containerWidth);
        frame.origin.x += shift;

        // 横屏纵向居中（0.5.16）：把 4 行块从原生那个偏下的基准挪到容器居中。
        CGFloat nativeY = CGRectGetMinY(frame);
        UIWindow *collectionWindow = collectionView.window;
        CGFloat containerHeight = collectionWindow ? CGRectGetHeight(collectionWindow.bounds)
                                                   : CGRectGetHeight(collectionView.bounds);
        UIEdgeInsets windowInsets = collectionWindow ? collectionWindow.safeAreaInsets : UIEdgeInsetsZero;
        // 1.0.9-2 · 网格容器基准（本窗口会话见过的最小 winY）—— 提到函数作用域，供下面的补偿与 GRID-PROBE 共用。
        static NSMapTable *gERGridContainerBaseY = nil;
        static dispatch_once_t onceD;
        dispatch_once(&onceD, ^{ gERGridContainerBaseY = [NSMapTable strongToStrongObjectsMapTable]; });
        CGFloat verticalShift = 0.0;
        if (ERLandscapePresentationActive()) {
            // 1.0.9-9 · **绝对钉死**（替代「+= 相对补偿」）。
            // 实测（20260921-1401）：同样的 vShift 下仍偶发 cellWinY=584（正常 56）—— 说明那一帧
            // 异常来自系统给的 nativeBase 本身（系统在重建单元时给了下一页坐标），相对补偿无从纠正。
            // 现在直接算出屏幕目标 Y，再把单元格 frame 写成「目标 − 容器窗口 Y」的绝对值：
            //   cellWinY = 容器winY + frame.y = 目标          → 与 nativeBase 无关，任何异常帧都被纠正；
            //   容器因胶囊位移时容器winY 变大、减得更多      → 屏幕落点仍恒为 目标。
            verticalShift = ERGridVerticalCenteringCompensationForFrame(frame, layoutRect, containerHeight,
                                                                         windowInsets.top, windowInsets.bottom);

            // 1.0.9-2 · **容器位移补偿**：网格的屏幕位置 = 父容器位置 + 单元位置。
            // 实测（20260921-0423 日志）：窗口顶部安全区恒为 0，但权限胶囊出现时
            // 系统会把整个面板容器下移 —— 单元在自己坐标系里没动，屏幕上却跟着走。
            // 这里量「容器当前 winY − 基准 winY」的差，从单元上反向补回：
            // 网格的屏幕位置与胶囊彻底无关（基准取见过的最小 y = 无胶囊时的原位）。
            if (collectionWindow) {
                // 1.0.9-4 · **落点校准（实测反推，不再猜）**
                // 20260921-0549 日志 GRID-PROBE：cellWinY=129.7、容器 winY=114.0、vShift≈-0.3，
                // 7 条读数完全一致 → 位置是稳的，不漂；真正的问题是**恒定偏低约 67pt**：
                // 第一行 129.7 + 网格高 304 = 433.7 > 屏幕高 430 → 最后一行出屏、显示不完整。
                //
                // target（ERGridVerticalCenteringCompensationForFrame 算出的 63）是**屏幕**坐标，
                // 但 verticalShift 加在单元格的**容器坐标** frame.y 上，容器自身的 winY 会被叠加 → 多出约 114。
                // 这里把容器当前 winY 减掉：屏幕落点 = 容器 winY + (target − 容器 winY) = target ✔
                // 副作用正好是我们想要的：胶囊引起容器下移时，containerWinY 变大、这里减得更多，
                // 屏幕落点仍恒为 target —— 落点正确 + 胶囊免疫，一次解决。
                CGFloat containerWinY = [collectionView convertRect:collectionView.bounds toView:collectionWindow].origin.y;
                // 1.0.9-8 · **只在容器窗口坐标有效时才补偿**。
                // 实测（20260921-1255）：30 余条 GRID-PROBE 里出现一条 cellWinY=584（正常 56）——
                // 首次布局时容器还没落到窗口里（winY 为负/未定），减它反而把整页推到下一页位置，
                // 屏幕上就"隐约看见下面一页"。这里加有效性判断，无效时不做容器补偿。
                // 1.0.9-13 · **回退 1.0.9-9 的「绝对钉死」**（用户实测非编辑态也出现「234 页看不见 /
                // 下一页内容叠在第 1 页」——那种定位方式把每页的落点写成了绝对坐标，翻页时来不及跟上）。
                // 恢复 1.0.9-8 的相对补偿（用户当时确认「问题 1 已解决」）。
                if (containerWinY > -1.0 && containerWinY < containerHeight) verticalShift -= containerWinY;
            }
            frame.origin.y += verticalShift;

            // 1.0.9-3 · GRID-PROBE（只读）：把网格单元的最终屏幕 y 与**父视图链**（类名 + 各自窗口 Y）整条打出来。
            // 胶囊出现时若仍有位移，这份清单能直接指出是哪一层在动、动了多少 —— 前两版都锁错了层（安全区恒为 0、容器补偿量不到真正的推动力）。
            @try {
                static CFTimeInterval gERGridProbeLast = 0.0;
                CFTimeInterval probeNow = CACurrentMediaTime();
                if (collectionWindow && probeNow - gERGridProbeLast > 1.5) {
                    gERGridProbeLast = probeNow;
                    CGFloat cellWinY = [collectionView convertRect:CGRectMake(0.0, frame.origin.y, frame.size.width, frame.size.height) toView:collectionWindow].origin.y;
                    NSMutableArray<NSString *> *chain = [NSMutableArray array];
                    UIView *node = collectionView;
                    for (NSUInteger depth = 0; node && depth < 7; depth++, node = node.superview) {
                        CGFloat nodeWinY = [node convertRect:node.bounds toView:collectionWindow].origin.y;
                        [chain addObject:[NSString stringWithFormat:@"%@:%.1f", NSStringFromClass(node.class), nodeWinY]];
                    }
                    NSNumber *baseNum = [gERGridContainerBaseY objectForKey:collectionWindow];
                    ERLogInfo(@"GRID-PROBE cellWinY=%.1f baseWinY=%.1f vShift=%.1f chain=%@", cellWinY,
                              baseNum ? baseNum.doubleValue : -1.0, verticalShift, chain);
                }
            } @catch (__unused NSException *exception) {}
        }

        // 1.0.9-1 · **顶部安全区基准锁定**：权限胶囊（相机/定位指示）出现时 iOS 会
        // 加大窗口顶部安全区，网格纵向居中的 floor 随之抬高 → 32 圆整体下移。
        // 这里只认**本窗口会话第一次读到的 top**（胶囊未出现时的原位），之后固定用
        // 基准 —— 胶囊出现/消失，网格纹丝不动；保留带 56 与底部安全区夹取照常。
        static CGFloat gERGridBaselineTopInset = -1.0;
        static UIWindow *gERGridBaselineWindow = nil;
        if (gERGridBaselineTopInset < 0.0 || gERGridBaselineWindow != collectionWindow) {
            gERGridBaselineTopInset = windowInsets.top;
            gERGridBaselineWindow = collectionWindow;
        } else {
            windowInsets.top = gERGridBaselineTopInset;
        }
        // 横屏折行 + 纵向定位诊断（0.5.15 / 0.5.16）。只在横屏时打印，且每个
        // 不同的组合只打一次。关键读数：
        //   nativeBaseX = 原生 x − 列 * 步长（各列恒等 → 原生对列 4-7 线性外推）
        //   nativeBaseY = 原生 y − 行 * 步长（纵向定位的原始基准）
        static NSMutableSet<NSString *> *landscapeLogged = nil;
        if (ERLandscapePresentationActive()) {
            if (!landscapeLogged) landscapeLogged = [NSMutableSet set];
            NSString *stateKey = [NSString stringWithFormat:@"state/%.0f", ERGridVisibleWidth()];
            if (![landscapeLogged containsObject:stateKey]) {
                [landscapeLogged addObject:stateKey];
                ERLogInfo(@"LANDSCAPE ver=1.0.9-103 cw=%.1f visibleW=%.1f cols=%lu stride=%lu blockRows=%lu blockCols=%lu",
                           containerWidth, ERGridVisibleWidth(),
                           (unsigned long)(kERLandscapeBlockColumns * 2),
                           (unsigned long)ERLayoutPageStrideRows(),
                           (unsigned long)kERLandscapeBlockRows, (unsigned long)kERLandscapeBlockColumns);
            }
            NSString *stateVKey = [NSString stringWithFormat:@"stateV/%.0f/%.0f/%.0f",
                                   containerHeight, windowInsets.top, windowInsets.bottom];
            if (![landscapeLogged containsObject:stateVKey]) {
                [landscapeLogged addObject:stateVKey];
                ERLogInfo(@"LANDSCAPEV ver=1.0.9-103 h=%.1f top=%.1f bot=%.1f extent=%.1f shift=%.1f",
                           containerHeight, windowInsets.top, windowInsets.bottom,
                           (CGFloat)kERLandscapeBlockRows * kERGridStep - kERGridGap, verticalShift);
            }
            NSString *rectKey = [NSString stringWithFormat:@"rect/%lu/%lu/%lu/%lu",
                                 (unsigned long)layoutRect.origin.x, (unsigned long)layoutRect.origin.y,
                                 (unsigned long)layoutRect.size.width, (unsigned long)layoutRect.size.height];
            if (![landscapeLogged containsObject:rectKey] && landscapeLogged.count < 64) {
                [landscapeLogged addObject:rectKey];
                ERLogInfo(@"LANDSCAPE rect x=%lu y=%lu %lux%lu nativeBaseX=%.1f nativeBaseY=%.1f shiftX=%.1f shiftY=%.1f finalX=%.1f finalY=%.1f",
                           (unsigned long)layoutRect.origin.x, (unsigned long)layoutRect.origin.y,
                           (unsigned long)layoutRect.size.width, (unsigned long)layoutRect.size.height,
                           nativeX - (CGFloat)layoutRect.origin.x * kERGridStep,
                           nativeY - (CGFloat)layoutRect.origin.y * kERGridStep,
                           shift, verticalShift, CGRectGetMinX(frame), CGRectGetMinY(frame));
            }
        }
    }
    return frame;
}

- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    UIView *nativeHit = %orig;
    if (nativeHit || !gEnabled) return nativeHit;

    UIView *collectionView = (UIView *)(id)self;
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        CGPoint overlayPoint = [collectionView convertPoint:point toView:overlay.view];
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
            if (!CGRectContainsPoint(ERVisibleModuleFrame(module, overlay), overlayPoint)) continue;
            CGPoint modulePoint = [collectionView convertPoint:point toView:module.view];
            UIView *moduleHit = [module.view hitTest:modulePoint withEvent:event];
            return moduleHit ?: module.view;
        }
    }
    return nil;
}

- (BOOL)pointInside:(CGPoint)point withEvent:(UIEvent *)event {
    BOOL insideOriginal = %orig;
    if (insideOriginal) return YES;
    if (!gEnabled) return NO;

    // iOS 16 keeps the collection view's original six-row bounds even when
    // EchoReborn's position provider lays modules into rows seven and eight.
    // UIKit consequently rejects touches before they reach those visible
    // module wrappers. Extend hit testing to the actual laid-out descendants
    // without changing the collection frame or any grid geometry.
    UIView *collectionView = (UIView *)(id)self;
    CGRect interactiveBounds = collectionView.bounds;
    for (UIView *subview in collectionView.subviews) {
        if (subview.hidden || subview.alpha <= 0.01) continue;
        interactiveBounds = CGRectUnion(interactiveBounds, subview.frame);
    }
    return CGRectContainsPoint(interactiveBounds, point);
}

%end

%hook UIWindow

- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    if (gEnabled && gERControlCenterPresented && !gEditModeActive && !gERExpandedModuleOpen) {
        for (UIViewController *overlay in gOverlayControllers.allObjects) {
            if (overlay.view.window != (UIWindow *)(id)self) continue;
            CGPoint overlayPoint = [(UIWindow *)(id)self convertPoint:point toView:overlay.view];
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
                if (!CGRectContainsPoint(ERVisibleModuleFrame(module, overlay), overlayPoint)) continue;
                CGPoint modulePoint = [(UIWindow *)(id)self convertPoint:point toView:module.view];
                UIView *moduleHit = [module.view hitTest:modulePoint withEvent:event];
                if (moduleHit) return moduleHit;
            }
        }
    }
    return %orig;
}

%end

%hook UIView

- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    if (gEnabled && !gEditModeActive && !gERExpandedModuleOpen) {
        for (UIViewController *overlay in gOverlayControllers.allObjects) {
            if ((UIView *)(id)self != overlay.view) continue;
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                if (module.view.hidden || module.view.alpha <= 0.01 || ERModuleViewIsPageHidden(module.view)) continue;
                if (!CGRectContainsPoint(ERVisibleModuleFrame(module, overlay), point)) continue;
                CGPoint modulePoint = [(UIView *)(id)self convertPoint:point toView:module.view];
                UIView *moduleHit = [module.view hitTest:modulePoint withEvent:event];
                if (moduleHit) return moduleHit;
            }
            break;
        }
    }
    return %orig;
}

%end

static NSArray<NSNumber *> *ERResizedPreviewSizeForDescendant(UIView *view) {
    for (UIView *ancestor = view; ancestor; ancestor = ancestor.superview) {
        NSArray<NSNumber *> *size = objc_getAssociatedObject(ancestor, kERResizePresentationSizeOverrideKey);
        if (size.count >= 2) return size;
    }
    return nil;
}

static void ERAnimateDiscreteMediaLayout(UIView *view) {
    Class filterClass = NSClassFromString(@"CAFilter");
    SEL factory = NSSelectorFromString(@"filterWithName:");
    id blur = filterClass && [filterClass respondsToSelector:factory] ?
        ((id (*)(id, SEL, id))objc_msgSend)(filterClass, factory, @"gaussianBlur") : nil;
    if (blur) {
        @try {
            [blur setValue:@"EchoRebornMediaLayoutBlur" forKey:@"name"];
            [blur setValue:@6.0 forKey:@"inputRadius"];
            [blur setValue:@YES forKey:@"inputNormalizeEdges"];
            view.layer.filters = @[blur];
            CABasicAnimation *blurAnimation = [CABasicAnimation animationWithKeyPath:@"filters.EchoRebornMediaLayoutBlur.inputRadius"];
            blurAnimation.fromValue = @6.0;
            blurAnimation.toValue = @0.0;
            blurAnimation.duration = 0.20;
            blurAnimation.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
            [blur setValue:@0.0 forKey:@"inputRadius"];
            [view.layer addAnimation:blurAnimation forKey:@"EchoRebornMediaLayoutBlur"];
        } @catch (__unused NSException *exception) { view.layer.filters = nil; }
    }
    view.layer.opacity = 1.0;
    CABasicAnimation *fade = [CABasicAnimation animationWithKeyPath:@"opacity"];
    fade.fromValue = @0.18;
    fade.toValue = @1.0;
    fade.duration = 0.20;
    fade.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
    [view.layer addAnimation:fade forKey:@"EchoRebornMediaLayoutFade"];
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.22 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (![view.layer animationForKey:@"EchoRebornMediaLayoutBlur"]) view.layer.filters = nil;
    });
}

// --- Media module internals (structure learned from CC26, credit
// therealhoodboy/CC26). The compact CC tile hosts MRUNowPlayingView with a
// `_layout` ivar (1/2 = expanded platter layouts, skip those), containing
// MRUNowPlayingControlsView -> _headerView (MRUNowPlayingHeaderView with
// _artworkView, native _routingButton, _labelView) + _transportControlsView
// (leftButton/middleButton/rightButton). ---

static UIView *ERIvarView(id object, const char *name) {
    if (!object) return nil;
    Ivar ivar = class_getInstanceVariable(object_getClass(object), name);
    if (!ivar) return nil;
    id value = object_getIvar(object, ivar);
    return [value isKindOfClass:[UIView class]] ? value : nil;
}

static UIView *ERMediaAncestorOfClass(UIView *view, NSString *className) {
    for (UIView *ancestor = view; ancestor; ancestor = ancestor.superview) {
        if ([NSStringFromClass(ancestor.class) isEqualToString:className]) return ancestor;
    }
    return nil;
}

// YES only for media views living inside a Control Center module tile (not the
// lock screen player) while the tile is in its collapsed `_layout`.
static BOOL ERMediaViewInsideControlCenterTile(UIView *view) {
    if (!gEnabled) return NO;
    UIView *container = ERMediaAncestorOfClass(view, @"CCUIContentModuleContentContainerView");
    if (!container) return NO;
    // Only the media module's OWN expansion hands the layout back to the
    // system; other modules expanding must not eject the tile from its custom
    // layout (that left it mangled in native form behind the platter). The
    // container's stuck-prone `_expanded` flag is consulted only inside
    // EchoReborn's own expansion window.
    if (gERExpandedModuleOpen) {
        BOOL mediaExpanding = [gERExpandedModuleIdentifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"];
        if (!mediaExpanding && !gERExpandedModuleIdentifier.length) {
            @try { mediaExpanding = [[container valueForKey:@"_expanded"] boolValue]; } @catch (__unused NSException *exception) {}
        }
        if (mediaExpanding) return NO;
    }
    UIView *npView = ERMediaAncestorOfClass(view, @"MRUNowPlayingView");
    if (npView) {
        @try {
            NSInteger layout = [[npView valueForKey:@"_layout"] integerValue];
            if (layout == 1 || layout == 2) return NO;
        } @catch (__unused NSException *exception) {}
    }
    return YES;
}

static NSString *ERMediaModeForNowPlayingView(UIView *npView) {
    NSArray<NSNumber *> *preview = ERResizedPreviewSizeForDescendant(npView);
    CGSize size = npView.bounds.size;
    // 0.5.10: 先以 EchoReborn 保存的自定义尺寸为准。
    //
    // 只靠 bounds 判断在改尺寸提交后的那一两帧是错的：布局动画期间 MRUNowPlayingView
    // 还是旧尺寸，模式却要按新尺寸算，于是 4x1 会被判成 compact（或反过来），
    // 表现为「编辑时正常、松手后错位」。编辑预览（preview）优先，其次才是已保存的
    // 网格尺寸，最后才退回bounds。
    NSArray<NSNumber *> *saved = gERCustomSizes[@"com.apple.mediaremote.controlcenter.nowplaying"];
    if (preview.count < 2 && saved.count >= 2) preview = saved;
    NSUInteger columns = preview.count >= 2 ? preview[0].unsignedIntegerValue : (size.width > 230.0 ? 4 : 2);
    NSUInteger rows = preview.count >= 2 ? preview[1].unsignedIntegerValue :
        (size.height < 100.0 ? 1 : (size.height > 230.0 ? 4 : 2));
    return columns < 4 ? @"compact" : [NSString stringWithFormat:@"wide%lu", (unsigned long)rows];
}

// Mode for any descendant of the now playing view; nil when EchoReborn should
// leave the native layout alone entirely.
static NSString *ERActiveMediaMode(UIView *descendant) {
    UIView *npView = ERMediaAncestorOfClass(descendant, @"MRUNowPlayingView");
    if (!npView || !ERMediaViewInsideControlCenterTile(npView)) return nil;
    NSString *stored = objc_getAssociatedObject(npView, kERNowPlayingLayoutModeKey);
    return stored ?: ERMediaModeForNowPlayingView(npView);
}

static void ERAdjustMediaLabelFonts(UIView *view, BOOL isTitle) {
    for (UIView *subview in view.subviews) {
        if ([subview isKindOfClass:[UILabel class]]) {
            UILabel *label = (UILabel *)subview;
            label.font = [UIFont systemFontOfSize:13.0 weight:isTitle ? UIFontWeightSemibold : UIFontWeightRegular];
            label.adjustsFontSizeToFitWidth = YES;
            label.minimumScaleFactor = 0.7;
            label.textAlignment = NSTextAlignmentLeft;
        } else {
            ERAdjustMediaLabelFonts(subview, isTitle);
        }
    }
}

// The system dims/hides pieces of the compact label stack for its own layout;
// force children visible whenever EchoReborn owns the geometry.
static void ERForceMediaSubviewAlphas(UIView *view) {
    for (UIView *subview in view.subviews) {
        if (!subview.hidden) subview.layer.opacity = 1.0;
    }
}

// Layout verified against the live iOS 16.5 hierarchy: every
// component is a direct child of MRUNowPlayingView — _artworkView (with its
// own placeholder system), _headerView (hosting _labelView + _routingButton),
// _timeControlsView, _transportControlsView, _volumeControlsView. The header
// is kept full-bleed so its children can be placed in tile coordinates; the
// sibling control strips are fronted above it for touch priority.
static void ERConfigureNowPlayingLayout(UIView *nowPlayingView) {
    if (!nowPlayingView) return;
    if (!ERMediaViewInsideControlCenterTile(nowPlayingView)) {
        // Leaving EchoReborn's tile modes (expansion, platter handoff): drop the
        // stored mode and give the wrapper its corner chrome back so the
        // native expanded layout isn't missing pieces.
        if (objc_getAssociatedObject(nowPlayingView, kERNowPlayingLayoutModeKey)) {
            objc_setAssociatedObject(nowPlayingView, kERNowPlayingLayoutModeKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
            UIView *wrapper = ERMediaAncestorOfClass(nowPlayingView, @"MRUControlCenterView");
            UIView *cornerRouting = ERIvarView(wrapper, "_routingButton");
            UIView *cornerMore = ERIvarView(wrapper, "_moreButton");
            if (cornerRouting) { cornerRouting.hidden = NO; cornerRouting.alpha = 1.0; }
            if (cornerMore) { cornerMore.hidden = NO; cornerMore.alpha = 1.0; }
            // The expanded platter reuses these exact subviews (_layout flip),
            // so every tile-mode override must be handed back to the system:
            // forced hidden/alpha on time & volume strips, the hidden rewind
            // button, the header play/pause button, and artwork styling.
            UIView *artwork = ERIvarView(nowPlayingView, "_artworkView");
            UIView *header = ERIvarView(nowPlayingView, "_headerView");
            UIView *time = ERIvarView(nowPlayingView, "_timeControlsView");
            UIView *transport = ERIvarView(nowPlayingView, "_transportControlsView");
            UIView *volume = ERIvarView(nowPlayingView, "_volumeControlsView");
            [UIView performWithoutAnimation:^{
                if (artwork) {
                    artwork.backgroundColor = UIColor.clearColor;
                    artwork.layer.cornerRadius = 0.0;
                    artwork.layer.masksToBounds = NO;
                }
                for (UIView *strip in @[time ?: (id)NSNull.null, volume ?: (id)NSNull.null]) {
                    if ((id)strip == NSNull.null) continue;
                    strip.hidden = NO;
                    @try {
                        NSString *flagKey = strip == time ? @"showTimeControlsView" : @"showVolumeControlsView";
                        strip.alpha = [[nowPlayingView valueForKey:flagKey] boolValue] ? 1.0 : 0.0;
                    } @catch (__unused NSException *exception) { strip.alpha = 1.0; }
                    strip.layer.opacity = strip.alpha;
                }
                UIView *leftButton = ERIvarView(transport, "_leftButton");
                UIView *stripRouting = ERIvarView(transport, "_routingButton");
                UIView *leadingButton = ERIvarView(transport, "_leadingButton");
                if (leftButton) { leftButton.hidden = NO; leftButton.alpha = 1.0; }
                if (stripRouting) stripRouting.hidden = NO;
                if (leadingButton) leadingButton.hidden = NO;
                UIView *headerTransport = ERIvarView(header, "_transportButton");
                if (headerTransport) headerTransport.hidden = NO;
            }];
            [nowPlayingView setNeedsLayout];
        }
        return;
    }
    NSString *mode = ERMediaModeForNowPlayingView(nowPlayingView);
    NSString *previous = objc_getAssociatedObject(nowPlayingView, kERNowPlayingLayoutModeKey);
    objc_setAssociatedObject(nowPlayingView, kERNowPlayingLayoutModeKey, mode, OBJC_ASSOCIATION_COPY_NONATOMIC);

    UIView *artwork = ERIvarView(nowPlayingView, "_artworkView");
    UIView *header = ERIvarView(nowPlayingView, "_headerView");
    UIView *time = ERIvarView(nowPlayingView, "_timeControlsView");
    UIView *transport = ERIvarView(nowPlayingView, "_transportControlsView");
    UIView *volume = ERIvarView(nowPlayingView, "_volumeControlsView");
    if (!header || !transport) return;

    BOOL wide1 = [mode isEqualToString:@"wide1"];
    BOOL wide2 = [mode isEqualToString:@"wide2"];
    BOOL wide4 = [mode isEqualToString:@"wide4"];
    BOOL showsTime = wide2 || wide4;
    BOOL showsVolume = wide4;
    CGFloat W = CGRectGetWidth(nowPlayingView.bounds);

    [UIView performWithoutAnimation:^{
        nowPlayingView.clipsToBounds = YES;
        header.frame = nowPlayingView.bounds;
        // The MRUControlCenterView wrapper draws its own corner routing
        // indicator and "more" button; EchoReborn's header routing button is the
        // sole routing control in every custom layout.
        UIView *wrapper = ERMediaAncestorOfClass(nowPlayingView, @"MRUControlCenterView");
        UIView *cornerRouting = ERIvarView(wrapper, "_routingButton");
        UIView *cornerMore = ERIvarView(wrapper, "_moreButton");
        if (cornerRouting) { cornerRouting.hidden = YES; cornerRouting.alpha = 0.0; }
        if (cornerMore) { cornerMore.hidden = YES; cornerMore.alpha = 0.0; }

        CGRect artworkFrame, transportFrame, timeFrame = CGRectZero, volumeFrame = CGRectZero;
        if (wide1) {
            artworkFrame = CGRectMake(8.0, 8.0, 51.0, 51.0);
            transportFrame = CGRectMake(170.0, 11.5, 84.0, 44.0);
        } else if (wide2) {
            artworkFrame = CGRectMake(12.0, 12.0, 122.0, 122.0);
            transportFrame = CGRectMake(142.0, 54.0, 140.0, 44.0);
            timeFrame = CGRectMake(142.0, 96.0, W - 162.0, 44.0);
        } else if (wide4) {
            artworkFrame = CGRectMake(16.0, 16.0, 96.0, 96.0);
            timeFrame = CGRectMake(20.0, 116.0, W - 40.0, 44.0);
            transportFrame = CGRectMake(52.0, 162.0, W - 104.0, 44.0);
            volumeFrame = CGRectMake(20.0, 208.0, W - 40.0, 44.0);
        } else {
            artworkFrame = CGRectMake(11.0, 10.0, 50.0, 50.0);
            transportFrame = CGRectMake(18.0, 100.0, 110.0, 44.0);
        }

        transport.frame = transportFrame;
        transport.alpha = 1.0;
        transport.layer.opacity = 1.0;
        transport.hidden = NO;

        if (artwork) {
            artwork.frame = artworkFrame;
            artwork.hidden = NO;
            artwork.alpha = 1.0;
            artwork.layer.opacity = 1.0;
            // Blank rounded placeholder with a light shade when nothing is
            // playing; MRUArtworkView's own placeholder draws on top when the
            // system provides one.
            artwork.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.12];
            artwork.layer.cornerRadius = CGRectGetWidth(artworkFrame) * 0.22;
            artwork.layer.cornerCurve = kCACornerCurveContinuous;
            artwork.layer.masksToBounds = YES;
            @try {
                if (![[artwork valueForKey:@"showPlaceholder"] boolValue]) [artwork setValue:@YES forKey:@"showPlaceholder"];
            } @catch (__unused NSException *exception) {}
        }
        if (time) {
            time.hidden = !showsTime;
            time.alpha = showsTime ? 1.0 : 0.0;
            time.layer.opacity = time.alpha;
            if (showsTime) {
                time.frame = timeFrame;
                [time setNeedsLayout];
            }
        }
        if (volume) {
            volume.hidden = !showsVolume;
            volume.alpha = showsVolume ? 1.0 : 0.0;
            volume.layer.opacity = volume.alpha;
            if (showsVolume) {
                volume.frame = volumeFrame;
                [volume setNeedsLayout];
            }
        }
        [nowPlayingView bringSubviewToFront:transport];
        if (time && showsTime) [nowPlayingView bringSubviewToFront:time];
        if (volume && showsVolume) [nowPlayingView bringSubviewToFront:volume];
    }];
    if (previous.length && ![previous isEqualToString:mode]) ERAnimateDiscreteMediaLayout(nowPlayingView);
    [header setNeedsLayout];
    [transport setNeedsLayout];
}

static UIViewController *ERConnectivityChild(UIViewController *controller, NSString *className) {
    NSMutableArray<UIViewController *> *queue = [NSMutableArray arrayWithArray:controller.childViewControllers];
    while (queue.count) {
        UIViewController *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if ([NSStringFromClass(candidate.class) isEqualToString:className]) return candidate;
        [queue addObjectsFromArray:candidate.childViewControllers];
    }
    return nil;
}

static NSString *ERConnectivityDetailChildClassForIdentifier(NSString *identifier) {
    NSString *lower = identifier.lowercaseString;
    if ([lower containsString:@".wifi"]) return @"CCUIConnectivityWifiViewController";
    if ([lower containsString:@".bluetooth"]) return @"CCUIConnectivityBluetoothViewController";
    if ([lower containsString:@".airdrop"]) return @"CCUIConnectivityAirDropViewController";
    return nil;
}

static UIViewController *ERConnectivityDetailFromConnectivityController(UIViewController *connectivity, NSString *identifier, id interactionController) {
    NSString *childClass = ERConnectivityDetailChildClassForIdentifier(identifier);
    if (!connectivity || !childClass.length) return nil;
    UIViewController *child = ERConnectivityChild(connectivity, childClass);
    SEL detailSelector = NSSelectorFromString(@"presentedViewControllerForContentModuleDetailClickPresentationInteractionController:");
    if (!child || ![child respondsToSelector:detailSelector]) return nil;
    @try {
        return ((UIViewController *(*)(id, SEL, id))objc_msgSend)((id)child, detailSelector, interactionController);
    } @catch (__unused NSException *exception) {
        return nil;
    }
}

static UIViewController *ERConnectivityDetailViewControllerForIdentifier(NSString *identifier, id interactionController) {
    if (!identifier.length) return nil;
    NSString *childClass = ERConnectivityDetailChildClassForIdentifier(identifier);
    if (!childClass.length) return nil;
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        UIViewController *presentedRoot = overlay.presentedViewController;
        UIViewController *presentedConnectivity = ERConnectivityChild(presentedRoot, @"CCUIConnectivityModuleViewController");
        if ([NSStringFromClass(presentedRoot.class) isEqualToString:@"CCUIConnectivityModuleViewController"]) presentedConnectivity = presentedRoot;
        UIViewController *detail = ERConnectivityDetailFromConnectivityController(presentedConnectivity, identifier, interactionController);
        if (detail) return detail;
    }
    for (UIViewController *overlay in gOverlayControllers.allObjects) {
        for (UIViewController *module in ERCollectModuleControllers(overlay)) {
            if (![ERModuleIdentifier(module) isEqualToString:@"com.apple.control-center.ConnectivityModule"]) continue;
            UIViewController *connectivity = ERConnectivityChild(module, @"CCUIConnectivityModuleViewController");
            if ([NSStringFromClass(module.class) isEqualToString:@"CCUIConnectivityModuleViewController"]) connectivity = module;
            UIViewController *detail = ERConnectivityDetailFromConnectivityController(connectivity, identifier, interactionController);
            if (detail) return detail;
        }
    }
    return nil;
}

static UIViewController *ERStandaloneConnectivityDetailIMP(id self, SEL _cmd, id interactionController) {
    NSString *identifier = nil;
    if ([self isKindOfClass:[UIViewController class]]) identifier = ((UIViewController *)self).view.accessibilityIdentifier;
    return ERConnectivityDetailViewControllerForIdentifier(identifier, interactionController);
}

static void ERInstallStandaloneConnectivityDetailMethod(void) {
    static BOOL installed = NO;
    if (installed) return;
    Class cls = NSClassFromString(@"ERConnectivityButtonViewController");
    if (!cls) return;
    SEL detailSelector = NSSelectorFromString(@"presentedViewControllerForContentModuleDetailClickPresentationInteractionController:");
    class_addMethod(cls, detailSelector, (IMP)ERStandaloneConnectivityDetailIMP, "@@:@");
    installed = YES;
}

static void EROpenPendingConnectivityDetailFromPresentation(UIPresentationController *presentationController) {
    NSString *identifier = gERConnectivityPendingDetailIdentifier.copy;
    gERConnectivityPendingDetailIdentifier = nil;
    if (!identifier.length || !presentationController.presentedViewController) return;
    // The per-toggle menu returned by Apple's connectivity child is only the
    // content controller. The private click presentation interaction normally
    // wraps it in a CCUI detail container. Presenting it manually makes the
    // list fill the screen and leaves the first-level platter visible behind
    // it, so keep this path as a no-op fallback and let the native detail
    // selector hooks service real pressure interactions directly.
    (void)presentationController;
}

static void ERResetConnectivityCompactTransforms(UIViewController *controller) {
    if (!controller) return;
    NSArray<NSString *> *classes = @[
        @"CCUIConnectivityAirplaneViewController", @"CCUIConnectivityCellularDataViewController",
        @"CCUIConnectivityWifiViewController", @"CCUIConnectivityBluetoothViewController",
        @"CCUIConnectivityAirDropViewController", @"CCUIConnectivityHotspotViewController"
    ];
    [UIView performWithoutAnimation:^{
        for (NSString *name in classes) {
            UIViewController *child = ERConnectivityChild(controller, name);
            if (child) {
                child.view.transform = CGAffineTransformIdentity;
                UIView *roundButton = ERFindSubviewWithClassName(child.view, @"CCUIRoundButton");
                objc_setAssociatedObject(roundButton, kERConnectivityExpandedCardKey, nil, OBJC_ASSOCIATION_ASSIGN);
                objc_setAssociatedObject(roundButton, kERConnectivityExpandedSurfaceKey, nil, OBJC_ASSOCIATION_ASSIGN);
                objc_setAssociatedObject(roundButton, kERConnectivityExpandedGridGlyphKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                for (UIView *glyph in ERCompactGlyphHosts(roundButton)) glyph.transform = CGAffineTransformIdentity;
            }
        }
        UIView *expand = [controller.view viewWithTag:kERConnectivityExpandButtonTag];
        UIView *vpn = [controller.view viewWithTag:kERConnectivityMiniClusterTag];
        UIView *airDropProxy = [controller.view viewWithTag:kERConnectivityCompactAirDropTag];
        UIView *bluetoothProxy = [controller.view viewWithTag:kERConnectivityCompactBluetoothTag];
        expand.hidden = YES;
        vpn.hidden = YES;
        airDropProxy.hidden = YES;
        bluetoothProxy.hidden = YES;
    }];
}

static void ERRestoreConnectivityContainerMaterial(UIView *root) {
    UIView *container = root.superview;
    while (container && ![NSStringFromClass(container.class) isEqualToString:@"CCUIContentModuleContentContainerView"]) container = container.superview;
    if (!container) return;
    for (UIView *child in container.subviews) {
        NSString *name = NSStringFromClass(child.class);
        if ([name containsString:@"Material"] || [child isKindOfClass:[UIVisualEffectView class]]) {
            child.hidden = NO;
            child.alpha = 1.0;
        }
    }
}

static void ERRestoreSuppressedMaterialsInTree(UIView *root) {
    if (!root) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if ([objc_getAssociatedObject(candidate, kERConnectivitySuppressedSurfaceKey) boolValue]) {
            objc_setAssociatedObject(candidate, kERConnectivitySuppressedSurfaceKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            candidate.hidden = NO;
            candidate.alpha = 1.0;
            candidate.layer.opacity = 1.0;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

// Watchdog: the connectivity expansion choreography (snapshot window, hidden
// live platter, suppressed materials) assumes the six-card platter completes
// its reveal. Detail expansions that merely route THROUGH the connectivity
// module (the Wi-Fi list) can strand that state, which then hides every later
// platter until respring. Reset everything whenever no expansion is open.
static void ERResetConnectivityExpansionState(UIViewController *overlay) {
    gERConnectivityExpansionActive = NO;
    gERConnectivityProxyExpansionActive = NO;
    gERConnectivityClosingTransitionActive = NO;
    gERConnectivityClosingFinishScheduled = NO;
    gERConnectivitySnapshotCaptureActive = NO;
    gERConnectivityClosingTransitionDeadline = 0.0;
    gERConnectivityTransitionController = nil;
    gERConnectivityTransitionPresentationController = nil;
    gERConnectivityProxySourceView = nil;
    gERConnectivityProxySourceWindowFrame = CGRectZero;
    gERConnectivityProxySourceCornerRadius = 32.0;
    gERConnectivityHasProxySourceFrame = NO;
    gERConnectivityPendingDetailIdentifier = nil;
    gERConnectivityTransitionGeneration++;
    if (gERConnectivityTransitionSurface) {
        [gERConnectivityTransitionSurface removeFromSuperview];
        gERConnectivityTransitionSurface = nil;
    }
    if (gERConnectivityTransitionHost) {
        [gERConnectivityTransitionHost removeFromSuperview];
        gERConnectivityTransitionHost = nil;
    }
    if (gERConnectivityTransitionWindow) {
        gERConnectivityTransitionWindow.hidden = YES;
        gERConnectivityTransitionWindow = nil;
    }
    ERRestoreSuppressedMaterialsInTree(overlay.view);
    ERRestoreSuppressedMaterialsInTree(overlay.presentedViewController.presentationController.containerView);
}

static UIImage *ERConnectivityControlSnapshot(UIViewController *child, CGSize targetSize) {
    if (!child.view || targetSize.width < 1.0 || targetSize.height < 1.0) return nil;
    if (![objc_getAssociatedObject(child, kERConnectivityProxyPreparedKey) boolValue]) {
        [child beginAppearanceTransition:YES animated:NO];
        [child endAppearanceTransition];
        objc_setAssociatedObject(child, kERConnectivityProxyPreparedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    BOOL childWasHidden = child.view.hidden;
    CGFloat childAlpha = child.view.alpha;
    child.view.hidden = NO;
    child.view.alpha = 1.0;
    [child.view setNeedsLayout];
    [child.view layoutIfNeeded];
    UIView *roundButton = ERFindSubviewWithClassName(child.view, @"CCUIRoundButton");
    if (!roundButton) {
        child.view.hidden = childWasHidden;
        child.view.alpha = childAlpha;
        return nil;
    }
    CGSize sourceSize = roundButton.bounds.size;
    if (sourceSize.width < 1.0 || sourceSize.height < 1.0) sourceSize = roundButton.frame.size;
    if (sourceSize.width < 1.0 || sourceSize.height < 1.0) {
        child.view.hidden = childWasHidden;
        child.view.alpha = childAlpha;
        return nil;
    }
    UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat defaultFormat];
    format.opaque = NO;
    format.scale = UIScreen.mainScreen.scale;
    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:targetSize format:format];
    UIImage *image = [renderer imageWithActions:^(UIGraphicsImageRendererContext *context) {
        CGContextSaveGState(context.CGContext);
        CGContextScaleCTM(context.CGContext, targetSize.width / sourceSize.width, targetSize.height / sourceSize.height);
        BOOL drawn = [roundButton drawViewHierarchyInRect:(CGRect){CGPointZero, sourceSize} afterScreenUpdates:YES];
        if (!drawn) [roundButton.layer renderInContext:context.CGContext];
        CGContextRestoreGState(context.CGContext);
    }];
    child.view.hidden = childWasHidden;
    child.view.alpha = childAlpha;
    return image;
}

static UIButton *ERConnectivitySnapshotProxy(UIView *root, NSInteger tag, CGRect frame, UIViewController *child) {
    UIButton *proxy = (UIButton *)[root viewWithTag:tag];
    if (!proxy) {
        proxy = [UIButton buttonWithType:UIButtonTypeCustom];
        proxy.tag = tag;
        proxy.imageView.contentMode = UIViewContentModeScaleAspectFit;
        [proxy addTarget:[EchoRebornCoordinator shared] action:@selector(connectivityProxyTapped:) forControlEvents:UIControlEventTouchUpInside];
        [root addSubview:proxy];
    }
    UIView *roundButton = ERFindSubviewWithClassName(child.view, @"CCUIRoundButton");
    if ([roundButton isKindOfClass:[UIControl class]]) objc_setAssociatedObject(proxy, kERConnectivityForwardControlKey, roundButton, OBJC_ASSOCIATION_ASSIGN);
    proxy.frame = frame;
    proxy.hidden = NO;
    proxy.clipsToBounds = NO;
    if (tag == kERConnectivityCompactAirDropTag) {
        CFPropertyListRef rawMode = CFPreferencesCopyAppValue(CFSTR("DiscoverableMode"), CFSTR("com.apple.sharingd"));
        NSString *mode = CFBridgingRelease(rawMode);
        BOOL receiving = mode.length && [mode rangeOfString:@"Off" options:NSCaseInsensitiveSearch].location == NSNotFound;
        proxy.backgroundColor = receiving ? [UIColor colorWithRed:0.61 green:0.14 blue:0.96 alpha:1.0]
                                          : [UIColor colorWithWhite:1.0 alpha:0.14];
        proxy.layer.cornerRadius = CGRectGetHeight(frame) * 0.5;
        proxy.layer.cornerCurve = kCACornerCurveContinuous;
        proxy.layer.masksToBounds = YES;
    }
    UIImage *snapshot = ERConnectivityControlSnapshot(child, frame.size);
    if (snapshot) [proxy setImage:snapshot forState:UIControlStateNormal];
    if (tag == kERConnectivityCompactAirDropTag) {
        UIView *roundButton = ERFindSubviewWithClassName(child.view, @"CCUIRoundButton");
        NSMutableArray<UIView *> *queue = roundButton ? [NSMutableArray arrayWithObject:roundButton] : [NSMutableArray array];
        UIImage *glyph = nil;
        while (queue.count && !glyph) {
            UIView *candidate = queue.firstObject;
            [queue removeObjectAtIndex:0];
            if ([candidate isKindOfClass:[UIImageView class]] && ((UIImageView *)candidate).image && candidate.alpha > 0.01 && !candidate.hidden) {
                glyph = ((UIImageView *)candidate).image;
                break;
            }
            [queue addObjectsFromArray:candidate.subviews];
        }
        if (glyph) {
            [proxy setImage:[glyph imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate] forState:UIControlStateNormal];
            proxy.tintColor = UIColor.whiteColor;
            proxy.imageView.contentMode = UIViewContentModeScaleAspectFit;
            proxy.imageView.transform = CGAffineTransformMakeScale(0.56, 0.56);
        }
    }
    return proxy;
}

typedef struct {
    CGFloat inset;
    CGFloat gap;
    CGFloat square;
    CGFloat barHeight;
    CGFloat contentHeight;
} ERConnectivityExpandedMetrics;

typedef struct {
    CGFloat inset;
    CGFloat gap;
    CGFloat cell;
    CGRect topLeft;
    CGRect topRight;
    CGRect bottomLeft;
    CGRect bottomRight;
} ERConnectivityCompactMetrics;

static ERConnectivityCompactMetrics ERConnectivityCompactMetricsForBounds(CGRect bounds) {
    CGFloat side = MIN(CGRectGetWidth(bounds), CGRectGetHeight(bounds));
    CGFloat inset = MAX(6.0, round(side * 0.103));
    CGFloat gap = MAX(4.0, round(side * 0.055));
    CGFloat cell = floor((side - inset * 2.0 - gap) * 0.5);
    CGFloat originX = round((CGRectGetWidth(bounds) - (cell * 2.0 + gap)) * 0.5);
    CGFloat originY = round((CGRectGetHeight(bounds) - (cell * 2.0 + gap)) * 0.5);
    CGRect topLeft = CGRectMake(originX, originY, cell, cell);
    CGRect topRight = CGRectMake(originX + cell + gap, originY, cell, cell);
    CGRect bottomLeft = CGRectMake(originX, originY + cell + gap, cell, cell);
    CGRect bottomRight = CGRectMake(originX + cell + gap, originY + cell + gap, cell, cell);
    return (ERConnectivityCompactMetrics){inset, gap, cell, topLeft, topRight, bottomLeft, bottomRight};
}

static ERConnectivityExpandedMetrics ERConnectivityMetricsForWidth(CGFloat width) {
    // All expanded geometry is derived from the actual presentation width.
    // The ratios follow the later Control Center platter while preserving true
    // squares and equal icon inset on every supported screen size.
    CGFloat inset = MAX(12.0, round(width * 0.05));
    CGFloat gap = MAX(8.0, round(width * 0.031));
    CGFloat contentWidth = MAX(1.0, width - inset * 2.0);
    CGFloat square = floor((contentWidth - gap) * 0.5);
    CGFloat barHeight = MAX(52.0, round(square * 0.445));
    CGFloat contentHeight = inset * 2.0 + square * 2.0 + barHeight * 3.0 + gap * 4.0;
    return (ERConnectivityExpandedMetrics){inset, gap, square, barHeight, contentHeight};
}

static BOOL ERIsOwnedConnectivityMaterial(UIView *view) {
    if (!view) return NO;
    NSInteger tag = view.tag;
    return (tag >= kERConnectivityExpandedCardBaseTag && tag < kERConnectivityExpandedCardBaseTag + 6) ||
           tag == kERConnectivityExpandedVPNTag;
}

static UIView *ERConnectivityNativeMaterialSource(UIView *root) {
    if (!root) return nil;
    UIView *container = root;
    while (container && ![NSStringFromClass(container.class) isEqualToString:@"CCUIContentModuleContentContainerView"]) {
        container = container.superview;
    }
    if (!container) container = root.superview ?: root;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:container];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if (candidate != root && !ERIsOwnedConnectivityMaterial(candidate) &&
            [NSStringFromClass(candidate.class) isEqualToString:@"MTMaterialView"]) {
            return candidate;
        }
        if (!ERIsOwnedConnectivityMaterial(candidate)) [queue addObjectsFromArray:candidate.subviews];
    }
    return nil;
}

static UIView *ERNewConnectivityMaterialView(UIView *root) {
    UIView *source = ERConnectivityNativeMaterialSource(root);
    UIView *material = nil;
    if (source && [source conformsToProtocol:@protocol(NSCopying)]) {
        @try { material = [source copy]; } @catch (__unused NSException *exception) {}
    }
    if (!material && source && [source respondsToSelector:NSSelectorFromString(@"recipe")]) {
        Class materialClass = NSClassFromString(@"MTMaterialView");
        SEL factory = NSSelectorFromString(@"materialViewWithRecipe:");
        if ([materialClass respondsToSelector:factory]) {
            long long recipe = ((long long (*)(id, SEL))objc_msgSend)(source, NSSelectorFromString(@"recipe"));
            material = ((id (*)(id, SEL, long long))objc_msgSend)(materialClass, factory, recipe);
        }
    }
    if (!material) {
        UIVisualEffectView *fallback = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThinMaterialDark]];
        fallback.contentView.backgroundColor = [UIColor.whiteColor colorWithAlphaComponent:0.055];
        material = fallback;
    }
    material.hidden = NO;
    material.alpha = 1.0;
    material.userInteractionEnabled = NO;
    material.backgroundColor = UIColor.clearColor;
    material.layer.cornerCurve = kCACornerCurveContinuous;
    return material;
}

static UIView *ERConnectivityLabeledButton(UIViewController *child) {
    UIView *labeled = ERFindSubviewWithClassName(child.view, @"CCUILabeledRoundButton");
    return labeled ?: child.view;
}

static UILabel *ERConnectivityLabel(UIView *labeled, SEL selector) {
    if (![labeled respondsToSelector:selector]) return nil;
    id label = ((id (*)(id, SEL))objc_msgSend)(labeled, selector);
    return [label isKindOfClass:[UILabel class]] ? label : nil;
}

static void ERApplyConnectivityCaret(UILabel *subtitle, NSString *text) {
    if (!subtitle || !text.length) return;
    UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:7.5 weight:UIImageSymbolWeightSemibold];
    UIImage *image = [[UIImage systemImageNamed:@"chevron.up.chevron.down" withConfiguration:configuration]
        imageWithTintColor:subtitle.textColor ?: [UIColor.whiteColor colorWithAlphaComponent:0.62]
        renderingMode:UIImageRenderingModeAlwaysOriginal];
    if (!image) { subtitle.text = text; return; }
    NSTextAttachment *attachment = [NSTextAttachment new];
    attachment.image = image;
    attachment.bounds = CGRectMake(0.0, -1.0, image.size.width, image.size.height);
    NSMutableAttributedString *value = [[NSMutableAttributedString alloc] initWithString:[text stringByAppendingString:@" "]
                                                                               attributes:@{NSFontAttributeName: subtitle.font,
                                                                                            NSForegroundColorAttributeName: subtitle.textColor}];
    [value appendAttributedString:[NSAttributedString attributedStringWithAttachment:attachment]];
    subtitle.attributedText = value;
}

static void ERStyleExpandedConnectivityChild(UIViewController *child, UIView *card, CGRect frame) {
    if (!child.view || CGRectIsNull(frame)) return;
    UIView *labeled = ERConnectivityLabeledButton(child);
    UIView *roundButton = ERFindSubviewWithClassName(child.view, @"CCUIRoundButton");
    BOOL wide = CGRectGetHeight(frame) < CGRectGetWidth(frame) * 0.7;
    CGFloat iconSide = 38.0;
    CGFloat iconInset = wide ? round((CGRectGetHeight(frame) - iconSide) * 0.5) : 16.0;
    if (labeled != child.view) labeled.frame = child.view.bounds;
    if (roundButton) {
        roundButton.frame = CGRectMake(iconInset, iconInset, iconSide, iconSide);
        objc_setAssociatedObject(roundButton, kERConnectivityExpandedCardKey, card, OBJC_ASSOCIATION_ASSIGN);
        objc_setAssociatedObject(roundButton, kERConnectivityExpandedSurfaceKey, child.view, OBJC_ASSOCIATION_ASSIGN);
        // The system reuses these button instances when connectivity moves
        // between its compact and expanded controllers. Mark only the four
        // square-grid controls, and apply/reset the glyph transform at the same
        // moment as the expanded geometry so it cannot leak into compact mode.
        objc_setAssociatedObject(roundButton, kERConnectivityExpandedGridGlyphKey,
                                 wide ? nil : @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        for (UIView *glyph in ERCompactGlyphHosts(roundButton)) {
            glyph.transform = wide ? CGAffineTransformIdentity : CGAffineTransformMakeScale(0.86, 0.86);
        }
    }
    objc_setAssociatedObject(labeled, kERConnectivityExpandedCardKey, card, OBJC_ASSOCIATION_ASSIGN);

    UILabel *title = ERConnectivityLabel(labeled, NSSelectorFromString(@"titleLabel"));
    UILabel *subtitle = ERConnectivityLabel(labeled, NSSelectorFromString(@"subtitleLabel"));
    if (!title || !subtitle) {
        NSMutableArray<UILabel *> *labels = [NSMutableArray array];
        NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:labeled];
        while (queue.count) {
            UIView *candidate = queue.firstObject;
            [queue removeObjectAtIndex:0];
            if ([candidate isKindOfClass:[UILabel class]]) [labels addObject:(UILabel *)candidate];
            [queue addObjectsFromArray:candidate.subviews];
        }
        if (!title && labels.count) title = labels.firstObject;
        if (!subtitle && labels.count > 1) subtitle = labels[1];
    }
    if (subtitle) subtitle.textColor = [UIColor.whiteColor colorWithAlphaComponent:0.62];
    if (wide) {
        CGFloat labelX = iconInset * 2.0 + iconSide;
        CGFloat lineHeight = 17.0;
        CGFloat groupTop = round((CGRectGetHeight(frame) - lineHeight * 2.0) * 0.5);
        if (title) {
            title.textAlignment = NSTextAlignmentLeft;
            title.frame = CGRectMake(labelX, groupTop, CGRectGetWidth(frame) - labelX - iconInset, lineHeight);
        }
        if (subtitle) {
            subtitle.textAlignment = NSTextAlignmentLeft;
            subtitle.frame = CGRectMake(labelX, groupTop + lineHeight, CGRectGetWidth(frame) - labelX - iconInset, lineHeight);
        }
        return;
    }

    if (!title) return;

    CGFloat textX = 21.0;
    CGFloat textWidth = MAX(0.0, CGRectGetWidth(frame) - textX - 24.0);
    CGFloat lineHeight = 14.3333;
    title.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightSemibold];
    title.numberOfLines = 2;
    title.lineBreakMode = NSLineBreakByTruncatingTail;
    subtitle.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightRegular];
    subtitle.numberOfLines = 1;
    NSString *titleText = [labeled respondsToSelector:NSSelectorFromString(@"title")]
        ? ((id (*)(id, SEL))objc_msgSend)(labeled, NSSelectorFromString(@"title")) : title.text;
    NSString *subtitleText = [labeled respondsToSelector:NSSelectorFromString(@"subtitle")]
        ? ((id (*)(id, SEL))objc_msgSend)(labeled, NSSelectorFromString(@"subtitle")) : subtitle.text;
    titleText = titleText ?: @"";
    subtitleText = subtitleText ?: @"";
    CGRect measuredTitle = [titleText boundingRectWithSize:CGSizeMake(textWidth, lineHeight * 2.0)
                                                   options:NSStringDrawingUsesLineFragmentOrigin | NSStringDrawingUsesFontLeading
                                                attributes:@{NSFontAttributeName: title.font}
                                                   context:nil];
    CGFloat titleHeight = measuredTitle.size.height > lineHeight + 1.0 ? lineHeight * 2.0 : lineHeight;
    BOOL showsSubtitle = subtitleText.length > 0;
    CGFloat groupHeight = titleHeight + (showsSubtitle ? lineHeight : 0.0);
    CGFloat groupTop = CGRectGetHeight(frame) - 17.3333 - groupHeight;
    title.frame = CGRectMake(textX, groupTop, textWidth, titleHeight);
    subtitle.frame = CGRectMake(textX, groupTop + titleHeight, textWidth, lineHeight);
    subtitle.hidden = !showsSubtitle;
    title.textAlignment = NSTextAlignmentLeft;
    subtitle.textAlignment = NSTextAlignmentLeft;

    NSString *name = NSStringFromClass(child.class);
    BOOL hasSubmenu = [name containsString:@"Wifi"] || [name containsString:@"AirDrop"] || [name containsString:@"Bluetooth"];
    if (hasSubmenu && showsSubtitle) ERApplyConnectivityCaret(subtitle, subtitleText);
    else subtitle.text = subtitleText;
}

static void ERConfigureConnectivityLayout(UIViewController *controller) {
    if (!gEnabled || !controller.view) return;
    UIView *root = controller.view;
    NSArray<NSString *> *classes = @[
        @"CCUIConnectivityAirplaneViewController", @"CCUIConnectivityCellularDataViewController",
        @"CCUIConnectivityWifiViewController", @"CCUIConnectivityBluetoothViewController",
        @"CCUIConnectivityAirDropViewController", @"CCUIConnectivityHotspotViewController"
    ];
    NSMutableDictionary<NSString *, UIViewController *> *children = [NSMutableDictionary dictionary];
    for (NSString *name in classes) {
        UIViewController *child = ERConnectivityChild(controller, name);
        if (child) children[name] = child;
    }
    BOOL compact = CGRectGetWidth(root.bounds) < 190.0 && CGRectGetHeight(root.bounds) < 190.0;
    UIButton *expand = (UIButton *)[root viewWithTag:kERConnectivityExpandButtonTag];
    UIView *miniCluster = [root viewWithTag:kERConnectivityMiniClusterTag];
    if (!compact) {
        ERResetConnectivityCompactTransforms(controller);
        expand.hidden = YES;
        miniCluster.hidden = YES;
        BOOL expanded = gERExpandedModuleOpen && CGRectGetWidth(root.bounds) > 250.0 && CGRectGetHeight(root.bounds) > 300.0;
        UIScrollView *scroll = nil;
        for (UIView *candidate in root.subviews) if ([candidate isKindOfClass:[UIScrollView class]]) { scroll = (UIScrollView *)candidate; break; }
        for (NSInteger tag = kERConnectivityExpandedCardBaseTag; tag < kERConnectivityExpandedCardBaseTag + 6; tag++) {
            UIView *card = [root viewWithTag:tag];
            card.hidden = !expanded;
        }
        UIView *vpnCard = [root viewWithTag:kERConnectivityExpandedVPNTag];
        vpnCard.hidden = !expanded;
        if (expanded && scroll) {
            CGFloat width = CGRectGetWidth(root.bounds);
            ERConnectivityExpandedMetrics metrics = ERConnectivityMetricsForWidth(width);
            NSDictionary<NSString *, NSValue *> *frames = @{
                @"CCUIConnectivityAirplaneViewController": [NSValue valueWithCGRect:ERExpandedConnectivityFrameForClass(@"CCUIConnectivityAirplaneViewController", root.bounds.size)],
                @"CCUIConnectivityWifiViewController": [NSValue valueWithCGRect:ERExpandedConnectivityFrameForClass(@"CCUIConnectivityWifiViewController", root.bounds.size)],
                @"CCUIConnectivityAirDropViewController": [NSValue valueWithCGRect:ERExpandedConnectivityFrameForClass(@"CCUIConnectivityAirDropViewController", root.bounds.size)],
                @"CCUIConnectivityCellularDataViewController": [NSValue valueWithCGRect:ERExpandedConnectivityFrameForClass(@"CCUIConnectivityCellularDataViewController", root.bounds.size)],
                @"CCUIConnectivityBluetoothViewController": [NSValue valueWithCGRect:ERExpandedConnectivityFrameForClass(@"CCUIConnectivityBluetoothViewController", root.bounds.size)],
                @"CCUIConnectivityHotspotViewController": [NSValue valueWithCGRect:ERExpandedConnectivityFrameForClass(@"CCUIConnectivityHotspotViewController", root.bounds.size)],
            };
            NSArray<NSString *> *cardOrder = @[
                @"CCUIConnectivityAirplaneViewController", @"CCUIConnectivityWifiViewController",
                @"CCUIConnectivityAirDropViewController", @"CCUIConnectivityCellularDataViewController",
                @"CCUIConnectivityBluetoothViewController", @"CCUIConnectivityHotspotViewController"
            ];
            [UIView performWithoutAnimation:^{
                scroll.scrollEnabled = YES;
                scroll.frame = root.bounds;
                scroll.bounds = root.bounds;
                scroll.contentSize = CGSizeMake(width, MAX(CGRectGetHeight(root.bounds), metrics.contentHeight));
                [cardOrder enumerateObjectsUsingBlock:^(NSString *name, NSUInteger index, __unused BOOL *stop) {
                    UIViewController *child = children[name];
                    CGRect frame = [frames[name] CGRectValue];
                    if (!child) return;
                    UIView *card = [root viewWithTag:kERConnectivityExpandedCardBaseTag + (NSInteger)index];
                    if (!card) {
                        card = ERNewConnectivityMaterialView(root);
                        card.tag = kERConnectivityExpandedCardBaseTag + (NSInteger)index;
                        card.userInteractionEnabled = NO;
                        card.layer.cornerCurve = kCACornerCurveContinuous;
                        [scroll insertSubview:card atIndex:0];
                    }
                    card.hidden = NO;
                    card.frame = frame;
                    BOOL squareCard = fabs(CGRectGetWidth(frame) - CGRectGetHeight(frame)) < 2.0;
                    card.layer.cornerRadius = squareCard ? MIN(26.0, round(CGRectGetWidth(frame) * 0.17))
                                                        : MIN(22.0, round(CGRectGetHeight(frame) * 0.38));
                    card.layer.masksToBounds = YES;
                    child.view.transform = CGAffineTransformIdentity;
                    child.view.hidden = NO;
                    child.view.alpha = 1.0;
                    child.view.frame = frame;
                    ERStyleExpandedConnectivityChild(child, card, frame);
                    [scroll bringSubviewToFront:child.view];
                }];
                UIControl *vpn = (UIControl *)[root viewWithTag:kERConnectivityExpandedVPNTag];
                CGRect hotspotFrame = [frames[@"CCUIConnectivityHotspotViewController"] CGRectValue];
                CGRect vpnFrame = CGRectMake(metrics.inset, CGRectGetMaxY(hotspotFrame) + metrics.gap, width - metrics.inset * 2.0, metrics.barHeight);
                if (!vpn) {
                    vpn = [[UIControl alloc] initWithFrame:vpnFrame];
                    vpn.tag = kERConnectivityExpandedVPNTag;
                    vpn.backgroundColor = UIColor.clearColor;
                    vpn.layer.cornerRadius = 20.0;
                    vpn.layer.cornerCurve = kCACornerCurveContinuous;
                    vpn.layer.masksToBounds = YES;
                    UIView *vpnMaterial = ERNewConnectivityMaterialView(root);
                    vpnMaterial.tag = 90;
                    vpnMaterial.frame = vpn.bounds;
                    vpnMaterial.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
                    vpnMaterial.userInteractionEnabled = NO;
                    [vpn addSubview:vpnMaterial];
                    [vpn addTarget:[EchoRebornCoordinator shared] action:@selector(openVPNSettings:) forControlEvents:UIControlEventTouchUpInside];
                    UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:16.0 weight:UIImageSymbolWeightMedium];
                    UIImageView *icon = [[UIImageView alloc] initWithImage:[UIImage systemImageNamed:@"network" withConfiguration:configuration]];
                    icon.tag = 1; icon.tintColor = [UIColor.whiteColor colorWithAlphaComponent:0.45]; icon.contentMode = UIViewContentModeCenter;
                    CGFloat iconSide = 38.0;
                    CGFloat iconInset = round((metrics.barHeight - iconSide) * 0.5);
                    icon.frame = CGRectMake(iconInset, iconInset, iconSide, iconSide); icon.backgroundColor = [UIColor.whiteColor colorWithAlphaComponent:0.08]; icon.layer.cornerRadius = iconSide * 0.5;
                    [vpn addSubview:icon];
                    CGFloat labelX = iconInset * 2.0 + iconSide;
                    CGFloat labelTop = round((metrics.barHeight - 34.0) * 0.5);
                    UILabel *title = [[UILabel alloc] initWithFrame:CGRectMake(labelX, labelTop, CGRectGetWidth(vpnFrame) - labelX - iconInset, 17.0)];
                    title.text = @"VPN"; title.font = [UIFont systemFontOfSize:13.0 weight:UIFontWeightSemibold]; title.textColor = [UIColor.whiteColor colorWithAlphaComponent:0.58];
                    [vpn addSubview:title];
                    UILabel *status = [[UILabel alloc] initWithFrame:CGRectMake(labelX, labelTop + 17.0, CGRectGetWidth(vpnFrame) - labelX - iconInset, 17.0)];
                    status.text = @"关闭"; status.font = [UIFont systemFontOfSize:12.0 weight:UIFontWeightRegular]; status.textColor = [UIColor.whiteColor colorWithAlphaComponent:0.38];
                    [vpn addSubview:status];
                    [scroll addSubview:vpn];
                }
                vpn.hidden = NO;
                vpn.frame = vpnFrame;
                [vpn viewWithTag:90].frame = vpn.bounds;
                [scroll bringSubviewToFront:vpn];
            }];
        }
        return;
    }

    // Expanded card backings live inside the connectivity scroll view. They
    // must be hidden explicitly when the same controller collapses back into
    // its 2x2 module; otherwise the wide/square cards remain visible behind
    // the compact controls until the controller is recreated.
    ERResetConnectivityCompactTransforms(controller);
    for (NSInteger tag = kERConnectivityExpandedCardBaseTag; tag < kERConnectivityExpandedCardBaseTag + 6; tag++) {
        UIView *card = [root viewWithTag:tag];
        card.hidden = YES;
    }
    UIView *expandedVPN = [root viewWithTag:kERConnectivityExpandedVPNTag];
    expandedVPN.hidden = YES;
    ERRestoreConnectivityContainerMaterial(root);

    ERConnectivityCompactMetrics compactMetrics = ERConnectivityCompactMetricsForBounds(root.bounds);
    NSDictionary<NSString *, NSValue *> *largeFrames = @{
        @"CCUIConnectivityAirplaneViewController": [NSValue valueWithCGRect:compactMetrics.topLeft],
        @"CCUIConnectivityWifiViewController": [NSValue valueWithCGRect:compactMetrics.bottomLeft],
    };
    [UIView performWithoutAnimation:^{
        [largeFrames enumerateKeysAndObjectsUsingBlock:^(NSString *name, NSValue *frameValue, __unused BOOL *stop) {
            UIView *view = children[name].view;
            view.transform = CGAffineTransformIdentity;
            view.frame = frameValue.CGRectValue;
            view.hidden = NO;
            view.alpha = 1.0;
            if (view.superview) [view.superview bringSubviewToFront:view];
        }];
        children[@"CCUIConnectivityCellularDataViewController"].view.hidden = YES;
        children[@"CCUIConnectivityHotspotViewController"].view.hidden = YES;
        children[@"CCUIConnectivityAirDropViewController"].view.hidden = YES;
        children[@"CCUIConnectivityBluetoothViewController"].view.hidden = YES;
    }];

    CGFloat naturalMiniCell = floor(compactMetrics.cell * 0.444);
    CGFloat naturalMiniGap = compactMetrics.cell - naturalMiniCell * 2.0;
    CGFloat requestedMiniGap = MAX(2.0, naturalMiniGap - 3.0);
    CGFloat miniCell = floor((compactMetrics.cell - requestedMiniGap) * 0.5);
    CGFloat miniGap = compactMetrics.cell - miniCell * 2.0;
    if (!miniCluster) {
        miniCluster = [[UIView alloc] initWithFrame:compactMetrics.bottomRight];
        miniCluster.tag = kERConnectivityMiniClusterTag;
        miniCluster.userInteractionEnabled = NO;
        NSArray<NSString *> *symbols = @[@"antenna.radiowaves.left.and.right", @"bluetooth", @"personalhotspot", @"network"];
        NSArray<UIColor *> *colors = @[
            [UIColor colorWithRed:0.26 green:0.66 blue:1.0 alpha:0.48],
            [UIColor colorWithRed:0.36 green:0.20 blue:1.0 alpha:1.0],
            [UIColor.whiteColor colorWithAlphaComponent:0.30],
            [UIColor.whiteColor colorWithAlphaComponent:0.30]
        ];
        for (NSUInteger index = 0; index < 4; index++) {
            CGFloat x = (index % 2) * (miniCell + miniGap), y = (index / 2) * (miniCell + miniGap);
            UIView *tile = [[UIView alloc] initWithFrame:CGRectMake(x, y, miniCell, miniCell)];
            tile.backgroundColor = [colors[index] colorWithAlphaComponent:index == 1 ? 0.85 : 0.18];
            tile.layer.cornerRadius = miniCell * 0.5;
            UIImageSymbolConfiguration *configuration = [UIImageSymbolConfiguration configurationWithPointSize:9.0 weight:UIImageSymbolWeightSemibold];
            UIImageView *icon = [[UIImageView alloc] initWithImage:[UIImage systemImageNamed:symbols[index] withConfiguration:configuration]];
            icon.frame = tile.bounds; icon.contentMode = UIViewContentModeCenter; icon.tintColor = colors[index];
            [tile addSubview:icon];
            if (index == 1) tile.hidden = YES;
            [miniCluster addSubview:tile];
        }
        [root addSubview:miniCluster];
    }
    miniCluster.hidden = NO;
    miniCluster.frame = compactMetrics.bottomRight;
    [miniCluster.subviews enumerateObjectsUsingBlock:^(UIView *tile, NSUInteger index, __unused BOOL *stop) {
        CGFloat x = (index % 2) * (miniCell + miniGap), y = (index / 2) * (miniCell + miniGap);
        tile.frame = CGRectMake(x, y, miniCell, miniCell);
        tile.layer.cornerRadius = miniCell * 0.5;
        tile.subviews.firstObject.frame = tile.bounds;
    }];
    UIButton *airDropProxy = ERConnectivitySnapshotProxy(root, kERConnectivityCompactAirDropTag, compactMetrics.topRight,
                                                          children[@"CCUIConnectivityAirDropViewController"]);
    CGRect bluetoothFrame = CGRectMake(CGRectGetMinX(compactMetrics.bottomRight) + miniCell + miniGap,
                                       CGRectGetMinY(compactMetrics.bottomRight), miniCell, miniCell);
    UIButton *bluetoothProxy = ERConnectivitySnapshotProxy(root, kERConnectivityCompactBluetoothTag, bluetoothFrame,
                                                            children[@"CCUIConnectivityBluetoothViewController"]);
    if (![objc_getAssociatedObject(controller, kERConnectivityProxyRefreshScheduledKey) boolValue]) {
        objc_setAssociatedObject(controller, kERConnectivityProxyRefreshScheduledKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        __weak UIViewController *weakController = controller;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.55 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIViewController *strongController = weakController;
            if (!strongController) return;
            ERConfigureConnectivityLayout(strongController);
        });
    }
    if (!expand) {
        expand = [UIButton buttonWithType:UIButtonTypeCustom];
        expand.tag = kERConnectivityExpandButtonTag;
        expand.accessibilityLabel = @"更多连接控制项";
        expand.accessibilityHint = @"打开全部连接控制项";
        expand.isAccessibilityElement = YES;
        [expand addTarget:[EchoRebornCoordinator shared] action:@selector(expandConnectivityFromMiniCluster:) forControlEvents:UIControlEventTouchUpInside];
        [root addSubview:expand];
    }
    expand.hidden = gEditModeActive;
    expand.userInteractionEnabled = !gEditModeActive;
    expand.frame = CGRectInset(compactMetrics.bottomRight, -compactMetrics.gap * 0.5, -compactMetrics.gap * 0.5);
    [root bringSubviewToFront:miniCluster];
    [root bringSubviewToFront:airDropProxy];
    [root bringSubviewToFront:bluetoothProxy];
    [root bringSubviewToFront:expand];
}

static CGRect ERExpandedConnectivityFrameForClass(NSString *className, CGSize containerSize) {
    ERConnectivityExpandedMetrics metrics = ERConnectivityMetricsForWidth(containerSize.width);
    CGFloat contentWidth = containerSize.width - metrics.inset * 2.0;
    CGFloat rightX = metrics.inset + metrics.square + metrics.gap;
    CGFloat firstSquareY = metrics.inset + metrics.barHeight + metrics.gap;
    CGFloat secondSquareY = firstSquareY + metrics.square + metrics.gap;
    CGFloat hotspotY = secondSquareY + metrics.square + metrics.gap;
    if ([className isEqualToString:@"CCUIConnectivityAirplaneViewController"]) return CGRectMake(metrics.inset, metrics.inset, contentWidth, metrics.barHeight);
    if ([className isEqualToString:@"CCUIConnectivityWifiViewController"]) return CGRectMake(metrics.inset, firstSquareY, metrics.square, metrics.square);
    if ([className isEqualToString:@"CCUIConnectivityAirDropViewController"]) return CGRectMake(rightX, firstSquareY, metrics.square, metrics.square);
    if ([className isEqualToString:@"CCUIConnectivityCellularDataViewController"]) return CGRectMake(metrics.inset, secondSquareY, metrics.square, metrics.square);
    if ([className isEqualToString:@"CCUIConnectivityBluetoothViewController"]) return CGRectMake(rightX, secondSquareY, metrics.square, metrics.square);
    if ([className isEqualToString:@"CCUIConnectivityHotspotViewController"]) return CGRectMake(metrics.inset, hotspotY, contentWidth, metrics.barHeight);
    return CGRectNull;
}

static void ERConfigureExpandedConnectivityChild(UIViewController *child) {
    if (!gEnabled || !gERExpandedModuleOpen || !child.view) return;
    UIViewController *parent = child.parentViewController;
    if (![NSStringFromClass(parent.class) isEqualToString:@"CCUIConnectivityModuleViewController"] || CGRectGetWidth(parent.view.bounds) < 250.0) return;
    CGRect frame = ERExpandedConnectivityFrameForClass(NSStringFromClass(child.class), parent.view.bounds.size);
    if (CGRectIsNull(frame)) return;
    [UIView performWithoutAnimation:^{
        if (!CGRectEqualToRect(child.view.frame, frame)) child.view.frame = frame;
        NSArray<NSString *> *order = @[
            @"CCUIConnectivityAirplaneViewController", @"CCUIConnectivityWifiViewController",
            @"CCUIConnectivityAirDropViewController", @"CCUIConnectivityCellularDataViewController",
            @"CCUIConnectivityBluetoothViewController", @"CCUIConnectivityHotspotViewController"
        ];
        NSUInteger index = [order indexOfObject:NSStringFromClass(child.class)];
        UIView *card = index == NSNotFound ? nil : [parent.view viewWithTag:kERConnectivityExpandedCardBaseTag + (NSInteger)index];
        ERStyleExpandedConnectivityChild(child, card, frame);
    }];
}

%hook MRUNowPlayingView

- (void)layoutSubviews {
    %orig;
    ERConfigureNowPlayingLayout((UIView *)(id)self);
}

%end

// Per-class media layout (structure ported from CC26). Each private view
// re-lays its own children after its parent, so geometry must be reasserted
// at every level; translatesAutoresizingMaskIntoConstraints = YES keeps the
// frames from being reclaimed by autolayout.

%hook MRUNowPlayingHeaderView

- (void)layoutSubviews {
    %orig;
    UIView *view = (UIView *)(id)self;
    NSString *mode = ERActiveMediaMode(view);
    if (!mode) return;
    // The header is kept full-bleed by ERConfigureNowPlayingLayout, so these
    // child frames are tile coordinates. Artwork is NOT in the header on this
    // iOS — it's a sibling handled at the now-playing-view level.
    UIView *routing = ERIvarView(self, "_routingButton");
    UIView *label = ERIvarView(self, "_labelView");
    UIView *headerTransport = ERIvarView(self, "_transportButton");
    if (!routing && !label) return;
    CGFloat W = CGRectGetWidth(view.bounds);
    [UIView performWithoutAnimation:^{
        view.clipsToBounds = NO;
        CGRect labelFrame, routingFrame;
        CGFloat routingSide;
        if ([mode isEqualToString:@"wide1"]) {
            routingSide = 38.0;
            routingFrame = CGRectMake(W - routingSide - 12.0, 14.5, routingSide, routingSide);
            labelFrame = CGRectMake(70.0, 18.0, 102.0, 31.0);
        } else if ([mode isEqualToString:@"wide2"]) {
            routingSide = 34.0;
            routingFrame = CGRectMake(W - routingSide - 12.0, 16.0, routingSide, routingSide);
            labelFrame = CGRectMake(150.0, 20.0, 104.0, 31.0);
        } else if ([mode isEqualToString:@"wide4"]) {
            routingSide = 38.0;
            routingFrame = CGRectMake((W - routingSide) / 2.0, 252.0, routingSide, routingSide);
            labelFrame = CGRectMake(128.0, 48.0, 150.0, 31.0);
        } else {
            routingSide = 40.0;
            routingFrame = CGRectMake(W - routingSide - 11.0, 14.0, routingSide, routingSide);
            labelFrame = CGRectMake(11.0, 62.0, W - 22.0, 34.0);
        }
        // The header's inline play/pause button overlaps our routing spot in
        // some native states; the transport strip owns playback controls.
        if (headerTransport) {
            headerTransport.hidden = YES;
            headerTransport.alpha = 0.0;
        }
        if (routing) {
            routing.translatesAutoresizingMaskIntoConstraints = YES;
            routing.frame = routingFrame;
            routing.alpha = 1.0;
            routing.hidden = NO;
            routing.backgroundColor = [UIColor colorWithWhite:0.8 alpha:0.25];
            routing.layer.cornerRadius = routingSide / 2.0;
            routing.layer.masksToBounds = YES;
            // Solid white output glyph. The shrink happens in the
            // MRUTransportButton layout hook (marked below) because the button
            // re-lays its image view after this header pass.
            routing.tintColor = UIColor.whiteColor;
            objc_setAssociatedObject(routing, kERMediaRouteGlyphShrinkKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            for (UIView *routingChild in routing.subviews) {
                if (![routingChild isKindOfClass:[UIImageView class]]) continue;
                UIImageView *glyph = (UIImageView *)routingChild;
                if (glyph.image && glyph.image.renderingMode != UIImageRenderingModeAlwaysTemplate) {
                    glyph.image = [glyph.image imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];
                }
                glyph.tintColor = UIColor.whiteColor;
            }
        }
        if (label) {
            label.translatesAutoresizingMaskIntoConstraints = YES;
            label.frame = labelFrame;
            label.alpha = 1.0;
            label.layer.opacity = 1.0;
            label.clipsToBounds = YES;
            ERForceMediaSubviewAlphas(label);
        }
    }];
}

%end

%hook MRUNowPlayingLabelView

- (void)setAlpha:(CGFloat)alpha {
    if (ERActiveMediaMode((UIView *)(id)self)) {
        %orig(1.0);
        ((UIView *)(id)self).layer.opacity = 1.0;
        ERForceMediaSubviewAlphas((UIView *)(id)self);
        return;
    }
    %orig;
}

- (void)layoutSubviews {
    %orig;
    UIView *view = (UIView *)(id)self;
    NSString *mode = ERActiveMediaMode(view);
    if (!mode) return;
    UIView *titleView = ERIvarView(self, "_titleMarqueeView") ?: ERIvarView(self, "_titleLabel");
    UIView *subtitleView = ERIvarView(self, "_subtitleMarqueeView") ?: ERIvarView(self, "_subtitleLabel");
    UIView *placeholderView = ERIvarView(self, "_placeholderMarqueeView");
    UIView *routeLabel = ERIvarView(self, "_routeLabel");
    if (routeLabel) routeLabel.hidden = YES;
    if (placeholderView && !placeholderView.hidden) {
        // "Not Playing" placeholder: center it in the label view's bounds.
        [UIView performWithoutAnimation:^{
            placeholderView.translatesAutoresizingMaskIntoConstraints = YES;
            placeholderView.frame = CGRectMake(0.0, (CGRectGetHeight(view.bounds) - 18.0) / 2.0, CGRectGetWidth(view.bounds), 18.0);
            placeholderView.layer.opacity = 1.0;
            ERAdjustMediaLabelFonts(placeholderView, YES);
        }];
    }
    if (!titleView || !subtitleView) return;
    [UIView performWithoutAnimation:^{
        CGFloat W = CGRectGetWidth(view.bounds);
        CGFloat titleHeight = 16.0;
        CGFloat subtitleHeight = 14.0;
        CGFloat lineSpacing = 1.0;
        titleView.translatesAutoresizingMaskIntoConstraints = YES;
        subtitleView.translatesAutoresizingMaskIntoConstraints = YES;
        titleView.clipsToBounds = YES;
        subtitleView.clipsToBounds = YES;
        view.layer.opacity = 1.0;
        titleView.layer.opacity = 1.0;
        subtitleView.layer.opacity = 1.0;
        ERForceMediaSubviewAlphas(titleView);
        ERForceMediaSubviewAlphas(subtitleView);
        CGFloat totalHeight = titleHeight + lineSpacing + subtitleHeight;
        CGFloat startY = MAX(0.0, (CGRectGetHeight(view.bounds) - totalHeight) / 2.0);
        titleView.frame = CGRectMake(0.0, startY, W, titleHeight);
        subtitleView.frame = CGRectMake(0.0, startY + titleHeight + lineSpacing, W, subtitleHeight);
        ERAdjustMediaLabelFonts(titleView, YES);
        ERAdjustMediaLabelFonts(subtitleView, NO);
    }];
    // The system re-dims these asynchronously after layout; force once more.
    dispatch_async(dispatch_get_main_queue(), ^{
        if (!ERActiveMediaMode(view)) return;
        view.layer.opacity = 1.0;
        for (UIView *subview in view.subviews) {
            if (subview.hidden) continue;
            subview.layer.opacity = 1.0;
            for (UIView *inner in subview.subviews) inner.layer.opacity = 1.0;
        }
    });
}

%end

%hook MPUMarqueeView

- (void)setAlpha:(CGFloat)alpha {
    UIView *view = (UIView *)(id)self;
    if (ERMediaAncestorOfClass(view, @"MRUNowPlayingLabelView") && ERActiveMediaMode(view)) {
        %orig(1.0);
        view.layer.opacity = 1.0;
        ERForceMediaSubviewAlphas(view);
        return;
    }
    %orig;
}

%end

%hook MRUTransportButton

- (void)layoutSubviews {
    %orig;
    if (![objc_getAssociatedObject(self, kERMediaRouteGlyphShrinkKey) boolValue]) return;
    UIView *view = (UIView *)(id)self;
    if (!ERActiveMediaMode(view)) return;
    // EchoReborn's circled routing button: pull the glyph in so it doesn't crowd
    // the circle. Runs after the button's own image layout, so it sticks.
    [UIView performWithoutAnimation:^{
        for (UIView *child in view.subviews) {
            if (![child isKindOfClass:[UIImageView class]]) continue;
            UIImageView *glyph = (UIImageView *)child;
            if (glyph.hidden || !glyph.image) continue;
            glyph.contentMode = UIViewContentModeScaleAspectFit;
            glyph.frame = CGRectInset(view.bounds, 6.5, 6.5);
        }
    }];
}

%end

%hook MRUNowPlayingTransportControlsView

- (void)layoutSubviews {
    %orig;
    UIView *view = (UIView *)(id)self;
    NSString *mode = ERActiveMediaMode(view);
    if (!mode) return;
    UIView *leftButton = ERIvarView(self, "_leftButton");
    UIView *centerButton = ERIvarView(self, "_centerButton");
    UIView *rightButton = ERIvarView(self, "_rightButton");
    UIView *leadingButton = ERIvarView(self, "_leadingButton");
    UIView *stripRouting = ERIvarView(self, "_routingButton");
    if (!leftButton || !centerButton || !rightButton) return;
    CGFloat W = CGRectGetWidth(view.bounds);
    CGFloat centerY = CGRectGetHeight(view.bounds) / 2.0;
    [UIView performWithoutAnimation:^{
        // The header's routing button is the one EchoReborn styles and places;
        // the transport strip's trailing duplicate stays hidden. Same for the
        // leading (TV remote style) button.
        if (stripRouting) { stripRouting.hidden = YES; stripRouting.alpha = 0.0; }
        if (leadingButton) { leadingButton.hidden = YES; leadingButton.alpha = 0.0; }
        // The 4x1 strip only fits play + skip-forward (reference design);
        // every other mode centers the full three-button cluster.
        BOOL strip = [mode isEqualToString:@"wide1"];
        leftButton.hidden = strip;
        leftButton.alpha = strip ? 0.0 : 1.0;
        if (strip) {
            centerButton.center = CGPointMake(W * 0.22, centerY);
            rightButton.center = CGPointMake(W * 0.78, centerY);
        } else {
            CGFloat spacing = [mode isEqualToString:@"compact"] ? W * 0.32 : W * 0.28;
            centerButton.center = CGPointMake(W / 2.0, centerY);
            leftButton.center = CGPointMake(W / 2.0 - spacing, centerY);
            rightButton.center = CGPointMake(W / 2.0 + spacing, centerY);
        }
    }];
}

%end

%hook CCUIConnectivityModuleViewController

- (double)preferredExpandedContentHeight {
    if (!gEnabled) return %orig;
    CGFloat width = CGRectGetWidth(((UIViewController *)(id)self).view.bounds);
    SEL widthSelector = NSSelectorFromString(@"preferredExpandedContentWidth");
    if (width < 250.0 && [(id)self respondsToSelector:widthSelector]) width = ((double (*)(id, SEL))objc_msgSend)((id)self, widthSelector);
    if (width < 250.0) width = CGRectGetWidth(UIScreen.mainScreen.bounds) * 0.856;
    return ERConnectivityMetricsForWidth(width).contentHeight;
}

- (void)viewDidLayoutSubviews {
    %orig;
    UIViewController *controller = (UIViewController *)(id)self;
    ERConfigureConnectivityLayout(controller);
    // Several of the child connectivity controllers finish their own layout
    // after the parent callback. Coalesce one next-turn correction so their
    // stock frames cannot overwrite the compact cluster.
    static const void *kERConnectivityDeferredLayoutKey = &kERConnectivityDeferredLayoutKey;
    BOOL compact = CGRectGetWidth(controller.view.bounds) < 190.0 && CGRectGetHeight(controller.view.bounds) < 190.0 && !gERExpandedModuleOpen;
    if (compact && ![objc_getAssociatedObject(controller, kERConnectivityDeferredLayoutKey) boolValue]) {
        objc_setAssociatedObject(controller, kERConnectivityDeferredLayoutKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        __weak UIViewController *weakController = controller;
        dispatch_async(dispatch_get_main_queue(), ^{
            UIViewController *strongController = weakController;
            if (!strongController) return;
            objc_setAssociatedObject(strongController, kERConnectivityDeferredLayoutKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            ERConfigureConnectivityLayout(strongController);
        });
    }
}

%end

%hook CCUIContentModuleContainerViewController

- (BOOL)clickPresentationInteractionShouldBegin:(id)interaction {
    if (gEnabled && (gEditModeActive || gEREditTransitionActive)) return NO;
    // 0.5.6.2：快捷指令槽位磁贴没有长按展开行为。这里挡掉长按呈现，一方面它不该有反应，
    // 另一方面它会向本插件那个朴素的内容控制器查 preferredExpandedContentHeight ——
    // 真实 0.5.6.24 上那条路径会让 SpringBoard 崩溃。
    {
        NSString *slotIdentifier = ERModuleIdentifier((UIViewController *)(id)self);
        if (gEnabled && ERShortcutIdentifierIsShortcut(slotIdentifier) &&
            ERShortcutSlotIndexFromIdentifier(slotIdentifier)) return NO;
    }
    ERApplyExpansionPageGeometrySync(gOverlayControllers.allObjects.firstObject);
    return %orig;
}

- (id)clickPresentationInteraction:(id)interaction previewForHighlightingAtLocation:(CGPoint)location {
    if (gEnabled && (gEditModeActive || gEREditTransitionActive)) {
        ERDiscardExpansionCompactTransitionAssets();
        return nil;
    }
    ERApplyExpansionPageGeometrySync(gOverlayControllers.allObjects.firstObject);
    ERResetGenericExpansionDismissal();
    UIView *sourceView = ((UIViewController *)(id)self).view;
    NSString *sourceIdentifier = ERModuleIdentifier((UIViewController *)(id)self);
    if (ERExpansionIdentifierUsesLiveTransition(sourceIdentifier) ||
        ERViewTreeContainsLiveExpansionContent(sourceView)) {
        ERDiscardExpansionCompactTransitionAssets();
        return %orig;
    }
    UIView *sourceSuperview = sourceView.superview;
    [sourceView layoutIfNeeded];
    ERDiscardExpansionCompactTransitionAssets();
    UIWindow *sourceWindow = sourceView.window;
    gERExpansionTransitionWindow = sourceWindow;
    gERExpansionCompactDestinationWindowFrame = sourceWindow
        ? [sourceView convertRect:sourceView.bounds toView:sourceWindow]
        : CGRectZero;
    UIView *sourceMaterial = ERFirstModuleMaterialSurface(sourceView);
    gERExpansionCompactMaterialTemplate = ERNewConnectivityMaterialView(sourceView);
    BOOL materialHidden = sourceMaterial.hidden;
    CGFloat materialAlpha = sourceMaterial.alpha;
    float materialLayerOpacity = sourceMaterial.layer.opacity;
    [UIView performWithoutAnimation:^{
        sourceMaterial.hidden = YES;
        sourceMaterial.alpha = 0.0;
        sourceMaterial.layer.opacity = 0.0;
    }];
    UIView *foregroundSnapshot = ERCompositedSnapshotView(sourceView);
    if ([foregroundSnapshot isKindOfClass:[UIImageView class]]) {
        gERExpansionCompactForegroundImage = ((UIImageView *)foregroundSnapshot).image;
    }
    [UIView performWithoutAnimation:^{
        sourceMaterial.hidden = materialHidden;
        sourceMaterial.alpha = materialAlpha;
        sourceMaterial.layer.opacity = materialLayerOpacity;
    }];
    UIView *snapshot = sourceSuperview ? ERWindowCropSnapshotView(sourceView) : nil;
    if (!snapshot && sourceSuperview) snapshot = ERCompositedSnapshotView(sourceView);
    if (snapshot) {
        ERDiscardExpansionSourceSnapshot();
        ERDiscardExpansionDismissalSnapshot();
        snapshot.frame = sourceView.frame;
        snapshot.userInteractionEnabled = NO;
        UIView *material = ERFirstModuleMaterialSurface(sourceView);
        CGFloat compactRadius = sourceView.layer.cornerRadius;
        if (compactRadius <= 1.0) compactRadius = material.layer.cornerRadius;
        if (compactRadius <= 1.0) compactRadius = 32.0;
        snapshot.layer.cornerRadius = compactRadius;
        snapshot.layer.cornerCurve = kCACornerCurveContinuous;
        snapshot.layer.masksToBounds = YES;
        [sourceSuperview insertSubview:snapshot aboveSubview:sourceView];
        gERExpansionSourceSnapshot = snapshot;
        if ([snapshot isKindOfClass:[UIImageView class]]) {
            gERExpansionCompactImage = ((UIImageView *)snapshot).image;
        }
        gERExpansionCompactCornerRadius = snapshot.layer.cornerRadius;
    }
    UITargetedPreview *nativePreview = %orig;
    if (!snapshot || !nativePreview) return nativePreview;
    return [[UITargetedPreview alloc] initWithView:snapshot
                                        parameters:nativePreview.parameters
                                            target:nativePreview.target];
}

- (void)clickPresentationInteractionEnded:(id)interaction wasCancelled:(BOOL)cancelled {
    %orig;
    if (cancelled) ERDiscardExpansionSourceSnapshot();
}

- (UIViewController *)presentedViewControllerForContentModuleDetailClickPresentationInteractionController:(id)interactionController {
    if (gEnabled && (gEditModeActive || gEREditTransitionActive)) return nil;
    NSString *identifier = ERModuleIdentifier((UIViewController *)(id)self);
    if (gEnabled && ERConnectivityIdentifierHasNativeExpandedMenu(identifier)) {
        UIViewController *detail = ERConnectivityDetailViewControllerForIdentifier(identifier, interactionController);
        if (detail) return detail;
    }
    return %orig;
}

- (double)preferredExpandedContentHeight {
    UIViewController *controller = (UIViewController *)(id)self;
    UIViewController *connectivity = ERConnectivityChild(controller, @"CCUIConnectivityModuleViewController");
    if (!gEnabled || !connectivity) return %orig;
    CGFloat width = CGRectGetWidth(connectivity.view.bounds);
    SEL widthSelector = NSSelectorFromString(@"preferredExpandedContentWidth");
    if (width < 250.0 && [(id)connectivity respondsToSelector:widthSelector]) width = ((double (*)(id, SEL))objc_msgSend)((id)connectivity, widthSelector);
    if (width < 250.0) width = CGRectGetWidth(UIScreen.mainScreen.bounds) * 0.856;
    return ERConnectivityMetricsForWidth(width).contentHeight;
}

%end

%hook CCUILabeledRoundButton

- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    UIView *view = (UIView *)(id)self;
    if (gEnabled && gERExpandedModuleOpen && objc_getAssociatedObject(view, kERConnectivityExpandedCardKey) &&
        !view.hidden && view.alpha > 0.01 && CGRectContainsPoint(view.bounds, point)) {
        SEL selector = NSSelectorFromString(@"buttonView");
        UIView *button = [view respondsToSelector:selector] ? ((id (*)(id, SEL))objc_msgSend)(view, selector) : nil;
        if (button) return button;
    }
    return %orig;
}

- (void)layoutSubviews {
    %orig;
    UIResponder *responder = ((UIView *)(id)self).nextResponder;
    while (responder && ![responder isKindOfClass:[UIViewController class]]) responder = responder.nextResponder;
    if ([responder isKindOfClass:[UIViewController class]]) ERConfigureExpandedConnectivityChild((UIViewController *)responder);
}

%end

%hook CCUIRoundButton

- (void)layoutSubviews {
    %orig;
    UIView *button = (UIView *)(id)self;
    if (!gEnabled || !gERExpandedModuleOpen ||
        ![objc_getAssociatedObject(button, kERConnectivityExpandedGridGlyphKey) boolValue]) return;
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    for (UIView *glyph in ERCompactGlyphHosts(button)) glyph.transform = CGAffineTransformMakeScale(0.86, 0.86);
    [CATransaction commit];
}

- (void)setHighlighted:(BOOL)highlighted {
    %orig;
    UIView *button = (UIView *)(id)self;
    UIView *card = objc_getAssociatedObject(button, kERConnectivityExpandedCardKey);
    UIView *surface = objc_getAssociatedObject(button, kERConnectivityExpandedSurfaceKey);
    if (!gEnabled || !gERExpandedModuleOpen || !card || !surface) return;
    [UIView animateWithDuration:highlighted ? 0.12 : 0.28
                          delay:0.0
         usingSpringWithDamping:highlighted ? 1.0 : 0.72
          initialSpringVelocity:0.0
                        options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction
                     animations:^{
        surface.transform = highlighted ? CGAffineTransformMakeScale(0.985, 0.985) : CGAffineTransformIdentity;
        card.alpha = highlighted ? 0.82 : 1.0;
    } completion:nil];
}

%end

%hook AXCCIconImageView

- (void)layoutSubviews {
    %orig;
    if (!gEnabled) return;
    UIView *view = (UIView *)(id)self;
    UIViewController *module = ERModuleControllerForView(view);
    NSString *identifier = ERModuleIdentifier(module);
    if (![identifier isEqualToString:@"com.apple.accessibility.controlcenter.text.size"]) return;
    NSArray<NSNumber *> *customSize = gERCustomSizes[identifier];
    if (customSize.count < 2 || (customSize[0].unsignedIntegerValue <= 1 && customSize[1].unsignedIntegerValue <= 1)) return;
    [UIView performWithoutAnimation:^{
        [CATransaction begin];
        [CATransaction setDisableActions:YES];
        view.layer.transform = CATransform3DIdentity;
        view.frame = CGRectMake(0.0, 0.0, kERGridCellSize, kERGridCellSize);
        if ([view isKindOfClass:[UIImageView class]]) ((UIImageView *)view).contentMode = UIViewContentModeCenter;
        [CATransaction commit];
    }];
}

%end

%hook UIActivityIndicatorView

- (void)layoutSubviews {
    %orig;
    if (!gEnabled) return;
    UIView *view = (UIView *)(id)self;
    UIViewController *module = ERModuleControllerForView(view);
    NSString *identifier = ERModuleIdentifier(module);
    if (![identifier isEqualToString:@"com.mtac.ccpowermenu"]) return;
    NSArray<NSNumber *> *customSize = gERCustomSizes[identifier];
    if (customSize.count < 2 || (customSize[0].unsignedIntegerValue <= 1 && customSize[1].unsignedIntegerValue <= 1)) return;
    view.hidden = YES;
    view.alpha = 0.0;
}

%end

%hook CCUIBaseSliderView

- (void)setValue:(float)value {
    %orig;
    ERLogSliderProbe((UIView *)(id)self, @"base.setValue");
    if (gEnabled) ERUpdateSliderGlyphColor((UIView *)(id)self, value, YES);
}

- (void)layoutSubviews {
    %orig;
    if (!gEnabled) return;
    float value = ((float (*)(id, SEL))objc_msgSend)((id)self, @selector(value));
    ERSliderReadoutTick((UIView *)(id)self, value);
    ERUpdateSliderGlyphColor((UIView *)(id)self, value, NO);
}

- (void)_setActiveGlyphView:(id)view {
    %orig;
    if (!gEnabled) return;
    float value = ((float (*)(id, SEL))objc_msgSend)((id)self, @selector(value));
    ERUpdateSliderGlyphColor((UIView *)(id)self, value, NO);
}

- (void)_applyGlyphState:(id)state performConfiguration:(BOOL)configuration {
    %orig;
    if (!gEnabled) return;
    float value = ((float (*)(id, SEL))objc_msgSend)((id)self, @selector(value));
    ERUpdateSliderGlyphColor((UIView *)(id)self, value, NO);
}

- (void)setGlyphVisible:(BOOL)visible {
    %orig;
    if (!gEnabled) return;
    float value = ((float (*)(id, SEL))objc_msgSend)((id)self, @selector(value));
    ERUpdateSliderGlyphColor((UIView *)(id)self, value, NO);
}

%end

%hook CCUIContinuousSliderView

- (void)_handleValueChangeGestureRecognizer:(UIPanGestureRecognizer *)gesture {
    %orig;
    ERUpdateSliderOverscroll((UIView *)(id)self, gesture);
    UIGestureRecognizerState state = gesture.state;
    if (state == UIGestureRecognizerStateEnded ||
        state == UIGestureRecognizerStateCancelled ||
        state == UIGestureRecognizerStateFailed) {
        // One last read so the settled value is on screen, then stop the
        // per-frame poller — a display link must not outlive the drag.
        ERRefreshSliderReadoutLive((UIView *)(id)self);
        ERSliderReadoutEnd((UIView *)(id)self);
        return;
    }
    ERLogSliderProbe((UIView *)(id)self, @"continuous.gesture");
    if (state == UIGestureRecognizerStateBegan) ERSliderReadoutBegin((UIView *)(id)self);
    // Advance the gesture-derived level; the display link paints it once per
    // frame. Do NOT also push the system's `value` here — it lags behind the
    // finger between milestones and would overwrite the smooth reading.
    ERSliderReadoutTrackGesture((UIView *)(id)self, gesture);
}

// The system can also drive a continuous slider through its pan recogniser's
// own target method when the gesture is replayed, and through the value
// setter on programmatic changes. Probe all of them so the log shows which one
// carries per-sample updates on the user's iOS build.
- (void)setValue:(float)value {
    %orig;
    ERLogSliderProbe((UIView *)(id)self, @"continuous.setValue");
    if (gEnabled) ERUpdateSliderGlyphColor((UIView *)(id)self, value, NO);
    // A value pushed while a drag is live is the finger's own gesture
    // callback (the setter is the only common code path both the coarse
    // A value pushed while no drag is live is a programmatic change (the
    // volume HUD, Control Center restoring a level, accessibility): paint it
    // directly. During a drag the display link owns the readout, so writing
    // the lagging system value here would undo the smooth tracking.
    if (gEnabled && !gEditModeActive) {
        ERSliderReadoutTick((UIView *)(id)self, value);
        if (!gERSliderReadoutTracking) ERRefreshSliderReadoutLive((UIView *)(id)self);
    }
}

%end

%hook CCUISteppedSliderView

- (void)setValue:(float)value {
    %orig;
    ERLogSliderProbe((UIView *)(id)self, @"stepped.setValue");
    if (gEnabled) ERUpdateSliderGlyphColor((UIView *)(id)self, value, NO);
}

%end

// ---------------------------------------------------------------------------
// MediaControls sliders — the brightness/volume pair on iOS 17.
//
// These are MRU* classes from the private MediaControls framework, NOT
// CCUIBaseSliderView subclasses, which is why the CCUI hooks above never fired
// for the brightness slider (four releases' worth of "the readout does not
// update" trace back to exactly this).
//
// They are hooked BY NAME here, with plain Logos. That is the point: Logos
// resolves each class once at load and captures the original implementation
// itself, so there is no class_getSuperclass walk, no class_copyMethodList, and
// no runtime function for another tweak to interpose. The two previous builds
// tried to reach these classes by enumerating the runtime from -layoutSubviews
// and crashed SpringBoard; naming them statically is both simpler and safe.
//
// If MediaControls is not loaded yet the hook group simply does not apply — it
// costs nothing and cannot fail. Only -setValue: is hooked, deliberately:
//   * it is the path the system drives as the finger moves, so it is the one
//     that actually produces the readout, and
//   * it is NOT a layout method. -layoutSubviews runs during SpringBoard's
//     first layout of every slider at boot; keeping our code off that path is
//     precisely what the two previous crashing builds got wrong.
// ---------------------------------------------------------------------------
%hook MRUContinuousSliderView

- (void)setValue:(float)value {
    %orig;
    if (!gEnabled || gEditModeActive) return;
    ERSliderReadoutTick((UIView *)(id)self, value);
    if (!gERSliderReadoutTracking) ERRefreshSliderReadoutLive((UIView *)(id)self);
}

%end

%hook MRUVolumeSliderView

- (void)setValue:(float)value {
    %orig;
    if (!gEnabled || gEditModeActive) return;
    ERSliderReadoutTick((UIView *)(id)self, value);
    if (!gERSliderReadoutTracking) ERRefreshSliderReadoutLive((UIView *)(id)self);
}

%end

%hook CCUICAPackageView

- (void)layoutSubviews {
    %orig;
    UIView *packageView = (UIView *)(id)self;
    UIView *buttonView = packageView;
    while (buttonView && ![NSStringFromClass(buttonView.class) isEqualToString:@"CCUIButtonModuleView"]) buttonView = buttonView.superview;
    // The glyph is invariant while the resize border follows the finger. Do
    // not let package layout reposition nested artwork during the preview.
    BOOL keepsLeadingAnchor = [buttonView viewWithTag:kERResizePresentationTag] || [objc_getAssociatedObject(buttonView, kERResizePreviewKey) boolValue];
    if (!buttonView || !keepsLeadingAnchor) return;
    if (CGRectGetWidth(packageView.bounds) <= 80.0 && CGRectGetHeight(packageView.bounds) <= 80.0 && packageView.superview) {
        [UIView performWithoutAnimation:^{
            [CATransaction begin];
            [CATransaction setDisableActions:YES];
            if (gERResizeInProgress) {
                [packageView.layer removeAnimationForKey:@"position"];
                [packageView.layer removeAnimationForKey:@"bounds"];
                [packageView.layer removeAnimationForKey:@"transform"];
            }
            packageView.layer.transform = CATransform3DIdentity;
            packageView.center = [buttonView convertPoint:CGPointMake(kERGridCellSize * 0.5, kERGridCellSize * 0.5) toView:packageView.superview];
            if (gERResizeInProgress) {
                [packageView.layer removeAnimationForKey:@"position"];
                [packageView.layer removeAnimationForKey:@"bounds"];
                [packageView.layer removeAnimationForKey:@"transform"];
            }
            [CATransaction commit];
        }];
    }
    for (UIView *content in packageView.subviews) {
        if (CGRectGetWidth(content.bounds) <= 60.0 && CGRectGetHeight(content.bounds) <= 60.0) {
            // Pin by visual center rather than intrinsic artwork size. Shortcut
            // modules such as Calculator use a smaller, nested package glyph;
            // a fixed origin therefore did not line up with Timer/toggles.
            [UIView performWithoutAnimation:^{
                [CATransaction begin];
                [CATransaction setDisableActions:YES];
                if (gERResizeInProgress) {
                    // UIKit lays out the package again during the native size
                    // transition. Remove only geometric interpolation so the
                    // package's own symbol/state animation remains available.
                    [content.layer removeAnimationForKey:@"position"];
                    [content.layer removeAnimationForKey:@"bounds"];
                    [content.layer removeAnimationForKey:@"transform"];
                }
                content.layer.transform = CATransform3DIdentity;
                content.center = [buttonView convertPoint:CGPointMake(kERGridCellSize * 0.5, kERGridCellSize * 0.5) toView:packageView];
                if (gERResizeInProgress) {
                    [content.layer removeAnimationForKey:@"position"];
                    [content.layer removeAnimationForKey:@"bounds"];
                    [content.layer removeAnimationForKey:@"transform"];
                }
                [CATransaction commit];
            }];
        }
    }
}

%end

// 模块单击震动的观察型 tap 识别器安装器（0.5.8）。
//
// 用它取代 0.5.7 的「%new -erModuleButtonTapped:」实现，原因有三：
//
//   1. 0.5.7 从未给识别器设置 delegate。delegate 为 nil 时 UIKit 不会来问
//      -gestureRecognizer:shouldRecognizeSimultaneouslyWithGestureRecognizer:，
//      那条「放行同时识别」的分支永远是死代码，于是本识别器被模块自己已有的
//      tap/长按按默认规则（canBePreventedBy = YES）prevent，一次都不触发——
//      实机日志里 TAPHAPTIC 为零正是这个原因。
//   2. 动作目标改成 EchoRebornCoordinator 单例。0.5.7 把目标设成 hook 自身，而
//      erModuleButtonTapped: 是 Logos 的 %new 方法：runtime 注册、编译期不可见，
//      还要求宿主恰好是 CCUIButtonModuleView。换成 coordinator 后，识别器可以装在
//      任意宿主视图上，不再依赖某个具体类名是否真的匹配到实机。
//   3. 宿主改成磁贴外框（CCUIContentModuleContainerView）。它是磁贴内容的祖先，
//      无论命中的是模块内容还是按钮 chrome，触摸都会经过它，因此一定能收到。
//
// 仍然只观察、不消费触摸（cancelsTouchesInView = NO），模块自身的开关行为不受影响。
static void ERInstallModuleTapFeedback(UIView *host) {
    if (!host) return;
    // 每个宿主只装一次。宿主会被系统复用，模块身份因此在触发时解析，而不是这里。
    if (objc_getAssociatedObject(host, kERModuleTapFeedbackKey) != nil) return;
    // 自愈：1.0.6 之前这里只把标记写在识别器上（见本函数末尾），宿主守卫因此永远
    // 不成立，被复用的宿主上会一层层堆叠识别器。实机日志中的证据是一次点击触发
    // 43 次、45 秒后同一宿主涨到 71 次。这里先按识别器标记清掉历史遗留，再装一个
    // 干净的，避免升级后旧实例把问题带过来。
    for (UIGestureRecognizer *stale in [host.gestureRecognizers copy]) {
        if (objc_getAssociatedObject(stale, kERModuleTapFeedbackKey) != nil) {
            [host removeGestureRecognizer:stale];
        }
    }
    EchoRebornCoordinator *coordinator = [EchoRebornCoordinator shared];
    if (!coordinator) return;
    UITapGestureRecognizer *tap = [[UITapGestureRecognizer alloc] initWithTarget:coordinator
                                                                         action:@selector(erModuleTapFired:)];
    tap.cancelsTouchesInView = NO;
    // 必须显式设 delegate，否则下面的放行规则不会被询问（见上文第 1 点）。
    tap.delegate = coordinator;
    // 让已有长按先失败：按压变成长按时本识别器不触发，避免「长按展开」被同时读成
    // 一次单击而多给一次震动。往下探三层——模块的长按不一定挂在宿主自己身上。
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:host];
    NSUInteger depth = 0;
    while (queue.count && depth < 3) {
        NSUInteger levelCount = queue.count;
        for (NSUInteger index = 0; index < levelCount; index++) {
            UIView *node = queue.firstObject;
            [queue removeObjectAtIndex:0];
            for (UIGestureRecognizer *gesture in node.gestureRecognizers) {
                if ([gesture isKindOfClass:[UILongPressGestureRecognizer class]]) {
                    [tap requireGestureRecognizerToFail:gesture];
                }
            }
            [queue addObjectsFromArray:node.subviews];
        }
        depth++;
    }
    // 标记必须写两份，缺一不可：
    //   · 写在**识别器**上 —— delegate 的两个放行方法（-gestureRecognizer:shouldReceiveTouch:
    //     与 -gestureRecognizer:shouldRecognizeSimultaneouslyWithGestureRecognizer:）正是
    //     按它认出「这是单击震动观察器」的，去掉它放行分支就会变成死代码，识别器
    //     一次都不会触发（0.5.7 踩过这个坑，实机日志里 TAPHAPTIC 为零）；
    //   · 写在**宿主**上 —— 本函数开头那句守卫读的是宿主。1.0.6 之前这里只写了识别器，
    //     守卫永远不成立，于是宿主每次布局都再叠加一个识别器：一次点击被识别成 71 次，
    //     每次都同步写两行日志文件（SpringBoard 主线程上的 fopen/append/fclose），
    //     142 次系统调用压在 9 毫秒里 —— 这就是「点一下卡几秒」，也是进程被看门狗
    //     干掉后「控制中心自动退出、快捷指令 App 打不开」的直接原因。
    objc_setAssociatedObject(tap, kERModuleTapFeedbackKey, @(YES), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(host, kERModuleTapFeedbackKey, @(YES), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [host addGestureRecognizer:tap];
}

%hook CCUIButtonModuleView

- (void)setSelected:(BOOL)selected {
    %orig;
    UIResponder *responder = (UIResponder *)(id)self;
    UIViewController *module = nil;
    while (responder) {
        if ([responder isKindOfClass:[UIViewController class]] && ERIsModuleController((UIViewController *)responder)) {
            module = (UIViewController *)responder;
            break;
        }
        responder = responder.nextResponder;
    }
    if (module) {
        dispatch_async(dispatch_get_main_queue(), ^{ [[EchoRebornCoordinator shared] applyResizedPresentationToModule:module]; });
    }
}

- (void)layoutSubviews {
    %orig;
    // resizePanned: applies the presentation exactly when the logical size
    // crosses a valid endpoint. Re-entering it for every intermediate layout
    // pass produces duplicate fades and visible flashing.
    UIResponder *responder = (UIResponder *)(id)self;
    UIViewController *module = nil;
    while (responder) {
        if ([responder isKindOfClass:[UIViewController class]] && ERIsModuleController((UIViewController *)responder)) {
            module = (UIViewController *)responder;
            break;
        }
        responder = responder.nextResponder;
    }
    if (module) [[EchoRebornCoordinator shared] applyResizedPresentationToModule:module];
    // 单击震动的观察型 tap 不在这里安装。0.5.8 起它的宿主改成磁贴外框
    // （CCUIContentModuleContainerView），安装点统一收在
    // -applyResizedPresentationToModule:，这样不再依赖本 hook 是否真的匹配到实机类名。
}

%end

%hook UIViewController

- (void)viewDidAppear:(BOOL)animated {
    %orig;
    if (gEnabled && ERIsOverlayController(self)) [[EchoRebornCoordinator shared] installOnOverlay:self];
}

- (void)viewDidLayoutSubviews {
    %orig;
    if (gEnabled && ERIsOverlayController(self) && gERControlCenterPresented) {
        // Provider-driven rebuilds replace the header pocket at unpredictable
        // times; the overlay always lays out afterwards, so this is the one
        // reliable spot to put the quick-access host back.
        EchoRebornCoordinator *coordinator = [EchoRebornCoordinator shared];
        [coordinator installQuickAccessHostOnOverlay:self];
        BOOL hasPageIndicators = [self.view viewWithTag:kERPageIndicatorHostTag] != nil;
        BOOL hasPager = NO;
        for (UIGestureRecognizer *gesture in self.view.gestureRecognizers) {
            if ([objc_getAssociatedObject(gesture, kERPagerGestureKey) boolValue]) {
                hasPager = YES;
                break;
            }
        }
        // installPagingOnOverlay performs a complete grid normalization and
        // presentation reconcile. Re-running it for every native presentation
        // layout pass restarts compositor work at the end of open/close.
        if (!hasPageIndicators || !hasPager) {
            [coordinator installPagingOnOverlay:self];
        }
        ERSuppressNativeOverflowMaterialForOverlay(self);
        ERSuppressHeaderPocketMaterialForOverlay(self);
        // 0.5.17 横屏顶部 chrome（状态栏 + 指示区/返回 App 胶囊）整体上移。
        // 用和模块静止态偏移相同的门槛：只在呈现动画落定后才改写 transform，
        // 否则会和 CC 自己的开合动画抢同一个属性。
        BOOL chromeSettled = (gERControlCenterPresentationState == 0 ||
                              gERControlCenterPresentationState == 2) &&
                             CACurrentMediaTime() - gERControlCenterPresentationStateChangedTime >= 0.18;
        if (chromeSettled) [coordinator applyLandscapeChromeRiseForOverlay:self];
        __weak UIViewController *weakOverlay = self;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIViewController *overlay = weakOverlay;
            if (overlay && gERControlCenterPresented) {
                ERSuppressNativeOverflowMaterialForOverlay(overlay);
                ERSuppressHeaderPocketMaterialForOverlay(overlay);
            }
        });
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.18 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIViewController *overlay = weakOverlay;
            if (overlay && gERControlCenterPresented) {
                ERSuppressNativeOverflowMaterialForOverlay(overlay);
                ERSuppressHeaderPocketMaterialForOverlay(overlay);
                [[EchoRebornCoordinator shared] applyLandscapeChromeRiseForOverlay:overlay];
            }
        });
    }
    BOOL settledControlCenterState = gERControlCenterPresentationState == 0 ||
        gERControlCenterPresentationState == 2;
    BOOL presentationLayerSettling =
        CACurrentMediaTime() - gERControlCenterPresentationStateChangedTime < 0.18;
    if (gEnabled && ERIsOverlayController(self) && !gEditModeActive &&
        ((settledControlCenterState && !presentationLayerSettling) ||
         ERInteractivePagingGeometryActive())) {
        // 0.5.13: 翻页进行中时，页面几何由 -pagePanned: /
        // -applyPageTransformToOverlay: 独占。此时再写一次静止态几何，只会与跟手
        // 位移和落位动画互相覆盖——正是「翻页时整个页面先反向偏移一下再恢复」的
        // 成因。翻页期间直接跳过；静止态偏移仅在非翻页时补写。
        if (gERPagerTransitionActive || fabs(gERPagerInteractiveTranslation) > 0.01) {
            ERLogInfo(@"[PAGER] skip resting reassert during flip page=%lu translation=%.1f",
                       (unsigned long)gERCurrentPage, gERPagerInteractiveTranslation);
        } else {
            [[EchoRebornCoordinator shared] applyRestingModuleOffsetToOverlay:self];
        }
    }
    if (ERIsModuleController(self) && !ERIsOwnedDuplicateModuleController(self)) {
        EchoRebornCoordinator *coordinator = [EchoRebornCoordinator shared];
        [coordinator applyRefinedLookToModule:self];
        if (!gERExpandedModuleOpen) [coordinator applyTransitionRadiusToModule:self];
        if (gEditModeActive) {
            [coordinator applyEditingToModule:self editing:YES];
            UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
            if (overlay) [coordinator setNativeDismissTapGesturesEnabled:NO forOverlay:overlay];
        }
    }
    // Connectivity's leaf controllers are reparented and laid out separately
    // by the stock expansion animator. Keep every live leaf suppressed while
    // our atomic pane snapshots own the transition; otherwise UIKit can expose
    // labels and glyphs outside their card backgrounds for a single frame.
    if (gEnabled && gERConnectivityTransitionWindow && gERConnectivityExpansionActive &&
        !gERConnectivitySnapshotCaptureActive && ERIsConnectivityTransitionLeafController(self)) {
        [UIView performWithoutAnimation:^{
            ERStopConnectivitySubviewAnimations(self.view, YES);
            self.view.hidden = YES;
            self.view.alpha = 0.0;
            self.view.layer.opacity = 0.0;
        }];
    }
}

- (void)viewDidDisappear:(BOOL)animated {
    %orig;
    if (ERIsOverlayController(self)) {
        if (gEditModeActive) {
            [[EchoRebornCoordinator shared] dismissEditingImmediately];
        } else if (gEnabled) {
            // Insurance: if a raced exit left edit presentation half-applied
            // (offset wrappers, borders, grids), scrub it while CC is away so
            // the next open and module expansions start from clean geometry.
            [[EchoRebornCoordinator shared] setEditPresentation:NO forOverlay:self animated:NO];
        }
    }
}

%end

%hook SBUIPowerDownViewController

- (void)powerDownViewRequestCancel:(id)view {
    %orig;
    // 1.0.3：%orig 通常已经处理了取消。补一次 dismiss 只在「还没开始收起」时才做，
    // 否则就是在收起过程中再发一次 dismiss —— UIKit 会把这次调用往上一层转发，
    // 严重时在 present/dismiss 交错里崩掉。
    if (self.presentingViewController && !self.isBeingDismissed) {
        [self dismissViewControllerAnimated:YES completion:nil];
    }
}

- (void)viewDidDisappear:(BOOL)animated {
    %orig;
    // 1.0.3：viewDidDisappear 本身常常就是「dismiss 过程」的一部分，这里再无条件
    // 发一次 dismiss 属于重入。加两个判断：不在收起中、也不是被移出父控制器，
    // 才做这次兜底。
    if (self.presentingViewController && !self.isBeingDismissed && !self.isMovingFromParentViewController) {
        [self dismissViewControllerAnimated:NO completion:nil];
    }
}

%end

%hook CCUIControlCenterPositionProvider

- (void)regenerateRectsWithOrderedIdentifiers:(NSArray *)identifiers orderedSizes:(NSArray *)sizes {
    gERProviderOrder = [identifiers copy];
    NSMutableDictionary *sizeMap = [NSMutableDictionary dictionary];
    for (NSUInteger index = 0; index < MIN(identifiers.count, sizes.count); index++) sizeMap[identifiers[index]] = sizes[index];
    gERProviderSizes = [sizeMap copy];
    %orig;
}

%end

%group ERPresentationStateCallbacks

%hook SBControlCenterController

// Two-stage exit while editing: the first home button press (or home gesture
// dismissal request on notched devices) leaves edit mode and keeps Control
// Center presented; only the next one actually dismisses. Both funnel through
// these seams, and tapping anywhere else can no longer end editing.
- (BOOL)handleHomeButtonPress {
    if (gEnabled && gERControlCenterPresented && !gERExpandedModuleOpen) {
        if (gEditModeActive) {
            ERHaptic();
            gEREditExitConsumedUntil = CACurrentMediaTime() + 0.9;
            [[EchoRebornCoordinator shared] dismissEditingImmediately];
            return YES;
        }
        if (CACurrentMediaTime() < gEREditExitConsumedUntil) return YES;
    }
    return %orig;
}

- (void)dismissAnimated:(BOOL)animated {
    if (gEnabled && gERControlCenterPresented && !gERExpandedModuleOpen) {
        if (gEditModeActive) {
            ERHaptic();
            gEREditExitConsumedUntil = CACurrentMediaTime() + 0.9;
            // Atomic, non-animated exit: the in-flight home gesture keeps
            // driving presentation callbacks that would strand an animated
            // exit halfway (stuck edit chrome, later expansion glitches).
            [[EchoRebornCoordinator shared] dismissEditingImmediately];
            return;
        }
        if (CACurrentMediaTime() < gEREditExitConsumedUntil) return;
	    }
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    if (gEnabled && overlay && !gERExpandedModuleOpen) {
        gEROwnedDuplicateHostSyncPresented = NO;
        [[EchoRebornCoordinator shared] beginOwnedDuplicateHostPresentationSync];
        [[EchoRebornCoordinator shared] animateOwnedDuplicateHostForOverlay:overlay presented:NO];
    }
    // Leaving Control Center must hand every piece of chrome back visible. The
    // status bar lives in the overlay's header pocket, which the scrubbing
    // hide/show path drives to alpha 0; if that restore is ever skipped the
    // bar stays gone on the home screen until Control Center is opened again.
    // Restoring unconditionally here is cheap and makes the failure impossible.
    if (gEnabled) {
        [[EchoRebornCoordinator shared] setHeaderChromeHiddenForScrubbing:NO overlay:overlay animated:NO];
    }
    %orig;
}

- (void)_handleStatusBarPullDownGesture:(id)gesture {
    gERSBControlCenterController = self;
    if (![gesture isKindOfClass:[UIPanGestureRecognizer class]]) {
        %orig;
        return;
    }
    // Once the touch reaches the pager, the coordinator force-finishes the
    // native reveal and owns the remaining drag. Letting SpringBoard continue
    // its interactive stretch would overwrite our scale on every callback.
    BOOL pagerOwnsGesture = gPagingEnabled && (gERPresentationNativeSettlePending || gERPresentationPageHandoffActive);
    if (!pagerOwnsGesture) %orig;
    UIViewController *overlay = nil;
    @try {
        id candidate = [(id)self valueForKey:@"viewController"];
        if ([candidate isKindOfClass:[UIViewController class]]) {
            overlay = ERFindOverlayController((UIViewController *)candidate);
        }
    } @catch (__unused NSException *exception) {}
    if (!overlay) overlay = gOverlayControllers.allObjects.firstObject;
    if (overlay && ERInteractivePagingGeometryActive()) {
        [[EchoRebornCoordinator shared] applyPageTransformToOverlay:overlay animated:NO];
    }
    if (gPagingEnabled) {
        [[EchoRebornCoordinator shared] trackControlCenterPresentationGesture:(UIPanGestureRecognizer *)gesture overlay:overlay controller:self];
    }
    [[EchoRebornCoordinator shared] beginOwnedDuplicateHostPresentationSync];
}

- (void)controlCenterViewController:(id)controller significantPresentationProgressChange:(double)progress {
    gERSBControlCenterController = self;
    %orig;
    UIViewController *overlay = [controller isKindOfClass:[UIViewController class]] ? (UIViewController *)controller : gOverlayControllers.allObjects.firstObject;
    CGFloat clamped = MIN(1.0, MAX(0.0, (CGFloat)progress));
    if (overlay && ERInteractivePagingGeometryActive()) {
        [[EchoRebornCoordinator shared] applyPageTransformToOverlay:overlay animated:NO];
    }
    // A presentation dip mid-drag is a second-finger page (or an incidental
    // native callback), not an intent to leave edit mode with a module in hand.
    if (gEnabled && gEditModeActive && !gERExpandedModuleOpen && !gERDragInProgress && clamped < 0.985) {
        ERHaptic();
        gEREditExitConsumedUntil = CACurrentMediaTime() + 1.1;
        [[EchoRebornCoordinator shared] dismissEditingImmediately];
        return;
    }
    if (gEditModeActive && !gERAddSheetPresentationActive && ![overlay.presentedViewController isKindOfClass:[ERAddControlSheetViewController class]]) {
        [[EchoRebornCoordinator shared] updateEditingChromeForPresentationProgress:clamped overlay:overlay];
    }
    [[EchoRebornCoordinator shared] updateTopFadeForOverlay:overlay presentationAlpha:clamped];
    if (clamped > 0.001 && clamped < 0.999) {
        [[EchoRebornCoordinator shared] updateOwnedDuplicateHostForOverlay:overlay presentationAlpha:clamped];
    } else {
        [[EchoRebornCoordinator shared] animateOwnedDuplicateHostForOverlay:overlay presented:clamped >= 0.999];
    }
    [[EchoRebornCoordinator shared] beginOwnedDuplicateHostPresentationSync];
    UIView *host = [overlay.view viewWithTag:181000];
    UIView *pageIndicators = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    if (gPagingEnabled && pageIndicators && !gERExpandedModuleOpen && gERPageCount > 1) {
        pageIndicators.hidden = clamped <= 0.001;
        pageIndicators.alpha = clamped;
    }
    if (!host || gERExpandedModuleOpen || gEditModeActive || !gEnabled || !gQuickAccessButtonsEnabled) return;
    // Presentation state remains nonzero throughout dismissal. Follow the
    // actual interactive progress so this chrome leaves with Control Center.
    [host.layer removeAllAnimations];
    objc_setAssociatedObject(host, kERQuickAccessAnimationTokenKey, [NSObject new], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    host.hidden = clamped <= 0.001;
    host.alpha = clamped;
    host.transform = CGAffineTransformMakeTranslation(0.0, -12.0 * (1.0 - clamped));
}

- (void)controlCenterViewController:(id)controller didChangePresentationState:(NSUInteger)state {
    gERSBControlCenterController = self;
    if (gERControlCenterPresentationState != state) {
        gERControlCenterPresentationStateChangedTime = CACurrentMediaTime();
    }
    NSUInteger chromeGeneration = ++gERPresentationChromeGeneration;
    gERControlCenterPresentationState = state;
    if (gEnabled && !gERExpandedModuleOpen) {
        if (state == 3 && gEditModeActive && !gERDragInProgress) {
            ERHaptic();
            gEREditExitConsumedUntil = CACurrentMediaTime() + 1.2;
            [[EchoRebornCoordinator shared] dismissEditingImmediately];
            gERControlCenterPresented = YES;
            return;
        }
    }
    // SpringBoard's own -[SBControlCenterController _willPresent] is reached
    // through this %orig. If our paged layout ever hands it an inconsistent
    // state it throws, and an uncaught throw here takes down SpringBoard (the
    // observed crash). Contain it: a single bad presentation is downgraded to a
    // cosmetic glitch, the exception reason is recorded for field diagnosis, and
    // the layout is re-sanitised so the following present starts clean.
    @try {
        %orig;
    } @catch (NSException *presentationException) {
        dispatch_async(dispatch_get_main_queue(), ^{
            UIViewController *recoveryOverlay = gOverlayControllers.allObjects.firstObject;
            if (recoveryOverlay) [[EchoRebornCoordinator shared] normalizePagedLayoutForOverlay:recoveryOverlay];
        });
    }
    gERControlCenterPresented = state != 0;
    [[EchoRebornCoordinator shared] beginOwnedDuplicateHostPresentationSync];

    if (state == 0) {
        // 0.5.19：CC 收起时把系统状态栏窗口里被平移过的视图还原。
        // 这个窗口不随 CC 消失，不还原会把 App 自己的横屏状态栏一起带偏。
        [[EchoRebornCoordinator shared] restoreLandscapeSystemStatusBarIfNeeded];
        gERAddSheetPresentationActive = NO;
        gERPresentationNativeSettlePending = NO;
        gERPresentationReleasedWhileSettling = NO;
        gERPresentationPageHandoffActive = NO;
        gERPresentationHandoffArmed = NO;
        gERPresentationPanGesture = nil;
        gERPresentationController = nil;
        [gERPresentationPanDisplayLink invalidate];
        gERPresentationPanDisplayLink = nil;
        [gERPresentationPanDiscoveryDisplayLink invalidate];
        gERPresentationPanDiscoveryDisplayLink = nil;
        gERPresentationPanDiscoveryOverlay = nil;
        gERPresentationPanDiscoveryController = nil;
    }
    // 1.0.7-21（用户第 4 条）：收尾抑制位的唯一放行口 —— 只有呈现方向（1 正在呈现 /
    // 2 已呈现）才能解除；3（正收起）/ 0（已收起）都回置为抑制。用状态机而不是单次
    // 回调做判据，正是为了挡住收尾期里带着陈旧进度的回调。
    if (state == 1 || state == 2) gERDismissSuppressDuplicates = NO;
    if (state == 0) gERDismissSuppressDuplicates = YES;
    UIViewController *overlay = nil;
    if ([controller isKindOfClass:[UIViewController class]]) overlay = ERFindOverlayController((UIViewController *)controller);
    if (!overlay) overlay = gOverlayControllers.allObjects.firstObject;
    if (overlay) {
        if (state != 0) {
            if (gPagingEnabled && !gERPresentationPanGesture) {
                [[EchoRebornCoordinator shared] beginPresentationPanDiscoveryForOverlay:overlay controller:self];
            }
            UIPanGestureRecognizer *presentationPan = gERPresentationPanGesture;
            BOOL livePresentationPull = presentationPan && presentationPan.numberOfTouches > 0 &&
                (presentationPan.state == UIGestureRecognizerStateBegan || presentationPan.state == UIGestureRecognizerStateChanged);
            // didChangePresentationState can arrive in the middle of the
            // opening pull. Resetting these flags here used to cancel a valid
            // handoff based on callback timing, producing the intermittent
            // "works after manually scrubbing" behavior.
            if (!livePresentationPull && !gERPresentationNativeSettlePending && !gERPresentationPageHandoffActive) {
                gERPresentationReleasedWhileSettling = NO;
                gERPresentationHandoffArmed = NO;
                gERPresentationPendingProgress = (CGFloat)gERCurrentPage;
                gERPresentationPendingTouchY = kERPageIndicatorScrubStep * ((CGFloat)gERCurrentPage + 0.5);
                [gERPresentationPanDisplayLink invalidate];
                gERPresentationPanDisplayLink = nil;
            }
        }
        if (state == 0 && gPagingEnabled && gERPageCount > 1) {
            // A Control Center presentation is a fresh paging session. Reset
            // while the overlay is offscreen so the next pull always starts
            // on page one, matching iOS 18 and avoiding a pull-to-scrub
            // handoff inheriting the previous session's page transform.
            gERPagerTransitionActive = NO;
            gERPagerInteractiveTranslation = 0.0;
            gERPagerInteractiveProgress = 0.0;
            gERPagerInteractiveStartPage = 0;
            gERPagerInteractiveBeganTime = 0.0;
            gERPagerScrubbingActive = NO;
            BOOL needsPageReset = gERCurrentPage != 0 ||
                fabs(gERPagerInteractiveTranslation) > 0.01;
            if (needsPageReset) {
                __weak UIViewController *weakOverlay = overlay;
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.18 * NSEC_PER_SEC)),
                               dispatch_get_main_queue(), ^{
                    if (gERControlCenterPresentationState != 0) return;
                    UIViewController *settledOverlay = weakOverlay;
                    if (settledOverlay) {
                        [[EchoRebornCoordinator shared] setCurrentPage:0
                                                         forOverlay:settledOverlay
                                                           animated:NO];
                    }
                });
            }
        }
        // 1.0.7-21（用户第 4 条）：控制中心确认收起 → 同步硬隐藏磁贴宿主。
        // 不再依赖淡出 completion / display link 到期 / 下一次布局这些「将来时」，
        // state 0 到达的这一刻就把宿主收干净（实机录屏里 0.45s 的悬停由此消除）。
        if (state == 0) {
            [[EchoRebornCoordinator shared] forceHideOwnedDuplicateHostForOverlay:overlay];
        }
        UIView *hitBridge = [overlay.view viewWithTag:kERExtendedHitBridgeTag];
        if (state != 0 && hitBridge) [overlay.view bringSubviewToFront:hitBridge];
        BOOL hideQuickAccess = state == 0 || gERExpandedModuleOpen || gEditModeActive;
        [[EchoRebornCoordinator shared] setQuickAccessButtonsHidden:hideQuickAccess forOverlay:overlay animated:state != 0];
        [[EchoRebornCoordinator shared] updateTopFadeForOverlay:overlay presentationAlpha:state == 0 ? 0.0 : 1.0];
        // 1.0.6-8（第 4 条）：state 3 = 正在收起。旧写法只认 state != 0，于是整段
        // 收起动画期间（原生界面已经在往下走）磁贴都还是「已呈现」，一直留到
        // state 0 才淡出 —— 用户看到的正是截图里那一幕：控制中心都没了，磁贴还在。
        // 现在 state 3 就跟着一起淡出；若收起中途被取消，state 2 会带着 presented:YES
        // 回来并解封淡出窗口（见 animateOwnedDuplicateHostForOverlay:）。
        [[EchoRebornCoordinator shared] animateOwnedDuplicateHostForOverlay:overlay presented:(state != 0 && state != 3)];
        if (state != 0 && !gERExpandedModuleOpen) {
            // The source presentation layers already exist when this callback
            // returns. Copy them now so the first committed duplicate frame
            // cannot flash at its resting transform before the display link
            // begins following the native animation.
            [[EchoRebornCoordinator shared] layoutOwnedDuplicateModulesForOverlay:overlay];
            [[EchoRebornCoordinator shared] updateOwnedDuplicateHostForOverlay:overlay presentationAlpha:1.0];
        }
        if (gEditModeActive) {
            CGFloat chromeProgress = state == 0 ? 0.0 : 1.0;
            if (state == 0) {
                [UIView animateWithDuration:0.16 delay:0.0 options:UIViewAnimationOptionCurveEaseOut | UIViewAnimationOptionBeginFromCurrentState animations:^{
                    [[EchoRebornCoordinator shared] updateEditingChromeForPresentationProgress:chromeProgress overlay:overlay];
                } completion:nil];
            } else {
                [[EchoRebornCoordinator shared] updateEditingChromeForPresentationProgress:chromeProgress overlay:overlay];
            }
        }
        UIView *pageIndicators = [overlay.view viewWithTag:kERPageIndicatorHostTag];
        if (pageIndicators) {
            [pageIndicators.layer removeAllAnimations];
            [UIView performWithoutAnimation:^{
                BOOL indicatorsVisible = gPagingEnabled && gERPageCount > 1 && state != 0 &&
                    (!gERExpandedModuleOpen || ERExpandedChromeRevealActive());
                pageIndicators.hidden = !indicatorsVisible;
                pageIndicators.alpha = indicatorsVisible ? 1.0 : 0.0;
            }];
        }
        if (state == 0 || state == 2) {
            __weak UIViewController *weakOverlay = overlay;
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.20 * NSEC_PER_SEC)),
                           dispatch_get_main_queue(), ^{
                if (chromeGeneration != gERPresentationChromeGeneration ||
                    gERControlCenterPresentationState != state) return;
                UIViewController *settledOverlay = weakOverlay;
                if (settledOverlay) {
                    [[EchoRebornCoordinator shared] updatePageIndicatorsForOverlay:settledOverlay];
                }
            });
            if (state == 2) {
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.38 * NSEC_PER_SEC)),
                               dispatch_get_main_queue(), ^{
                    if (chromeGeneration != gERPresentationChromeGeneration ||
                        gERControlCenterPresentationState != 2) return;
                    UIViewController *settledOverlay = weakOverlay;
                    if (settledOverlay) ERRefreshSettledCompactMediaSnapshot(settledOverlay);
                });
            }
        }
        if (state != 0 && gEditModeActive) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                [[EchoRebornCoordinator shared] updateEditControlFramesForOverlay:overlay];
            });
        }
    }
    // CCUI presentation state zero is fully dismissed.  The modular overlay
    // remains in SpringBoard's view hierarchy, so UIViewController appearance
    // callbacks are not reliable enough to remove overlay-hosted edit chrome.
    if (state == 0 && gEditModeActive) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.18 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            if (gEditModeActive) [[EchoRebornCoordinator shared] dismissEditingImmediately];
        });
    }
    if (state == 0) {
        ERResetGenericExpansionDismissal();
        ERDiscardExpansionCompactTransitionAssets();
    }
}

%end

%end

%group ERExpandedModuleClickAssistant

%hook _UIClickPresentationAssistant

- (void)presentFromSourcePreview:(id)sourcePreview lifecycleCompletion:(id)completion {
    ERApplyExpansionPageGeometrySync(gOverlayControllers.allObjects.firstObject);
    %orig;
}

- (void)_animatePresentation {
    ERApplyExpansionPageGeometrySync(gOverlayControllers.allObjects.firstObject);
    %orig;
    UIView *snapshot = gERExpansionSourceSnapshot;
    UIViewPropertyAnimator *animator = ERExpansionPropertyAnimator(self);
    if (snapshot && animator) {
        [animator addAnimations:^{ snapshot.alpha = 0.0; } delayFactor:0.18];
        [animator addCompletion:^(__unused UIViewAnimatingPosition finalPosition) {
            if (gERExpansionSourceSnapshot == snapshot) ERDiscardExpansionSourceSnapshot();
        }];
    }
}

- (void)_didTransitionToPresented {
    %orig;
    ERDiscardExpansionSourceSnapshot();
}

- (void)_animateDismissalIsInterruption:(BOOL)interruption {
    UIViewController *overlay = gOverlayControllers.allObjects.firstObject;
    UIViewController *presented = overlay.presentedViewController;
    BOOL usesGenericTransition = !ERUsesSpecializedExpansionTransition(presented);
    NSUInteger transitionGeneration = 0;
    if (usesGenericTransition) {
        ERResetGenericExpansionDismissal();
        transitionGeneration = gERExpansionDismissalGeneration;
        ERFreezeExpandedModuleForDismissal(presented);
        ERInstallExpansionDismissalSnapshot(self);
    }
    ERReassertExpansionPageGeometry(overlay);
    %orig;
    UIViewPropertyAnimator *animator = ERExpansionPropertyAnimator(self);
    UIView *expandedSnapshot = gERExpansionExpandedSnapshot;
    UIView *compactSnapshot = gERExpansionDismissalSnapshot;
    UIView *foregroundSnapshot = gERExpansionDismissalForegroundSnapshot;
    CGPoint compactCenter = CGPointMake(CGRectGetMidX(gERExpansionCompactDestinationWindowFrame),
                                        CGRectGetMidY(gERExpansionCompactDestinationWindowFrame));
    if (usesGenericTransition && expandedSnapshot && animator) {
        [animator addAnimations:^{
            expandedSnapshot.alpha = 0.0;
            compactSnapshot.alpha = 1.0;
            compactSnapshot.frame = gERExpansionCompactDestinationWindowFrame;
            compactSnapshot.layer.cornerRadius = gERExpansionCompactCornerRadius;
            foregroundSnapshot.alpha = 1.0;
            foregroundSnapshot.center = compactCenter;
        }];
    }
    ERHoldExpansionPageGeometryDuringDismissal(overlay);
    if (usesGenericTransition && animator) {
        [animator addCompletion:^(UIViewAnimatingPosition finalPosition) {
            if (transitionGeneration != gERExpansionDismissalGeneration) return;
            gERExpansionDismissalAnimatorFinished = YES;
            if (finalPosition != UIViewAnimatingPositionEnd) {
                gERExpansionDismissalDidClose = YES;
            }
            ERCompleteGenericExpansionDismissalIfReady();
        }];
    } else if (usesGenericTransition) {
        [UIView animateWithDuration:0.2 animations:^{
            expandedSnapshot.alpha = 0.0;
            compactSnapshot.alpha = 1.0;
            compactSnapshot.frame = gERExpansionCompactDestinationWindowFrame;
            compactSnapshot.layer.cornerRadius = gERExpansionCompactCornerRadius;
            foregroundSnapshot.alpha = 1.0;
            foregroundSnapshot.center = compactCenter;
        } completion:^(__unused BOOL finished) {
            if (transitionGeneration != gERExpansionDismissalGeneration) return;
            gERExpansionDismissalAnimatorFinished = YES;
            ERCompleteGenericExpansionDismissalIfReady();
        }];
    }
}

- (void)_postInteractionCleanup {
    %orig;
    ERDiscardExpansionSourceSnapshot();
}

%end

%end

%group ERExpandedPlatterRadius

static BOOL ERIsConnectivityExpandedController(UIViewController *controller) {
    if (!controller) return [gERExpandedModuleIdentifier isEqualToString:@"com.apple.control-center.ConnectivityModule"];
    if ([NSStringFromClass(controller.class) isEqualToString:@"CCUIConnectivityModuleViewController"]) return YES;
    UIViewController *connectivity = ERConnectivityChild(controller, @"CCUIConnectivityModuleViewController");
    if (connectivity) return YES;
    return NO;
}

static void ERSuppressConnectivityOuterMaterial(UIPresentationController *presentationController) {
    UIViewController *presentedController = presentationController.presentedViewController;
    if (!ERIsConnectivityExpandedController(presentedController)) return;
    UIView *presentedView = presentationController.presentedView;
    UIView *contentView = presentedController.view;
    presentedView.backgroundColor = UIColor.clearColor;
    contentView.backgroundColor = UIColor.clearColor;
    UIView *containerView = presentationController.containerView;
    NSMutableArray<UIView *> *queue = [NSMutableArray array];
    if (containerView) [queue addObject:containerView];
    else if (presentedView) [queue addObject:presentedView];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        NSString *name = NSStringFromClass(candidate.class);
        BOOL effectSurface = [candidate isKindOfClass:[UIVisualEffectView class]] || [name containsString:@"Material"] || [name containsString:@"Backdrop"];
        CGRect converted = candidate.superview ? [candidate.superview convertRect:candidate.frame toView:presentedView] : candidate.bounds;
        BOOL platterSized = fabs(CGRectGetWidth(converted) - CGRectGetWidth(presentedView.bounds)) <= 8.0 &&
                            fabs(CGRectGetHeight(converted) - CGRectGetHeight(presentedView.bounds)) <= 8.0;
        BOOL belongsToCustomContent = candidate == contentView || [candidate isDescendantOfView:contentView];
        // Our six cards are deliberately smaller than the presentation host;
        // only the stock full-platter material is suppressed.
        if (effectSurface && platterSized && !belongsToCustomContent && !objc_getAssociatedObject(candidate, kERConnectivitySuppressedSurfaceKey)) {
            objc_setAssociatedObject(candidate, kERConnectivitySuppressedSurfaceKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            candidate.alpha = 0.0;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

static BOOL ERConnectivityViewLivesInsideCustomCard(UIView *view, UIView *container) {
    for (UIView *ancestor = view; ancestor && ancestor != container; ancestor = ancestor.superview) {
        NSInteger tag = ancestor.tag;
        if ((tag >= kERConnectivityExpandedCardBaseTag && tag < kERConnectivityExpandedCardBaseTag + 6) ||
            tag == kERConnectivityExpandedVPNTag) return YES;
    }
    return NO;
}

static void ERSuppressConnectivityStockContainerMaterial(UIView *contentContainer) {
    if (!contentContainer) return;
    CGFloat containerWidth = CGRectGetWidth(contentContainer.bounds);
    CGFloat containerHeight = CGRectGetHeight(contentContainer.bounds);
    if (containerWidth < 1.0 || containerHeight < 1.0) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithArray:contentContainer.subviews];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        NSString *name = NSStringFromClass(candidate.class);
        BOOL material = [candidate isKindOfClass:[UIVisualEffectView class]] ||
                        [name containsString:@"Material"] || [name containsString:@"Backdrop"];
        if (material && !ERConnectivityViewLivesInsideCustomCard(candidate, contentContainer)) {
            CGRect frame = [candidate convertRect:candidate.bounds toView:contentContainer];
            // The stock platter backing is the only material that occupies most
            // of the presentation container. During UIKit's reparenting pass it
            // briefly takes on crossed/stretched geometry, so suppress it by
            // coverage rather than by a device-specific frame or class name.
            BOOL outerBacking = CGRectGetWidth(frame) >= containerWidth * 0.68 &&
                                CGRectGetHeight(frame) >= containerHeight * 0.68;
            if (outerBacking) {
                objc_setAssociatedObject(candidate, kERConnectivitySuppressedSurfaceKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                [candidate.layer removeAllAnimations];
                candidate.hidden = YES;
                candidate.alpha = 0.0;
                candidate.layer.opacity = 0.0;
            }
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
}

static void ERConfigureConnectivityPresentationContainer(UIPresentationController *presentationController) {
    if (!gEnabled || !gERConnectivityExpansionActive || !presentationController.presentedViewController.view) return;
    UIView *presentedRoot = presentationController.presentedViewController.view;
    BOOL transitionOwnsVisibility = gERConnectivityTransitionHost != nil &&
        gERConnectivityExpansionActive && !gERConnectivityClosingTransitionActive &&
        !gERConnectivitySnapshotCaptureActive;
    if (transitionOwnsVisibility) {
        // Suppressing only the connectivity child is too late: Apple's detail
        // presentation briefly draws duplicated labels and toggles in wrapper
        // views while it reparents them. Keep the entire presented pane out of
        // the render tree until our settled composite is ready.
        UIView *presentedSurface = presentationController.presentedView;
        [UIView performWithoutAnimation:^{
            [presentedSurface.layer removeAllAnimations];
            presentedSurface.hidden = YES;
            presentedSurface.alpha = 0.0;
            presentedSurface.layer.opacity = 0.0;
        }];
    }
    UIView *contentContainer = ERFindSubviewWithClassName(presentedRoot, @"CCUIContentModuleContentContainerView");
    if (!contentContainer) return;
    ERSuppressConnectivityStockContainerMaterial(contentContainer);
    CGFloat width = CGRectGetWidth(contentContainer.bounds);
    if (width < 250.0) width = CGRectGetWidth(contentContainer.frame);
    if (width < 250.0) return;
    ERConnectivityExpandedMetrics metrics = ERConnectivityMetricsForWidth(width);
    UIEdgeInsets safeInsets = presentedRoot.window.safeAreaInsets;
    CGFloat availableHeight = CGRectGetHeight(presentedRoot.bounds) - safeInsets.top - safeInsets.bottom - 32.0;
    CGFloat height = MIN(metrics.contentHeight, availableHeight);
    // UIKit's iOS 16 detail presentation is shorter than our rebuilt platter.
    // Remove clipping from the presentation chain before changing the content
    // frame, otherwise the first committed frame briefly cuts the VPN/bottom
    // bar off at the stock expanded height.
    presentationController.containerView.clipsToBounds = NO;
    presentationController.containerView.layer.masksToBounds = NO;
    for (UIView *ancestor = contentContainer; ancestor; ancestor = ancestor.superview) {
        ancestor.clipsToBounds = NO;
        ancestor.layer.masksToBounds = NO;
        if (ancestor == presentedRoot || ancestor == presentationController.containerView) break;
    }
    CGRect frame = contentContainer.frame;
    frame.size = CGSizeMake(width, height);
    frame.origin.x = round((CGRectGetWidth(presentedRoot.bounds) - width) * 0.5);
    frame.origin.y = round((CGRectGetHeight(presentedRoot.bounds) - height) * 0.5);
    contentContainer.frame = frame;
    contentContainer.bounds = CGRectMake(0.0, 0.0, width, height);
    contentContainer.clipsToBounds = NO;
    for (UIView *child in contentContainer.subviews) {
        NSString *name = NSStringFromClass(child.class);
        if ([name containsString:@"Material"] || [child isKindOfClass:[UIVisualEffectView class]]) {
            child.hidden = YES;
            child.alpha = 0.0;
        } else {
            child.frame = contentContainer.bounds;
            child.bounds = contentContainer.bounds;
        }
    }
    UIViewController *connectivity = ERConnectivityChild(presentationController.presentedViewController, @"CCUIConnectivityModuleViewController");
    if ([NSStringFromClass(presentationController.presentedViewController.class) isEqualToString:@"CCUIConnectivityModuleViewController"]) {
        connectivity = presentationController.presentedViewController;
    }
    if (connectivity) {
        if (connectivity.view == gERConnectivityDetachedLiveView) {
            // During the opening blend the real content is deliberately
            // hosted at final screen coordinates. Do not let a presentation
            // layout pass put it back into content-container coordinates.
            return;
        }
        if (transitionOwnsVisibility) {
            // The expanded presentation may own a different connectivity
            // controller than the compact module. Hide this instance before
            // UIKit gets a chance to animate any of its children onscreen.
            [connectivity.view.layer removeAnimationForKey:@"opacity"];
            connectivity.view.layer.opacity = 0.0;
            connectivity.view.alpha = 0.0;
            connectivity.view.hidden = YES;
        }
        connectivity.view.frame = contentContainer.bounds;
        connectivity.view.bounds = contentContainer.bounds;
        ERConfigureConnectivityLayout(connectivity);
        [connectivity.view setNeedsLayout];
        [connectivity.view layoutIfNeeded];
        // Child labeled buttons finish their own layout after the parent.  A
        // final explicit pass ensures the transition snapshot never captures
        // the blank/intermediate card geometry used by UIKit's animator.
        ERConfigureConnectivityLayout(connectivity);
        if (transitionOwnsVisibility) {
            [connectivity.view.layer removeAnimationForKey:@"opacity"];
            connectivity.view.layer.opacity = 0.0;
            connectivity.view.alpha = 0.0;
            connectivity.view.hidden = YES;
        }
    }
    // A late native layout can recreate or resize the stock material after the
    // first suppression pass. Reassert after the final connectivity layout.
    ERSuppressConnectivityStockContainerMaterial(contentContainer);
}

static UIView *ERConnectivityStaticSnapshot(UIView *view, BOOL afterScreenUpdates) {
    if (!view || CGRectGetWidth(view.bounds) < 1.0 || CGRectGetHeight(view.bounds) < 1.0) return nil;
    // This must be a true still image. snapshotViewAfterScreenUpdates: keeps a
    // live replica of the source layers; connectivity reparents those layers
    // during expansion, which made the frozen compact module mutate into the
    // expanded card geometry. Compact and settled-closing content has already
    // rendered. Compact content uses a no-flush bitmap so it cannot mutate
    // during UIKit's reparenting; the already-settled expanded hierarchy uses
    // a flush so MTMaterial/backdrop layers are included in the bitmap.
    UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat defaultFormat];
    format.opaque = NO;
    format.scale = UIScreen.mainScreen.scale;
    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:view.bounds.size format:format];
    UIImage *image = [renderer imageWithActions:^(UIGraphicsImageRendererContext *context) {
        BOOL drawn = [view drawViewHierarchyInRect:(CGRect){CGPointZero, view.bounds.size}
                                afterScreenUpdates:afterScreenUpdates];
        if (!drawn) [view.layer renderInContext:context.CGContext];
    }];
    UIImageView *snapshot = [[UIImageView alloc] initWithImage:image];
    snapshot.contentMode = UIViewContentModeScaleToFill;
    snapshot.userInteractionEnabled = NO;
    return snapshot;
}

static void ERStopConnectivitySubviewAnimations(UIView *view, BOOL includeRoot) {
    if (!view) return;
    if (includeRoot) [view.layer removeAllAnimations];
    for (UIView *subview in view.subviews) {
        [subview.layer removeAllAnimations];
        ERStopConnectivitySubviewAnimations(subview, NO);
    }
}

static BOOL ERIsConnectivityTransitionLeafController(UIViewController *controller) {
    NSString *name = NSStringFromClass(controller.class);
    return [name isEqualToString:@"CCUIConnectivityAirplaneViewController"] ||
           [name isEqualToString:@"CCUIConnectivityCellularDataViewController"] ||
           [name isEqualToString:@"CCUIConnectivityWifiViewController"] ||
           [name isEqualToString:@"CCUIConnectivityBluetoothViewController"] ||
           [name isEqualToString:@"CCUIConnectivityAirDropViewController"] ||
           [name isEqualToString:@"CCUIConnectivityHotspotViewController"];
}

static void ERSuppressConnectivityLiveChildren(UIViewController *controller) {
    if (!controller) return;
    NSMutableArray<UIViewController *> *queue = [NSMutableArray arrayWithArray:controller.childViewControllers];
    while (queue.count) {
        UIViewController *child = queue.firstObject;
        [queue removeObjectAtIndex:0];
        [queue addObjectsFromArray:child.childViewControllers];
        if (!ERIsConnectivityTransitionLeafController(child)) continue;
        [UIView performWithoutAnimation:^{
            ERStopConnectivitySubviewAnimations(child.view, YES);
            child.view.hidden = YES;
            child.view.alpha = 0.0;
            child.view.layer.opacity = 0.0;
        }];
    }
}

static void ERRestoreConnectivityDetachedLiveView(void) {
    UIView *view = gERConnectivityDetachedLiveView;
    UIView *superview = gERConnectivityDetachedOriginalSuperview;
    if (view && superview) {
        [UIView performWithoutAnimation:^{
            [view removeFromSuperview];
            view.layer.mask = nil;
            view.transform = CGAffineTransformIdentity;
            NSUInteger index = gERConnectivityDetachedOriginalIndex;
            if (index == NSNotFound || index > superview.subviews.count) index = superview.subviews.count;
            [superview insertSubview:view atIndex:index];
            view.frame = gERConnectivityDetachedOriginalFrame;
            view.bounds = gERConnectivityDetachedOriginalBounds;
        }];
    }
    gERConnectivityDetachedLiveView = nil;
    gERConnectivityDetachedOriginalSuperview = nil;
    gERConnectivityDetachedOriginalFrame = CGRectZero;
    gERConnectivityDetachedOriginalBounds = CGRectZero;
    gERConnectivityDetachedOriginalIndex = NSNotFound;
}

static void ERRemoveConnectivityTransitionVisuals(BOOL restoreLiveView) {
    [gERConnectivityTransitionHost.layer removeAllAnimations];
    [gERConnectivityCompactTransitionSnapshot.layer removeAllAnimations];
    [gERConnectivityExpandedTransitionSnapshot.layer removeAllAnimations];
    [gERConnectivityTransitionSurface.layer removeAllAnimations];
    ERRestoreConnectivityDetachedLiveView();
    [gERConnectivityTransitionHost removeFromSuperview];
    gERConnectivityTransitionHost = nil;
    gERConnectivityTransitionWindow.hidden = YES;
    gERConnectivityTransitionWindow.rootViewController = nil;
    gERConnectivityTransitionWindow = nil;
    gERConnectivityCompactTransitionSnapshot = nil;
    gERConnectivityExpandedTransitionSnapshot = nil;
    gERConnectivityTransitionSurface = nil;
    gERConnectivityOpeningRevealStarted = NO;
    gERConnectivityClosingTransitionActive = NO;
    gERConnectivityClosingFinishScheduled = NO;
    gERConnectivityClosingTransitionDeadline = 0.0;
    gERConnectivitySnapshotCaptureActive = NO;
    UIView *presentedSurface = gERConnectivityTransitionPresentationController.presentedView;
    if (restoreLiveView) {
        [UIView performWithoutAnimation:^{
            presentedSurface.hidden = NO;
            presentedSurface.alpha = 1.0;
            presentedSurface.layer.opacity = 1.0;
            if (gERConnectivityTransitionController.view) {
                gERConnectivityTransitionController.view.hidden = NO;
                gERConnectivityTransitionController.view.alpha = 1.0;
                gERConnectivityTransitionController.view.layer.opacity = 1.0;
            }
        }];
    }
    gERConnectivityTransitionPresentationController = nil;
}

static UIView *ERConnectivityTransitionHostForWindow(UIWindow *window) {
    if (!window) return nil;
    // UIKit may move the expanded platter into a temporary window and destroy
    // that window before our closing animation completes. Use a short-lived,
    // noninteractive compositor window above both hierarchies so one atomic
    // transition survives the complete open/close handoff.
    if (gERConnectivityTransitionHost.superview) {
        gERConnectivityTransitionWindow.windowLevel = MAX(gERConnectivityTransitionWindow.windowLevel,
                                                            window.windowLevel + 100.0);
        gERConnectivityTransitionWindow.hidden = NO;
    } else {
        UIWindow *transitionWindow = nil;
        if (@available(iOS 13.0, *)) {
            if (window.windowScene) transitionWindow = [[UIWindow alloc] initWithWindowScene:window.windowScene];
        }
        if (!transitionWindow) transitionWindow = [[UIWindow alloc] initWithFrame:UIScreen.mainScreen.bounds];
        transitionWindow.frame = UIScreen.mainScreen.bounds;
        transitionWindow.backgroundColor = UIColor.clearColor;
        transitionWindow.opaque = NO;
        transitionWindow.userInteractionEnabled = NO;
        transitionWindow.windowLevel = MAX(UIWindowLevelAlert + 100.0, window.windowLevel + 100.0);
        UIViewController *root = [UIViewController new];
        root.view.frame = transitionWindow.bounds;
        root.view.backgroundColor = UIColor.clearColor;
        root.view.opaque = NO;
        root.view.userInteractionEnabled = NO;
        root.view.clipsToBounds = NO;
        transitionWindow.rootViewController = root;
        transitionWindow.hidden = NO;
        gERConnectivityTransitionWindow = transitionWindow;
        gERConnectivityTransitionHost = root.view;
    }
    return gERConnectivityTransitionHost;
}

static CGRect ERConnectivityScreenFrameForView(UIView *view) {
    if (!view.window) return CGRectNull;
    CGRect windowFrame = [view convertRect:view.bounds toView:view.window];
    return [view.window convertRect:windowFrame toCoordinateSpace:UIScreen.mainScreen.coordinateSpace];
}

static CGRect ERConnectivityHostFrameForScreenRect(UIView *host, CGRect screenRect) {
    if (!host || CGRectIsNull(screenRect)) return CGRectNull;
    return [host convertRect:screenRect fromCoordinateSpace:UIScreen.mainScreen.coordinateSpace];
}

static UIImage *ERConnectivityWindowImage(UIWindow *window) {
    if (!window || CGRectGetWidth(window.bounds) < 1.0 || CGRectGetHeight(window.bounds) < 1.0) return nil;
    UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat defaultFormat];
    format.opaque = NO;
    format.scale = UIScreen.mainScreen.scale;
    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:window.bounds.size format:format];
    return [renderer imageWithActions:^(UIGraphicsImageRendererContext *context) {
        CGContextSaveGState(context.CGContext);
        CGContextTranslateCTM(context.CGContext, -CGRectGetMinX(window.bounds), -CGRectGetMinY(window.bounds));
        BOOL drawn = [window drawViewHierarchyInRect:window.bounds afterScreenUpdates:YES];
        if (!drawn) [window.layer renderInContext:context.CGContext];
        CGContextRestoreGState(context.CGContext);
    }];
}

static UIImage *ERConnectivityCropImage(UIImage *image, CGRect rect) {
    if (!image.CGImage || CGRectGetWidth(rect) < 1.0 || CGRectGetHeight(rect) < 1.0) return nil;
    CGFloat scale = image.scale;
    CGRect pixels = CGRectMake(round(CGRectGetMinX(rect) * scale), round(CGRectGetMinY(rect) * scale),
                               round(CGRectGetWidth(rect) * scale), round(CGRectGetHeight(rect) * scale));
    CGRect imagePixels = CGRectMake(0.0, 0.0, CGImageGetWidth(image.CGImage), CGImageGetHeight(image.CGImage));
    pixels = CGRectIntersection(pixels, imagePixels);
    if (CGRectIsNull(pixels) || CGRectGetWidth(pixels) < 1.0 || CGRectGetHeight(pixels) < 1.0) return nil;
    CGImageRef cropped = CGImageCreateWithImageInRect(image.CGImage, pixels);
    if (!cropped) return nil;
    UIImage *result = [UIImage imageWithCGImage:cropped scale:scale orientation:UIImageOrientationUp];
    CGImageRelease(cropped);
    return result;
}

static UIView *ERConnectivityExpandedCompositeSnapshot(UIViewController *controller, UIView *host) {
    if (!controller.view.window || !host) return nil;
    UIWindow *window = controller.view.window;
    UIImage *windowImage = ERConnectivityWindowImage(window);
    if (!windowImage) return nil;

    NSMutableArray<UIView *> *cards = [NSMutableArray array];
    for (NSInteger tag = kERConnectivityExpandedCardBaseTag; tag < kERConnectivityExpandedCardBaseTag + 6; tag++) {
        UIView *card = [controller.view viewWithTag:tag];
        if (card && !card.hidden && card.alpha > 0.01) [cards addObject:card];
    }
    UIView *vpn = [controller.view viewWithTag:kERConnectivityExpandedVPNTag];
    if (vpn && !vpn.hidden && vpn.alpha > 0.01) [cards addObject:vpn];
    if (!cards.count) return nil;

    CGRect unionScreenFrame = CGRectNull;
    NSMutableArray<NSValue *> *screenFrames = [NSMutableArray arrayWithCapacity:cards.count];
    for (UIView *card in cards) {
        CGRect screenFrame = ERConnectivityScreenFrameForView(card);
        [screenFrames addObject:[NSValue valueWithCGRect:screenFrame]];
        unionScreenFrame = CGRectIsNull(unionScreenFrame) ? screenFrame : CGRectUnion(unionScreenFrame, screenFrame);
    }
    if (CGRectIsNull(unionScreenFrame)) return nil;

    UIView *composite = [[UIView alloc] initWithFrame:ERConnectivityHostFrameForScreenRect(host, unionScreenFrame)];
    composite.backgroundColor = UIColor.clearColor;
    composite.opaque = NO;
    composite.userInteractionEnabled = NO;
    composite.clipsToBounds = NO;

    [cards enumerateObjectsUsingBlock:^(UIView *card, NSUInteger index, __unused BOOL *stop) {
        CGRect screenFrame = screenFrames[index].CGRectValue;
        CGRect windowFrame = [card convertRect:card.bounds toView:window];
        UIImage *cardImage = ERConnectivityCropImage(windowImage, windowFrame);
        if (!cardImage) return;
        CGRect relativeFrame = CGRectOffset(screenFrame, -CGRectGetMinX(unionScreenFrame), -CGRectGetMinY(unionScreenFrame));
        UIImageView *cardSnapshot = [[UIImageView alloc] initWithImage:cardImage];
        cardSnapshot.frame = relativeFrame;
        cardSnapshot.contentMode = UIViewContentModeScaleToFill;
        cardSnapshot.layer.cornerRadius = card.layer.cornerRadius;
        cardSnapshot.layer.cornerCurve = kCACornerCurveContinuous;
        cardSnapshot.layer.masksToBounds = YES;
        [composite addSubview:cardSnapshot];
    }];
    return composite.subviews.count ? composite : nil;
}

static NSTimeInterval ERConnectivityTransitionDuration(UIViewController *controller) {
    id<UIViewControllerTransitionCoordinator> coordinator = controller.transitionCoordinator;
    NSTimeInterval duration = coordinator ? coordinator.transitionDuration : 0.36;
    return MIN(0.46, MAX(0.30, duration));
}

static void ERRestoreConnectivityPresentedSurface(UIPresentationController *presentationController, UIViewController *controller) {
    UIView *presentedSurface = presentationController.presentedView;
    [UIView performWithoutAnimation:^{
        presentedSurface.hidden = NO;
        presentedSurface.alpha = 1.0;
        presentedSurface.layer.opacity = 1.0;
        controller.view.hidden = NO;
        controller.view.alpha = 1.0;
        controller.view.layer.opacity = 1.0;
        controller.view.transform = CGAffineTransformIdentity;
        ERConfigureConnectivityLayout(controller);
        [controller.view setNeedsLayout];
        [controller.view layoutIfNeeded];
        ERConfigureConnectivityLayout(controller);
    }];
}

static void ERBeginConnectivityOpeningTransition(UIViewController *controller) {
    if (!controller.view.window || CGRectGetWidth(controller.view.bounds) < 1.0) return;
    ERRemoveConnectivityTransitionVisuals(YES);
    gERConnectivityTransitionGeneration++;
    gERConnectivityTransitionController = controller;
    gERConnectivityCompactController = controller;
    UIWindow *window = controller.view.window;
    // Remember the persistent Control Center window. The expanded platter can
    // be moved to a short-lived presentation window; hosting the return there
    // made the animation disappear whenever UIKit tore that window down first.
    gERConnectivityCompactWindow = window;
    UIView *host = ERConnectivityTransitionHostForWindow(window);
    UIView *sourceView = (gERConnectivityHasProxySourceFrame && gERConnectivityProxySourceView.window) ? gERConnectivityProxySourceView : controller.view;
    UIView *snapshot = ERConnectivityStaticSnapshot(sourceView, NO);
    if (!host || !snapshot) return;
    CGRect frame = gERConnectivityHasProxySourceFrame ? gERConnectivityProxySourceWindowFrame : ERConnectivityScreenFrameForView(controller.view);
    gERConnectivityCompactWindowFrame = frame;
    gERConnectivityHasCompactWindowFrame = CGRectGetWidth(frame) > 1.0 && CGRectGetHeight(frame) > 1.0;
    snapshot.frame = ERConnectivityHostFrameForScreenRect(host, frame);
    CGFloat sourceRadius = gERConnectivityHasProxySourceFrame ? gERConnectivityProxySourceCornerRadius : controller.view.layer.cornerRadius;
    gERConnectivityCompactCornerRadius = sourceRadius > 1.0 ? sourceRadius : 32.0;
    snapshot.layer.cornerRadius = gERConnectivityCompactCornerRadius;
    snapshot.layer.cornerCurve = kCACornerCurveContinuous;
    snapshot.layer.masksToBounds = YES;
    UIView *surface = ERNewConnectivityMaterialView(controller.view);
    surface.frame = snapshot.frame;
    surface.layer.cornerRadius = gERConnectivityCompactCornerRadius;
    surface.layer.cornerCurve = kCACornerCurveContinuous;
    surface.layer.masksToBounds = YES;
    surface.alpha = 1.0;
    [host addSubview:surface];
    gERConnectivityTransitionSurface = surface;
    [host addSubview:snapshot];
    gERConnectivityCompactTransitionSnapshot = snapshot;
    if ([snapshot isKindOfClass:[UIImageView class]]) {
        gERConnectivityCachedCompactImage = ((UIImageView *)snapshot).image;
    }
    [UIView performWithoutAnimation:^{
        controller.view.hidden = YES;
        controller.view.alpha = 0.0;
        controller.view.layer.opacity = 0.0;
    }];
}

static void ERStartConnectivityOpeningReveal(UIPresentationController *presentationController) {
    if (!gERConnectivityExpansionActive || gERConnectivityOpeningRevealStarted || gERConnectivityClosingTransitionActive) return;
    UIViewController *presented = presentationController.presentedViewController;
    UIViewController *controller = ERConnectivityChild(presented, @"CCUIConnectivityModuleViewController");
    if ([NSStringFromClass(presented.class) isEqualToString:@"CCUIConnectivityModuleViewController"]) controller = presented;
    if (!controller || !controller.view.window || !gERConnectivityTransitionHost) return;
    gERConnectivityOpeningRevealStarted = YES;
    gERConnectivityTransitionController = controller;
    gERConnectivityTransitionPresentationController = presentationController;
    NSUInteger generation = gERConnectivityTransitionGeneration;
    UIWindow *window = controller.view.window;
    UIView *host = gERConnectivityTransitionHost ?: ERConnectivityTransitionHostForWindow(window);

    if (!host) {
        ERRemoveConnectivityTransitionVisuals(YES);
        return;
    }

    // Let the final expanded hierarchy settle invisibly, then flatten it once.
    // Animating this stable image prevents UIKit's child controllers from
    // reintroducing their stock fly-out animations midway through our blend.
    gERConnectivitySnapshotCaptureActive = YES;
    UIView *presentedSurface = presentationController.presentedView;
    [UIView performWithoutAnimation:^{
        presentedSurface.hidden = NO;
        presentedSurface.alpha = 1.0;
        presentedSurface.layer.opacity = 1.0;
        controller.view.hidden = NO;
        controller.view.alpha = 1.0;
        controller.view.layer.opacity = 1.0;
        controller.view.transform = CGAffineTransformIdentity;
        ERConfigureConnectivityLayout(controller);
        [controller.view setNeedsLayout];
        [controller.view layoutIfNeeded];
        ERConfigureConnectivityLayout(controller);
        ERStopConnectivitySubviewAnimations(controller.view, YES);
    }];

    CGSize finalSize = controller.view.bounds.size;
    CGRect screenBounds = UIScreen.mainScreen.bounds;
    // convertRect: includes the presentation ancestor's in-flight transform at
    // this point and therefore reports a compact-origin frame. The expanded
    // platter is centered by its presentation controller; derive that final
    // frame directly from its settled bounds so the temporary host is immune
    // to the native transition's current progress on every screen size.
    CGRect finalScreenFrame = CGRectMake(round((CGRectGetWidth(screenBounds) - finalSize.width) * 0.5),
                                         round((CGRectGetHeight(screenBounds) - finalSize.height) * 0.5),
                                         finalSize.width,
                                         finalSize.height);
    CGRect finalHostFrame = ERConnectivityHostFrameForScreenRect(host, finalScreenFrame);
    UIView *expandedSnapshot = ERConnectivityExpandedCompositeSnapshot(controller, host);
    if (!expandedSnapshot) expandedSnapshot = ERConnectivityStaticSnapshot(controller.view, YES);
    if (!expandedSnapshot || CGRectIsNull(finalHostFrame)) {
        ERRemoveConnectivityTransitionVisuals(YES);
        return;
    }
    if ([expandedSnapshot isKindOfClass:[UIImageView class]]) expandedSnapshot.frame = finalHostFrame;
    expandedSnapshot.alpha = 0.0;
    expandedSnapshot.transform = CGAffineTransformMakeTranslation(0.0, 12.0);
    [host addSubview:expandedSnapshot];
    gERConnectivityExpandedTransitionSnapshot = expandedSnapshot;
    gERConnectivitySnapshotCaptureActive = NO;
    [UIView performWithoutAnimation:^{
        presentedSurface.hidden = YES;
        presentedSurface.alpha = 0.0;
        presentedSurface.layer.opacity = 0.0;
        controller.view.hidden = YES;
        controller.view.alpha = 0.0;
        controller.view.layer.opacity = 0.0;
        controller.view.transform = CGAffineTransformIdentity;
    }];
    ERSuppressConnectivityLiveChildren(controller);

    // Compact and expanded connectivity are each flattened into one complete
    // pane. Their cards, labels, and glyphs therefore cannot separate or fly on
    // independent native child animations during the handoff.
    NSTimeInterval duration = MIN(0.70, MAX(0.64, ERConnectivityTransitionDuration(presented) + 0.24));
    [UIView animateKeyframesWithDuration:duration delay:0.0
                                options:UIViewKeyframeAnimationOptionCalculationModeCubic | UIViewAnimationOptionCurveEaseInOut |
                                        UIViewAnimationOptionBeginFromCurrentState
                             animations:^{
        [UIView addKeyframeWithRelativeStartTime:0.02 relativeDuration:0.56 animations:^{
            gERConnectivityCompactTransitionSnapshot.alpha = 0.0;
        }];
        [UIView addKeyframeWithRelativeStartTime:0.0 relativeDuration:0.82 animations:^{
            gERConnectivityTransitionSurface.frame = finalHostFrame;
            gERConnectivityTransitionSurface.layer.cornerRadius = 38.0;
            gERConnectivityTransitionSurface.alpha = 0.18;
        }];
        [UIView addKeyframeWithRelativeStartTime:0.58 relativeDuration:0.42 animations:^{
            gERConnectivityTransitionSurface.alpha = 0.0;
        }];
        [UIView addKeyframeWithRelativeStartTime:0.20 relativeDuration:0.76 animations:^{
            expandedSnapshot.alpha = 1.0;
            expandedSnapshot.transform = CGAffineTransformIdentity;
        }];
    } completion:^(__unused BOOL finished) {
        if (generation != gERConnectivityTransitionGeneration || gERConnectivityClosingTransitionActive) {
            if (!gERConnectivityClosingTransitionActive && gERExpandedModuleOpen) {
                ERRestoreConnectivityPresentedSurface(presentationController, controller);
                ERRemoveConnectivityTransitionVisuals(NO);
            }
            return;
        }
        gERConnectivitySnapshotCaptureActive = NO;
        ERRestoreConnectivityPresentedSurface(presentationController, controller);
        ERRemoveConnectivityTransitionVisuals(NO);
    }];
    __weak UIPresentationController *weakPresentation = presentationController;
    __weak UIViewController *weakController = controller;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((duration + 0.18) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (generation != gERConnectivityTransitionGeneration || gERConnectivityClosingTransitionActive || !gERExpandedModuleOpen) return;
        if (weakPresentation && weakController) {
            ERRestoreConnectivityPresentedSurface(weakPresentation, weakController);
            ERRemoveConnectivityTransitionVisuals(NO);
        }
    });
}

static void ERBeginConnectivityClosingTransition(UIPresentationController *presentationController) {
    if (!gERConnectivityExpansionActive || gERConnectivityClosingTransitionActive) return;
    UIViewController *presented = presentationController.presentedViewController;
    UIViewController *controller = ERConnectivityChild(presented, @"CCUIConnectivityModuleViewController");
    if ([NSStringFromClass(presented.class) isEqualToString:@"CCUIConnectivityModuleViewController"]) controller = presented;
    if (!controller || !controller.view.window) return;

    ERRemoveConnectivityTransitionVisuals(YES);
    gERConnectivityTransitionGeneration++;
    NSUInteger generation = gERConnectivityTransitionGeneration;
    gERConnectivityClosingTransitionActive = YES;
    gERConnectivityTransitionController = controller;
    gERConnectivityTransitionPresentationController = presentationController;
    UIWindow *window = gERConnectivityCompactWindow ?: controller.view.window;
    UIView *host = ERConnectivityTransitionHostForWindow(window);
    gERConnectivitySnapshotCaptureActive = YES;
    // Capture the fully composited pixels of each custom card from the source
    // window. MTMaterial/backdrop layers do not reliably render when the
    // controller alone is flattened; card crops keep every background, label,
    // and glyph together under one parent transform.
    UIView *snapshot = ERConnectivityExpandedCompositeSnapshot(controller, host);
    if (!snapshot) snapshot = ERConnectivityStaticSnapshot(controller.view, YES);
    gERConnectivitySnapshotCaptureActive = NO;
    if (!host || !snapshot) {
        ERRemoveConnectivityTransitionVisuals(YES);
        return;
    }
    CGRect expandedWindowFrame = ERConnectivityScreenFrameForView(controller.view);
    if ([snapshot isKindOfClass:[UIImageView class]]) {
        snapshot.frame = ERConnectivityHostFrameForScreenRect(host, expandedWindowFrame);
    }
    UIView *surface = ERNewConnectivityMaterialView(controller.view);
    surface.frame = ERConnectivityHostFrameForScreenRect(host, expandedWindowFrame);
    surface.layer.cornerRadius = 38.0;
    surface.layer.cornerCurve = kCACornerCurveContinuous;
    surface.layer.masksToBounds = YES;
    surface.alpha = 0.0;
    [host addSubview:surface];
    gERConnectivityTransitionSurface = surface;
    [host addSubview:snapshot];
    gERConnectivityExpandedTransitionSnapshot = snapshot;
    controller.view.hidden = YES;
    controller.view.alpha = 0.0;
    controller.view.layer.opacity = 0.0;
    ERSuppressConnectivityLiveChildren(controller);

    CGRect compactHostFrame = gERConnectivityHasCompactWindowFrame
        ? ERConnectivityHostFrameForScreenRect(host, gERConnectivityCompactWindowFrame)
        : CGRectNull;
    CGRect surfaceTargetFrame = CGRectIsNull(compactHostFrame) ? surface.frame : compactHostFrame;
    if (gERConnectivityCachedCompactImage && !CGRectIsNull(compactHostFrame)) {
        UIImageView *compactSnapshot = [[UIImageView alloc] initWithImage:gERConnectivityCachedCompactImage];
        compactSnapshot.contentMode = UIViewContentModeScaleToFill;
        compactSnapshot.frame = compactHostFrame;
        compactSnapshot.layer.cornerRadius = 30.0;
        compactSnapshot.layer.cornerCurve = kCACornerCurveContinuous;
        compactSnapshot.layer.masksToBounds = YES;
        compactSnapshot.alpha = 0.0;
        compactSnapshot.userInteractionEnabled = NO;
        [host addSubview:compactSnapshot];
        gERConnectivityCompactTransitionSnapshot = compactSnapshot;
    }
    NSTimeInterval duration = MIN(0.62, MAX(0.56, ERConnectivityTransitionDuration(presented) + 0.18));
    gERConnectivityClosingTransitionDeadline = CACurrentMediaTime() + duration;
    [UIView animateKeyframesWithDuration:duration delay:0.0
                                options:UIViewKeyframeAnimationOptionCalculationModeCubic | UIViewAnimationOptionCurveEaseInOut |
                                        UIViewAnimationOptionBeginFromCurrentState
                             animations:^{
        [UIView addKeyframeWithRelativeStartTime:0.0 relativeDuration:0.58 animations:^{
            snapshot.alpha = 0.0;
            // The expanded menu lifts very slightly as it fades, matching the
            // later Control Center transition instead of sinking downward.
            snapshot.transform = CGAffineTransformMakeTranslation(0.0, -10.0);
        }];
        [UIView addKeyframeWithRelativeStartTime:0.08 relativeDuration:0.24 animations:^{
            surface.alpha = 0.78;
        }];
        [UIView addKeyframeWithRelativeStartTime:0.12 relativeDuration:0.82 animations:^{
            surface.frame = surfaceTargetFrame;
            surface.layer.cornerRadius = gERConnectivityCompactCornerRadius;
            surface.alpha = 1.0;
        }];
        [UIView addKeyframeWithRelativeStartTime:0.48 relativeDuration:0.46 animations:^{
            gERConnectivityCompactTransitionSnapshot.alpha = 1.0;
        }];
    } completion:^(__unused BOOL finished) {
        if (generation != gERConnectivityTransitionGeneration) return;
        // didCloseExpandedModule performs the compact handoff.  Keep the
        // transparent transition host alive until then so UIKit's reused child
        // hierarchy never becomes visible in its intermediate frames.
    }];
}

static void ERFinishConnectivityClosingTransition(UIViewController *controller) {
    UIViewController *target = gERConnectivityCompactController ?: controller ?: gERConnectivityTransitionController;
    CFTimeInterval remaining = gERConnectivityClosingTransitionDeadline - CACurrentMediaTime();
    if (gERConnectivityClosingTransitionActive && remaining > 0.01 && !gERConnectivityClosingFinishScheduled) {
        gERConnectivityClosingFinishScheduled = YES;
        __weak UIViewController *weakTarget = target;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(remaining * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            gERConnectivityClosingFinishScheduled = NO;
            ERFinishConnectivityClosingTransition(weakTarget);
        });
        return;
    }
    if (!target || !target.view) {
        ERRemoveConnectivityTransitionVisuals(NO);
        gERConnectivityTransitionController = nil;
        gERConnectivityCompactController = nil;
        return;
    }
    [UIView performWithoutAnimation:^{
        target.view.hidden = YES;
        target.view.alpha = 0.0;
        target.view.layer.opacity = 0.0;
        ERConfigureConnectivityLayout(target);
        [target.view setNeedsLayout];
        [target.view layoutIfNeeded];
        target.view.hidden = NO;
        target.view.alpha = 1.0;
        target.view.layer.opacity = 1.0;
    }];
    // Keep the populated compact still above the restored live module for a
    // few frames. This masks the final UIKit child reparent/layout pass and
    // turns the previous blank-frame -> full-opacity snap into a real handoff
    // between two identical populated states.
    UIView *compactSnapshot = gERConnectivityCompactTransitionSnapshot;
    if (compactSnapshot) {
        [UIView animateWithDuration:0.16 delay:0.02
                            options:UIViewAnimationOptionCurveEaseOut | UIViewAnimationOptionBeginFromCurrentState
                         animations:^{ compactSnapshot.alpha = 0.0; }
                         completion:^(__unused BOOL finished) {
            ERRemoveConnectivityTransitionVisuals(NO);
            gERConnectivityTransitionController = nil;
            gERConnectivityCompactController = nil;
        }];
    } else {
        ERRemoveConnectivityTransitionVisuals(NO);
        gERConnectivityTransitionController = nil;
        gERConnectivityCompactController = nil;
    }
}

static void ERApplyExpandedPlatterRadius(UIPresentationController *presentationController) {
    UIViewController *anchor = nil;
    @try { anchor = [(id)presentationController valueForKey:@"anchoringViewController"]; } @catch (__unused NSException *exception) {}
    if (!anchor) {
        @try { anchor = [(id)presentationController valueForKey:@"_anchoringViewController"]; } @catch (__unused NSException *exception) {}
    }
    CGFloat radius = 0.0;
    if (gEnabled && anchor.view) {
        radius = [[EchoRebornCoordinator shared] refinedCornerRadiusForSize:anchor.view.bounds.size];
        [[EchoRebornCoordinator shared] applyTransitionRadiusToModule:anchor];
    }
    if (radius <= 1.0) radius = anchor.view.layer.cornerRadius;
    for (UIView *view = anchor.view.superview; radius <= 1.0 && view; view = view.superview) radius = view.layer.cornerRadius;
    if (radius <= 1.0) radius = 32.0;

    UIView *presentedView = presentationController.presentedView;
    UIView *contentView = presentationController.presentedViewController.view;
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    for (UIView *target in @[presentedView ?: (id)NSNull.null, contentView ?: (id)NSNull.null]) {
        if (![target isKindOfClass:[UIView class]]) continue;
        target.layer.cornerRadius = radius;
        target.layer.cornerCurve = kCACornerCurveContinuous;
        // Expanded connectivity and menu content intentionally reaches beyond
        // intermediate controller bounds. Never clip those presentation hosts.
        target.layer.masksToBounds = NO;
    }

    // Round only matching material surfaces; these own the visible platter
    // fill and can safely mask their own effect without clipping child content.
    NSMutableArray<UIView *> *queue = [NSMutableArray array];
    if (contentView) [queue addObjectsFromArray:contentView.subviews];
    while (queue.count) {
        UIView *candidate = queue.firstObject;
        [queue removeObjectAtIndex:0];
        NSString *name = NSStringFromClass(candidate.class);
        BOOL material = [name containsString:@"Material"] || [name containsString:@"VisualEffect"] || [name containsString:@"Platter"];
        BOOL fillsContent = fabs(CGRectGetWidth(candidate.bounds) - CGRectGetWidth(contentView.bounds)) < 4.0 &&
                            fabs(CGRectGetHeight(candidate.bounds) - CGRectGetHeight(contentView.bounds)) < 4.0;
        if (material && fillsContent) {
            candidate.layer.cornerRadius = radius;
            candidate.layer.cornerCurve = kCACornerCurveContinuous;
            candidate.layer.masksToBounds = YES;
        }
        [queue addObjectsFromArray:candidate.subviews];
    }
    [CATransaction commit];
    ERSuppressConnectivityOuterMaterial(presentationController);
}

%hook CCUIContentModuleDetailPresentationController

- (double)_preferredExpandedContentHeightForViewController:(UIViewController *)viewController {
    double original = %orig;
    if (!gEnabled || !ERIsConnectivityExpandedController(viewController)) return original;
    CGFloat width = CGRectGetWidth(viewController.view.bounds);
    SEL widthSelector = NSSelectorFromString(@"_preferredExpandedContentWidthForViewController:");
    if (width < 100.0 && [(id)self respondsToSelector:widthSelector]) {
        width = ((double (*)(id, SEL, id))objc_msgSend)((id)self, widthSelector, viewController);
    }
    if (width < 100.0) width = CGRectGetWidth(UIScreen.mainScreen.bounds) * 0.856;
    ERConnectivityExpandedMetrics metrics = ERConnectivityMetricsForWidth(width);
    UIEdgeInsets safeInsets = viewController.view.window.safeAreaInsets;
    CGFloat availableHeight = CGRectGetHeight(UIScreen.mainScreen.bounds) - safeInsets.top - safeInsets.bottom - 48.0;
    return MIN(metrics.contentHeight, availableHeight);
}

- (void)presentationTransitionWillBegin {
    ERApplyExpansionPageGeometrySync(gOverlayControllers.allObjects.firstObject);
    %orig;
    ERApplyExpandedPlatterRadius((UIPresentationController *)(id)self);
}

- (void)containerViewWillLayoutSubviews {
    %orig;
    ERApplyExpandedPlatterRadius((UIPresentationController *)(id)self);
}

- (void)containerViewDidLayoutSubviews {
    %orig;
    ERApplyExpandedPlatterRadius((UIPresentationController *)(id)self);
}

- (void)dismissalTransitionWillBegin {
    // Set the final continuous radius before UIKit captures the first collapse
    // frame; applying it only during layout caused the visible radius snap.
    ERPrepareOverlayChromeForExpandedDismissal(gOverlayControllers.allObjects.firstObject);
    ERApplyExpandedPlatterRadius((UIPresentationController *)(id)self);
    %orig;
    ERApplyExpandedPlatterRadius((UIPresentationController *)(id)self);
}

%end


%hook CCUIContentModuleContainerPresentationController

- (void)containerViewWillLayoutSubviews {
    %orig;
    ERConfigureConnectivityPresentationContainer((UIPresentationController *)(id)self);
}

- (void)containerViewDidLayoutSubviews {
    %orig;
    ERConfigureConnectivityPresentationContainer((UIPresentationController *)(id)self);
}

- (void)presentationTransitionWillBegin {
    UIPresentationController *presentation = (UIPresentationController *)(id)self;
    ERApplyExpansionPageGeometrySync(gOverlayControllers.allObjects.firstObject);
    // Preflight the custom height/masks before Apple's animator captures its
    // initial frame, then reassert after it installs the transition hierarchy.
    ERConfigureConnectivityPresentationContainer(presentation);
    %orig;
    ERConfigureConnectivityPresentationContainer(presentation);
}

- (void)presentationTransitionDidEnd:(BOOL)completed {
    %orig;
    UIPresentationController *presentation = (UIPresentationController *)(id)self;
    if (!completed || !gERConnectivityExpansionActive || gERConnectivityOpeningRevealStarted) return;
    // Apple's child controllers do not reach their final model frames until
    // the native presentation completes. Capturing earlier simply freezes the
    // fly-out geometry. Build our flattened card pane only from this settled
    // hierarchy, while the compact still continues to cover the native UI.
    ERConfigureConnectivityPresentationContainer(presentation);
    ERApplyExpandedPlatterRadius(presentation);
    if (gERConnectivityProxyExpansionActive) {
        UIViewController *connectivity = ERConnectivityChild(presentation.presentedViewController, @"CCUIConnectivityModuleViewController");
        if ([NSStringFromClass(presentation.presentedViewController.class) isEqualToString:@"CCUIConnectivityModuleViewController"]) {
            connectivity = presentation.presentedViewController;
        }
        if (connectivity) ERRestoreConnectivityPresentedSurface(presentation, connectivity);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            EROpenPendingConnectivityDetailFromPresentation(presentation);
        });
        return;
    }
    dispatch_async(dispatch_get_main_queue(), ^{
        ERConfigureConnectivityPresentationContainer(presentation);
        ERStartConnectivityOpeningReveal(presentation);
    });
}

    - (void)dismissalTransitionWillBegin {
        UIPresentationController *presentation = (UIPresentationController *)(id)self;
        ERPrepareOverlayChromeForExpandedDismissal(gOverlayControllers.allObjects.firstObject);
        if (!gERConnectivityProxyExpansionActive) ERBeginConnectivityClosingTransition(presentation);
        %orig;
    }

%end

%end

%group ERExpandedModuleCallbacks

static UIViewController *ERCompactMediaModuleForSource(UIViewController *overlay, id sourceObject) {
    NSString *identifier = [ERIdentifierFromObject(sourceObject) copy];
    BOOL sourceIsMedia = [NSStringFromClass([sourceObject class]) isEqualToString:@"MediaControlsModule"];
    if (identifier.length &&
        ![identifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"] &&
        !sourceIsMedia) return nil;

    UIViewController *module = nil;
    SEL contentControllerSelector = NSSelectorFromString(@"contentViewController");
    if (sourceIsMedia && [sourceObject respondsToSelector:contentControllerSelector]) {
        @try {
            id candidate = ((id (*)(id, SEL))objc_msgSend)(sourceObject, contentControllerSelector);
            if ([candidate isKindOfClass:[UIViewController class]]) module = candidate;
        } @catch (__unused NSException *exception) {}
    }
    if (!module) module = ERModuleControllerMatchingObject(overlay, sourceObject);
    if (!module) {
        for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
            NSString *candidateIdentifier = ERModuleIdentifier(candidate);
            if ((identifier.length && [candidateIdentifier isEqualToString:identifier]) ||
                (sourceIsMedia && [candidateIdentifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"])) {
                module = candidate;
                break;
            }
        }
    }
    if (!module) return nil;
    if (!sourceIsMedia &&
        ![ERModuleIdentifier(module) isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"]) return nil;
    return module;
}


static void ERDiscardCompactMediaTransitionSnapshot(void) {
    [gERMediaCompactTransitionSnapshot.layer removeAllAnimations];
    [gERMediaExpandedTransitionSnapshot.layer removeAllAnimations];
    [gERMediaCompactTransitionSnapshot removeFromSuperview];
    [gERMediaExpandedTransitionSnapshot removeFromSuperview];
    [UIView performWithoutAnimation:^{
        gERMediaHiddenExpandedView.hidden = NO;
        gERMediaHiddenExpandedView.alpha = 1.0;
        gERMediaHiddenExpandedView.layer.opacity = 1.0;
    }];
    gERMediaCompactTransitionSnapshot = nil;
    gERMediaExpandedTransitionSnapshot = nil;
    gERMediaHiddenExpandedView = nil;
    gERMediaCompactModule = nil;
    gERMediaCompactDestinationScreenFrame = CGRectZero;
    gERMediaExpandedPresentationScreenFrame = CGRectZero;
    gERMediaTransitionWindow.hidden = YES;
    gERMediaTransitionWindow.rootViewController = nil;
    gERMediaTransitionWindow = nil;
    gERMediaTransitionHost = nil;
}

static UIView *ERMediaTransitionHostForWindow(UIWindow *sourceWindow) {
    if (!sourceWindow) return nil;
    if (gERMediaTransitionHost.superview) {
        gERMediaTransitionWindow.windowLevel = MAX(gERMediaTransitionWindow.windowLevel,
                                                    sourceWindow.windowLevel + 100.0);
        gERMediaTransitionWindow.hidden = NO;
        return gERMediaTransitionHost;
    }
    UIWindow *window = nil;
    if (@available(iOS 13.0, *)) {
        if (sourceWindow.windowScene) window = [[UIWindow alloc] initWithWindowScene:sourceWindow.windowScene];
    }
    if (!window) window = [[UIWindow alloc] initWithFrame:UIScreen.mainScreen.bounds];
    window.frame = UIScreen.mainScreen.bounds;
    window.backgroundColor = UIColor.clearColor;
    window.opaque = NO;
    window.userInteractionEnabled = NO;
    window.windowLevel = MAX(UIWindowLevelAlert + 100.0, sourceWindow.windowLevel + 100.0);
    UIViewController *root = [UIViewController new];
    root.view.frame = window.bounds;
    root.view.backgroundColor = UIColor.clearColor;
    root.view.opaque = NO;
    root.view.userInteractionEnabled = NO;
    root.view.clipsToBounds = NO;
    window.rootViewController = root;
    window.hidden = NO;
    gERMediaTransitionWindow = window;
    gERMediaTransitionHost = root.view;
    return root.view;
}

static UIView *ERCompositedSnapshotView(UIView *view) {
    if (!view || CGRectIsEmpty(view.bounds)) return nil;
    UIGraphicsBeginImageContextWithOptions(view.bounds.size, NO, UIScreen.mainScreen.scale);
    BOOL drewHierarchy = [view drawViewHierarchyInRect:view.bounds afterScreenUpdates:NO];
    if (!drewHierarchy) [view.layer renderInContext:UIGraphicsGetCurrentContext()];
    UIImage *image = UIGraphicsGetImageFromCurrentImageContext();
    UIGraphicsEndImageContext();
    if (!image) return nil;
    UIImageView *snapshot = [[UIImageView alloc] initWithImage:image];
    snapshot.frame = view.bounds;
    snapshot.contentMode = UIViewContentModeScaleToFill;
    snapshot.userInteractionEnabled = NO;
    return snapshot;
}

static UIView *ERWindowCropSnapshotView(UIView *view) {
    UIWindow *window = view.window;
    if (!window || CGRectIsEmpty(view.bounds)) return nil;
    CGRect crop = [view convertRect:view.bounds toView:window];
    UIView *snapshot = ERWindowCropSnapshotForWindowRect(window, crop);
    snapshot.frame = view.bounds;
    return snapshot;
}

static UIView *ERWindowCropSnapshotForWindowRect(UIWindow *window, CGRect crop) {
    if (!window || CGRectIsEmpty(crop)) return nil;
    UIGraphicsBeginImageContextWithOptions(crop.size, NO, UIScreen.mainScreen.scale);
    CGContextRef context = UIGraphicsGetCurrentContext();
    CGContextTranslateCTM(context, -crop.origin.x, -crop.origin.y);
    BOOL drewHierarchy = [window drawViewHierarchyInRect:window.bounds afterScreenUpdates:YES];
    if (!drewHierarchy) [window.layer renderInContext:context];
    UIImage *image = UIGraphicsGetImageFromCurrentImageContext();
    UIGraphicsEndImageContext();
    if (!image) return nil;

    UIImageView *snapshot = [[UIImageView alloc] initWithImage:image];
    snapshot.frame = crop;
    snapshot.contentMode = UIViewContentModeScaleToFill;
    snapshot.userInteractionEnabled = NO;
    return snapshot;
}

static void ERRefreshSettledCompactMediaSnapshot(UIViewController *overlay) {
    if (!overlay || gERExpandedModuleOpen || gERExpandedModuleClosingActive || gEditModeActive) return;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - gERMediaCompactSnapshotRefreshTime < 0.25) return;

    UIViewController *module = ERConnectivityChild(overlay, @"MRUControlCenterViewController");
    UIView *compactSurface = module.view.superview ?: module.view;
    CGSize size = compactSurface.bounds.size;
    if (!module.view.window || size.width < 40.0 || size.height < 40.0 ||
        size.width > 350.0 || size.height > 300.0) return;

    [compactSurface layoutIfNeeded];
    UIView *snapshot = ERWindowCropSnapshotView(compactSurface);
    if (!snapshot) snapshot = ERCompositedSnapshotView(compactSurface);
    if (!snapshot) snapshot = [compactSurface snapshotViewAfterScreenUpdates:YES];
    if (!snapshot) return;
    snapshot.userInteractionEnabled = NO;
    snapshot.layer.cornerRadius = compactSurface.layer.cornerRadius;
    snapshot.layer.cornerCurve = kCACornerCurveContinuous;
    snapshot.layer.masksToBounds = YES;

    [gERMediaCompactTransitionSnapshot removeFromSuperview];
    gERMediaCompactTransitionSnapshot = snapshot;
    gERMediaCompactModule = module;
    gERMediaCompactDestinationScreenFrame = [compactSurface convertRect:compactSurface.bounds toView:nil];
    gERMediaCompactSnapshotRefreshTime = now;
}

static void ERCaptureCompactMediaTransitionSnapshot(UIViewController *overlay, id sourceObject) {
    ERDiscardCompactMediaTransitionSnapshot();
    UIViewController *module = ERCompactMediaModuleForSource(overlay, sourceObject);
    if (!module.view || !module.view.window) return;
    UIView *compactSurface = module.view.superview ?: module.view;
    [compactSurface layoutIfNeeded];
    UIView *snapshot = ERCompositedSnapshotView(compactSurface);
    if (!snapshot) snapshot = [compactSurface snapshotViewAfterScreenUpdates:NO];
    if (!snapshot) {
        snapshot = [compactSurface resizableSnapshotViewFromRect:compactSurface.bounds
                                              afterScreenUpdates:NO
                                                   withCapInsets:UIEdgeInsetsZero];
    }
    if (!snapshot) return;
    snapshot.userInteractionEnabled = NO;
    snapshot.layer.cornerRadius = compactSurface.layer.cornerRadius;
    snapshot.layer.cornerCurve = kCACornerCurveContinuous;
    snapshot.layer.masksToBounds = YES;
    gERMediaCompactModule = module;
    gERMediaCompactTransitionSnapshot = snapshot;
    gERMediaCompactDestinationScreenFrame = [compactSurface convertRect:compactSurface.bounds toView:nil];
}

static void ERBeginCompactMediaDismissalProxy(UIViewController *overlay, id sourceObject) {
    UIViewController *module = gERMediaCompactModule ?: ERCompactMediaModuleForSource(overlay, sourceObject);
    if (module) gERMediaCompactModule = module;
    if (!overlay.view || !module) return;

    UIViewController *presented = overlay.presentedViewController;
    UIView *presentedView = presented.view;
    UIWindow *sourceWindow = presentedView.window ?: overlay.view.window;
    UIView *host = ERMediaTransitionHostForWindow(sourceWindow);
    if (!host) return;
    CGRect currentDestinationScreenFrame = [module.view convertRect:module.view.bounds toView:nil];
    if (!CGRectIsEmpty(currentDestinationScreenFrame)) {
        gERMediaCompactDestinationScreenFrame = currentDestinationScreenFrame;
    }
    CGRect presentedScreenFrame = presentedView.window ?
        [presentedView convertRect:presentedView.bounds toView:nil] : gERMediaCompactDestinationScreenFrame;
    gERMediaExpandedPresentationScreenFrame = presentedScreenFrame;

    UIView *presentationSurface = presented.presentationController.containerView ?: presentedView;
    CGRect surfaceScreenFrame = presentationSurface.window ?
        [presentationSurface convertRect:presentationSurface.bounds toView:nil] : presentedScreenFrame;
    CGRect surfaceHostFrame = [host convertRect:surfaceScreenFrame fromView:nil];
    UIView *expandedSnapshot = [presentationSurface snapshotViewAfterScreenUpdates:NO];
    if (!expandedSnapshot) {
        expandedSnapshot = [presentationSurface resizableSnapshotViewFromRect:presentationSurface.bounds
                                                           afterScreenUpdates:NO
                                                                withCapInsets:UIEdgeInsetsZero];
    }
    if (expandedSnapshot) {
        expandedSnapshot.frame = surfaceHostFrame;
        expandedSnapshot.userInteractionEnabled = NO;
        [host addSubview:expandedSnapshot];
        gERMediaExpandedTransitionSnapshot = expandedSnapshot;
    }
}

static void ERFadeExpandedMediaDismissalSnapshot(void) {
    UIView *expandedSnapshot = gERMediaExpandedTransitionSnapshot;
    UIView *compactSnapshot = gERMediaCompactTransitionSnapshot;
    if (!expandedSnapshot && !compactSnapshot) return;
    [UIView animateWithDuration:0.13 delay:0.0
                        options:UIViewAnimationOptionCurveEaseOut | UIViewAnimationOptionBeginFromCurrentState
                     animations:^{
        expandedSnapshot.alpha = 0.0;
        compactSnapshot.alpha = 1.0;
    } completion:^(__unused BOOL finished) {
        [expandedSnapshot removeFromSuperview];
        if (gERMediaExpandedTransitionSnapshot == expandedSnapshot) {
            gERMediaExpandedTransitionSnapshot = nil;
        }
    }];
}

static void ERAttachCompactMediaSnapshotToNativeTransition(void) {
    UIViewController *module = gERMediaCompactModule;
    UIView *snapshot = gERMediaCompactTransitionSnapshot;
    UIView *contentContainer = module.view.superview;
    if (!module.view || !snapshot || !contentContainer) return;

    [snapshot removeFromSuperview];
    snapshot.frame = contentContainer.bounds;
    snapshot.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    snapshot.alpha = 0.0;
    [contentContainer addSubview:snapshot];
    [contentContainer bringSubviewToFront:snapshot];
    [UIView performWithoutAnimation:^{
        module.view.alpha = 0.0;
        module.view.layer.opacity = 0.0;
    }];
}

static void ERRestoreCompactMediaLayout(UIViewController *overlay, id sourceObject, BOOL applyEchoRebornLayout) {
    UIViewController *module = ERCompactMediaModuleForSource(overlay, sourceObject);
    if (!module) return;

    UIViewController *mediaController = ERConnectivityChild(module, @"MRUControlCenterViewController");
    if (!mediaController && [NSStringFromClass(module.class) isEqualToString:@"MRUControlCenterViewController"]) {
        mediaController = module;
    }
    if (!mediaController) return;

    SEL transitionSelector = NSSelectorFromString(@"didTransitionToExpandedContentMode:");
    if ([mediaController respondsToSelector:transitionSelector]) {
        ((void (*)(id, SEL, BOOL))objc_msgSend)((id)mediaController, transitionSelector, NO);
    }
    SEL updateSelector = NSSelectorFromString(@"updateNowPlayingViewControllerLayout");
    if ([mediaController respondsToSelector:updateSelector]) {
        ((void (*)(id, SEL))objc_msgSend)((id)mediaController, updateSelector);
    }

    UIViewController *nowPlayingController = nil;
    @try {
        id candidate = [(id)mediaController valueForKey:@"nowPlayingViewController"];
        if ([candidate isKindOfClass:[UIViewController class]]) nowPlayingController = candidate;
    } @catch (__unused NSException *exception) {}
    SEL setLayoutSelector = NSSelectorFromString(@"setLayout:");
    if ([nowPlayingController respondsToSelector:setLayoutSelector]) {
        ((void (*)(id, SEL, NSInteger))objc_msgSend)((id)nowPlayingController, setLayoutSelector, 0);
    }
    SEL updateLayoutSelector = NSSelectorFromString(@"updateLayout");
    if ([nowPlayingController respondsToSelector:updateLayoutSelector]) {
        ((void (*)(id, SEL))objc_msgSend)((id)nowPlayingController, updateLayoutSelector);
    }

    [mediaController.view setNeedsLayout];
    [mediaController.view layoutIfNeeded];
    UIView *nowPlayingView = ERFindSubviewWithClassName(mediaController.view, @"MRUNowPlayingView");
    if (nowPlayingView) {
        if ([nowPlayingView respondsToSelector:setLayoutSelector]) {
            ((void (*)(id, SEL, NSInteger))objc_msgSend)((id)nowPlayingView, setLayoutSelector, 0);
        }
        [nowPlayingView setNeedsLayout];
        [nowPlayingView layoutIfNeeded];
        if (!applyEchoRebornLayout) {
            return;
        }
        objc_setAssociatedObject(nowPlayingView, kERNowPlayingLayoutModeKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
        [nowPlayingView setNeedsLayout];
        [nowPlayingView layoutIfNeeded];
        ERConfigureNowPlayingLayout(nowPlayingView);
    }
    if (applyEchoRebornLayout) {
        UIView *snapshot = gERMediaCompactTransitionSnapshot.superview ?
            gERMediaCompactTransitionSnapshot : nil;
        ERStopConnectivitySubviewAnimations(module.view, YES);
        [module.view setNeedsLayout];
        [module.view layoutIfNeeded];
        [UIView performWithoutAnimation:^{
            module.view.hidden = NO;
            module.view.alpha = 1.0;
            module.view.layer.opacity = 1.0;
        }];
        // MediaRemote finishes rebuilding several compact-only material and
        // control layers just after the container lands. Keep the already
        // landed compact proxy above it for two turns, then hand off in place.
        [UIView animateWithDuration:0.14 delay:0.08
                            options:UIViewAnimationOptionCurveEaseOut | UIViewAnimationOptionBeginFromCurrentState
                         animations:^{
            snapshot.alpha = 0.0;
        } completion:^(__unused BOOL finished) {
            ERDiscardCompactMediaTransitionSnapshot();
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)),
                           dispatch_get_main_queue(), ^{
                ERRefreshSettledCompactMediaSnapshot(overlay);
            });
        }];
    }
}

%hook CCUIModularControlCenterOverlayViewController

- (void)moduleCollectionViewController:(id)collection willOpenExpandedModule:(id)module {
    if (gEnabled && (gEditModeActive || gEREditTransitionActive)) {
        gERExpandedModuleOpen = NO;
        gERConnectivityExpansionActive = NO;
        gERExpandedModuleIdentifier = nil;
        ERHaptic();
        return;
    }
    UIViewController *overlay = (UIViewController *)(id)self;
    // Never begin an expansion on top of stale transition state from an
    // earlier one that didn't finish its choreography.
    if (!gERExpandedModuleOpen &&
        (gERConnectivityTransitionWindow || gERConnectivityTransitionHost ||
         gERConnectivityClosingTransitionActive || gERConnectivityExpansionActive)) {
        ERResetConnectivityExpansionState(overlay);
    }
    UIViewController *expandedController = ERModuleControllerMatchingObject(overlay, module);
    if (!expandedController && [module isKindOfClass:[UIViewController class]]) expandedController = (UIViewController *)module;
    UIViewController *connectivity = expandedController ? ERConnectivityChild(expandedController, @"CCUIConnectivityModuleViewController") : nil;
    if ([NSStringFromClass(expandedController.class) isEqualToString:@"CCUIConnectivityModuleViewController"]) connectivity = expandedController;
    NSString *openingIdentifier = [ERModuleIdentifier(expandedController) copy] ?: [ERIdentifierFromObject(module) copy];
    BOOL openingMedia = [openingIdentifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"] ||
        [NSStringFromClass([module class]) isEqualToString:@"MediaControlsModule"];
    if (openingMedia) {
        if (!gERMediaCompactTransitionSnapshot || !gERMediaCompactModule ||
            gERMediaCompactTransitionSnapshot.superview) {
            ERCaptureCompactMediaTransitionSnapshot(overlay, module);
        }
    }
    // rangeOfString on a NIL identifier returns a zeroed range whose location
    // (0) is NOT NSNotFound — every identifier-less expansion (flashlight,
    // brightness, media, …) was misclassified as connectivity, inheriting the
    // six-card platter sizing (the chin) and its snapshot choreography that
    // hides platter materials until respring.
    BOOL openingConnectivity = connectivity != nil ||
        (openingIdentifier.length &&
         [openingIdentifier rangeOfString:@"Connectivity" options:NSCaseInsensitiveSearch].location != NSNotFound);
    ERApplyExpansionPageGeometrySync(overlay);
    // Capture the settled compact hierarchy before resetting any of its proxy
    // controls.  The still image remains fixed while UIKit reparents and moves
    // the real child views invisibly underneath it.
    BOOL proxyConnectivityExpansion = openingConnectivity && gERConnectivityProxyExpansionActive && gERConnectivityHasProxySourceFrame;
    if (openingConnectivity && connectivity && !proxyConnectivityExpansion) ERBeginConnectivityOpeningTransition(connectivity);
    // Remove the compact mini-cluster transforms before Apple's expansion
    // transition asks the children for their new frames. UIKit otherwise lays
    // out through the 0.44 transform and produces oversized expanded controls.
    if (connectivity) ERResetConnectivityCompactTransforms(connectivity);
    gERConnectivityExpansionActive = openingConnectivity;
    gERConnectivityProxyExpansionActive = proxyConnectivityExpansion;
    gERExpandedModuleClosingActive = NO;
    gERExpandedModuleOpen = YES;
    gERExpandedModuleIdentifier = openingIdentifier;
    if (openingConnectivity) {
        CGFloat expandedWidth = 0.0;
        SEL preferredWidthSelector = NSSelectorFromString(@"preferredExpandedContentWidth");
        if (connectivity && [(id)connectivity respondsToSelector:preferredWidthSelector]) {
            expandedWidth = ((double (*)(id, SEL))objc_msgSend)((id)connectivity, preferredWidthSelector);
        }
        if (expandedWidth < 250.0) expandedWidth = CGRectGetWidth(UIScreen.mainScreen.bounds) * 0.856;
        CGFloat expandedHeight = ERConnectivityMetricsForWidth(expandedWidth).contentHeight;
        CGSize preferredSize = CGSizeMake(expandedWidth, expandedHeight);
        if (connectivity) {
            connectivity.preferredContentSize = preferredSize;
            for (UIViewController *candidate = connectivity.parentViewController; candidate; candidate = candidate.parentViewController) {
                candidate.preferredContentSize = preferredSize;
                if (candidate == expandedController) break;
            }
        }
        if (expandedController) expandedController.preferredContentSize = preferredSize;
        if ([module isKindOfClass:[UIViewController class]]) ((UIViewController *)module).preferredContentSize = preferredSize;

    }
    EchoRebornCoordinator *coordinator = [EchoRebornCoordinator shared];
    [coordinator hideOwnedChromeForExpandedPlatterInOverlay:overlay];
    if (gEditModeActive) [coordinator dismissEditingImmediately];
    if (expandedController) [coordinator applyResizedPresentationToModule:expandedController];
    [coordinator setQuickAccessButtonsHidden:YES forOverlay:overlay animated:YES];
    %orig;
    if (openingConnectivity) {
        __weak UIViewController *weakOverlay = overlay;
        void (^applyLivePresentation)(BOOL) = ^(BOOL beginReveal) {
            UIViewController *strongOverlay = weakOverlay;
            UIViewController *presented = strongOverlay.presentedViewController;
            if (!presented) return;
            UIPresentationController *presentation = presented.presentationController;
            CGFloat width = CGRectGetWidth(presented.view.bounds);
            if (width < 250.0) width = CGRectGetWidth(UIScreen.mainScreen.bounds) * 0.856;
            CGSize preferred = CGSizeMake(width, ERConnectivityMetricsForWidth(width).contentHeight);
            presented.preferredContentSize = preferred;
            SEL changed = NSSelectorFromString(@"preferredContentSizeDidChangeForChildContentContainer:");
            if ([presentation respondsToSelector:changed]) ((void (*)(id, SEL, id))objc_msgSend)((id)presentation, changed, presented);
            [presentation.containerView setNeedsLayout];
            [presentation.containerView layoutIfNeeded];
            ERConfigureConnectivityPresentationContainer(presentation);
            ERApplyExpandedPlatterRadius(presentation);
            // The first pass establishes the final presentation geometry. Let
            // the child labeled controls complete another run-loop layout
            // before capturing the reveal image.
            if (beginReveal) ERStartConnectivityOpeningReveal(presentation);

        };
        // The presentation controller is normally available synchronously
        // after %orig. Suppress its stock backing before Core Animation commits
        // the first expansion frame; the next-turn pass remains as a fallback
        // for the oersional lazily-created presentation hierarchy.
        applyLivePresentation(NO);
        dispatch_async(dispatch_get_main_queue(), ^{
            applyLivePresentation(NO);
            // Keep laying out invisibly while UIKit presents. The transition
            // controller's presentationTransitionDidEnd: callback performs the
            // actual capture only after every child has reached final geometry.
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.035 * NSEC_PER_SEC)),
                           dispatch_get_main_queue(), ^{ applyLivePresentation(NO); });
        });
    }
    // Expansion reparents portions of the module hierarchy during the opening
    // transition. Reassert on the next turn so no edit ring or preview backing
    // survives behind the platter after that reparenting completes.
    dispatch_async(dispatch_get_main_queue(), ^{
        [coordinator hideOwnedChromeForExpandedPlatterInOverlay:overlay];
    });
}

- (void)moduleCollectionViewController:(id)collection didCloseExpandedModule:(id)module {
    UIViewController *overlay = (UIViewController *)(id)self;
    %orig;
    // Restore the selected page before clearing expanded state or updating any
    // overlay chrome. Deferring this to the next run-loop turn let page-zero
    // geometry render for one frame after every later-page dismissal.
    ERRestoreExpansionPageGeometrySync(overlay);
    NSTimeInterval erCollapseChromeStart = CACurrentMediaTime();
    NSString *closingIdentifier = [ERIdentifierFromObject(module) copy];
    BOOL closingMedia = [closingIdentifier isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"] ||
        [NSStringFromClass([module class]) isEqualToString:@"MediaControlsModule"];
    UIViewController *closingConnectivity = gERConnectivityTransitionController;
    gERExpandedModuleOpen = NO;
    gERExpandedModuleClosingActive = NO;
    gERConnectivityExpansionActive = NO;
    gERExpandedModuleIdentifier = nil;
    if (closingConnectivity) ERFinishConnectivityClosingTransition(closingConnectivity);
    EchoRebornCoordinator *coordinator = [EchoRebornCoordinator shared];
    UIView *pageIndicators = [overlay.view viewWithTag:kERPageIndicatorHostTag];
    if (pageIndicators) {
        objc_setAssociatedObject(pageIndicators, kERPageIndicatorDraggingKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        BOOL revealActive = ERExpandedChromeRevealActive();
        pageIndicators.hidden = gERPageCount <= 1 || !gERControlCenterPresented;
        if (!revealActive) pageIndicators.alpha = pageIndicators.hidden ? 0.0 : 1.0;
    }
    [coordinator setQuickAccessButtonsHidden:(gEditModeActive || !gERControlCenterPresented) forOverlay:overlay animated:!ERExpandedChromeRevealActive()];
    [coordinator updateTopFadeForOverlay:overlay presentationAlpha:gERControlCenterPresented ? 1.0 : 0.0];
    [coordinator animateOwnedDuplicateHostForOverlay:overlay presented:gERControlCenterPresented];
    for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
        [coordinator applyRefinedLookToModule:candidate];
        [coordinator applyTransitionRadiusToModule:candidate];
        // 1.0.7-4（第 3 条）：折叠退回后再对齐一次七个磁贴的白色选中底。
        //
        // 这条路径此前只重刷材质与圆角，没有重刷白底的 **frame**。展开态 / 编辑态期间
        // 白底已经被压成过一条 27pt 高的横条（见 ERConnectivitySurfaceFrameForModuleView
        // 的日志），折叠回来后它就一直留在那个尺寸上，表现为「退回去界面出现一些重叠」。
        // 该函数只在数值真变化时写入，稳态下是空操作，所以这里补一次没有额外开销。
        ERReassertConnectivitySelectedSurface(candidate.view);
    }
    // 1.0.7-5（第 3 条）：把这段收尾的耗时打出来。
    // 用户反馈「退回时卡顿一下」，而这一圈要遍历全部模块（实测 39 个）逐个重刷
    // 材质 + 圆角 + 白底，是整条路径上唯一的重活，且跑在主线程、正好压在折叠动画
    // 收尾的那一帧上（ERPERF 里紧随其后出现过 layout=16.30ms，刚好一帧）。
    // 先量出来再决定是减负还是挪到下一帧，不盲改。
    ERLogInfo(@"COLLAPSECHROME ver=1.0.9-103 modules=%lu cost=%.2fms",
              (unsigned long)ERCollectModuleControllers(overlay).count,
              (CACurrentMediaTime() - erCollapseChromeStart) * 1000.0);
    [coordinator updatePageIndicatorsForOverlay:overlay];
    if (gERExpansionHiddenLiveViews.count || gERExpansionExpandedSnapshot) {
        gERExpansionDismissalDidClose = YES;
        ERCompleteGenericExpansionDismissalIfReady();
    }
    dispatch_async(dispatch_get_main_queue(), ^{
        if (closingMedia) ERRestoreCompactMediaLayout(overlay, module, YES);
        [coordinator updatePageIndicatorsForOverlay:overlay];
    });
    // Give the legit closing choreography time to finish, then scrub any
    // leftover transition state so the next expansion starts clean.
    __weak UIViewController *weakOverlay = overlay;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (!gERExpandedModuleOpen) ERResetConnectivityExpansionState(weakOverlay);
    });
}

%end

%end

%group ERExpandedModuleWillCloseCallback

%hook CCUIModuleCollectionViewController

- (void)contentModuleContainerViewController:(id)container willCloseExpandedModule:(id)module {
    UIViewController *overlay = ((UIViewController *)(id)self).parentViewController;
    while (overlay && !ERIsOverlayController(overlay)) overlay = overlay.parentViewController;
    UIViewController *expandedController = overlay ? ERModuleControllerMatchingObject(overlay, module) : nil;
    // This concrete collection callback is guaranteed on iOS 16 even though
    // the overlay delegate does not implement its optional will-close method.
    UIViewController *containerController = [container isKindOfClass:[UIViewController class]] ? (UIViewController *)container : expandedController;
    if (overlay) ERApplyExpansionPageGeometrySync(overlay);
    gERExpandedModuleClosingActive = YES;
    if (overlay && !gERControlCenterPresented) {
        [[EchoRebornCoordinator shared] animateOwnedDuplicateHostForOverlay:overlay presented:NO];
    } else if (overlay) {
        [[EchoRebornCoordinator shared] animateOwnedDuplicateHostForOverlay:overlay presented:YES];
    }
    for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
        [[EchoRebornCoordinator shared] applyRefinedLookToModule:candidate];
        [[EchoRebornCoordinator shared] applyTransitionRadiusToModule:candidate];
    }
    if (expandedController) [[EchoRebornCoordinator shared] applyTransitionRadiusToModule:expandedController];
    if (containerController) [[EchoRebornCoordinator shared] applyTransitionRadiusToModule:containerController];
    if (expandedController) [[EchoRebornCoordinator shared] applyClosingCompactRadiusToModule:expandedController overlay:overlay sourceObject:module];
    if (containerController) [[EchoRebornCoordinator shared] applyClosingCompactRadiusToModule:containerController overlay:overlay sourceObject:module];
    if (overlay) [[EchoRebornCoordinator shared] setQuickAccessButtonsHidden:YES forOverlay:overlay animated:YES];
    if (overlay) [[EchoRebornCoordinator shared] updatePageIndicatorsForOverlay:overlay];
    BOOL closingMedia = [NSStringFromClass([module class]) isEqualToString:@"MediaControlsModule"] ||
        [[ERIdentifierFromObject(module) copy] isEqualToString:@"com.apple.mediaremote.controlcenter.nowplaying"];
    if (closingMedia && overlay) {
        // Freeze the expanded presentation exactly where it is, then return
        // the live hierarchy to compact layout before Apple's own reverse
        // transition starts. CCUI's animator retains ownership of the
        // anchor-to-grid geometry for every supported module size.
        ERBeginCompactMediaDismissalProxy(overlay, module);
        ERRestoreCompactMediaLayout(overlay, module, NO);
        ERAttachCompactMediaSnapshotToNativeTransition();
    }
    %orig;
    if (closingMedia && overlay) {
        ERFadeExpandedMediaDismissalSnapshot();
    }
    EchoRebornCoordinator *coordinator = [EchoRebornCoordinator shared];
    NSString *closingIdentifier = [ERModuleIdentifier(expandedController) copy] ?: [ERIdentifierFromObject(module) copy];
    // 1.0.6-12（第 4 条）：轮次从 8 降到 5。
    //
    // 每一轮都会对全部模块 + 容器各跑一次 applyRefinedLookToModule: /
    // applyTransitionRadiusToModule: / applyClosingCompactRadiusToModule:，而这三个函数
    // 各自都要遍历整棵子树。8 轮 = 单次收回动作约 24 次全子树扫描；配合上面已做的
    // 差量写入（圆角不变则不赋值）与连通性磁贴让路，这一处再压掉 37.5% 的扫描次数。
    // 时间覆盖（0 → 0.7s）与前半段密度保持不变，收回动画的圆角收敛不受影响。
    for (NSNumber *delay in @[@0.0, @0.08, @0.2, @0.4, @0.7]) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIViewController *settled = closingIdentifier.length ? nil : expandedController;
            for (UIViewController *candidate in ERCollectModuleControllers(overlay)) {
                if ([ERModuleIdentifier(candidate) isEqualToString:closingIdentifier]) { settled = candidate; break; }
            }
            if (settled) {
                [coordinator applyRefinedLookToModule:settled];
                [coordinator applyTransitionRadiusToModule:settled];
                [coordinator applyClosingCompactRadiusToModule:settled overlay:overlay sourceObject:module];
            }
            if (containerController.view.window) {
                [coordinator applyTransitionRadiusToModule:containerController];
                [coordinator applyClosingCompactRadiusToModule:containerController overlay:overlay sourceObject:module];
            }
        });
    }
}

%end

%end

// 1.0.7-11：相机双摄信号。Darwin 通知不携带数据，但**通知名本身**区分状态：
//   …/dualcam.heartbeat        = 相机进程里 DualCam 的 %ctor 跑过了（dylib 已加载）
//   …/dualcam.state.off        = 双摄开关被读成「关」
//   …/dualcam.state.notopbar   = 开关开着，但没在相机视图树里找到顶部栏
//   …/dualcam.state.installed  = 按钮已装上
// 之前连续五个版本都在盲猜，就是因为相机沙盒写不进日志、没有这条分界线。
static void ERDualCamHeartbeat(__unused CFNotificationCenterRef center, __unused void *observer, CFStringRef name, __unused const void *object, __unused CFDictionaryRef userInfo) {
    ERLogInfo(@"DUALCAM-SIGNAL ver=1.0.9-103 name=%@", (__bridge NSString *)name);
}

static void ERPrefsChanged(__unused CFNotificationCenterRef center, __unused void *observer, __unused CFStringRef name, __unused const void *object, __unused CFDictionaryRef userInfo) {
    ERLoadPrefs();
    // 0.5.5.0：被从控制中心移除的槽位释放绑定，槽位可以重新分配。控制中心没起来时跳过。
    if (gERControlCenterPresented) ERShortcutReconcileSlots();
    // 1.0.7-9：把「相机双摄」开关落成一个**标记文件**。
    // 相机 App 是沙盒进程，读 /var/mobile/Library/Preferences 里的偏好 plist 可能被拒
    // （1.0.7-5~8 实机一直没有按钮，最可能就是这个原因）。标记文件与共用日志同目录，
    // 相机侧 DualCamFeatureEnabled() 的第二级回退会读它。
    @try {
        NSString *directory = @"/var/mobile/Library/Logs/EchoReborn";
        [[NSFileManager defaultManager] createDirectoryAtPath:directory
                                  withIntermediateDirectories:YES
                                                   attributes:nil
                                                        error:nil];
        NSString *flagPath = [directory stringByAppendingPathComponent:@"dualcam_enabled"];
        BOOL on = ERPreferenceBool(@"DualCamEnabled", YES);
        NSString *flag = on ? @"1" : @"0";
        [flag writeToFile:flagPath atomically:YES encoding:NSUTF8StringEncoding error:nil];
        // 1.0.7-20：「小窗位置」（0 左上 / 1 右上 / 2 左下 / 3 右下）和开关一样要跨沙盒。
        // 相机进程读不到偏好域时，DualCamCornerValue() 的第二级回退就读这个文件。
        NSString *cornerPath = [directory stringByAppendingPathComponent:@"dualcam_corner"];
        NSInteger corner = (NSInteger)lround(ERPreferenceDouble(@"DualCam.Corner", 1.0));
        corner = MIN(3, MAX(0, corner));
        [[NSString stringWithFormat:@"%ld", (long)corner] writeToFile:cornerPath
                                                          atomically:YES
                                                            encoding:NSUTF8StringEncoding
                                                               error:nil];
    } @catch (__unused NSException *exception) {
    }
    dispatch_async(dispatch_get_main_queue(), ^{
        EchoRebornCoordinator *coordinator = [EchoRebornCoordinator shared];
        [coordinator setEditing:NO];
        for (UIViewController *overlay in gOverlayControllers.allObjects) {
            [coordinator installQuickAccessHostOnOverlay:overlay];
            BOOL hideQuickAccess = !gEnabled || !gQuickAccessButtonsEnabled || !gERControlCenterPresented || gERExpandedModuleOpen;
            [coordinator setQuickAccessButtonsHidden:hideQuickAccess forOverlay:overlay animated:NO];
            [coordinator installPagingOnOverlay:overlay];
            // 1.0.7-23：恢复横屏布局后，若控制中心正开着，立刻让整棵树重排一次。
            [overlay.view setNeedsLayout];
            for (UIViewController *module in ERCollectModuleControllers(overlay)) [coordinator applyRefinedLookToModule:module];
            // 切换液态玻璃后玻璃层可能被 GlassKit 移除，重新断言七个连通性磁贴的背景不变量。
            for (UIViewController *module in ERCollectModuleControllers(overlay)) {
                NSString *cid = ERModuleIdentifier(module);
                if ([cid.lowercaseString containsString:@"echoreborn.connectivity"])
                    ERSyncConnectivityTileChrome(module.view);
            }
        }
    });
}

// 槽位 bundle 的磁贴被点击了。bundle 已经把工作流 uuid 写进 ShortcutRunRequest 并
// 广播 RunShortcut；这里读回来，按 EvoCenter16 的方式运行（进程内，不前台化 App）。
static void ERShortcutRunRequested(__unused CFNotificationCenterRef center, __unused void *observer, __unused CFStringRef name, __unused const void *object, __unused CFDictionaryRef userInfo) {
    CFPropertyListRef request = CFPreferencesCopyAppValue((__bridge CFStringRef)kERShortcutRunRequestKey, kERPrefsDomain);
    if (!request) return;
    NSString *uuid = (__bridge_transfer NSString *)request;
    if (![uuid isKindOfClass:[NSString class]] || !uuid.length) return;
    NSString *runName = nil;
    for (NSDictionary *record in ERShortcutRecords()) {
        if ([record[@"uuid"] isKindOfClass:[NSString class]] && [record[@"uuid"] isEqualToString:uuid]) {
            runName = [record[@"name"] isKindOfClass:[NSString class]] ? record[@"name"] : nil;
            break;
        }
    }
    ERHaptic();
    id controller = gERSBControlCenterController;
    SEL dismissSelector = @selector(dismissAnimated:);
    if (controller && [controller respondsToSelector:dismissSelector]) {
        ((void (*)(id, SEL, BOOL))objc_msgSend)(controller, dismissSelector, NO);
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        ERRunShortcutInBackground(runName, uuid);
    });
}

static void ERShortcutRescanRequested(__unused CFNotificationCenterRef center, __unused void *observer, __unused CFStringRef name, __unused const void *object, __unused CFDictionaryRef userInfo) {
    dispatch_async(dispatch_get_main_queue(), ^{
        // 0.5.1: pull the pane's freshly written catalog into this process
        // before refreshing, otherwise the rescan re-reads the cached copy.
        CFPreferencesAppSynchronize(kERPrefsDomain);
        ERShortcutRefreshNow();
    });
}

// ---------------------------------------------------------------------------
// 1.0.4：更名（CCAster → Echo Reborn）遗留状态的一次性迁移
// ---------------------------------------------------------------------------
// 更名同时改了三样东西：
//   · 偏好域   com.futur3sn0w.ccaster.preferences  →  com.strive.echoreborn.preferences
//   · 快捷指令磁贴前缀 com.futur3sn0w.ccaster.shortcut.  →  com.strive.echoreborn.shortcut.
//   · 包标识 / 依赖 / 图标
//
// 但**用户已经配置好的东西仍然留在老域里**：gERDuplicateFamilies（自己添加或复制
// 出来的模块）与「显示控制项」清单。新版本只读新域，读到的就是空 —— 这就是
// 「更名之后快捷指令模块不显示了」最直接的那条成因：插件不知道那些磁贴归自己管，
// 既不登记、也不渲染。
//
// 这里做一次性搬迁：新域没有该键时，从老域取过来；顺带把清单里仍是老前缀的磁贴
// 标识符重写成新前缀。不去删除老域（保留回滚余地）。
static id ERMigratedValue(CFStringRef key) {
    CFPropertyListRef legacy = CFPreferencesCopyAppValue(key, kERLegacyPrefsDomain);
    if (!legacy) return nil;
    id value = (__bridge_transfer id)legacy;
    if ([value isKindOfClass:[NSArray class]]) {
        NSMutableArray *rewritten = [NSMutableArray array];
        for (id entry in (NSArray *)value) {
            [rewritten addObject:ERShortcutNormalizedIdentifier(entry)];
        }
        return rewritten;
    }
    if ([value isKindOfClass:[NSDictionary class]]) {
        NSMutableDictionary *rewritten = [NSMutableDictionary dictionary];
        [(NSDictionary *)value enumerateKeysAndObjectsUsingBlock:^(id innerKey, id innerValue, __unused BOOL *stop) {
            rewritten[ERShortcutNormalizedIdentifier(innerKey)] = ERShortcutNormalizedIdentifier(innerValue);
        }];
        return rewritten;
    }
    return value;
}

// 合并一份老域的值与一份新域的值：
//   · 数组 → 顺序去重的并集（老磁贴与新增磁贴都留下）
//   · 字典 → 逐键补齐，**新域已有的键优先**（用户在新版里的改动不被旧值覆盖）
//   · 其它 → 以新域为准
static id ERMergeLegacyValue(id current, id legacy) {
    if (!legacy) return current;
    if (!current) return legacy;
    if ([current isKindOfClass:[NSArray class]] && [legacy isKindOfClass:[NSArray class]]) {
        NSMutableArray *merged = [NSMutableArray arrayWithArray:(NSArray *)current];
        for (id entry in (NSArray *)legacy) {
            if (![merged containsObject:entry]) [merged addObject:entry];
        }
        return merged;
    }
    if ([current isKindOfClass:[NSDictionary class]] && [legacy isKindOfClass:[NSDictionary class]]) {
        NSMutableDictionary *merged = [NSMutableDictionary dictionaryWithDictionary:(NSDictionary *)current];
        [(NSDictionary *)legacy enumerateKeysAndObjectsUsingBlock:^(id innerKey, id innerValue, __unused BOOL *stop) {
            if (!merged[innerKey]) merged[innerKey] = innerValue;
        }];
        return merged;
    }
    return current;
}

// 1.0.5：把三份「插件自己的账本」也纳入迁移，并把「跳过」改成**幂等的并集合并**。
//
// 1.0.4 写的是「新域已经有值就不动它」。这在真机上几乎必然失效：只要用户装过
// 1.0.0 ~ 1.0.3 里的任意一版，并且在新版里点过任何一个开关、或者重新添加过一次
// 快捷指令，新域就**已经被写进了一部分内容**，于是整段搬迁被 continue 掉 ——
// 老域里真正完整的那份配置永远搬不过来。用户看到的现象就是「更名之后快捷指令一直
// 不显示，怎么弄都不回来」。
//
// 现在改成并集合并，并且**每次都跑**（幂等，合并不出重复）：数组取并集、字典逐键补齐。
// 同时把 ShortcutCatalog 与布局账本 ModuleGridOrigins / ModuleGridSizes 一起纳入，
// 老磁贴的图标与位置才能一并恢复。
static void ERMigrateRenamedPreferenceState(void) {
    NSArray<NSString *> *keys = @[@"COSMICDuplicateFamilies",
                                  @"ShortcutVisibleIdentifiers",
                                  @"ShortcutCatalog",
                                  @"ModuleGridOrigins",
                                  @"ModuleGridSizes"];
    for (NSString *key in keys) {
        CFStringRef cfKey = (__bridge CFStringRef)key;
        id legacy = ERMigratedValue(cfKey);
        if (!legacy) continue;
        CFPropertyListRef currentRef = CFPreferencesCopyAppValue(cfKey, kERPrefsDomain);
        id current = currentRef ? (__bridge_transfer id)currentRef : nil;
        id merged = ERMergeLegacyValue(current, legacy);
        if (!merged) continue;
        if (current && [merged isEqual:current]) continue;   // 已经包含老域内容，无需回写
        CFPreferencesSetAppValue(cfKey, (__bridge CFPropertyListRef)merged, kERPrefsDomain);
        ERLogRecord(@"INFO", [NSString stringWithFormat:@"migrate: merged %@ from the CCAster domain", key]);
    }
    CFPreferencesAppSynchronize(kERPrefsDomain);
}

// 1.0.5 起：把一份「以模块标识符为键」的字典就地归一化到当前前缀。
//
// 1.0.0 ~ 1.0.3 期间写进新域的键仍可能是老前缀（com.futur3sn0w.ccaster.shortcut.）。
// 不归一化的话，迁移的并集合并会把「老前缀的键」和「新前缀的键」同时留在表里，
// 于是一条快捷指令在「添加控制项」里出现两次。放在读盘之后、任何使用之前。
//
// 1.0.6：**值也要一起归一化**。COSMICDuplicateFamilies 的值本身就是标识符
// （快捷指令磁贴的 family 就是它自己），只改键不改值会留下「新前缀的键 →
// 老前缀的值」这种半迁移状态：图标与布局按新标识符查得到，family 解析却仍指向
// 老标识符，`gERBaseLayoutSizes` 之类的按 family 查表全部落空。键值同时归一化后
// 账本内部才自洽。
static void ERNormalizeIdentifierKeys(NSMutableDictionary *dictionary) {
    if (!dictionary.count) return;
    NSArray *existingKeys = [dictionary.allKeys copy];
    for (id key in existingKeys) {
        if (![key isKindOfClass:[NSString class]]) continue;
        NSString *normalized = ERShortcutNormalizedIdentifier((NSString *)key);
        id value = dictionary[key];
        if ([value isKindOfClass:[NSString class]]) {
            value = ERShortcutNormalizedIdentifier((NSString *)value);
        }
        if ([normalized isEqualToString:(NSString *)key]) {
            if (![value isEqual:dictionary[key]]) dictionary[key] = value;
            continue;
        }
        [dictionary removeObjectForKey:key];
        if (!dictionary[normalized]) dictionary[normalized] = value;
    }
}

// ---------------------------------------------------------------------------
// 1.0.7-14 · 主屏「快速添加」：长按任意图标 → 快捷菜单顶部出现「添加到文件夹」
// → 点选文件夹 → 图标移入。
//
// 实现路径**逐项对照 AddToFolder 1.4 的 ObjC 元数据**（用户提供的参考包），不猜：
//   · 注入：`-[SBIconView applicationShortcutItems]`（它的 selrefs 里有这个选择器），
//     把一个 SBSApplicationShortcutItem（type = com.strive.echoreborn.quickadd）
//     插到列表**顶部**；
//   · 响应：`-[SBIconController activateShortcut:withBundleIdentifier:forIconView:]`
//     里识别自己的 item（按 type），弹出文件夹选择（UIAlertController 动作面板，
//     AddToFolder 同款），确定后调用
//     `addIcons:intoFolderIcon:openFolderOnFinish:completion:`（旧系统退 …complete:）；
//   · 文件夹枚举：`iconModel.rootFolder` → `valueForKey:_folders` → 过滤 SBFolderIcon；
//   · 名称：设置页 `QuickAdd.ActionName`（默认「添加到文件夹」），实时读取；
//   · 开关：`QuickAdd.Enabled`，默认**关**（用户指定）。
// 全链路 @try：任何一步拿不到都不注入，长按菜单本身永远不受影响。
// ---------------------------------------------------------------------------
static NSString * const kERQuickAddItemType = @"com.strive.echoreborn.quickadd";

// 最小声明：这些是 SpringBoard 私有类，编译期只做类型检查（运行时用 %c/objc_msgSend）。
@interface SBIcon : NSObject
@end

@interface SBIconView : UIView
- (SBIcon *)icon;
@end

// ============================================================================
// 1.0.9-7 · iOS 26 风格「开合应用」动画（逆向参考 com.ngkhoi.26anim / 26Anim 1.0.3）
//
// 逆向结论（解包 + 符号扫描）：26Anim 是纯函数级 hook，只注入 SpringBoard，目标：
//   SBCrossfadeView / SBFullscreenZoomView / SBReusableSnapshotItemContainer
//   + _framesInAppSwitcher、setAlpha:、transform
//   + asTappedIcon / _g_lastTappedIconCenter（记录被点图标中心）
// 即：**以被点图标的中心为锚点，把应用窗口缩放展开/收起** —— iOS 26 的开合动画。
//
// 本模块同一思路实现（两套落点，缺哪个都不会崩）：
//   ① SBIconView 高亮时记录图标中心（窗口坐标）
//   ② SBFullscreenZoomView 首次布局：从该中心 scale 0.18 → 1、alpha 0 → 1
//   ③ SBCrossfadeView 首次布局：淡入
// iOS 17 上这些私有类若不存在，Logos 对该 hook 组整体跳过（安全）。
// ============================================================================
static BOOL ERAppZoom26Enabled(void) { return ERPreferenceBool(@"AppZoom26Enabled", NO); }
static CGFloat ERAppZoom26Duration(void) { return ERPreferenceBool(@"AppZoom26OriginalSpeed", NO) ? 0.55 : 0.42; }
static CGPoint gERZoomIconCenter = {0.0, 0.0};
static BOOL gERZoomHasIconCenter = NO;
static const void *kERZoomDidAnimateKey = &kERZoomDidAnimateKey;

@interface SBFullscreenZoomView : UIView
@end

@interface SBCrossfadeView : UIView
@end

%hook SBIconView
// 用 touchesBegan: 记录被点图标的中心（UIView 的既有方法，一定存在，比 setHighlighted: 稳）
- (void)touchesBegan:(NSSet *)touches withEvent:(UIEvent *)event {
    %orig;
    @try {
        if (!ERAppZoom26Enabled()) return;
        UIWindow *window = self.window;
        if (!window) return;
        CGPoint center = [self convertPoint:CGPointMake(CGRectGetMidX(self.bounds), CGRectGetMidY(self.bounds)) toView:window];
        gERZoomIconCenter = center;
        gERZoomHasIconCenter = YES;
    } @catch (__unused NSException *exception) {}
}
%end

%hook SBFullscreenZoomView
- (void)layoutSubviews {
    %orig;
    @try {
        if (!ERAppZoom26Enabled() || !gERZoomHasIconCenter) return;
        static CFTimeInterval gERZoomLastAt = 0.0;
        CFTimeInterval now = CACurrentMediaTime();
        if (now - gERZoomLastAt < 0.35) return;
        gERZoomLastAt = now;
        if (!self.window) return;
        CALayer *layer = self.layer;
        if (!layer) return;

        // 1.0.9-9 · **按参考插件（26Anim）的逻辑重做**：不再用 UIView 的 scale+alpha。
        //
        // 反汇编 26Anim 得到的证据：它导入的是
        //   meshTransformWithVertexCount:vertices:faceCount:faces:depthNormalization: / setMeshTransform:
        //   setDampingRatio: / setResponse:（CASpringAnimation 弹簧）
        //   displayLinkWithTarget:selector: / tick:（CADisplayLink 逐帧）
        //   setDisableActions: / setCornerCurve: / setSubTransform 类 —— 即**直接操作 layer**
        // 而 UIView 动画会被系统自己的布局/事务覆盖，这就是之前"感觉不明显"的原因。
        //
        // 这里按同一逻辑实现：把 layer 的 anchorPoint 钉到**被点图标的中心**，
        // 用 CASpringAnimation（0.05 → 1.0）驱动 transform.scale、配 opacity 淡入。
        CGPoint local = [self.window convertPoint:gERZoomIconCenter toView:self];
        CGFloat w = MAX(CGRectGetWidth(self.bounds), 1.0);
        CGFloat h = MAX(CGRectGetHeight(self.bounds), 1.0);
        CGPoint unit = CGPointMake(local.x / w, local.y / h);
        if (unit.x < -0.5 || unit.x > 1.5 || unit.y < -0.5 || unit.y > 1.5) {
            unit = CGPointMake(0.5, 0.5);      // 图标不在本视图内 → 退回中心
        }
        CGRect f = self.frame;
        CGPoint anchorPosition = CGPointMake(CGRectGetMinX(f) + unit.x * CGRectGetWidth(f),
                                             CGRectGetMinY(f) + unit.y * CGRectGetHeight(f));

        [CATransaction begin];
        [CATransaction setDisableActions:YES];
        layer.anchorPoint = unit;
        layer.position = anchorPosition;       // 与旧 anchorPoint 组合保持视觉位置不变

        CASpringAnimation *spring = [CASpringAnimation animationWithKeyPath:@"transform.scale"];
        spring.fromValue = @0.05;
        spring.toValue = @1.0;
        spring.duration = ERAppZoom26Duration();
        // 弹簧参数用经典三件套（mass/stiffness/damping）——`dampingRatio` 是 iOS 17 SDK 才有的属性，
        // 本工程用 16.5 SDK 编译，不能引用。这组值 ≈ response 0.42 / dampingRatio 0.82 的轻微回弹。
        spring.mass = 1.0;
        spring.stiffness = 280.0;
        spring.damping = 24.0;
        spring.initialVelocity = 0.0;
        [layer addAnimation:spring forKey:@"erZoomIn"];

        CABasicAnimation *fade = [CABasicAnimation animationWithKeyPath:@"opacity"];
        fade.fromValue = @0.10;
        fade.toValue = @1.0;
        fade.duration = ERAppZoom26Duration() * 0.55;
        fade.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
        [layer addAnimation:fade forKey:@"erFadeIn"];
        [CATransaction commit];

        ERLogInfo(@"APPSW-PROBE zoom(layer弹簧) anchor=(%.2f,%.2f) scale=0.05 dur=%.2f", unit.x, unit.y, ERAppZoom26Duration());
    } @catch (__unused NSException *exception) {}
}
%end

%hook SBCrossfadeView
- (void)layoutSubviews {
    %orig;
    @try {
        if (!ERAppZoom26Enabled()) return;
        if (objc_getAssociatedObject(self, kERZoomDidAnimateKey)) return;
        objc_setAssociatedObject(self, kERZoomDidAnimateKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        self.alpha = 0.0;
        [UIView animateWithDuration:0.28 animations:^{ self.alpha = 1.0; }];
    } @catch (__unused NSException *exception) {}
}
%end


@interface SBSApplicationShortcutItem : NSObject
@property (nonatomic, copy) NSString *type;
@property (nonatomic, copy) NSString *localizedTitle;
@end

static NSString *ERQuickAddActionName(void) {
    NSString *name = ERPreferenceString(@"QuickAdd.ActionName", @"添加到文件夹") ?: @"";
    NSString *trimmed = [name stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
    return trimmed.length ? trimmed : @"添加到文件夹";
}

// 1.0.8-25：快速添加卡片外观交给用户自调（设置页「系统增强 → 长按桌面快速添加」）。
// 三项默认值即 v21 定稿的实机效果；0 表示不生效（不压暗 / 不模糊）。范围与设置页滑块一致。
static CGFloat ERQuickAddOutsideDarkness(void) {
    CGFloat v = ERPreferenceDouble(@"QuickAdd.OutsideDarkness", 30.0);
    return MIN(MAX(v, 0.0), 100.0);
}
// 1.0.8-28 · 回到 v19 思路图（用户指定 A-1）。默认 45 → 0：v19 的卡片是
// `.blurwrap`(未压暗) + `.glass-dark rgba(38,45,58,.88)`，卡内本来就没有压暗层。
// 滑块保留，想要更沉可以自己往上拉。
static CGFloat ERQuickAddInsideDarkness(void) {
    CGFloat v = ERPreferenceDouble(@"QuickAdd.InsideDarkness", 0.0);
    return MIN(MAX(v, 0.0), 100.0);
}
// 1.0.8-28 · 回到 v19 思路图（A-1）。默认 30 → 4：v19 的卡片玻璃是 `filter:blur(4px)`。
static CGFloat ERQuickAddInsideBlur(void) {
    CGFloat v = ERPreferenceDouble(@"QuickAdd.InsideBlur", 4.0);
    return MIN(MAX(v, 0.0), 30.0);
}

// v25：玻璃底染色 —— 背景色值滑块（透明度 0–100，默认 88）+ 色板/自定义 RGB（默认灰蓝 38,45,48）。
// 与「框内压暗」相互独立：压暗仍是黑，染色是叠在玻璃上的彩色层，透明度由背景色值滑块决定。
static CGFloat ERQuickAddBackgroundAlpha(void) {
    CGFloat v = ERPreferenceDouble(@"QuickAdd.BackgroundAlpha", 88.0);
    return MIN(MAX(v, 0.0), 100.0);
}
// 1.0.8-27：色值 38,45,48 → 38,45,58。真机卡面实测 B−R 只有 8，思路图是 15~20 ——
// 旧值偏"绿灰"，卡片看着发闷发脏；38,45,58 正是 v19 思路图 HTML 里写定的卡色。
static UIColor *ERQuickAddTintColor(void) {
    NSString *raw = ERPreferenceString(@"QuickAdd.BackgroundColor", @"38,45,58") ?: @"38,45,58";
    NSArray<NSString *> *parts = [raw componentsSeparatedByString:@","];
    CGFloat r = 38.0, g = 45.0, b = 58.0;
    if (parts.count >= 3) {
        r = [parts[0] doubleValue];
        g = [parts[1] doubleValue];
        b = [parts[2] doubleValue];
    }
    r = MIN(MAX(r, 0.0), 255.0);
    g = MIN(MAX(g, 0.0), 255.0);
    b = MIN(MAX(b, 0.0), 255.0);
    return [UIColor colorWithRed:r / 255.0 green:g / 255.0 blue:b / 255.0 alpha:1.0];
}

// 文件夹选择面板 + 移动。所有系统调用前都做 respondsToSelector 探测。
// ---------------------------------------------------------------------------
// 1.0.7-28 · QuickAdd 底部选择面板 —— 底部出现，但整体停在 dock 上方。
//
// 用户明确要求：不要居中，要「底部出现」，而且不能被 dock 压住（原 ActionSheet 的
// 末行会被 dock 盖住）。ActionSheet 只会贴屏幕底边、无法抬高，所以这里自绘同款面板：
//   · 半透明遮罩（点一下取消）+ 毛玻璃圆角面板
//   · 面板底边 = 安全区底 + kERQuickAddSheetLift —— 正好落在 dock 图标行之上
//   · 行高 48、文件夹多时面板内部滚动；点「取消」或遮罩关闭
// ---------------------------------------------------------------------------
// 1.0.8-7 ·「添加到文件夹」面板 —— 视觉层再调（业务逻辑与交互一行未改）
//
// 对标参考效果图的分层与材质：
//   ① 全屏毛玻璃背景（模糊主屏幕）
//   ② 极轻遮罩（**不用**重黑色全屏遮罩，避免把后方画面压死）
//   ③ 居中悬浮毛玻璃卡片：圆角 26、柔和阴影透明度 0.3、**无实色背景、无边框**，
//      透出模糊的后方屏幕画面
//   ④ 卡片外标题 + 副标题，顶部留白
//   ⑤ 列表：固定 6 行整；每条 cell 圆角 16、半透明材质底，**条目之间用间距区分**，
//      不画分割线
//   ⑥ 图标：**CoreGraphics 代码绘制** —— 白色线性文件夹（造型固定）+ 彩色圆角底
//      （15 套色值按 row 循环，底色 70% 透明度，白色线条 100% 不透明），
//      **彻底没有问号占位图，也不加载任何外部图片**
//   ⑦ 选中：整条 cell 的蓝色胶囊高亮 + 微弱外发光
//   ⑧ 底部两个胶囊按钮（圆角 23）：蓝色主按钮「新建文件夹」/ 半透明「取消」
// ---------------------------------------------------------------------------
// 1.0.8-10 · 按 v12 思路图把规格逐项对齐（业务逻辑与交互一行未改）
//   · 卡片磨砂改双叠层：白 10% + 黑 6%（与思路图逐层一致），加 0.6pt 白 16% 发丝描边
//   · cell：1px 边缘光（深色白 14% / 浅色白 35%）；名字 15 Medium、副标题 11
//   · 图标 34 → 30pt（圆角 9）；选中态与「新建文件夹」按钮改思路图同款纯色 #2E6BFF
//   · 按钮 139×46 → 134×46（间距 12、距卡缘 20）；列表-按钮间距 14；卡内距上 20 / 下 18
//   · 标题 26 Bold → 24 Semibold、副标题 14 → 13；选中行副标题提亮到白 78%
// ---------------------------------------------------------------------------
// 1.0.8-12 · 用户反馈「三处无变化」后的加固版（视觉规格与 1.0.8-11 相同，逐项核对）：
//   ① 背景**上屏即不透明**（去掉淡入的 viewDidAppear 依赖），根视图也同步上底色双保险
//   ② 副标题计数再加一层：NSArray 递归求和、folderIcon 直读兜底、逐行落 QUICKADD 日志
//   ③ 布局数值与 1.0.8-11 一致（列表/按钮同 span 20 / 280；图标 14；文字 54；chevron 20）
//   注：若实机装上本版后弹窗仍与 1.0.8-9 完全一致 —— 问题不在本面板代码，优先排查
//   设备上是否另装了原版 AddToFolder（抢占同一长按入口）以及安装/注销流程。
// ---------------------------------------------------------------------------
// 1.0.8-15 · 三处最终版（用户要求"这次一定要解决"）：
//   ① 背景：**纯平**不透明底色（移除三团光晕 —— 柔光斑块易被误读为壁纸透出）；
//      深色 #15151B / 浅色 #F5F5F7，根视图双保险不变
//   ② 图标：白色文件夹字形按思路图路径逐点重绘（30 盒内 x 7..22 / y 9..21、
//      描边 1.6、移除内衬高光线），与思路图 SVG 完全一致
//   ③ 副标题：实机验证可用的 allIcons 路径固化为第一优先（1.0.8-14 已出真实数字），
//      其余探测路径保留为兜底
// ---------------------------------------------------------------------------
// 1.0.8-16 · 用户批注（绿箭头=整屏黑底 / 绿圈=图标；"显示层级太高了"）后的修正：
//   ① 背景：纯平黑幕 → **厚毛玻璃 + 黑 60% 压暗**（iOS 打开文件夹同款）——
//      壁纸不可辨认但不吞掉整屏氛围；_qaDim 回归压暗层职责；根视图回到透明
//   ② 图标居中：白色字形在 30 色块内两轴精确居中（x +0.5pt，思路图手稿本身偏 0.5）；
//      名字下移 1pt 使文字块几何中心与图标中心对齐
//   窗口层级维持 100（盖 dock 的最低已验证值）不变。
// ---------------------------------------------------------------------------
// 1.0.8-17 · 用户三项指令：
//   ① **窗口层级锁定 100，后续版本永久不改**（用户确认"层级对"）
//   ② 背景：压暗 60% → **黑 10%**（用户指定"背景改为10%"）—— 桌面清晰可见，
//      厚毛玻璃保留（壁纸不可辨）；如仍显示为纯黑即为渲染层问题，与本层参数无关
//   ③ 「新建文件夹」：点击先弹**改名输入框**（参考 AddToFolder；默认「新建文件夹」
//      可改），确定后创建 → 按「前后差集」找新文件夹 → setDisplayName:/setTitle:/
//      setName:/renameTo:/KVC 依次尝试改名 → 移入图标。取消则不动。
// ---------------------------------------------------------------------------
// 1.0.8-18 · 用户三条反馈的修复：
//   ① 居中：图标在行左侧区域（0→54）水平+垂直双居中（x=12，中心 27/29）；
//      文字块（名字 18 + 2 + 数量 14）作为整体垂直居中，块中心与图标中心同高（29）
//   ② 选中高亮：点行先上蓝色胶囊高亮（可见停留 0.16s）再关面板执行动作
//   ③ 改名框：改为**自绘弹窗**（替代 UIAlertController —— 解决 iOS 17 上弹窗
//      渲染为空/只显示标题的问题）；输入框初始为空、仅占位提示；点「新建文件夹」
//      先关闭主面板，关闭完成后再弹改名框（两者不再并存）
// ---------------------------------------------------------------------------
// 1.0.8-19 · 日志实锤 scene=SBSystemApertureWindowScene 后的根治版：
//   ① 背景：**桌面快照铺底** —— 本窗口所在场景没有主屏合成背景（毛玻璃永远采不到），
//      改为对本窗口层级以下的所有 SpringBoard 窗口截图合成（图标/组件/dock/壁纸窗口），
//      铺作背景 + 10% 压暗 —— 一定看得见桌面；捕获窗口清单落日志
//   ② 居中：**图标 y 补上 insetY**（此前恒偏上 4pt —— 从首版起就存在的真正根因）；
//      图标中心 = 文字块中心 = 行中心（29）
//   ③ 动画：弹出 / 关闭 / 改名框全部**无动画**直接显示（用户要求）
// ---------------------------------------------------------------------------
// 1.0.8-20 · 按 v14 思路图（已确认）实施 —— 15PM 规格落地 + 五项修复：
//   ① 3D Touch 菜单：面板出现前**主动关闭**（日志实锤菜单渲染层级高于 100，盖在面板上）
//   ② 卡片：厚材质+黑6%灰层 → **薄毛玻璃**（ThinMaterial + 白 10% 玻璃膜 + 白 22%
//      发丝描边），壁纸隐约透出
//   ③ 改名框：**移除外层灰底**（去模糊层与压暗层），只留毛玻璃对话框 + 透明命中区
//   ④ 过渡：恢复**轻淡入淡出**动画（0.18s / 0.15s，无缩放无弹跳）
//   ⑤ 桌面压暗：10% → **30%**
//   ⑥ 快照收紧：只截「Wallpaper / HomeScreen / Dock」三类窗口（此前混入 13 个无关窗口）
//   ⑦ 尺寸全部换到 v14（15PM ×1.097）：卡 350×428 r38｜行 64 · cell 306×55 r18｜
//      图标 33 r10 距左 15｜名字 16 / 数量 12（cell+59）｜chevron 22 距右 22｜
//      按钮 147×50 r25 距卡缘 22｜标题 26 / 副标题 14｜内距 上 22 下 20 间距 16
// ---------------------------------------------------------------------------
// 1.0.8-21 · 三联修复：
//   ① 3D Touch 菜单：dismissMenu 走了但无效（日志实锤）→ 追加「方法名探测 + 调用」：
//      对 iconView / 主屏 rootVC / SBIconController 上名字含 dismiss|hide|cancel 且含
//      menu|context 的无参方法逐个调用，并把这些方法的完整名单写进日志
//   ② 卡片/改名框玻璃：本场景 UIVisualEffectView 模糊恒失败（卡片只剩灰底）→ 改为
//      **自绘毛玻璃**：桌面快照的模糊副本（CoreImage，半径 16）按弹窗位置取景 + 白 10% 膜
//   ③ **全深色模式外观**：两处控制器 overrideUserInterfaceStyle = Dark
//      （背景恒压暗 30%，不再区分系统深浅色）
// ---------------------------------------------------------------------------
// 1.0.8-22 · 两项修正：
//   ① 3D Touch 菜单"不消失"：真相 = 面板在点按后 0.2s 就截图，菜单淡出动画（~0.3-0.4s）
//      还没结束就被"拍进"了桌面快照背景（菜单 UI 在主屏窗口内部，不受窗口白名单过滤）。
//      修法：点按后**等 0.45s**（菜单完全淡出）再弹面板；menu-surface 名单改为
//      **全量记录（含带参数签名）**——真正的关闭接口若带参数，下一版照名单调用
//   ② 玻璃通透度按用户要求降到 50%：模糊半径 16→8、白膜 10%→5%（两处弹窗同步）
// ---------------------------------------------------------------------------
// 1.0.8-23 · 速度与实时性（用户反馈"弹出来好慢，之前速度刚刚好；不能实时显吗"）：
//   ① 背景改为**实时直透**：窗口全透明，真实桌面直接透出 + 黑 30% 压暗 ——
//      不再用截图铺底，弹窗**即时出现**（与菜单同刻）
//   ② 3D Touch 菜单改为**点按瞬间隐藏视图**（含容器），不再等待 0.45s 淡出；
//      1.2s 后自动恢复（系统正常流程会先移除它们）
//   ③ 卡片玻璃维持"桌面模糊副本"（系统模糊本场景不可用），快照仅在玻璃糊化使用
// ---------------------------------------------------------------------------
// 1.0.8-24 · 按 v21 定稿实施（去白通透 + 文字高光）：
//   ① 模糊 8 → **6**（卡内玻璃与改名框同步）
//   ② **卡内压暗 32%**（白膜移除）—— 与卡外 30% 亮度衔接，"发白"从物理上消除
//   ③ 面上去白：行白 0.09→0.05 · 行边光 0.14→0.10 · 取消按钮 0.14→0.10
//   ④ 镜面高光描边（liquidass `_specularLayer` 原样）：1pt · 六段渐变
//      （白 0.098→0.035→透明→透明→黑 0.014→白 0.042）· -45° · 圆角路径掩码
//   ⑤ 发丝边改分隔色 16%（1pt）；文字高光：标题 32pt（26→32）柔光 r7 α0.35、
//      副标题 18pt（14→18）柔光 r5 α0.28、行名 16pt 柔光 r4 α0.18；副标题白 0.78
